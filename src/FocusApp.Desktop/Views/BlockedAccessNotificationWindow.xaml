<Window x:Class="FocusApp.Desktop.Views.BlockedAccessNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource BlockedAccessNotificationTitle}"
        Width="400"
        Height="210"
        MinWidth="400"
        MinHeight="210"
        MaxWidth="400"
        MaxHeight="210"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        Opacity="0"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Window.Resources>
        <Style x:Key="NotificationCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseHitArea" Background="{TemplateBinding Background}" CornerRadius="16">
                            <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M 1,1 L 15,15 M 15,1 L 1,15"
                                      Stroke="{DynamicResource TextWeak}"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="1.4" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseHitArea" Property="Background" Value="{DynamicResource BackgroundSecondary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseHitArea" Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootCard"
            Margin="4"
            Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource OverlayBorder}"
            BorderThickness="1"
            CornerRadius="18"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="ToastTranslateTransform" X="12" Y="8" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              Direction="270"
                              Opacity="0.08"
                              ShadowDepth="2" />
        </Border.Effect>

        <Grid Margin="24,14,24,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="12" />
                <RowDefinition Height="28" />
                <RowDefinition Height="6" />
                <RowDefinition Height="20" />
                <RowDefinition Height="6" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image x:Name="ApplicationLogo"
                       Width="32"
                       Height="32"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Source="/FocusApp.Desktop;component/Assets/Icons/Common/shiguang_logo.png"
                       Stretch="Uniform" />

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="{DynamicResource BlockedAccessNotificationBrandName}" />

                <Button Grid.Column="3"
                        Margin="0,-4,-8,0"
                        AutomationProperties.Name="{DynamicResource BlockedAccessNotificationClose}"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource NotificationCloseButtonStyle}" />
            </Grid>

            <TextBlock Grid.Row="2"
                       x:Name="BlockedAccessTitle"
                       VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}">
                <Run Text="{Binding TargetKindDisplay, Mode=OneWay}" /><Run Text="{DynamicResource BlockedAccessNotificationBlockedSuffix}" />
            </TextBlock>

            <TextBlock Grid.Row="4"
                       x:Name="BlockedAccessSubtitle"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="Normal"
                       Foreground="{DynamicResource TextSecondary}">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Text" Value="{DynamicResource BlockedAccessNotificationWebsiteSubtitle}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="Application">
                                <Setter Property="Text" Value="{DynamicResource BlockedAccessNotificationApplicationSubtitle}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Border Grid.Row="6"
                    Background="{DynamicResource TransparentBrush}"
                    BorderBrush="{DynamicResource BorderPrimary}"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid Margin="14,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="40"
                          Height="40"
                          VerticalAlignment="Center">
                        <Viewbox Width="28" Height="28">
                            <Grid Width="20" Height="20">
                                <Ellipse Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.4" />
                                <Ellipse Margin="5,0" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.2" />
                                <Line X1="1" Y1="7" X2="19" Y2="7" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.1" />
                                <Line X1="1" Y1="13" X2="19" Y2="13" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.1" />
                            </Grid>
                        </Viewbox>
                    </Grid>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="{Binding Name, Mode=OneWay}" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="{Binding Address, Mode=OneWay}" />
                    </StackPanel>

                    <Viewbox Grid.Column="3"
                             Width="32"
                             Height="32"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Opacity="0.42">
                        <Grid Width="28" Height="28">
                            <Ellipse Stroke="{DynamicResource AccentPrimary}" StrokeThickness="2.6" />
                            <Line X1="5" Y1="5" X2="23" Y2="23"
                                  Stroke="{DynamicResource AccentPrimary}"
                                  StrokeEndLineCap="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="2.6" />
                        </Grid>
                    </Viewbox>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
