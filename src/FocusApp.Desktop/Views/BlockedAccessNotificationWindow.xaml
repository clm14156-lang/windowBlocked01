<Window x:Class="FocusApp.Desktop.Views.BlockedAccessNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource BlockedAccessNotificationTitle}"
        Width="400"
        Height="180"
        MinWidth="400"
        MinHeight="180"
        MaxWidth="400"
        MaxHeight="180"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        Opacity="0"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Window.Resources>
        <Style x:Key="NotificationCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseHitArea" Background="{TemplateBinding Background}" CornerRadius="16">
                            <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M 1,1 L 15,15 M 15,1 L 1,15"
                                      Stroke="#C4C8CE"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="1.4" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseHitArea" Property="Background" Value="#50545A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseHitArea" Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootCard"
            Margin="1"
            BorderBrush="#555A60"
            BorderThickness="1"
            CornerRadius="12"
            RenderTransformOrigin="0.5,0.5">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#50545A" Offset="0" />
                <GradientStop Color="#40454A" Offset="0.44" />
                <GradientStop Color="#3C4146" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.RenderTransform>
            <TranslateTransform x:Name="ToastTranslateTransform" X="12" Y="8" />
        </Border.RenderTransform>
        <Grid Margin="22,14,22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="18" />
                <RowDefinition Height="25" />
                <RowDefinition Height="5" />
                <RowDefinition Height="18" />
                <RowDefinition Height="18" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image x:Name="ApplicationLogo"
                       Width="28"
                       Height="28"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Source="/FocusApp.Desktop;component/Assets/Icons/Common/shiguang_logo.png"
                       Stretch="Uniform" />

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="#F5F6F8"
                           Text="{DynamicResource BlockedAccessNotificationBrandName}" />

                <Button Grid.Column="3"
                        Margin="0,-2,-6,0"
                        AutomationProperties.Name="{DynamicResource BlockedAccessNotificationClose}"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource NotificationCloseButtonStyle}" />
            </Grid>

            <TextBlock Grid.Row="2"
                       x:Name="BlockedAccessTitle"
                       VerticalAlignment="Center"
                       FontSize="19"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF">
                <Run Text="{Binding TargetKindDisplay, Mode=OneWay}" /><Run Text="{DynamicResource BlockedAccessNotificationBlockedSuffix}" />
            </TextBlock>

            <TextBlock Grid.Row="4"
                       x:Name="BlockedAccessSubtitle"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="Normal"
                       Foreground="#B4BAC3">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Text" Value="{DynamicResource BlockedAccessNotificationWebsiteSubtitle}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="Application">
                                <Setter Property="Text" Value="{DynamicResource BlockedAccessNotificationApplicationSubtitle}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="23"
                      Height="23"
                      VerticalAlignment="Center">
                    <Viewbox Width="23" Height="23">
                        <Grid Width="20" Height="20">
                            <Ellipse Stroke="#AEB5BE" StrokeThickness="1.4" />
                            <Ellipse Margin="5,0" Stroke="#AEB5BE" StrokeThickness="1.2" />
                            <Line X1="1" Y1="7" X2="19" Y2="7" Stroke="#AEB5BE" StrokeThickness="1.1" />
                            <Line X1="1" Y1="13" X2="19" Y2="13" Stroke="#AEB5BE" StrokeThickness="1.1" />
                        </Grid>
                    </Viewbox>
                </Grid>

                <Border Grid.Column="2"
                        Width="1"
                        Height="28"
                        VerticalAlignment="Center"
                        Background="#656B72" />

                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock FontSize="14"
                               FontWeight="Medium"
                               Foreground="#F5F6F8"
                               Text="{Binding Name, Mode=OneWay}" />
                    <TextBlock Margin="0,1,0,0"
                               FontSize="11"
                               FontWeight="Normal"
                               Foreground="#AEB5BE"
                               Text="{Binding Address, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
