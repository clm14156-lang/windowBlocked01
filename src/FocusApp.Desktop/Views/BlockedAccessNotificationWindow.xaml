<Window x:Class="FocusApp.Desktop.Views.BlockedAccessNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource BlockedAccessNotificationTitle}"
        Width="400"
        Height="180"
        MinWidth="400"
        MinHeight="180"
        MaxWidth="400"
        MaxHeight="180"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        Opacity="0"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Window.Resources>
        <Style x:Key="NotificationMoreButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="MoreHitArea" Background="{TemplateBinding Background}" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="3" Height="3" Fill="#C4C8CE" />
                            <Ellipse Width="3" Height="3" Margin="3,0" Fill="#C4C8CE" />
                            <Ellipse Width="3" Height="3" Fill="#C4C8CE" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MoreHitArea" Property="Background" Value="#5A6067" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="MoreHitArea" Property="Opacity" Value="0.68" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWebsite}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NotificationMenuItemStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#F5F6F8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="MenuItemChrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MenuItemChrome" Property="Background" Value="#565C63" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MenuItemChrome" Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="NotificationCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseHitArea" Background="{TemplateBinding Background}" CornerRadius="16">
                            <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M 1,1 L 15,15 M 15,1 L 1,15"
                                      Stroke="#C4C8CE"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="1.4" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseHitArea" Property="Background" Value="#50545A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseHitArea" Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWebsite}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="RootCard"
            Margin="1"
            BorderBrush="#555A60"
            BorderThickness="1"
            CornerRadius="12"
            RenderTransformOrigin="0.5,0.5">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#50545A" Offset="0" />
                <GradientStop Color="#40454A" Offset="0.44" />
                <GradientStop Color="#3C4146" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.RenderTransform>
            <TranslateTransform x:Name="ToastTranslateTransform" X="12" Y="8" />
        </Border.RenderTransform>
        <Grid Margin="22,14,22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="18" />
                <RowDefinition Height="25" />
                <RowDefinition Height="5" />
                <RowDefinition Height="18" />
                <RowDefinition Height="18" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image x:Name="ApplicationLogo"
                       Width="28"
                       Height="28"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Source="/FocusApp.Desktop;component/Assets/Icons/Common/shiguang_logo.png"
                       Stretch="Uniform" />

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="#F5F6F8"
                           Text="{DynamicResource BlockedAccessNotificationBrandName}" />

                <Button Grid.Column="3"
                        Margin="0,-2,-6,0"
                        AutomationProperties.Name="{DynamicResource BlockedAccessNotificationClose}"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource NotificationCloseButtonStyle}" />
                <Button x:Name="MoreActionsButton" Grid.Column="3" Margin="0,-2,-6,0"
                        AutomationProperties.Name="{DynamicResource BlockedAccessNotificationMore}"
                        Click="MoreActionsButton_Click" Style="{StaticResource NotificationMoreButtonStyle}" />
                <Popup x:Name="ActionsPopup" Grid.Column="3"
                       Placement="Custom" PlacementTarget="{Binding ElementName=MoreActionsButton}"
                       CustomPopupPlacementCallback="ActionsPopup_Placement"
                       DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                       AllowsTransparency="True" StaysOpen="False"
                       Opened="ActionsPopup_Opened" Closed="ActionsPopup_Closed"
                       Mouse.PreviewMouseDownOutsideCapturedElement="ActionsPopup_MouseDownOutside">
                    <Border x:Name="ActionsPoptip" Width="155" Height="90" Padding="3"
                            BorderBrush="#656B72" BorderThickness="1" CornerRadius="9"
                            TextElement.FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#494F55" Offset="0" />
                                <GradientStop Color="#3C4146" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="1" /><RowDefinition /></Grid.RowDefinitions>
                            <Button x:Name="DismissNotificationButton" Command="{Binding CloseCommand}"
                                    AutomationProperties.Name="{DynamicResource BlockedAccessNotificationDismiss}" Style="{StaticResource NotificationMenuItemStyle}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Grid Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Ellipse Stroke="#F5F6F8" StrokeThickness="1.3" />
                                        <Path Data="M 2,2 L 13,13" Stroke="#F5F6F8" StrokeThickness="1.3" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" FontWeight="Normal"
                                               Foreground="#F5F6F8" Text="{DynamicResource BlockedAccessNotificationDismiss}" />
                                </Grid>
                            </Button>
                            <Border Grid.Row="1" Margin="7,0" Background="#656B72" />
                            <Button x:Name="SuppressSessionButton" Grid.Row="2" Command="{Binding SuppressForSessionCommand}"
                                    AutomationProperties.Name="{DynamicResource BlockedAccessNotificationSuppressSession}" Style="{StaticResource NotificationMenuItemStyle}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Path Width="15" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Uniform"
                                          Data="M 8,1 L 8,3 M 4,4 Q 8,0 12,4 L 12,10 L 14,13 L 2,13 L 4,10 L 4,7 M 6,15 Q 8,17 10,15 M 1,1 L 15,16"
                                          Stroke="#F5F6F8" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" FontWeight="Normal"
                                               Foreground="#F5F6F8" Text="{DynamicResource BlockedAccessNotificationSuppressSession}" />
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>
                </Popup>
            </Grid>

            <TextBlock Grid.Row="2"
                       x:Name="BlockedAccessTitle"
                       VerticalAlignment="Center"
                       FontSize="19"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF">
                <Run Text="{Binding TargetKindDisplay, Mode=OneWay}" /><Run Text="{DynamicResource BlockedAccessNotificationBlockedSuffix}" />
            </TextBlock>

            <TextBlock Grid.Row="4"
                       x:Name="BlockedAccessSubtitle"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="Normal"
                       Foreground="#B4BAC3">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Text" Value="{DynamicResource BlockedAccessNotificationWebsiteSubtitle}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="Application">
                                <Setter Property="Text" Value="{DynamicResource BlockedAccessNotificationApplicationSubtitle}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="23"
                      Height="23"
                      VerticalAlignment="Center">
                    <Viewbox Width="23" Height="23">
                        <Grid Width="20" Height="20">
                            <Ellipse Stroke="#AEB5BE" StrokeThickness="1.4" />
                            <Ellipse Margin="5,0" Stroke="#AEB5BE" StrokeThickness="1.2" />
                            <Line X1="1" Y1="7" X2="19" Y2="7" Stroke="#AEB5BE" StrokeThickness="1.1" />
                            <Line X1="1" Y1="13" X2="19" Y2="13" Stroke="#AEB5BE" StrokeThickness="1.1" />
                        </Grid>
                    </Viewbox>
                </Grid>

                <Border Grid.Column="2"
                        Width="1"
                        Height="28"
                        VerticalAlignment="Center"
                        Background="#656B72" />

                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock FontSize="14"
                               FontWeight="Medium"
                               Foreground="#F5F6F8"
                               Text="{Binding Name, Mode=OneWay}" />
                    <TextBlock Margin="0,1,0,0"
                               FontSize="11"
                               FontWeight="Normal"
                               Foreground="#AEB5BE"
                               Text="{Binding Address, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
