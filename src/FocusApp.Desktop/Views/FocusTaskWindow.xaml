<UserControl x:Class="FocusApp.Desktop.Views.FocusTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FocusApp.Desktop.Views"
        Width="290"
        Height="420"
        Background="Transparent"
        PreviewKeyDown="FocusTaskWindow_PreviewKeyDown"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:PositiveIntToVisibilityConverter x:Key="PositiveIntToVisibilityConverter" />

        <Style x:Key="FocusTaskWindowPlainButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusTaskWindowCloseButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#808080" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="CloseBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <Path Width="13"
                                  Height="13"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 1.5,1.5 L 11.5,11.5 M 11.5,1.5 L 1.5,11.5"
                                  Fill="{x:Null}"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBackground" Property="Background" Value="#F3F3F3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseBackground" Property="Background" Value="#EDEDED" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusTaskWindowMenuItemButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="35" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="MenuItemBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuItemBackground" Property="Background" Value="#F5F5F7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MenuItemBackground" Property="Background" Value="#EFEFF1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusTaskWindowEditorStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="FocusTaskWindowCheckButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextTertiary}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusTaskWindowThinScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="5" />
            <Setter Property="MinWidth" Value="5" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="5" Background="{DynamicResource TransparentBrush}">
                            <Track x:Name="PART_Track" Margin="0,3" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}" BorderThickness="0" Command="{x:Static ScrollBar.PageUpCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBody" Width="3" HorizontalAlignment="Center" Background="#D1D1D6" CornerRadius="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#C7C7CC" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#AEAEB2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}" BorderThickness="0" Command="{x:Static ScrollBar.PageDownCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Margin="2"
            Padding="20,12,20,10"
            Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource BorderPrimary}"
            BorderThickness="1"
            CornerRadius="22"
            MouseDown="Window_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.10" ShadowDepth="4" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
                <RowDefinition Height="48" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" FontSize="15" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource FocusCurrentTask}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="15" Foreground="{DynamicResource TextSecondary}">
                        <Run Text="1/" /><Run Text="{Binding PendingTaskCount, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <Button Margin="0,0,-4,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{DynamicResource FocusCloseTaskWindow}"
                        Click="CloseButton_Click"
                        Style="{StaticResource FocusTaskWindowCloseButton}" />
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource BorderPrimary}" />

            <ScrollViewer x:Name="TaskListScrollViewer"
                          Grid.Row="2"
                          AllowDrop="True"
                          DragOver="TaskList_DragOver"
                          Drop="TaskList_Drop"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource FocusTaskWindowThinScrollBarStyle}" />
                </ScrollViewer.Resources>
                <StackPanel Background="{DynamicResource TransparentBrush}">
                    <ItemsControl x:Name="PendingTaskList" ItemsSource="{Binding PendingTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="TaskDragRow"
                                      Height="57"
                                      Background="Transparent"
                                      PreviewMouseLeftButtonDown="PendingTaskList_PreviewMouseLeftButtonDown"
                                      PreviewMouseLeftButtonUp="PendingTaskList_PreviewMouseLeftButtonUp"
                                      PreviewMouseMove="PendingTaskList_PreviewMouseMove">
                                    <Grid.Style>
                                        <Style TargetType="{x:Type Grid}">
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="RenderTransform"><Setter.Value><TranslateTransform /></Setter.Value></Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                    <Setter Property="Opacity" Value="0.76" />
                                                    <Setter Property="Panel.ZIndex" Value="6" />
                                                    <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="10" Direction="270" Opacity="0.14" ShadowDepth="2" Color="#808080" /></Setter.Value></Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ShowDropBefore}" Value="True"><Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="4" /></Setter.Value></Setter></DataTrigger>
                                                <DataTrigger Binding="{Binding ShowDropAfter}" Value="True"><Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="-4" /></Setter.Value></Setter></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Border x:Name="TaskRow" CornerRadius="10">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=TaskDragRow}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <Button HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.ToggleTaskCompletedCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource FocusTaskWindowCheckButton}" />
                                    <Grid Margin="38,0,34,0" VerticalAlignment="Center">
                                        <TextBox AutomationProperties.Name="任务名称"
                                                 IsVisibleChanged="Editor_IsVisibleChanged"
                                                 Loaded="Editor_Loaded"
                                                 LostKeyboardFocus="TargetTaskTextBox_LostKeyboardFocus"
                                                 Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 Style="{StaticResource FocusTaskWindowEditorStyle}" />
                                        <TextBlock VerticalAlignment="Center" FontSize="13" Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button x:Name="TaskMenuButton"
                                            Width="30"
                                            Height="30"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.ToggleTaskMenuCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource FocusTaskWindowPlainButton}"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            ToolTip="{DynamicResource FocusTaskMenu}">
                                        <TextBlock FontSize="17" Foreground="{DynamicResource TextSecondary}" Text="···" />
                                    </Button>
                                    <Popup AllowsTransparency="True"
                                           HorizontalOffset="-86"
                                           IsOpen="{Binding IsFocusMenuOpen, Mode=TwoWay}"
                                           Placement="Bottom"
                                           PlacementTarget="{Binding ElementName=TaskMenuButton}"
                                           PopupAnimation="Fade"
                                           StaysOpen="False"
                                           VerticalOffset="7">
                                        <Border Width="116"
                                                Padding="4"
                                                DataContext="{Binding DataContext, ElementName=TaskMenuButton}"
                                                Tag="{Binding Tag, ElementName=TaskMenuButton}"
                                                Background="#FFFFFF"
                                                BorderBrush="#EAEAEA"
                                                BorderThickness="1"
                                                CornerRadius="9">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12" Direction="270" Opacity="0.08" ShadowDepth="4" />
                                            </Border.Effect>
                                            <StackPanel>
                                                <Button Command="{Binding Tag.BeginEditTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type Border}}}"
                                                        CommandParameter="{Binding}"
                                                        Foreground="{DynamicResource TextPrimary}"
                                                        Style="{StaticResource FocusTaskWindowMenuItemButton}">
                                                    <TextBlock Foreground="{DynamicResource TextPrimary}"
                                                               Text="{DynamicResource FocusRenameTask}" />
                                                </Button>
                                                <Border Height="1" Margin="10,0" Background="#EFEFEF" />
                                                <Button Command="{Binding Tag.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type Border}}}"
                                                        CommandParameter="{Binding}"
                                                        Foreground="#FF3B30"
                                                        Style="{StaticResource FocusTaskWindowMenuItemButton}">
                                                    <TextBlock Foreground="#FF3B30"
                                                               Text="{DynamicResource FocusDeleteTask}" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                    <Border Height="1" Margin="0,56,0,0" Background="{DynamicResource BorderPrimary}" />
                                    <Border Height="2" VerticalAlignment="Top" Panel.ZIndex="10" Background="{DynamicResource AccentPrimary}" CornerRadius="1" IsHitTestVisible="False" Visibility="{Binding ShowDropBefore, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Border Height="2" VerticalAlignment="Bottom" Panel.ZIndex="10" Background="{DynamicResource AccentPrimary}" CornerRadius="1" IsHitTestVisible="False" Visibility="{Binding ShowDropAfter, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Height="44"
                            HorizontalContentAlignment="Stretch"
                            Background="{DynamicResource TransparentBrush}"
                            Command="{Binding DataContext.ToggleTaskPanelCompletedTasksCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Style="{StaticResource FocusTaskWindowPlainButton}">
                        <Grid Margin="0,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextSecondary}"><Run Text="{DynamicResource FocusCompletedTasksPrefix}" /><Run Text="{Binding CompletedTasks.Count, Mode=OneWay}" /><Run Text="{DynamicResource FocusCompletedTasksSuffix}" /></TextBlock>
                            <Viewbox Grid.Column="1"
                                     Width="10"
                                     Height="10"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center"
                                     RenderTransformOrigin="0.5,0.5"
                                     Visibility="{Binding CompletedTasks.Count, Mode=OneWay, Converter={StaticResource PositiveIntToVisibilityConverter}}">
                                <Viewbox.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Viewbox.RenderTransform>
                                <Viewbox.Style>
                                    <Style TargetType="{x:Type Viewbox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsCompletedTasksExpanded, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             To="90"
                                                                             Duration="0:0:0.14">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <SineEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             To="0"
                                                                             Duration="0:0:0.14">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <SineEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Viewbox.Style>
                                <Path Data="M 2,1 L 6,5 L 2,9"
                                      Fill="{x:Null}"
                                      Stroke="{DynamicResource TextSecondary}"
                                      StrokeThickness="1.35"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Viewbox>
                        </Grid>
                    </Button>
                    <ItemsControl ItemsSource="{Binding CompletedTasks}" Visibility="{Binding IsCompletedTasksExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="50">
                                    <Button HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            BorderBrush="{DynamicResource TextWeak}"
                                            Command="{Binding DataContext.ToggleTaskCompletedCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource FocusTaskWindowCheckButton}">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextWeak}" Text="&#xE73E;" />
                                    </Button>
                                    <TextBlock Margin="38,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextWeak}" Text="{Binding Name}" TextDecorations="Strikethrough" TextTrimming="CharacterEllipsis" />
                                    <Border Height="1" Margin="38,49,0,0" Background="{DynamicResource BorderPrimary}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="3"
                    Height="44"
                    HorizontalContentAlignment="Left"
                    Focusable="False"
                    IsDefault="False"
                    IsTabStop="False"
                    Command="{Binding AddTaskCommand}"
                    Style="{StaticResource FocusTaskWindowPlainButton}">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Width="24"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontSize="23"
                               Foreground="{DynamicResource AccentPrimary}"
                               Text="+"
                               TextAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource AccentPrimary}" Text="{DynamicResource FocusAddTask}" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
