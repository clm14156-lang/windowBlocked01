<UserControl x:Class="FocusApp.Desktop.Views.AutomaticRuleModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             Width="300"
             Background="Transparent"
             FontFamily="{DynamicResource FontFamilyPrimary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Style>
        <Style TargetType="{x:Type UserControl}">
            <Setter Property="Height" Value="390" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCustom}" Value="True">
                    <Setter Property="Height" Value="470" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <DataTemplate x:Key="RuleToggleTextContentTemplate">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                       Text="{Binding}" />
        </DataTemplate>

        <Style x:Key="RuleModeButtonStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextUnit}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="ContentTemplate" Value="{StaticResource RuleToggleTextContentTemplate}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="ModeBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="{DynamicResource AccentPrimary}" />
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WeekdayButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextUnit}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="ContentTemplate" Value="{StaticResource RuleToggleTextContentTemplate}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="DayBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource AccentPrimary}" />
                                <Setter TargetName="DayBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RuleTimeTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RuleSecondaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ThemedTextButtonBaseStyle}">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextUnit}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RulePrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource RuleSecondaryButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentHover}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentPressed}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource OverlayBorder}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" Direction="270" Opacity="0.16" ShadowDepth="5" />
        </Border.Effect>
        <Grid>
            <TextBlock Margin="20,18,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource AutomaticRuleNewTitle}" />
            <Button Margin="252,14,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="28" Height="28" Foreground="{DynamicResource TextUnit}" AutomationProperties.Name="{DynamicResource AutomaticRuleClose}" Command="{Binding CloseCommand}" Style="{StaticResource AuthCloseButtonStyle}">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextUnit}" Text="&#xE8BB;" />
            </Button>
            <Border Margin="20,60,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="260" Height="1" Background="{DynamicResource BorderPrimary}" />

            <TextBlock Margin="20,78,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource AutomaticRuleRepeatTitle}" />
            <Grid Margin="20,102,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="260" Height="30">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <RadioButton Grid.Column="0" Content="{DynamicResource AutomaticRuleDaily}" Command="{Binding SelectDailyCommand}" IsChecked="{Binding IsDaily, Mode=OneWay}" Style="{StaticResource RuleModeButtonStyle}" />
                <RadioButton Grid.Column="1" Content="{DynamicResource AutomaticRuleCustom}" Command="{Binding SelectCustomCommand}" IsChecked="{Binding IsCustom, Mode=OneWay}" Style="{StaticResource RuleModeButtonStyle}" />
            </Grid>

            <StackPanel Margin="20,150,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource AutomaticRuleChooseWeekdays}" />
                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Weekdays}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle><Style TargetType="{x:Type ContentPresenter}"><Setter Property="Margin" Value="0,0,7,0" /></Style></ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton AutomationProperties.Name="{Binding DisplayName}" Content="{Binding ShortName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource WeekdayButtonStyle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,6,0,0" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}">
                    <Run Text="{DynamicResource AutomaticRuleSelectedPrefix}" /><Run Text="{Binding SelectedDaysText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <Border Margin="20,232,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="260" Height="1" Background="{DynamicResource BorderPrimary}" Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource AutomaticRuleTimeTitle}">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Margin" Value="20,154,0,0" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Margin" Value="20,244,0,0" /></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBox HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="{DynamicResource AutomaticRuleStartTime}" Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Style>
                    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource RuleTimeTextBoxStyle}">
                        <Setter Property="Margin" Value="20,182,0,0" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Margin" Value="20,272,0,0" /></DataTrigger></Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="—">
                <TextBlock.Style><Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Margin" Value="147,189,0,0" /><Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Margin" Value="147,279,0,0" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <TextBox HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="{DynamicResource AutomaticRuleEndTime}" Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Style>
                    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource RuleTimeTextBoxStyle}">
                        <Setter Property="Margin" Value="180,182,0,0" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Margin" Value="180,272,0,0" /></DataTrigger></Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <views:TimeRangeSlider HorizontalAlignment="Left" VerticalAlignment="Top" Width="260" StartValue="{Binding StartValue, Mode=TwoWay}" EndValue="{Binding EndValue, Mode=TwoWay}">
                <views:TimeRangeSlider.Style>
                    <Style TargetType="{x:Type views:TimeRangeSlider}">
                        <Setter Property="Margin" Value="20,238,0,0" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Margin" Value="20,328,0,0" /></DataTrigger></Style.Triggers>
                    </Style>
                </views:TimeRangeSlider.Style>
            </views:TimeRangeSlider>

            <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Width="260" Height="20">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Margin" Value="20,298,0,0" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Margin" Value="20,388,0,0" /></DataTrigger></Style.Triggers>
                    </Style>
                </Grid.Style>
                <TextBlock HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="Normal"
                           Foreground="{DynamicResource AutomaticRuleValidationText}"
                           Text="{Binding ValidationMessage}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
            </Grid>

            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Width="260" Height="1" Background="{DynamicResource BorderPrimary}">
                <Border.Style><Style TargetType="{x:Type Border}"><Setter Property="Margin" Value="20,328,0,0" /><Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Margin" Value="20,418,0,0" /></DataTrigger></Style.Triggers></Style></Border.Style>
            </Border>
            <Button HorizontalAlignment="Left" VerticalAlignment="Top" Content="{DynamicResource AutomaticRuleCancel}" Command="{Binding CloseCommand}">
                <Button.Style><Style TargetType="{x:Type Button}" BasedOn="{StaticResource RuleSecondaryButtonStyle}"><Setter Property="Margin" Value="124,340,0,0" /><Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Margin" Value="124,430,0,0" /></DataTrigger></Style.Triggers></Style></Button.Style>
            </Button>
            <Button HorizontalAlignment="Left" VerticalAlignment="Top" Content="{DynamicResource AutomaticRuleAdd}" Command="{Binding ConfirmCommand}">
                <Button.Style><Style TargetType="{x:Type Button}" BasedOn="{StaticResource RulePrimaryButtonStyle}"><Setter Property="Margin" Value="208,340,0,0" /><Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Margin" Value="208,430,0,0" /></DataTrigger></Style.Triggers></Style></Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>
