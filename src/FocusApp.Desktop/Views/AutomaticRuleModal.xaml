<UserControl x:Class="FocusApp.Desktop.Views.AutomaticRuleModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             Width="300"
             Background="Transparent"
             FontFamily="{DynamicResource FontFamilyPrimary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Style>
        <Style TargetType="{x:Type UserControl}">
            <Setter Property="Height" Value="390" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCustom}" Value="True">
                    <Setter Property="Height" Value="470" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <DataTemplate x:Key="RuleToggleTextContentTemplate">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                       Text="{Binding}" />
        </DataTemplate>

        <Style x:Key="RuleModeButtonStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextUnit}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="ContentTemplate" Value="{StaticResource RuleToggleTextContentTemplate}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="ModeBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="{DynamicResource AccentPrimary}" />
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WeekdayButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextUnit}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="ContentTemplate" Value="{StaticResource RuleToggleTextContentTemplate}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="DayBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource AccentPrimary}" />
                                <Setter TargetName="DayBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RuleTimeSelectorButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="SelectorBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{TemplateBinding Content}" />
                                <TextBlock Margin="0,0,11,0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Text="&#xE70D;" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectorBorder" Property="BorderBrush" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SelectorBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                <Setter TargetName="SelectorBorder" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SelectorBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimeWheelItemButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ThemedTextButtonBaseStyle}">
            <Setter Property="Width" Value="68" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="WheelItemBorder" Background="{TemplateBinding Background}" CornerRadius="7">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="WheelItemBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                    <Setter Property="FontWeight" Value="Medium" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TimePickerActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ThemedTextButtonBaseStyle}">
            <Setter Property="Width" Value="68" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ActionBorder" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ActionBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RuleSecondaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ThemedTextButtonBaseStyle}">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextUnit}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RulePrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource RuleSecondaryButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentHover}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentPressed}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource OverlayBorder}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" Direction="270" Opacity="0.16" ShadowDepth="5" />
        </Border.Effect>
        <Grid>
            <TextBlock Margin="20,18,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Text" Value="{DynamicResource AutomaticRuleNewTitle}" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Text" Value="{DynamicResource AutomaticRuleEditTitle}" /></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Border Margin="20,60,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="260" Height="1" Background="{DynamicResource BorderPrimary}" />

            <TextBlock Margin="20,78,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource AutomaticRuleRepeatTitle}" />
            <Grid Margin="20,102,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="260" Height="30">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <RadioButton Grid.Column="0" Content="{DynamicResource AutomaticRuleDaily}" Command="{Binding SelectDailyCommand}" IsChecked="{Binding IsDaily, Mode=OneWay}" Style="{StaticResource RuleModeButtonStyle}" />
                <RadioButton Grid.Column="1" Content="{DynamicResource AutomaticRuleCustom}" Command="{Binding SelectCustomCommand}" IsChecked="{Binding IsCustom, Mode=OneWay}" Style="{StaticResource RuleModeButtonStyle}" />
            </Grid>

            <StackPanel Margin="20,150,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="260" Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource AutomaticRuleChooseWeekdays}" />
                <ItemsControl Width="238" Margin="0,8,0,0" HorizontalAlignment="Center" AlternationCount="7" ItemsSource="{Binding Weekdays}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="{x:Type ContentPresenter}">
                            <Setter Property="Margin" Value="0,0,7,0" />
                            <Style.Triggers><Trigger Property="ItemsControl.AlternationIndex" Value="6"><Setter Property="Margin" Value="0" /></Trigger></Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton AutomationProperties.Name="{Binding DisplayName}" Content="{Binding ShortName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource WeekdayButtonStyle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,8,0,0" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}">
                    <Run Text="{DynamicResource AutomaticRuleSelectedPrefix}" /><Run Text="{Binding SelectedDaysText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <Border Margin="20,236,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="260" Height="1" Background="{DynamicResource BorderPrimary}" Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource AutomaticRuleTimeTitle}">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Margin" Value="20,150,0,0" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Margin" Value="20,246,0,0" /></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button x:Name="StartTimeButton"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{DynamicResource AutomaticRuleStartTime}"
                    Click="TimeSelectorButton_Click"
                    Content="{Binding StartTimeText}"
                    PreviewMouseWheel="TimeSelectorButton_PreviewMouseWheel"
                    Tag="Start">
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource RuleTimeSelectorButtonStyle}">
                        <Setter Property="Margin" Value="20,174,0,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Margin" Value="20,270,0,0" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsStartTimePickerOpen}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                <Setter Property="BorderThickness" Value="1.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="—">
                <TextBlock.Style><Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Margin" Value="147,181,0,0" /><Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Margin" Value="147,277,0,0" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <Button x:Name="EndTimeButton"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{DynamicResource AutomaticRuleEndTime}"
                    Click="TimeSelectorButton_Click"
                    Content="{Binding EndTimeText}"
                    PreviewMouseWheel="TimeSelectorButton_PreviewMouseWheel"
                    Tag="End">
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource RuleTimeSelectorButtonStyle}">
                        <Setter Property="Margin" Value="180,174,0,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Margin" Value="180,270,0,0" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsEndTimePickerOpen}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                <Setter Property="BorderThickness" Value="1.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Popup x:Name="TimePickerPopup"
                   AllowsTransparency="True"
                   Closed="TimePickerPopup_Closed"
                   IsOpen="{Binding IsTimePickerOpen, Mode=TwoWay}"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=StartTimeButton}"
                   PopupAnimation="Fade"
                   StaysOpen="False">
                <Border Width="176"
                        Height="214"
                        Padding="10"
                        Background="{DynamicResource SurfacePrimary}"
                        BorderBrush="{DynamicResource OverlayBorder}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" Opacity="0.15" ShadowDepth="4" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="152" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="39" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="3"
                                    Height="30"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentTint}"
                                    CornerRadius="7" />
                            <ItemsControl Grid.Column="0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding HourWheelItems}"
                                          PreviewMouseWheel="TimeWheel_PreviewMouseWheel"
                                          Tag="Hour">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectHourWheelItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding Display}"
                                                Opacity="{Binding Opacity}"
                                                Style="{StaticResource TimeWheelItemButtonStyle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Text=":" />
                            <ItemsControl Grid.Column="2"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding MinuteWheelItems}"
                                          PreviewMouseWheel="TimeWheel_PreviewMouseWheel"
                                          Tag="Minute">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectMinuteWheelItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding Display}"
                                                Opacity="{Binding Opacity}"
                                                Style="{StaticResource TimeWheelItemButtonStyle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <Border Grid.Row="1" Background="{DynamicResource BorderPrimary}" />
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{DynamicResource AutomaticRuleTimePickerClear}" Command="{Binding ClearTimePickerCommand}" Style="{StaticResource TimePickerActionButtonStyle}" />
                            <Button Grid.Column="1" Content="{DynamicResource AutomaticRuleTimePickerConfirm}" Command="{Binding ConfirmTimePickerCommand}" Foreground="{DynamicResource AccentPrimary}" Style="{StaticResource TimePickerActionButtonStyle}" />
                        </Grid>
                    </Grid>
                </Border>
            </Popup>
            <views:TimeRangeSlider HorizontalAlignment="Left" VerticalAlignment="Top" Width="260" StartValue="{Binding StartValue, Mode=TwoWay}" EndValue="{Binding EndValue, Mode=TwoWay}">
                <views:TimeRangeSlider.Style>
                    <Style TargetType="{x:Type views:TimeRangeSlider}">
                        <Setter Property="Margin" Value="20,230,0,0" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Margin" Value="20,326,0,0" /></DataTrigger></Style.Triggers>
                    </Style>
                </views:TimeRangeSlider.Style>
            </views:TimeRangeSlider>

            <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Width="260" Height="20">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Margin" Value="20,280,0,0" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Margin" Value="20,376,0,0" /></DataTrigger></Style.Triggers>
                    </Style>
                </Grid.Style>
                <TextBlock HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="Normal"
                           Foreground="{DynamicResource AutomaticRuleValidationText}"
                           Text="{Binding ValidationMessage}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
            </Grid>

            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Width="260" Height="1" Background="{DynamicResource BorderPrimary}">
                <Border.Style><Style TargetType="{x:Type Border}"><Setter Property="Margin" Value="20,311,0,0" /><Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Margin" Value="20,407,0,0" /></DataTrigger></Style.Triggers></Style></Border.Style>
            </Border>
            <Button HorizontalAlignment="Left" VerticalAlignment="Top" Content="{DynamicResource AutomaticRuleCancel}" Command="{Binding CloseCommand}">
                <Button.Style><Style TargetType="{x:Type Button}" BasedOn="{StaticResource RuleSecondaryButtonStyle}"><Setter Property="Margin" Value="124,324,0,0" /><Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Margin" Value="124,420,0,0" /></DataTrigger></Style.Triggers></Style></Button.Style>
            </Button>
            <Button HorizontalAlignment="Left" VerticalAlignment="Top" Command="{Binding ConfirmCommand}">
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource RulePrimaryButtonStyle}">
                        <Setter Property="Margin" Value="208,324,0,0" />
                        <Setter Property="Content" Value="{DynamicResource AutomaticRuleAdd}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Margin" Value="208,420,0,0" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Content" Value="{DynamicResource AutomaticRuleSave}" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>
