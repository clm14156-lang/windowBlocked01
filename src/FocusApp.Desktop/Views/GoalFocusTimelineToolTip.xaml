<UserControl x:Class="FocusApp.Desktop.Views.GoalFocusTimelineToolTip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="SessionToolTipStyle" TargetType="ToolTip">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="8,8,8,0" Width="224">
        <Border Background="White" BorderBrush="#E9ECF1" BorderThickness="1" CornerRadius="9" Padding="13,11" Margin="0,0,0,7">
            <Border.Effect><DropShadowEffect Color="#243047" Opacity="0.08" BlurRadius="12" ShadowDepth="2"/></Border.Effect>
            <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding TimeRangeDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="#202A38"/>
                    <TextBlock Grid.Column="1" Text="{Binding CalendarDurationDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="#202A38" Margin="12,0,0,0"/>
                </Grid>
                <StackPanel>
                    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding CompletedTaskCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <Border Height="1" Background="#F0F1F4" Margin="0,10,0,9"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="完成任务" FontSize="11" Foreground="#8993A2"/>
                        <TextBlock Grid.Column="1" FontSize="12" Foreground="#202A38"><Run Text="{Binding CompletedTaskCount, Mode=OneWay}"/><Run Text="项"/></TextBlock>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
        <Canvas Height="8" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <Path Canvas.Left="{Binding PointerLeft, ElementName=Root}" Width="14" Height="8" Data="M 0,0 L 7,7 L 14,0" Fill="White" Stroke="#E9ECF1" StrokeThickness="1"/>
        </Canvas>
    </Grid>
</UserControl>
