<UserControl x:Class="FocusApp.Desktop.Views.GoalFocusTimelineToolTip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource FontFamilyPrimary}" UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="SessionToolTipStyle" TargetType="ToolTip">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Border Width="180" Margin="8" Padding="14,13" Background="White" BorderBrush="#E5E7EB"
            BorderThickness="1" CornerRadius="12">
        <Border.Effect><DropShadowEffect Color="#243047" Opacity="0.10" BlurRadius="12" ShadowDepth="3" /></Border.Effect>
        <StackPanel>
            <TextBlock Text="{Binding TimelineTimeRangeDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="#111827" />
            <Grid Margin="0,13,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="实际专注" FontSize="13" Foreground="#8A919F" VerticalAlignment="Center" />
                <TextBlock x:Name="ActualDuration" Grid.Column="1" FontSize="13" FontWeight="Normal"
                           Foreground="#FF7A00" VerticalAlignment="Center"><Run Text="{Binding PoptipActualMinutesDisplay, Mode=OneWay}" /><Run Text="分钟" /></TextBlock>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
