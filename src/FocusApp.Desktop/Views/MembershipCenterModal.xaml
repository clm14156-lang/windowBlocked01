<UserControl x:Class="FocusApp.Desktop.Views.MembershipCenterModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="680" FontFamily="{DynamicResource FontFamilyPrimary}"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FocusApp.Desktop;component/Resources/StatisticsTypography.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
            <DrawingBrush x:Key="MembershipCardBrush" Stretch="Fill" Viewbox="0,0,630,138" ViewboxUnits="Absolute">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Geometry="M0,0 H630 V138 H0 Z">
                            <GeometryDrawing.Brush>
                                <LinearGradientBrush StartPoint="0.12,1" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#FBF3E8" />
                                    <GradientStop Offset="0.49" Color="#FCF0DF" />
                                    <GradientStop Offset="1" Color="#FEE4C4" />
                                </LinearGradientBrush>
                            </GeometryDrawing.Brush>
                        </GeometryDrawing>
                        <GeometryDrawing Geometry="M323,138 C404,103 467,47 630,114 V138 Z">
                            <GeometryDrawing.Brush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#00FFC277" />
                                    <GradientStop Offset="1" Color="#5EFFBB64" />
                                </LinearGradientBrush>
                            </GeometryDrawing.Brush>
                        </GeometryDrawing>
                        <GeometryDrawing Geometry="M390,138 C459,129 531,34 630,49 V138 Z">
                            <GeometryDrawing.Brush>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#00FFBC62" />
                                    <GradientStop Offset="1" Color="#74FFBB62" />
                                </LinearGradientBrush>
                            </GeometryDrawing.Brush>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfacePrimary}" BorderBrush="#F1E7DD" BorderThickness="1" CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" Direction="270" Opacity="0.12" ShadowDepth="4" Color="#A9937D" />
        </Border.Effect>
        <Grid>
            <Grid Margin="24,18,20,25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="144" />
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource MembershipCenterTitle}" VerticalAlignment="Center"
                           Style="{StaticResource DialogTitleTextStyle}" FontSize="18"
                           Foreground="{DynamicResource StatisticsPrimaryBrush}" />
                <Border x:Name="MembershipCard" Grid.Row="2" CornerRadius="18" Background="{StaticResource MembershipCardBrush}">
                    <Grid Margin="20,0,17,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="11" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="MembershipCrown" Width="80" Height="80" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Source="/FocusApp.Desktop;component/Assets/Images/Illustrations/MemberCenter_Crown.png">
                            <Image.Clip>
                                <PathGeometry Figures="M 113,71 A 17,17 0 1 1 138,77 L 166,124 L 205,107 A 16,16 0 1 1 219,107 L 194,185 Q 207,192 198,204 Q 196,209 185,209 H 70 Q 54,209 55,194 Q 56,188 64,184 L 42,109 A 16,16 0 1 1 60,102 L 90,124 L 120,77 Z">
                                    <PathGeometry.Transform><ScaleTransform ScaleX="0.3125" ScaleY="0.3125" /></PathGeometry.Transform>
                                </PathGeometry>
                            </Image.Clip>
                        </Image>
                        <Border Grid.Column="2" Background="#F4E0C8" Height="88" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="3" Margin="15,0,12,0" VerticalAlignment="Center">
                            <TextBlock x:Name="MembershipTitle" Text="{DynamicResource MembershipPremiumTitle}"
                                       Style="{StaticResource StatisticsHeadingTextStyle}" />
                            <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                <Path Width="23" Height="24" Margin="0,0,11,0" Stretch="Uniform" Stroke="#FF931A" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 3,4 H 19 Q 21,4 21,6 V 21 Q 21,23 19,23 H 3 Q 1,23 1,21 V 6 Q 1,4 3,4 Z M 1,10 H 21 M 6,2 V 6 M 16,2 V 6 M 6,14 H 7 M 10.5,14 H 11.5 M 15,14 H 16 M 6,18 H 7 M 10.5,18 H 11.5 M 15,18 H 16" />
                                <TextBlock x:Name="MembershipExpiry" Text="{Binding ExpiryText}"
                                           Style="{StaticResource StatisticsBodyTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="MembershipRemainingDays" Margin="0,7,0,0" Style="{StaticResource StatisticsMetricLabelStyle}"
                                       Visibility="{Binding CanRenew, Converter={StaticResource VisibleWhenTrue}}">
                                <Run Text="{DynamicResource MembershipDaysPrefix}" /><Run Text="{Binding DaysRemaining, Mode=OneWay}"
                                    Style="{StaticResource StatisticsValueRunStyle}" Foreground="#FD7E05" /><Run
                                    Text="{DynamicResource MembershipDaysUnit}" Style="{StaticResource StatisticsUnitRunStyle}" />
                            </TextBlock>
                        </StackPanel>
                        <Button x:Name="MembershipRenewButton" Grid.Column="4" Width="154" Height="46" VerticalAlignment="Center"
                                Style="{DynamicResource PrimaryActionButtonStyle}" Command="{Binding RenewCommand}"
                                AutomationProperties.Name="{DynamicResource MembershipRenew}"
                                Visibility="{Binding CanRenew, Converter={StaticResource VisibleWhenTrue}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="RenewSurface" CornerRadius="23">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FF961B" Offset="0" />
                                                <GradientStop Color="#FF7914" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RenewSurface" Property="Opacity" Value="0.88" /></Trigger>
                                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="RenewSurface" Property="Opacity" Value="0.76" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{DynamicResource PrimaryActionButtonLabelStyle}"
                                           Text="{DynamicResource MembershipRenew}" />
                                <Path Width="14" Height="10" Margin="6,0,0,0" VerticalAlignment="Center"
                                      Data="M 1,5 H 13 M 9,1 L 13,5 L 9,9" Stretch="Uniform"
                                      Stroke="White" StrokeThickness="1.5" StrokeLineJoin="Round" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
            <Button x:Name="ModalCloseButton" Margin="0,20,17,0" AutomationProperties.Name="{DynamicResource MembershipCenterClose}"
                    Command="{Binding CloseCommand}" Style="{DynamicResource ModalCloseButtonStyle}" />
        </Grid>
    </Border>
</UserControl>
