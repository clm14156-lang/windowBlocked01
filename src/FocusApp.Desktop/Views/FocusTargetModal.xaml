<UserControl x:Class="FocusApp.Desktop.Views.FocusTargetModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="336"
             Height="430"
             PreviewMouseDown="FocusTargetModal_PreviewMouseDown"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="TargetPlainButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecentTargetButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Background" Value="{DynamicResource BackgroundSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                MinWidth="67"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource RecentTargetDefaultBackgroundColor}" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{DynamicResource RecentTargetDefaultBorderColor}" />
                            </Border.BorderBrush>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding IsSelected}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="RecentTargetHoverStoryboard">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Root"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="{StaticResource RecentTargetHoverBackgroundColor}"
                                                            Duration="0:0:0.18" />
                                            <ColorAnimation Storyboard.TargetName="Root"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="{StaticResource RecentTargetHoverBorderColor}"
                                                            Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <RemoveStoryboard BeginStoryboardName="RecentTargetHoverStoryboard" />
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentTint}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                                <Setter Property="FontWeight" Value="Normal" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskEditorStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusTargetThinScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="5" />
            <Setter Property="MinWidth" Value="5" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Opacity" Value="0.16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="5" Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   Margin="0,3"
                                   IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Width="3"
                                                        HorizontalAlignment="Center"
                                                        Background="{DynamicResource TextSecondary}"
                                                        CornerRadius="1.5"
                                                        Opacity="0.62" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsTaskScrollBarActive, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                <Setter Property="Opacity" Value="0.68" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource OverlayBorder}"
            BorderThickness="1"
            CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" Direction="270" Opacity="0.11" ShadowDepth="6" />
        </Border.Effect>
        <Grid Margin="24,20,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="58" />
                <RowDefinition Height="18" />
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Margin="0,0,9,0"
                           VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="20"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="&#xE823;" />
                <TextBlock VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="{DynamicResource FocusTargetRecent}" />
            </StackPanel>
            <Grid Grid.Row="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Width="28" Height="36" AutomationProperties.Name="上一个目标" Command="{Binding ShowPreviousTargetsCommand}">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TargetPlainButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding CanShowPreviousTargets}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource TextSecondary}" Text="&#xE76B;" />
                </Button>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding VisibleTargets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button AutomationProperties.Name="{Binding Name}"
                                    Command="{Binding DataContext.SelectTargetCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding Name}"
                                    Style="{StaticResource RecentTargetButton}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Grid.Column="2" Width="28" Height="36" AutomationProperties.Name="{DynamicResource FocusTargetMore}" Command="{Binding ShowNextTargetsCommand}">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TargetPlainButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding CanShowNextTargets}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource TextSecondary}" Text="&#xE76C;" />
                </Button>
            </Grid>

            <Border Grid.Row="2"
                    Height="1"
                    VerticalAlignment="Center"
                    Background="{DynamicResource OverlayBorder}" />

            <Grid Grid.Row="3">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,9,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource TextPrimary}" Text="&#xE823;" />
                    <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource FocusTargetPendingTasks}" />
                </StackPanel>
                <Button Width="38"
                        Height="38"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="{DynamicResource FocusTargetAddTask}"
                        Command="{Binding BeginAddTaskCommand}"
                        Style="{StaticResource TargetPlainButton}">
                    <Border Width="34"
                            Height="34"
                            Background="{DynamicResource SurfacePrimary}"
                            BorderBrush="{DynamicResource OverlayBorder}"
                            BorderThickness="1"
                            CornerRadius="17">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="9" Direction="270" Opacity="0.10" ShadowDepth="2" />
                        </Border.Effect>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" FontWeight="Light" Foreground="{DynamicResource AccentPrimary}" Text="+" />
                    </Border>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="4"
                          Margin="0,2,0,10"
                          ScrollChanged="TaskScrollViewer_ScrollChanged"
                          VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource FocusTargetThinScrollBarStyle}" />
                </ScrollViewer.Resources>
                <StackPanel>
                    <Border Margin="0,0,0,4" BorderThickness="0">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAddingTask}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid Height="48">
                            <Ellipse Width="18" Height="18" Margin="4,0,0,0" HorizontalAlignment="Left" Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.3" />
                            <Grid Margin="32,4,28,4">
                                <TextBox x:Name="NewTaskTextBox"
                                         AutomationProperties.Name="{DynamicResource FocusTargetTaskPlaceholder}"
                                         IsVisibleChanged="Editor_IsVisibleChanged"
                                         KeyDown="NewTaskTextBox_KeyDown"
                                         LostKeyboardFocus="NewTaskTextBox_LostKeyboardFocus"
                                         Text="{Binding NewTaskName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TaskEditorStyle}" />
                                <TextBlock VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextTertiary}"
                                           Text="{DynamicResource FocusTargetTaskPlaceholder}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Margin" Value="11,0,0,0" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=NewTaskTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=NewTaskTextBox}" Value="True">
                                                    <Setter Property="Margin" Value="20,0,0,0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding CurrentTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="48"
                                        Margin="0"
                                        BorderBrush="{DynamicResource OverlayBorder}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="10"
                                        MouseEnter="TaskRow_MouseEnter"
                                        MouseLeave="TaskRow_MouseLeave">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BackgroundPrimary}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Ellipse Width="18" Height="18" Margin="4,0,0,0" HorizontalAlignment="Left" Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.3" />
                                        <TextBlock Margin="36,0,38,0" VerticalAlignment="Center" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource TextPrimary}" Text="{Binding Name}">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Margin="32,4,30,4"
                                                 AutomationProperties.Name="{DynamicResource FocusTargetEditTask}"
                                                 IsVisibleChanged="Editor_IsVisibleChanged"
                                                 KeyDown="EditTaskTextBox_KeyDown"
                                                 Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Style>
                                                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource TaskEditorStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                         <Button x:Name="TaskMenuButton"
                                                 Width="30"
                                                 Height="34"
                                                 HorizontalAlignment="Right"
                                                 AutomationProperties.Name="{DynamicResource FocusTargetTaskMenu}"
                                                 Command="{Binding DataContext.ToggleTaskMenuCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                 CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TargetPlainButton}">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsMenuButtonVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Margin="0,-7,0,0" FontSize="19" FontWeight="Medium" Foreground="{DynamicResource TextTertiary}" Text="..." />
                                        </Button>
                                        <Popup AllowsTransparency="True"
                                               IsOpen="{Binding IsMenuOpen, Mode=TwoWay}"
                                               Placement="Left"
                                               PlacementTarget="{Binding ElementName=TaskMenuButton}"
                                               StaysOpen="False">
                                            <Border Width="142" Height="92" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource OverlayBorder}" BorderThickness="1" CornerRadius="10">
                                                <Border.Effect><DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.18" ShadowDepth="5" /></Border.Effect>
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="1" /><RowDefinition /></Grid.RowDefinitions>
                                                    <Button Click="EditTaskButton_Click" Style="{StaticResource TargetPlainButton}">
                                                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                                            <TextBlock Width="28" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE70F;" />
                                                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="{DynamicResource FocusTargetEditTask}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Border Grid.Row="1" Background="{DynamicResource BorderPrimary}" />
                                                    <Button Grid.Row="2" Click="DeleteTaskButton_Click" Style="{StaticResource TargetPlainButton}">
                                                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                                            <TextBlock Width="28" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource Danger}" Text="&#xE74D;" />
                                                            <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Danger}" Text="{DynamicResource FocusTargetDeleteTask}" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="5">
                <Button Height="48"
                        AutomationProperties.Name="{DynamicResource FocusTargetCreateNew}"
                        Command="{Binding BeginCreateTargetCommand}">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TargetPlainButton}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCreatingTarget}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasSelectedTarget}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Border Width="286"
                            Height="48"
                            Background="{DynamicResource SurfacePrimary}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{DynamicResource CreateTargetDefaultBorderColor}" />
                        </Border.BorderBrush>
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                    To="{StaticResource CreateTargetHoverBorderColor}"
                                                                    Duration="0:0:0.18" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                    To="{StaticResource CreateTargetDefaultBorderColor}"
                                                                    Duration="0:0:0.18" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Margin="0,-2,9,0" VerticalAlignment="Center" FontSize="24" FontWeight="Light" Foreground="{DynamicResource AccentPrimary}" Text="+" />
                            <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource AccentPrimary}" Text="{DynamicResource FocusTargetCreateNew}" />
                        </StackPanel>
                    </Border>
                </Button>

                <Grid Height="48">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedTarget}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            AutomationProperties.Name="{DynamicResource FocusTargetCancel}"
                            Command="{Binding CancelSelectionCommand}"
                            Style="{StaticResource TargetPlainButton}">
                        <Border Width="139"
                                Height="48"
                                Background="{DynamicResource SurfacePrimary}"
                                BorderBrush="{DynamicResource BorderPrimary}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="Normal"
                                       Text="{DynamicResource FocusTargetCancel}" />
                        </Border>
                    </Button>
                    <Button Grid.Column="2"
                            AutomationProperties.Name="{DynamicResource FocusTargetConfirm}"
                            Command="{Binding ConfirmSelectionCommand}"
                            Style="{StaticResource TargetPlainButton}">
                        <Border Width="139"
                                Height="48"
                                Background="{DynamicResource FocusButtonBackground}"
                                CornerRadius="12">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource WhiteText}"
                                       Text="{DynamicResource FocusTargetConfirm}" />
                        </Border>
                    </Button>
                </Grid>

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCreatingTarget}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Grid>
                        <TextBox x:Name="NewTargetTextBox"
                                 Height="42"
                                 AutomationProperties.Name="{DynamicResource FocusTargetNamePlaceholder}"
                                 IsVisibleChanged="Editor_IsVisibleChanged"
                                 Text="{Binding NewTargetName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TaskEditorStyle}" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13" Foreground="{DynamicResource TextTertiary}" Text="{DynamicResource FocusTargetNamePlaceholder}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=NewTargetTextBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <StackPanel Margin="0,9,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Width="76" Height="36" AutomationProperties.Name="{DynamicResource FocusTargetCancel}" Command="{Binding CancelCreateTargetCommand}" Content="{DynamicResource FocusTargetCancel}" Style="{StaticResource RecentTargetButton}" />
                        <Button Width="82" Height="36" Margin="8,0,0,0" AutomationProperties.Name="{DynamicResource FocusTargetCreate}" Command="{Binding CreateTargetCommand}" IsEnabled="{Binding CanCreateTarget}" Style="{StaticResource TargetPlainButton}">
                            <Border Width="82" Height="36" Background="{DynamicResource FocusButtonBackground}" CornerRadius="9">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource WhiteText}" Text="{DynamicResource FocusTargetCreate}" />
                            </Border>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
