<UserControl x:Class="FocusApp.Desktop.Views.FocusTargetModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="336"
             Height="430"
             PreviewMouseDown="FocusTargetModal_PreviewMouseDown"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="TargetPlainButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TargetChevronButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource FocusTargetChevronBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.58" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TargetAddButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Background="Transparent">
                            <Border x:Name="Surface"
                                    Width="34"
                                    Height="34"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SurfacePrimary}"
                                    BorderBrush="{DynamicResource BorderPrimary}"
                                    BorderThickness="1"
                                    CornerRadius="17">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="5" Direction="270" Opacity="0.055" ShadowDepth="1" />
                                </Border.Effect>
                                <TextBlock x:Name="Glyph"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="25"
                                           FontWeight="Light"
                                           Foreground="{DynamicResource AccentPrimary}"
                                           Text="+" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource FocusTargetSubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource FocusTargetSubtlePressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource BackgroundSecondary}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextWeak}" />
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TargetCloseButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="CloseSurface"
                                Width="28"
                                Height="28"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="17"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="×" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseSurface" Property="Background" Value="{DynamicResource FocusTargetSubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseSurface" Property="Background" Value="{DynamicResource FocusTargetSubtlePressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EmptyTargetCreateButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="206" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="21">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentTint}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecentTargetButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Background" Value="{DynamicResource BackgroundSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                MinWidth="67"
                                Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource RecentTargetDefaultBackgroundColor}"
                                BorderBrush="{DynamicResource RecentTargetDefaultBorderColor}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding IsSelected}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource RecentTargetHoverBackgroundColor}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource RecentTargetHoverBorderColor}" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource RecentTargetSelectedBackground}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource RecentTargetSelectedBorder}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                                <Setter Property="FontWeight" Value="Normal" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding IsSelected}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource RecentTargetPressedBackground}" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding IsSelected}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource RecentTargetSelectedPressedBackground}" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskEditorStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0"
                                          Padding="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusTargetThinScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="5" />
            <Setter Property="MinWidth" Value="5" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Opacity" Value="0.16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="5" Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   Margin="0,3"
                                   IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Width="3"
                                                        HorizontalAlignment="Center"
                                                        Background="{DynamicResource TextSecondary}"
                                                        CornerRadius="1.5"
                                                        Opacity="0.62" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsTaskScrollBarActive, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                <Setter Property="Opacity" Value="0.68" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource OverlayBorder}"
            BorderThickness="1"
            CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.075" ShadowDepth="3" />
        </Border.Effect>
        <Grid Margin="24,20,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="58" />
                <RowDefinition Height="18" />
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button x:Name="TargetModalCloseButton"
                    Grid.RowSpan="6"
                    Margin="0,-4,-4,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Panel.ZIndex="5"
                    AutomationProperties.Name="{DynamicResource FocusTargetClose}"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource TargetCloseButton}" />

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Margin="0,0,9,0"
                           VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="18"
                           Foreground="{DynamicResource FocusTargetIconBrush}"
                           Text="&#xE823;" />
                <TextBlock VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="{DynamicResource FocusTargetRecent}" />
            </StackPanel>
            <Grid Grid.Row="1"
                  VerticalAlignment="Center"
                  Visibility="{Binding HasTargets, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Width="28" Height="36" AutomationProperties.Name="上一个目标" Command="{Binding ShowPreviousTargetsCommand}">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TargetChevronButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding CanShowPreviousTargets}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Text="&#xE76B;" />
                </Button>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding VisibleTargets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button AutomationProperties.Name="{Binding Name}"
                                    Command="{Binding DataContext.SelectTargetCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource RecentTargetButton}">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                    <Image Width="18"
                                           Height="18"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           SnapsToDevicePixels="True"
                                           Source="{Binding IconSource}"
                                           Stretch="Uniform" />
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                               Text="{Binding Name}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Grid.Column="2" Width="28" Height="36" AutomationProperties.Name="{DynamicResource FocusTargetMore}" Command="{Binding ShowNextTargetsCommand}">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TargetChevronButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding CanShowNextTargets}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Text="&#xE76C;" />
                </Button>
            </Grid>

            <Border Grid.Row="2"
                    Height="1"
                    VerticalAlignment="Center"
                    Background="{DynamicResource FocusTargetDividerBrush}"
                    Visibility="{Binding HasTargets, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Grid Grid.Row="3"
                  Visibility="{Binding HasTargets, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,9,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource FocusTargetIconBrush}" Text="&#xE823;" />
                    <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource FocusTargetPendingTasks}" />
                </StackPanel>
                <Button Width="38"
                        Height="38"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="{DynamicResource FocusTargetAddTask}"
                        Command="{Binding BeginAddTaskCommand}"
                        Visibility="{Binding HasTargets, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Style="{StaticResource TargetAddButton}" />
            </Grid>

            <ScrollViewer Grid.Row="4"
                          Margin="0,2,0,0"
                          ScrollChanged="TaskScrollViewer_ScrollChanged"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasTargets, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer.Resources>
                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource FocusTargetThinScrollBarStyle}" />
                </ScrollViewer.Resources>
                <StackPanel>
                    <Border Margin="0,0,0,4" BorderThickness="0">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAddingTask}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid x:Name="NewTaskEntryRow" Height="48">
                            <Ellipse Width="18" Height="18" Margin="4,0,0,0" HorizontalAlignment="Left" Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.3" />
                            <Grid x:Name="NewTaskEditorContainer" Margin="32,4,28,4">
                                <TextBox x:Name="NewTaskTextBox"
                                         AutomationProperties.Name="{DynamicResource FocusTargetTaskPlaceholder}"
                                         IsVisibleChanged="Editor_IsVisibleChanged"
                                         KeyDown="NewTaskTextBox_KeyDown"
                                         LostKeyboardFocus="NewTaskTextBox_LostKeyboardFocus"
                                         Text="{Binding NewTaskName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TaskEditorStyle}" />
                                <TextBlock VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextTertiary}"
                                           Text="{DynamicResource FocusTargetTaskPlaceholder}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Margin" Value="11,0,0,0" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=NewTaskTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=NewTaskTextBox}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding CurrentTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="46"
                                        Margin="0"
                                        BorderBrush="{DynamicResource FocusTargetDividerBrush}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="10"
                                        MouseEnter="TaskRow_MouseEnter"
                                        MouseLeave="TaskRow_MouseLeave">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BackgroundPrimary}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="30" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="18" Height="18" Margin="4,0,0,0" HorizontalAlignment="Left" Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.3" />
                                        <TextBlock x:Name="TaskNameText"
                                                   Grid.Column="1"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="Normal"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock x:Name="TaskCreatedDateText"
                                                   Grid.Column="2"
                                                   Margin="4,0,6,0"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="Normal"
                                                   Foreground="{DynamicResource TextWeak}"
                                                   Text="{Binding CreatedDateDisplay}">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsHovered}" Value="True" />
                                                                <Condition Binding="{Binding IsEditing}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Grid.Column="1"
                                                 Grid.ColumnSpan="2"
                                                 Margin="0,4,4,4"
                                                 AutomationProperties.Name="{DynamicResource FocusTargetEditTask}"
                                                 IsVisibleChanged="Editor_IsVisibleChanged"
                                                 KeyDown="EditTaskTextBox_KeyDown"
                                                 LostKeyboardFocus="EditTaskTextBox_LostKeyboardFocus"
                                                 Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Style>
                                                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource TaskEditorStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                         <Button x:Name="TaskMenuButton"
                                                 Grid.Column="3"
                                                 Width="30"
                                                 Height="34"
                                                 HorizontalAlignment="Right"
                                                 AutomationProperties.Name="{DynamicResource FocusTargetTaskMenu}"
                                                 Command="{Binding DataContext.ToggleTaskMenuCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                 CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TargetPlainButton}">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsMenuButtonVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Margin="0,-7,0,0" FontSize="19" FontWeight="Medium" Foreground="{DynamicResource TextTertiary}" Text="..." />
                                        </Button>
                                        <Popup Grid.Column="3"
                                               AllowsTransparency="True"
                                               IsOpen="{Binding IsMenuOpen, Mode=TwoWay}"
                                               Placement="Left"
                                               PlacementTarget="{Binding ElementName=TaskMenuButton}"
                                               StaysOpen="False">
                                            <Border Width="142" Height="92" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource OverlayBorder}" BorderThickness="1" CornerRadius="10">
                                                <Border.Effect><DropShadowEffect BlurRadius="14" Direction="270" Opacity="0.10" ShadowDepth="3" /></Border.Effect>
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="1" /><RowDefinition /></Grid.RowDefinitions>
                                                    <Button Click="EditTaskButton_Click" Style="{StaticResource TargetPlainButton}">
                                                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                                            <TextBlock Width="28" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE70F;" />
                                                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="{DynamicResource FocusTargetEditTask}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Border Grid.Row="1" Background="{DynamicResource BorderPrimary}" />
                                                    <Button Grid.Row="2" Click="DeleteTaskButton_Click" Style="{StaticResource TargetPlainButton}">
                                                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                                            <TextBlock Width="28" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource Danger}" Text="&#xE74D;" />
                                                            <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Danger}" Text="{DynamicResource FocusTargetDeleteTask}" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="EmptyTargetState"
                  Grid.Row="1"
                  Grid.RowSpan="5"
                  Panel.ZIndex="2"
                  Background="{DynamicResource SurfacePrimary}">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasTargets}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Width="150"
                           Height="118"
                           HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="/FocusApp.Desktop;component/Assets/Images/Illustrations/create-target.png"
                           Stretch="Uniform" />
                    <TextBlock Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               FontSize="15"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"
                               Text="{DynamicResource FocusTargetEmptyTitle}" />
                    <TextBlock Margin="0,5,0,0"
                               HorizontalAlignment="Center"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="{DynamicResource FocusTargetEmptyDescription}" />
                    <Button Margin="0,24,0,0"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="{DynamicResource FocusTargetCreateNew}"
                            Command="{Binding CreateNewTargetCommand}"
                            Style="{StaticResource EmptyTargetCreateButton}">
                        <Grid Height="20"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="9" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="CreateTargetPlusGlyph"
                                  Grid.Column="0"
                                  Width="14"
                                  Height="20"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Path Width="14"
                                      Height="14"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 1,7 L 13,7 M 7,1 L 7,13"
                                      Stroke="{DynamicResource AccentPrimary}"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="1.2" />
                            </Grid>
                            <TextBlock Grid.Column="2"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource AccentPrimary}"
                                       LineHeight="20"
                                       LineStackingStrategy="BlockLineHeight"
                                       Text="{DynamicResource FocusTargetCreateNew}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="5">
                <Button Height="48"
                        AutomationProperties.Name="{DynamicResource FocusTargetCreateNew}"
                        Command="{Binding CreateNewTargetCommand}">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TargetPlainButton}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDraftSelectedTarget}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasTargets}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Border Width="286"
                            Height="48"
                            Background="{DynamicResource SurfacePrimary}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{DynamicResource CreateTargetDefaultBorderColor}" />
                        </Border.BorderBrush>
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                    To="{StaticResource CreateTargetHoverBorderColor}"
                                                                    Duration="0:0:0.18" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                    To="{StaticResource CreateTargetDefaultBorderColor}"
                                                                    Duration="0:0:0.18" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Margin="0,-2,9,0" VerticalAlignment="Center" FontSize="24" FontWeight="Light" Foreground="{DynamicResource AccentPrimary}" Text="+" />
                            <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource AccentPrimary}" Text="{DynamicResource FocusTargetCreateNew}" />
                        </StackPanel>
                    </Border>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
