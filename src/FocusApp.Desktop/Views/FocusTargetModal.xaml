<UserControl x:Class="FocusApp.Desktop.Views.FocusTargetModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="350"
             Height="380"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="TargetCloseButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="CloseSurface"
                                Width="28"
                                Height="28"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="17"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="×" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseSurface" Property="Background" Value="{DynamicResource FocusTargetSubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseSurface" Property="Background" Value="{DynamicResource FocusTargetSubtlePressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EmptyTargetCreateButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="206" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="21">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentTint}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Border Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource OverlayBorder}"
            BorderThickness="1"
            CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.075" ShadowDepth="3" />
        </Border.Effect>
        <Grid Margin="24,20,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="58" />
                <RowDefinition Height="18" />
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button x:Name="TargetModalCloseButton"
                    Grid.RowSpan="6"
                    Margin="0,-4,-4,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Panel.ZIndex="5"
                    AutomationProperties.Name="{DynamicResource FocusTargetClose}"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource TargetCloseButton}" />

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Margin="0,0,9,0"
                           VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="18"
                           Foreground="{DynamicResource FocusTargetIconBrush}"
                           Text="&#xE823;" />
                <TextBlock VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="{DynamicResource FocusTargetRecent}" />
            </StackPanel>
            <Grid x:Name="ExistingTargetState"
                  Grid.Row="1"
                  Grid.RowSpan="5"
                  Background="{DynamicResource SurfacePrimary}">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasTargets}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
            </Grid>

            <Grid x:Name="EmptyTargetState"
                  Grid.Row="1"
                  Grid.RowSpan="5"
                  Panel.ZIndex="2"
                  Background="{DynamicResource SurfacePrimary}">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasTargets}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Width="150"
                           Height="118"
                           HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="/FocusApp.Desktop;component/Assets/Images/Illustrations/create-target.png"
                           Stretch="Uniform" />
                    <TextBlock Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               FontSize="15"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"
                               Text="{DynamicResource FocusTargetEmptyTitle}" />
                    <TextBlock Margin="0,5,0,0"
                               HorizontalAlignment="Center"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="{DynamicResource FocusTargetEmptyDescription}" />
                    <Button Margin="0,24,0,0"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="{DynamicResource FocusTargetCreateNew}"
                            Command="{Binding CreateNewTargetCommand}"
                            Style="{StaticResource EmptyTargetCreateButton}">
                        <Grid Height="20"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="9" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="CreateTargetPlusGlyph"
                                  Grid.Column="0"
                                  Width="14"
                                  Height="20"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Path Width="14"
                                      Height="14"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 1,7 L 13,7 M 7,1 L 7,13"
                                      Stroke="{DynamicResource AccentPrimary}"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="1.2" />
                            </Grid>
                            <TextBlock Grid.Column="2"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource AccentPrimary}"
                                       LineHeight="20"
                                       LineStackingStrategy="BlockLineHeight"
                                       Text="{DynamicResource FocusTargetCreateNew}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</UserControl>
