<UserControl x:Class="FocusApp.Desktop.Views.FocusTargetModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="320"
             Height="435"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="TargetPlainButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecentTargetButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                MinWidth="67"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentTint}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskEditorStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource OverlayBorder}"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" Direction="270" Opacity="0.16" ShadowDepth="8" />
        </Border.Effect>
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="50" />
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Margin="0,0,9,0"
                           VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="19"
                           Text="&#xE823;" />
                <TextBlock VerticalAlignment="Center"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Text="{DynamicResource FocusTargetRecent}" />
            </StackPanel>
            <Button Width="28"
                    Height="28"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="{DynamicResource FocusTargetClose}"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource TargetPlainButton}">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TextSecondary}" Text="&#xE8BB;" />
            </Button>

            <Grid Grid.Row="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{Binding VisibleTargets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button AutomationProperties.Name="{Binding Name}"
                                    Command="{Binding DataContext.SelectTargetCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding Name}"
                                    Style="{StaticResource RecentTargetButton}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Grid.Column="1"
                        Width="28"
                        Height="36"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="{DynamicResource FocusTargetMore}"
                        Command="{Binding ShowMoreTargetsCommand}">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TargetPlainButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMoreTargets}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource TextSecondary}" Text="&#xE76C;" />
                </Button>
            </Grid>

            <Grid Grid.Row="2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,9,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="19" Text="&#xE823;" />
                    <TextBlock VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="{DynamicResource FocusTargetPendingTasks}" />
                </StackPanel>
                <Button Width="32"
                        Height="32"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="{DynamicResource FocusTargetAddTask}"
                        Command="{Binding BeginAddTaskCommand}"
                        Style="{StaticResource TargetPlainButton}">
                    <Border Width="28" Height="28" Background="{DynamicResource AccentPrimary}" CornerRadius="14">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="23" FontWeight="Light" Foreground="{DynamicResource WhiteText}" Text="+" />
                    </Border>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="3" Margin="0,4,0,8" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Margin="0,0,0,7" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="9">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAddingTask}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid Height="46">
                            <Ellipse Width="17" Height="17" Margin="12,0,0,0" HorizontalAlignment="Left" Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.4" />
                            <Grid Margin="39,4,34,4">
                                <TextBox x:Name="NewTaskTextBox"
                                         AutomationProperties.Name="{DynamicResource FocusTargetTaskPlaceholder}"
                                         IsVisibleChanged="Editor_IsVisibleChanged"
                                         KeyDown="NewTaskTextBox_KeyDown"
                                         Text="{Binding NewTaskName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TaskEditorStyle}" />
                                <TextBlock Margin="11,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextTertiary}"
                                           Text="{DynamicResource FocusTargetTaskPlaceholder}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=NewTaskTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding CurrentTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="46" Margin="0,0,0,7" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="9">
                                    <Grid>
                                        <Ellipse Width="17" Height="17" Margin="12,0,0,0" HorizontalAlignment="Left" Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.4" />
                                        <TextBlock Margin="40,0,38,0" VerticalAlignment="Center" FontSize="13" Text="{Binding Name}">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Margin="38,4,34,4"
                                                 AutomationProperties.Name="{DynamicResource FocusTargetEditTask}"
                                                 IsVisibleChanged="Editor_IsVisibleChanged"
                                                 KeyDown="EditTaskTextBox_KeyDown"
                                                 Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Style>
                                                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource TaskEditorStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <Button x:Name="TaskMenuButton"
                                                Width="30"
                                                Height="34"
                                                HorizontalAlignment="Right"
                                                AutomationProperties.Name="{DynamicResource FocusTargetTaskMenu}"
                                                Command="{Binding DataContext.ToggleTaskMenuCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TargetPlainButton}">
                                            <TextBlock Margin="0,-7,0,0" FontSize="19" FontWeight="SemiBold" Text="..." />
                                        </Button>
                                        <Popup AllowsTransparency="True"
                                               IsOpen="{Binding IsMenuOpen, Mode=TwoWay}"
                                               Placement="Left"
                                               PlacementTarget="{Binding ElementName=TaskMenuButton}"
                                               StaysOpen="False">
                                            <Border Width="142" Height="92" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource OverlayBorder}" BorderThickness="1" CornerRadius="10">
                                                <Border.Effect><DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.18" ShadowDepth="5" /></Border.Effect>
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="1" /><RowDefinition /></Grid.RowDefinitions>
                                                    <Button Click="EditTaskButton_Click" Style="{StaticResource TargetPlainButton}">
                                                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                                            <TextBlock Width="28" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE70F;" />
                                                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="{DynamicResource FocusTargetEditTask}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Border Grid.Row="1" Background="{DynamicResource BorderPrimary}" />
                                                    <Button Grid.Row="2" Click="DeleteTaskButton_Click" Style="{StaticResource TargetPlainButton}">
                                                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                                            <TextBlock Width="28" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource Danger}" Text="&#xE74D;" />
                                                            <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Danger}" Text="{DynamicResource FocusTargetDeleteTask}" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="4">
                <Button Height="43"
                        AutomationProperties.Name="{DynamicResource FocusTargetCreateNew}"
                        Command="{Binding BeginCreateTargetCommand}">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TargetPlainButton}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCreatingTarget}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid Width="280" Height="43">
                        <Rectangle Stroke="{DynamicResource AccentPrimary}" StrokeDashArray="4,3" StrokeThickness="1" RadiusX="9" RadiusY="9" />
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Margin="0,-2,8,0" VerticalAlignment="Center" FontSize="24" Foreground="{DynamicResource AccentPrimary}" Text="+" />
                            <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" Text="{DynamicResource FocusTargetCreateNew}" />
                        </StackPanel>
                    </Grid>
                </Button>

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCreatingTarget}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Grid>
                        <TextBox x:Name="NewTargetTextBox"
                                 Height="42"
                                 AutomationProperties.Name="{DynamicResource FocusTargetNamePlaceholder}"
                                 IsVisibleChanged="Editor_IsVisibleChanged"
                                 Text="{Binding NewTargetName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TaskEditorStyle}" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13" Foreground="{DynamicResource TextTertiary}" Text="{DynamicResource FocusTargetNamePlaceholder}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=NewTargetTextBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <StackPanel Margin="0,9,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Width="76" Height="36" AutomationProperties.Name="{DynamicResource FocusTargetCancel}" Command="{Binding CancelCreateTargetCommand}" Content="{DynamicResource FocusTargetCancel}" Style="{StaticResource RecentTargetButton}" />
                        <Button Width="82" Height="36" Margin="8,0,0,0" AutomationProperties.Name="{DynamicResource FocusTargetCreate}" Command="{Binding CreateTargetCommand}" IsEnabled="{Binding CanCreateTarget}" Style="{StaticResource TargetPlainButton}">
                            <Border Width="82" Height="36" Background="{DynamicResource FocusButtonBackground}" CornerRadius="9">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource WhiteText}" Text="{DynamicResource FocusTargetCreate}" />
                            </Border>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
