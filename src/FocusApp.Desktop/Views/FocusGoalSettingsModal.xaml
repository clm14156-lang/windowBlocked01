<UserControl x:Class="FocusApp.Desktop.Views.FocusGoalSettingsModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="390"
             Height="{Binding DialogHeight, Mode=OneWay}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             PreviewMouseDown="FocusGoalSettingsModal_PreviewMouseDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="FocusGoalSegmentButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource BackgroundSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#6E6E73" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="SegmentChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentChrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SegmentChrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusGoalStepperButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="StepperChrome" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StepperChrome" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StepperChrome" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusGoalRepeatButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource FocusGoalSegmentButtonStyle}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style x:Key="FocusGoalTargetHoursInputStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Width" Value="78" />
            <Setter Property="Height" Value="58" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyNumeric}" />
            <Setter Property="FontSize" Value="38" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="FocusGoalWeekdayButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="{DynamicResource BackgroundSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#6E6E73" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="WeekdayChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="WeekdayChrome" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="WeekdayChrome" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusGoalSecondaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="SecondaryChrome" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecondaryChrome" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SecondaryChrome" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusGoalPrimaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="104" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="PrimaryChrome"
                                Background="{TemplateBinding Background}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                CornerRadius="11">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryChrome" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimaryChrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusGoalDangerMenuItemStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="DangerMenuItemChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DangerMenuItemChrome" Property="Background" Value="#FFF1F0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DangerMenuItemChrome" Property="Background" Value="#FFE5E2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="FocusGoalSettingsCard"
            Width="390"
            Height="{Binding DialogHeight, Mode=OneWay}"
            Padding="24,16,24,16"
            Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource BorderPrimary}"
            BorderThickness="1"
            CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Direction="270" Opacity="0.17" ShadowDepth="6" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="86" />
                <RowDefinition Height="*" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock VerticalAlignment="Center"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="专注目标" />
                <Button x:Name="FocusGoalMoreButton"
                        Width="38"
                        Height="30"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasSavedTarget, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Content="•••"
                        Click="FocusGoalMoreButton_Click"
                        PreviewMouseDown="FocusGoalMoreButton_PreviewMouseDown"
                        FontSize="15"
                        Foreground="{DynamicResource TextSecondary}"
                        FocusVisualStyle="{x:Null}">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="MoreButtonChrome"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="MoreButtonChrome"
                                                        Property="Background"
                                                        Value="{DynamicResource ControlHoverBackground}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Popup x:Name="FocusGoalMoreMenu"
                       AllowsTransparency="True"
                       Closed="FocusGoalMoreMenu_Closed"
                       Focusable="False"
                       HorizontalOffset="-66"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=FocusGoalMoreButton}"
                       StaysOpen="False"
                       VerticalOffset="4">
                    <Border Width="104"
                            Padding="5"
                            Background="#FFFFFF"
                            BorderBrush="#E5E5EA"
                            BorderThickness="1"
                            CornerRadius="9">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Direction="270" Opacity="0.14" ShadowDepth="3" />
                        </Border.Effect>
                        <Button Content="删除目标"
                                Click="DeleteFocusGoalMenuItem_Click"
                                Foreground="{DynamicResource Danger}"
                                Style="{StaticResource FocusGoalDangerMenuItemStyle}" />
                    </Border>
                </Popup>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="目标模式" />
                <Border Height="50"
                        Margin="0,6,0,0"
                        Background="{DynamicResource BackgroundSecondary}"
                        BorderBrush="{DynamicResource BorderPrimary}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="DailyFixedModeButton"
                            Grid.Column="0"
                            Command="{Binding SelectDailyModeCommand}">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource FocusGoalSegmentButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDailyFixedMode}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentTint}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBorder}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Margin="0,0,7,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       Text="&#xE787;" />
                            <TextBlock VerticalAlignment="Center" Text="每日固定" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MonthlyTotalModeButton"
                            Grid.Column="1"
                            Command="{Binding SelectMonthlyModeCommand}">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource FocusGoalSegmentButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonthlyTotalMode}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentTint}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBorder}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Margin="0,0,7,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       Text="&#xE9D2;" />
                            <TextBlock VerticalAlignment="Center" Text="每月总目标" />
                        </StackPanel>
                    </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,4,0,0">
                <StackPanel x:Name="DailyFixedContent">
                    <StackPanel.Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDailyFixedMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Margin="0,10,0,5" FontSize="16" FontWeight="SemiBold" Text="目标时长" />
                    <Border Height="58"
                            Background="{DynamicResource SurfacePrimary}"
                            BorderBrush="{DynamicResource BorderPrimary}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    AutomationProperties.Name="减少每日目标时长"
                                    Command="{Binding DecreaseDailyTargetCommand}"
                                    Content="−"
                                    Style="{StaticResource FocusGoalStepperButtonStyle}" />
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBox x:Name="DailyTargetHoursInputBox"
                                         Tag="Daily"
                                         MaxLength="2"
                                         Style="{StaticResource FocusGoalTargetHoursInputStyle}"
                                         Text="{Binding DailyTargetHoursInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextChanged="TargetHoursInputBox_TextChanged"
                                         PreviewKeyDown="TargetHoursInputBox_PreviewKeyDown"
                                         PreviewTextInput="TargetHoursInputBox_PreviewTextInput"
                                         LostKeyboardFocus="TargetHoursInputBox_LostKeyboardFocus"
                                         DataObject.Pasting="TargetHoursInputBox_Pasting" />
                                <TextBlock Margin="8,7,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Text="小时" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    AutomationProperties.Name="增加每日目标时长"
                                    Command="{Binding IncreaseDailyTargetCommand}"
                                    Content="+"
                                    Style="{StaticResource FocusGoalStepperButtonStyle}" />
                        </Grid>
                    </Border>
                    <TextBlock Margin="0,10,0,5" FontSize="16" FontWeight="SemiBold" Text="重复" />
                    <Grid Height="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="EveryDayRepeatButton"
                                Grid.Column="0"
                                Command="{Binding SelectEveryDayCommand}">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource FocusGoalRepeatButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEveryDay}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentTint}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBorder}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Margin="0,0,7,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                           Text="&#xE895;" />
                                <TextBlock VerticalAlignment="Center" Text="每天" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CustomRepeatButton"
                                Grid.Column="1"
                                Command="{Binding SelectCustomRepeatCommand}">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource FocusGoalRepeatButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustomRepeat}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentTint}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBorder}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Margin="0,0,7,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="17"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                           Text="&#xE787;" />
                                <TextBlock VerticalAlignment="Center" Text="自定义" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Weekdays}">
                        <ItemsControl.Style>
                            <Style TargetType="{x:Type ItemsControl}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCustomRepeat}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button AutomationProperties.Name="{Binding Label}"
                                        Command="{Binding DataContext.ToggleWeekdayCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource FocusGoalWeekdayButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#FF8000" />
                                                    <Setter Property="BorderBrush" Value="#FF8000" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="MonthlyTotalContent">
                    <StackPanel.Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMonthlyTotalMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Margin="0,10,0,5" FontSize="16" FontWeight="SemiBold" Text="目标时长" />
                    <Border Height="58"
                            Background="{DynamicResource SurfacePrimary}"
                            BorderBrush="{DynamicResource BorderPrimary}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    AutomationProperties.Name="减少每月目标时长"
                                    Command="{Binding DecreaseMonthlyTargetCommand}"
                                    Content="−"
                                    Style="{StaticResource FocusGoalStepperButtonStyle}" />
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBox x:Name="MonthlyTargetHoursInputBox"
                                         Tag="Monthly"
                                         MaxLength="3"
                                         Style="{StaticResource FocusGoalTargetHoursInputStyle}"
                                         Text="{Binding MonthlyTargetHoursInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextChanged="TargetHoursInputBox_TextChanged"
                                         PreviewKeyDown="TargetHoursInputBox_PreviewKeyDown"
                                         PreviewTextInput="TargetHoursInputBox_PreviewTextInput"
                                         LostKeyboardFocus="TargetHoursInputBox_LostKeyboardFocus"
                                         DataObject.Pasting="TargetHoursInputBox_Pasting" />
                                <TextBlock Margin="8,7,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Text="小时" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    AutomationProperties.Name="增加每月目标时长"
                                    Command="{Binding IncreaseMonthlyTargetCommand}"
                                    Content="+"
                                    Style="{StaticResource FocusGoalStepperButtonStyle}" />
                        </Grid>
                    </Border>
                    <Grid Margin="0,14,0,0" Height="56">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="24"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="&#xE787;" />
                            <StackPanel>
                                <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="剩余" />
                                <TextBlock Margin="0,2,0,0" FontSize="18" FontWeight="SemiBold">
                                    <Run Text="{Binding RemainingDays, Mode=OneWay}" />
                                    <Run Text="天" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Width="1" Margin="0,2" Background="{DynamicResource BorderPrimary}" />
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="24"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="&#xE9D2;" />
                            <StackPanel>
                                <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="还差" />
                                <TextBlock Margin="0,2,0,0" FontSize="18" FontWeight="SemiBold">
                                    <Run Text="{Binding RemainingHours, Mode=OneWay}" />
                                    <Run Text="小时" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>

            <Border Grid.Row="3"
                    Margin="0,10,0,0"
                    Padding="0,10,0,0"
                    BorderBrush="{DynamicResource BorderPrimary}"
                    BorderThickness="0,1,0,0">
                <Grid Height="40">
                    <Button x:Name="TargetSettingsCancelButton"
                            HorizontalAlignment="Right"
                            Margin="0,0,108,0"
                            Command="{Binding CancelCommand}"
                            Content="取消"
                            Style="{StaticResource FocusGoalSecondaryButtonStyle}" />
                    <Button x:Name="TargetSettingsSaveButton"
                            HorizontalAlignment="Right"
                            Command="{Binding SaveCommand}"
                            Content="保存"
                            Style="{StaticResource FocusGoalPrimaryButtonStyle}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
