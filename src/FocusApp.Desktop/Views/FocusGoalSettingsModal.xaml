<UserControl x:Class="FocusApp.Desktop.Views.FocusGoalSettingsModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="330" Height="{Binding DialogHeight, Mode=OneWay}"
             TextElement.FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             IsVisibleChanged="FocusGoalSettingsModal_IsVisibleChanged" Unloaded="FocusGoalSettingsModal_Unloaded"
             PreviewMouseDown="FocusGoalSettingsModal_PreviewMouseDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="FocusGoalSegmentButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="3" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#858B99" /><Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="SegmentChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="24">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SegmentChrome" Property="Opacity" Value="0.85" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="SegmentChrome" Property="Opacity" Value="0.7" /></Trigger>
                    <Trigger Property="Background" Value="White"><Setter TargetName="SegmentChrome" Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.09" /></Setter.Value></Setter></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FocusGoalStepperButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44" /><Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" /><Setter Property="Background" Value="#F4F4F7" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="#858B99" />
            <Setter Property="FontSize" Value="28" /><Setter Property="FontWeight" Value="Light" />
            <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="StepperChrome" Background="{TemplateBinding Background}" CornerRadius="22">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StepperChrome" Property="Background" Value="#EDEEF2" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="StepperChrome" Property="Background" Value="#E5E6EC" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FocusGoalTargetHoursInputStyle" TargetType="TextBox">
            <Setter Property="Width" Value="124" /><Setter Property="Height" Value="64" />
            <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" /><Setter Property="FontSize" Value="48" />
            <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#111216" />
            <Setter Property="CaretBrush" Value="#858B99" />
        </Style>
        <Style x:Key="FocusGoalSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" /><Setter Property="Background" Value="#F0F1F4" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="#34373F" />
            <Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="SecondaryChrome" Background="{TemplateBinding Background}" CornerRadius="14">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"
                               FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Text="{TemplateBinding Content}" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SecondaryChrome" Property="Opacity" Value="0.85" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="SecondaryChrome" Property="Opacity" Value="0.7" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FocusGoalPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FocusGoalSecondaryButtonStyle}">
            <Setter Property="Background" Value="#FF7928" /><Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style x:Key="FocusGoalDangerMenuItemStyle" TargetType="Button">
            <Setter Property="Height" Value="34" /><Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Danger}" /><Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="DangerMenuItemChrome" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="6">
                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DangerMenuItemChrome" Property="Background" Value="#FFF1F0" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Border x:Name="FocusGoalSettingsCard" Width="330" Height="{Binding DialogHeight, Mode=OneWay}" Padding="22,20,22,22"
            Background="#FFFFFF" BorderBrush="#E3E5E9" BorderThickness="1" CornerRadius="18">
        <Border.Effect><DropShadowEffect BlurRadius="24" Direction="270" Opacity="0.14" ShadowDepth="6" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="66" /><RowDefinition Height="54" /><RowDefinition Height="*" /><RowDefinition Height="58" /></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#1D1D1F" Text="专注目标" />
                    <TextBlock Margin="0,5,0,0" FontSize="13" Foreground="#9197A4" Text="设置你的专注节奏" />
                </StackPanel>
                <Button x:Name="FocusGoalMoreButton"
                        Width="38"
                        Height="30"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Visibility="{Binding HasSavedTarget, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Content="•••"
                        Click="FocusGoalMoreButton_Click"
                        PreviewMouseDown="FocusGoalMoreButton_PreviewMouseDown"
                        FontSize="15"
                        Foreground="{DynamicResource TextSecondary}"
                        FocusVisualStyle="{x:Null}">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="MoreButtonChrome"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Top"
                                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="MoreButtonChrome"
                                                        Property="Background"
                                                        Value="{DynamicResource ControlHoverBackground}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Popup x:Name="FocusGoalMoreMenu"
                       AllowsTransparency="True"
                       Closed="FocusGoalMoreMenu_Closed"
                       Focusable="False"
                       HorizontalOffset="-66"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=FocusGoalMoreButton}"
                       StaysOpen="False"
                       VerticalOffset="4">
                    <Border Width="104"
                            Padding="5"
                            Background="#FFFFFF"
                            BorderBrush="#E5E5EA"
                            BorderThickness="1"
                            CornerRadius="9">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Direction="270" Opacity="0.14" ShadowDepth="3" />
                        </Border.Effect>
                        <Button Content="删除目标"
                                Click="DeleteFocusGoalMenuItem_Click"
                                Foreground="{DynamicResource Danger}"
                                Style="{StaticResource FocusGoalDangerMenuItemStyle}" />
                    </Border>
                </Popup>
            </Grid>
            <Border Grid.Row="1" Background="#F0F1F4" CornerRadius="27">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Button x:Name="DailyFixedModeButton" Command="{Binding SelectDailyModeCommand}">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FocusGoalSegmentButtonStyle}"><Style.Triggers>
                            <DataTrigger Binding="{Binding IsDailyFixedMode}" Value="True"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#E9EBF0" /><Setter Property="Foreground" Value="#202126" /></DataTrigger>
                        </Style.Triggers></Style></Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="20" Height="20" Margin="0,0,8,0">
                                <Ellipse Canvas.Left="5" Canvas.Top="5" Width="10" Height="10" Stroke="#8B91A0" StrokeThickness="1.5" />
                                <Path Data="M 10,0 L 10,2 M 10,18 L 10,20 M 0,10 L 2,10 M 18,10 L 20,10 M 3,3 L 4.5,4.5 M 15.5,15.5 L 17,17 M 3,17 L 4.5,15.5 M 15.5,4.5 L 17,3" Stroke="#8B91A0" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                            <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="每日固定" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MonthlyTotalModeButton" Grid.Column="1" Command="{Binding SelectMonthlyModeCommand}">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FocusGoalSegmentButtonStyle}"><Style.Triggers>
                            <DataTrigger Binding="{Binding IsMonthlyTotalMode}" Value="True"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#E9EBF0" /><Setter Property="Foreground" Value="#202126" /></DataTrigger>
                        </Style.Triggers></Style></Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="20" Margin="0,0,8,0" Data="M 3,18 L 3,13 M 9,18 L 9,8 M 15,18 L 15,3" Stroke="#8B91A0" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="每月总目标" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <Grid Grid.Row="2">
                <Grid x:Name="DailyFixedContent" Height="84" Margin="0,26,0,0" VerticalAlignment="Top" Visibility="{Binding IsDailyFixedMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                    <Button VerticalAlignment="Top" Margin="0,10,0,0" AutomationProperties.Name="减少每日目标时长" Command="{Binding DecreaseDailyTargetCommand}" Content="−" Style="{StaticResource FocusGoalStepperButtonStyle}" />
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBox x:Name="DailyTargetHoursInputBox" Tag="Daily" MaxLength="2" AutomationProperties.Name="每日目标小时数"
                                 Style="{StaticResource FocusGoalTargetHoursInputStyle}" Text="{Binding DailyTargetHoursInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="TargetHoursInputBox_TextChanged" PreviewKeyDown="TargetHoursInputBox_PreviewKeyDown" PreviewTextInput="TargetHoursInputBox_PreviewTextInput"
                                 LostKeyboardFocus="TargetHoursInputBox_LostKeyboardFocus" DataObject.Pasting="TargetHoursInputBox_Pasting" />
                        <TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="#9197A4" Text="小时 / 天" />
                    </StackPanel>
                    <Button Grid.Column="2" VerticalAlignment="Top" Margin="0,10,0,0" AutomationProperties.Name="增加每日目标时长" Command="{Binding IncreaseDailyTargetCommand}" Content="+" Style="{StaticResource FocusGoalStepperButtonStyle}" />
                </Grid>
                <Grid x:Name="MonthlyTotalContent" Visibility="{Binding IsMonthlyTotalMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="64" /></Grid.RowDefinitions>
                    <Grid Height="84" Margin="0,26,0,0" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                        <Button VerticalAlignment="Top" Margin="0,10,0,0" AutomationProperties.Name="减少每月目标时长" Command="{Binding DecreaseMonthlyTargetCommand}" Content="−" Style="{StaticResource FocusGoalStepperButtonStyle}" />
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBox x:Name="MonthlyTargetHoursInputBox" Tag="Monthly" MaxLength="3" AutomationProperties.Name="每月目标小时数"
                                     Style="{StaticResource FocusGoalTargetHoursInputStyle}" Text="{Binding MonthlyTargetHoursInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="TargetHoursInputBox_TextChanged" PreviewKeyDown="TargetHoursInputBox_PreviewKeyDown" PreviewTextInput="TargetHoursInputBox_PreviewTextInput"
                                     LostKeyboardFocus="TargetHoursInputBox_LostKeyboardFocus" DataObject.Pasting="TargetHoursInputBox_Pasting" />
                            <TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="#9197A4" Text="小时 / 月" />
                        </StackPanel>
                        <Button Grid.Column="2" VerticalAlignment="Top" Margin="0,10,0,0" AutomationProperties.Name="增加每月目标时长" Command="{Binding IncreaseMonthlyTargetCommand}" Content="+" Style="{StaticResource FocusGoalStepperButtonStyle}" />
                    </Grid>
                    <Border x:Name="MonthlyProgressHint" Grid.Row="1" Background="#F6F6F8" CornerRadius="14" Padding="12,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Viewbox Width="24" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Canvas Width="24" Height="32">
                                    <Path Data="M 8,23 L 8,20 C 8,17 3,16 3,11 C 3,6 7,3 12,3 C 17,3 21,6 21,11 C 21,16 16,17 16,20 L 16,23 Z M 8,26 L 16,26 M 10,29 L 14,29 M 12,0 L 12,-2 M 1,3 L -1,1 M 23,3 L 25,1 M 0,11 L -2,11 M 24,11 L 26,11"
                                          Stroke="#FF9A40" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="MonthlyDailyRequirementText" FontSize="11.5" FontWeight="Medium" Foreground="#33363F" Text="{Binding MonthlyDailyRequirementDisplay, Mode=OneWay}" />
                                <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="#9297A4" Text="坚持下去，你可以达成目标！" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <Grid Grid.Row="3" Height="42" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Button x:Name="TargetSettingsCancelButton" Command="{Binding CancelCommand}" Content="取消" Style="{StaticResource FocusGoalSecondaryButtonStyle}" />
                <Button x:Name="TargetSettingsSaveButton" Grid.Column="2" Command="{Binding SaveCommand}" Content="保存" Style="{StaticResource FocusGoalPrimaryButtonStyle}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
