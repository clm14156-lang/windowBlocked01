<UserControl x:Class="FocusApp.Desktop.Views.BrowserExtensionModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource FontFamilyPrimary}" FontSize="{DynamicResource BodyFontSize}"
             UseLayoutRounding="True" SnapsToDevicePixels="True" Focusable="True"
             KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="Modal_PreviewKeyDown"
             IsVisibleChanged="Modal_IsVisibleChanged">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/Styles.xaml"/></ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="ModalVisibility"/>
        <Style x:Key="BrowserInstallButton" TargetType="Button" BasedOn="{StaticResource AuthPrimaryButtonStyle}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyPrimary}"/>
            <Setter Property="FontSize" Value="{DynamicResource ButtonFontSize}"/>
            <Setter Property="FontWeight" Value="{DynamicResource ButtonEmphasisFontWeight}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Effect" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <!-- Half of the shared 42-DIP height gives true semicircular capsule ends. -->
                <Grid x:Name="BrowserButtonRoot">
                    <Border x:Name="BrowserButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="21"/>
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="BrowserButtonRoot" Property="Opacity" Value="0.85"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource FocusButtonHoverBackground}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChromeInstallButtonStyle" TargetType="Button" BasedOn="{StaticResource BrowserInstallButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChromeInstalled}" Value="True">
                    <Setter Property="Background" Value="#F0FAF5"/><Setter Property="Foreground" Value="#182A42"/>
                    <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Arrow"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BrowserEdgeButton" TargetType="Button" BasedOn="{StaticResource BrowserInstallButton}">
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#DEE4EF"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="{DynamicResource ButtonFontWeight}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F7F9FC"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#EDF1F7"/></Trigger>
                <DataTrigger Binding="{Binding IsEdgeInstalled}" Value="True">
                    <Setter Property="Background" Value="#F0FAF5"/><Setter Property="Foreground" Value="#182A42"/>
                    <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Arrow"/>
                    <Setter Property="FontWeight" Value="{DynamicResource ButtonEmphasisFontWeight}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BrowserSkipButton" TargetType="Button">
            <Setter Property="Foreground" Value="#4779C6"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{DynamicResource ButtonFontSize}"/><Setter Property="FontWeight" Value="{DynamicResource ButtonFontWeight}"/>
            <Setter Property="Padding" Value="12,3"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#315FAD"/><Setter Property="Background" Value="#F0F5FF"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#E7EEFB"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="Overlay" Background="{DynamicResource ModalScrim}" MouseLeftButtonDown="Overlay_MouseLeftButtonDown">
        <Border x:Name="ModalSurface" Width="450" Height="450" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource SurfacePrimary}" BorderBrush="#E3E7EE" BorderThickness="1" CornerRadius="16">
            <Border.Effect><DropShadowEffect Color="#46536B" BlurRadius="26" ShadowDepth="6" Opacity="0.16"/></Border.Effect>
            <Grid>
                <Grid Margin="53,21,53,21">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="148"/><RowDefinition Height="12"/><RowDefinition Height="28"/><RowDefinition Height="8"/>
                        <RowDefinition Height="42"/><RowDefinition Height="18"/><RowDefinition Height="42"/><RowDefinition Height="10"/>
                        <RowDefinition Height="42"/><RowDefinition/><RowDefinition Height="46"/>
                    </Grid.RowDefinitions>
                    <Image x:Name="BrowserIllustration" Width="300" Height="144" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                           Source="/FocusApp.Desktop;component/Assets/Images/Illustrations/chrom_chahua.png"/>
                    <TextBlock x:Name="ModalTitle" Grid.Row="2" Text="让浏览器也一起专注" FontSize="18" FontWeight="{DynamicResource DialogTitleFontWeight}"
                               Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ModalDescription" Grid.Row="4" Text="{Binding Description}"
                               FontSize="{DynamicResource SecondaryFontSize}" FontWeight="{DynamicResource SecondaryFontWeight}"
                               Foreground="#667085" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" VerticalAlignment="Center"/>
                    <Button x:Name="ChromeInstallButton" Grid.Row="6" Style="{StaticResource ChromeInstallButtonStyle}" Command="{Binding InstallCommand}"
                            CommandParameter="Chrome" AutomationProperties.Name="{Binding ChromeInstallButtonText}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="23"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                            <Image Width="23" Height="23" Source="/FocusApp.Desktop;component/Assets/Images/Illustrations/chrom01.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="ChromeButtonLabel" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PrimaryActionButtonLabelStyle}">
                                    <Setter Property="Text" Value="安装 Chrome 插件"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsChromeInstalled}" Value="True"><Setter Property="Text" Value="Chrome 插件"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                            <Border x:Name="ChromeInstalledBadge" Grid.Column="3" Height="28" Padding="10,0" Margin="0,0,8,0" CornerRadius="14" Background="#DFF7E9"
                                    Visibility="{Binding IsChromeInstalled, Converter={StaticResource ModalVisibility}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="18" Height="18">
                                        <Ellipse Fill="#0DBD68"/>
                                        <Path Width="9" Height="6" Data="M 0,3 L 3,6 L 9,0" Stretch="Fill" Stroke="White" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="已安装" FontSize="{DynamicResource ButtonFontSize}" FontWeight="{DynamicResource ButtonEmphasisFontWeight}"
                                               Foreground="#14A45D" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Path x:Name="ChromeActionArrow" Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" StrokeThickness="1.3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Fill">
                                <Path.Style><Style TargetType="Path">
                                    <Setter Property="Width" Value="12"/><Setter Property="Height" Value="11"/>
                                    <Setter Property="Data" Value="M 0,5.5 L 12,5.5 M 7,0 L 12,5.5 L 7,11"/>
                                    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsChromeInstalled}" Value="True">
                                        <Setter Property="Width" Value="6"/><Setter Property="Height" Value="10"/>
                                        <Setter Property="Data" Value="M 0,0 L 5,4.5 L 0,9"/><Setter Property="Stroke" Value="#7F899B"/>
                                    </DataTrigger></Style.Triggers>
                                </Style></Path.Style>
                            </Path>
                        </Grid>
                    </Button>
                    <Button x:Name="EdgeInstallButton" Grid.Row="8" Style="{StaticResource BrowserEdgeButton}" Command="{Binding InstallCommand}"
                            CommandParameter="Edge" AutomationProperties.Name="{Binding EdgeInstallButtonText}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="23"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                            <Image Width="23" Height="23" Source="/FocusApp.Desktop;component/Assets/Images/Illustrations/chrom_edge.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="EdgeButtonLabel" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PrimaryActionButtonLabelStyle}">
                                    <Setter Property="Text" Value="安装 Edge 插件"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsEdgeInstalled}" Value="True"><Setter Property="Text" Value="Edge 插件"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                            <Border x:Name="EdgeInstalledBadge" Grid.Column="3" Height="28" Padding="10,0" Margin="0,0,8,0" CornerRadius="14" Background="#DFF7E9"
                                    Visibility="{Binding IsEdgeInstalled, Converter={StaticResource ModalVisibility}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="18" Height="18">
                                        <Ellipse Fill="#0DBD68"/>
                                        <Path Width="9" Height="6" Data="M 0,3 L 3,6 L 9,0" Stretch="Fill" Stroke="White" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="已安装" FontSize="{DynamicResource ButtonFontSize}" FontWeight="{DynamicResource ButtonEmphasisFontWeight}"
                                               Foreground="#14A45D" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Path x:Name="EdgeActionArrow" Grid.Column="4" Width="6" Height="10" Data="M 0,0 L 5,4.5 L 0,9" Stretch="Fill" Stroke="#7F899B" StrokeThickness="1.3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <StackPanel x:Name="SkipArea" Grid.Row="10" HorizontalAlignment="Center" Visibility="{Binding ShowSkip, Converter={StaticResource ModalVisibility}}">
                        <Button x:Name="SkipButton" Style="{StaticResource BrowserSkipButton}" Command="{Binding SkipCommand}">
                            <TextBlock Style="{StaticResource PrimaryActionButtonLabelStyle}" Text="暂不安装"/>
                        </Button>
                        <TextBlock Margin="0,2,0,0" Text="稍后可在设置中安装。" FontSize="{DynamicResource SecondaryFontSize}"
                                   FontWeight="{DynamicResource SecondaryFontWeight}" Foreground="#7C8798" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <Button x:Name="CloseButton" Style="{StaticResource ModalCloseButtonStyle}" Margin="0,10,10,0"
                        Command="{Binding CloseCommand}" AutomationProperties.Name="关闭浏览器插件弹窗"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
