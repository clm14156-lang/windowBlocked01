<UserControl x:Class="FocusApp.Desktop.Views.CalendarRecordHoverToolTip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             Width="{x:Static views:CalendarRecordHoverToolTip.MaximumWidth}"
             MaxWidth="{x:Static views:CalendarRecordHoverToolTip.MaximumWidth}"
             FontFamily="{DynamicResource FontFamilyPrimary}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FocusApp.Desktop;component/Resources/PoptipStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <views:PoptipChrome x:Name="RecordPoptipSurface" Style="{StaticResource PoptipSurfaceStyle}"
                        MaxWidth="{Binding MaxWidth, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        Background="{StaticResource ChartPoptipBackgroundBrush}" BorderBrush="{StaticResource ChartPoptipBorderBrush}">
        <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ActualDuration" Margin="0,0,8,0" VerticalAlignment="Center" TextWrapping="Wrap"
                       FontSize="{DynamicResource BodyFontSize}" FontWeight="Normal" Foreground="Black">
                <Run Text="{Binding PoptipActualMinutesDisplay, Mode=OneWay}" /><Run Text="分钟" />
            </TextBlock>
            <TextBlock x:Name="TimeRange" Grid.Column="1" Text="{Binding TimelineTimeRangeDisplay}" VerticalAlignment="Center"
                       FontFamily="{DynamicResource FontFamilyEnglish}" FontSize="{DynamicResource BodyFontSize}" FontWeight="Normal"
                       Foreground="{StaticResource ChartPoptipSecondaryBrush}" Typography.NumeralAlignment="Tabular" />
        </Grid>
    </views:PoptipChrome>
</UserControl>
