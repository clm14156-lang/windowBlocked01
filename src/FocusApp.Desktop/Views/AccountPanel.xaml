<UserControl x:Class="FocusApp.Desktop.Views.AccountPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="210"
             Height="270"
             TextElement.FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="AccountPanelRowButton" TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccountPanelVipRowButton" TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.72" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource OverlayBorder}"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" Direction="270" Opacity="0.12" ShadowDepth="5" />
        </Border.Effect>

        <Grid Margin="16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="74" />
                <RowDefinition Height="1" />
                <RowDefinition Height="49" />
                <RowDefinition Height="57" />
                <RowDefinition Height="1" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Grid Width="44" Height="44" Margin="0,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Ellipse Fill="{DynamicResource BackgroundSecondary}" />
                    <Ellipse>
                        <Ellipse.Fill>
                            <ImageBrush AlignmentX="Center"
                                        AlignmentY="Center"
                                        ImageSource="/FocusApp.Desktop;component/Assets/Images/Illustrations/UserAvatar.png"
                                        Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <Image Width="18"
                            Height="18"
                            Margin="0,0,-1,-1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="/FocusApp.Desktop;component/Assets/Icons/Common/vip_logo.png"
                            Stretch="Uniform">
                        <Image.Style>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVipMember}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Grid>

                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource AccountPanelLoggedIn}" />
                        <Ellipse Width="7" Height="7" Margin="7,1,0,0" VerticalAlignment="Center" Fill="{DynamicResource Success}" />
                        <Border Margin="8,0,0,0"
                                Padding="7,1"
                                VerticalAlignment="Center"
                                BorderBrush="{DynamicResource MembershipBadgeAccent}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVipMember}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource MembershipBadgeAccent}"
                                       Text="{DynamicResource AccountPanelMemberTag}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{Binding CurrentUserEmail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentUserEmail}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource BorderPrimary}" Opacity="0.72" />

            <Button Grid.Row="2"
                    AutomationProperties.Name="{DynamicResource AccountPanelAccountSync}"
                    Command="{Binding OpenAccountSyncCommand}"
                    Style="{StaticResource AccountPanelRowButton}">
                <Grid Margin="2,0,4,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="35" /><ColumnDefinition /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource TextSecondary}" Text="&#xE753;" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource AccountPanelAccountSync}" />
                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextSecondary}" Opacity="0.72" Text="&#xE76C;" />
                </Grid>
            </Button>

            <Button Grid.Row="3"
                    Margin="0,1,0,0"
                    AutomationProperties.Name="{DynamicResource AccountPanelVip}"
                    Command="{Binding OpenVipCommand}"
                    Style="{StaticResource AccountPanelVipRowButton}">
                <Grid Margin="2,0,4,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="35" /><ColumnDefinition /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                    <Image Width="20"
                           Height="20"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="/FocusApp.Desktop;component/Assets/Icons/Common/Menber_vip.png"
                           Stretch="Uniform" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Text" Value="{DynamicResource AccountPanelVip}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVipMember}" Value="True"><Setter Property="Text" Value="{DynamicResource AccountPanelMemberCenter}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="0,3,0,0" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Text" Value="解锁更多专注功能" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVipMember}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextSecondary}" Opacity="0.72" Text="&#xE76C;" />
                </Grid>
            </Button>

            <Button Grid.Row="5"
                    AutomationProperties.Name="{DynamicResource AccountPanelLogout}"
                    Command="{Binding LogoutCommand}"
                    Style="{StaticResource AccountPanelRowButton}">
                <Grid Margin="2,0,4,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="35" /><ColumnDefinition /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                    <Image Width="20"
                           Height="20"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="/FocusApp.Desktop;component/Assets/Icons/Common/Log_Out.png"
                           Stretch="Uniform" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource AccountPanelLogout}" />
                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextSecondary}" Opacity="0.72" Text="&#xE76C;" />
                </Grid>
            </Button>
        </Grid>
    </Border>
</UserControl>
