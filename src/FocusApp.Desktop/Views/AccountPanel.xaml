<UserControl x:Class="FocusApp.Desktop.Views.AccountPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="220" Height="280"
             FontFamily="{DynamicResource FontFamilyPrimary}"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Geometry x:Key="CrownOutline">M 2,6 L 6.8,8.4 L 10,3 L 13.2,8.4 L 18,6 L 15.5,16 H 4.5 Z M 7,12.8 H 13</Geometry>
        <Geometry x:Key="CloudOutline">M 5,15 H 15 A 3.3,3.3 0 1 0 14.5,8.4 A 4.8,4.8 0 0 0 5.1,8.5 A 3.3,3.3 0 1 0 5,15</Geometry>
        <Geometry x:Key="Chevron">M 6,3 L 12,9 L 6,15</Geometry>
        <BooleanToVisibilityConverter x:Key="AccountBoolVisibility" />
        <Style x:Key="AccountIcon" TargetType="Path">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{DynamicResource TextSecondary}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="AccountChevron" TargetType="Path" BasedOn="{StaticResource AccountIcon}">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Stroke" Value="{DynamicResource TextTertiary}" />
            <Setter Property="Data" Value="{StaticResource Chevron}" />
        </Style>
        <Style x:Key="AccountLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style x:Key="AccountPanelRowButton" TargetType="Button">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource OverlayBorder}" BorderThickness="1" CornerRadius="19">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" Direction="270" Opacity="0.12" ShadowDepth="5" />
        </Border.Effect>
        <StackPanel Margin="15,24,15,16">
            <Grid Height="66" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid Width="52" Height="52" VerticalAlignment="Center">
                    <Ellipse Width="51" Height="51">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="/FocusApp.Desktop;component/Assets/Images/Illustrations/UserAvatar.png" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <Image x:Name="MemberCrown" Width="19" Height="19" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Source="/FocusApp.Desktop;component/Assets/Icons/Common/vip_logo.png"
                           Visibility="{Binding IsVipMember, Converter={StaticResource AccountBoolVisibility}}" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource HomeLoggedInAccount}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <Ellipse x:Name="ServerConnectionDot" Width="7" Height="7" Margin="6,0,0,0" VerticalAlignment="Center"
                                 ToolTip="{Binding AccountServerConnectionDescription}"
                                 AutomationProperties.Name="{Binding AccountServerConnectionDescription}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#999DA3" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAccountServerConnected}" Value="True">
                                            <Setter Property="Fill" Value="#269C27" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </StackPanel>
                    <TextBlock x:Name="AccountEmail" Margin="0,3,0,0" Text="{Binding CurrentUserEmail}"
                               ToolTip="{Binding CurrentUserEmail}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               FontSize="13" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock x:Name="MembershipDetailsText" Margin="0,4,0,0"
                               Text="{Binding AccountMembershipDetails}" ToolTip="{Binding AccountMembershipDescription}"
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AccountMembershipDetails}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <Border Height="1" Background="{DynamicResource BorderPrimary}" Margin="0,0,0,10" />

            <Button Style="{StaticResource AccountPanelRowButton}" Command="{Binding OpenAccountSyncCommand}"
                    AutomationProperties.Name="{DynamicResource AccountPanelAccountSync}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" /><ColumnDefinition /><ColumnDefinition Width="17" />
                    </Grid.ColumnDefinitions>
                    <Path Style="{StaticResource AccountIcon}" Data="{StaticResource CloudOutline}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource AccountLabel}" Text="{DynamicResource AccountPanelAccountSync}" />
                    <Path Grid.Column="2" Style="{StaticResource AccountChevron}" />
                </Grid>
            </Button>

            <Button Command="{Binding OpenVipCommand}" AutomationProperties.Name="{Binding Text, ElementName=MembershipMenuLabel}"
                    Style="{StaticResource AccountPanelRowButton}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition /><ColumnDefinition Width="17" /></Grid.ColumnDefinitions>
                    <Path Style="{StaticResource AccountIcon}" Stroke="{DynamicResource AccentPrimary}" Data="{StaticResource CrownOutline}" />
                    <TextBlock x:Name="MembershipMenuLabel" Grid.Column="1" Style="{StaticResource AccountLabel}"
                               Text="{DynamicResource AccountPanelMemberCenter}" />
                    <Path Grid.Column="2" Style="{StaticResource AccountChevron}" />
                </Grid>
            </Button>

            <Button Style="{StaticResource AccountPanelRowButton}" Command="{Binding LogoutCommand}"
                    AutomationProperties.Name="{DynamicResource AccountPanelLogout}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition /><ColumnDefinition Width="17" /></Grid.ColumnDefinitions>
                    <Path Style="{StaticResource AccountIcon}" Data="M 11,4 H 4 Q 2.5,4 2.5,5.5 V 15 Q 2.5,16.5 4,16.5 H 11 M 8,10 H 17 M 13.5,6.5 L 17,10 L 13.5,13.5" />
                    <TextBlock Grid.Column="1" Style="{StaticResource AccountLabel}" Text="{DynamicResource AccountPanelLogout}" />
                    <Path Grid.Column="2" Style="{StaticResource AccountChevron}" />
                </Grid>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
