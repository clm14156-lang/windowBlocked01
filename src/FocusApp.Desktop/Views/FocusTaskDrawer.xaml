<UserControl x:Class="FocusApp.Desktop.Views.FocusTaskDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="270" Height="710" Background="White" FontFamily="Microsoft YaHei UI, Segoe UI"
             Foreground="#24262C" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
             PreviewKeyDown="Drawer_PreviewKeyDown" PreviewMouseMove="Drawer_PreviewMouseMove"
             PreviewMouseLeftButtonUp="Drawer_PreviewMouseLeftButtonUp" LostMouseCapture="Drawer_LostMouseCapture"
             Unloaded="Drawer_Unloaded" DataContextChanged="Drawer_DataContextChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="FocusTaskResources.xaml" /></ResourceDictionary.MergedDictionaries>
        <Style x:Key="DrawerTaskCheck" TargetType="CheckBox">
            <Setter Property="Width" Value="19"/><Setter Property="Height" Value="19"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Border x:Name="CheckChrome" CornerRadius="3" BorderBrush="#BCC2CB" BorderThickness="1" Background="White">
                    <Grid>
                    <TextBlock x:Name="TaskNumber" Text="{Binding DrawerNumber}" FontSize="11" Foreground="#A9AFB9"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Path x:Name="Tick" Width="9" Height="7" Data="M 0,3 L 3,6 L 9,0" Stroke="White" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckChrome" Property="BorderBrush" Value="#FF9D5F"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckChrome" Property="BorderBrush" Value="#FF9D5F"/></Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="CheckChrome" Property="Background" Value="#ABB1BA"/><Setter TargetName="CheckChrome" Property="BorderBrush" Value="#ABB1BA"/>
                        <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="TaskNumber" Property="Visibility" Value="Collapsed"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DrawerCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource PlainButton}">
            <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Foreground" Value="#A0A7B2"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="CloseSurface" Background="Transparent" CornerRadius="8" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                    <Path Width="11" Height="11" Data="M 0,0 L 11,11 M 11,0 L 0,11" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CloseSurface" Property="Background" Value="#F5F6F8"/><Setter Property="Foreground" Value="#707986"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CloseSurface" Property="Background" Value="#F5F6F8"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="CloseSurface" Property="Background" Value="#EBEEF2"/><Setter TargetName="CloseSurface" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.94" ScaleY="0.94"/></Setter.Value></Setter></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DrawerAddTaskButtonStyle" TargetType="Button" BasedOn="{StaticResource PlainButton}">
            <Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="CreateSurface" Background="White" BorderBrush="#FFAF7A" BorderThickness="1" CornerRadius="21" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                    <Path Width="14" Height="14" Data="M 0,7 L 14,7 M 7,0 L 7,14" Stroke="#FF9650" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CreateSurface" Property="Background" Value="#FFF7F0"/><Setter TargetName="CreateSurface" Property="BorderBrush" Value="#FF9C5B"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CreateSurface" Property="Background" Value="#FFF7F0"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="CreateSurface" Property="Background" Value="#FFF0E5"/><Setter TargetName="CreateSurface" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.94" ScaleY="0.94"/></Setter.Value></Setter></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><DataTrigger Binding="{Binding IsCreating}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="DraftActionButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
            <Setter Property="Height" Value="30"/><Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#929AA7"/><Setter Property="Padding" Value="3,0"/>
        </Style>
        <Style x:Key="DraftSubTaskCheck" TargetType="CheckBox" BasedOn="{StaticResource CircleCheck}">
            <Setter Property="Width" Value="15"/><Setter Property="Height" Value="15"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Border x:Name="DraftCheckSurface" Background="White" BorderBrush="#BAC2CD" BorderThickness="1" CornerRadius="3">
                    <Path x:Name="DraftTick" Visibility="Collapsed" Width="8" Height="6" Data="M 0,3 L 3,6 L 8,0" Stroke="White" StrokeThickness="1.3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="DraftCheckSurface" Property="Background" Value="#FF9144"/>
                    <Setter TargetName="DraftCheckSurface" Property="BorderBrush" Value="#FF9144"/>
                    <Setter TargetName="DraftTick" Property="Visibility" Value="Visible"/>
                </Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DraftCreateButton" TargetType="Button" BasedOn="{StaticResource SheetButton}">
            <Setter Property="Background" Value="#FF781A"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#ECEEF1"/><Setter Property="Foreground" Value="#B2B8C2"/></Trigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="TaskRow">
            <Grid x:Name="TaskRowSurface" Background="Transparent" PreviewMouseLeftButtonDown="TaskRow_PreviewMouseLeftButtonDown">
                <StackPanel Margin="18,14,14,15">
                    <Grid MinHeight="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="35" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}" Command="{Binding DataContext.ToggleTaskCompletedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource DrawerTaskCheck}" AutomationProperties.Name="切换任务完成状态" />
                        <TextBlock x:Name="TaskTitle" Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource CompletedTitle}" />
                        <Button x:Name="TaskMoreButton" Grid.Column="2" Width="24" Height="24" VerticalAlignment="Center" Content="···" FontSize="17" AutomationProperties.Name="更多任务操作" Click="TaskMoreButton_Click">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PlainButton}"><Setter Property="Opacity" Value="0.6"/><Style.Triggers><DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="编辑任务" Click="EditTaskMenu_Click" Foreground="#424955">
                                    <MenuItem.Icon><Path Width="14" Height="14" Data="M 2,11 L 2,14 L 5,14 L 13,6 L 10,3 Z M 10,3 L 12,1 L 15,4 L 13,6" Stroke="#424955" StrokeThickness="1.4" Fill="Transparent" StrokeLineJoin="Round" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="删除任务" Foreground="#E35B58" Click="DeleteTaskMenu_Click">
                                    <MenuItem.Icon><Path Width="14" Height="14" Data="M 2,4 L 14,4 M 5,4 L 5,14 L 11,14 L 11,4 M 6,2 L 10,2 M 7,7 L 7,11 M 9,7 L 9,11" Stroke="#E35B58" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu></Button.ContextMenu>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="InlineDescription" Margin="35,5,2,0" Text="{Binding Description}" FontSize="11" Foreground="#9299A6" TextWrapping="Wrap" LineHeight="18" MaxHeight="36" TextTrimming="CharacterEllipsis" Visibility="{Binding HasDescription, Converter={StaticResource BoolVisibility}}" />
                    <Button x:Name="SubTaskToggle" Margin="35,9,0,0" Padding="10,0" Height="25" HorizontalAlignment="Left" Background="#F2F3F5" Style="{StaticResource PlainButton}" Command="{Binding DataContext.ToggleExpandedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Visibility="{Binding HasSubTasks, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="展开或收起子任务">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding DrawerSubTaskToggleLabel}" FontSize="11" Foreground="#838B98" />
                            <Path Width="6" Height="9" Margin="7,0,0,0" VerticalAlignment="Center" Data="M 0,0 L 5,4.5 L 0,9" Stroke="#9299A6" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" CenterX="3" CenterY="4.5" /></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Path.Style>
                            </Path>
                        </StackPanel>
                    </Button>
                    <Border Margin="45,10,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolVisibility}}">
                        <ItemsControl x:Name="InlineSubTaskList" Margin="14,0,0,0" ItemsSource="{Binding SortedSubTasks}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Grid MinHeight="33"><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}" Style="{StaticResource CircleCheck}" VerticalAlignment="Center" AutomationProperties.Name="切换子任务完成状态" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Title}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="11.5" Style="{StaticResource CompletedTitle}" />
                                </Grid>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
                <Border VerticalAlignment="Bottom" Height="1" Margin="18,0,14,0" Background="#EEF0F2" />
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="TaskRowSurface" Property="IsMouseOver" Value="True"><Setter TargetName="TaskMoreButton" Property="Opacity" Value="1"/></Trigger>
                <Trigger SourceName="TaskRowSurface" Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TaskMoreButton" Property="Opacity" Value="1"/></Trigger>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter TargetName="TaskRowSurface" Property="Opacity" Value="0.72" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border BorderBrush="#E9EBEF" BorderThickness="1,0,0,0" Background="White">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="60" /><RowDefinition Height="Auto"/><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border BorderBrush="#F0F1F4" Margin="18,0,14,0">
                <Border.Style><Style TargetType="Border"><Setter Property="BorderThickness" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding HasPendingTasks}" Value="False"><Setter Property="BorderThickness" Value="0,0,0,1"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="DrawerTitle" VerticalAlignment="Center" Text="当前专注" FontSize="17" FontWeight="SemiBold" Foreground="#252C37"/>
                    <Button x:Name="DrawerCloseButton" Grid.Column="1" Style="{StaticResource DrawerCloseButtonStyle}" Command="{Binding CloseCommand}" AutomationProperties.Name="关闭任务面板" />
                </Grid>
            </Border>
            <StackPanel x:Name="DrawerTaskProgress" Grid.Row="1" Margin="18,8,18,0" Visibility="{Binding HasPendingTasks, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{Binding TaskProgressDisplay}" FontSize="13" Foreground="#929BA8"/>
                <ProgressBar x:Name="DrawerTaskProgressBar" Height="6" Margin="0,10,0,14" Minimum="0" Maximum="1" Value="{Binding TaskProgressRatio, Mode=OneWay}" Foreground="#FF9144" Background="#F3F1F0" BorderThickness="0">
                    <ProgressBar.Template><ControlTemplate TargetType="ProgressBar">
                        <Grid><Border CornerRadius="3" Background="{TemplateBinding Background}"/>
                            <Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{TemplateBinding Foreground}"/></Grid>
                        </Grid>
                    </ControlTemplate></ProgressBar.Template>
                </ProgressBar>
                <Border Height="1" Background="#F0F1F4"/>
            </StackPanel>
            <ScrollViewer x:Name="TaskDrawerScrollViewer" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl x:Name="DrawerTaskList" ItemsSource="{Binding VisibleTasks}" ItemTemplate="{StaticResource TaskRow}"/>
                </StackPanel>
            </ScrollViewer>
            <Canvas Grid.Row="2" IsHitTestVisible="False" ClipToBounds="True" Panel.ZIndex="1">
                <Border x:Name="TaskInsertionLine" Canvas.Left="18" Height="1" Background="#DEE3EB" Visibility="Collapsed"/>
            </Canvas>
            <StackPanel x:Name="DrawerEmptyState" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,32"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False">
                <Image Width="142" Height="142" Opacity="0.65" Stretch="Uniform" Margin="0,0,0,16" RenderOptions.BitmapScalingMode="HighQuality"
                       Source="/FocusApp.Desktop;component/Assets/Images/Illustrations/todolist_empty.png"/>
                <TextBlock Text="暂无任务" FontSize="16" Foreground="#646D7A" HorizontalAlignment="Center"/>
                <TextBlock Text="添加任务后，专注更有方向" FontSize="12" Foreground="#9BA3AE" Margin="0,9,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
            <Border x:Name="TaskEditorScrim" Grid.RowSpan="4" Panel.ZIndex="1" Background="#280F172A"
                    Visibility="{Binding IsCreating, Converter={StaticResource BoolVisibility}}"
                    MouseLeftButtonDown="TaskEditorScrim_MouseLeftButtonDown" />
            <Grid Grid.Row="3">
                <Button x:Name="DrawerAddTaskButton" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,14,16,18"
                        Style="{StaticResource DrawerAddTaskButtonStyle}" Command="{Binding AddTaskCommand}" AutomationProperties.Name="创建任务" ToolTip="添加任务"/>
            </Grid>
            <Grid Grid.RowSpan="4" Panel.ZIndex="2" VerticalAlignment="Bottom">
                <Border x:Name="TaskEditorPanel" Background="White" BorderBrush="#E9EBEF" BorderThickness="0,1,0,0" CornerRadius="14,14,0,0"
                        MaxHeight="500" MinHeight="150" VerticalAlignment="Bottom" Padding="18,14,18,16"
                        Visibility="{Binding IsCreating, Converter={StaticResource BoolVisibility}}" IsVisibleChanged="TaskEditorPanel_IsVisibleChanged">
                    <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Button x:Name="DraftCloseButton" HorizontalAlignment="Right" Width="26" Height="26" Margin="0,-6,-8,0"
                                Style="{StaticResource DrawerCloseButtonStyle}" Command="{Binding CancelCreationCommand}" AutomationProperties.Name="关闭创建任务"/>
                        <ScrollViewer x:Name="DraftContentScroll" Grid.Row="1" MaxHeight="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="4,6,4,0">
                                <Grid>
                                    <TextBox x:Name="DraftTaskTitleInput" Height="34" FontSize="17" FontWeight="Medium" Style="{StaticResource BorderlessInput}"
                                             Text="{Binding DraftTitle, UpdateSourceTrigger=PropertyChanged}" KeyDown="DraftTaskTitleInput_KeyDown" AutomationProperties.Name="任务名称" />
                                    <TextBlock VerticalAlignment="Center" Text="要做什么？" FontSize="18" Foreground="#929AA7" IsHitTestVisible="False">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DraftTitle}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Border x:Name="DraftDescriptionArea" CornerRadius="7" Background="#FAFAFB" Padding="8,8,8,6" Margin="0,10,0,0"
                                        Visibility="{Binding IsDescriptionExpanded, Converter={StaticResource BoolVisibility}}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBox x:Name="DraftTaskDescriptionInput" MinHeight="42" MaxHeight="90" MaxLength="200" VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                     FontSize="11.5" Foreground="#69717E" Style="{StaticResource BorderlessInput}" Text="{Binding DraftDescription, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="任务描述，最多200字"/>
                                            <TextBlock Text="添加描述…" FontSize="11.5" Foreground="#A5ABB5" IsHitTestVisible="False">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DraftDescription}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock x:Name="DraftDescriptionCount" Text="{Binding DescriptionCountDisplay}" FontSize="10" Foreground="#969EAA" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="DraftSubTaskArea" Margin="0,12,0,0" Visibility="{Binding IsSubTasksExpanded, Converter={StaticResource BoolVisibility}}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="子任务" FontSize="11.5" Foreground="#454B55"/>
                                        <TextBlock Text="{Binding SubTaskCountDisplay}" FontSize="11" Foreground="#959CAA" Margin="7,0,0,0"/>
                                    </StackPanel>
                                    <ItemsControl x:Name="DraftSubTaskList" ItemsSource="{Binding Draft.SubTasks}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Grid MinHeight="31"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}" VerticalAlignment="Center" Style="{StaticResource DraftSubTaskCheck}" AutomationProperties.Name="子任务完成状态"/>
                                                <TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="11.5" Style="{StaticResource BorderlessInput}" AutomationProperties.Name="子任务名称"/>
                                                <Button Grid.Column="2" Width="20" Height="22" Style="{StaticResource PlainButton}" Content="×" FontSize="16" Command="{Binding DataContext.DeleteSubTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="删除子任务"/>
                                            </Grid>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid x:Name="DraftSubTaskInputArea" Height="32" Visibility="{Binding IsSubTaskInputVisible, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanEnterSubTask}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                                        <Border Width="16" Height="16" CornerRadius="4" BorderBrush="#BDC4CE" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        <Grid Grid.Column="1">
                                            <TextBox x:Name="DraftSubTaskInput" Style="{StaticResource BorderlessInput}" FontSize="11.5" Text="{Binding SubTaskInput, UpdateSourceTrigger=PropertyChanged}" KeyDown="DraftSubTaskInput_KeyDown" AutomationProperties.Name="输入子任务，按回车添加"/>
                                            <TextBlock Text="子任务名称" Foreground="#A0A6B0" FontSize="11.5" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SubTaskInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <Button Grid.Column="2" Width="24" Height="26" Style="{StaticResource PlainButton}" Command="{Binding AddSubTaskCommand}" Content="↵" FontSize="16" AutomationProperties.Name="添加当前子任务"/>
                                    </Grid>
                                </StackPanel>
                                <WrapPanel Margin="-3,10,0,0">
                                    <Button x:Name="DraftAddDescriptionButton" Style="{StaticResource DraftActionButton}" Margin="0,0,14,0"
                                            Visibility="{Binding ShowAddDescription, Converter={StaticResource BoolVisibility}}" Command="{Binding ExpandDescriptionCommand}" Click="DraftAddDescriptionButton_Click">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="+" FontSize="17" Foreground="#6F7A89" Margin="0,0,6,0"/><TextBlock Text="添加描述" Foreground="#929AA7" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                    <Button x:Name="DraftAddSubTaskButton" Style="{StaticResource DraftActionButton}" IsEnabled="{Binding CanEnterSubTask}"
                                            Visibility="{Binding ShowAddSubTask, Converter={StaticResource BoolVisibility}}" Command="{Binding BeginSubTaskCommand}" Click="DraftAddSubTaskButton_Click">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="+" FontSize="17" Foreground="#6F7A89" Margin="0,0,6,0"/><TextBlock Text="添加子任务" Foreground="#929AA7" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Width="46" Height="32" Command="{Binding CancelCreationCommand}" Foreground="#717987" FontSize="12" Style="{StaticResource PlainButton}"><TextBlock Text="取消" Foreground="#717987" FontSize="12"/></Button>
                            <Button x:Name="DrawerCreateTaskButton" MinWidth="62" Padding="12,0" Height="32" Margin="8,0,0,0" Command="{Binding CreateTaskCommand}" Content="{Binding CommitButtonText}" Style="{StaticResource DraftCreateButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
