<UserControl x:Class="FocusApp.Desktop.Views.FocusTaskDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="270" Height="710" Background="White" FontFamily="Microsoft YaHei UI, Segoe UI"
             Foreground="#24262C" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
             PreviewKeyDown="Drawer_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="FocusTaskResources.xaml" /></ResourceDictionary.MergedDictionaries>
        <DataTemplate x:Key="TaskRow">
            <Grid x:Name="TaskRowSurface" Background="Transparent">
                <Border x:Name="SelectionTint" Background="Transparent" />
                <Border x:Name="SelectionAccent" Width="2" HorizontalAlignment="Left" Background="#FF7A19" Visibility="Collapsed" />
                <StackPanel Margin="18,14,14,15">
                    <Grid MinHeight="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="35" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}" VerticalAlignment="Center" Style="{StaticResource ParentCheck}" AutomationProperties.Name="切换任务完成状态" />
                        <TextBlock x:Name="TaskTitle" Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource CompletedTitle}" />
                        <Button x:Name="TaskMoreButton" Grid.Column="2" Width="24" Height="24" VerticalAlignment="Center" Content="···" FontSize="17" AutomationProperties.Name="更多任务操作" Click="TaskMoreButton_Click">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PlainButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="编辑任务" Click="EditTaskMenu_Click" Foreground="#424955">
                                    <MenuItem.Icon><Path Width="14" Height="14" Data="M 2,11 L 2,14 L 5,14 L 13,6 L 10,3 Z M 10,3 L 12,1 L 15,4 L 13,6" Stroke="#424955" StrokeThickness="1.4" Fill="Transparent" StrokeLineJoin="Round" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="删除任务" Foreground="#E35B58" Click="DeleteTaskMenu_Click">
                                    <MenuItem.Icon><Path Width="14" Height="14" Data="M 2,4 L 14,4 M 5,4 L 5,14 L 11,14 L 11,4 M 6,2 L 10,2 M 7,7 L 7,11 M 9,7 L 9,11" Stroke="#E35B58" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu></Button.ContextMenu>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="InlineDescription" Margin="35,5,2,0" Text="{Binding Description}" FontSize="11" Foreground="#9299A6" TextWrapping="Wrap" LineHeight="18" MaxHeight="36" TextTrimming="CharacterEllipsis" Visibility="{Binding HasDescription, Converter={StaticResource BoolVisibility}}" />
                    <Button x:Name="SubTaskToggle" Margin="35,9,0,0" Padding="10,0" Height="25" HorizontalAlignment="Left" Background="#F2F3F5" Style="{StaticResource PlainButton}" Command="{Binding DataContext.ToggleExpandedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Visibility="{Binding HasSubTasks, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="展开或收起子任务">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding DrawerSubTaskToggleLabel}" FontSize="11" Foreground="#838B98" />
                            <Path Width="6" Height="9" Margin="7,0,0,0" VerticalAlignment="Center" Data="M 0,0 L 5,4.5 L 0,9" Stroke="#9299A6" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" CenterX="3" CenterY="4.5" /></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Path.Style>
                            </Path>
                        </StackPanel>
                    </Button>
                    <Border Margin="45,10,0,0" BorderBrush="#E8EBF0" BorderThickness="1,0,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolVisibility}}">
                        <ItemsControl x:Name="InlineSubTaskList" Margin="14,0,0,0" ItemsSource="{Binding SortedSubTasks}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Grid MinHeight="33"><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}" Style="{StaticResource CircleCheck}" VerticalAlignment="Center" AutomationProperties.Name="切换子任务完成状态" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Title}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="11.5" Style="{StaticResource CompletedTitle}" />
                                </Grid>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
                <Border VerticalAlignment="Bottom" Height="1" Margin="18,0,14,0" Background="#EEF0F2" />
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="TaskRowSurface" Property="IsMouseOver" Value="True"><Setter TargetName="TaskMoreButton" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger SourceName="TaskRowSurface" Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TaskMoreButton" Property="Visibility" Value="Visible"/></Trigger>
                <DataTrigger Binding="{Binding IsDrawerSelected}" Value="True"><Setter TargetName="SelectionTint" Property="Background" Value="#FFF9F4" /><Setter TargetName="SelectionAccent" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter TargetName="TaskRowSurface" Property="Opacity" Value="0.62" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border BorderBrush="#E9EBEF" BorderThickness="1,0,0,0" Background="White">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="60" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border BorderBrush="#F0F1F4" BorderThickness="0,0,0,1" Margin="14,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="当前任务" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding TaskProgress}" FontFamily="Segoe UI" FontSize="12" Foreground="#969CA7" />
                    <Button Grid.Column="2" Width="28" Height="28" Style="{StaticResource PlainButton}" Command="{Binding CloseCommand}" Content="×" FontSize="21" AutomationProperties.Name="关闭任务面板" />
                </Grid>
            </Border>
            <ScrollViewer x:Name="TaskDrawerScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl x:Name="DrawerTaskList" ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource TaskRow}" />
                    <Button x:Name="CompletedTasksToggle" Margin="14,14,14,2" Padding="4,8" HorizontalContentAlignment="Left" Style="{StaticResource PlainButton}" Command="{Binding ToggleCompletedCommand}" Visibility="{Binding HasCompletedTasks, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="查看已完成任务">
                        <TextBlock Text="{Binding CompletedTasksLabel}" FontSize="11" Foreground="#9299A6"/>
                    </Button>
                    <ItemsControl x:Name="DrawerCompletedTaskList" ItemsSource="{Binding CompletedTasks}" ItemTemplate="{StaticResource TaskRow}" Visibility="{Binding IsCompletedExpanded, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2">
                <Button x:Name="DrawerAddTaskButton" Height="54" Padding="18,0" HorizontalContentAlignment="Left" Command="{Binding AddTaskCommand}" Foreground="#F47728">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PlainButton}"><Style.Triggers><DataTrigger Binding="{Binding IsCreating}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe UI" FontSize="23" Foreground="#F47728" Margin="0,0,9,0" Text="+" /><TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#F47728" Text="添加任务" /></StackPanel>
                </Button>
                <Border x:Name="TaskEditorPanel" Background="White" BorderBrush="#E9EBEF" BorderThickness="0,1,0,0" CornerRadius="14,14,0,0"
                        Visibility="{Binding IsCreating, Converter={StaticResource BoolVisibility}}" IsVisibleChanged="TaskEditorPanel_IsVisibleChanged" Padding="16,18,16,13">
                    <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="3" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Background="#FF791D" CornerRadius="1.5" Margin="0,3,0,5" />
                            <Grid Grid.Column="1" Margin="9,0,0,0">
                                <TextBox x:Name="DraftTaskTitleInput" Height="34" FontSize="17" FontWeight="Medium" Style="{StaticResource BorderlessInput}"
                                         Text="{Binding DraftTitle, UpdateSourceTrigger=PropertyChanged}" KeyDown="DraftTaskTitleInput_KeyDown" AutomationProperties.Name="任务名称" />
                                <TextBlock VerticalAlignment="Center" Text="输入任务名称" FontSize="17" Foreground="#4F5662" IsHitTestVisible="False">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DraftTitle}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                        <Grid Margin="12,8,0,0">
                            <TextBox x:Name="DraftTaskDescriptionInput" Height="48" VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     FontSize="12" Foreground="#69717E" Style="{StaticResource BorderlessInput}" Text="{Binding Draft.Description, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="任务描述" />
                            <TextBlock Text="添加任务描述..." FontSize="12" Foreground="#A5ABB5" Margin="0,2,0,0" IsHitTestVisible="False">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Draft.Description}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Border Height="1" Margin="0,9,0,15" Background="#EBEDF0" />
                        <Grid Margin="1,0,1,10"><TextBlock Text="子任务" FontSize="12" FontWeight="SemiBold" Foreground="#454B55" /><TextBlock HorizontalAlignment="Right" Text="{Binding SubTaskCountDisplay}" FontFamily="Segoe UI" FontSize="11" Foreground="#959CAA" /></Grid>
                        <ScrollViewer MaxHeight="105" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DraftSubTaskList" ItemsSource="{Binding Draft.SubTasks}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Grid MinHeight="29"><Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /></Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}" VerticalAlignment="Center" Style="{StaticResource CircleCheck}" AutomationProperties.Name="子任务完成状态" />
                                        <TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Style="{StaticResource BorderlessInput}" AutomationProperties.Name="子任务名称" />
                                        <Button Grid.Column="2" Width="20" Height="22" Style="{StaticResource PlainButton}" Content="×" FontSize="16" Command="{Binding DataContext.DeleteSubTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="删除子任务" />
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Grid Height="33" Margin="0,2,0,8" IsEnabled="{Binding CanEnterSubTask}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="⊕" FontFamily="Segoe UI Symbol" Foreground="#FF7A22" FontSize="20" VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="DraftSubTaskInput" Style="{StaticResource BorderlessInput}" FontSize="11" Text="{Binding SubTaskInput, UpdateSourceTrigger=PropertyChanged}" KeyDown="DraftSubTaskInput_KeyDown" AutomationProperties.Name="添加子任务，按回车创建" />
                                <TextBlock Text="添加子任务" Foreground="#A0A6B0" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SubTaskInput}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                        <Border Height="1" Background="#EBEDF0" Margin="0,0,0,11" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Width="56" Height="34" Command="{Binding CancelCreationCommand}" Content="取消" Foreground="#717987" Style="{StaticResource PlainButton}" />
                            <Button x:Name="DrawerCreateTaskButton" Width="88" Height="34" Margin="9,0,0,0" Command="{Binding CreateTaskCommand}" Content="{Binding CommitButtonText}" Style="{StaticResource TaskPrimaryButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
