<UserControl x:Class="FocusApp.Desktop.Views.BlockedContentRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             Height="52"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="BlockedRowIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="IconButtonBackground" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconButtonBackground" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconButtonBackground" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,2,0">
        <Border Height="1"
                Margin="12,0,8,0"
                VerticalAlignment="Bottom"
                Background="{DynamicResource OverlayBorder}"
                Opacity="0.72" />
        <Grid Margin="14,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition />
                <ColumnDefinition Width="62" />
                <ColumnDefinition Width="42" />
            </Grid.ColumnDefinitions>

            <Border Width="32"
                    Height="32"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AccentTint}"
                    CornerRadius="9">
                <Grid>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="17"
                               Foreground="{DynamicResource AccentPrimary}"
                               Text="{Binding IconGlyph}" />
                    <Image Width="25"
                           Height="25"
                           Source="{Binding Favicon}"
                           Stretch="Uniform" />
                </Grid>
            </Border>

            <TextBlock Grid.Column="1"
                       Margin="2,0,8,0"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="Normal"
                       Foreground="{DynamicResource TextPrimary}"
                       Text="{Binding Name}"
                       TextTrimming="CharacterEllipsis" />

            <Border Grid.Column="2"
                    Width="50"
                    Height="25"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AccentTint}"
                    CornerRadius="9">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontWeight="Normal"
                           Foreground="{DynamicResource AccentPrimary}"
                           Text="{Binding TypeText}" />
            </Border>

            <Button Grid.Column="3"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{DynamicResource BlockedContentDisable}"
                    Command="{Binding DataContext.DisableCommand, RelativeSource={RelativeSource AncestorType={x:Type views:BlockedContentModal}}}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource BlockedRowIconButtonStyle}"
                    ToolTip="{DynamicResource BlockedContentDisable}">
                <Viewbox Width="16"
                         Height="16">
                    <Canvas Width="16" Height="16">
                        <Path Data="M 3.25,4.5 L 12.75,4.5 M 6,2.75 L 10,2.75 M 4.5,4.5 L 5.25,13.25 L 10.75,13.25 L 11.5,4.5 M 7,6.5 L 7,11.5 M 9,6.5 L 9,11.5"
                              Fill="{DynamicResource TransparentBrush}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="1.35" />
                    </Canvas>
                </Viewbox>
            </Button>
        </Grid>
    </Grid>
</UserControl>
