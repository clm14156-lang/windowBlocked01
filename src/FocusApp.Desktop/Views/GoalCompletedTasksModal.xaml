<UserControl x:Class="FocusApp.Desktop.Views.GoalCompletedTasksModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FocusApp.Desktop.ViewModels"
             UseLayoutRounding="True" SnapsToDevicePixels="True" Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
             FontFamily="{DynamicResource FontFamilyPrimary}" Foreground="{DynamicResource StatisticsBodyBrush}"
             PreviewKeyDown="Modal_PreviewKeyDown" IsVisibleChanged="Modal_IsVisibleChanged">
    <UserControl.Style><Style TargetType="UserControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></UserControl.Style>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/FocusApp.Desktop;component/Resources/StatisticsScrollStyles.xaml"/><ResourceDictionary Source="/FocusApp.Desktop;component/Resources/StatisticsTypography.xaml"/></ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleIf"/>
            <Style x:Key="CompletedTableHeading" TargetType="TextBlock" BasedOn="{StaticResource StatisticsAuxiliaryTextStyle}">
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{DynamicResource StatisticsSecondaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="CompletedTimeText" TargetType="TextBlock" BasedOn="{StaticResource StatisticsAuxiliaryTextStyle}">
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyEnglish}"/>
                <Setter Property="Foreground" Value="{DynamicResource StatisticsSecondaryBrush}"/>
                <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            </Style>
            <DataTemplate x:Key="CompletedRangeTextTemplate">
                <TextBlock Text="{Binding}" Style="{StaticResource StatisticsBodyTextStyle}"/>
            </DataTemplate>
            <Style x:Key="CompletedRangeOption" TargetType="ComboBoxItem">
                <Setter Property="Height" Value="30"/><Setter Property="Padding" Value="9,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyPrimary}"/><Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Foreground" Value="{DynamicResource StatisticsBodyBrush}"/><Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
                <Setter Property="ContentTemplate" Value="{StaticResource CompletedRangeTextTemplate}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="OptionSurface" Background="White" Padding="{TemplateBinding Padding}" CornerRadius="5">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" TextElement.FontFamily="{TemplateBinding FontFamily}" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Path x:Name="SelectedMark" Grid.Column="1" Width="9" Height="7" Data="M 0,3 L 3,6 L 8,0" Stroke="#727E90" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="OptionSurface" Property="Background" Value="#F5F6F8"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="OptionSurface" Property="Background" Value="#F1F3F6"/><Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="CompletedRangeSelector" TargetType="ComboBox">
                <Setter Property="Height" Value="32"/><Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/><Setter Property="Foreground" Value="{DynamicResource StatisticsBodyBrush}"/>
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyPrimary}"/><Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DDE1E8"/><Setter Property="BorderThickness" Value="1"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource CompletedRangeOption}"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="RangeToggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="SelectorSurface" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="7">
                                    <Path Width="8" Height="5" Data="M 0,0 L 4,4 L 8,0" Stroke="#6D788B" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                </Border>
                                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectorSurface" Property="Background" Value="#FAFAFB"/></Trigger></ControlTemplate.Triggers>
                            </ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="12,0,30,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{StaticResource CompletedRangeTextTemplate}" TextElement.FontFamily="{TemplateBinding FontFamily}" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}" TextElement.Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="3" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="4,4,8,8" Padding="4" Background="White" BorderBrush="#E7EAF0" BorderThickness="1" CornerRadius="8">
                                <Border.Effect><DropShadowEffect Color="#293549" BlurRadius="10" ShadowDepth="2" Opacity="0.10"/></Border.Effect>
                                <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#B9C2D0"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="CompletedTaskMenuItem" TargetType="MenuItem">
                <Setter Property="Height" Value="30"/><Setter Property="MinWidth" Value="118"/><Setter Property="FontSize" Value="{StaticResource BodyFontSize}"/><Setter Property="Foreground" Value="{StaticResource StatisticsBodyBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}"/><Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="HeaderTemplate"><Setter.Value><DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                               FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                               FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}"/>
                </DataTemplate></Setter.Value></Setter>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="ActionSurface" Background="Transparent" Padding="10,0" CornerRadius="5"><ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.FontFamily="{TemplateBinding FontFamily}" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}" TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ActionSurface" Property="Background" Value="#F5F5F7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="CompletedTaskContextMenu" TargetType="ContextMenu">
                <EventSetter Event="Opened" Handler="TaskMenu_Opened"/>
                <EventSetter Event="Closed" Handler="TaskMenu_Closed"/>
            </Style>
            <Style x:Key="CompletedTaskContainer" TargetType="ListBoxItem">
                <Setter Property="Height" Value="40"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Grid Background="White"><ContentPresenter HorizontalAlignment="Stretch"/><Border Height="1" VerticalAlignment="Bottom" Background="#EEF0F3" IsHitTestVisible="False"/></Grid></ControlTemplate></Setter.Value></Setter>
                <Setter Property="ContextMenu"><Setter.Value>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" ItemContainerStyle="{StaticResource CompletedTaskMenuItem}" Style="{StaticResource CompletedTaskContextMenu}">
                        <ContextMenu.Template><ControlTemplate TargetType="ContextMenu"><Border Background="White" BorderBrush="#ECEEF2" BorderThickness="1" CornerRadius="8" Padding="5"><ItemsPresenter/></Border></ControlTemplate></ContextMenu.Template>
                        <MenuItem Header="恢复任务" Command="{Binding RestoreCommand}" CommandParameter="{Binding}"/>
                        <MenuItem Header="删除任务" Foreground="#D55D58" Command="{Binding DeleteCommand}" CommandParameter="{Binding}"/>
                    </ContextMenu>
                </Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="Overlay" Background="#26000000" MouseDown="Overlay_MouseDown">
        <Border x:Name="ModalSurface" Width="460" Height="500" Background="White" BorderBrush="#E8EAEE" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect><DropShadowEffect Color="#424954" BlurRadius="18" Opacity="0.08" ShadowDepth="3"/></Border.Effect>
            <Grid x:Name="CloseButtonHost">
                <Grid Margin="22,20,22,20">
                    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="14"/><RowDefinition Height="32"/><RowDefinition Height="14"/><RowDefinition Height="34"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="CompletedTasksTitle" Text="已完成的任务" Style="{StaticResource StatisticsPageTitleTextStyle}" VerticalAlignment="Center"/>
                    <Grid x:Name="CompletedTasksFilters" Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="10"/><ColumnDefinition Width="174"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="RangeFilter" Style="{StaticResource CompletedRangeSelector}" SelectedValuePath="Tag" SelectedValue="{Binding SelectedRange, Mode=TwoWay}" AutomationProperties.Name="筛选已完成任务时间范围">
                            <ComboBoxItem Content="全部" Tag="{x:Static vm:CompletedTaskTimeRange.All}"/>
                            <ComboBoxItem Content="今天" Tag="{x:Static vm:CompletedTaskTimeRange.Today}"/>
                            <ComboBoxItem Content="本周" Tag="{x:Static vm:CompletedTaskTimeRange.Week}"/>
                            <ComboBoxItem Content="本月" Tag="{x:Static vm:CompletedTaskTimeRange.Month}"/>
                        </ComboBox>
                        <Border x:Name="CompletedSearchSurface" Grid.Column="2" Height="32" BorderThickness="1" CornerRadius="7" Background="White">
                            <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="#DDE1E8"/><Style.Triggers><DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchInput}" Value="True"><Setter Property="BorderBrush" Value="#B9C2D0"/></DataTrigger></Style.Triggers></Style></Border.Style>
                            <Grid Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Path Width="13" Height="13" Data="M 9,9 L 13,13 M 10.5,5.5 A 5,5 0 1 1 0.5,5.5 A 5,5 0 1 1 10.5,5.5" Stroke="#A3ACBA" StrokeThickness="1.4" StrokeStartLineCap="Round" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBox x:Name="SearchInput" Grid.Column="2" Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource FontFamilyPrimary}" FontSize="{DynamicResource BodyFontSize}" FontWeight="Normal" Foreground="{DynamicResource StatisticsBodyBrush}" Background="Transparent" BorderThickness="0" Padding="0" VerticalContentAlignment="Center" CaretBrush="{DynamicResource StatisticsBodyBrush}" AutomationProperties.Name="搜索任务">
                                    <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/></ControlTemplate></TextBox.Template>
                                </TextBox>
                                <TextBlock Grid.Column="2" Text="搜索任务..." Foreground="{DynamicResource StatisticsWeakBrush}" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource StatisticsBodyTextStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="CompletedTaskCount" Grid.Column="4" Text="{Binding FilteredCountDisplay}" Style="{StaticResource StatisticsAuxiliaryTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Border x:Name="CompletedTasksTableHeader" Grid.Row="4" Background="#F6F6F8" CornerRadius="6" Padding="12,0,14,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions>
                            <TextBlock Text="任务内容" Style="{StaticResource CompletedTableHeading}"/>
                            <Button x:Name="CompletionSortButton" Grid.Column="1" Command="{Binding ToggleSortCommand}" ToolTip="{Binding SortHint}" AutomationProperties.Name="{Binding SortHint}" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="4,0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="SortSurface" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SortSurface" Property="Background" Value="#ECEEF1"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SortSurface" Property="Background" Value="#ECEEF1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="完成时间" Style="{StaticResource CompletedTableHeading}"/>
                                    <StackPanel Margin="7,0,0,0" VerticalAlignment="Center">
                                        <Path Width="8" Height="5" Data="M 0,4 L 4,0 L 8,4" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"><Path.Style><Style TargetType="Path"><Setter Property="Stroke" Value="#BDC3CC"/><Style.Triggers><DataTrigger Binding="{Binding IsSortAscending}" Value="True"><Setter Property="Stroke" Value="#777F90"/></DataTrigger></Style.Triggers></Style></Path.Style></Path>
                                        <Path Width="8" Height="5" Margin="0,4,0,0" Data="M 0,0 L 4,4 L 8,0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"><Path.Style><Style TargetType="Path"><Setter Property="Stroke" Value="#BDC3CC"/><Style.Triggers><DataTrigger Binding="{Binding IsSortDescending}" Value="True"><Setter Property="Stroke" Value="#777F90"/></DataTrigger></Style.Triggers></Style></Path.Style></Path>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="5">
                        <ListBox x:Name="TaskList" ItemsSource="{Binding Tasks}" ItemContainerStyle="{StaticResource CompletedTaskContainer}" BorderThickness="0" Background="White" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="已完成的任务列表">
                            <ListBox.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource StatisticsThinScrollBarStyle}"/></ListBox.Resources>
                            <ListBox.Template><ControlTemplate TargetType="ListBox"><ScrollViewer x:Name="TasksScrollViewer" Focusable="False" Padding="0" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></ListBox.Template>
                            <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemTemplate><DataTemplate>
                                <Grid x:Name="CompletedTaskRow" Margin="12,0,12,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions>
                                    <Border x:Name="CompletedParentMark" Width="18" Height="18" CornerRadius="4" Background="#FF871F" VerticalAlignment="Center" IsHitTestVisible="False"><Path Width="13" Height="11" Data="M 0,5 L 4,9 L 12,1" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock x:Name="CompletedTaskName" Grid.Column="2" Text="{Binding Name}" Style="{StaticResource StatisticsBodyTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTip="{Binding Name}"/>
                                    <TextBlock x:Name="CompletedTaskTime" Grid.Column="3" Text="{Binding TimeDisplay}" Style="{StaticResource CompletedTimeText}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="CompletedTasksEmptyState" Text="{Binding EmptyText}" Foreground="{DynamicResource StatisticsWeakBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource StatisticsBodyTextStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasResults}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    </Grid>
                    <TextBlock Grid.Row="6" Text="{Binding ErrorText}" Style="{StaticResource StatisticsAuxiliaryTextStyle}" Foreground="#D85B57" Margin="0,7,0,0" Visibility="{Binding HasError, Converter={StaticResource VisibleIf}}"/>
                </Grid>
                <Button x:Name="CloseModalButton" Style="{DynamicResource ModalCloseButtonStyle}" Command="{Binding CloseCommand}" AutomationProperties.Name="关闭已完成的任务"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
