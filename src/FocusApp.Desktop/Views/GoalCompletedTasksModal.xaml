<UserControl x:Class="FocusApp.Desktop.Views.GoalCompletedTasksModal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 UseLayoutRounding="True" SnapsToDevicePixels="True" Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
 PreviewKeyDown="Modal_PreviewKeyDown" IsVisibleChanged="Modal_IsVisibleChanged">
 <UserControl.Style><Style TargetType="UserControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></UserControl.Style>
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="VisibleIf"/>
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"/><Setter Property="FontSize" Value="{DynamicResource SecondaryFontSize}"/><Setter Property="FontWeight" Value="{DynamicResource SecondaryFontWeight}"/><Setter Property="Foreground" Value="#273344"/></Style>
  <Style x:Key="QuietAction" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F5F6F8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="QuietToggle" TargetType="ToggleButton">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F5F6F8"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F1F3F6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="5"/><Setter Property="MinWidth" Value="5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Width="5"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#D7DBE3" CornerRadius="2" Width="3" MinHeight="24"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid x:Name="Overlay" Background="#26000000" MouseDown="Overlay_MouseDown">
  <Border x:Name="ModalSurface" Width="400" Height="430" Background="White" BorderBrush="#ECEEF2" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center">
   <Border.Effect><DropShadowEffect Color="#526070" BlurRadius="18" Opacity="0.1" ShadowDepth="3"/></Border.Effect>
   <Grid x:Name="CloseButtonHost">
   <Grid Margin="20,17,20,18">
    <Grid.RowDefinitions><RowDefinition Height="27"/><RowDefinition Height="12"/><RowDefinition Height="36"/><RowDefinition Height="12"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><StackPanel Orientation="Horizontal"><TextBlock Text="已完成任务" FontSize="{DynamicResource DialogTitleFontSize}" FontWeight="{DynamicResource DialogTitleFontWeight}" Foreground="#17202C" VerticalAlignment="Center"/><TextBlock Text="{Binding TotalCount, StringFormat=共{0}项}" Margin="10,0,0,0" FontSize="{DynamicResource SecondaryFontSize}" FontWeight="{DynamicResource SecondaryFontWeight}" Foreground="#939BA9" VerticalAlignment="Center"/></StackPanel></Grid>
     <Border x:Name="SearchSurface" Grid.Row="2" Background="#F7F8FA" BorderBrush="#E8EBF1" BorderThickness="1" CornerRadius="8" Padding="12,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="19"/><ColumnDefinition/></Grid.ColumnDefinitions><Path Width="12" Height="12" Data="M 9,5 A 4,4 0 1 1 1,5 A 4,4 0 1 1 9,5 M 8,8 L 12,12" Stroke="#929CAC" StrokeThickness="1.2" VerticalAlignment="Center"/>
       <TextBox x:Name="SearchInput" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="0" FontSize="{DynamicResource BodyFontSize}" FontWeight="{DynamicResource BodyFontWeight}" FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI" Foreground="#273344" VerticalContentAlignment="Center"/>
       <TextBlock Grid.Column="1" Text="搜索已完成任务…" FontSize="{DynamicResource BodyFontSize}" FontWeight="{DynamicResource BodyFontWeight}" Foreground="#939BA9" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
     </Border>
    <Border x:Name="SearchDivider" Grid.Row="3" Height="1" Background="#F0F2F5" VerticalAlignment="Bottom"/>
    <Grid Grid.Row="4">
     <ScrollViewer x:Name="TasksScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="DateGroups" ItemsSource="{Binding Days}" AlternationCount="2147483647"><ItemsControl.ItemTemplate><DataTemplate>
       <StackPanel>
        <Border x:Name="DateGroupSeparator" Height="1" Background="#F0F2F5"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
        <Button x:Name="DateGroupHeader" Height="40" Padding="8,0" HorizontalContentAlignment="Stretch" Style="{StaticResource QuietAction}" Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding DateDisplay}">
         <Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding DateDisplay}" FontSize="{DynamicResource BodyMediumFontSize}" FontWeight="{DynamicResource BodyMediumFontWeight}" Foreground="#17202C"/><Border x:Name="DateGroupCountPill" Background="#F5F6F8" CornerRadius="10" Padding="8,1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding CountDisplay}" FontSize="{DynamicResource SecondaryMediumFontSize}" FontWeight="{DynamicResource SecondaryMediumFontWeight}" Foreground="#7E8CA6"/></Border></StackPanel><Path Width="6" Height="9" Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" Data="M 0,0 L 5,4.5 L 0,9" Stroke="#939BA9" StrokeThickness="1.2" RenderTransformOrigin="0.5,0.5"><Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Path.Style></Path></Grid>
        </Button>
        <ItemsControl ItemsSource="{Binding Tasks}" Margin="0,0,0,8" Visibility="{Binding IsExpanded, Converter={StaticResource VisibleIf}}"><ItemsControl.ItemTemplate><DataTemplate>
         <Grid x:Name="CompletedTaskRow" Margin="8,1,8,1" Background="Transparent">
          <Border x:Name="TaskHoverSurface" CornerRadius="6" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, ElementName=CompletedTaskRow}" Value="True"><Setter Property="Background" Value="#F5F6F8"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
          <Border x:Name="TaskContentSurface" Padding="0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <Border x:Name="CompletedParentMark" Width="15" Height="15" CornerRadius="3" Background="{DynamicResource AccentPrimary}" VerticalAlignment="Center" IsHitTestVisible="False"><Path Data="M 3.5,7.5 L 6.5,10.5 L 11.5,4.5" Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Border>
           <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="{DynamicResource BodyMediumFontSize}" FontWeight="{DynamicResource BodyMediumFontWeight}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
           <ToggleButton x:Name="TaskMoreToggle" Grid.Column="3" Width="22" Height="23" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TaskMore_Click" AutomationProperties.Name="任务操作">
            <ToggleButton.Style><Style TargetType="ToggleButton" BasedOn="{StaticResource QuietToggle}"><Setter Property="Visibility" Value="Hidden"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, ElementName=CompletedTaskRow}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ToggleButton.Style>
            <Path Width="11" Height="3" Data="M 1.5,1.5 A 0.5,0.5 0 1 1 1.49,1.5 M 5.5,1.5 A 0.5,0.5 0 1 1 5.49,1.5 M 9.5,1.5 A 0.5,0.5 0 1 1 9.49,1.5" Stroke="#8993A4" StrokeThickness="2" StrokeStartLineCap="Round"/>
           </ToggleButton>
           <Popup PlacementTarget="{Binding ElementName=TaskMoreToggle}" IsOpen="{Binding IsChecked, ElementName=TaskMoreToggle, Mode=TwoWay}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Placement="Bottom" HorizontalOffset="-93" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
            <Border Width="120" Padding="5" Margin="5" Background="White" BorderBrush="#ECEEF2" BorderThickness="1" CornerRadius="8"><Border.Effect><DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/></Border.Effect><StackPanel>
             <Button Height="29" Padding="7,0" HorizontalContentAlignment="Left" Style="{StaticResource QuietAction}" Command="{Binding RestoreCommand}" CommandParameter="{Binding}" Click="TaskOperation_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="恢复任务" FontSize="11.5"/></StackPanel></Button>
             <Button Height="29" Padding="7,0" HorizontalContentAlignment="Left" Style="{StaticResource QuietAction}" Command="{Binding DeleteCommand}" CommandParameter="{Binding}" Click="TaskOperation_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#E65353" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="删除任务" FontSize="11.5" Foreground="#E65353"/></StackPanel></Button>
            </StackPanel></Border>
           </Popup>
           <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,3,0,0" Text="{Binding Description}" FontSize="{DynamicResource SecondaryFontSize}" FontWeight="{DynamicResource SecondaryFontWeight}" LineHeight="16" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Visibility="{Binding HasDescription, Converter={StaticResource VisibleIf}}"/>
           <Border x:Name="TaskHierarchyLead" Grid.Row="1" Width="1" Background="#E1E5EC" HorizontalAlignment="Left" Margin="9.5,0,0,-5" IsHitTestVisible="False" Visibility="{Binding HasSubTasks, Converter={StaticResource VisibleIf}}"/>
           <ItemsControl x:Name="CompletedSubTasks" Grid.Row="2" Grid.ColumnSpan="4" Margin="0,5,0,0" ItemsSource="{Binding SubTaskRows}" Visibility="{Binding HasSubTasks, Converter={StaticResource VisibleIf}}">
            <ItemsControl.ItemTemplate><DataTemplate>
             <Grid x:Name="CompletedChildRow" MinHeight="18" Margin="0,2,0,2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="14"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border x:Name="ChildHierarchyTop" Width="1" Height="11" Background="#E1E5EC" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9.5,-2,0,0" IsHitTestVisible="False"/>
              <Border x:Name="ChildHierarchyBottom" Width="1" Background="#E1E5EC" HorizontalAlignment="Left" Margin="9.5,9,0,-2" IsHitTestVisible="False"/>
              <Border x:Name="ChildHierarchyBranch" Height="1" Width="18" Background="#E1E5EC" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9.5,8.5,0,0" IsHitTestVisible="False"/>
              <Grid x:Name="CompletedChildMark" Grid.Column="1" Width="12" Height="12" VerticalAlignment="Top" Margin="0,3,0,0" IsHitTestVisible="False">
               <Ellipse x:Name="CompletedChildCircle" Stroke="#FFB57F" StrokeThickness="1" Fill="Transparent"/>
               <Path x:Name="CompletedChildTick" Data="M 2.5,6 L 5,8.5 L 9.5,3.5" Stroke="White" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Grid>
              <TextBlock x:Name="CompletedChildTitle" Grid.Column="3" Text="{Binding Title}" FontSize="{DynamicResource BodyFontSize}" FontWeight="{DynamicResource BodyFontWeight}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
             </Grid>
             <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter TargetName="CompletedChildCircle" Property="Fill" Value="#FFAA70"/><Setter TargetName="CompletedChildTick" Property="Visibility" Value="Visible"/></DataTrigger>
              <DataTrigger Binding="{Binding IsLast}" Value="True"><Setter TargetName="ChildHierarchyBottom" Property="Visibility" Value="Collapsed"/></DataTrigger>
             </DataTemplate.Triggers>
            </DataTemplate></ItemsControl.ItemTemplate>
           </ItemsControl>
          </Grid>
          </Border>
         </Grid>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </StackPanel>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </ScrollViewer>
     <TextBlock Text="{Binding EmptyText}" Foreground="#939BA9" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasResults}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
    <TextBlock Grid.Row="5" Text="{Binding ErrorText}" FontSize="11" Foreground="#D85B57" Margin="0,7,0,0" Visibility="{Binding HasError, Converter={StaticResource VisibleIf}}"/>
   </Grid>
    <Button x:Name="CloseModalButton" Style="{DynamicResource ModalCloseButtonStyle}" Command="{Binding CloseCommand}" AutomationProperties.Name="关闭已完成任务" />
   </Grid>
  </Border>
 </Grid>
</UserControl>
