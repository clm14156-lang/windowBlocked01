<UserControl x:Class="FocusApp.Desktop.Views.GoalCompletedTasksModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True" Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
             FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
             PreviewKeyDown="Modal_PreviewKeyDown" IsVisibleChanged="Modal_IsVisibleChanged">
    <UserControl.Style><Style TargetType="UserControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></UserControl.Style>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/FocusApp.Desktop;component/Resources/StatisticsScrollStyles.xaml"/></ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleIf"/>
            <LinearGradientBrush x:Key="CompletedFilterAccent" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF962F" Offset="0"/><GradientStop Color="#FF7D1B" Offset="1"/></LinearGradientBrush>
            <Style x:Key="CompletedRangeButton" TargetType="RadioButton">
                <Setter Property="Width" Value="76"/><Setter Property="Height" Value="40"/><Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E7EAF0"/><Setter Property="Foreground" Value="#293247"/>
                <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                    <Border x:Name="RangeSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FFF8F2"/><Setter Property="BorderBrush" Value="#FFDCC0"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#C5CBD4"/></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{StaticResource CompletedFilterAccent}"/><Setter Property="BorderBrush" Value="#FF8B25"/><Setter Property="Foreground" Value="White"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="RangeSurface" Property="Opacity" Value="0.8"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="CompletedTaskMenuItem" TargetType="MenuItem">
                <Setter Property="Height" Value="30"/><Setter Property="MinWidth" Value="118"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#343C49"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="ActionSurface" Background="Transparent" Padding="10,0" CornerRadius="5"><ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ActionSurface" Property="Background" Value="#F5F5F7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="CompletedTaskContextMenu" TargetType="ContextMenu">
                <EventSetter Event="Opened" Handler="TaskMenu_Opened"/>
                <EventSetter Event="Closed" Handler="TaskMenu_Closed"/>
            </Style>
            <Style x:Key="CompletedTaskContainer" TargetType="ListBoxItem">
                <Setter Property="Height" Value="48"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Grid Background="White"><ContentPresenter HorizontalAlignment="Stretch"/><Border Height="1" VerticalAlignment="Bottom" Background="#EEF0F3" IsHitTestVisible="False"/></Grid></ControlTemplate></Setter.Value></Setter>
                <Setter Property="ContextMenu"><Setter.Value>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" ItemContainerStyle="{StaticResource CompletedTaskMenuItem}" Style="{StaticResource CompletedTaskContextMenu}">
                        <ContextMenu.Template><ControlTemplate TargetType="ContextMenu"><Border Background="White" BorderBrush="#ECEEF2" BorderThickness="1" CornerRadius="8" Padding="5"><ItemsPresenter/></Border></ControlTemplate></ContextMenu.Template>
                        <MenuItem Header="恢复任务" Command="{Binding RestoreCommand}" CommandParameter="{Binding}"/>
                        <MenuItem Header="删除任务" Foreground="#D55D58" Command="{Binding DeleteCommand}" CommandParameter="{Binding}"/>
                    </ContextMenu>
                </Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="Overlay" Background="#26000000" MouseDown="Overlay_MouseDown">
        <Border x:Name="ModalSurface" Width="600" Height="590" Background="White" BorderBrush="#E8EAEE" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect><DropShadowEffect Color="#424954" BlurRadius="18" Opacity="0.08" ShadowDepth="3"/></Border.Effect>
            <Grid x:Name="CloseButtonHost">
                <Grid Margin="26,20,26,24">
                    <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="12"/><RowDefinition Height="40"/><RowDefinition Height="16"/><RowDefinition Height="44"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="CompletedTasksTitle" Text="已完成的任务" FontSize="28" FontWeight="SemiBold" Foreground="#111722" VerticalAlignment="Center"/>
                    <Grid x:Name="CompletedTasksFilters" Grid.Row="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="AllFilter" Content="全部" Width="86" GroupName="CompletedTaskRange" IsChecked="{Binding IsAllRange, Mode=TwoWay}" Style="{StaticResource CompletedRangeButton}" AutomationProperties.Name="全部"/>
                            <RadioButton x:Name="TodayFilter" Content="今天" GroupName="CompletedTaskRange" IsChecked="{Binding IsTodayRange, Mode=TwoWay}" Style="{StaticResource CompletedRangeButton}" AutomationProperties.Name="今天"/>
                            <RadioButton x:Name="WeekFilter" Content="本周" GroupName="CompletedTaskRange" IsChecked="{Binding IsWeekRange, Mode=TwoWay}" Style="{StaticResource CompletedRangeButton}" AutomationProperties.Name="本周"/>
                            <RadioButton x:Name="MonthFilter" Content="本月" Margin="0" GroupName="CompletedTaskRange" IsChecked="{Binding IsMonthRange, Mode=TwoWay}" Style="{StaticResource CompletedRangeButton}" AutomationProperties.Name="本月"/>
                        </StackPanel>
                        <TextBlock x:Name="CompletedTaskCount" Text="{Binding FilteredCountDisplay}" FontSize="14" Foreground="#7C8494" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Border x:Name="CompletedTasksTableHeader" Grid.Row="4" Background="#F6F6F8" CornerRadius="6,6,0,0" Padding="18,0,20,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="142"/></Grid.ColumnDefinitions>
                            <TextBlock Text="任务内容" FontSize="15" FontWeight="SemiBold" Foreground="#7B8392" VerticalAlignment="Center"/>
                            <Button x:Name="CompletionSortButton" Grid.Column="1" Command="{Binding ToggleSortCommand}" ToolTip="{Binding SortHint}" AutomationProperties.Name="{Binding SortHint}" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="4,0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="SortSurface" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SortSurface" Property="Background" Value="#ECEEF1"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SortSurface" Property="Background" Value="#ECEEF1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="完成时间" FontSize="15" FontWeight="SemiBold" Foreground="#7B8392" VerticalAlignment="Center"/>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <Path Width="8" Height="5" Data="M 0,4 L 4,0 L 8,4" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"><Path.Style><Style TargetType="Path"><Setter Property="Stroke" Value="#BDC3CC"/><Style.Triggers><DataTrigger Binding="{Binding IsSortAscending}" Value="True"><Setter Property="Stroke" Value="#777F90"/></DataTrigger></Style.Triggers></Style></Path.Style></Path>
                                        <Path Width="8" Height="5" Margin="0,4,0,0" Data="M 0,0 L 4,4 L 8,0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"><Path.Style><Style TargetType="Path"><Setter Property="Stroke" Value="#BDC3CC"/><Style.Triggers><DataTrigger Binding="{Binding IsSortDescending}" Value="True"><Setter Property="Stroke" Value="#777F90"/></DataTrigger></Style.Triggers></Style></Path.Style></Path>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="5">
                        <ListBox x:Name="TaskList" ItemsSource="{Binding Tasks}" ItemContainerStyle="{StaticResource CompletedTaskContainer}" BorderThickness="0" Background="White" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="已完成的任务列表">
                            <ListBox.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource StatisticsThinScrollBarStyle}"/></ListBox.Resources>
                            <ListBox.Template><ControlTemplate TargetType="ListBox"><ScrollViewer x:Name="TasksScrollViewer" Focusable="False" Padding="0" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></ListBox.Template>
                            <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemTemplate><DataTemplate>
                                <Grid x:Name="CompletedTaskRow" Margin="14,0,14,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="22"/><ColumnDefinition/><ColumnDefinition Width="142"/></Grid.ColumnDefinitions>
                                    <Border x:Name="CompletedParentMark" Width="22" Height="22" CornerRadius="4" Background="#FF871F" VerticalAlignment="Center" IsHitTestVisible="False"><Path Width="13" Height="11" Data="M 0,5 L 4,9 L 12,1" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock x:Name="CompletedTaskName" Grid.Column="2" Text="{Binding Name}" FontSize="14" FontWeight="Medium" Foreground="#182131" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTip="{Binding Name}"/>
                                    <TextBlock x:Name="CompletedTaskTime" Grid.Column="3" Text="{Binding TimeDisplay}" FontSize="14" Foreground="#808899" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"/>
                                </Grid>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="CompletedTasksEmptyState" Text="{Binding EmptyText}" FontSize="13" Foreground="#929AA7" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasResults}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    </Grid>
                    <TextBlock Grid.Row="6" Text="{Binding ErrorText}" FontSize="11" Foreground="#D85B57" Margin="0,7,0,0" Visibility="{Binding HasError, Converter={StaticResource VisibleIf}}"/>
                </Grid>
                <Button x:Name="CloseModalButton" Style="{DynamicResource ModalCloseButtonStyle}" Command="{Binding CloseCommand}" AutomationProperties.Name="关闭已完成的任务"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
