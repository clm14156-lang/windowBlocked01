<UserControl x:Class="FocusApp.Desktop.Views.GoalTasksModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Focusable="True"
             KeyboardNavigation.TabNavigation="Cycle"
             PreviewKeyDown="Modal_PreviewKeyDown"
             Unloaded="Modal_Unloaded"
             IsVisibleChanged="Modal_IsVisibleChanged">
    <UserControl.Style>
        <Style TargetType="{x:Type UserControl}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.Resources>
        <views:GoalInverseVisibilityConverter x:Key="InverseVisibilityConverter" />
        <Style x:Key="TaskQuietButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#F7F7F9" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#F0F0F3" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GoalTasksThinScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="5" />
            <Setter Property="MinWidth" Value="5" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Opacity" Value="0.36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="5" Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" Margin="0,3" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}" BorderThickness="0" Command="{x:Static ScrollBar.PageUpCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Width="3" Margin="1,0" HorizontalAlignment="Center" Background="{DynamicResource TextSecondary}" CornerRadius="1.5" Opacity="0.58" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}" BorderThickness="0" Command="{x:Static ScrollBar.PageDownCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.9" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.2" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource ModalScrim}" MouseDown="Overlay_MouseDown">
        <Border x:Name="GoalTasksCard"
                Width="330"
                Height="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                BorderBrush="#EEEEF0"
                BorderThickness="1"
                CornerRadius="18"
                Padding="26,22,26,20">
            <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.10" /></Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="已完成任务" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Top" />
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Width="28"
                        Height="28"
                        Margin="0,-2,-2,0"
                        Style="{StaticResource TaskQuietButton}"
                        Command="{Binding CloseCommand}"
                        AutomationProperties.Name="关闭已完成任务">
                    <TextBlock Text="×" FontSize="24" FontWeight="Light" Foreground="{DynamicResource TextWeak}" />
                </Button>
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="CompletedTasksScrollViewer"
                                  ScrollChanged="CompletedTasks_ScrollChanged"
                                  Margin="0,2,-4,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources><Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource GoalTasksThinScrollBarStyle}" /></ScrollViewer.Resources>
                        <ItemsControl x:Name="CompletedTasksControl" ItemsSource="{Binding CompletedGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Margin" Value="0,0,0,14" />
                                                <Style.Triggers><DataTrigger Binding="{Binding IsLast}" Value="True"><Setter Property="Margin" Value="0" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Grid x:Name="CompletedTaskGroupHeader" Height="36">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Tasks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="CompletedTaskRow"
                                                                Height="38"
                                                                BorderBrush="#EFEFF2"
                                                                BorderThickness="0,0,0,1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F6F5F4" /></Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                                                <Border Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource AccentPrimary}" CornerRadius="5">
                                                                    <Path Width="10" Height="7" Data="M 0,3.5 L 3.5,7 L 10,0" Stretch="Fill" Stroke="White" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <TextBlock Grid.Column="1" Margin="0,0,12,0" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                                <Grid Grid.Column="2">
                                                                    <TextBlock x:Name="CompletedTaskTime" Text="{Binding CompletedTimeDisplay}" FontSize="11.5" Foreground="{DynamicResource TextWeak}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                                    <Button x:Name="CompletedTaskMore" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                            Visibility="Hidden" Style="{StaticResource TaskQuietButton}" Click="CompletedTaskMore_Click"
                                                                            AutomationProperties.Name="更多操作">
                                                                        <TextBlock Text="&#x2026;" FontSize="18" Foreground="#8B8B93" Margin="0,-5,0,0" />
                                                                    </Button>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <Trigger SourceName="CompletedTaskRow" Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="CompletedTaskTime" Property="Visibility" Value="Hidden" />
                                                                <Setter TargetName="CompletedTaskMore" Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="暂无已完成任务"
                               FontSize="13"
                               Foreground="{DynamicResource TextWeak}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasCompletedTasks, Converter={StaticResource InverseVisibilityConverter}}" />
                </Grid>
                <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Margin="0,8,0,0" FontSize="11" Foreground="#D95B40" />
            </Grid>
        </Border>
        <Popup x:Name="CompletedTaskMenu" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               VerticalOffset="2" Closed="CompletedTaskMenu_Closed">
            <Border Background="Transparent" Padding="8">
                <Border Background="White" CornerRadius="9" Padding="4" BorderBrush="#EEEEF0" BorderThickness="1">
                    <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.14" /></Border.Effect>
                    <Button Width="100" Height="30" Style="{StaticResource TaskQuietButton}" Click="DeleteCompletedTask_Click" AutomationProperties.Name="删除">
                        <TextBlock Width="76" Text="删除" TextAlignment="Left" FontSize="13" Foreground="#303038" />
                    </Button>
                </Border>
            </Border>
        </Popup>
    </Grid>
</UserControl>
