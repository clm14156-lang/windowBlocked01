<UserControl x:Class="FocusApp.Desktop.Views.GoalTasksModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             UseLayoutRounding="True" SnapsToDevicePixels="True" Focusable="True"
             KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="Modal_PreviewKeyDown"
             PreviewMouseDown="Modal_PreviewMouseDown" IsVisibleChanged="Modal_IsVisibleChanged">
    <UserControl.Style><Style TargetType="UserControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></UserControl.Style>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <views:GoalInverseVisibilityConverter x:Key="InverseVisibilityConverter"/>
        <Style x:Key="TaskQuietButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#F7F7F9"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#F0F0F3"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TaskTabButton" TargetType="Button" BasedOn="{StaticResource TaskQuietButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid Background="Transparent">
                    <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,0,2"/>
                    <Border x:Name="Indicator" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource AccentPrimary}" Opacity="0"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
                        <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                    </DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TaskInlineInput" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GoalTasksThinScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="5" />
            <Setter Property="MinWidth" Value="5" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Opacity" Value="0.36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="5" Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   Margin="0,3"
                                   IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Width="3"
                                                        Margin="1,0"
                                                        HorizontalAlignment="Center"
                                                        Background="{DynamicResource TextSecondary}"
                                                        CornerRadius="1.5"
                                                        Opacity="0.58" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>
    <Grid Background="{DynamicResource ModalScrim}" MouseDown="Overlay_MouseDown">
        <Border x:Name="GoalTasksCard" Width="450" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="White" BorderBrush="#EEEEF0" BorderThickness="1" CornerRadius="18" Padding="24,20,24,18">
            <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.10"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="全部任务" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Top"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="28" Height="28" Margin="0,-2,-4,0" Style="{StaticResource TaskQuietButton}" Command="{Binding CloseCommand}" AutomationProperties.Name="关闭全部任务">
                    <TextBlock Text="×" FontSize="24" FontWeight="Light" Foreground="{DynamicResource TextWeak}"/>
                </Button>
                <Grid Grid.Row="1">
                    <Border Height="1" Background="#EEEEF0" VerticalAlignment="Bottom"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Width="86" Style="{StaticResource TaskTabButton}" Content="{Binding PendingTabTitle}" Tag="{Binding IsPendingTab}" Command="{Binding SelectPendingTabCommand}"/>
                        <Button Width="94" Margin="8,0,0,0" Style="{StaticResource TaskTabButton}" Content="{Binding CompletedTabTitle}" Tag="{Binding IsCompletedTab}" Command="{Binding SelectCompletedTabCommand}"/>
                    </StackPanel>
                    <Button x:Name="NewTaskButton" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="5,5" Focusable="False"
                            Style="{StaticResource TaskQuietButton}" Command="{Binding NewTaskCommand}" Visibility="{Binding IsPendingTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="＋ 新建任务" FontSize="13" Foreground="{DynamicResource AccentPrimary}"/>
                    </Button>
                </Grid>
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid Visibility="{Binding IsPendingTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer x:Name="PendingTasksScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource GoalTasksThinScrollBarStyle}"/></ScrollViewer.Resources>
                            <StackPanel>
                                <Border x:Name="TaskEditorRow" Height="34" Background="#F7F8FA" CornerRadius="6" Visibility="{Binding IsCreating, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid Margin="0,0,4,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Center" BorderBrush="#B9BDC6" BorderThickness="1" CornerRadius="4"/>
                                        <Grid Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Text="输入任务名称…" FontSize="14" Foreground="{DynamicResource TextWeak}" IsHitTestVisible="False" VerticalAlignment="Center">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DraftName}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                            <TextBox x:Name="NewTaskNameTextBox" Style="{StaticResource TaskInlineInput}" Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}"
                                                     IsVisibleChanged="Editor_IsVisibleChanged" PreviewKeyDown="Editor_PreviewKeyDown" LostKeyboardFocus="Editor_LostKeyboardFocus"/>
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="Enter 创建 · Esc 取消" FontSize="10" Foreground="{DynamicResource TextWeak}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ItemsControl x:Name="PendingTasksControl" ItemsSource="{Binding PendingTasks}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Grid Height="32">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Button Width="21" Height="25" HorizontalAlignment="Left" Style="{StaticResource TaskQuietButton}" Focusable="False"
                                                    Command="{Binding DataContext.CompleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="完成任务">
                                                <Border Width="17" Height="17" BorderBrush="#B9BDC6" BorderThickness="1" CornerRadius="4"/>
                                            </Button>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                        </Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock Text="暂无未完成任务" FontSize="13" Foreground="{DynamicResource TextWeak}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ShowPendingEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                    <Grid Visibility="{Binding IsCompletedTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer x:Name="CompletedTasksScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource GoalTasksThinScrollBarStyle}"/></ScrollViewer.Resources>
                            <ItemsControl ItemsSource="{Binding CompletedGroups}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Margin="0,0,0,12" Padding="0,0,0,12" BorderBrush="#EEEEF0">
                                        <Border.Style><Style TargetType="Border"><Setter Property="BorderThickness" Value="0,0,0,1"/><Style.Triggers><DataTrigger Binding="{Binding IsLast}" Value="True"><Setter Property="BorderThickness" Value="0"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <StackPanel>
                                            <StackPanel Height="30" Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextWeak}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Tasks}">
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <Grid Height="28">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                                                        <Border Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource AccentPrimary}" CornerRadius="8">
                                                            <Path Width="9" Height="6" Data="M 0,3 L 3,6 L 9,0" Stretch="Fill" Stroke="White" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Margin="0,0,12,0" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding CompletedTimeDisplay}" FontSize="11" Foreground="{DynamicResource TextWeak}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="暂无已完成任务" FontSize="13" Foreground="{DynamicResource TextWeak}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasCompletedTasks, Converter={StaticResource InverseVisibilityConverter}}"/>
                    </Grid>
                </Grid>
                <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Margin="0,6,0,0" FontSize="11" Foreground="#D95B40" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
