<UserControl x:Class="FocusApp.Desktop.Views.GoalFocusCalendarModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource FontFamilyPrimary}" UseLayoutRounding="True"
             KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="Modal_PreviewKeyDown"
             IsVisibleChanged="Modal_IsVisibleChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FocusApp.Desktop;component/Resources/StatisticsTypography.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
            <Style x:Key="CalendarMonthArrow" TargetType="Button">
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Foreground" Value="{DynamicResource StatisticsPrimaryBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FD7E05"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CalendarWeekdayLabel" TargetType="TextBlock" BasedOn="{StaticResource StatisticsAuxiliaryTextStyle}">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource StatisticsSecondaryBrush}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Grid Background="#26000000" MouseDown="Overlay_MouseDown">
        <Border x:Name="CalendarSurface" Width="330" Height="400" Background="White" BorderBrush="#E8EAEE"
                BorderThickness="1" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#424954" BlurRadius="18" Opacity="0.10" ShadowDepth="3"/>
            </Border.Effect>
            <Grid>
                <Grid Margin="18,17,18,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="31"/>
                        <RowDefinition Height="43"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,36,0" VerticalAlignment="Top">
                        <TextBlock x:Name="CalendarTitle" DockPanel.Dock="Left" Text="专注日历"
                                   Style="{StaticResource StatisticsPageTitleTextStyle}" VerticalAlignment="Center"/>
                        <Border DockPanel.Dock="Left" Width="1" Height="13" Margin="10,0" Background="#E2E6ED"
                                Visibility="{Binding HasMonthFocus, Converter={StaticResource VisibleWhenTrue}}"/>
                        <TextBlock x:Name="CalendarMonthTotal" Text="{Binding MonthTotalDisplay}" TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource StatisticsAuxiliaryTextStyle}" VerticalAlignment="Center"
                                   Visibility="{Binding HasMonthFocus, Converter={StaticResource VisibleWhenTrue}}"/>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <TextBlock Text="{Binding MonthDisplay}" Style="{StaticResource StatisticsHeadingTextStyle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource CalendarMonthArrow}" Command="{Binding PreviousMonthCommand}"
                                HorizontalAlignment="Left" AutomationProperties.Name="上个月">
                            <Path Data="M 6,1 L 2,5 L 6,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Button>
                        <Button Style="{StaticResource CalendarMonthArrow}" Command="{Binding NextMonthCommand}"
                                HorizontalAlignment="Right" AutomationProperties.Name="下个月">
                            <Path Data="M 2,1 L 6,5 L 2,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Button>
                    </Grid>
                    <UniformGrid Grid.Row="2" Columns="7">
                        <TextBlock Text="一" Style="{StaticResource CalendarWeekdayLabel}"/>
                        <TextBlock Text="二" Style="{StaticResource CalendarWeekdayLabel}"/>
                        <TextBlock Text="三" Style="{StaticResource CalendarWeekdayLabel}"/>
                        <TextBlock Text="四" Style="{StaticResource CalendarWeekdayLabel}"/>
                        <TextBlock Text="五" Style="{StaticResource CalendarWeekdayLabel}"/>
                        <TextBlock Text="六" Style="{StaticResource CalendarWeekdayLabel}"/>
                        <TextBlock Text="日" Style="{StaticResource CalendarWeekdayLabel}"/>
                    </UniformGrid>
                    <Border Grid.Row="2" Height="1" Background="#EEF0F3" VerticalAlignment="Bottom"/>
                    <ItemsControl x:Name="CalendarDays" Grid.Row="3" ItemsSource="{Binding Cells}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="6" Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <Grid.RowDefinitions><RowDefinition Height="17"/><RowDefinition Height="16"/></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding DayDisplay}" TextAlignment="Center" FontFamily="{DynamicResource FontFamilyEnglish}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatisticsBodyTextStyle}">
                                                <Setter Property="Foreground" Value="#98A2B3"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasFocus}" Value="True"><Setter Property="Foreground" Value="{DynamicResource StatisticsPrimaryBrush}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Row="1" Text="{Binding DurationDisplay}" TextAlignment="Center"
                                               Style="{StaticResource StatisticsAuxiliaryTextStyle}" Foreground="#FD7E05"
                                               FontFamily="{DynamicResource FontFamilyEnglish}"
                                               Visibility="{Binding HasFocus, Converter={StaticResource VisibleWhenTrue}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <Button x:Name="CloseCalendarButton" Style="{DynamicResource ModalCloseButtonStyle}" Command="{Binding CloseCommand}"
                        Margin="0,12,12,0" AutomationProperties.Name="关闭专注日历"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
