<UserControl x:Class="FocusApp.Desktop.Views.FocusCharacterPickerModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             FontFamily="{DynamicResource FontFamilyPrimary}" UseLayoutRounding="True" SnapsToDevicePixels="True"
             Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
             PreviewKeyDown="Modal_PreviewKeyDown" IsVisibleChanged="Modal_IsVisibleChanged">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/><Setter Property="MinWidth" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="5" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Width="3" MinHeight="24" Background="#D7DBE3" CornerRadius="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CharacterCard" TargetType="Button">
            <Setter Property="Height" Value="162"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="#FAFAFC" BorderBrush="#EEF0F4" BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <views:FocusCharacterImage x:Name="CharacterImage" CharacterId="{Binding Id}" IsNight="False" DecodePixelWidth="320"
                                                           Width="116" Height="116" Margin="8,9,8,0" VerticalAlignment="Top"
                                                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
                                <TextBlock x:Name="CharacterName" Text="{Binding Name}" FontSize="{DynamicResource BodyFontSize}" FontWeight="{DynamicResource BodyFontWeight}"
                                           Foreground="#1D2738" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="4,0,4,11"/>
                                <Grid x:Name="SelectionMark" Width="19" Height="19" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Visibility="Collapsed">
                                    <Ellipse Fill="#8F95A3"/>
                                    <Path Data="M 5,9.5 L 8,12.5 L 14,6.5" Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Grid>
                                <Border x:Name="VipLockBadge" Width="44" Height="20"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,7,0"
                                        Background="#FFF5E7" BorderBrush="#FFDAB0" BorderThickness="1"
                                        CornerRadius="10" Visibility="Collapsed" IsHitTestVisible="False">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="8" Height="10" VerticalAlignment="Center">
                                            <Path Stroke="#C67B19" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M 2,4 V 2.8 C 2,0.4 6,0.4 6,2.8 V 4" />
                                            <Rectangle Width="6" Height="5" Canvas.Left="1" Canvas.Top="4" RadiusX="1" RadiusY="1" Fill="#C67B19" />
                                            <Ellipse Width="1" Height="1.4" Canvas.Left="3.5" Canvas.Top="5.4" Fill="#FFF5E7" />
                                        </Canvas>
                                        <TextBlock Margin="3,0,0,0" VerticalAlignment="Center" Text="VIP"
                                                   FontFamily="{DynamicResource FontFamilyEnglish}" FontSize="10"
                                                   FontWeight="Medium" Foreground="#C67B19" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                                <Setter TargetName="Card" Property="Background" Value="#F4F5F8"/>
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#9DA4B2"/></Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#EFF0F4"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="#CFD3DE"/>
                                <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                <Setter Property="Cursor" Value="Arrow"/>
                                <Setter TargetName="CharacterImage" Property="Opacity" Value="0.45"/>
                                <Setter TargetName="CharacterName" Property="Foreground" Value="#7C8492"/>
                                <Setter TargetName="Card" Property="Background" Value="#FAFAFC"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="#EEF0F4"/>
                                <Setter TargetName="SelectionMark" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="VipLockBadge" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="Overlay" Background="#40000000" MouseDown="Overlay_MouseDown">
        <Border x:Name="ModalSurface" Width="500" Height="450" Background="White" BorderBrush="#EAECF1" BorderThickness="1"
                CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect><DropShadowEffect Color="#263244" BlurRadius="24" Opacity="0.12" ShadowDepth="4"/></Border.Effect>
            <Grid Margin="20,18,20,18">
                <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="14"/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="选择专注角色" FontSize="{DynamicResource DialogTitleFontSize}" FontWeight="{DynamicResource DialogTitleFontWeight}" Foreground="#111D30" VerticalAlignment="Center"/>
                <Button x:Name="CloseButton" Width="26" Height="26" Margin="0" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding CloseCommand}"
                        Style="{DynamicResource ModalCloseButtonStyle}" AutomationProperties.Name="关闭角色选择"/>
                <TextBlock Grid.Row="1" Text="选择陪伴你专注的角色，选择后将立即应用。" FontSize="{DynamicResource SecondaryFontSize}"
                           FontWeight="{DynamicResource SecondaryFontWeight}" Foreground="#9098A8" VerticalAlignment="Center"/>
                <ListBox x:Name="CharacterRows" Grid.Row="3" ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="0" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Focusable" Value="False"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource CharacterCard}" Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" IsEnabled="{Binding CanSelect}" AutomationProperties.Name="{Binding Name}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
