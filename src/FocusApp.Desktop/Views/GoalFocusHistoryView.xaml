<UserControl x:Class="FocusApp.Desktop.Views.GoalFocusHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="HistoryScrollBarBaseStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="5" />
            <Setter Property="MinWidth" Value="5" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="5" Background="{DynamicResource TransparentBrush}">
                            <Track x:Name="PART_Track"
                                   Margin="0,3,1,3"
                                   IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBody"
                                                        Width="3"
                                                        HorizontalAlignment="Center"
                                                        Background="#D1D1D6"
                                                        CornerRadius="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#C7C7CC" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#AEAEB2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="HistoryVisibility"/>
        <views:GoalInverseVisibilityConverter x:Key="HistoryInverseVisibility"/>
        <Style x:Key="HistoryDayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HistorySessionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,12,0,12"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="SessionSurface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SessionSurface" Property="Background" Value="#FAFBFC"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SessionSurface" Property="Background" Value="#FAFBFC"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><DataTrigger Binding="{Binding HasTasks}" Value="False"><Setter Property="Cursor" Value="Arrow"/></DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <ScrollViewer x:Name="HistoryScrollViewer" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasRecords, Converter={StaticResource HistoryVisibility}}">
            <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource HistoryScrollBarBaseStyle}">
                <Style.Triggers><Trigger Property="Maximum" Value="0"><Setter Property="Opacity" Value="0"/><Setter Property="IsHitTestVisible" Value="False"/></Trigger></Style.Triggers>
            </Style></ScrollViewer.Resources>
            <ItemsControl ItemsSource="{Binding Days}" Margin="0,0,5,0">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <StackPanel>
                        <Button Height="38" Command="{Binding ToggleCommand}" Style="{StaticResource HistoryDayButtonStyle}" AutomationProperties.Name="{Binding DateDisplay}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="19"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DateDisplay}" VerticalAlignment="Center" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SummaryDisplay}" VerticalAlignment="Center" FontSize="11" Margin="8,0,8,0">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextWeak}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                                <Path Grid.Column="2" Width="8" Height="4" Data="M 0,0 L 4,4 L 8,0" Stretch="Fill" Stroke="{DynamicResource TextWeak}" StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Right" RenderTransformOrigin="0.5,0.5">
                                    <Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Path.Style>
                                </Path>
                            </Grid>
                        </Button>
                        <ItemsControl ItemsSource="{Binding Sessions}" Visibility="{Binding IsExpanded, Converter={StaticResource HistoryVisibility}}" Margin="10,2,0,7">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border x:Name="SessionListRow" BorderBrush="#F6F7F9" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <Button x:Name="SessionSummaryButton" Command="{Binding ToggleTasksCommand}" IsEnabled="{Binding HasTasks}" IsTabStop="{Binding HasTasks}" Style="{StaticResource HistorySessionButtonStyle}" AutomationProperties.Name="{Binding SessionDetailsDisplay}" AutomationProperties.HelpText="{Binding TaskToggleDisplay}">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Ellipse x:Name="SessionBullet" Width="8" Height="8" Fill="{DynamicResource AccentPrimary}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                    <TextBlock x:Name="SessionTaskSummary" Text="{Binding TaskSummaryDisplay}" FontSize="12" FontWeight="Medium" Foreground="#454C57" TextTrimming="CharacterEllipsis" Visibility="{Binding HasTasks, Converter={StaticResource HistoryVisibility}}"/>
                                                    <TextBlock x:Name="SessionDetails" Text="{Binding SessionDetailsDisplay}" FontSize="11" Foreground="{DynamicResource TextSecondary}">
                                                        <TextBlock.Style><Style TargetType="TextBlock">
                                                            <Setter Property="Margin" Value="0,4,0,0"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding HasTasks}" Value="False"><Setter Property="Margin" Value="0"/></DataTrigger></Style.Triggers>
                                                        </Style></TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border x:Name="SessionTaskPill" Grid.Column="2" Padding="10,5" Background="#F3F5F7" CornerRadius="12" VerticalAlignment="Center" Visibility="{Binding HasTasks, Converter={StaticResource HistoryVisibility}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding TaskCountDisplay}" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                        <Path Width="4" Height="7" Margin="7,0,0,0" Data="M 0,0 L 4,3.5 L 0,7" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                            <Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsTasksExpanded}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Path.Style>
                                                        </Path>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <ItemsControl x:Name="SessionTaskDetails" ItemsSource="{Binding Tasks}" Margin="26,0,0,12" Visibility="{Binding IsTasksExpanded, Converter={StaticResource HistoryVisibility}}">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Grid x:Name="HistoryParentTask" Margin="0,4,0,6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Path Width="10" Height="8" Data="M 0,4 L 3,7 L 9,0" Stroke="#FF984C" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0" IsHitTestVisible="False"/>
                                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextWeak}" TextWrapping="Wrap" LineHeight="17" Margin="0,4,0,4" Visibility="{Binding HasDescription, Converter={StaticResource HistoryVisibility}}"/>
                                                        <ItemsControl x:Name="HistorySubTasks" ItemsSource="{Binding SubTasks}" Margin="4,5,0,0" Visibility="{Binding HasSubTasks, Converter={StaticResource HistoryVisibility}}">
                                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                                <Grid Margin="0,2,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextWeak}" IsHitTestVisible="False">
                                                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="·"/><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Text" Value="✓"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource TextWeak}" TextWrapping="Wrap"/>
                                                                </Grid>
                                                            </DataTemplate></ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <TextBlock x:Name="HistoryTaskCompletionTime" Grid.Column="2" Text="{Binding CompletedTimeDisplay}" FontSize="10.5" Foreground="{DynamicResource TextWeak}" VerticalAlignment="Top" Margin="0,1,0,0" Visibility="{Binding HasCompletedTime, Converter={StaticResource HistoryVisibility}}"/>
                                                </Grid>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Height="1" Background="#F3F4F6" Visibility="{Binding IsExpanded, Converter={StaticResource HistoryInverseVisibility}}"/>
                    </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel x:Name="GoalFocusHistoryEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource HistoryVisibility}}">
            <Image x:Name="GoalFocusHistoryEmptyIllustration" Width="144" Height="144" Stretch="Uniform" Opacity="0.6"
                   Source="/FocusApp.Desktop;component/Assets/Images/Illustrations/mubiao_empty.png"
                   RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
            <TextBlock Text="还没有专注记录" Margin="0,16,0,0" FontSize="14" FontWeight="Medium"
                       Foreground="#5C6573" HorizontalAlignment="Center"/>
            <TextBlock Margin="0,10,0,0" FontSize="11.5" Foreground="#9BA4B3" LineHeight="18" TextAlignment="Center">
                <Run Text="开始专注计时后，记录会显示在这里，"/><LineBreak/>
                <Run Text="你可以查看每次专注的时间与任务。"/>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
