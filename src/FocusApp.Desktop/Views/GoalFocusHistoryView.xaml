<UserControl x:Class="FocusApp.Desktop.Views.GoalFocusHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             FontFamily="{DynamicResource FontFamilyPrimary}" Foreground="{DynamicResource StatisticsBodyBrush}"
             UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="Popup_PreviewKeyDown">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/FocusApp.Desktop;component/Resources/StatisticsTypography.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <Style TargetType="TextBlock" BasedOn="{StaticResource StatisticsBodyTextStyle}"/>
        <Style x:Key="HistoryScrollBarBaseStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="5" />
            <Setter Property="MinWidth" Value="5" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="5" Background="{DynamicResource TransparentBrush}">
                            <Track x:Name="PART_Track"
                                   Margin="0,3,1,3"
                                   IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBody"
                                                        Width="3"
                                                        HorizontalAlignment="Center"
                                                        Background="#D1D1D6"
                                                        CornerRadius="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#C7C7CC" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#AEAEB2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="HistoryVisibility"/>
        <views:GoalInverseVisibilityConverter x:Key="HistoryInverseVisibility"/>
        <Style x:Key="HistoryDayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#ECEEF2"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="2,0,5,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="DayRowSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HistoryFilterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E7EAF0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{DynamicResource StatisticsSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F8F9FA"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#FFC58E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><DataTrigger Binding="{Binding IsRangeMenuOpen}" Value="True"><Setter Property="BorderBrush" Value="#DCE0E6"/></DataTrigger><DataTrigger Binding="{Binding IsMonthPickerOpen}" Value="True"><Setter Property="BorderBrush" Value="#DCE0E6"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="HistoryMenuItemStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="10,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="MenuSurface" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MenuSurface" Property="Background" Value="#F5F6F8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="MenuSurface" Property="Background" Value="#F5F6F8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HistoryMonthButtonStyle" TargetType="Button" BasedOn="{StaticResource HistoryMenuItemStyle}">
            <Setter Property="Height" Value="30"/><Setter Property="Padding" Value="8,0"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#F1F3F6"/></DataTrigger></Style.Triggers>
        </Style>
      </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="GoalHistoryRoot">
        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock x:Name="HistoryTitle" Text="专注记录" Style="{StaticResource StatisticsHeadingTextStyle}" VerticalAlignment="Center"/>
        <Button x:Name="HistoryRangeButton" Width="130" Height="30" HorizontalAlignment="Right" Style="{StaticResource HistoryFilterButtonStyle}" Command="{Binding ToggleRangeMenuCommand}" AutomationProperties.Name="筛选专注记录时间范围">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="9"/></Grid.ColumnDefinitions>
                <Path Width="14" Height="15" Stretch="Uniform" Data="M 3,4 L 15,4 Q 17,4 17,6 L 17,15 Q 17,17 15,17 L 3,17 Q 1,17 1,15 L 1,6 Q 1,4 3,4 M 1,8 L 17,8 M 5,1 L 5,6 M 13,1 L 13,6" Stroke="#6D7788" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Left"/>
                <TextBlock Grid.Column="1" Text="{Binding RangeDisplay}" Style="{StaticResource StatisticsMetricLabelStyle}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Path Grid.Column="2" Width="7" Height="4" Data="M 0,0 L 3.5,3.5 L 7,0" Stroke="#4D586B" StrokeThickness="1.2" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsRangeMenuOpen}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></DataTrigger><DataTrigger Binding="{Binding IsMonthPickerOpen}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Path.Style></Path>
            </Grid>
        </Button>
        <Popup x:Name="HistoryRangePopup" Opened="RangePopup_Opened" IsOpen="{Binding IsRangeMenuOpen, Mode=TwoWay}" Placement="Bottom" PlacementTarget="{Binding ElementName=HistoryRangeButton}" HorizontalOffset="-4" VerticalOffset="2" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border x:Name="HistoryRangeMenuSurface" PreviewKeyDown="Popup_PreviewKeyDown" Width="130" Padding="5" Margin="4,4,8,8" Background="White" BorderBrush="#E7EAF0" BorderThickness="1" CornerRadius="10"><Border.Effect><DropShadowEffect Color="#293549" BlurRadius="12" ShadowDepth="3" Opacity="0.10"/></Border.Effect><StackPanel>
                <Button Command="{Binding SelectRangeCommand}" CommandParameter="All" AutomationProperties.Name="全部时间"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource HistoryMenuItemStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsAllTime}" Value="True"><Setter Property="Background" Value="#F5F6F8"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><TextBlock Text="全部时间" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource StatisticsBodyBrush}" VerticalAlignment="Center"/><Path Grid.Column="1" Width="10" Height="7" HorizontalAlignment="Right" Data="M 0,3 L 3,6 L 9,0" Stretch="Uniform" Stroke="#7D8796" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Visibility="{Binding IsAllTime, Converter={StaticResource HistoryVisibility}}"/></Grid>
                </Button>
                <Button Command="{Binding SelectRangeCommand}" CommandParameter="SevenDays" AutomationProperties.Name="近7天"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource HistoryMenuItemStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsSevenDays}" Value="True"><Setter Property="Background" Value="#F5F6F8"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><TextBlock Text="近7天" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource StatisticsBodyBrush}" VerticalAlignment="Center"/><Path Grid.Column="1" Width="10" Height="7" HorizontalAlignment="Right" Data="M 0,3 L 3,6 L 9,0" Stretch="Uniform" Stroke="#7D8796" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Visibility="{Binding IsSevenDays, Converter={StaticResource HistoryVisibility}}"/></Grid>
                </Button>
                <Button Command="{Binding SelectRangeCommand}" CommandParameter="ThirtyDays" AutomationProperties.Name="近30天"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource HistoryMenuItemStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsThirtyDays}" Value="True"><Setter Property="Background" Value="#F5F6F8"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><TextBlock Text="近30天" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource StatisticsBodyBrush}" VerticalAlignment="Center"/><Path Grid.Column="1" Width="10" Height="7" HorizontalAlignment="Right" Data="M 0,3 L 3,6 L 9,0" Stretch="Uniform" Stroke="#7D8796" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Visibility="{Binding IsThirtyDays, Converter={StaticResource HistoryVisibility}}"/></Grid>
                </Button>
                <Button x:Name="HistoryMonthOption" Command="{Binding OpenMonthPickerCommand}" AutomationProperties.Name="按月查看"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource HistoryMenuItemStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsMonth}" Value="True"><Setter Property="Background" Value="#F5F6F8"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><TextBlock Text="按月查看" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource StatisticsBodyBrush}" VerticalAlignment="Center"/><Path Grid.Column="1" Width="10" Height="7" HorizontalAlignment="Right" Data="M 0,3 L 3,6 L 9,0" Stretch="Uniform" Stroke="#7D8796" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Visibility="{Binding IsMonth, Converter={StaticResource HistoryVisibility}}"/></Grid>
                </Button>
            </StackPanel></Border>
        </Popup>
        <Popup x:Name="HistoryMonthPopup" Opened="MonthPopup_Opened" IsOpen="{Binding IsMonthPickerOpen, Mode=TwoWay}" Placement="Bottom" PlacementTarget="{Binding ElementName=HistoryRangeButton}" HorizontalOffset="-4" VerticalOffset="2" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border x:Name="HistoryMonthPickerSurface" PreviewKeyDown="Popup_PreviewKeyDown" Width="130" Padding="5" Margin="4,4,8,8" Background="White" BorderBrush="#E7EAF0" BorderThickness="1" CornerRadius="10"><Border.Effect><DropShadowEffect Color="#293549" BlurRadius="12" ShadowDepth="3" Opacity="0.10"/></Border.Effect>
                <StackPanel>
                    <ScrollViewer x:Name="HistoryMonthScrollViewer" MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource HistoryScrollBarBaseStyle}"/></ScrollViewer.Resources>
                        <ItemsControl x:Name="HistoryMonths" ItemsSource="{Binding Months}" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Style="{StaticResource HistoryMonthButtonStyle}" Command="{Binding DataContext.SelectMonthCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Display}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Display}" Style="{StaticResource StatisticsBodyTextStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Path Grid.Column="1" Width="9" Height="7" HorizontalAlignment="Right" Data="M 0,3 L 3,6 L 9,0" Stretch="Uniform" Stroke="#556176" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Visibility="{Binding IsSelected, Converter={StaticResource HistoryVisibility}}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="HistoryMonthsEmptyState" Text="暂无专注记录" Style="{StaticResource StatisticsAuxiliaryTextStyle}" HorizontalAlignment="Center" Margin="0,9" Visibility="{Binding HasMonths, Converter={StaticResource HistoryInverseVisibility}}"/>
                </StackPanel>
            </Border>
        </Popup>
        <ScrollViewer x:Name="HistoryScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasRecords, Converter={StaticResource HistoryVisibility}}">
            <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource HistoryScrollBarBaseStyle}"><Style.Triggers><Trigger Property="Maximum" Value="0"><Setter Property="Opacity" Value="0"/><Setter Property="IsHitTestVisible" Value="False"/></Trigger></Style.Triggers></Style></ScrollViewer.Resources>
            <ItemsControl ItemsSource="{Binding Days}" Margin="0,0,3,0"><ItemsControl.ItemTemplate><DataTemplate>
                <StackPanel>
                    <Button x:Name="HistoryDayHeader" Height="40" Command="{Binding ToggleCommand}" Style="{StaticResource HistoryDayButtonStyle}" AutomationProperties.Name="{Binding FullDateDisplay}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding HeaderDateDisplay}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource StatisticsBodyBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding SummaryDisplay}" FontSize="{DynamicResource SecondaryFontSize}" Foreground="{DynamicResource StatisticsWeakBrush}" VerticalAlignment="Center" Margin="8,0,5,0"/>
                            <Path Grid.Column="2" Width="6" Height="9" Data="M 0,0 L 5,4.5 L 0,9" Stretch="Uniform" Stroke="#556176" StrokeThickness="1.3" VerticalAlignment="Center" HorizontalAlignment="Right" RenderTransformOrigin="0.5,0.5"><Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="-90"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Path.Style></Path>
                        </Grid>
                    </Button>
                    <ItemsControl x:Name="HistoryDaySessions" ItemsSource="{Binding Sessions}" Visibility="{Binding IsExpanded, Converter={StaticResource HistoryVisibility}}" Margin="5,12,3,6"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border x:Name="SessionListRow" Padding="0,0,0,12">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border x:Name="SessionConnector" Grid.RowSpan="2" Width="1" Background="#FFDBC0" Margin="0,12,0,-24" IsHitTestVisible="False" Visibility="{Binding IsLastInDay, Converter={StaticResource HistoryInverseVisibility}}"/>
                                <Ellipse x:Name="SessionBullet" Width="9" Height="9" Fill="#FF861C" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SessionTimeRange" Text="{Binding TimeRangeDisplay}" Style="{StaticResource StatisticsTimeTextStyle}" VerticalAlignment="Center" ToolTip="{Binding SessionDetailsDisplay}"/>
                                    <TextBlock x:Name="SessionDuration" Grid.Column="1" Text="{Binding DurationDisplay}" FontSize="12" Foreground="{DynamicResource StatisticsWeakBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                                <ItemsControl x:Name="SessionTaskDetails" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Tasks}" Margin="2,3,0,0" Visibility="{Binding HasTasks, Converter={StaticResource HistoryVisibility}}">
<ItemsControl.ItemTemplate><DataTemplate>
                                                    <Border BorderThickness="0" Padding="0,1,0,0">
                                                        <Grid x:Name="HistoryParentTask">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                            <Border x:Name="HistoryParentCompletionMark" Width="16" Height="16" CornerRadius="3" Background="{DynamicResource AccentPrimary}" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                <Path Width="9" Height="6" Data="M 0,3 L 3,6 L 9,0" Stretch="Fill" Stroke="White" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock x:Name="HistoryParentTaskName" Grid.Column="1" Text="{Binding Name}" Style="{StaticResource StatisticsBodyTextStyle}" Foreground="{DynamicResource StatisticsWeakBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Description}"/>
                                                            <ItemsControl x:Name="HistorySubTasks" Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding SubTasks}" Margin="0,2,0,0" Visibility="{Binding HasSubTasks, Converter={StaticResource HistoryVisibility}}">
                                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                                    <Grid x:Name="HistorySubTask" MinHeight="26">
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions><RowDefinition Height="13"/><RowDefinition/></Grid.RowDefinitions>
                                                                        <Border x:Name="TaskHierarchySpineTop" Width="1" Background="#E5E8EC" HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False"/>
                                                                        <Border x:Name="TaskHierarchySpineBottom" Grid.Row="1" Width="1" Background="#E5E8EC" HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False" Visibility="{Binding IsLast, Converter={StaticResource HistoryInverseVisibility}}"/>
                                                                        <Border x:Name="TaskHierarchyBranch" Grid.RowSpan="2" Height="1" Background="#E5E8EC" VerticalAlignment="Top" Margin="8,13,4,0" IsHitTestVisible="False"/>
                                                                        <Grid x:Name="HistorySubTaskCompletionMark" Grid.Column="1" Grid.RowSpan="2" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                            <Ellipse x:Name="HistorySubTaskCircle" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="1.2" Fill="Transparent"/>
                                                                            <Path x:Name="HistorySubTaskTick" Width="8" Height="5" Data="M 0,2.5 L 2.5,5 L 8,0" Stretch="Fill" Stroke="White" StrokeThickness="1.3" Visibility="Collapsed" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                        <TextBlock x:Name="HistorySubTaskName" Grid.Column="2" Grid.RowSpan="2" Text="{Binding Title}" Style="{StaticResource StatisticsBodyTextStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                    <DataTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter TargetName="HistorySubTaskCircle" Property="Fill" Value="{DynamicResource AccentPrimary}"/>
                                                                            <Setter TargetName="HistorySubTaskTick" Property="Visibility" Value="Visible"/>
                                                                            <Setter TargetName="HistorySubTaskName" Property="Foreground" Value="{DynamicResource StatisticsWeakBrush}"/>
                                                                        </DataTrigger>
                                                                    </DataTemplate.Triggers>
                                                                </DataTemplate></ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </ScrollViewer>
        <StackPanel x:Name="GoalFocusHistoryEmptyState" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowEmptyState, Converter={StaticResource HistoryVisibility}}">
            <Image x:Name="GoalFocusHistoryEmptyIllustration" Width="120" Height="120" Stretch="Uniform" Opacity="0.6" Source="/FocusApp.Desktop;component/Assets/Images/Illustrations/mubiao_empty.png" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
            <TextBlock Text="还没有专注记录" Margin="0,12,0,0" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource StatisticsBodyBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding EmptyHint}" Margin="0,8,0,0" FontSize="{DynamicResource SecondaryFontSize}" Foreground="{DynamicResource StatisticsWeakBrush}" LineHeight="18" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
