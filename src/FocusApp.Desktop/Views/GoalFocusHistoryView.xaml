<UserControl x:Class="FocusApp.Desktop.Views.GoalFocusHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="HistoryScrollBarBaseStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="5" />
            <Setter Property="MinWidth" Value="5" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="5" Background="{DynamicResource TransparentBrush}">
                            <Track x:Name="PART_Track"
                                   Margin="0,3,1,3"
                                   IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBody"
                                                        Width="3"
                                                        HorizontalAlignment="Center"
                                                        Background="#D1D1D6"
                                                        CornerRadius="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#C7C7CC" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#AEAEB2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="HistoryVisibility"/>
        <views:GoalInverseVisibilityConverter x:Key="HistoryInverseVisibility"/>
        <Style x:Key="HistoryDayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HistoryTaskPillStyle" TargetType="Button">
            <Setter Property="Padding" Value="9,3"/><Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="Background" Value="#F3F5F7"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="{TemplateBinding FontSize}"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="#E9EDF1"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <ScrollViewer x:Name="HistoryScrollViewer" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasRecords, Converter={StaticResource HistoryVisibility}}">
            <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource HistoryScrollBarBaseStyle}">
                <Style.Triggers><Trigger Property="Maximum" Value="0"><Setter Property="Opacity" Value="0"/><Setter Property="IsHitTestVisible" Value="False"/></Trigger></Style.Triggers>
            </Style></ScrollViewer.Resources>
            <ItemsControl ItemsSource="{Binding Days}" Margin="0,0,5,0">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <StackPanel>
                        <Button Height="38" Command="{Binding ToggleCommand}" Style="{StaticResource HistoryDayButtonStyle}" AutomationProperties.Name="{Binding DateDisplay}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="19"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DateDisplay}" VerticalAlignment="Center" FontSize="14">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="FontWeight" Value="Medium"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding SummaryDisplay}" VerticalAlignment="Center" FontSize="11" Margin="8,0,8,0">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextWeak}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                                <Path Grid.Column="2" Width="8" Height="4" Data="M 0,0 L 4,4 L 8,0" Stretch="Fill" Stroke="{DynamicResource TextWeak}" StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Right" RenderTransformOrigin="0.5,0.5">
                                    <Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Path.Style>
                                </Path>
                            </Grid>
                        </Button>
                        <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource HistoryVisibility}}" Margin="0,2,0,7">
                            <views:CalendarFocusTimeline Height="38" TrackHeight="6" TrackTop="22" GoalHistoryStyle="True" Timeline="{Binding Timeline}" Margin="2,0,2,5" AutomationProperties.Name="全天专注时间轴"/>
                            <ItemsControl ItemsSource="{Binding Sessions}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Grid x:Name="SessionTimelineRow">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding StartTimeDisplay}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                    <Grid Grid.Column="1" IsHitTestVisible="False">
                                        <Border x:Name="SessionConnector" Width="1" HorizontalAlignment="Center" Background="#ECEFF3"/>
                                        <Ellipse x:Name="SessionNode" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,7,0,0">
                                            <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#CCD0D7"/><Style.Triggers><DataTrigger Binding="{Binding IsTasksExpanded}" Value="True"><Setter Property="Fill" Value="{DynamicResource AccentPrimary}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                    <StackPanel Grid.Column="2" Margin="0,0,0,18">
                                        <Grid MinHeight="44"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="{Binding FocusDurationDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding TimeRangeDisplay}" FontSize="11" Foreground="{DynamicResource TextWeak}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        <Button Grid.Column="1" Command="{Binding ToggleTasksCommand}" Margin="8,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource HistoryTaskPillStyle}" Visibility="{Binding HasTasks, Converter={StaticResource HistoryVisibility}}" AutomationProperties.Name="{Binding TaskToggleDisplay}" AutomationProperties.HelpText="展开或收起本次专注的只读任务结果">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="11" Height="13" Data="M 1,1 L 7,1 L 10,4 L 10,12 L 1,12 Z M 7,1 L 7,4 L 10,4 M 3,6 L 8,6 M 3,9 L 7,9" Stretch="Fill" Stroke="{DynamicResource TextWeak}" StrokeThickness="1" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TaskCountDisplay}" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                <Path Width="7" Height="4" Margin="6,0,0,0" Data="M 0,4 L 3.5,0 L 7,4" Stroke="{DynamicResource TextWeak}" StrokeThickness="1" VerticalAlignment="Center" Visibility="{Binding IsTasksExpanded, Converter={StaticResource HistoryVisibility}}"/>
                                            </StackPanel>
                                        </Button>
                                        </Grid>
                                    <ItemsControl ItemsSource="{Binding Tasks}" Margin="0,7,2,10" Visibility="{Binding IsTasksExpanded, Converter={StaticResource HistoryVisibility}}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Grid Margin="0,3,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <Grid Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0" IsHitTestVisible="False">
                                                    <Ellipse Fill="#FF984C"/>
                                                    <Path Data="M 3,6 L 5,8 L 9,4" Stroke="White" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Grid>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextWeak}" TextWrapping="Wrap" LineHeight="17" Margin="0,4,0,4" Visibility="{Binding HasDescription, Converter={StaticResource HistoryVisibility}}"/>
                                                    <ItemsControl ItemsSource="{Binding SubTasks}" Margin="6,4,0,0" Visibility="{Binding HasSubTasks, Converter={StaticResource HistoryVisibility}}">
                                                        <ItemsControl.ItemTemplate><DataTemplate>
                                                            <Grid Margin="0,2,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="19"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                                <Grid Width="11" Height="11" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0" IsHitTestVisible="False">
                                                                    <Ellipse StrokeThickness="1" Fill="Transparent"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Stroke" Value="#D7DCE3"/><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Stroke" Value="#FFAB70"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                                                                    <Path Data="M 2.5,5.5 L 4.5,7.5 L 8,4" Stroke="#FF984C" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="{Binding IsCompleted, Converter={StaticResource HistoryVisibility}}"/>
                                                                </Grid>
                                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource TextWeak}" TextWrapping="Wrap"/>
                                                            </Grid>
                                                        </DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                        <Border Height="1" Background="#F3F4F6"/>
                    </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock Text="暂无专注记录" FontSize="12" Foreground="{DynamicResource TextWeak}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasRecords, Converter={StaticResource HistoryInverseVisibility}}"/>
    </Grid>
</UserControl>
