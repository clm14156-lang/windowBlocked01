<UserControl x:Class="FocusApp.Desktop.Views.GoalFocusHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="HistoryScrollBarBaseStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="5" />
            <Setter Property="MinWidth" Value="5" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="5" Background="{DynamicResource TransparentBrush}">
                            <Track x:Name="PART_Track"
                                   Margin="0,3,1,3"
                                   IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBody"
                                                        Width="3"
                                                        HorizontalAlignment="Center"
                                                        Background="#D1D1D6"
                                                        CornerRadius="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#C7C7CC" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#AEAEB2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="HistoryVisibility"/>
        <views:GoalInverseVisibilityConverter x:Key="HistoryInverseVisibility"/>
        <Style x:Key="HistoryDayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HistoryTaskPillButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,2"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#E7EBEF"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="PillSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PillSurface" Property="Background" Value="#F8F9FA"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PillSurface" Property="Background" Value="#F8F9FA"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <ScrollViewer x:Name="HistoryScrollViewer" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasRecords, Converter={StaticResource HistoryVisibility}}">
            <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource HistoryScrollBarBaseStyle}">
                <Style.Triggers><Trigger Property="Maximum" Value="0"><Setter Property="Opacity" Value="0"/><Setter Property="IsHitTestVisible" Value="False"/></Trigger></Style.Triggers>
            </Style></ScrollViewer.Resources>
            <ItemsControl ItemsSource="{Binding Days}" Margin="0,0,5,0">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <StackPanel>
                        <Button Height="38" Command="{Binding ToggleCommand}" Style="{StaticResource HistoryDayButtonStyle}" AutomationProperties.Name="{Binding DateDisplay}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="19"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DateDisplay}" VerticalAlignment="Center" FontSize="{DynamicResource BodyMediumFontSize}" FontWeight="{DynamicResource BodyMediumFontWeight}" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SummaryDisplay}" VerticalAlignment="Center" FontSize="{DynamicResource SecondaryFontSize}" FontWeight="{DynamicResource SecondaryFontWeight}" Margin="8,0,8,0">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextWeak}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                                <Path Grid.Column="2" Width="8" Height="4" Data="M 0,0 L 4,4 L 8,0" Stretch="Fill" Stroke="{DynamicResource TextWeak}" StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Right" RenderTransformOrigin="0.5,0.5">
                                    <Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Path.Style>
                                </Path>
                            </Grid>
                        </Button>
                        <ItemsControl ItemsSource="{Binding Sessions}" Visibility="{Binding IsExpanded, Converter={StaticResource HistoryVisibility}}" Margin="10,2,0,4">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <StackPanel>
                                    <Border x:Name="SessionListRow">
                                        <Grid Margin="4,2,6,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Border x:Name="ContinuousIncomingLine" Width="1.5" Background="{DynamicResource AccentPrimary}" Margin="0,-2,0,20"
                                                    IsHitTestVisible="False" Visibility="{Binding ConnectsFromPrevious, Converter={StaticResource HistoryVisibility}}"/>
                                            <Border x:Name="ContinuousOutgoingLine" Grid.RowSpan="2" Width="1.5" Background="{DynamicResource AccentPrimary}" Margin="0,20,0,-2"
                                                    IsHitTestVisible="False" Visibility="{Binding ConnectsToNext, Converter={StaticResource HistoryVisibility}}"/>
                                            <Ellipse x:Name="SessionBullet" Width="12" Height="12" Fill="{DynamicResource AccentPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border x:Name="SessionConnector" Grid.Row="1" Width="1.5" Background="{DynamicResource AccentPrimary}" Margin="0,1,0,1" Visibility="{Binding IsTasksExpanded, Converter={StaticResource HistoryVisibility}}"/>
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <TextBlock x:Name="SessionTimeRange" Text="{Binding TimeRangeDisplay}" MinWidth="110" FontFamily="{DynamicResource FontFamilyEnglish}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" ToolTip="{Binding SessionDetailsDisplay}"/>
                                                <Button x:Name="SessionTaskPill" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource HistoryTaskPillButtonStyle}"
                                                        Command="{Binding ToggleTasksCommand}" Visibility="{Binding HasTasks, Converter={StaticResource HistoryVisibility}}"
                                                        AutomationProperties.Name="{Binding TaskToggleDisplay}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding TaskCountDisplay}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                        <Path Width="7" Height="4" Margin="8,0,0,0" Data="M 0,0 L 3.5,3.5 L 7,0" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                            <Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsTasksExpanded}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Path.Style>
                                                        </Path>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <ItemsControl x:Name="SessionTaskDetails" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Tasks}" Margin="4,2,0,0" Visibility="{Binding IsTasksExpanded, Converter={StaticResource HistoryVisibility}}">
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="0,1,0,2">
                                                        <Grid x:Name="HistoryParentTask">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                            <Border x:Name="HistoryParentCompletionMark" Width="16" Height="16" CornerRadius="3" Background="{DynamicResource AccentPrimary}" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                <Path Width="9" Height="6" Data="M 0,3 L 3,6 L 9,0" Stretch="Fill" Stroke="White" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock x:Name="HistoryParentTaskName" Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="#A0A2A7" TextDecorations="Strikethrough" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Description}"/>
                                                            <ItemsControl x:Name="HistorySubTasks" Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding SubTasks}" Margin="0,2,0,0" Visibility="{Binding HasSubTasks, Converter={StaticResource HistoryVisibility}}">
                                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                                    <Grid x:Name="HistorySubTask" MinHeight="26">
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions><RowDefinition Height="13"/><RowDefinition/></Grid.RowDefinitions>
                                                                        <Border x:Name="TaskHierarchySpineTop" Width="1" Background="#E5E8EC" HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False"/>
                                                                        <Border x:Name="TaskHierarchySpineBottom" Grid.Row="1" Width="1" Background="#E5E8EC" HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False" Visibility="{Binding IsLast, Converter={StaticResource HistoryInverseVisibility}}"/>
                                                                        <Border x:Name="TaskHierarchyBranch" Grid.RowSpan="2" Height="1" Background="#E5E8EC" VerticalAlignment="Top" Margin="8,13,4,0" IsHitTestVisible="False"/>
                                                                        <Grid x:Name="HistorySubTaskCompletionMark" Grid.Column="1" Grid.RowSpan="2" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                            <Ellipse x:Name="HistorySubTaskCircle" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="1.2" Fill="Transparent"/>
                                                                            <Path x:Name="HistorySubTaskTick" Width="8" Height="5" Data="M 0,2.5 L 2.5,5 L 8,0" Stretch="Fill" Stroke="White" StrokeThickness="1.3" Visibility="Collapsed" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                        <TextBlock x:Name="HistorySubTaskName" Grid.Column="2" Grid.RowSpan="2" Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                    <DataTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter TargetName="HistorySubTaskCircle" Property="Fill" Value="{DynamicResource AccentPrimary}"/>
                                                                            <Setter TargetName="HistorySubTaskTick" Property="Visibility" Value="Visible"/>
                                                                            <Setter TargetName="HistorySubTaskName" Property="Foreground" Value="#A0A2A7"/>
                                                                            <Setter TargetName="HistorySubTaskName" Property="TextDecorations" Value="Strikethrough"/>
                                                                        </DataTrigger>
                                                                    </DataTemplate.Triggers>
                                                                </DataTemplate></ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                    <Grid x:Name="ContinuousRecordSpacing" Height="8" Margin="4,0,6,0"
                                          Visibility="{Binding ConnectsToNext, Converter={StaticResource HistoryVisibility}}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border x:Name="ContinuousSpacingLine" Width="1.5" Background="{DynamicResource AccentPrimary}" IsHitTestVisible="False"/>
                                    </Grid>
                                    <Grid x:Name="SessionGap" Height="24" Margin="4,0,6,0" Visibility="{Binding HasGap, Converter={StaticResource HistoryVisibility}}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border Width="1.5" Background="#E3E7EC" Margin="0,2,0,2"/>
                                        <Ellipse Width="9" Height="9" Fill="#C7CFD8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding GapDisplay}" FontSize="11" Foreground="#A3AAB5" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Height="1" Background="#F3F4F6" Visibility="{Binding IsExpanded, Converter={StaticResource HistoryInverseVisibility}}"/>
                    </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel x:Name="GoalFocusHistoryEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource HistoryVisibility}}">
            <Image x:Name="GoalFocusHistoryEmptyIllustration" Width="144" Height="144" Stretch="Uniform" Opacity="0.6"
                   Source="/FocusApp.Desktop;component/Assets/Images/Illustrations/mubiao_empty.png"
                   RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
            <TextBlock Text="还没有专注记录" Margin="0,16,0,0" FontSize="14" FontWeight="Medium"
                       Foreground="#5C6573" HorizontalAlignment="Center"/>
            <TextBlock Margin="0,10,0,0" FontSize="11.5" Foreground="#9BA4B3" LineHeight="18" TextAlignment="Center">
                <Run Text="开始专注计时后，记录会显示在这里，"/><LineBreak/>
                <Run Text="你可以查看每次专注的时间与任务。"/>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
