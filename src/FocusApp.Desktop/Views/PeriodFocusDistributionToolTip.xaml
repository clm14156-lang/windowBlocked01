<UserControl x:Class="FocusApp.Desktop.Views.PeriodFocusDistributionToolTip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             x:Name="Root" MaxWidth="240" IsHitTestVisible="False"
             FontFamily="{DynamicResource FontFamilyPrimary}"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/FocusApp.Desktop;component/Resources/PoptipStyles.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="PeriodDistributionTipStyle" TargetType="ToolTip">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ToolTip"><ContentPresenter /></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
          </ResourceDictionary>
    </UserControl.Resources>
    <views:PoptipChrome Style="{StaticResource PoptipSurfaceStyle}"
                        PointerLeft="{Binding PointerLeft, ElementName=Root}"
                        PointerOnTop="{Binding PointerOnTop, ElementName=Root}">
        <StackPanel>
            <TextBlock x:Name="DistributionTipPrimaryLine" Style="{StaticResource PoptipPrimaryTextStyle}">
                <Run Text="{Binding TooltipDurationDisplay, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding PercentageDisplay, Mode=OneWay}" Foreground="{StaticResource PoptipAccentBrush}"/>
            </TextBlock>
            <TextBlock x:Name="DistributionTipSecondaryLine" Margin="0,4,0,0" Style="{StaticResource PoptipSecondaryTextStyle}">
                <Run Text="{Binding SessionCount, Mode=OneWay}"/><Run Text="次专注  ·  "/><Run Text="{Binding FocusDayCount, Mode=OneWay}"/><Run Text="个专注日"/>
            </TextBlock>
        </StackPanel>
    </views:PoptipChrome>
</UserControl>
