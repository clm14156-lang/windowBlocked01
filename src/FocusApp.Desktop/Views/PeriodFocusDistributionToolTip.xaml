<UserControl x:Class="FocusApp.Desktop.Views.PeriodFocusDistributionToolTip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="180" Height="70" IsHitTestVisible="False"
             FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="PeriodDistributionTipStyle" TargetType="ToolTip">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ToolTip"><ContentPresenter /></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.Effect><DropShadowEffect Color="#526070" Opacity="0.08" BlurRadius="10" ShadowDepth="2" /></Grid.Effect>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="6"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#ECEEF2" BorderThickness="1" CornerRadius="10" Padding="14,9,14,9">
            <Grid VerticalAlignment="Center">
                <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="18"/></Grid.RowDefinitions>
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="DistributionTipPrimaryLine" FontSize="13" FontWeight="SemiBold" Foreground="#17202C">
                        <Run Text="{Binding TooltipDurationDisplay, Mode=OneWay}"/><Run Text=" · " Foreground="#7C8798" FontWeight="Normal"/><Run Text="{Binding PercentageDisplay, Mode=OneWay}" Foreground="{DynamicResource AccentPrimary}"/>
                    </TextBlock>
                </Viewbox>
                <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="DistributionTipSecondaryLine" FontSize="11" FontWeight="Normal" Foreground="#7C8798">
                        <Run Text="{Binding SessionCount, Mode=OneWay}"/><Run Text="次专注 · "/><Run Text="{Binding FocusDayCount, Mode=OneWay}"/><Run Text="个专注日"/>
                    </TextBlock>
                </Viewbox>
            </Grid>
        </Border>
        <Canvas Grid.Row="1" Height="6" IsHitTestVisible="False">
            <Path Canvas.Left="{Binding PointerLeft, RelativeSource={RelativeSource AncestorType=UserControl}}" Canvas.Top="-1"
                  Data="M 0,0 L 6,6 L 12,0 Z" Fill="White"/>
            <Path Canvas.Left="{Binding PointerLeft, RelativeSource={RelativeSource AncestorType=UserControl}}" Canvas.Top="-1"
                  Data="M 0,0 L 6,6 L 12,0" Stroke="#ECEEF2" StrokeThickness="1" StrokeLineJoin="Round"/>
        </Canvas>
    </Grid>
</UserControl>
