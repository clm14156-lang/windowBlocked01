<Window x:Class="FocusApp.Desktop.Views.AutomaticBlockingToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400"
        Height="180"
        MinWidth="400"
        MinHeight="180"
        MaxWidth="400"
        MaxHeight="180"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
        ShowActivated="False"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Window.Resources>
        <Style x:Key="ToastCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseHitArea"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <Path Width="16"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 1,1 L 15,15 M 15,1 L 1,15"
                                  Stroke="#D4D9DF"
                                  StrokeEndLineCap="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.4" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseHitArea" Property="Background" Value="#505761" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToastLinkButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="2"
            BorderBrush="#626973"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F53D434B" Offset="0" />
                <GradientStop Color="#F5343A42" Offset="0.44" />
                <GradientStop Color="#F530353C" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              Direction="270"
                              Opacity="0.14"
                              ShadowDepth="2" />
        </Border.Effect>

        <Grid Margin="22,14,22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="15" />
                <RowDefinition Height="40" />
                <RowDefinition Height="4" />
                <RowDefinition Height="18" />
                <RowDefinition Height="14" />
                <RowDefinition Height="25" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image x:Name="ApplicationLogo"
                       Width="28"
                       Height="28"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Source="/FocusApp.Desktop;component/Assets/Icons/Common/shiguang_logo.png"
                       Stretch="Uniform" />

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="#F6F7F9"
                           Text="{DynamicResource AutomaticBlockingToastBrandName}" />

                <Button Grid.Column="3"
                        Margin="0,-2,-6,0"
                        AutomationProperties.Name="{DynamicResource AutomaticBlockingToastClose}"
                        Click="CloseButton_Click"
                        Style="{StaticResource ToastCloseButtonStyle}" />
            </Grid>

            <TextBlock Grid.Row="2"
                       VerticalAlignment="Center"
                       FontSize="19"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF"
                       TextWrapping="NoWrap">
                <Run FontSize="32"
                     FontWeight="Bold"
                     Foreground="#FF9448"
                     Text="{DynamicResource AutomaticBlockingToastMinutes}" /><Run Text="{DynamicResource AutomaticBlockingToastTitleSuffix}" />
            </TextBlock>

            <TextBlock Grid.Row="4"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="Normal"
                       Foreground="#B8BEC7"
                       Text="{DynamicResource AutomaticBlockingToastDescription}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="19"
                           Foreground="#E3E7EC"
                           Text="&#xE823;" />

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="Normal"
                           Foreground="#F0F2F5"
                           Text="{DynamicResource AutomaticBlockingToastRule}" />

                <Button Grid.Column="3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource ToastLinkButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="#F3F5F7"
                                   Text="{DynamicResource AutomaticBlockingToastView}" />
                        <TextBlock Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="17"
                                   FontWeight="Normal"
                                   Foreground="#F3F5F7"
                                   Text="{DynamicResource AutomaticBlockingToastViewArrow}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
