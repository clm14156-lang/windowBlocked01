<Window x:Class="FocusApp.Desktop.Views.AutomaticBlockingToastWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="400" Height="160" MinWidth="400" MinHeight="160" MaxWidth="400" MaxHeight="160" AllowsTransparency="True" Background="Transparent" Focusable="False" ShowActivated="False" ShowInTaskbar="False" Topmost="True" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="Manual" WindowStyle="None">
  <Border Margin="3" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="12">
    <Border.Effect><DropShadowEffect BlurRadius="14" Direction="270" Opacity="0.12" ShadowDepth="2" /></Border.Effect>
    <Grid Margin="24,18,20,16">
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
        <Border Width="76" Height="76" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource AccentTint}" CornerRadius="38">
          <Grid Width="48" Height="48"><Ellipse Stroke="{DynamicResource AccentPrimary}" StrokeThickness="3" /><Line X1="24" Y1="24" X2="24" Y2="12" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /><Line X1="24" Y1="24" X2="35" Y2="24" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Grid>
        </Border>
        <StackPanel Grid.Column="1" Margin="0,0,4,0">
          <TextBlock FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"><Run Foreground="{DynamicResource AccentPrimary}" Text="{DynamicResource AutomaticBlockingToastMinutes}" /><Run Text="{DynamicResource AutomaticBlockingToastTitleSuffix}" /></TextBlock>
          <TextBlock Margin="0,12,0,0" FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI" FontSize="13" LineHeight="20" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource AutomaticBlockingToastDescription}" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32" Background="{DynamicResource TransparentBrush}" BorderThickness="0" Foreground="{DynamicResource TextSecondary}" FontSize="24" FocusVisualStyle="{x:Null}" AutomationProperties.Name="{DynamicResource AutomaticBlockingToastClose}" Click="CloseButton_Click" Content="×" />
      </Grid>
      <Grid Grid.Row="1" Margin="96,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI" FontSize="12" Foreground="{DynamicResource TextTertiary}" Text="{DynamicResource AutomaticBlockingToastRule}" /><Button Grid.Column="1" MinHeight="28" Padding="0" Background="{DynamicResource TransparentBrush}" BorderThickness="0" Foreground="{DynamicResource AccentPrimary}" FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI" FontSize="13" FontWeight="Medium" FocusVisualStyle="{x:Null}" Content="{DynamicResource AutomaticBlockingToastView}" /></Grid>
    </Grid>
  </Border>
</Window>
