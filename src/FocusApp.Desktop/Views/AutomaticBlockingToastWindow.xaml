<Window x:Class="FocusApp.Desktop.Views.AutomaticBlockingToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400"
        Height="210"
        MinWidth="400"
        MinHeight="210"
        MaxWidth="400"
        MaxHeight="210"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
        ShowActivated="False"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Border Margin="3"
            Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource BorderPrimary}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              Direction="270"
                              Opacity="0.07"
                              ShadowDepth="2" />
        </Border.Effect>

        <Grid Margin="26,14,22,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="10" />
                <RowDefinition Height="26" />
                <RowDefinition Height="24" />
                <RowDefinition Height="*" />
                <RowDefinition Height="1" />
                <RowDefinition Height="10" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="26" />
                </Grid.ColumnDefinitions>

                <Image x:Name="ApplicationLogo"
                       Width="32"
                       Height="32"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Source="/FocusApp.Desktop;component/Assets/Icons/Common/shiguang_logo.png"
                       Stretch="Uniform" />

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="{DynamicResource AutomaticBlockingToastBrandName}" />

                <Button Grid.Column="3"
                        Width="26"
                        Height="26"
                        Margin="0,-4,-6,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{DynamicResource AutomaticBlockingToastClose}"
                        Click="CloseButton_Click"
                        Style="{StaticResource WindowChromeButtonStyle}">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="&#xE8BB;" />
                </Button>
            </Grid>

            <TextBlock Grid.Row="2"
                       VerticalAlignment="Center"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}">
                <Run Foreground="{DynamicResource AccentPrimary}"
                     Text="{DynamicResource AutomaticBlockingToastMinutes}" />
                <Run Text="{DynamicResource AutomaticBlockingToastTitleSuffix}" />
            </TextBlock>

            <TextBlock Grid.Row="3"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="Normal"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="{DynamicResource AutomaticBlockingToastDescription}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />

            <Border Grid.Row="5"
                    Height="1"
                    Background="{DynamicResource BorderPrimary}" />

            <Grid Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="15"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="&#xE823;" />

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="Normal"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="{DynamicResource AutomaticBlockingToastRule}" />

                <Button Grid.Column="3"
                        MinHeight="28"
                        Padding="8,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{DynamicResource TransparentBrush}"
                        BorderThickness="0"
                        FocusVisualStyle="{x:Null}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="{DynamicResource AutomaticBlockingToastView}" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource TextTertiary}"
                                   Text="{DynamicResource AutomaticBlockingToastViewArrow}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
