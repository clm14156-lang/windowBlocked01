<UserControl x:Class="FocusApp.Desktop.Views.FocusFlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             xmlns:local="clr-namespace:FocusApp.Desktop.Views"
             Background="{DynamicResource SurfacePrimary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:PositiveIntToVisibilityConverter x:Key="PositiveIntToVisibilityConverter" />
        <TranslateTransform x:Key="FocusFlowCenterShift" X="11" />

        <Style x:Key="FocusFlowPlainButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TargetTaskEditorStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="FocusTaskThinScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="5" />
            <Setter Property="MinWidth" Value="5" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="5" Background="{DynamicResource TransparentBrush}">
                            <Track x:Name="PART_Track"
                                   Margin="0,3,0,3"
                                   IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBody"
                                                        Width="3"
                                                        HorizontalAlignment="Center"
                                                        Background="#D1D1D6"
                                                        CornerRadius="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#C7C7CC" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#AEAEB2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusFlowOutlineButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusFlowAccentButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FocusFlowOutlineButton}">
            <Setter Property="Background" Value="{DynamicResource FocusButtonBackground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource FocusButtonHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource FocusButtonPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfacePrimary}">
        <Grid Height="48"
              VerticalAlignment="Top"
              Background="{DynamicResource SurfacePrimary}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Margin="0,4,8,4" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button AutomationProperties.Name="{DynamicResource HomeMinimizeButton}"
                        Click="MinimizeButton_Click"
                        Style="{StaticResource WindowChromeButtonStyle}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE921;" />
                </Button>
                <Button AutomationProperties.Name="{DynamicResource HomeCloseButton}"
                        Click="CloseButton_Click"
                        Style="{StaticResource WindowChromeButtonStyle}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE8BB;" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid MouseDown="TargetMode_MouseDown">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsFocusing}" Value="True" />
                                <Condition Binding="{Binding HasTarget}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid Margin="0,50,0,4">
                <StackPanel Width="410" HorizontalAlignment="Center">
                    <Border Height="210" Padding="22,18,22,16" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="22">
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center" FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="54" FontWeight="SemiBold" Text="{Binding RemainingTimeDisplay}" />
                            <TextBlock Margin="0,0,0,0" HorizontalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource FocusRemainingTime}" />
                            <ProgressBar Height="6" Margin="28,18,28,0" Maximum="1" Value="{Binding RemainingProgress, Mode=OneWay}" Background="{DynamicResource FocusRingTrack}" Foreground="{DynamicResource AccentPrimary}" BorderThickness="0" />
                            <Border Width="92" Height="36" Margin="0,18,0,0" HorizontalAlignment="Center" Background="{DynamicResource AccentTint}" CornerRadius="18">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{DynamicResource AccentPrimary}" />
                                    <TextBlock FontSize="14" Foreground="{DynamicResource AccentPrimary}" Text="专注中" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Height="350" Margin="0,20,0,0" Padding="20,20,20,12" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="22">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource AccentPrimary}" Text="&#xE735;" />
                                <StackPanel>
                                    <TextBlock FontSize="20" Text="{Binding TargetName}" />
                                    <TextBlock Margin="0,3,0,0" FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="{Binding PendingTaskSummary}" />
                                </StackPanel>
                            </StackPanel>
                            <Border Height="1" Margin="0,14,0,0" Background="{DynamicResource BorderPrimary}" />

                            <ScrollViewer x:Name="TaskListScrollViewer"
                                          Height="212"
                                          Margin="0,2,0,0"
                                          AllowDrop="True"
                                          DragOver="TaskList_DragOver"
                                          Drop="TaskList_Drop"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource FocusTaskThinScrollBarStyle}" />
                            </ScrollViewer.Resources>
                            <ItemsControl x:Name="PendingTaskList"
                                          ItemsSource="{Binding PendingTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid x:Name="TaskDragRow"
                                              Height="53"
                                              Background="Transparent"
                                              PreviewMouseLeftButtonDown="PendingTaskList_PreviewMouseLeftButtonDown"
                                              PreviewMouseLeftButtonUp="PendingTaskList_PreviewMouseLeftButtonUp"
                                              PreviewMouseMove="PendingTaskList_PreviewMouseMove">
                                            <Grid.Style>
                                                <Style TargetType="{x:Type Grid}">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <TranslateTransform />
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                            <Setter Property="Opacity" Value="0.76" />
                                                            <Setter Property="Panel.ZIndex" Value="6" />
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect BlurRadius="10"
                                                                                      Direction="270"
                                                                                      Opacity="0.14"
                                                                                      ShadowDepth="2"
                                                                                      Color="#808080" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ShowDropBefore}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                                         To="4"
                                                                                         Duration="0:0:0.09" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                                         To="0"
                                                                                         Duration="0:0:0.09" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ShowDropAfter}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                                         To="-4"
                                                                                         Duration="0:0:0.09" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                                         To="0"
                                                                                         Duration="0:0:0.09" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Border x:Name="TaskRow" CornerRadius="10">
                                                <Border.Style>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=TaskDragRow}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <Button Width="24" Height="24" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding DataContext.ToggleTaskCompletedCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Style="{StaticResource FocusFlowOutlineButton}" Padding="0" BorderBrush="{DynamicResource TextTertiary}">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource WhiteText}" Text="&#xE73E;" Visibility="Collapsed" />
                                            </Button>
                                            <Grid Margin="38,0,38,0" VerticalAlignment="Center">
                                                <TextBox AutomationProperties.Name="任务名称" IsVisibleChanged="Editor_IsVisibleChanged" KeyDown="TargetTaskTextBox_KeyDown" LostKeyboardFocus="TargetTaskTextBox_LostKeyboardFocus" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource TargetTaskEditorStyle}" />
                                                <TextBlock FontSize="15" Text="{Binding Name}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <Button Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding DataContext.ToggleTaskMenuCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Style="{StaticResource FocusFlowPlainButton}" ToolTip="{DynamicResource FocusTaskMenu}">
                                                <TextBlock FontSize="17" Foreground="{DynamicResource TextSecondary}" Text="···" />
                                            </Button>
                                            <Border Width="126" Margin="0,0,-4,0" HorizontalAlignment="Right" VerticalAlignment="Center" Panel.ZIndex="5" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="10" Visibility="{Binding IsFocusMenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <Button Height="34" Command="{Binding DataContext.BeginEditTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Style="{StaticResource FocusFlowPlainButton}"><TextBlock HorizontalAlignment="Left" Margin="12,0" FontSize="13" Text="{DynamicResource FocusRenameTask}" /></Button>
                                                    <Button Height="34" Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Style="{StaticResource FocusFlowPlainButton}"><TextBlock HorizontalAlignment="Left" Margin="12,0" FontSize="13" Foreground="{DynamicResource Danger}" Text="{DynamicResource FocusDeleteTask}" /></Button>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Row="0" Height="1" Margin="0,52,0,0" Background="{DynamicResource BorderPrimary}" />
                                            <Border Height="2"
                                                    VerticalAlignment="Top"
                                                    Panel.ZIndex="10"
                                                    Background="{DynamicResource AccentPrimary}"
                                                    CornerRadius="1"
                                                    IsHitTestVisible="False"
                                                    Visibility="{Binding ShowDropBefore, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Border Height="2"
                                                    VerticalAlignment="Bottom"
                                                    Panel.ZIndex="10"
                                                    Background="{DynamicResource AccentPrimary}"
                                                    CornerRadius="1"
                                                    IsHitTestVisible="False"
                                                    Visibility="{Binding ShowDropAfter, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>

                            <Button Height="42" Margin="0,1,0,0" HorizontalContentAlignment="Left" Command="{Binding AddTaskCommand}" Style="{StaticResource FocusFlowPlainButton}">
                                <StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,10,0" FontSize="23" Foreground="{DynamicResource AccentPrimary}" Text="+" /><TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource AccentPrimary}" Text="{DynamicResource FocusAddTask}" /></StackPanel>
                            </Button>

                            <Button Height="44" HorizontalContentAlignment="Left" Command="{Binding ToggleCompletedTasksCommand}" Style="{StaticResource FocusFlowPlainButton}" Visibility="{Binding CompletedTasks.Count, Mode=OneWay, Converter={StaticResource PositiveIntToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,10,0" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="›" /><TextBlock FontSize="14" Foreground="{DynamicResource TextSecondary}"><Run Text="{DynamicResource FocusCompletedTasksPrefix}" /><Run Text="{Binding CompletedTasks.Count, Mode=OneWay}" /><Run Text="{DynamicResource FocusCompletedTasksSuffix}" /></TextBlock></StackPanel>
                            </Button>
                            <ItemsControl ItemsSource="{Binding CompletedTasks}" Visibility="{Binding IsCompletedTasksExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="50"><TextBlock Margin="44,0,0,0" VerticalAlignment="Center" FontSize="15" Foreground="{DynamicResource TextSecondary}" TextDecorations="Strikethrough" Text="{Binding Name}" /><TextBlock Margin="0,0,0,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource Success}" Text="&#xE73E;" /></Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Grid Width="286" Height="38" Margin="0,16,0,0" HorizontalAlignment="Center">
                        <Button Width="112" Height="38" HorizontalAlignment="Center" Command="{Binding RequestEndCommand}" Content="{DynamicResource FocusEndAction}" FontSize="14">
                            <Button.Style><Style TargetType="{x:Type Button}" BasedOn="{StaticResource FocusFlowOutlineButton}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsForcedModeActive}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <Border Height="38" Padding="12,0" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource ControlHoverBackground}" CornerRadius="8" IsHitTestVisible="False">
                            <Border.Style><Style TargetType="{x:Type Border}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsForcedModeActive}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                            <StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextSecondary}" Text="&#xE83D;" /><TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource FocusForcedModeStatus}" /></StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid>
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsFocusing}" Value="True" />
                                <Condition Binding="{Binding HasTarget}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <StackPanel Margin="0,163,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        RenderTransform="{StaticResource FocusFlowCenterShift}">
                <Grid Width="290" Height="290">
                    <views:CircularProgressRing Progress="{Binding RemainingProgress}"
                                                ProgressBrush="{DynamicResource AccentPrimary}"
                                                RingThickness="5"
                                                TrackBrush="{DynamicResource FocusRingTrack}" />
                    <Grid>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   FontSize="68"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="{Binding RemainingTimeDisplay}" />
                        <StackPanel Margin="0,187,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Orientation="Horizontal">
                            <Ellipse Width="7"
                                     Height="7"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource AccentPrimary}" />
                            <TextBlock FontSize="16"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Text="{DynamicResource FocusInProgress}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid Width="290" Height="42" Margin="0,30,0,0">
                    <Button Width="137" Height="42" HorizontalAlignment="Center" AutomationProperties.Name="{DynamicResource FocusEndAction}" Command="{Binding RequestEndCommand}" Content="{DynamicResource FocusEndAction}" FontSize="16" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" BorderBrush="{DynamicResource BorderPrimary}">
                        <Button.Style><Style TargetType="{x:Type Button}" BasedOn="{StaticResource FocusFlowOutlineButton}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsForcedModeActive}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                    <Border Height="42" Padding="12,0" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource ControlHoverBackground}" CornerRadius="8" IsHitTestVisible="False">
                        <Border.Style><Style TargetType="{x:Type Border}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsForcedModeActive}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource TextSecondary}" Text="&#xE83D;" /><TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource FocusForcedModeStatus}" /></StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsCompleted}" Value="True" />
                                <Condition Binding="{Binding HasTarget}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <StackPanel Margin="0,52,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Grid Width="118" Height="84">
                    <Ellipse Width="82" Height="82" Fill="{DynamicResource SuccessTint}" />
                    <Ellipse Width="58" Height="58" Fill="{DynamicResource SuccessBright}" />
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource WhiteText}" Text="&#xE73E;" />
                    <Rectangle Width="8" Height="8" Margin="0,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource AccentPrimary}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="45" /></Rectangle.RenderTransform></Rectangle>
                    <Rectangle Width="7" Height="7" Margin="0,12,8,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource SuccessBright}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="45" /></Rectangle.RenderTransform></Rectangle>
                </Grid>

                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource FocusCompletedTitle}" />
                <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource AccentPrimary}"><Run FontSize="44" FontWeight="SemiBold" Text="{Binding CompletedDurationPrimaryValue, Mode=OneWay}" /><Run FontFamily="{DynamicResource FontFamilyPrimary}" FontSize="20" FontWeight="Normal" Text="{Binding CompletedDurationPrimaryUnit, Mode=OneWay}" /><Run FontSize="44" FontWeight="SemiBold" Text="{Binding CompletedDurationSecondaryValue, Mode=OneWay}" /><Run FontFamily="{DynamicResource FontFamilyPrimary}" FontSize="20" FontWeight="Normal" Text="{Binding CompletedDurationSecondaryUnit, Mode=OneWay}" /></TextBlock>

                <Border Width="438" Margin="0,22,0,0" Padding="26,14,26,15" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource OverlayBorder}" BorderThickness="1" CornerRadius="16">
                    <Border.Effect><DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.07" ShadowDepth="4" /></Border.Effect>
                    <StackPanel>
                        <Grid Height="36">
                            <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource FocusSessionCompletedTitle}" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}">
                                <Run Text="{Binding SessionCompletedTaskCount, Mode=OneWay}" /><Run Text="{DynamicResource FocusSessionCompletedSuffix}" />
                            </TextBlock>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource BorderPrimary}" />
                        <ItemsControl Margin="0,3,0,3" ItemsSource="{Binding SessionCompletedTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="38">
                                        <Ellipse Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource SuccessBright}" />
                                        <TextBlock Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource WhiteText}" Text="&#xE73E;" />
                                        <TextBlock Margin="36,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextPrimary}" Text="{Binding Name}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Height="1" Background="{DynamicResource BorderPrimary}" />
                        <Grid Height="52">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource SuccessBright}" Text="&#xE787;" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource FocusTodayTotal}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{Binding TodayTotalDisplay}" />
                        </Grid>
                        <Grid Height="52">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource TextSecondary}" Text="&#xE823;" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource FocusCompletedAt}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{Binding CompletedAtDisplay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,18,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextSecondary}" Text="&#xE753;" />
                    <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource FocusRecordSaved}" />
                </StackPanel>

                <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                    <Button Width="194" AutomationProperties.Name="{DynamicResource FocusAgain}" Command="{Binding FocusAgainCommand}" Content="{DynamicResource FocusAgain}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource AccentPrimary}" BorderBrush="{DynamicResource AccentPrimary}" Style="{StaticResource FocusFlowOutlineButton}" />
                    <Button Width="194" Margin="20,0,0,0" AutomationProperties.Name="{DynamicResource FocusReturnHome}" Command="{Binding ReturnHomeCommand}" Style="{StaticResource FocusFlowAccentButton}">
                        <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource WhiteText}" Text="{DynamicResource FocusReturnHome}" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsCompleted}" Value="True" />
                                <Condition Binding="{Binding HasTarget}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <StackPanel Margin="0,84,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Grid Width="118" Height="92">
                    <Ellipse Width="82" Height="82" Fill="{DynamicResource SuccessTint}" />
                    <Ellipse Width="58" Height="58" Fill="{DynamicResource SuccessBright}" />
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource WhiteText}" Text="&#xE73E;" />
                    <Rectangle Width="8" Height="8" Margin="0,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource AccentPrimary}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="45" /></Rectangle.RenderTransform></Rectangle>
                    <Rectangle Width="7" Height="7" Margin="0,12,8,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource SuccessBright}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="45" /></Rectangle.RenderTransform></Rectangle>
                </Grid>

                <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource FocusCompletedTitle}" />
                <TextBlock Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           FontFamily="{DynamicResource FontFamilyNumeric}"
                           Foreground="{DynamicResource AccentPrimary}"><Run FontSize="48" FontWeight="SemiBold" Text="{Binding CompletedDurationPrimaryValue, Mode=OneWay}" /><Run FontFamily="{DynamicResource FontFamilyPrimary}" FontSize="20" FontWeight="Normal" Text="{Binding CompletedDurationPrimaryUnit, Mode=OneWay}" /><Run FontSize="48" FontWeight="SemiBold" Text="{Binding CompletedDurationSecondaryValue, Mode=OneWay}" /><Run FontFamily="{DynamicResource FontFamilyPrimary}" FontSize="20" FontWeight="Normal" Text="{Binding CompletedDurationSecondaryUnit, Mode=OneWay}" /></TextBlock>

                <Border Width="438" Height="146" Margin="0,55,0,0" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource OverlayBorder}" BorderThickness="1" CornerRadius="16">
                    <Border.Effect><DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.07" ShadowDepth="4" /></Border.Effect>
                    <Grid Margin="26,0">
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="1" /><RowDefinition /></Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource SuccessBright}" Text="&#xE787;" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource FocusTodayTotal}" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{Binding TodayTotalDisplay}" />
                        </Grid>
                        <Border Grid.Row="1" Background="{DynamicResource BorderPrimary}" />
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource TextSecondary}" Text="&#xE823;" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource FocusCompletedAt}" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{Binding CompletedAtDisplay}" />
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Margin="0,24,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextSecondary}" Text="&#xE753;" />
                    <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource FocusRecordSaved}" />
                </StackPanel>

                <StackPanel Margin="0,28,0,0" Orientation="Horizontal">
                    <Button Width="194"
                            AutomationProperties.Name="{DynamicResource FocusAgain}"
                            Command="{Binding FocusAgainCommand}"
                            Content="{DynamicResource FocusAgain}"
                            FontSize="13"
                            FontWeight="Medium"
                            Foreground="{DynamicResource AccentPrimary}"
                            BorderBrush="{DynamicResource AccentPrimary}"
                            Style="{StaticResource FocusFlowOutlineButton}" />
                    <Button Width="194"
                            Margin="20,0,0,0"
                            AutomationProperties.Name="{DynamicResource FocusReturnHome}"
                            Command="{Binding ReturnHomeCommand}"
                            Style="{StaticResource FocusFlowAccentButton}">
                        <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource WhiteText}" Text="{DynamicResource FocusReturnHome}" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Panel.ZIndex="10">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEndConfirmationOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="{DynamicResource ModalScrim}" />
            <Border x:Name="FocusEndConfirmationDialog"
                    Width="350"
                    Height="250"
                    Background="{DynamicResource SurfacePrimary}"
                    BorderBrush="{DynamicResource OverlayBorder}"
                    BorderThickness="1"
                    CornerRadius="20">
                <Border.Effect><DropShadowEffect BlurRadius="24" Direction="270" Opacity="0.16" ShadowDepth="6" /></Border.Effect>
                <Grid Margin="24,16,24,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>
                    <Border x:Name="FocusEndConfirmationClock"
                            Width="52"
                            Height="52"
                            Background="{DynamicResource AccentTint}"
                            CornerRadius="26">
                        <Viewbox Width="27" Height="27">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="1.5" Canvas.Top="1.5" Width="21" Height="21" Fill="{DynamicResource TransparentBrush}" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="1.8" />
                                <Path Data="M 12,6 V 12 L 16.5,15" Fill="{DynamicResource TransparentBrush}" Stroke="{DynamicResource AccentPrimary}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="2" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               Text="{DynamicResource FocusEndConfirmTitle}" />
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource FocusElapsedPrefix}" />
                        <TextBlock x:Name="FocusEndElapsedValue" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" Text="{Binding ElapsedTimeDisplay}" />
                    </StackPanel>
                    <TextBlock x:Name="FocusEndSaveHintText"
                               Grid.Row="3"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextTertiary}"
                               Text="{DynamicResource FocusEndSaveHint}" />
                    <Grid Grid.Row="5" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Button x:Name="FocusEndConfirmationButton"
                                Grid.Column="0"
                                Height="42"
                                AutomationProperties.Name="{DynamicResource FocusConfirmEndAction}"
                                Command="{Binding ConfirmEndCommand}"
                                Background="{DynamicResource SurfacePrimary}"
                                BorderBrush="{DynamicResource BorderPrimary}"
                                BorderThickness="1"
                                Style="{StaticResource FocusFlowOutlineButton}">
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource FocusConfirmEndAction}" />
                        </Button>
                        <Button x:Name="FocusContinueConfirmationButton"
                                Grid.Column="2"
                                Height="42"
                                AutomationProperties.Name="{DynamicResource FocusContinueAction}"
                                Command="{Binding ContinueFocusCommand}"
                                Background="{DynamicResource AccentPrimary}"
                                BorderThickness="0"
                                Style="{StaticResource FocusFlowAccentButton}">
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource WhiteText}" Text="{DynamicResource FocusContinueAction}" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
