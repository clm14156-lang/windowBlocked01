<UserControl x:Class="FocusApp.Desktop.Views.FocusFlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             xmlns:local="clr-namespace:FocusApp.Desktop.Views"
             Background="{DynamicResource SurfacePrimary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:PositiveIntToVisibilityConverter x:Key="PositiveIntToVisibilityConverter" />
        <TranslateTransform x:Key="FocusFlowCenterShift" X="11" />

        <Style x:Key="FocusFlowPlainButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TargetTaskEditorStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="FocusTaskThinScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="5" />
            <Setter Property="MinWidth" Value="5" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="5" Background="{DynamicResource TransparentBrush}">
                            <Track x:Name="PART_Track"
                                   Margin="0,3,0,3"
                                   IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBody"
                                                        Width="3"
                                                        HorizontalAlignment="Center"
                                                        Background="#D1D1D6"
                                                        CornerRadius="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#C7C7CC" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#AEAEB2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusFlowOutlineButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusFlowAccentButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FocusFlowOutlineButton}">
            <Setter Property="Background" Value="{DynamicResource FocusButtonBackground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource FocusButtonHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource FocusButtonPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusNoTargetReturnHomeButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FocusFlowOutlineButton}">
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusNoTaskEndButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#1E2228" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="NoTaskEndButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="21">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NoTaskEndButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NoTaskEndButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsForcedModeActive}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FocusFooterActionStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#697789"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#394555"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="FocusEndConfirmationAccentButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource FocusFlowAccentButton}">
            <Setter Property="FontSize" Value="{DynamicResource ButtonEmphasisFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource ButtonEmphasisFontWeight}" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusEndConfirmationSecondaryButton" TargetType="{x:Type Button}">
            <Setter Property="FontSize" Value="{DynamicResource ButtonFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource ButtonFontWeight}" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FocusCompletionDetails">
            <Grid>
                <Grid x:Name="CompletionGreeting" Margin="44,22,44,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="CompletionHeart" Width="48" Height="48" Margin="0,1,0,0"
                           VerticalAlignment="Top" IsHitTestVisible="False"
                           Source="/FocusApp.Desktop;component/Assets/Images/Illustrations/focus_aixin.png"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource FocusCompletedTitle}" FontSize="26" FontWeight="SemiBold" Foreground="#0B1B2A" />
                        <TextBlock Text="{DynamicResource FocusCompletionSubtitle}" FontSize="17" Foreground="#7A8797" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="CompletionCenter" Width="520" Height="370" Margin="0,108,0,0"
                      HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="100" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="46" />
                        <RowDefinition Height="28" />
                    </Grid.RowDefinitions>
                    <!-- The supplied check illustration has transparent padding above and below. -->
                    <Grid Width="256" Height="150" HorizontalAlignment="Center" ClipToBounds="True">
                        <Image x:Name="CompletionCheck" Width="256" Height="256" Margin="0,-53,0,-53"
                               IsHitTestVisible="False" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                               Source="/FocusApp.Desktop;component/Assets/Images/Illustrations/focus_gouxuan.png" />
                    </Grid>
                    <Viewbox Grid.Row="2" Width="440" Height="100" Stretch="Uniform" StretchDirection="DownOnly">
                        <TextBlock x:Name="CompletionTime" Text="{Binding CompletedTimeDisplay, Mode=OneWay}"
                                   FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="88" FontWeight="Bold"
                                   LineHeight="100" LineStackingStrategy="BlockLineHeight"
                                   Foreground="#071827" TextAlignment="Center" />
                    </Viewbox>
                    <Grid x:Name="CompletionTarget" Grid.Row="4" HorizontalAlignment="Center" MaxWidth="440"
                          Visibility="{Binding HasTarget, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="23" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Width="22" Height="22" VerticalAlignment="Center" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="{Binding ActiveTarget.IconSource, Mode=OneWay, Converter={x:Static views:TargetIconSourceConverter.Instance}, ConverterParameter=#65758B}" />
                        <TextBlock Grid.Column="2" MaxWidth="407" VerticalAlignment="Center"
                                   Text="{Binding TargetName, Mode=OneWay}" FontSize="20" Foreground="#65758B"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding TargetName}" />
                    </Grid>
                    <TextBlock x:Name="CompletionStatistics" Grid.Row="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="18" Foreground="#7A8797">
                        <Run Text="{DynamicResource FocusCompletionTodayPrefix}" /><Run Text="{Binding TodayFocusCount, Mode=OneWay}" /><Run Text="{DynamicResource FocusCompletionTodaySuffix}" /><Run Text="   ·   " /><Run Text="{DynamicResource FocusCompletionTotalPrefix}" /><Run Text="{Binding CompletionTodayTotalDisplay, Mode=OneWay}" />
                    </TextBlock>
                </Grid>

                <StackPanel x:Name="CompletionFooter" Margin="48,0,48,44" VerticalAlignment="Bottom">
                    <Border Height="1" Background="#EEEDEA" Margin="0,0,0,22" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="CompletionAgainButton" Height="42"
                                Style="{StaticResource FocusFooterActionStyle}" Command="{Binding RequestFocusAgainCommand}"
                                AutomationProperties.Name="{DynamicResource FocusAgainShort}">
                            <StackPanel Orientation="Horizontal">
                                <views:SvgIcon Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"
                                               FillOverride="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               Source="/FocusApp.Desktop;component/Assets/Icons/Common/reset.svg" />
                                <TextBlock Text="{DynamicResource FocusAgainShort}" FontSize="16" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                        <Border Width="1" Height="28" Margin="26,0" VerticalAlignment="Center" Background="#E5E7EB" />
                        <Button x:Name="CompletionHomeButton" Height="42"
                                Style="{StaticResource FocusFooterActionStyle}" Command="{Binding ReturnHomeCommand}"
                                AutomationProperties.Name="{DynamicResource FocusReturnHome}">
                            <StackPanel Orientation="Horizontal">
                                <views:SvgIcon Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"
                                               FillOverride="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               Source="/FocusApp.Desktop;component/Assets/Icons/Common/home.svg" />
                                <TextBlock Text="{DynamicResource FocusReturnHome}" FontSize="16" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfacePrimary}">
        <Image x:Name="FocusBackground" Panel.ZIndex="-1" IsHitTestVisible="False"
               Source="/FocusApp.Desktop;component/Assets/Images/Illustrations/foucus_background02.png"
               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
               Visibility="{Binding IsFocusing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <Grid Height="48" Panel.ZIndex="1"
              VerticalAlignment="Top"
              Background="{DynamicResource SurfacePrimary}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Margin="0,4,8,4" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button AutomationProperties.Name="{DynamicResource HomeMinimizeButton}"
                        Click="MinimizeButton_Click"
                        Style="{DynamicResource WindowChromeButtonStyle}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE921;" />
                </Button>
                <Button AutomationProperties.Name="{DynamicResource HomeCloseButton}"
                        Click="CloseButton_Click"
                        Style="{DynamicResource WindowChromeButtonStyle}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE8BB;" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="FocusingView" Margin="0,48,0,0" Background="Transparent" MouseDown="TargetMode_MouseDown"
              Visibility="{Binding IsFocusing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid x:Name="FocusGreeting" Margin="64,40,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image x:Name="FocusGreetingIcon" Width="56" Height="56" VerticalAlignment="Top" Margin="0,-6,0,0"
                       Source="{Binding GreetingIconSource}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="FocusGreetingTitle" Text="{Binding GreetingTitle}" FontSize="{DynamicResource PageTitleFontSize}" FontWeight="{DynamicResource PageTitleFontWeight}" Foreground="#202A34"/>
                    <TextBlock x:Name="FocusGreetingSubtitle" Text="{Binding GreetingSubtitle}" FontSize="{DynamicResource SecondaryFontSize}" FontWeight="{DynamicResource SecondaryFontWeight}" Margin="0,7,0,0" Foreground="#7A8290"/>
                </StackPanel>
            </Grid>
            <Grid IsHitTestVisible="False">
                <Grid.RowDefinitions><RowDefinition Height="0.42*"/><RowDefinition Height="214"/><RowDefinition Height="0.58*"/></Grid.RowDefinitions>
                <StackPanel x:Name="FocusCenter" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Viewbox Width="440" Height="116" Stretch="Uniform" StretchDirection="DownOnly">
                        <TextBlock x:Name="FocusCountdown" Text="{Binding RemainingTimeDisplay}" FontFamily="{DynamicResource FontFamilyNumeric}"
                                   FontSize="100" FontWeight="Normal" Foreground="#111820" TextAlignment="Center"/>
                    </Viewbox>
                    <Grid x:Name="FocusTargetRegion" HorizontalAlignment="Center" Height="30" Margin="0,8,0,0" MaxWidth="440"
                          Visibility="{Binding HasTarget, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Image x:Name="FocusTargetIcon" Width="23" Height="23" VerticalAlignment="Center" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                               Source="{Binding ActiveTarget.IconSource, Mode=OneWay, Converter={x:Static views:TargetIconSourceConverter.Instance}, ConverterParameter=#65758B}"/>
                        <TextBlock x:Name="FocusTargetName" Grid.Column="2" MaxWidth="406" VerticalAlignment="Center" Text="{Binding TargetName, Mode=OneWay}"
                                   FontSize="{DynamicResource SectionTitleFontSize}" FontWeight="{DynamicResource SectionTitleFontWeight}" Foreground="#65758B" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding TargetName}"/>
                    </Grid>
                    <StackPanel x:Name="FocusInProgressStatus" HorizontalAlignment="Center" Orientation="Horizontal">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Margin" Value="0,20,0,0"/><Style.Triggers>
                            <DataTrigger Binding="{Binding HasTarget}" Value="True"><Setter Property="Margin" Value="0,30,0,0"/></DataTrigger>
                        </Style.Triggers></Style></StackPanel.Style>
                        <Ellipse Width="12" Height="12" Margin="0,0,12,0" VerticalAlignment="Center" Fill="{DynamicResource AccentPrimary}"/>
                        <TextBlock Text="{DynamicResource FocusInProgress}" FontSize="{DynamicResource BodyMediumFontSize}" FontWeight="{DynamicResource BodyMediumFontWeight}" Foreground="{DynamicResource AccentPrimary}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <StackPanel x:Name="FocusFooter" Margin="48,0,48,44" VerticalAlignment="Bottom">
                <StackPanel x:Name="FocusForceNotice" Orientation="Horizontal" HorizontalAlignment="Center" IsHitTestVisible="False"
                            Visibility="{Binding ShowForceNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Margin" Value="0,0,0,16"/><Style.Triggers>
                        <DataTrigger Binding="{Binding ShowFocusActions}" Value="False"><Setter Property="Margin" Value="0"/></DataTrigger>
                    </Style.Triggers></Style></StackPanel.Style>
                    <Grid Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Ellipse Stroke="#8190A3" StrokeThickness="1.4"/>
                        <Ellipse Width="1.8" Height="1.8" Fill="#8190A3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0"/>
                        <Path Data="M 7.5,7 L 7.5,11" Stroke="#8190A3" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                    <TextBlock Text="{DynamicResource FocusForcedModeStatus}" FontSize="14" Foreground="#8190A3" VerticalAlignment="Center"/>
                </StackPanel>
                <Border x:Name="FocusFooterRule" Height="1" Background="#EDEEF1" Margin="0,0,0,18"
                        Visibility="{Binding ShowFocusActions, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <StackPanel x:Name="FocusFooterActions" Orientation="Horizontal" HorizontalAlignment="Center"
                            Visibility="{Binding ShowFocusActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button x:Name="FocusEndActionButton" Command="{Binding RequestEndCommand}" Style="{StaticResource FocusFooterActionStyle}"
                            AutomationProperties.Name="{DynamicResource FocusEndAction}"
                            Visibility="{Binding ShowEndFocus, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="14" Height="14" CornerRadius="1.5" Margin="0,0,14,0" VerticalAlignment="Center"
                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="{DynamicResource FocusEndAction}" FontSize="{DynamicResource ButtonFontSize}" FontWeight="{DynamicResource ButtonFontWeight}" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                    <Border x:Name="FocusActionDivider" Height="26" Width="1" Margin="18,0" VerticalAlignment="Center" Background="#E6E8ED"
                            Visibility="{Binding ShowFocusActionDivider, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button x:Name="FocusViewTasksButton" Click="ViewTasksButton_Click" Style="{StaticResource FocusFooterActionStyle}"
                            AutomationProperties.Name="{DynamicResource FocusViewTasks}"
                            Visibility="{Binding ShowTaskButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="19" Margin="0,0,14,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock FontSize="{DynamicResource ButtonFontSize}" FontWeight="{DynamicResource ButtonFontWeight}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <Run Text="{DynamicResource FocusViewTasks}"/><Run Text="（"/><Run Text="{Binding PendingTaskCount, Mode=OneWay}"/><Run Text="）"/>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
        <Grid x:Name="TargetCompletionView" Margin="0,48,0,0">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsCompleted}" Value="True" />
                                <Condition Binding="{Binding HasTarget}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Image x:Name="TargetCompletionBackground" Margin="0,-48,0,0"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                   IsHitTestVisible="False" Opacity="0.8" RenderOptions.BitmapScalingMode="HighQuality"
                   Source="/FocusApp.Desktop;component/Assets/Images/Illustrations/foucus_background02.png"
                   Stretch="UniformToFill" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FocusCompletionDetails}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
        <Grid x:Name="NoTargetCompletionView" Margin="0,48,0,0">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsCompleted}" Value="True" />
                                <Condition Binding="{Binding HasTarget}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Image x:Name="NoTargetCompletionBackground" Margin="0,-48,0,0"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                   IsHitTestVisible="False" Opacity="0.8" RenderOptions.BitmapScalingMode="HighQuality"
                   Source="/FocusApp.Desktop;component/Assets/Images/Illustrations/foucus_background02.png"
                   Stretch="UniformToFill" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FocusCompletionDetails}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
        <Grid Panel.ZIndex="10">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEndConfirmationOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="{DynamicResource ModalScrim}" />
            <Border x:Name="FocusEndConfirmationDialog"
                    Width="370" Height="315" Background="{DynamicResource SurfacePrimary}"
                    BorderBrush="{DynamicResource OverlayBorder}" BorderThickness="1" CornerRadius="20"
                    TextElement.FontFamily="{DynamicResource FontFamilyPrimary}">
                <Border.Effect><DropShadowEffect BlurRadius="16" Direction="270" Opacity="0.10" ShadowDepth="3" /></Border.Effect>
                <Grid>
                    <Button x:Name="FocusEndCloseButton" Width="28" Height="28" Margin="0,12,12,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1"
                            Command="{Binding ContinueFocusCommand}" Style="{StaticResource FocusEndConfirmationSecondaryButton}"
                            AutomationProperties.Name="关闭结束专注确认，继续专注" Foreground="{DynamicResource DisabledText}">
                        <Path Data="M 1,1 L 13,13 M 13,1 L 1,13" Width="14" Height="14" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Grid Margin="28,30,28,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="54"/>
                            <RowDefinition Height="13"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="FocusEndTitle" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="{DynamicResource PageTitleFontSize}" FontWeight="{DynamicResource DialogTitleFontWeight}"
                                   Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource FocusEndNormalTitle}"/>
                        <TextBlock x:Name="FocusEndElapsedLabel" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource SecondaryFontSize}"
                                   FontWeight="{DynamicResource SecondaryFontWeight}" Text="{DynamicResource FocusEndElapsedLabel}"/>
                        <Grid x:Name="FocusEndTimeRegion" Grid.Row="4">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="FocusEndElapsedValue" Foreground="{DynamicResource AccentPrimary}"
                                           FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="{DynamicResource TimerConfirmationFontSize}"
                                           FontWeight="{DynamicResource TimerFontWeight}" AutomationProperties.Name="{Binding EndConfirmationElapsedDisplay}">
                                    <Run Text="{Binding EndConfirmationMinutesDisplay, Mode=OneWay}"/><Run Text=" 分 " FontSize="{DynamicResource TimerUnitFontSize}" FontWeight="{DynamicResource TimerUnitFontWeight}"/><Run Text="{Binding EndConfirmationSecondsDisplay, Mode=OneWay}"/><Run Text=" 秒" FontSize="{DynamicResource TimerUnitFontSize}" FontWeight="{DynamicResource TimerUnitFontWeight}"/>
                                </TextBlock>
                            </Viewbox>
                        </Grid>
                        <Border x:Name="FocusEndStatusRegion" Grid.Row="6" Height="24" Background="{DynamicResource TransparentBrush}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding IsShortEndConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid x:Name="FocusEndWarningIcon" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse Fill="{DynamicResource AccentTint}"/>
                                        <Path Data="M 9,4 L 9,10" Stroke="{DynamicResource AccentPrimary}" Opacity="0.65" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Ellipse Width="1.8" Height="1.8" Fill="{DynamicResource AccentPrimary}" Opacity="0.65"
                                                 Margin="0,11,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="FocusEndWarningText" VerticalAlignment="Center" TextWrapping="NoWrap"
                                               FontSize="{DynamicResource SecondaryFontSize}" FontWeight="{DynamicResource SecondaryFontWeight}"
                                               Foreground="{DynamicResource TextSecondary}">
                                        <Run Text="{DynamicResource FocusEndShortDescriptionPrefix}"/><Run Text="{DynamicResource FocusEndShortDescriptionEmphasis}"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock x:Name="FocusEndEncouragementText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="{DynamicResource SecondaryFontSize}" FontWeight="{DynamicResource SecondaryFontWeight}"
                                           Foreground="{DynamicResource TextSecondary}" Visibility="{Binding IsNormalEndConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Run Text="{DynamicResource FocusEndEncouragementPrefix}"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <Grid x:Name="FocusEndActionRegion" Grid.Row="8" Grid.RowSpan="3">
                            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="12"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                            <Button x:Name="FocusContinueConfirmationButton" Grid.Row="0" Width="268" Height="42" HorizontalAlignment="Center" IsDefault="True"
                                    AutomationProperties.Name="{DynamicResource FocusContinueAction}" Command="{Binding ContinueFocusCommand}"
                                    BorderThickness="0" Style="{StaticResource FocusEndConfirmationAccentButton}">
                                <Button.Effect><DropShadowEffect Color="{DynamicResource AccentShadowColor}" BlurRadius="12" Direction="270" Opacity="0.08" ShadowDepth="3"/></Button.Effect>
                                <TextBlock FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                           FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                           Foreground="{DynamicResource WhiteText}" Text="{DynamicResource FocusContinueAction}"/>
                            </Button>
                            <Button x:Name="FocusEndConfirmationButton" Grid.Row="2" Width="120" Height="32" HorizontalAlignment="Center"
                                    AutomationProperties.Name="{DynamicResource FocusConfirmEndAction}" Command="{Binding EndConfirmedFocusCommand}"
                                    Style="{StaticResource FocusEndConfirmationSecondaryButton}">
                                <TextBlock FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                           FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                           Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource FocusConfirmEndAction}"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid Panel.ZIndex="11">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFocusAgainConfirmationOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="{DynamicResource ModalScrim}" />
            <Border x:Name="FocusAgainConfirmationDialog"
                    Width="300"
                    Height="220"
                    Background="{DynamicResource SurfacePrimary}"
                    BorderBrush="{DynamicResource OverlayBorder}"
                    BorderThickness="1"
                    CornerRadius="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      Direction="270"
                                      Opacity="0.12"
                                      ShadowDepth="4" />
                </Border.Effect>
                <Grid Margin="24,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54" />
                        <RowDefinition Height="44" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>
                    <Border Width="54"
                            Height="54"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource AccentTint}"
                            CornerRadius="27">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource FontFamilyPrimary}"
                                   FontSize="32"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource AccentPrimary}"
                                   Text="?" />
                    </Border>
                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               Text="{Binding FocusAgainConfirmationTitle, Mode=OneWay}" />
                    <TextBlock Grid.Row="2"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="{DynamicResource FocusAgainConfirmationDescription}" />
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Height="42"
                                AutomationProperties.Name="{DynamicResource FocusAgainConfirmationCancel}"
                                Background="{DynamicResource SurfacePrimary}"
                                BorderBrush="{DynamicResource BorderPrimary}"
                                BorderThickness="1"
                                Command="{Binding CancelFocusAgainCommand}"
                                Style="{StaticResource FocusFlowOutlineButton}">
                            <TextBlock FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Text="{DynamicResource FocusAgainConfirmationCancel}" />
                        </Button>
                        <Button Grid.Column="2"
                                Height="42"
                                AutomationProperties.Name="{DynamicResource FocusAgainConfirmationConfirm}"
                                Background="{DynamicResource AccentPrimary}"
                                BorderThickness="0"
                                Command="{Binding FocusAgainCommand}"
                                Style="{StaticResource FocusFlowAccentButton}">
                            <TextBlock FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource WhiteText}"
                                       Text="{DynamicResource FocusAgainConfirmationConfirm}" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
