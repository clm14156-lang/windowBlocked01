<UserControl x:Class="FocusApp.Desktop.Views.FocusFlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             xmlns:local="clr-namespace:FocusApp.Desktop.Views"
             Background="{DynamicResource SurfacePrimary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:PositiveIntToVisibilityConverter x:Key="PositiveIntToVisibilityConverter" />
        <local:RemainingToElapsedProgressConverter x:Key="RemainingToElapsedProgressConverter" />
        <TranslateTransform x:Key="FocusFlowCenterShift" X="11" />

        <Style x:Key="FocusFlowPlainButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TargetTaskEditorStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="FocusTaskThinScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="5" />
            <Setter Property="MinWidth" Value="5" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="5" Background="{DynamicResource TransparentBrush}">
                            <Track x:Name="PART_Track"
                                   Margin="0,3,0,3"
                                   IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBody"
                                                        Width="3"
                                                        HorizontalAlignment="Center"
                                                        Background="#D1D1D6"
                                                        CornerRadius="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#C7C7CC" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#AEAEB2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusFlowOutlineButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusFlowAccentButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FocusFlowOutlineButton}">
            <Setter Property="Background" Value="{DynamicResource FocusButtonBackground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource FocusButtonHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource FocusButtonPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusNoTargetReturnHomeButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FocusFlowOutlineButton}">
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusNoTaskEndButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderBrush" Value="#E9E2D9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource FocusNoTaskEndButtonText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="NoTaskEndButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="21">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NoTaskEndButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NoTaskEndButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsForcedModeActive}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfacePrimary}">
        <Image x:Name="NoTaskFocusBackground"
               Panel.ZIndex="-1"
               IsHitTestVisible="False"
               Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/foucus_background.png"
               Stretch="UniformToFill">
            <Image.Style>
                <Style TargetType="{x:Type Image}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsFocusing}" Value="True" />
                                <Condition Binding="{Binding HasTarget}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>
        <Grid Height="48"
              VerticalAlignment="Top"
              Background="{DynamicResource SurfacePrimary}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Margin="0,4,8,4" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button AutomationProperties.Name="{DynamicResource HomeMinimizeButton}"
                        Click="MinimizeButton_Click"
                        Style="{StaticResource WindowChromeButtonStyle}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE921;" />
                </Button>
                <Button AutomationProperties.Name="{DynamicResource HomeCloseButton}"
                        Click="CloseButton_Click"
                        Style="{StaticResource WindowChromeButtonStyle}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE8BB;" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="TargetFocusingView"
              Margin="0,48,0,0"
              MouseDown="TargetMode_MouseDown">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsFocusing}" Value="True" />
                                <Condition Binding="{Binding HasTarget}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid>
                <Image IsHitTestVisible="False"
                       Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/foucus_background.png"
                       Stretch="UniformToFill" />

                <Grid RenderTransform="{StaticResource FocusFlowCenterShift}">
                    <TextBlock Margin="0,56,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               FontSize="28"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextPrimary}"
                               Text="{Binding PendingTasks[0].Name, Mode=OneWay}" />

                    <Grid Width="290"
                          Height="290"
                          Margin="0,118,0,0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top">
                        <views:CircularProgressRing Progress="{Binding RemainingProgress, Converter={StaticResource RemainingToElapsedProgressConverter}, Mode=OneWay}"
                                                    ProgressBrush="{DynamicResource AccentPrimary}"
                                                    ProgressEndPointDiameter="5"
                                                    RingThickness="2"
                                                    TrackBrush="#EEE8DE" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center"
                                       FontFamily="{DynamicResource FontFamilyNumeric}"
                                       FontSize="68"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Text="{Binding RemainingTimeDisplay}" />
                            <StackPanel Margin="0,3,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="20"
                                           Foreground="{DynamicResource AccentPrimary}"
                                           Text="&#xE735;" />
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="17"
                                           Foreground="{DynamicResource TextPrimary}"
                                           Text="{Binding TargetName, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,476,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               FontSize="24"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="{DynamicResource FocusNoTaskAtmosphere}" />

                    <Image Width="42"
                           Height="8"
                           Margin="0,505,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           IsHitTestVisible="False"
                           Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/focusPage_OrangeLine.png"
                           Stretch="Uniform" />

                    <Grid Width="320"
                          Height="42"
                          Margin="0,555,0,0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Button Height="42"
                                    Command="{Binding RequestEndCommand}"
                                    Content="{DynamicResource FocusEndAction}"
                                    FontSize="14">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource FocusFlowOutlineButton}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsForcedModeActive}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Border Height="42"
                                    Padding="10,0"
                                    Background="{DynamicResource ControlHoverBackground}"
                                    CornerRadius="14"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsForcedModeActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TextSecondary}" Text="&#xE83D;" />
                                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource FocusForcedModeStatus}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Button Grid.Column="2"
                                Height="42"
                                Click="ViewTasksButton_Click"
                                FontSize="14"
                                Style="{StaticResource FocusFlowOutlineButton}">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Margin="0,0,9,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="17" Text="&#xE8FD;" />
                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource FocusViewTasks}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <views:FocusTaskWindow x:Name="TaskPopupView"
                                       Width="290"
                                       Height="420"
                                       Margin="0,105,20,0"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Panel.ZIndex="20"
                                       Visibility="Collapsed" />
            </Grid>

        </Grid>

        <Grid x:Name="NoTaskFocusingView">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsFocusing}" Value="True" />
                                <Condition Binding="{Binding HasTarget}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid RenderTransform="{StaticResource FocusFlowCenterShift}">
                <Grid Width="290"
                      Height="290"
                      Margin="0,163,0,0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top">
                    <views:CircularProgressRing Progress="{Binding RemainingProgress, Converter={StaticResource RemainingToElapsedProgressConverter}, Mode=OneWay}"
                                                ProgressBrush="{DynamicResource AccentPrimary}"
                                                ProgressEndPointDiameter="5"
                                                RingThickness="2"
                                                TrackBrush="#EEE8DE" />
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource FontFamilyNumeric}"
                               FontSize="68"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextPrimary}"
                               Text="{Binding RemainingTimeDisplay}" />
                </Grid>

                <TextBlock Margin="0,520,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           FontSize="24"
                           LineHeight="24"
                           FontWeight="Normal"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="{DynamicResource FocusNoTaskAtmosphere}" />

                <Image Width="42"
                       Height="8"
                       Margin="0,547,0,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       IsHitTestVisible="False"
                       Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/focusPage_OrangeLine.png"
                       Stretch="Uniform" />

                <Grid Width="290" Height="45" Margin="0,606,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Button Width="165"
                            Height="45"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="{DynamicResource FocusEndAction}"
                            Command="{Binding RequestEndCommand}"
                            FontSize="13"
                            FontWeight="Medium"
                            Foreground="{DynamicResource FocusNoTaskEndButtonText}"
                            Background="{DynamicResource TransparentBrush}"
                            BorderBrush="#E9E2D9"
                            BorderThickness="1"
                            Style="{StaticResource FocusNoTaskEndButton}">
                        <TextBlock Foreground="{DynamicResource FocusNoTaskEndButtonText}"
                                   Text="{DynamicResource FocusEndAction}" />
                    </Button>
                    <Border Height="42" Padding="12,0" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource ControlHoverBackground}" CornerRadius="8" IsHitTestVisible="False">
                        <Border.Style><Style TargetType="{x:Type Border}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsForcedModeActive}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource TextSecondary}" Text="&#xE83D;" /><TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource FocusForcedModeStatus}" /></StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Grid>
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsCompleted}" Value="True" />
                                <Condition Binding="{Binding HasTarget}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <StackPanel Margin="0,52,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Grid Width="118" Height="84">
                    <Ellipse Width="82" Height="82" Fill="{DynamicResource SuccessTint}" />
                    <Ellipse Width="58" Height="58" Fill="{DynamicResource SuccessBright}" />
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource WhiteText}" Text="&#xE73E;" />
                    <Rectangle Width="8" Height="8" Margin="0,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource AccentPrimary}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="45" /></Rectangle.RenderTransform></Rectangle>
                    <Rectangle Width="7" Height="7" Margin="0,12,8,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource SuccessBright}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="45" /></Rectangle.RenderTransform></Rectangle>
                </Grid>

                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource FocusCompletedTitle}" />
                <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource AccentPrimary}"><Run FontSize="44" FontWeight="SemiBold" Text="{Binding CompletedDurationPrimaryValue, Mode=OneWay}" /><Run FontFamily="{DynamicResource FontFamilyPrimary}" FontSize="20" FontWeight="Normal" Text="{Binding CompletedDurationPrimaryUnit, Mode=OneWay}" /><Run FontSize="44" FontWeight="SemiBold" Text="{Binding CompletedDurationSecondaryValue, Mode=OneWay}" /><Run FontFamily="{DynamicResource FontFamilyPrimary}" FontSize="20" FontWeight="Normal" Text="{Binding CompletedDurationSecondaryUnit, Mode=OneWay}" /></TextBlock>

                <Border Width="438" Margin="0,22,0,0" Padding="26,14,26,15" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource OverlayBorder}" BorderThickness="1" CornerRadius="16">
                    <Border.Effect><DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.07" ShadowDepth="4" /></Border.Effect>
                    <StackPanel>
                        <Grid Height="36">
                            <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource FocusSessionCompletedTitle}" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}">
                                <Run Text="{Binding SessionCompletedTaskCount, Mode=OneWay}" /><Run Text="{DynamicResource FocusSessionCompletedSuffix}" />
                            </TextBlock>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource BorderPrimary}" />
                        <ScrollViewer x:Name="SessionCompletedTasksScrollViewer"
                                      MaxHeight="158"
                                      Margin="0,3,0,3"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource FocusTaskThinScrollBarStyle}" />
                            </ScrollViewer.Resources>
                            <ItemsControl ItemsSource="{Binding SessionCompletedTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="38">
                                            <Ellipse Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource SuccessBright}" />
                                            <TextBlock Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource WhiteText}" Text="&#xE73E;" />
                                            <TextBlock Margin="36,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextPrimary}" Text="{Binding Name}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Border Height="1" Background="{DynamicResource BorderPrimary}" />
                        <Grid Height="52">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource SuccessBright}" Text="&#xE787;" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource FocusTodayTotal}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{Binding TodayTotalDisplay}" />
                        </Grid>
                        <Grid Height="52">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource TextSecondary}" Text="&#xE823;" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource FocusCompletedAt}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{Binding CompletedAtDisplay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                    <Button Width="194" AutomationProperties.Name="{DynamicResource FocusAgain}" Command="{Binding RequestFocusAgainCommand}" Content="{DynamicResource FocusAgain}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource AccentPrimary}" BorderBrush="{DynamicResource AccentPrimary}" Style="{StaticResource FocusFlowOutlineButton}" />
                    <Button Width="194" Margin="20,0,0,0" AutomationProperties.Name="{DynamicResource FocusReturnHome}" Command="{Binding ReturnHomeCommand}" Style="{StaticResource FocusFlowAccentButton}">
                        <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource WhiteText}" Text="{DynamicResource FocusReturnHome}" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid x:Name="NoTargetCompletionView" Margin="0,48,0,0">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsCompleted}" Value="True" />
                                <Condition Binding="{Binding HasTarget}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Image x:Name="NoTargetCompletionBackground"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   IsHitTestVisible="False"
                   Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/foucus_background.png"
                   Stretch="UniformToFill" />

            <StackPanel Margin="0,80,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Image x:Name="NoTargetCompletionRibbon"
                       Width="430"
                       Height="156"
                       HorizontalAlignment="Center"
                       IsHitTestVisible="False"
                       Source="/FocusApp.Desktop;component/Assets/Images/Illustrations/foucusOntheEnd_ribbon.png"
                       Stretch="Uniform" />

                <TextBlock x:Name="NoTargetCompletionTitle"
                           Margin="0,-22,0,0"
                           HorizontalAlignment="Center"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="{DynamicResource FocusCompletedTitle}" />

                <TextBlock Margin="0,0,0,0"
                           HorizontalAlignment="Center"
                           FontFamily="{DynamicResource FontFamilyNumeric}"
                           Foreground="{DynamicResource AccentPrimary}">
                    <Run FontSize="68"
                         FontWeight="SemiBold"
                         Text="{Binding CompletedDurationMinutes, Mode=OneWay}" />
                    <Run FontFamily="{DynamicResource FontFamilyPrimary}"
                         FontSize="20"
                         FontWeight="Medium"
                         Foreground="{DynamicResource TextPrimary}"
                         Text="{DynamicResource FocusCompletionMinutesUnit}" />
                </TextBlock>

                <TextBlock Margin="0,2,0,0"
                           HorizontalAlignment="Center"
                           FontSize="15"
                           FontWeight="Normal"
                           Foreground="{DynamicResource TextWeak}"
                           Text="{DynamicResource FocusCompletionEncouragement}" />

                <Border x:Name="NoTargetCompletionSummary"
                        Width="280"
                        Height="38"
                        Margin="0,18,0,0"
                        Background="{DynamicResource TransparentBrush}"
                        BorderBrush="{DynamicResource BorderPrimary}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{DynamicResource TextWeak}"
                                   Text="&#xE823;" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource TextSecondary}">
                            <Run Text="{DynamicResource FocusTodayTotal}" />
                            <Run Text=" " />
                            <Run Text="{Binding TodayTotalMinutes, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{DynamicResource FocusCompletionMinutesUnit}" />
                            <Run Foreground="{DynamicResource AccentPrimary}" Text="  ·  " />
                            <Run Text="{Binding TodayFocusCount, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{DynamicResource FocusCompletionSessionCountSuffix}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,38,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Width="172"
                            Height="48"
                            AutomationProperties.Name="{DynamicResource FocusAgain}"
                            Background="{DynamicResource TransparentBrush}"
                            BorderBrush="{DynamicResource BorderPrimary}"
                            BorderThickness="1"
                            Command="{Binding RequestFocusAgainCommand}"
                            FontSize="13"
                            FontWeight="Medium"
                            Style="{StaticResource FocusFlowOutlineButton}">
                        <TextBlock FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="{DynamicResource FocusAgainShort}" />
                    </Button>
                    <Button Width="172"
                            Height="48"
                            Margin="20,0,0,0"
                            AutomationProperties.Name="{DynamicResource FocusReturnHome}"
                            Command="{Binding ReturnHomeCommand}"
                            Style="{StaticResource FocusNoTargetReturnHomeButton}">
                        <TextBlock FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource WhiteText}"
                                   Text="{DynamicResource FocusReturnHome}" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Panel.ZIndex="10">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEndConfirmationOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="{DynamicResource ModalScrim}" />
            <Border x:Name="FocusEndConfirmationDialog"
                    Width="350"
                    Height="250"
                    Background="{DynamicResource SurfacePrimary}"
                    BorderBrush="{DynamicResource OverlayBorder}"
                    BorderThickness="1"
                    CornerRadius="20">
                <Border.Effect><DropShadowEffect BlurRadius="24" Direction="270" Opacity="0.16" ShadowDepth="6" /></Border.Effect>
                <Grid Margin="24,16,24,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>
                    <Border x:Name="FocusEndConfirmationClock"
                            Width="52"
                            Height="52"
                            Background="{DynamicResource AccentTint}"
                            CornerRadius="26">
                        <Viewbox Width="27" Height="27">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="1.5" Canvas.Top="1.5" Width="21" Height="21" Fill="{DynamicResource TransparentBrush}" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="1.8" />
                                <Path Data="M 12,6 V 12 L 16.5,15" Fill="{DynamicResource TransparentBrush}" Stroke="{DynamicResource AccentPrimary}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="2" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               Text="{DynamicResource FocusEndConfirmTitle}" />
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource FocusElapsedPrefix}" />
                        <TextBlock x:Name="FocusEndElapsedValue" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" Text="{Binding ElapsedTimeDisplay}" />
                    </StackPanel>
                    <TextBlock x:Name="FocusEndSaveHintText"
                               Grid.Row="3"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextTertiary}"
                               Text="{DynamicResource FocusEndSaveHint}" />
                    <Grid Grid.Row="5" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Button x:Name="FocusEndConfirmationButton"
                                Grid.Column="0"
                                Height="42"
                                AutomationProperties.Name="{DynamicResource FocusConfirmEndAction}"
                                Command="{Binding ConfirmEndCommand}"
                                Background="{DynamicResource SurfacePrimary}"
                                BorderBrush="{DynamicResource BorderPrimary}"
                                BorderThickness="1"
                                Style="{StaticResource FocusFlowOutlineButton}">
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource FocusConfirmEndAction}" />
                        </Button>
                        <Button x:Name="FocusContinueConfirmationButton"
                                Grid.Column="2"
                                Height="42"
                                AutomationProperties.Name="{DynamicResource FocusContinueAction}"
                                Command="{Binding ContinueFocusCommand}"
                                Background="{DynamicResource AccentPrimary}"
                                BorderThickness="0"
                                Style="{StaticResource FocusFlowAccentButton}">
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource WhiteText}" Text="{DynamicResource FocusContinueAction}" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Panel.ZIndex="11">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFocusAgainConfirmationOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="{DynamicResource ModalScrim}" />
            <Border x:Name="FocusAgainConfirmationDialog"
                    Width="300"
                    Height="220"
                    Background="{DynamicResource SurfacePrimary}"
                    BorderBrush="{DynamicResource OverlayBorder}"
                    BorderThickness="1"
                    CornerRadius="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      Direction="270"
                                      Opacity="0.12"
                                      ShadowDepth="4" />
                </Border.Effect>
                <Grid Margin="24,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54" />
                        <RowDefinition Height="44" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>
                    <Border Width="54"
                            Height="54"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource AccentTint}"
                            CornerRadius="27">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource FontFamilyPrimary}"
                                   FontSize="32"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource AccentPrimary}"
                                   Text="?" />
                    </Border>
                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               Text="{Binding FocusAgainConfirmationTitle, Mode=OneWay}" />
                    <TextBlock Grid.Row="2"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="{DynamicResource FocusAgainConfirmationDescription}" />
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Height="42"
                                AutomationProperties.Name="{DynamicResource FocusAgainConfirmationCancel}"
                                Background="{DynamicResource SurfacePrimary}"
                                BorderBrush="{DynamicResource BorderPrimary}"
                                BorderThickness="1"
                                Command="{Binding CancelFocusAgainCommand}"
                                Style="{StaticResource FocusFlowOutlineButton}">
                            <TextBlock FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Text="{DynamicResource FocusAgainConfirmationCancel}" />
                        </Button>
                        <Button Grid.Column="2"
                                Height="42"
                                AutomationProperties.Name="{DynamicResource FocusAgainConfirmationConfirm}"
                                Background="{DynamicResource AccentPrimary}"
                                BorderThickness="0"
                                Command="{Binding FocusAgainCommand}"
                                Style="{StaticResource FocusFlowAccentButton}">
                            <TextBlock FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource WhiteText}"
                                       Text="{DynamicResource FocusAgainConfirmationConfirm}" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
