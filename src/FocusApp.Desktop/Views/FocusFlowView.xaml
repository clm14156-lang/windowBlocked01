<UserControl x:Class="FocusApp.Desktop.Views.FocusFlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             xmlns:local="clr-namespace:FocusApp.Desktop.Views"
             views:FocusThemeScope.IsDark="{Binding IsDarkFocusTheme}"
             Background="{DynamicResource SurfacePrimary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/FocusTheme.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:PositiveIntToVisibilityConverter x:Key="PositiveIntToVisibilityConverter" />
        <TranslateTransform x:Key="FocusFlowCenterShift" X="11" />
        <LinearGradientBrush x:Key="FocusEndButtonBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF8A00" Offset="0" />
            <GradientStop Color="#FF7800" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FocusEndButtonHoverBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF981A" Offset="0" />
            <GradientStop Color="#FF8614" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="FocusFlowPlainButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TargetTaskEditorStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="FocusTaskThinScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="5" />
            <Setter Property="MinWidth" Value="5" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="5" Background="{DynamicResource TransparentBrush}">
                            <Track x:Name="PART_Track"
                                   Margin="0,3,0,3"
                                   IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBody"
                                                        Width="3"
                                                        HorizontalAlignment="Center"
                                                        Background="#D1D1D6"
                                                        CornerRadius="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#C7C7CC" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#AEAEB2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusFlowOutlineButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusFlowAccentButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FocusFlowOutlineButton}">
            <Setter Property="Background" Value="{DynamicResource FocusButtonBackground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource FocusButtonHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource FocusButtonPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusNoTargetReturnHomeButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FocusFlowOutlineButton}">
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusNoTaskEndButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#1E2228" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="NoTaskEndButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="21">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NoTaskEndButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NoTaskEndButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsForcedModeActive}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FocusChromeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ChromeSurface" Background="{TemplateBinding Background}" CornerRadius="8">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChromeSurface" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ChromeSurface" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsFullScreenVisible}" Value="True" />
                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="ChromeSurface" Property="Background" Value="{DynamicResource FocusChromeHoverBrush}" />
                    </MultiDataTrigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFullScreenVisible}" Value="True"><Setter Property="Foreground" Value="{DynamicResource FocusCountdownBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FocusFooterActionStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource FocusFooterBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource FocusFooterHoverBrush}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="FocusConfirmationTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource FocusEndTitleBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FocusAgainConfirmationActionButton" TargetType="Button" BasedOn="{StaticResource FocusFlowOutlineButton}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="{DynamicResource ButtonFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource ButtonFontWeight}" />
            <Setter Property="Foreground" Value="{DynamicResource FocusEndSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource FocusAgainCancelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Button}}"
                                   FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                   FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}" /><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="1" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="FocusEndConfirmationAccentButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource FocusFlowAccentButton}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="{StaticResource FocusEndButtonBackground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#30FFB45E" BorderThickness="1" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource FocusEndButtonHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusEndConfirmationSecondaryButton" TargetType="{x:Type Button}">
            <Setter Property="FontSize" Value="{DynamicResource ButtonFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource ButtonFontWeight}" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusEndConfirmationTextButton" TargetType="Button" BasedOn="{StaticResource FocusEndConfirmationSecondaryButton}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource FocusEndSecondaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource FocusEndTitleBrush}" /></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FocusCountdownTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyNumeric}" />
            <Setter Property="FontSize" Value="100" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource FocusCountdownBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="FocusCompletionDetails">
            <Grid>
                <Grid x:Name="CompletionGreeting" Margin="40,40,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="CompletionHeart" Width="48" Height="48" Margin="0,1,0,0"
                           VerticalAlignment="Top" IsHitTestVisible="False"
                           Source="/FocusApp.Desktop;component/Assets/Images/Illustrations/focus_aixin.png"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="CompletionTitle" Text="{DynamicResource FocusCompletedTitle}" FontSize="{DynamicResource PageTitleFontSize}" FontWeight="{DynamicResource PageTitleFontWeight}" Foreground="{DynamicResource FocusTitleBrush}" />
                        <TextBlock x:Name="CompletionSubtitle" Text="{Binding CompletionSubtitle}" FontSize="{DynamicResource SectionTitleFontSize}" FontWeight="{DynamicResource BodyFontWeight}" Foreground="{DynamicResource FocusSubtitleBrush}" Margin="0,4,0,0"
                                   MaxWidth="668" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="CompletionCenter" MaxWidth="520" Margin="0,168,0,0"
                      HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False">
                    <!-- The supplied check illustration has transparent padding above and below. -->
                    <Grid Width="256" Height="150" HorizontalAlignment="Center" ClipToBounds="True">
                        <Image x:Name="CompletionCheck"
                               IsHitTestVisible="False" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                               Source="{DynamicResource FocusCompletionCheck}">
                            <Image.Style><Style TargetType="Image">
                                <Setter Property="Width" Value="256" />
                                <Setter Property="Height" Value="256" />
                                <Setter Property="Margin" Value="0,-53,0,-53" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsDarkFocusTheme}" Value="True">
                                    <Setter Property="Width" Value="128" />
                                    <Setter Property="Height" Value="128" />
                                    <Setter Property="Margin" Value="0,11,0,11" />
                                </DataTrigger></Style.Triggers>
                            </Style></Image.Style>
                        </Image>
                    </Grid>
                    <StackPanel x:Name="CompletionSummary" Margin="0,-30,0,0" HorizontalAlignment="Center">
                        <Viewbox Width="440" Height="116" Stretch="Uniform" StretchDirection="DownOnly">
                            <TextBlock x:Name="CompletionTime" Text="{Binding CompletedTimeDisplay, Mode=OneWay}"
                                       Style="{StaticResource FocusCountdownTextStyle}" />
                        </Viewbox>
                        <StackPanel Margin="0,-4,0,0" HorizontalAlignment="Center">
                            <Grid x:Name="CompletionTarget" HorizontalAlignment="Center" MaxWidth="440" Height="26" Margin="0,0,0,6"
                                  Visibility="{Binding HasTarget, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="23" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image x:Name="CompletionTargetIcon" Width="22" Height="22" VerticalAlignment="Center" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Source><MultiBinding Converter="{x:Static views:TargetIconSourceConverter.Instance}">
                                        <Binding Source="/FocusApp.Desktop;component/Assets/Icons/targetSelected_Svg/internet.svg" />
                                        <Binding ElementName="CompletionTargetName" Path="Foreground" />
                                    </MultiBinding></Image.Source>
                                </Image>
                                <TextBlock x:Name="CompletionTargetName" Grid.Column="2" MaxWidth="407" VerticalAlignment="Center"
                                           Text="{Binding TargetName, Mode=OneWay}" FontSize="{DynamicResource SectionTitleFontSize}" FontWeight="{DynamicResource SectionTitleFontWeight}" Foreground="{DynamicResource FocusTargetBrush}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding TargetName}" />
                            </Grid>
                            <Grid Height="30">
                                <TextBlock x:Name="CompletionStatistics" Text="{Binding CompletionTodayStatistics, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="{DynamicResource BodyFontSize}" FontWeight="{DynamicResource BodyFontWeight}" Foreground="{DynamicResource FocusSubtitleBrush}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="CompletionFooter" Margin="40,0,40,20" VerticalAlignment="Bottom">
                    <StackPanel x:Name="CompletionFooterActions" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="CompletionAgainButton"
                                Style="{StaticResource FocusFooterActionStyle}" Command="{Binding RequestFocusAgainCommand}"
                                AutomationProperties.Name="{DynamicResource FocusAgainShort}">
                            <StackPanel Orientation="Horizontal">
                                <views:SvgIcon Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"
                                               FillOverride="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               Source="/FocusApp.Desktop;component/Assets/Icons/Common/reset.svg" />
                                <TextBlock Text="{DynamicResource FocusAgainShort}" FontSize="{DynamicResource ButtonFontSize}" FontWeight="{DynamicResource ButtonFontWeight}" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                        <Border x:Name="CompletionActionDivider" Width="1" Height="26" Margin="18,0" VerticalAlignment="Center" Background="{DynamicResource FocusDividerBrush}" />
                        <Button x:Name="CompletionHomeButton"
                                Style="{StaticResource FocusFooterActionStyle}" Command="{Binding ReturnHomeCommand}"
                                AutomationProperties.Name="{DynamicResource FocusReturnHome}">
                            <StackPanel Orientation="Horizontal">
                                <views:SvgIcon Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"
                                               FillOverride="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               Source="/FocusApp.Desktop;component/Assets/Icons/Common/home.svg" />
                                <TextBlock Text="{DynamicResource FocusReturnHome}" FontSize="{DynamicResource ButtonFontSize}" FontWeight="{DynamicResource ButtonFontWeight}" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfacePrimary}">
        <Image x:Name="FocusBackground" Panel.ZIndex="-1" IsHitTestVisible="False"
               Source="{DynamicResource FocusSceneBackground}"
               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
               Visibility="{Binding IsFullScreenVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <views:FocusLeafLayer x:Name="FocusLeaves" Sources="{DynamicResource FocusSceneLeaves}" IsActive="{Binding IsFocusing}"
                             TotalFocusSeconds="{Binding TotalFocusSeconds}" RemainingFocusSeconds="{Binding RemainingFocusSeconds}"
                             WeatherBrush="{DynamicResource FocusWeatherBrush}"
                             IsHitTestVisible="False" ClipToBounds="True"/>
        <Grid Height="48" Panel.ZIndex="1"
              VerticalAlignment="Top"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.Style><Style TargetType="Grid">
                <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
                <Style.Triggers><DataTrigger Binding="{Binding IsFullScreenVisible}" Value="True"><Setter Property="Background" Value="Transparent" /></DataTrigger></Style.Triggers>
            </Style></Grid.Style>
            <StackPanel Margin="0,4,8,4" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button AutomationProperties.Name="{DynamicResource HomeMinimizeButton}"
                        Click="MinimizeButton_Click"
                        Style="{StaticResource FocusChromeButtonStyle}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE921;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button AutomationProperties.Name="{DynamicResource HomeCloseButton}"
                        Click="CloseButton_Click"
                        Style="{StaticResource FocusChromeButtonStyle}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE8BB;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="FocusingView" Background="Transparent" MouseDown="TargetMode_MouseDown"
              Visibility="{Binding IsFocusing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid x:Name="FocusGreeting" Margin="40,40,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image x:Name="FocusGreetingIcon" Width="56" Height="56" VerticalAlignment="Top" Margin="0,-6,0,0"
                       Source="{Binding GreetingIconSource}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="FocusGreetingTitle" Text="{Binding GreetingTitle}" FontSize="{DynamicResource PageTitleFontSize}" FontWeight="{DynamicResource PageTitleFontWeight}" Foreground="{DynamicResource FocusTitleBrush}"/>
                    <TextBlock x:Name="FocusGreetingSubtitle" Text="{Binding GreetingSubtitle}" FontSize="{DynamicResource SecondaryFontSize}" FontWeight="{DynamicResource SecondaryFontWeight}" Margin="0,7,0,0" Foreground="{DynamicResource FocusSubtitleBrush}"
                               MaxWidth="668" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
            </Grid>
            <Grid IsHitTestVisible="False">
                <StackPanel x:Name="FocusCenter" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,128,0,0">
                    <Viewbox Width="440" Height="116" Stretch="Uniform" StretchDirection="DownOnly">
                        <TextBlock x:Name="FocusCountdown" Text="{Binding RemainingTimeDisplay}" Style="{StaticResource FocusCountdownTextStyle}"/>
                    </Viewbox>
                    <Grid x:Name="FocusTargetRegion" HorizontalAlignment="Center" Height="30" Margin="0,8,0,0" MaxWidth="440"
                          Visibility="{Binding HasTarget, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Image x:Name="FocusTargetIcon" Width="23" Height="23" VerticalAlignment="Center" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                               >
                            <Image.Source><MultiBinding Converter="{x:Static views:TargetIconSourceConverter.Instance}">
                                <Binding Path="ActiveTarget.IconSource" Mode="OneWay" />
                                <Binding ElementName="FocusTargetName" Path="Foreground" />
                            </MultiBinding></Image.Source>
                        </Image>
                        <TextBlock x:Name="FocusTargetName" Grid.Column="2" MaxWidth="406" VerticalAlignment="Center" Text="{Binding TargetName, Mode=OneWay}"
                                   FontSize="{DynamicResource SectionTitleFontSize}" FontWeight="{DynamicResource SectionTitleFontWeight}" Foreground="{DynamicResource FocusTargetBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding TargetName}"/>
                    </Grid>
                </StackPanel>
            </Grid>
            <Grid x:Name="FocusCharacterShadowLayers" Width="288" Height="36"
                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,540,0,0" IsHitTestVisible="False">
                <Image x:Name="FocusCharacterShadow" Source="{DynamicResource FocusSceneShadow}" Width="288" Height="36"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <Image x:Name="FocusCharacterContactShadow" Width="216" Height="{Binding ActualHeight, ElementName=FocusCharacterShadow}" Opacity="0.4"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Source" Value="{x:Null}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDarkFocusTheme}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Source" Value="{DynamicResource FocusSceneContactShadow}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Grid>
            <views:FocusCharacterImage x:Name="FocusCharacter" CharacterId="{Binding FocusCharacterId}" IsNight="{Binding IsDarkFocusTheme}"
                   Width="{Binding FocusCharacterId, Converter={x:Static views:FocusCharacterSizeConverter.Instance}}"
                   Height="{Binding FocusCharacterId, Converter={x:Static views:FocusCharacterSizeConverter.Instance}}"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Stretch="Uniform"
                   RenderTransformOrigin="{x:Static views:FocusCharacterMotion.TransformOrigin}" views:FocusCharacterMotion.IsEnabled="True"
                   IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality">
                <views:FocusCharacterImage.Margin>
                    <MultiBinding Converter="{x:Static views:FocusCharacterPlacementConverter.Instance}">
                        <Binding Path="FocusCharacterId"/>
                        <Binding Path="IsDarkFocusTheme"/>
                    </MultiBinding>
                </views:FocusCharacterImage.Margin>
            </views:FocusCharacterImage>
            <StackPanel x:Name="FocusFooter" Margin="40,0,40,20" VerticalAlignment="Bottom">
                <StackPanel x:Name="FocusForceNotice" Orientation="Horizontal" HorizontalAlignment="Center" IsHitTestVisible="False"
                            Visibility="{Binding ShowForceNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Margin" Value="0,0,0,16"/><Style.Triggers>
                        <DataTrigger Binding="{Binding ShowFocusActions}" Value="False"><Setter Property="Margin" Value="0"/></DataTrigger>
                    </Style.Triggers></Style></StackPanel.Style>
                    <Grid Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Ellipse Stroke="{DynamicResource FocusNoticeBrush}" StrokeThickness="1.4"/>
                        <Ellipse Width="1.8" Height="1.8" Fill="{DynamicResource FocusNoticeBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0"/>
                        <Path Data="M 7.5,7 L 7.5,11" Stroke="{DynamicResource FocusNoticeBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                    <TextBlock Text="{DynamicResource FocusForcedModeStatus}" FontSize="14" Foreground="{DynamicResource FocusNoticeBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Border x:Name="FocusFooterRule" Height="1" Background="{DynamicResource FocusRuleBrush}" Margin="0,0,0,18"
                        Visibility="{Binding ShowFocusActions, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <StackPanel x:Name="FocusFooterActions" Orientation="Horizontal" HorizontalAlignment="Center"
                            Visibility="{Binding ShowFocusActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button x:Name="FocusEndActionButton" Command="{Binding RequestEndCommand}" Style="{StaticResource FocusFooterActionStyle}"
                            AutomationProperties.Name="{DynamicResource FocusEndAction}"
                            Visibility="{Binding ShowEndFocus, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="14" Height="14" CornerRadius="1.5" Margin="0,0,14,0" VerticalAlignment="Center"
                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="{DynamicResource FocusEndAction}" FontSize="{DynamicResource ButtonFontSize}" FontWeight="{DynamicResource ButtonFontWeight}" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                    <Border x:Name="FocusActionDivider" Height="26" Width="1" Margin="18,0" VerticalAlignment="Center" Background="{DynamicResource FocusDividerBrush}"
                            Visibility="{Binding ShowFocusActionDivider, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button x:Name="FocusViewTasksButton" Click="ViewTasksButton_Click" Style="{StaticResource FocusFooterActionStyle}"
                            AutomationProperties.Name="{DynamicResource FocusViewTasks}"
                            Visibility="{Binding ShowTaskButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="19" Margin="0,0,14,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock FontSize="{DynamicResource ButtonFontSize}" FontWeight="{DynamicResource ButtonFontWeight}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <Run Text="{DynamicResource FocusViewTasks}"/><Run Text="（"/><Run Text="{Binding PendingTaskCount, Mode=OneWay}"/><Run Text="）"/>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
        <ContentControl x:Name="CompletionView" Content="{Binding}" ContentTemplate="{StaticResource FocusCompletionDetails}"
                        Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        <Grid Panel.ZIndex="10">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEndConfirmationOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="{DynamicResource ModalScrim}" />
            <Border x:Name="FocusEndConfirmationDialog"
                    Width="330" Height="300" Background="{DynamicResource FocusEndDialogBackground}"
                    BorderBrush="{DynamicResource FocusEndDialogBorder}" BorderThickness="1" CornerRadius="20"
                    TextElement.FontFamily="{DynamicResource FontFamilyPrimary}">
                <Border.Effect><DropShadowEffect BlurRadius="24" Direction="270" Opacity="0.22" ShadowDepth="6" /></Border.Effect>
                <Grid>
                    <Button x:Name="FocusEndCloseButton" Width="28" Height="28" Margin="0,12,12,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1"
                            Command="{Binding ContinueFocusCommand}" Style="{StaticResource FocusEndConfirmationSecondaryButton}"
                            AutomationProperties.Name="关闭结束专注确认，继续专注" Foreground="{DynamicResource DisabledText}">
                        <Path Data="M 1,1 L 13,13 M 13,1 L 1,13" Width="14" Height="14" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Grid Margin="24,24,24,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="19"/>
                            <RowDefinition Height="7"/>
                            <RowDefinition Height="56"/>
                            <RowDefinition Height="9"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="28"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="FocusEndTitle" Grid.Row="0" Style="{StaticResource FocusConfirmationTitle}"
                                   Text="{DynamicResource FocusEndNormalTitle}"/>
                        <TextBlock x:Name="FocusEndElapsedLabel" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource FocusEndSecondaryBrush}" FontSize="13"
                                   FontWeight="Normal" Text="{DynamicResource FocusEndElapsedLabel}"/>
                        <Grid x:Name="FocusEndTimeRegion" Grid.Row="4">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="FocusEndElapsedValue" Foreground="{DynamicResource AccentPrimary}"
                                           FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="44"
                                           FontWeight="{DynamicResource TimerFontWeight}" AutomationProperties.Name="{Binding EndConfirmationElapsedDisplay}">
                                    <Run Text="{Binding EndConfirmationMinutesDisplay, Mode=OneWay}"/><Run Text=" 分 " FontSize="18" FontWeight="{DynamicResource TimerUnitFontWeight}" Foreground="{DynamicResource FocusEndSecondaryBrush}"/><Run Text="{Binding EndConfirmationSecondsDisplay, Mode=OneWay}"/><Run Text=" 秒" FontSize="18" FontWeight="{DynamicResource TimerUnitFontWeight}" Foreground="{DynamicResource FocusEndSecondaryBrush}"/>
                                </TextBlock>
                            </Viewbox>
                        </Grid>
                        <Border x:Name="FocusEndStatusRegion" Grid.Row="6" Width="240" Height="34" HorizontalAlignment="Center" Padding="10,0" CornerRadius="10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers><DataTrigger Binding="{Binding IsShortEndConfirmation}" Value="True"><Setter Property="Background" Value="{DynamicResource FocusEndWarningBackground}" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding IsShortEndConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid x:Name="FocusEndWarningIcon" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse Fill="{DynamicResource FocusEndWarningIconBrush}"/>
                                        <Path Data="M 9,4 L 9,10" Stroke="White" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Ellipse Width="1.8" Height="1.8" Fill="White"
                                                 Margin="0,11,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="FocusEndWarningText" VerticalAlignment="Center" TextWrapping="NoWrap"
                                               FontSize="11.5" FontWeight="Normal"
                                               Foreground="{DynamicResource FocusEndWarningTextBrush}">
                                        <Run Text="{DynamicResource FocusEndShortDescriptionPrefix}"/><Run Text="{DynamicResource FocusEndShortDescriptionEmphasis}"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock x:Name="FocusEndEncouragementText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="{DynamicResource SecondaryFontSize}" FontWeight="{DynamicResource SecondaryFontWeight}"
                                           Foreground="{DynamicResource FocusEndSecondaryBrush}" Visibility="{Binding IsNormalEndConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Run Text="{DynamicResource FocusEndEncouragementPrefix}"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <Grid x:Name="FocusEndActionRegion" Grid.Row="8" Grid.RowSpan="3">
                            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="8"/><RowDefinition Height="28"/></Grid.RowDefinitions>
                            <Button x:Name="FocusContinueConfirmationButton" Grid.Row="0" Height="42" HorizontalAlignment="Stretch" IsDefault="True"
                                    AutomationProperties.Name="{DynamicResource FocusContinueAction}" Command="{Binding ContinueFocusCommand}"
                                    BorderThickness="0" Style="{StaticResource FocusEndConfirmationAccentButton}">
                                <Button.Effect><DropShadowEffect Color="{DynamicResource AccentShadowColor}" BlurRadius="18" Direction="270" Opacity="0.20" ShadowDepth="4"/></Button.Effect>
                                <TextBlock FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                           FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                           Foreground="{DynamicResource WhiteText}" Text="{DynamicResource FocusContinueAction}"/>
                            </Button>
                            <Button x:Name="FocusEndConfirmationButton" Grid.Row="2" Width="120" Height="28" HorizontalAlignment="Center"
                                    AutomationProperties.Name="{DynamicResource FocusConfirmEndAction}" Command="{Binding EndConfirmedFocusCommand}"
                                    Style="{StaticResource FocusEndConfirmationTextButton}">
                                <TextBlock FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                           FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="{DynamicResource FocusConfirmEndAction}"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid Panel.ZIndex="11">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFocusAgainConfirmationOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="{DynamicResource ModalScrim}" />
            <Border x:Name="FocusAgainConfirmationDialog"
                    Width="330" Height="180" Background="{DynamicResource FocusEndDialogBackground}"
                    BorderBrush="{DynamicResource FocusEndDialogBorder}" BorderThickness="1" CornerRadius="20"
                    TextElement.FontFamily="{DynamicResource FontFamilyPrimary}" KeyboardNavigation.TabNavigation="Cycle">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      Direction="270"
                                      Opacity="0.20"
                                      ShadowDepth="4" />
                </Border.Effect>
                <Grid>
                    <Button x:Name="FocusAgainCloseButton" Width="24" Height="24" Margin="0,8,8,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1"
                            Command="{Binding CancelFocusAgainCommand}" Style="{StaticResource FocusEndConfirmationSecondaryButton}"
                            Foreground="{DynamicResource FocusEndSecondaryBrush}" AutomationProperties.Name="{DynamicResource FocusAgainConfirmationClose}">
                        <Path Data="M 1,1 L 13,13 M 13,1 L 1,13" Width="12" Height="12" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Grid Margin="24,22,24,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/><RowDefinition Height="6"/><RowDefinition Height="40"/>
                            <RowDefinition Height="18"/><RowDefinition Height="40"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="FocusAgainTitle" Style="{StaticResource FocusConfirmationTitle}"
                                   Text="{DynamicResource FocusAgainConfirmationTitle}"/>
                        <Viewbox x:Name="FocusAgainDescriptionRegion" Grid.Row="2" Stretch="Uniform" StretchDirection="DownOnly"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="FocusAgainDescription" TextAlignment="Center" LineHeight="20" TextWrapping="NoWrap"
                                       FontSize="{DynamicResource BodyFontSize}" FontWeight="{DynamicResource BodyFontWeight}"
                                       Foreground="{DynamicResource FocusEndSecondaryBrush}">
                                <Run Text="{DynamicResource FocusAgainConfirmationDescriptionPrefix}"/>
                                <Run x:Name="FocusAgainDuration" Text="{Binding CompletedDurationDisplay, Mode=OneWay}" Foreground="{DynamicResource AccentPrimary}" FontWeight="SemiBold"/>
                                <Run Text="{DynamicResource FocusAgainConfirmationDescriptionSuffix}"/><LineBreak/>
                                <Run Text="{DynamicResource FocusAgainConfirmationDescription}"/>
                            </TextBlock>
                        </Viewbox>
                        <Grid x:Name="FocusAgainActionRegion" Grid.Row="4">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button x:Name="FocusAgainCancelButton" Grid.Column="0" Style="{StaticResource FocusAgainConfirmationActionButton}"
                                    Command="{Binding CancelFocusAgainCommand}" IsCancel="True"
                                    AutomationProperties.Name="{DynamicResource FocusAgainConfirmationCancel}" Content="{DynamicResource FocusAgainConfirmationCancel}"/>
                            <Button x:Name="FocusAgainConfirmButton" Grid.Column="2" Style="{StaticResource FocusAgainConfirmationActionButton}"
                                    Background="{StaticResource FocusEndButtonBackground}" Foreground="{DynamicResource WhiteText}"
                                    BorderBrush="{DynamicResource TransparentBrush}" BorderThickness="0" IsDefault="True"
                                    Command="{Binding FocusAgainCommand}" AutomationProperties.Name="{DynamicResource FocusAgainConfirmationConfirm}"
                                    Content="{DynamicResource FocusAgainConfirmationConfirm}">
                                <Button.Effect><DropShadowEffect Color="{DynamicResource AccentShadowColor}" BlurRadius="12" Direction="270" Opacity="0.14" ShadowDepth="3"/></Button.Effect>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
