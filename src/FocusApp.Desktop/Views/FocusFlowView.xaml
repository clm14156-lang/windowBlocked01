<UserControl x:Class="FocusApp.Desktop.Views.FocusFlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             xmlns:local="clr-namespace:FocusApp.Desktop.Views"
             Background="{DynamicResource SurfacePrimary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:PositiveIntToVisibilityConverter x:Key="PositiveIntToVisibilityConverter" />
        <TranslateTransform x:Key="FocusFlowCenterShift" X="11" />

        <Style x:Key="FocusFlowPlainButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TargetTaskEditorStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="FocusTaskThinScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="5" />
            <Setter Property="MinWidth" Value="5" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="5" Background="{DynamicResource TransparentBrush}">
                            <Track x:Name="PART_Track"
                                   Margin="0,3,0,3"
                                   IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBody"
                                                        Width="3"
                                                        HorizontalAlignment="Center"
                                                        Background="#D1D1D6"
                                                        CornerRadius="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#C7C7CC" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#AEAEB2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusFlowOutlineButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusFlowAccentButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FocusFlowOutlineButton}">
            <Setter Property="Background" Value="{DynamicResource FocusButtonBackground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource FocusButtonHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource FocusButtonPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusNoTargetReturnHomeButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FocusFlowOutlineButton}">
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusNoTaskEndButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#1E2228" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="NoTaskEndButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="21">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NoTaskEndButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NoTaskEndButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsForcedModeActive}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FocusEndConfirmationAccentButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource FocusFlowAccentButton}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource FocusButtonHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource FocusButtonPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusEndConfirmationSecondaryButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="#F4F4F6" />
            <Setter Property="BorderBrush" Value="#E4E5E9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FocusCompletionDetails">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock HorizontalAlignment="Center"
                           FontSize="14"
                           Foreground="{DynamicResource TextWeak}"
                           Text="{DynamicResource FocusCompletionPraise}" />
                <TextBlock Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="{DynamicResource FocusCompletedTitle}" />
                <TextBlock Margin="0,3,0,0"
                           HorizontalAlignment="Center"
                           FontFamily="{DynamicResource FontFamilyNumeric}"
                           Foreground="{DynamicResource AccentPrimary}">
                    <Run FontSize="68" FontWeight="SemiBold" Text="{Binding CompletedDurationMinutes, Mode=OneWay}" />
                    <Run FontFamily="{DynamicResource FontFamilyPrimary}"
                         FontSize="20"
                         FontWeight="Medium"
                         Foreground="{DynamicResource TextPrimary}"
                         Text="{DynamicResource FocusCompletionMinutesUnit}" />
                </TextBlock>

                <Grid Width="420" Height="66" Margin="0,18,0,0" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="#EAE7E3" BorderThickness="0,0,1,0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                            <views:SvgIcon Width="22" Height="22" Margin="0,0,10,0"
                                           Source="/FocusApp.Desktop;component/Assets/Icons/Common/statistics.svg" />
                            <StackPanel>
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource FocusTodayTotalShort}" />
                                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}">
                                    <Run Text="{Binding TodayTotalMinutes, Mode=OneWay}" /><Run Text=" " /><Run Text="{DynamicResource FocusCompletionMinutesUnit}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" BorderBrush="#EAE7E3" BorderThickness="0,0,1,0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                            <views:SvgIcon Width="22" Height="22" Margin="0,0,10,0"
                                           Source="/FocusApp.Desktop;component/Assets/Icons/Common/time.svg" />
                            <StackPanel>
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource FocusSessionCountLabel}" />
                                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}">
                                    <Run Text="{Binding TodayFocusCount, Mode=OneWay}" /><Run Text=" " /><Run Text="{DynamicResource FocusCompletionTimesUnit}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                        <views:SvgIcon Width="22" Height="22" Margin="0,0,10,0"
                                       Source="/FocusApp.Desktop;component/Assets/Icons/Common/checkbox.svg" />
                        <StackPanel>
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource FocusCompletedTasksLabel}" />
                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}">
                                <Run Text="{Binding SessionCompletedTaskCount, Mode=OneWay}" /><Run Text=" " /><Run Text="{DynamicResource FocusCompletionItemCountSuffix}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,35,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button Width="172" Height="48"
                            AutomationProperties.Name="{DynamicResource FocusAgain}"
                            Background="{DynamicResource SurfacePrimary}"
                            BorderBrush="{DynamicResource BorderPrimary}"
                            BorderThickness="1"
                            Command="{Binding RequestFocusAgainCommand}"
                            FontSize="13" FontWeight="Medium"
                            Style="{StaticResource FocusFlowOutlineButton}">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <views:SvgIcon Width="18" Height="18" Margin="0,0,9,0"
                                           Source="/FocusApp.Desktop;component/Assets/Icons/Common/reset.svg" />
                            <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource FocusAgainShort}" />
                        </StackPanel>
                    </Button>
                    <Button Width="172" Height="48" Margin="20,0,0,0"
                            AutomationProperties.Name="{DynamicResource FocusReturnHome}"
                            Command="{Binding ReturnHomeCommand}"
                            Style="{StaticResource FocusNoTargetReturnHomeButton}">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <views:SvgIcon Width="18" Height="18" Margin="0,0,9,0"
                                           FillOverride="White"
                                           Source="/FocusApp.Desktop;component/Assets/Icons/Common/home.svg" />
                            <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource WhiteText}" Text="{DynamicResource FocusReturnHome}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfacePrimary}">
        <Image x:Name="NoTaskFocusBackground"
               Panel.ZIndex="-1"
               IsHitTestVisible="False"
               Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/foucus_background.png"
               Stretch="UniformToFill">
            <Image.Style>
                <Style TargetType="{x:Type Image}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsFocusing}" Value="True" />
                                <Condition Binding="{Binding HasTarget}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>
        <Grid Height="48"
              VerticalAlignment="Top"
              Background="{DynamicResource SurfacePrimary}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Margin="0,4,8,4" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button AutomationProperties.Name="{DynamicResource HomeMinimizeButton}"
                        Click="MinimizeButton_Click"
                        Style="{DynamicResource WindowChromeButtonStyle}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE921;" />
                </Button>
                <Button AutomationProperties.Name="{DynamicResource HomeCloseButton}"
                        Click="CloseButton_Click"
                        Style="{DynamicResource WindowChromeButtonStyle}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE8BB;" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="TargetFocusingView"
              Margin="0,48,0,0"
              MouseDown="TargetMode_MouseDown">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsFocusing}" Value="True" />
                                <Condition Binding="{Binding HasTarget}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid>
                <Image IsHitTestVisible="False"
                       Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/foucus_background.png"
                       Stretch="UniformToFill" />

                <Grid RenderTransform="{StaticResource FocusFlowCenterShift}">
                    <TextBlock Margin="0,56,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               FontSize="28"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextPrimary}"
                               Text="{Binding PendingTasks[0].Name, Mode=OneWay}" />

                    <Grid Width="290"
                          Height="290"
                          Margin="0,118,0,0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top">
                        <views:CircularProgressRing Progress="{Binding RemainingProgress, Mode=OneWay}"
                                                    ProgressBrush="{DynamicResource AccentPrimary}"
                                                    ProgressEndPointDiameter="5"
                                                    RingThickness="2"
                                                    TrackBrush="#EEE8DE" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center"
                                        FontFamily="/FocusApp.Desktop;component/Assets/font/#Source Han Serif CN"
                                        FontSize="68"
                                        FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Text="{Binding RemainingTimeDisplay}" />
                            <StackPanel Margin="0,3,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                <Image Width="24"
                                       Height="24"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       SnapsToDevicePixels="True"
                                       Source="{Binding ActiveTarget.IconSource, Mode=OneWay, Converter={x:Static views:TargetIconSourceConverter.Instance}}"
                                       Stretch="Uniform" />
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="17"
                                           Foreground="{DynamicResource TextPrimary}"
                                           Text="{Binding TargetName, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,476,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               FontFamily="/FocusApp.Desktop;component/Assets/font/#Source Han Serif CN"
                               FontSize="24"
                               FontWeight="Light"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="{DynamicResource FocusNoTaskAtmosphere}" />

                    <Image Width="44"
                           Height="8.4"
                           Margin="0,517,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           IsHitTestVisible="False"
                           Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/focusPage_OrangeLine.png"
                           Stretch="Uniform" />

                    <Grid Width="350"
                          Height="45"
                          Margin="0,555,0,0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="165" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Button Height="45"
                                     Background="#FCF8F1"
                                     BorderBrush="#E7D9CE"
                                     BorderThickness="1"
                                     Command="{Binding RequestEndCommand}"
                                     FontSize="13"
                                     FontWeight="Medium"
                                     Foreground="#9D9690">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource FocusFlowOutlineButton}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsForcedModeActive}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="#9D9690"
                                           Text="{DynamicResource FocusEndAction}" />
                            </Button>
                            <Button Height="45"
                                    Padding="10,0"
                                    AutomationProperties.Name="{DynamicResource FocusForcedEndUnavailable}"
                                    Background="{DynamicResource FocusForcedEndDisabledBackground}"
                                    BorderBrush="{DynamicResource BorderPrimary}"
                                    BorderThickness="1"
                                    Cursor="Arrow"
                                    Focusable="False"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource DisabledText}"
                                    IsEnabled="False"
                                    IsHitTestVisible="False">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsForcedModeActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="20">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Margin="0,0,7,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Text="&#xE83D;" />
                                    <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Text="{DynamicResource FocusForcedEndUnavailable}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Button Grid.Column="2"
                                Height="45"
                                Background="#FBF2E6"
                                BorderBrush="#E7D9CE"
                                BorderThickness="1"
                                Click="ViewTasksButton_Click"
                                Foreground="#353535"
                                FontSize="13"
                                FontWeight="Normal"
                                Style="{StaticResource FocusFlowOutlineButton}">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <Image Width="15"
                                       Height="15"
                                       Margin="0,0,9,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/renwugaunli.png"
                                       Stretch="Uniform" />
                                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Normal" Foreground="#353535">
                                    <Run Text="{DynamicResource FocusViewTasks}" /><Run Text="（" /><Run Text="{Binding PendingTaskCount, Mode=OneWay}" /><Run Text="）" />
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

            </Grid>

        </Grid>

        <Grid x:Name="NoTaskFocusingView">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsFocusing}" Value="True" />
                                <Condition Binding="{Binding HasTarget}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid RenderTransform="{StaticResource FocusFlowCenterShift}">
                <Grid Width="290"
                      Height="290"
                      Margin="0,163,0,0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top">
                    <views:CircularProgressRing Progress="{Binding RemainingProgress, Mode=OneWay}"
                                                ProgressBrush="{DynamicResource AccentPrimary}"
                                                ProgressEndPointDiameter="8"
                                                RingThickness="8"
                                                TrackBrush="#E8E8ED" />
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="68"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"
                               Text="{Binding RemainingTimeDisplay}" />
                </Grid>

                <Grid Width="290" Height="45" Margin="0,552,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Button Width="165"
                            Height="45"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="{DynamicResource FocusEndAction}"
                            Command="{Binding RequestEndCommand}"
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="#1E2228"
                            Background="{DynamicResource TransparentBrush}"
                            BorderThickness="0"
                            Style="{StaticResource FocusNoTaskEndButton}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="13" Height="13" Margin="0,0,10,0"
                                    VerticalAlignment="Center" Background="#1E2228" CornerRadius="2" />
                            <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="Medium"
                                       Foreground="#1E2228" Text="{DynamicResource FocusEndAction}" />
                        </StackPanel>
                    </Button>
                    <Border Height="42" Padding="12,0" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource TransparentBrush}" CornerRadius="8" IsHitTestVisible="False">
                        <Border.Style><Style TargetType="{x:Type Border}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsForcedModeActive}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource TextSecondary}" Text="&#xE83D;" /><TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource FocusForcedModeStatus}" /></StackPanel>
                    </Border>
                </Grid>

                <StackPanel Margin="0,628,0,0"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Orientation="Horizontal">
                    <Border Width="26" Height="1" Margin="0,0,12,0"
                            VerticalAlignment="Center" Background="#D8DADF" />
                    <TextBlock FontSize="12" FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="{DynamicResource FocusNoTaskAtmosphere}" />
                    <Border Width="26" Height="1" Margin="12,0,0,0"
                            VerticalAlignment="Center" Background="#D8DADF" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="TargetCompletionView" Margin="0,48,0,0">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsCompleted}" Value="True" />
                                <Condition Binding="{Binding HasTarget}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Image x:Name="TargetCompletionBackground"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   IsHitTestVisible="False"
                   Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/foucus_background.png"
                   Stretch="UniformToFill" />

            <StackPanel Margin="0,34,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Image x:Name="TargetCompletionRibbon"
                       Width="450" Height="162"
                       HorizontalAlignment="Center"
                       IsHitTestVisible="False"
                       Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/foucusOntheEnd_ribbon.png"
                       Stretch="Uniform" />
                <ContentControl Margin="0,-4,0,0"
                                Content="{Binding}"
                                ContentTemplate="{StaticResource FocusCompletionDetails}" />
            </StackPanel>
        </Grid>
        <Grid x:Name="NoTargetCompletionView" Margin="0,48,0,0">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsCompleted}" Value="True" />
                                <Condition Binding="{Binding HasTarget}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Image x:Name="NoTargetCompletionBackground"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   IsHitTestVisible="False"
                   Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/foucus_background.png"
                   Stretch="UniformToFill" />

            <StackPanel Margin="0,80,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Image x:Name="NoTargetCompletionRibbon"
                       Width="430" Height="156"
                       HorizontalAlignment="Center"
                       IsHitTestVisible="False"
                       Source="/FocusApp.Desktop;component/Assets/Images/Illustrations/foucusOntheEnd_ribbon.png"
                       Stretch="Uniform" />
                <ContentControl Margin="0,-20,0,0"
                                Content="{Binding}"
                                ContentTemplate="{StaticResource FocusCompletionDetails}" />
            </StackPanel>
        </Grid>
        <Grid Panel.ZIndex="10">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEndConfirmationOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="{DynamicResource ModalScrim}" />
            <Border x:Name="FocusEndConfirmationDialog"
                    Width="360"
                    Height="225"
                    Background="{DynamicResource SurfacePrimary}"
                    BorderBrush="{DynamicResource OverlayBorder}"
                    BorderThickness="1"
                    CornerRadius="20"
                    TextElement.FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI">
                <Border.Effect><DropShadowEffect BlurRadius="16" Direction="270" Opacity="0.10" ShadowDepth="3" /></Border.Effect>
                <Grid Margin="23,21,23,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="44" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="FocusEndTitle" Grid.Row="0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               Text="{DynamicResource FocusEndNormalTitle}" />

                    <Grid x:Name="FocusEndTimeRegion" Grid.Row="2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,5,0" Text="{DynamicResource FocusElapsedPrefix}"/>
                            <TextBlock x:Name="FocusEndElapsedValue" VerticalAlignment="Center" Text="{Binding EndConfirmationElapsedDisplay, Mode=OneWay}" Foreground="{DynamicResource AccentPrimary}" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource FocusEndMinimumTimeLabel}"/>
                    </Grid>
                    <ProgressBar x:Name="FocusEndProgress" Grid.Row="4" Height="6" Minimum="0" Maximum="1" Value="{Binding EndConfirmationProgress, Mode=OneWay}"
                                 Background="#EDEEF1" Foreground="{DynamicResource AccentPrimary}" BorderThickness="0" AutomationProperties.Name="五分钟专注进度">
                        <ProgressBar.Template><ControlTemplate TargetType="ProgressBar">
                            <Grid x:Name="PART_Track">
                                <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                            </Grid>
                        </ControlTemplate></ProgressBar.Template>
                    </ProgressBar>
                    <Border x:Name="FocusEndStatusRegion" Grid.Row="6" Height="44" Background="#FFF4ED" CornerRadius="8" Padding="12,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid x:Name="FocusEndWarningIcon" Width="18" Height="18" VerticalAlignment="Center" Visibility="{Binding IsShortEndConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Ellipse Fill="{DynamicResource AccentPrimary}"/>
                                <Path Data="M 9,4 L 9,10" Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Ellipse Width="1.8" Height="1.8" Fill="White" Margin="0,11,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"/>
                            </Grid>
                            <Path x:Name="FocusEndThumbsUpIcon" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Fill="{DynamicResource AccentPrimary}"
                                  Data="M 2,21 L 6,21 L 6,9 L 2,9 Z M 22,10 C 22,8.9 21.1,8 20,8 L 13.7,8 L 14.65,3.43 C 14.67,3.33 14.68,3.22 14.68,3.11 C 14.68,2.7 14.51,2.32 14.24,2.05 L 13.17,1 L 6.59,7.59 C 6.22,7.95 6,8.45 6,9 L 6,19 C 6,20.1 6.9,21 8,21 L 17,21 C 17.83,21 18.54,20.5 18.84,19.78 L 21.86,12.73 C 21.95,12.5 22,12.26 22,12 Z"
                                  Visibility="{Binding IsNormalEndConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock x:Name="FocusEndWarningText" Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                       Visibility="{Binding IsShortEndConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Run Text="{DynamicResource FocusEndShortDescriptionPrefix}"/><Run Text="{DynamicResource FocusEndShortDescriptionEmphasis}" Foreground="{DynamicResource AccentPrimary}" FontWeight="SemiBold"/><Run Text="{DynamicResource FocusEndShortDescriptionSuffix}"/>
                            </TextBlock>
                            <TextBlock x:Name="FocusEndEncouragementText" Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                       Visibility="{Binding IsNormalEndConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Run Text="{DynamicResource FocusEndEncouragementPrefix}"/><Run Text="{DynamicResource FocusEndEncouragementEmphasis}" Foreground="{DynamicResource AccentPrimary}" FontWeight="SemiBold"/><Run Text="{DynamicResource FocusEndEncouragementSuffix}"/>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Grid x:Name="FocusEndActionRegion" Grid.Row="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="FocusEndConfirmationButton"
                                Grid.Column="0"
                                Height="40"
                                AutomationProperties.Name="{DynamicResource FocusConfirmEndAction}"
                                Command="{Binding EndConfirmedFocusCommand}"
                                Style="{StaticResource FocusEndConfirmationSecondaryButton}">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"
                                       Text="{DynamicResource FocusConfirmEndAction}" />
                        </Button>
                        <Button x:Name="FocusContinueConfirmationButton"
                                Grid.Column="2"
                                Height="40"
                                AutomationProperties.Name="{DynamicResource FocusContinueAction}"
                                Command="{Binding ContinueFocusCommand}"
                                Background="{DynamicResource AccentPrimary}"
                                BorderThickness="0"
                                Style="{StaticResource FocusEndConfirmationAccentButton}">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource WhiteText}"
                                       Text="{DynamicResource FocusContinueAction}" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid Panel.ZIndex="11">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFocusAgainConfirmationOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="{DynamicResource ModalScrim}" />
            <Border x:Name="FocusAgainConfirmationDialog"
                    Width="300"
                    Height="220"
                    Background="{DynamicResource SurfacePrimary}"
                    BorderBrush="{DynamicResource OverlayBorder}"
                    BorderThickness="1"
                    CornerRadius="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      Direction="270"
                                      Opacity="0.12"
                                      ShadowDepth="4" />
                </Border.Effect>
                <Grid Margin="24,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54" />
                        <RowDefinition Height="44" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>
                    <Border Width="54"
                            Height="54"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource AccentTint}"
                            CornerRadius="27">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource FontFamilyPrimary}"
                                   FontSize="32"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource AccentPrimary}"
                                   Text="?" />
                    </Border>
                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               Text="{Binding FocusAgainConfirmationTitle, Mode=OneWay}" />
                    <TextBlock Grid.Row="2"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="{DynamicResource FocusAgainConfirmationDescription}" />
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Height="42"
                                AutomationProperties.Name="{DynamicResource FocusAgainConfirmationCancel}"
                                Background="{DynamicResource SurfacePrimary}"
                                BorderBrush="{DynamicResource BorderPrimary}"
                                BorderThickness="1"
                                Command="{Binding CancelFocusAgainCommand}"
                                Style="{StaticResource FocusFlowOutlineButton}">
                            <TextBlock FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Text="{DynamicResource FocusAgainConfirmationCancel}" />
                        </Button>
                        <Button Grid.Column="2"
                                Height="42"
                                AutomationProperties.Name="{DynamicResource FocusAgainConfirmationConfirm}"
                                Background="{DynamicResource AccentPrimary}"
                                BorderThickness="0"
                                Command="{Binding FocusAgainCommand}"
                                Style="{StaticResource FocusFlowAccentButton}">
                            <TextBlock FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource WhiteText}"
                                       Text="{DynamicResource FocusAgainConfirmationConfirm}" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
