<UserControl x:Class="FocusApp.Desktop.Views.FocusFlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             xmlns:local="clr-namespace:FocusApp.Desktop.Views"
             Background="{DynamicResource SurfacePrimary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:PositiveIntToVisibilityConverter x:Key="PositiveIntToVisibilityConverter" />
        <TranslateTransform x:Key="FocusFlowCenterShift" X="11" />

        <Style x:Key="FocusFlowPlainButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TargetTaskEditorStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="FocusTaskThinScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="5" />
            <Setter Property="MinWidth" Value="5" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="5" Background="{DynamicResource TransparentBrush}">
                            <Track x:Name="PART_Track"
                                   Margin="0,3,0,3"
                                   IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBody"
                                                        Width="3"
                                                        HorizontalAlignment="Center"
                                                        Background="#D1D1D6"
                                                        CornerRadius="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#C7C7CC" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#AEAEB2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusFlowOutlineButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusCompletedTasksButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FocusFlowOutlineButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter Margin="5,0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusFlowAccentButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FocusFlowOutlineButton}">
            <Setter Property="Background" Value="{DynamicResource FocusButtonBackground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource FocusButtonHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource FocusButtonPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusNoTargetReturnHomeButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FocusFlowOutlineButton}">
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusNoTaskEndButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderBrush" Value="#E9E2D9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource FocusNoTaskEndButtonText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="NoTaskEndButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="21">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NoTaskEndButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NoTaskEndButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsForcedModeActive}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FocusEndConfirmationAccentButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource FocusFlowAccentButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource FocusButtonHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource FocusButtonPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfacePrimary}">
        <Image x:Name="NoTaskFocusBackground"
               Panel.ZIndex="-1"
               IsHitTestVisible="False"
               Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/foucus_background.png"
               Stretch="UniformToFill">
            <Image.Style>
                <Style TargetType="{x:Type Image}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsFocusing}" Value="True" />
                                <Condition Binding="{Binding HasTarget}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>
        <Grid Height="48"
              VerticalAlignment="Top"
              Background="{DynamicResource SurfacePrimary}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Margin="0,4,8,4" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button AutomationProperties.Name="{DynamicResource HomeMinimizeButton}"
                        Click="MinimizeButton_Click"
                        Style="{StaticResource WindowChromeButtonStyle}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE921;" />
                </Button>
                <Button AutomationProperties.Name="{DynamicResource HomeCloseButton}"
                        Click="CloseButton_Click"
                        Style="{StaticResource WindowChromeButtonStyle}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE8BB;" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="TargetFocusingView"
              Margin="0,48,0,0"
              MouseDown="TargetMode_MouseDown">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsFocusing}" Value="True" />
                                <Condition Binding="{Binding HasTarget}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid>
                <Image IsHitTestVisible="False"
                       Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/foucus_background.png"
                       Stretch="UniformToFill" />

                <Grid RenderTransform="{StaticResource FocusFlowCenterShift}">
                    <TextBlock Margin="0,56,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               FontSize="28"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextPrimary}"
                               Text="{Binding PendingTasks[0].Name, Mode=OneWay}" />

                    <Grid Width="290"
                          Height="290"
                          Margin="0,118,0,0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top">
                        <views:CircularProgressRing Progress="{Binding RemainingProgress, Mode=OneWay}"
                                                    ProgressBrush="{DynamicResource AccentPrimary}"
                                                    ProgressEndPointDiameter="5"
                                                    RingThickness="2"
                                                    TrackBrush="#EEE8DE" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center"
                                       FontFamily="{DynamicResource FontFamilyNumeric}"
                                       FontSize="68"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Text="{Binding RemainingTimeDisplay}" />
                            <StackPanel Margin="0,3,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                <Image Width="24"
                                       Height="24"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/mubiao.png"
                                       Stretch="Uniform" />
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="17"
                                           Foreground="{DynamicResource TextPrimary}"
                                           Text="{Binding TargetName, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,476,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               FontFamily="/FocusApp.Desktop;component/Assets/font/#Source Han Serif CN"
                               FontSize="24"
                               FontWeight="Light"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="{DynamicResource FocusNoTaskAtmosphere}" />

                    <Image Width="44"
                           Height="8.4"
                           Margin="0,517,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           IsHitTestVisible="False"
                           Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/focusPage_OrangeLine.png"
                           Stretch="Uniform" />

                    <Grid Width="350"
                          Height="45"
                          Margin="0,555,0,0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="165" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Button Height="45"
                                     Background="#FCF8F1"
                                     BorderBrush="#E7D9CE"
                                     BorderThickness="1"
                                     Command="{Binding RequestEndCommand}"
                                     FontSize="13"
                                     FontWeight="Medium"
                                     Foreground="#9D9690">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource FocusFlowOutlineButton}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsForcedModeActive}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="#9D9690"
                                           Text="{DynamicResource FocusEndAction}" />
                            </Button>
                            <Border Height="42"
                                    Padding="10,0"
                                    Background="{DynamicResource ControlHoverBackground}"
                                    CornerRadius="14"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsForcedModeActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TextSecondary}" Text="&#xE83D;" />
                                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource FocusForcedModeStatus}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Button Grid.Column="2"
                                Height="45"
                                Background="#FBF2E6"
                                BorderBrush="#E7D9CE"
                                BorderThickness="1"
                                Click="ViewTasksButton_Click"
                                Foreground="#151B23"
                                FontSize="13"
                                FontWeight="Medium"
                                Style="{StaticResource FocusFlowOutlineButton}">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <Image Width="15"
                                       Height="15"
                                       Margin="0,0,9,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/renwugaunli.png"
                                       Stretch="Uniform" />
                                <TextBlock VerticalAlignment="Center" FontWeight="Medium" Foreground="#151B23" Text="{DynamicResource FocusViewTasks}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <views:FocusTaskWindow x:Name="TaskPopupView"
                                       Width="290"
                                       Height="420"
                                       Margin="0,105,20,0"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Panel.ZIndex="20"
                                       Visibility="Collapsed" />
            </Grid>

        </Grid>

        <Grid x:Name="NoTaskFocusingView">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsFocusing}" Value="True" />
                                <Condition Binding="{Binding HasTarget}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid RenderTransform="{StaticResource FocusFlowCenterShift}">
                <Grid Width="290"
                      Height="290"
                      Margin="0,163,0,0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top">
                    <views:CircularProgressRing Progress="{Binding RemainingProgress, Mode=OneWay}"
                                                ProgressBrush="{DynamicResource AccentPrimary}"
                                                ProgressEndPointDiameter="5"
                                                RingThickness="2"
                                                TrackBrush="#EEE8DE" />
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource FontFamilyNumeric}"
                               FontSize="68"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextPrimary}"
                               Text="{Binding RemainingTimeDisplay}" />
                </Grid>

                <TextBlock Margin="0,520,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           FontFamily="/FocusApp.Desktop;component/Assets/font/#Source Han Serif CN"
                           FontSize="24"
                           LineHeight="24"
                           FontWeight="Light"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="{DynamicResource FocusNoTaskAtmosphere}" />

                <Image Width="44"
                       Height="8.4"
                       Margin="0,556,0,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       IsHitTestVisible="False"
                       Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/focusPage_OrangeLine.png"
                       Stretch="Uniform" />

                <Grid Width="290" Height="45" Margin="0,606,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Button Width="165"
                            Height="45"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="{DynamicResource FocusEndAction}"
                            Command="{Binding RequestEndCommand}"
                            FontSize="13"
                            FontWeight="Medium"
                            Foreground="{DynamicResource FocusNoTaskEndButtonText}"
                            Background="{DynamicResource TransparentBrush}"
                            BorderBrush="#E9E2D9"
                            BorderThickness="1"
                            Style="{StaticResource FocusNoTaskEndButton}">
                        <TextBlock Foreground="{DynamicResource FocusNoTaskEndButtonText}"
                                   Text="{DynamicResource FocusEndAction}" />
                    </Button>
                    <Border Height="42" Padding="12,0" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource ControlHoverBackground}" CornerRadius="8" IsHitTestVisible="False">
                        <Border.Style><Style TargetType="{x:Type Border}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsForcedModeActive}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource TextSecondary}" Text="&#xE83D;" /><TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource FocusForcedModeStatus}" /></StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="TargetCompletionView" Margin="0,48,0,0">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsCompleted}" Value="True" />
                                <Condition Binding="{Binding HasTarget}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Image x:Name="TargetCompletionBackground"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   IsHitTestVisible="False"
                   Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/foucus_background.png"
                   Stretch="UniformToFill" />

            <StackPanel Margin="0,34,0,24" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Image x:Name="TargetCompletionRibbon"
                       Width="450"
                       Height="162"
                       HorizontalAlignment="Center"
                       IsHitTestVisible="False"
                       Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/foucusOntheEnd_ribbon.png"
                       Stretch="Uniform" />

                <TextBlock Margin="0,2,0,0"
                           HorizontalAlignment="Center"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="{DynamicResource FocusCompletedTitle}" />

                <TextBlock Margin="0,2,0,0"
                           HorizontalAlignment="Center"
                           FontFamily="{DynamicResource FontFamilyNumeric}"
                           Foreground="{DynamicResource AccentPrimary}">
                    <Run FontSize="68" FontWeight="SemiBold" Text="{Binding CompletedDurationMinutes, Mode=OneWay}" />
                    <Run FontFamily="{DynamicResource FontFamilyPrimary}"
                         FontSize="20"
                         FontWeight="Medium"
                         Foreground="{DynamicResource TextPrimary}"
                         Text="{DynamicResource FocusCompletionMinutesUnit}" />
                </TextBlock>

                <Border Width="280"
                        Height="38"
                        Margin="0,16,0,0"
                        Background="{DynamicResource TransparentBrush}"
                        CornerRadius="19">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="&#xE823;" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondary}">
                            <Run Text="{DynamicResource FocusTodayTotal}" />
                            <Run Text=" " />
                            <Run Text="{Binding TodayTotalMinutes, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{DynamicResource FocusCompletionMinutesUnit}" />
                            <Run Foreground="{DynamicResource AccentPrimary}" Text="  ·  " />
                            <Run Text="{Binding TodayFocusCount, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{DynamicResource FocusCompletionSessionCountSuffix}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Grid Width="280" Height="44" Margin="0,12,0,0" HorizontalAlignment="Center" Panel.ZIndex="1">
                    <Button Panel.ZIndex="1"
                            Height="44"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="{DynamicResource FocusSessionCompletedTitle}"
                            Background="{DynamicResource TransparentBrush}"
                            BorderBrush="{DynamicResource BorderPrimary}"
                            BorderThickness="1"
                            Command="{Binding ToggleCompletedTasksCommand}"
                            IsEnabled="{Binding CanExpandCompletedTasks}"
                            Padding="14,0"
                            Style="{StaticResource FocusCompletedTasksButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0"
                                   Width="18"
                                   Height="18"
                                   Margin="10,0,8,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/gouxuan.png"
                                   Stretch="Uniform" />
                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}">
                                <Run Text="{DynamicResource FocusCompletedTaskSummaryPrefix}" />
                                <Run Text="{Binding SessionCompletedTaskCount, Mode=OneWay}" />
                                <Run Text="{DynamicResource FocusCompletedTaskSummarySuffix}" />
                            </TextBlock>
                            <Image Grid.Column="2"
                                   Width="14"
                                   Height="14"
                                   Margin="8,0,6,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5"
                                   Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/zhankai.png"
                                   Stretch="Uniform">
                                <Image.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Image.RenderTransform>
                                <Image.Style>
                                    <Style TargetType="{x:Type Image}">
                                        <Setter Property="Opacity" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanExpandCompletedTasks}" Value="False">
                                                <Setter Property="Opacity" Value="0.35" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCompletedTasksExpanded}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             To="90"
                                                                             Duration="0:0:0.14">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <SineEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             To="0"
                                                                             Duration="0:0:0.14">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <SineEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Grid>
                    </Button>
                    <Canvas Panel.ZIndex="5"
                            Width="280"
                            Height="44"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                        <Border x:Name="SessionCompletedTasksPopup"
                            Canvas.Top="52"
                            Width="280"
                            MaxHeight="156"
                            Padding="14,8"
                            Background="{DynamicResource SurfacePrimary}"
                            BorderBrush="{DynamicResource BorderPrimary}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Panel.ZIndex="5"
                            Visibility="{Binding IsCompletedTasksExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" Opacity="0.10" ShadowDepth="3" />
                        </Border.Effect>
                        <ScrollViewer x:Name="SessionCompletedTasksScrollViewer"
                                      MaxHeight="136"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource FocusTaskThinScrollBarStyle}" />
                            </ScrollViewer.Resources>
                            <ItemsControl ItemsSource="{Binding SessionCompletedTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="36">
                                            <Ellipse Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource SuccessBright}" />
                                            <TextBlock Margin="3,0,0,0"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource WhiteText}"
                                                       Text="&#xE73E;" />
                                            <TextBlock Margin="30,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="13"
                                                       FontWeight="Normal"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       Text="{Binding Name}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        </Border>
                    </Canvas>
                </Grid>

                <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button Width="172"
                            Height="48"
                            AutomationProperties.Name="{DynamicResource FocusAgain}"
                            Background="{DynamicResource TransparentBrush}"
                            BorderBrush="{DynamicResource BorderPrimary}"
                            BorderThickness="1"
                            Command="{Binding RequestFocusAgainCommand}"
                            FontSize="13"
                            FontWeight="Medium"
                            Style="{StaticResource FocusFlowOutlineButton}">
                        <TextBlock FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="{DynamicResource FocusAgainShort}" />
                    </Button>
                    <Button Width="172"
                            Height="48"
                            Margin="20,0,0,0"
                            AutomationProperties.Name="{DynamicResource FocusReturnHome}"
                            Command="{Binding ReturnHomeCommand}"
                            Style="{StaticResource FocusNoTargetReturnHomeButton}">
                        <TextBlock FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource WhiteText}"
                                   Text="{DynamicResource FocusReturnHome}" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid x:Name="NoTargetCompletionView" Margin="0,48,0,0">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsCompleted}" Value="True" />
                                <Condition Binding="{Binding HasTarget}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Image x:Name="NoTargetCompletionBackground"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   IsHitTestVisible="False"
                   Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/foucus_background.png"
                   Stretch="UniformToFill" />

            <StackPanel Margin="0,80,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Image x:Name="NoTargetCompletionRibbon"
                       Width="430"
                       Height="156"
                       HorizontalAlignment="Center"
                       IsHitTestVisible="False"
                       Source="/FocusApp.Desktop;component/Assets/Images/Illustrations/foucusOntheEnd_ribbon.png"
                       Stretch="Uniform" />

                <TextBlock x:Name="NoTargetCompletionTitle"
                           Margin="0,-22,0,0"
                           HorizontalAlignment="Center"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="{DynamicResource FocusCompletedTitle}" />

                <TextBlock Margin="0,0,0,0"
                           HorizontalAlignment="Center"
                           FontFamily="{DynamicResource FontFamilyNumeric}"
                           Foreground="{DynamicResource AccentPrimary}">
                    <Run FontSize="68"
                         FontWeight="SemiBold"
                         Text="{Binding CompletedDurationMinutes, Mode=OneWay}" />
                    <Run FontFamily="{DynamicResource FontFamilyPrimary}"
                         FontSize="20"
                         FontWeight="Medium"
                         Foreground="{DynamicResource TextPrimary}"
                         Text="{DynamicResource FocusCompletionMinutesUnit}" />
                </TextBlock>

                <Border x:Name="NoTargetCompletionSummary"
                        Width="280"
                        Height="38"
                        Margin="0,18,0,0"
                        Background="{DynamicResource TransparentBrush}"
                        CornerRadius="10">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{DynamicResource TextWeak}"
                                   Text="&#xE823;" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource TextSecondary}">
                            <Run Text="{DynamicResource FocusTodayTotal}" />
                            <Run Text=" " />
                            <Run Text="{Binding TodayTotalMinutes, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{DynamicResource FocusCompletionMinutesUnit}" />
                            <Run Foreground="{DynamicResource AccentPrimary}" Text="  ·  " />
                            <Run Text="{Binding TodayFocusCount, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{DynamicResource FocusCompletionSessionCountSuffix}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,38,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Width="172"
                            Height="48"
                            AutomationProperties.Name="{DynamicResource FocusAgain}"
                            Background="{DynamicResource TransparentBrush}"
                            BorderBrush="{DynamicResource BorderPrimary}"
                            BorderThickness="1"
                            Command="{Binding RequestFocusAgainCommand}"
                            FontSize="13"
                            FontWeight="Medium"
                            Style="{StaticResource FocusFlowOutlineButton}">
                        <TextBlock FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="{DynamicResource FocusAgainShort}" />
                    </Button>
                    <Button Width="172"
                            Height="48"
                            Margin="20,0,0,0"
                            AutomationProperties.Name="{DynamicResource FocusReturnHome}"
                            Command="{Binding ReturnHomeCommand}"
                            Style="{StaticResource FocusNoTargetReturnHomeButton}">
                        <TextBlock FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource WhiteText}"
                                   Text="{DynamicResource FocusReturnHome}" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Panel.ZIndex="10">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEndConfirmationOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="{DynamicResource ModalScrim}" />
            <Border x:Name="FocusEndConfirmationDialog"
                    Width="350"
                    Height="250"
                    Background="{DynamicResource SurfacePrimary}"
                    BorderBrush="{DynamicResource OverlayBorder}"
                    BorderThickness="1"
                    CornerRadius="20"
                    TextElement.FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI">
                <Border.Effect><DropShadowEffect BlurRadius="24" Direction="270" Opacity="0.16" ShadowDepth="6" /></Border.Effect>
                <Grid Margin="24,14,24,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="38" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>
                    <Image x:Name="FocusEndConfirmationClock"
                           Width="52"
                           Height="52"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/shizhong.png"
                           Stretch="Uniform" />
                    <TextBlock Grid.Row="2"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Text" Value="{DynamicResource FocusEndNormalTitle}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsShortEndConfirmation}" Value="True">
                                        <Setter Property="Text" Value="{DynamicResource FocusEndShortTitle}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource FocusElapsedPrefix}" />
                        <TextBlock x:Name="FocusEndElapsedValue" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" Text="{Binding ElapsedTimeDisplay}" />
                    </StackPanel>
                    <Grid Grid.Row="6">
                        <Border x:Name="FocusEndShortWarning"
                                Height="38"
                                Background="{DynamicResource AccentTint}"
                                CornerRadius="10"
                                Visibility="{Binding IsShortEndConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                <Image Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/gantanhao.png" Stretch="Uniform" />
                                <TextBlock x:Name="FocusEndDiscardHintText" VerticalAlignment="Center" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource AccentPrimary}" Text="{DynamicResource FocusEndDiscardHint}" />
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="FocusEndNormalStatus"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Visibility="{Binding IsNormalEndConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Image Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/gouxuan.png" Stretch="Uniform" />
                            <TextBlock x:Name="FocusEndSaveHintText" VerticalAlignment="Center" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource FocusEndNormalSaveHint}" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="8" VerticalAlignment="Bottom">
                        <Grid x:Name="FocusEndShortActions" Visibility="{Binding IsShortEndConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button x:Name="FocusDiscardConfirmationButton" Grid.Column="0" Height="42" AutomationProperties.Name="{DynamicResource FocusEndDiscardAction}" Command="{Binding DiscardEndCommand}" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" Style="{StaticResource FocusFlowOutlineButton}">
                                <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource FocusEndDiscardAction}" />
                            </Button>
                            <Button x:Name="FocusShortContinueConfirmationButton" Grid.Column="2" Height="42" AutomationProperties.Name="{DynamicResource FocusContinueAction}" Command="{Binding ContinueFocusCommand}" Background="{DynamicResource AccentPrimary}" BorderThickness="0" Style="{StaticResource FocusEndConfirmationAccentButton}">
                                <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource WhiteText}" Text="{DynamicResource FocusContinueAction}" />
                            </Button>
                        </Grid>
                        <Grid x:Name="FocusEndNormalActions" Visibility="{Binding IsNormalEndConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button x:Name="FocusContinueConfirmationButton" Grid.Column="0" Height="42" AutomationProperties.Name="{DynamicResource FocusContinueAction}" Command="{Binding ContinueFocusCommand}" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" Style="{StaticResource FocusFlowOutlineButton}">
                                <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource FocusContinueAction}" />
                            </Button>
                            <Button x:Name="FocusEndConfirmationButton" Grid.Column="2" Height="42" AutomationProperties.Name="{DynamicResource FocusConfirmEndAction}" Command="{Binding ConfirmEndCommand}" Background="{DynamicResource AccentPrimary}" BorderThickness="0" Style="{StaticResource FocusEndConfirmationAccentButton}">
                                <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource WhiteText}" Text="{DynamicResource FocusConfirmEndAction}" />
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Panel.ZIndex="11">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFocusAgainConfirmationOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="{DynamicResource ModalScrim}" />
            <Border x:Name="FocusAgainConfirmationDialog"
                    Width="300"
                    Height="220"
                    Background="{DynamicResource SurfacePrimary}"
                    BorderBrush="{DynamicResource OverlayBorder}"
                    BorderThickness="1"
                    CornerRadius="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      Direction="270"
                                      Opacity="0.12"
                                      ShadowDepth="4" />
                </Border.Effect>
                <Grid Margin="24,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54" />
                        <RowDefinition Height="44" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>
                    <Border Width="54"
                            Height="54"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource AccentTint}"
                            CornerRadius="27">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource FontFamilyPrimary}"
                                   FontSize="32"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource AccentPrimary}"
                                   Text="?" />
                    </Border>
                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               Text="{Binding FocusAgainConfirmationTitle, Mode=OneWay}" />
                    <TextBlock Grid.Row="2"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="{DynamicResource FocusAgainConfirmationDescription}" />
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Height="42"
                                AutomationProperties.Name="{DynamicResource FocusAgainConfirmationCancel}"
                                Background="{DynamicResource SurfacePrimary}"
                                BorderBrush="{DynamicResource BorderPrimary}"
                                BorderThickness="1"
                                Command="{Binding CancelFocusAgainCommand}"
                                Style="{StaticResource FocusFlowOutlineButton}">
                            <TextBlock FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Text="{DynamicResource FocusAgainConfirmationCancel}" />
                        </Button>
                        <Button Grid.Column="2"
                                Height="42"
                                AutomationProperties.Name="{DynamicResource FocusAgainConfirmationConfirm}"
                                Background="{DynamicResource AccentPrimary}"
                                BorderThickness="0"
                                Command="{Binding FocusAgainCommand}"
                                Style="{StaticResource FocusFlowAccentButton}">
                            <TextBlock FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource WhiteText}"
                                       Text="{DynamicResource FocusAgainConfirmationConfirm}" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
