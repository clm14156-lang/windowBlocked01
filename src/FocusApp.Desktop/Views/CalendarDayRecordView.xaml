<UserControl x:Class="FocusApp.Desktop.Views.CalendarDayRecordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             FontFamily="{DynamicResource FontFamilyPrimary}" UseLayoutRounding="True" Background="Transparent"
             ToolTipService.InitialShowDelay="180" ToolTipService.BetweenShowDelay="80" ToolTipService.ShowDuration="2147483647"
             ToolTipOpening="RecordHoverTip_Opening">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FocusApp.Desktop;component/Resources/CalendarTypography.xaml"/>
                <ResourceDictionary Source="/FocusApp.Desktop;component/Resources/PoptipStyles.xaml"/>
                <ResourceDictionary Source="/FocusApp.Desktop;component/Resources/StatisticsScrollStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
            <Style x:Key="TaskLinkStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource CalendarTextWeak}"/>
                <Setter Property="Padding" Value="3,0"/>
                <Setter Property="Cursor" Value="Arrow"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="MinHeight" Value="28"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F4F6F8"/><Setter Property="TextElement.Foreground" Value="{DynamicResource CalendarTextBody}"/></Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.ToolTip>
        <ToolTip x:Name="RecordHoverTip" Placement="Custom"
                 DataContext="{Binding PlacementTarget.DataContext.Record, RelativeSource={RelativeSource Self}}"
                 CustomPopupPlacementCallback="RecordHoverTip_Placement" Opened="RecordHoverTip_Opened" Closed="RecordHoverTip_Closed"
                 Padding="0" BorderThickness="0" Background="Transparent" HasDropShadow="False" IsHitTestVisible="False">
            <ToolTip.Template><ControlTemplate TargetType="ToolTip"><ContentPresenter /></ControlTemplate></ToolTip.Template>
            <views:CalendarRecordHoverToolTip x:Name="RecordHoverContent" />
        </ToolTip>
    </UserControl.ToolTip>
    <Grid Height="36" Margin="0,0,3,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="98"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border x:Name="TimelineSpine" Width="1" Background="#E6E8EB" IsHitTestVisible="False"/>
        <Border x:Name="FocusMarker" Width="9" Height="9" CornerRadius="4.5" VerticalAlignment="Center" IsHitTestVisible="False">
            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#19C463"/><Style.Triggers><DataTrigger Binding="{Binding IsInterrupted}" Value="True"><Setter Property="Background" Value="#FF861F"/></DataTrigger></Style.Triggers></Style></Border.Style>
        </Border>
        <TextBlock Style="{StaticResource CalendarRecordTextStyle}" x:Name="TimeRange" Grid.Column="1" Text="{Binding TimeRangeDisplay}"
                   FontFamily="{DynamicResource FontFamilyEnglish}" VerticalAlignment="Center"/>
        <TextBlock Style="{StaticResource CalendarBodyTextStyle}" x:Name="GoalName" Grid.Column="2" Text="{Binding Record.CalendarTitle}"
                   Foreground="{DynamicResource CalendarTextSecondary}" Margin="0,0,5,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <Border x:Name="TaskCountAnchor" Grid.Column="3" Style="{StaticResource TaskLinkStyle}"
                Visibility="{Binding HasTasks, Converter={StaticResource VisibleWhenTrue}}"
                MouseEnter="TaskCountAnchor_MouseEnter" MouseLeave="TaskPreview_MouseLeave"
                AutomationProperties.Name="{Binding TasksTitle}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="Summary" Text="{Binding TaskCountDisplay}" FontSize="12" FontWeight="Normal" Foreground="{Binding Path=(TextElement.Foreground), ElementName=TaskCountAnchor}"/>
                <Path x:Name="ExpandArrow" Width="5" Height="8" Margin="5,0,0,0" Data="M 0,0 L 4,4 L 0,8"
                      Stroke="{Binding Foreground, ElementName=Summary}" StrokeThickness="1.2" StrokeLineJoin="Round" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <Popup x:Name="TaskPopup" PlacementTarget="{Binding ElementName=TaskCountAnchor}" Placement="Custom"
               CustomPopupPlacementCallback="TaskPopup_Placement" AllowsTransparency="True" StaysOpen="True"
               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
               Opened="TaskPopup_Opened" Closed="TaskPopup_Closed">
            <views:PoptipChrome x:Name="TaskPoptipSurface" Width="240" Style="{StaticResource PoptipSurfaceStyle}" PointerOnTop="False" PointerLeft="196"
                                MouseEnter="TaskPreview_MouseEnter" MouseLeave="TaskPreview_MouseLeave">
                <ScrollViewer x:Name="TaskPreviewScroll" MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly">
                    <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource StatisticsThinScrollBarStyle}"/></ScrollViewer.Resources>
                    <ItemsControl x:Name="TaskPreviewItems" ItemsSource="{Binding PreviewTasks}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Grid x:Name="TaskRow" Height="30"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border x:Name="TaskCheck" Width="17" Height="17" CornerRadius="3" BorderBrush="{DynamicResource AccentPrimary}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentPrimary}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <Path Data="M 3,8 L 6,11 L 13,4" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Path.Style>
                                    </Path>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource CalendarBodyTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </views:PoptipChrome>
        </Popup>
    </Grid>
</UserControl>
