<UserControl x:Class="FocusApp.Desktop.Views.CalendarDayRecordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource FontFamilyPrimary}" UseLayoutRounding="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
    </UserControl.Resources>
    <Grid Margin="0,3,8,3">
        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border x:Name="TimelineSpine" Grid.RowSpan="2" Width="1.5" Background="#E3E7EC" Margin="0,-3,0,-3" IsHitTestVisible="False"/>
        <!-- Overlap the rounded ends so short-gap records form one continuous focus bar. -->
        <Border x:Name="ContinuousIncomingLine" Width="6" Height="8" Background="{DynamicResource AccentPrimary}" Margin="0,-3,0,0" VerticalAlignment="Top"
                IsHitTestVisible="False" Visibility="{Binding ConnectsFromPrevious, Converter={StaticResource VisibleWhenTrue}}"/>
        <Border x:Name="ContinuousOutgoingLine" Grid.RowSpan="2" Width="6" Background="{DynamicResource AccentPrimary}" Margin="0,0,0,-3" VerticalAlignment="Bottom"
                IsHitTestVisible="False" Visibility="{Binding ConnectsToNext, Converter={StaticResource VisibleWhenTrue}}">
            <Border.Style><Style TargetType="Border"><Setter Property="Height" Value="8"/>
                <Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Height" Value="16"/></DataTrigger></Style.Triggers>
            </Style></Border.Style>
        </Border>
        <Border x:Name="FocusMarker" Grid.RowSpan="2" Width="6" CornerRadius="3" Background="{DynamicResource AccentPrimary}" IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Margin" Value="0,2,0,2"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Margin" Value="0,2,0,10"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="TimeRange" MinWidth="110" Text="{Binding Record.TimeRangeDisplay}" FontFamily="{DynamicResource FontFamilyEnglish}" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
            <Viewbox Grid.Column="1" Margin="8,0,0,0" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="Summary" Text="{Binding SummaryDisplay}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
            </Viewbox>
            <Path x:Name="ExpandArrow" Grid.Column="2" Width="6" Height="10" Margin="14,0,1,0" Data="M 0,0 L 5,5 L 0,10"
                  Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Visibility="{Binding HasTasks, Converter={StaticResource VisibleWhenTrue}}">
                <Path.RenderTransform><RotateTransform x:Name="ArrowRotation"/></Path.RenderTransform>
            </Path>
        </Grid>
        <StackPanel Grid.Column="1" Grid.Row="1">
            <TextBlock x:Name="GoalName" Text="{Binding Record.GoalName}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Record.GoalName}"
                       Visibility="{Binding HasGoal, Converter={StaticResource VisibleWhenTrue}}"/>
            <Border x:Name="TaskExpansion" Height="0" Opacity="0" ClipToBounds="True">
                <ItemsControl x:Name="TaskItems" ItemsSource="{Binding Tasks}" Margin="4,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="TaskRow" MinHeight="32">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid x:Name="ChildConnector" Width="24" Visibility="Collapsed">
                                    <Border x:Name="ChildStem" Width="1" Background="#E8EBEF" HorizontalAlignment="Left" Margin="8,0,0,0"/>
                                    <Border Width="11" Height="1" Background="#E8EBEF" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <Border x:Name="TaskCheck" Grid.Column="1" Width="16" Height="16" CornerRadius="8" BorderBrush="{DynamicResource AccentPrimary}" BorderThickness="1.2"
                                        VerticalAlignment="Center" HorizontalAlignment="Left" Background="Transparent">
                                    <Path x:Name="TaskTick" Visibility="Collapsed" Data="M 3,7 L 6,10 L 11,4" Stroke="White" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Border>
                                <TextBlock x:Name="TaskText" Grid.Column="2" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                <Border x:Name="TaskSeparator" Grid.ColumnSpan="3" Height="1" Background="#F3F4F6" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSubTask}" Value="False">
                                    <Setter TargetName="TaskCheck" Property="Grid.Column" Value="0"/>
                                    <Setter TargetName="TaskCheck" Property="CornerRadius" Value="3"/>
                                    <Setter TargetName="TaskText" Property="Grid.Column" Value="1"/>
                                    <Setter TargetName="TaskText" Property="Grid.ColumnSpan" Value="2"/>
                                    <Setter TargetName="TaskRow" Property="MinHeight" Value="36"/>
                                    <Setter TargetName="TaskSeparator" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSubTask}" Value="True"><Setter TargetName="ChildConnector" Property="Visibility" Value="Visible"/></DataTrigger>
                                <DataTrigger Binding="{Binding HasChildren}" Value="True"><Setter TargetName="TaskSeparator" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                <DataTrigger Binding="{Binding IsLastChild}" Value="True"><Setter TargetName="ChildStem" Property="Margin" Value="8,0,0,16"/></DataTrigger>
                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                    <Setter TargetName="TaskCheck" Property="Background" Value="{DynamicResource AccentPrimary}"/>
                                    <Setter TargetName="TaskTick" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="TaskText" Property="Foreground" Value="#A0A2A7"/>
                                    <Setter TargetName="TaskText" Property="TextDecorations" Value="Strikethrough"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
