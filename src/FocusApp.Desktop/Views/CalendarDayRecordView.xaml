<UserControl x:Class="FocusApp.Desktop.Views.CalendarDayRecordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource FontFamilyPrimary}" UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/FocusApp.Desktop;component/Resources/CalendarTypography.xaml"/></ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0,0,5,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border x:Name="TimelineSpine" Grid.RowSpan="2" Width="1" Background="#E6E8EB" IsHitTestVisible="False"/>
        <Border x:Name="FocusMarker" Width="9" Height="9" CornerRadius="4.5" VerticalAlignment="Center" IsHitTestVisible="False">
            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#19C463"/><Style.Triggers><DataTrigger Binding="{Binding IsInterrupted}" Value="True"><Setter Property="Background" Value="#FF861F"/></DataTrigger></Style.Triggers></Style></Border.Style>
        </Border>
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource CalendarRecordTextStyle}" x:Name="TimeRange" Text="{Binding Record.TimeRangeDisplay}" FontFamily="{DynamicResource FontFamilyEnglish}" VerticalAlignment="Center"/>
            <TextBlock Style="{StaticResource CalendarBodyTextStyle}" x:Name="GoalName" Grid.Column="1" Text="{Binding Record.CalendarTitle}" Margin="0,0,6,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.IsEnabled="{Binding HasGoal}"><TextBlock.ToolTip><ToolTip Style="{StaticResource CalendarToolTipStyle}" Content="{Binding Record.CalendarTitle}"/></TextBlock.ToolTip></TextBlock>
            <TextBlock Style="{StaticResource CalendarWeakTextStyle}" x:Name="Summary" Grid.Column="2" Text="{Binding TaskCountDisplay}" VerticalAlignment="Center" Visibility="{Binding HasTasks, Converter={StaticResource VisibleWhenTrue}}"/>
            <Path x:Name="ExpandArrow" Grid.Column="3" Width="5" Height="9" Margin="5,0,0,0" Data="M 0,0 L 4,4 L 0,8"
                  Stroke="#959CA7" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Visibility="{Binding HasTasks, Converter={StaticResource VisibleWhenTrue}}">
                <Path.RenderTransform><RotateTransform x:Name="ArrowRotation"/></Path.RenderTransform>
            </Path>
        </Grid>
        <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Style="{StaticResource CalendarWeakTextStyle}" x:Name="FocusDuration" Text="{Binding FocusDurationDisplay}" Margin="0,1,0,0"/>
            <Border x:Name="TaskExpansion" Height="0" Opacity="0" ClipToBounds="True">
                <ItemsControl x:Name="TaskItems" ItemsSource="{Binding Tasks}" Margin="4,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="TaskRow" MinHeight="32">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid x:Name="ChildConnector" Width="24" Visibility="Collapsed">
                                    <Border x:Name="ChildStem" Width="1" Background="#E8EBEF" HorizontalAlignment="Left" Margin="8,0,0,0"/>
                                    <Border Width="11" Height="1" Background="#E8EBEF" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <Border x:Name="TaskCheck" Grid.Column="1" Width="16" Height="16" CornerRadius="8" BorderBrush="{DynamicResource AccentPrimary}" BorderThickness="1.2"
                                        VerticalAlignment="Center" HorizontalAlignment="Left" Background="Transparent">
                                    <Path x:Name="TaskTick" Visibility="Collapsed" Data="M 3,7 L 6,10 L 11,4" Stroke="White" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Border>
                                <TextBlock Style="{StaticResource CalendarBodyTextStyle}" x:Name="TaskText" Grid.Column="2" Text="{Binding Name}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ><TextBlock.ToolTip><ToolTip Style="{StaticResource CalendarToolTipStyle}" Content="{Binding Name}"/></TextBlock.ToolTip></TextBlock>
                                <Border x:Name="TaskSeparator" Grid.ColumnSpan="3" Height="1" Background="#F3F4F6" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSubTask}" Value="False">
                                    <Setter TargetName="TaskCheck" Property="Grid.Column" Value="0"/>
                                    <Setter TargetName="TaskCheck" Property="CornerRadius" Value="3"/>
                                    <Setter TargetName="TaskText" Property="Grid.Column" Value="1"/>
                                    <Setter TargetName="TaskText" Property="Grid.ColumnSpan" Value="2"/>
                                    <Setter TargetName="TaskRow" Property="MinHeight" Value="36"/>
                                    <Setter TargetName="TaskSeparator" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSubTask}" Value="True"><Setter TargetName="ChildConnector" Property="Visibility" Value="Visible"/></DataTrigger>
                                <DataTrigger Binding="{Binding HasChildren}" Value="True"><Setter TargetName="TaskSeparator" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                <DataTrigger Binding="{Binding IsLastChild}" Value="True"><Setter TargetName="ChildStem" Property="Margin" Value="8,0,0,16"/></DataTrigger>
                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                    <Setter TargetName="TaskCheck" Property="Background" Value="{DynamicResource AccentPrimary}"/>
                                    <Setter TargetName="TaskTick" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="TaskText" Property="Foreground" Value="{DynamicResource CalendarTextWeak}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
