<UserControl x:Class="FocusApp.Desktop.Views.AccountSyncModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FocusApp.Desktop.ViewModels"
             Width="650"
             Height="400"
             IsVisibleChanged="AccountSyncModal_IsVisibleChanged"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="AccountSyncPlainButton" TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccountSyncNavButton" TargetType="{x:Type Button}" BasedOn="{StaticResource AccountSyncPlainButton}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="12,0,15,10" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style x:Key="AccountSyncCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
        </Style>

        <Style x:Key="AccountPasswordPrimaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccountPasswordRevealButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource AccountSyncPlainButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
        </Style>

        <Style x:Key="AccountDeletionDangerButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource AccountPasswordPrimaryButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource Danger}" />
        </Style>

        <Style x:Key="AccountSyncThinScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="5" />
            <Setter Property="MinWidth" Value="5" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Opacity" Value="0.16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="5" Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   Margin="0,3"
                                   IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Width="3"
                                                        HorizontalAlignment="Center"
                                                        Background="{DynamicResource TextSecondary}"
                                                        CornerRadius="1.5"
                                                        Opacity="0.62" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsScrollBarActive, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                <Setter Property="Opacity" Value="0.68" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource OverlayBorder}"
            BorderThickness="1"
            CornerRadius="17">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Direction="270" Opacity="0.17" ShadowDepth="8" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="145" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource BackgroundPrimary}" CornerRadius="17,0,0,17" />
            <Border Grid.Column="1" Background="{DynamicResource BorderPrimary}" />

            <StackPanel Margin="0,40,0,0">
                <Button Click="NavigationButton_Click"
                        Command="{Binding NavigateSectionCommand}"
                        CommandParameter="{x:Static vm:AccountSyncModalViewModel.CloudSection}"
                        Tag="{x:Static vm:AccountSyncModalViewModel.CloudSection}">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource AccountSyncNavButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSectionKey}" Value="{x:Static vm:AccountSyncModalViewModel.CloudSection}">
                                    <Setter Property="Background" Value="{DynamicResource AccentTint}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Text="&#xE753;" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Text="{DynamicResource AccountSyncCloudNav}" />
                    </Grid>
                </Button>

                <Button Click="NavigationButton_Click"
                        Command="{Binding NavigateSectionCommand}"
                        CommandParameter="{x:Static vm:AccountSyncModalViewModel.DevicesSection}"
                        Tag="{x:Static vm:AccountSyncModalViewModel.DevicesSection}">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource AccountSyncNavButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSectionKey}" Value="{x:Static vm:AccountSyncModalViewModel.DevicesSection}">
                                    <Setter Property="Background" Value="{DynamicResource AccentTint}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Text="&#xE7F8;" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Text="{DynamicResource AccountSyncDevicesNav}" />
                    </Grid>
                </Button>

                <Button Click="NavigationButton_Click"
                        Command="{Binding NavigateSectionCommand}"
                        CommandParameter="{x:Static vm:AccountSyncModalViewModel.SecuritySection}"
                        Tag="{x:Static vm:AccountSyncModalViewModel.SecuritySection}">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource AccountSyncNavButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSectionKey}" Value="{x:Static vm:AccountSyncModalViewModel.SecuritySection}">
                                    <Setter Property="Background" Value="{DynamicResource AccentTint}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Text="&#xEA18;" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Text="{DynamicResource AccountSyncSecurityNav}" />
                    </Grid>
                </Button>
            </StackPanel>

            <Grid Grid.Column="2">
                <ScrollViewer x:Name="ContentScrollViewer"
                              Margin="28,30,17,14"
                              CanContentScroll="False"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              PreviewMouseWheel="ContentScrollViewer_PreviewMouseWheel"
                              ScrollChanged="ContentScrollViewer_ScrollChanged"
                              VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="{x:Type ScrollViewer}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTransientContentActive}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource AccountSyncThinScrollBarStyle}" />
                    </ScrollViewer.Resources>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock FontSize="25" FontWeight="Bold" Text="{DynamicResource AccountSyncTitle}" />
                        <TextBlock Margin="0,7,0,0" FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource AccountSyncSubtitle}" />

                        <StackPanel x:Name="CloudSectionAnchor" Margin="0,29,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" Background="{DynamicResource AccentTint}" CornerRadius="10">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource AccentPrimary}" Text="&#xE753;" />
                                </Border>
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="{DynamicResource AccountSyncCloudNav}" />
                            </StackPanel>
                            <TextBlock Margin="0,9,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource AccountSyncCloudDescription}" />

                            <Border Height="68" Margin="0,13,0,0" Style="{StaticResource AccountSyncCard}">
                                <Grid Margin="14,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" Background="#E8F7EC" CornerRadius="21">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="{DynamicResource Success}" Text="&#xE753;" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Success}" Text="{DynamicResource AccountSyncNormal}" />
                                        <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource AccountSyncLastSync}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Width="34" Height="34" AutomationProperties.Name="{DynamicResource AccountSyncRefresh}" Style="{StaticResource AccountSyncPlainButton}">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource TextSecondary}" Text="&#xE72C;" />
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Height="190" Margin="0,6,0,0" Style="{StaticResource AccountSyncCard}">
                                <Grid Margin="13,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42" />
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="32" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{DynamicResource AccountSyncContentTitle}" />
                                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource AccountSyncContentHint}" />
                                    </StackPanel>
                                    <Grid Grid.Row="1">
                                        <TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource Success}" Text="&#xE823;" />
                                        <TextBlock Margin="27,0,0,0" VerticalAlignment="Center" FontSize="13" Text="{DynamicResource AccountSyncFocusRecords}" />
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource Success}" Text="&#xE73E;" />
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource BorderPrimary}" />
                                        <TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TextSecondary}" Text="&#xE774;" />
                                        <TextBlock Margin="27,0,0,0" VerticalAlignment="Center" FontSize="13" Text="{DynamicResource AccountSyncWebsiteList}" />
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextTertiary}" Text="&#xE72E;" />
                                    </Grid>
                                    <Grid Grid.Row="3">
                                        <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource BorderPrimary}" />
                                        <TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TextSecondary}" Text="&#xEA18;" />
                                        <TextBlock Margin="27,0,0,0" VerticalAlignment="Center" FontSize="13" Text="{DynamicResource AccountSyncAutomaticRules}" />
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextTertiary}" Text="&#xE72E;" />
                                    </Grid>
                                    <Grid Grid.Row="4">
                                        <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource BorderPrimary}" />
                                        <TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TextSecondary}" Text="&#xE713;" />
                                        <TextBlock Margin="27,0,0,0" VerticalAlignment="Center" FontSize="13" Text="{DynamicResource AccountSyncPreferences}" />
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextTertiary}" Text="&#xE72E;" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="DevicesSectionAnchor" Margin="0,24,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" Background="#EDF3FB" CornerRadius="17">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource TextSecondary}" Text="&#xE7F8;" />
                                </Border>
                                <TextBlock Margin="11,0,0,0" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="{DynamicResource AccountSyncDevicesTitle}" />
                                <Border Height="22" Margin="12,0,0,0" Padding="9,0" VerticalAlignment="Center" Background="{DynamicResource BackgroundSecondary}" CornerRadius="7">
                                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondary}">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Text" Value="{DynamicResource AccountSyncDevicesCount}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMacBookProLoggedIn}" Value="False">
                                                        <Setter Property="Text" Value="{DynamicResource AccountSyncDevicesCountAfterLogout}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                            <Border Margin="0,11,0,0">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource AccountSyncCard}">
                                        <Setter Property="Height" Value="104" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMacBookProLoggedIn}" Value="False">
                                                <Setter Property="Height" Value="52" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid Margin="14,0" Visibility="{Binding IsMacBookProLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="1" /><RowDefinition /></Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource TextSecondary}" Text="&#xE7F8;" />
                                            <StackPanel Margin="34,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="{DynamicResource AccountSyncCurrentDevice}" />
                                                    <Border Height="21" Margin="9,0,0,0" Padding="8,0" Background="{DynamicResource AccentTint}" CornerRadius="7">
                                                        <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AccentPrimary}" Text="{DynamicResource AccountSyncCurrentDeviceTag}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource AccountSyncCurrentDeviceMeta}" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Grid.Row="1" Background="{DynamicResource BorderPrimary}" />
                                        <Grid Grid.Row="2">
                                            <TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource TextSecondary}" Text="&#xE7F8;" />
                                            <StackPanel Margin="34,0,72,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{DynamicResource AccountSyncOtherDevice}" />
                                                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource AccountSyncOtherDeviceMeta}" />
                                            </StackPanel>
                                            <Button Width="64"
                                                    Height="32"
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding OpenDeviceLogoutConfirmationCommand}"
                                                    Style="{StaticResource AccountSyncPlainButton}">
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="{DynamicResource AccountSyncDeviceLogout}" />
                                                    <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE76C;" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Grid>

                                    <Grid Margin="14,0">
                                        <Grid.Style>
                                            <Style TargetType="{x:Type Grid}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMacBookProLoggedIn}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource TextSecondary}" Text="&#xE7F8;" />
                                        <StackPanel Margin="34,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{DynamicResource AccountSyncCurrentDevice}" />
                                                <Border Height="21" Margin="9,0,0,0" Padding="8,0" Background="{DynamicResource AccentTint}" CornerRadius="7">
                                                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AccentPrimary}" Text="{DynamicResource AccountSyncCurrentDeviceTag}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource AccountSyncCurrentDeviceMeta}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="SecuritySectionAnchor" Margin="0,24,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" Background="#EAF7EF" CornerRadius="17">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource Success}" Text="&#xEA18;" />
                                </Border>
                                <TextBlock Margin="11,0,0,0" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="{DynamicResource AccountSyncSecurityTitle}" />
                            </StackPanel>
                            <Border Height="112" Margin="0,11,0,0" Style="{StaticResource AccountSyncCard}">
                                <Grid Margin="14,0">
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="1" /><RowDefinition /><RowDefinition Height="1" /><RowDefinition /></Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock VerticalAlignment="Center" FontSize="13" Text="{DynamicResource AccountSyncLoginEmail}" />
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource AccountSyncMaskedEmail}" />
                                    </Grid>
                                    <Border Grid.Row="1" Background="{DynamicResource BorderPrimary}" />
                                    <Grid Grid.Row="2">
                                        <TextBlock VerticalAlignment="Center" FontSize="13" Text="{DynamicResource AccountSyncVerification}" />
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Success}" Text="&#xE73E;" />
                                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource AccountSyncVerified}" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Row="3" Background="{DynamicResource BorderPrimary}" />
                                    <Grid Grid.Row="4">
                                        <TextBlock VerticalAlignment="Center" FontSize="13" Text="{DynamicResource AccountSyncPassword}" />
                                        <Button Width="64"
                                                Height="30"
                                                HorizontalAlignment="Right"
                                                Click="OpenPasswordChange_Click"
                                                Style="{StaticResource AccountSyncPlainButton}">
                                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource AccountSyncModify}" />
                                                <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="&#xE76C;" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,24,0,20">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" Background="#FDEBEC" CornerRadius="17">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource Danger}" Text="&#xE7BA;" />
                                </Border>
                                <TextBlock Margin="11,0,0,0" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="{DynamicResource AccountSyncDangerTitle}" />
                            </StackPanel>
                            <Border Height="72" Margin="0,11,0,0" Style="{StaticResource AccountSyncCard}">
                                <Grid Margin="14,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="{DynamicResource AccountSyncDeleteAccount}" />
                                        <TextBlock Margin="0,5,90,0" FontSize="11" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource AccountSyncDeleteHint}" />
                                    </StackPanel>
                                    <Button Width="82"
                                            Height="34"
                                            HorizontalAlignment="Right"
                                            Command="{Binding OpenAccountDeletionCommand}"
                                            Style="{StaticResource AccountSyncPlainButton}">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Danger}" Text="{DynamicResource AccountSyncDeleteAccount}" />
                                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Danger}" Text="&#xE76C;" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid Margin="28,18,17,16"
                      Visibility="{Binding IsPasswordChangeActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Visibility="{Binding IsVerificationStage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Width="66"
                                Height="30"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Command="{Binding ReturnFromPasswordChangeCommand}"
                                Style="{StaticResource AccountSyncPlainButton}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Margin="0,0,7,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextSecondary}" Text="&#xE76B;" />
                                <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource AccountPasswordBack}" />
                            </StackPanel>
                        </Button>

                        <TextBlock Margin="0,34,0,0" VerticalAlignment="Top" FontSize="25" FontWeight="Medium" Text="{DynamicResource AccountPasswordTitle}" />
                        <TextBlock Margin="0,69,0,0" VerticalAlignment="Top" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextTertiary}" Text="{DynamicResource AccountPasswordVerifySubtitle}" />

                        <Grid Width="68" Height="68" Margin="170,106,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Border Background="{DynamicResource BackgroundSecondary}" CornerRadius="34">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="31" Foreground="{DynamicResource TextSecondary}" Text="&#xE715;" />
                            </Border>
                            <Border Width="22" Height="22" Margin="0,0,-2,-1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource AccentPrimary}" CornerRadius="11">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource WhiteText}" Text="&#xEA18;" />
                            </Border>
                        </Grid>

                        <StackPanel Width="408" Margin="0,188,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextTertiary}" Text="{DynamicResource AccountPasswordCodeSent}" />
                            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="15" FontWeight="Medium" Text="{DynamicResource AccountPasswordMaskedEmail}" />
                        </StackPanel>

                        <Border Width="360" Height="44" Margin="23,246,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource AccountSyncCard}">
                            <Grid Margin="12,0,7,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="116" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource TextSecondary}" Text="&#xEA18;" />
                                <TextBox x:Name="PasswordVerificationCodeTextBox"
                                         Grid.Column="1"
                                         Padding="0"
                                         VerticalContentAlignment="Center"
                                         Background="{DynamicResource TransparentBrush}"
                                         BorderThickness="0"
                                         FontSize="14"
                                         Text="{Binding VerificationCode, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource TextTertiary}" Text="{DynamicResource AccountPasswordCodePlaceholder}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding VerificationCode}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Grid.Column="2" Height="26" VerticalAlignment="Center" Background="{DynamicResource BorderPrimary}" />
                                <Button Grid.Column="3" Margin="6,0,0,0" Style="{StaticResource AccountSyncPlainButton}">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource AccountPasswordGetCode}" />
                                </Button>
                            </Grid>
                        </Border>

                        <Button Width="360"
                                Height="44"
                                Margin="23,310,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Command="{Binding ContinuePasswordChangeCommand}"
                                Style="{StaticResource AccountPasswordPrimaryButtonStyle}"
                                Content="{DynamicResource AccountPasswordNext}" />
                    </Grid>

                    <Grid Visibility="{Binding IsNewPasswordStage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Width="66"
                                Height="30"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Command="{Binding ReturnFromPasswordChangeCommand}"
                                Style="{StaticResource AccountSyncPlainButton}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Margin="0,0,7,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextSecondary}" Text="&#xE76B;" />
                                <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource AccountPasswordBack}" />
                            </StackPanel>
                        </Button>

                        <TextBlock Margin="0,34,0,0" VerticalAlignment="Top" FontSize="25" FontWeight="Medium" Text="{DynamicResource AccountPasswordTitle}" />
                        <TextBlock Margin="0,69,0,0" VerticalAlignment="Top" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextTertiary}" Text="{DynamicResource AccountPasswordNewSubtitle}" />

                        <TextBlock Margin="22,101,0,0" VerticalAlignment="Top" FontSize="13" FontWeight="Medium" Text="{DynamicResource AccountPasswordNewLabel}" />
                        <Border Width="344" Height="44" Margin="22,123,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource AccountSyncCard}">
                            <Grid Margin="13,0,5,0">
                                <PasswordBox x:Name="AccountNewPasswordBox"
                                             Margin="0,0,40,0"
                                             Padding="0"
                                             VerticalContentAlignment="Center"
                                             Background="{DynamicResource TransparentBrush}"
                                             BorderThickness="0"
                                             FontSize="14"
                                             PasswordChanged="AccountNewPasswordBox_PasswordChanged" />
                                <TextBox x:Name="AccountNewPasswordTextBox"
                                         Margin="0,0,40,0"
                                         Padding="0"
                                         VerticalContentAlignment="Center"
                                         Background="{DynamicResource TransparentBrush}"
                                         BorderThickness="0"
                                         FontSize="14"
                                         Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="Collapsed" />
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleAccountNewPasswordVisibility_Click" Style="{StaticResource AccountPasswordRevealButtonStyle}">
                                    <TextBlock x:Name="AccountNewPasswordVisibilityIcon" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource TextSecondary}" Text="&#xE890;" />
                                </Button>
                            </Grid>
                        </Border>

                        <StackPanel Margin="22,175,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                            <TextBlock FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextTertiary}" Text="{DynamicResource AccountPasswordStrength}" />
                            <TextBlock Margin="4,0,0,0" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource AccentPrimary}" Text="{Binding PasswordStrengthText}" />
                        </StackPanel>
                        <Grid Width="344" Height="5" Margin="22,200,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Border Margin="0,0,5,0" CornerRadius="2.5">
                                <Border.Style><Style TargetType="{x:Type Border}"><Setter Property="Background" Value="{DynamicResource BorderPrimary}" /><Style.Triggers><DataTrigger Binding="{Binding IsPasswordStrengthOneActive}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentPrimary}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                            </Border>
                            <Border Grid.Column="1" Margin="5,0" CornerRadius="2.5">
                                <Border.Style><Style TargetType="{x:Type Border}"><Setter Property="Background" Value="{DynamicResource BorderPrimary}" /><Style.Triggers><DataTrigger Binding="{Binding IsPasswordStrengthTwoActive}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentPrimary}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                            </Border>
                            <Border Grid.Column="2" Margin="5,0,0,0" CornerRadius="2.5">
                                <Border.Style><Style TargetType="{x:Type Border}"><Setter Property="Background" Value="{DynamicResource BorderPrimary}" /><Style.Triggers><DataTrigger Binding="{Binding IsPasswordStrengthThreeActive}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentPrimary}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                            </Border>
                        </Grid>

                        <TextBlock Margin="22,221,0,0" VerticalAlignment="Top" FontSize="13" FontWeight="Medium" Text="{DynamicResource AccountPasswordConfirmLabel}" />
                        <Border Width="344" Height="44" Margin="22,241,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource AccountSyncCard}">
                            <Grid Margin="13,0,5,0">
                                <PasswordBox x:Name="AccountConfirmPasswordBox"
                                             Margin="0,0,40,0"
                                             Padding="0"
                                             VerticalContentAlignment="Center"
                                             Background="{DynamicResource TransparentBrush}"
                                             BorderThickness="0"
                                             FontSize="14"
                                             PasswordChanged="AccountConfirmPasswordBox_PasswordChanged" />
                                <TextBox x:Name="AccountConfirmPasswordTextBox"
                                         Margin="0,0,40,0"
                                         Padding="0"
                                         VerticalContentAlignment="Center"
                                         Background="{DynamicResource TransparentBrush}"
                                         BorderThickness="0"
                                         FontSize="14"
                                         Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="Collapsed" />
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleAccountConfirmPasswordVisibility_Click" Style="{StaticResource AccountPasswordRevealButtonStyle}">
                                    <TextBlock x:Name="AccountConfirmPasswordVisibilityIcon" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource TextSecondary}" Text="&#xE890;" />
                                </Button>
                            </Grid>
                        </Border>

                        <TextBlock Margin="22,286,0,0" VerticalAlignment="Top" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextTertiary}" Text="{DynamicResource AccountPasswordHint}" />
                        <Button Width="344"
                                Height="42"
                                Margin="22,318,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Command="{Binding SavePasswordCommand}"
                                IsEnabled="{Binding CanSavePassword}"
                                Style="{StaticResource AccountPasswordPrimaryButtonStyle}"
                                Content="{DynamicResource AccountPasswordSave}" />
                    </Grid>

                    <Grid Visibility="{Binding IsPasswordChangeSuccessStage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Width="70" Height="70" Margin="169,73,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#E8F7EC" CornerRadius="35">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="{DynamicResource Success}" Text="&#xE73E;" />
                        </Border>
                        <TextBlock Width="408" Margin="0,159,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="22" FontWeight="Medium" Text="{DynamicResource AccountPasswordSuccessTitle}" TextAlignment="Center" />
                        <StackPanel Width="408" Margin="0,202,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource TextTertiary}" Text="{DynamicResource AccountPasswordSuccessLineOne}" />
                            <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource TextTertiary}" Text="{DynamicResource AccountPasswordSuccessLineTwo}" />
                        </StackPanel>
                        <Button Width="196"
                                 Height="42"
                                 Margin="106,284,0,0"
                                 HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Command="{Binding CompletePasswordChangeCommand}"
                                Style="{StaticResource AccountPasswordPrimaryButtonStyle}"
                                Content="{DynamicResource AccountPasswordComplete}" />
                    </Grid>
                </Grid>

                <Grid Margin="28,18,17,16"
                      Visibility="{Binding IsAccountDeletionActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Width="66"
                            Height="30"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Command="{Binding ReturnFromAccountDeletionCommand}"
                            Style="{StaticResource AccountSyncPlainButton}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Margin="0,0,7,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextSecondary}" Text="&#xE76B;" />
                            <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource AccountPasswordBack}" />
                        </StackPanel>
                    </Button>

                    <TextBlock Margin="0,38,0,0"
                               VerticalAlignment="Top"
                               FontSize="25"
                               FontWeight="Medium"
                               Text="{DynamicResource AccountDeletionTitle}" />

                    <StackPanel Margin="0,80,0,0" VerticalAlignment="Top">
                        <TextBlock FontSize="14" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource AccountDeletionDescriptionLineOne}" />
                        <TextBlock Margin="0,7,0,0" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource AccountDeletionDescriptionLineTwo}" />
                    </StackPanel>

                    <Border Height="52"
                            Margin="0,144,20,0"
                            VerticalAlignment="Top"
                            Background="{DynamicResource DangerTint}"
                            BorderBrush="{DynamicResource DangerBorder}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel Margin="15,0" VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="{DynamicResource Danger}" Text="&#xE7BA;" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource Danger}" Text="{DynamicResource AccountDeletionWarning}" />
                        </StackPanel>
                    </Border>

                    <Border Height="58"
                            Margin="0,218,20,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource AccountSyncCard}">
                        <Grid Margin="16,0">
                            <TextBox Padding="0"
                                     VerticalContentAlignment="Center"
                                     Background="{DynamicResource TransparentBrush}"
                                     BorderThickness="0"
                                     FontSize="14"
                                     Text="{Binding AccountDeletionConfirmation, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       FontSize="14"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource TextTertiary}"
                                       Text="{DynamicResource AccountDeletionPlaceholder}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AccountDeletionConfirmation}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Button Width="88"
                            Height="42"
                            Margin="0,307,177,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Command="{Binding ReturnFromAccountDeletionCommand}"
                            Style="{StaticResource AccountSyncPlainButton}">
                        <Border Background="{DynamicResource SurfacePrimary}"
                                BorderBrush="{DynamicResource BorderPrimary}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <TextBlock Margin="26,0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Text="{DynamicResource AccountDeletionCancel}" />
                        </Border>
                    </Button>

                    <Button Width="142"
                            Height="42"
                            Margin="0,307,20,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Command="{Binding ConfirmAccountDeletionCommand}"
                            IsEnabled="{Binding CanConfirmAccountDeletion}"
                            Style="{StaticResource AccountDeletionDangerButtonStyle}"
                            Content="{DynamicResource AccountDeletionConfirm}" />
                </Grid>

                <Grid Margin="28,18,17,16"
                      Visibility="{Binding IsDeviceLogoutConfirmationActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Width="66"
                            Height="30"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Command="{Binding ReturnFromDeviceLogoutConfirmationCommand}"
                            Style="{StaticResource AccountSyncPlainButton}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Margin="0,0,7,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextSecondary}" Text="&#xE76B;" />
                            <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource AccountPasswordBack}" />
                        </StackPanel>
                    </Button>

                    <Border Width="50"
                            Height="50"
                            Margin="179,75,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AccentTint}"
                            BorderBrush="{DynamicResource AccentSoftBorder}"
                            BorderThickness="1"
                            CornerRadius="25">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="29" FontWeight="Normal" Foreground="{DynamicResource AccentPrimary}" Text="!" />
                    </Border>

                    <TextBlock Width="408"
                               Margin="0,130,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               FontSize="22"
                               FontWeight="Medium"
                               Text="{DynamicResource AccountDeviceLogoutQuestion}"
                               TextAlignment="Center" />

                    <TextBlock Width="408"
                               Margin="0,174,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               FontSize="14"
                               FontWeight="Normal"
                               Text="{DynamicResource AccountDeviceLogoutDescription}"
                               TextAlignment="Center" />
                    <TextBlock Width="408"
                               Margin="0,201,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               FontSize="14"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextTertiary}"
                               Text="{DynamicResource AccountDeviceLogoutCloudHint}"
                               TextAlignment="Center" />

                    <Border Width="284"
                            Height="62"
                            Margin="62,227,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Style="{StaticResource AccountSyncCard}">
                        <Grid Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{DynamicResource TextPrimary}" Text="&#xE7F8;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="16" FontWeight="Medium" Text="{DynamicResource AccountSyncOtherDevice}" />
                                <TextBlock Margin="0,5,0,0" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource AccountDeviceLogoutMeta}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button Width="130"
                            Height="42"
                            Margin="62,304,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Command="{Binding ReturnFromDeviceLogoutConfirmationCommand}"
                            Style="{StaticResource AccountSyncPlainButton}">
                        <Border Background="{DynamicResource SurfacePrimary}"
                                BorderBrush="{DynamicResource BorderPrimary}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Text="{DynamicResource AccountDeviceLogoutCancel}" />
                        </Border>
                    </Button>

                    <Button Width="135"
                            Height="42"
                            Margin="211,304,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Command="{Binding ConfirmDeviceLogoutCommand}"
                            Style="{StaticResource AccountDeletionDangerButtonStyle}"
                            Content="{DynamicResource AccountDeviceLogoutConfirm}" />
                </Grid>

            </Grid>
        </Grid>
    </Border>
</UserControl>
