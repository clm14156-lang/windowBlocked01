<UserControl x:Class="FocusApp.Desktop.Views.AccountSyncModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FocusApp.Desktop.ViewModels"
             Width="520" Height="330" Margin="16" IsVisibleChanged="OnVisibilityChanged"
             FontFamily="{DynamicResource FontFamilyPrimary}" FontSize="{DynamicResource BodyFontSize}"
             Foreground="{DynamicResource AccountSyncText}" UseLayoutRounding="True"
             KeyboardNavigation.TabNavigation="Cycle">
    <UserControl.Resources>
        <Style x:Key="AccountGroup" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource AccountSyncBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style x:Key="AccountSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccountSyncText}" />
            <Setter Property="FontSize" Value="{DynamicResource DialogTitleFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource DialogTitleFontWeight}" />
            <Setter Property="Margin" Value="2,0,0,12" />
        </Style>
        <Style x:Key="AccountSecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccountSyncSecondaryText}" />
            <Setter Property="FontSize" Value="{DynamicResource SecondaryFontSize}" />
        </Style>
        <Style x:Key="AccountActionText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
        <Style x:Key="AccountIcon" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{DynamicResource AccountSyncSecondaryText}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <Style x:Key="AccountChevron" TargetType="Path" BasedOn="{StaticResource AccountIcon}">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Data" Value="M 0,0 L 5,5 L 0,10" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
        <Style x:Key="AccountAction" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccountSyncSecondaryText}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccountSyncHover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccountSyncPressed}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AccountSecurityAction" TargetType="Button" BasedOn="{StaticResource AccountAction}">
            <Setter Property="MinHeight" Value="39" />
        </Style>
        <Style x:Key="AccountSyncAction" TargetType="Button" BasedOn="{StaticResource AccountAction}">
            <Setter Property="BorderBrush" Value="{DynamicResource AccountSyncBorder}" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="{DynamicResource SecondaryFontSize}" />
        </Style>
        <Style x:Key="UnsettledSyncDetails" TargetType="TextBlock" BasedOn="{StaticResource AccountSecondaryText}">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SyncPresentation.State}" Value="{x:Static vm:SyncDisplayState.Synced}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="SyncCategoryTemplate" DataType="{x:Type vm:SyncCategoryPresentation}">
            <Border ToolTip="{Binding Status}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccountSyncBorder}" />
                        <Setter Property="BorderThickness" Value="0,1,0,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                <Setter Property="BorderThickness" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel MinHeight="38" Margin="6,0">
                    <Path DockPanel.Dock="Left" Data="{Binding Icon}" Style="{StaticResource AccountIcon}"
                          Width="18" Height="18" Margin="0,0,14,0" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding StorageLabel}" Style="{StaticResource AccountSecondaryText}"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AccountSyncText}" FontWeight="{DynamicResource BodyMediumFontWeight}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border x:Name="ModalSurface" Background="{DynamicResource AccountSyncSurface}" BorderBrush="{DynamicResource AccountSyncBorder}"
            BorderThickness="1" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="ModalHeader" Margin="23,0" BorderBrush="{DynamicResource AccountSyncBorder}" BorderThickness="0,0,0,1">
                <DockPanel Margin="0,13">
                    <Button DockPanel.Dock="Right" Style="{DynamicResource ModalCloseButtonStyle}" Margin="0"
                            Foreground="{DynamicResource AccountSyncSecondaryText}" Command="{Binding CloseCommand}"
                            AutomationProperties.Name="{DynamicResource AccountSyncClose}" />
                    <TextBlock Text="{DynamicResource AccountSyncTitle}" Style="{DynamicResource PageTitleTextStyle}" Foreground="{DynamicResource AccountSyncText}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" ScrollChanged="OnContentScrollChanged">
                <ScrollViewer.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.MergedDictionaries>
                            <ResourceDictionary Source="../Resources/StatisticsScrollStyles.xaml" />
                        </ResourceDictionary.MergedDictionaries>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource StatisticsThinScrollBarStyle}" />
                    </ResourceDictionary>
                </ScrollViewer.Resources>
                <StackPanel Margin="22,15,22,22">
                    <TextBlock Text="数据与同步" Style="{StaticResource AccountSectionTitle}" />

                    <Border x:Name="SyncStatusPanel" CornerRadius="10" Padding="15,11" Margin="0,0,0,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource AccountSyncWaitingBackground}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SyncPresentation.State}" Value="{x:Static vm:SyncDisplayState.Synced}">
                                        <Setter Property="Background" Value="{DynamicResource AccountSyncSuccessBackground}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SyncPresentation.State}" Value="{x:Static vm:SyncDisplayState.Failed}">
                                        <Setter Property="Background" Value="{DynamicResource AccountSyncFailedBackground}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Path DockPanel.Dock="Left" Width="33" Height="29" Margin="3,0,15,0" StrokeThickness="1.8">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource AccountIcon}">
                                        <Setter Property="Data" Value="M 8,23 H 6 C -1,23 -1,13 5,12 C 3,1 20,-1 23,10 C 33,9 36,23 27,23 H 8 M 16,20 V 11 M 12,15 L 16,11 L 20,15" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SyncPresentation.State}" Value="{x:Static vm:SyncDisplayState.Synced}">
                                                <Setter Property="Stroke" Value="{DynamicResource AccountSyncSuccess}" />
                                                <Setter Property="Data" Value="M 8,23 H 6 C -1,23 -1,13 5,12 C 3,1 20,-1 23,10 C 33,9 36,23 27,23 H 8 M 11,15 L 15,19 L 21,12" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SyncPresentation.State}" Value="{x:Static vm:SyncDisplayState.Failed}">
                                                <Setter Property="Stroke" Value="{DynamicResource AccountSyncDanger}" />
                                                <Setter Property="Data" Value="M 25,23 H 6 C -1,23 -1,13 5,12 M 8,5 C 14,-1 22,2 23,10 C 32,9 36,20 29,23 M 3,1 L 30,28" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Button x:Name="SyncNowButton" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0"
                                    Style="{StaticResource AccountSyncAction}" Content="{Binding SyncPresentation.ActionLabel}"
                                    Command="{Binding FocusUploads.SyncNowCommand}" IsEnabled="{Binding FocusUploads.IsIdle, FallbackValue=False}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SyncPresentation.Title}" Style="{DynamicResource SectionTitleTextStyle}" Foreground="{DynamicResource AccountSyncText}"
                                           FontWeight="{DynamicResource FontWeightSemiBold}" />
                                <TextBlock Text="{Binding SyncPresentation.RecentSync}" Style="{StaticResource AccountSecondaryText}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding SyncPresentation.Description}" Style="{StaticResource UnsettledSyncDetails}" />
                                <TextBlock Text="{Binding SyncPresentation.PendingRecords}" Style="{StaticResource UnsettledSyncDetails}" />
                                <TextBlock Text="{Binding FocusUploads.DeleteSummary, FallbackValue=''}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource AccountSecondaryText}">
                                            <Setter Property="Margin" Value="0,3,0,0" />
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource AccountGroup}">
                        <ItemsControl x:Name="SyncCategoryList" ItemsSource="{Binding SyncPresentation.Categories}"
                                      ItemTemplate="{StaticResource SyncCategoryTemplate}" AlternationCount="3" />
                    </Border>

                    <Border Height="1" Margin="2,17" Background="{DynamicResource AccountSyncBorder}" />
                    <TextBlock Text="{DynamicResource AccountSyncSecurityTitle}" Style="{StaticResource AccountSectionTitle}" />

                    <Border x:Name="AccountSecurityGroup" Style="{StaticResource AccountGroup}">
                        <StackPanel>
                            <Grid MinHeight="39" Margin="6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource AccountSyncLoginEmail}" Foreground="{DynamicResource AccountSyncText}"
                                           FontWeight="{DynamicResource BodyMediumFontWeight}" />
                                <TextBlock Grid.Column="1" Text="{Binding MaskedEmail}" ToolTip="{Binding MaskedEmail}"
                                           TextTrimming="CharacterEllipsis" TextAlignment="Right" Margin="12,0,0,0"
                                           VerticalAlignment="Center" Style="{StaticResource AccountSecondaryText}" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource AccountSyncBorder}" />
                            <Button x:Name="ChangePasswordEntry" Style="{StaticResource AccountSecurityAction}"
                                    Command="{Binding OpenAccountWebsiteCommand}" CommandParameter="ChangePassword"
                                    AutomationProperties.Name="修改登录密码">
                                <DockPanel>
                                    <Path DockPanel.Dock="Right" Style="{StaticResource AccountChevron}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{DynamicResource AccountSyncModify}" Style="{StaticResource AccountActionText}" />
                                    <TextBlock Text="{DynamicResource AccountSyncPassword}" Foreground="{DynamicResource AccountSyncText}"
                                               FontWeight="{DynamicResource BodyMediumFontWeight}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                            <Border Height="1" Background="{DynamicResource AccountSyncBorder}" />
                            <Button x:Name="ManageDevicesEntry" Style="{StaticResource AccountSecurityAction}"
                                    Command="{Binding OpenAccountWebsiteCommand}" CommandParameter="ManageDevices"
                                    AutomationProperties.Name="管理登录设备">
                                <DockPanel>
                                    <Path DockPanel.Dock="Right" Style="{StaticResource AccountChevron}" />
                                    <TextBlock DockPanel.Dock="Right" Text="管理" Style="{StaticResource AccountActionText}" />
                                    <TextBlock Text="{DynamicResource AccountSyncDevicesTitle}" Foreground="{DynamicResource AccountSyncText}"
                                               FontWeight="{DynamicResource BodyMediumFontWeight}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                            <Border Height="1" Background="{DynamicResource AccountSyncBorder}" />
                            <Button x:Name="DeleteAccountEntry" Style="{StaticResource AccountSecurityAction}" MinHeight="56"
                                    Foreground="{DynamicResource AccountSyncDanger}" Command="{Binding OpenAccountWebsiteCommand}"
                                    CommandParameter="DeleteAccount" AutomationProperties.Name="注销账号"
                                    AutomationProperties.HelpText="永久删除账号及云端数据，无法恢复。">
                                <DockPanel>
                                    <Path DockPanel.Dock="Right" Style="{StaticResource AccountChevron}" />
                                    <TextBlock DockPanel.Dock="Right" Text="注销" Style="{StaticResource AccountActionText}" />
                                    <StackPanel VerticalAlignment="Center" Margin="0,5,12,5">
                                        <TextBlock Text="{DynamicResource AccountSyncDeleteAccount}" Foreground="{DynamicResource AccountSyncText}"
                                                   FontWeight="{DynamicResource BodyMediumFontWeight}" />
                                        <TextBlock Text="{DynamicResource AccountSyncDeleteHint}" Style="{StaticResource AccountSecondaryText}"
                                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="WebsiteStatusText" Text="{Binding WebsiteStatus}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" IsVisibleChanged="OnWebsiteStatusVisibilityChanged">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource AccountSecondaryText}">
                                <Setter Property="Margin" Value="2,8,0,0" />
                                <Style.Triggers>
                                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
