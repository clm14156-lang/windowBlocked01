<UserControl x:Class="FocusApp.Desktop.Views.BlockingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="BlockingTabStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Width" Value="82" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid>
                            <Border x:Name="TabBackground" Background="{TemplateBinding Background}" CornerRadius="7" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="TabIndicator" Width="38" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource TransparentBrush}" CornerRadius="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBackground" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="TabBackground" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" /><Setter TargetName="TabIndicator" Property="Background" Value="{DynamicResource AccentPrimary}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlockingOutlineButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentTint}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlockingToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Background" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid>
                            <Border x:Name="Track" Background="{TemplateBinding Background}" CornerRadius="11" />
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Margin="2,0,0,0" HorizontalAlignment="Left" Fill="{DynamicResource SurfacePrimary}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.82" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.68" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentPrimary}" /><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" /><Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlockingIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="IconBackground" Background="{TemplateBinding Background}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="IconBackground" Property="Background" Value="{DynamicResource ControlHoverBackground}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="IconBackground" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <TextBlock Margin="26,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" FontWeight="SemiBold" Text="{DynamicResource BlockingPageTitle}" />

        <Grid Height="41" Margin="26,64,26,0" VerticalAlignment="Top">
            <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource BorderPrimary}" />
            <StackPanel Orientation="Horizontal">
                <RadioButton AutomationProperties.Name="{DynamicResource BlockingWebsiteTab}" Command="{Binding SelectWebsitesCommand}" IsChecked="{Binding IsWebsitesSelected, Mode=OneWay}" Style="{StaticResource BlockingTabStyle}" Content="{DynamicResource BlockingWebsiteTab}" />
                <RadioButton AutomationProperties.Name="{DynamicResource BlockingApplicationTab}" Command="{Binding SelectApplicationsCommand}" IsChecked="{Binding IsApplicationsSelected, Mode=OneWay}" Style="{StaticResource BlockingTabStyle}" Content="{DynamicResource BlockingApplicationTab}" />
            </StackPanel>
        </Grid>

        <Grid Margin="26,114,26,48">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsWebsitesSelected}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
            </Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="8" /><RowDefinition /></Grid.RowDefinitions>

            <Border Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="10">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition /><ColumnDefinition Width="132" /></Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" HorizontalAlignment="Left" Background="{DynamicResource AccentTint}" CornerRadius="22"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource AccentPrimary}" Text="&#xE774;" /></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding WebsiteCountText}" />
                        <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource BlockingWebsiteSummaryDescription}" />
                    </StackPanel>
                    <Button Grid.Column="2" AutomationProperties.Name="{DynamicResource BlockingAddWebsite}" Command="{Binding OpenWebsiteModalCommand}" Style="{StaticResource BlockingOutlineButtonStyle}">
                        <StackPanel Orientation="Horizontal"><TextBlock Margin="0,-1,8,0" VerticalAlignment="Center" FontSize="21" FontWeight="Normal" Text="+" /><TextBlock VerticalAlignment="Center" Text="{DynamicResource BlockingAddWebsite}" /></StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition /></Grid.RowDefinitions>
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="323" /><ColumnDefinition Width="140" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Margin="40,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource BlockingWebsiteNameColumn}" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource BlockingStatusColumn}" />
                        <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource BlockingActionsColumn}" />
                    </Grid>
                    <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource BorderPrimary}" />

                    <Grid Grid.Row="1">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Websites}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="38" Margin="18,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="323" /><ColumnDefinition Width="140" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource OverlayBorder}" />
                                            <StackPanel Margin="40,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="24" Height="24" Background="{DynamicResource AccentTint}" CornerRadius="6">
                                                    <Grid>
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentPrimary}" Text="&#xE774;">
                                                            <TextBlock.Style>
                                                                <Style TargetType="{x:Type TextBlock}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers><DataTrigger Binding="{Binding Favicon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Image Width="20" Height="20" Source="{Binding Favicon}" Stretch="Uniform" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Name}" />
                                                    <TextBlock MaxWidth="310" Margin="0,1,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{Binding Address}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Style="{StaticResource BlockingToggleStyle}" />
                                            <StackPanel Grid.Column="2" Margin="64,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                                                <Button AutomationProperties.Name="{DynamicResource BlockingEditWebsite}" Command="{Binding DataContext.EditWebsiteCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Style="{StaticResource BlockingIconButtonStyle}" ToolTip="{DynamicResource BlockingEditWebsite}"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE70F;" /></Button>
                                                <Button Margin="8,0,0,0" AutomationProperties.Name="{DynamicResource BlockingDeleteWebsite}" Command="{Binding DataContext.DeleteWebsiteCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Foreground="{DynamicResource Danger}" Style="{StaticResource BlockingIconButtonStyle}" ToolTip="{DynamicResource BlockingDeleteWebsite}"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE74D;" /></Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="{DynamicResource AccentPrimary}" Text="&#xE774;" />
                            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{DynamicResource BlockingWebsiteEmptyTitle}" />
                            <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource BlockingWebsiteEmptyDescription}" TextAlignment="Center" />
                            <StackPanel.Style><Style TargetType="{x:Type StackPanel}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Websites.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Margin="26,114,26,48">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsApplicationsSelected}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
            </Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="8" /><RowDefinition /></Grid.RowDefinitions>
            <Border Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="10">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition /><ColumnDefinition Width="132" /></Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" HorizontalAlignment="Left" Background="{DynamicResource AccentTint}" CornerRadius="22"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource AccentPrimary}" Text="&#xE71D;" /></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding ApplicationCountText}" /><TextBlock Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource BlockingApplicationSummaryDescription}" /></StackPanel>
                    <Button Grid.Column="2" AutomationProperties.Name="{DynamicResource BlockingAddApplication}" Command="{Binding OpenProgramModalCommand}" Style="{StaticResource BlockingOutlineButtonStyle}"><StackPanel Orientation="Horizontal"><TextBlock Margin="0,-1,8,0" VerticalAlignment="Center" FontSize="21" Text="+" /><TextBlock VerticalAlignment="Center" Text="{DynamicResource BlockingAddApplication}" /></StackPanel></Button>
                </Grid>
            </Border>
            <Border Grid.Row="2" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition /></Grid.RowDefinitions>
                    <Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="323" /><ColumnDefinition Width="140" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource BlockingApplicationNameColumn}" /><TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource BlockingStatusColumn}" /><TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource BlockingActionsColumn}" /></Grid>
                    <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource BorderPrimary}" />
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Applications}">
                            <ItemsControl.ItemTemplate><DataTemplate><Grid Height="46" Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="323" /><ColumnDefinition Width="140" /><ColumnDefinition /></Grid.ColumnDefinitions><Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource OverlayBorder}" /><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="26" Height="26" Background="{DynamicResource AccentPrimary}" CornerRadius="6"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource WhiteText}" Text="&#xE71D;" /></Border><StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock MaxWidth="250" Margin="0,1,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{Binding Path}" TextTrimming="CharacterEllipsis" /></StackPanel></StackPanel><ToggleButton Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Style="{StaticResource BlockingToggleStyle}" /><Button Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource BlockingDeleteApplication}" Command="{Binding DataContext.DeleteApplicationCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Foreground="{DynamicResource Danger}" Style="{StaticResource BlockingIconButtonStyle}" ToolTip="{DynamicResource BlockingDeleteApplication}"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE74D;" /></Button></Grid></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
