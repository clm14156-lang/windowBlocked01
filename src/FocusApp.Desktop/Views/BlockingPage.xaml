<UserControl x:Class="FocusApp.Desktop.Views.BlockingPage"
             x:Name="BlockingPageRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="BlockingTabStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid>
                            <Border x:Name="TabBackground" Background="{TemplateBinding Background}" CornerRadius="7" />
                            <ContentPresenter x:Name="TabContent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="TabIndicator" Width="{Binding ActualWidth, ElementName=TabContent}" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource TransparentBrush}" CornerRadius="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBackground" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="TabBackground" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" /><Setter TargetName="TabIndicator" Property="Background" Value="{DynamicResource AccentPrimary}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlockingOutlineButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentTint}" /><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentSoftBorder}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlockingAddWebsiteButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlockingToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Background" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid>
                            <Border x:Name="Track" Background="{TemplateBinding Background}" CornerRadius="11" />
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Margin="2,0,0,0" HorizontalAlignment="Left" Fill="{DynamicResource SurfacePrimary}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.82" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.68" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentPrimary}" /><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" /><Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlockingIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextWeak}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="IconBackground" Background="{TemplateBinding Background}" CornerRadius="16"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="IconBackground" Property="Background" Value="{DynamicResource ControlHoverBackground}" /><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="IconBackground" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlockingMoreButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="MoreBackground" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MoreBackground" Property="Background" Value="{DynamicResource ControlHoverBackground}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="MoreBackground" Property="Background" Value="{DynamicResource ControlPressedBackground}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlockingMenuItemStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="MenuItemBackground" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MenuItemBackground" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="MenuItemBackground" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <TextBlock Margin="29,-4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" FontWeight="SemiBold" Text="{DynamicResource BlockingPageTitle}" />
        <TextBlock Margin="29,27,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource BlockingPageDescription}" />

        <Grid Height="41" Margin="26,54,29,0" VerticalAlignment="Top">
            <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource BorderPrimary}" />
            <StackPanel Orientation="Horizontal">
                <RadioButton AutomationProperties.Name="{DynamicResource BlockingWebsiteTab}" Command="{Binding SelectWebsitesCommand}" IsChecked="{Binding IsWebsitesSelected, Mode=OneWay}" Style="{StaticResource BlockingTabStyle}" Content="{DynamicResource BlockingWebsiteTab}" />
                <RadioButton AutomationProperties.Name="{DynamicResource BlockingApplicationTab}" Command="{Binding SelectApplicationsCommand}" IsChecked="{Binding IsApplicationsSelected, Mode=OneWay}" Style="{StaticResource BlockingTabStyle}" Content="{DynamicResource BlockingApplicationTab}" />
            </StackPanel>
        </Grid>

        <Grid Margin="24,104,29,40">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsWebsitesSelected}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
            </Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="74" /><RowDefinition Height="13" /><RowDefinition /></Grid.RowDefinitions>

            <Border Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="12">
                <Border.Effect><DropShadowEffect BlurRadius="14" Direction="270" Opacity="0.06" ShadowDepth="3" /></Border.Effect>
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" HorizontalAlignment="Left" Background="{DynamicResource AccentTint}" CornerRadius="22"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource AccentPrimary}" Text="&#xE774;" /></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="Medium" Text="{DynamicResource BlockingWebsiteSummaryTitle}" />
                        <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}"><Run Text="{Binding Websites.Count, Mode=OneWay}" /><Run Text="{DynamicResource BlockingWebsiteManagedSuffix}" /></TextBlock>
                    </StackPanel>
                    <Button Grid.Column="2" Width="108" Height="38" HorizontalAlignment="Right" AutomationProperties.Name="{DynamicResource BlockingAddWebsite}" Command="{Binding OpenWebsiteModalCommand}" Style="{StaticResource BlockingAddWebsiteButtonStyle}">
                        <StackPanel Orientation="Horizontal"><TextBlock Margin="0,-1,6,0" VerticalAlignment="Center" FontSize="21" FontWeight="Normal" Foreground="{DynamicResource AccentPrimary}" Text="+" /><TextBlock VerticalAlignment="Center" Foreground="{DynamicResource AccentPrimary}" Text="{DynamicResource BlockingAddWebsite}" /></StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="12">
                <Border.Effect><DropShadowEffect BlurRadius="12" Direction="270" Opacity="0.045" ShadowDepth="2" /></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition /></Grid.RowDefinitions>
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="390" /><ColumnDefinition Width="126" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Margin="22,0,0,0" VerticalAlignment="Center" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource BlockingWebsiteNameColumn}" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource BlockingStatusColumn}" />
                        <TextBlock Grid.Column="2" Margin="0,0,23,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource BlockingActionsColumn}" />
                    </Grid>
                    <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource BorderPrimary}" />

                    <Grid Grid.Row="1">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Websites}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="48.5" Margin="14,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="390" /><ColumnDefinition Width="126" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Grid.Style><Style TargetType="Grid"><Setter Property="Background" Value="{DynamicResource TransparentBrush}" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger></Style.Triggers></Style></Grid.Style>
                                            <Border Grid.ColumnSpan="3" Height="1" Margin="22,0" VerticalAlignment="Bottom" Background="{DynamicResource OverlayBorder}" Opacity="0.48" />
                                            <StackPanel Margin="22,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="24" Height="24" Background="{DynamicResource TransparentBrush}" CornerRadius="6">
                                                    <Grid>
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentPrimary}" Text="&#xE774;">
                                                            <TextBlock.Style>
                                                                <Style TargetType="{x:Type TextBlock}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers><DataTrigger Binding="{Binding Favicon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Image Width="20" Height="20" Source="{Binding Favicon}" Stretch="Uniform" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock FontSize="13" FontWeight="Medium" Text="{Binding Name}" />
                                                    <TextBlock MaxWidth="310" Margin="0,1,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{Binding Address}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Style="{StaticResource BlockingToggleStyle}" />
                                            <ToggleButton x:Name="WebsiteMoreButton" Grid.Column="2" Margin="64,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource BlockingWebsiteActions}" IsChecked="{Binding IsActionMenuOpen, Mode=TwoWay}" Style="{StaticResource BlockingMoreButtonStyle}" ToolTip="{DynamicResource BlockingWebsiteActions}">
                                                <TextBlock Margin="0,-7,0,0" FontSize="17" FontWeight="SemiBold" Text="..." />
                                            </ToggleButton>
                                            <Popup AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=WebsiteMoreButton, Mode=TwoWay}" Placement="Left" PlacementTarget="{Binding ElementName=WebsiteMoreButton}" PopupAnimation="Fade" StaysOpen="False">
                                                <Border Width="160" Padding="6" Background="{DynamicResource SurfacePrimary}" BorderBrush="#E5E5EA" BorderThickness="1" CornerRadius="12">
                                                    <Border.Effect><DropShadowEffect BlurRadius="10" Direction="270" Opacity="0.08" ShadowDepth="2" /></Border.Effect>
                                                    <StackPanel>
                                                        <Button AutomationProperties.Name="{DynamicResource BlockingRenameWebsite}" Command="{Binding DataContext.EditWebsiteCommand, Source={x:Reference BlockingPageRoot}}" CommandParameter="{Binding}" Style="{StaticResource BlockingMenuItemStyle}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Width="15" Height="15" VerticalAlignment="Center" Data="M 2,13 L 3.5,8.8 L 11.2,1.1 L 14.9,4.8 L 7.2,12.5 Z M 10.2,2.1 L 13.9,5.8 M 2,13 L 6.2,11.8" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.35" />
                                                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="{DynamicResource BlockingRenameWebsite}" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button AutomationProperties.Name="{DynamicResource BlockingDeleteWebsite}" Command="{Binding DataContext.DeleteWebsiteCommand, Source={x:Reference BlockingPageRoot}}" CommandParameter="{Binding}" Foreground="{DynamicResource Danger}" Style="{StaticResource BlockingMenuItemStyle}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Width="15" Height="15" VerticalAlignment="Center" Data="M 2,4 H 14 M 5,4 V 2 H 11 V 4 M 4,6 V 14 H 12 V 6 M 7,8 V 12 M 9,8 V 12" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.35" />
                                                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="{DynamicResource BlockingDeleteWebsite}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="{DynamicResource AccentPrimary}" Text="&#xE774;" />
                            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{DynamicResource BlockingWebsiteEmptyTitle}" />
                            <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource BlockingWebsiteEmptyDescription}" TextAlignment="Center" />
                            <StackPanel.Style><Style TargetType="{x:Type StackPanel}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Websites.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Margin="24,104,29,40">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsApplicationsSelected}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="74" />
                <RowDefinition Height="13" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource SurfacePrimary}"
                    BorderBrush="{DynamicResource BorderPrimary}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" Direction="270" Opacity="0.06" ShadowDepth="3" />
                </Border.Effect>
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="116" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44"
                            Height="44"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource AccentTint}"
                            CornerRadius="22">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Foreground="{DynamicResource AccentPrimary}"
                                   Text="&#xE71D;" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="15"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="{DynamicResource BlockingApplicationSummaryTitle}" />
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}">
                            <Run Text="{Binding Applications.Count, Mode=OneWay}" />
                            <Run Text="{DynamicResource BlockingApplicationManagedSuffix}" />
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Width="108"
                            Height="38"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="{DynamicResource BlockingAddApplication}"
                            Command="{Binding OpenProgramModalCommand}"
                            Style="{StaticResource BlockingAddWebsiteButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,-1,8,0"
                                       VerticalAlignment="Center"
                                       FontSize="21"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource AccentPrimary}"
                                       Text="+" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentPrimary}"
                                       Text="{DynamicResource BlockingAddApplication}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="{DynamicResource SurfacePrimary}"
                    BorderBrush="{DynamicResource BorderPrimary}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Direction="270" Opacity="0.045" ShadowDepth="2" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="390" />
                            <ColumnDefinition Width="126" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="22,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12.5"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="{DynamicResource BlockingApplicationNameColumn}" />
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12.5"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="{DynamicResource BlockingStatusColumn}" />
                        <TextBlock Grid.Column="2"
                                   Margin="0,0,23,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="12.5"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="{DynamicResource BlockingActionsColumn}" />
                    </Grid>
                    <Border Height="1"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource BorderPrimary}" />
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Applications}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="48.5" Margin="14,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="390" />
                                            <ColumnDefinition Width="126" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Grid.Style>
                                            <Style TargetType="{x:Type Grid}">
                                                <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Border Grid.ColumnSpan="3"
                                                Height="1"
                                                Margin="22,0"
                                                VerticalAlignment="Bottom"
                                                Background="{DynamicResource OverlayBorder}"
                                                Opacity="0.48" />
                                        <StackPanel Margin="22,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="24"
                                                    Height="24"
                                                    Background="{DynamicResource TransparentBrush}"
                                                    CornerRadius="6">
                                                <Grid>
                                                    <Image Width="22" Height="22" Source="{Binding Icon}" Stretch="Uniform" />
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource AccentPrimary}"
                                                               Text="&#xE71D;">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="13"
                                                           FontWeight="Medium"
                                                           Text="{Binding Name}" />
                                                <TextBlock MaxWidth="310"
                                                           Margin="0,1,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           Text="{Binding Path}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="{Binding Name}"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      Style="{StaticResource BlockingToggleStyle}" />
                                        <Button Grid.Column="2"
                                                Margin="64,0,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{DynamicResource BlockingDeleteApplication}"
                                                Command="{Binding DataContext.DeleteApplicationCommand, Source={x:Reference BlockingPageRoot}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource BlockingIconButtonStyle}"
                                                ToolTip="{DynamicResource BlockingDeleteApplication}">
                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                       FontSize="15"
                                                       FontWeight="Normal"
                                                       Text="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
