<UserControl x:Class="FocusApp.Desktop.Views.GoalInvestmentTrendChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FocusApp.Desktop.ViewModels"
             Width="638" Height="214"
             TextElement.FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
             TextElement.FontSize="13" TextElement.FontWeight="Normal"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="TrendVerticalGuideLineStyle" TargetType="{x:Type Line}">
            <Setter Property="Y1" Value="28"/>
            <Setter Property="Y2" Value="174"/>
            <Setter Property="Stroke" Value="#C9CDD4"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeDashArray" Value="3,3"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style x:Key="TooltipLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style x:Key="TooltipThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/><Setter Property="Opacity" Value="0.42"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Grid Width="5"><Track x:Name="PART_Track" Margin="0,2" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                    <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb MinHeight="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Width="3" Background="#A8ADB7" CornerRadius="1.5"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0"/></Track.IncreaseRepeatButton>
                </Track></Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid ClipToBounds="False">
        <ItemsControl IsHitTestVisible="False" ItemsSource="{Binding YAxisTicks}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter"><Setter Property="Canvas.Top" Value="{Binding ChartY}"/></Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GoalInvestmentTrendAxisTickViewModel}">
                    <Canvas Width="638" Height="1">
                        <TextBlock Canvas.Left="0" Canvas.Top="-9" Width="40" TextAlignment="Right" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{Binding Label}"/>
                        <Line X1="44" X2="610" Stroke="#ECEEF1" StrokeThickness="1">
                            <Line.Style><Style TargetType="Line"><Setter Property="StrokeDashArray" Value="3,4"/><Style.Triggers><DataTrigger Binding="{Binding ShowGuideLine}" Value="False"><Setter Property="StrokeDashArray" Value="0"/></DataTrigger></Style.Triggers></Style></Line.Style>
                        </Line>
                    </Canvas>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Path Data="{Binding TrendAreaGeometry}" IsHitTestVisible="False">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#30FF7A00"/>
                    <GradientStop Offset="0.62" Color="#12FF7A00"/>
                    <GradientStop Offset="1" Color="#00FF7A00"/>
                </LinearGradientBrush>
            </Path.Fill>
        </Path>
        <Path Data="{Binding TrendCurveGeometry}" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"/>

        <ItemsControl x:Name="SelectedGuideLines" IsHitTestVisible="False" ItemsSource="{Binding TrendPoints}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding ChartX}"/></Style></ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GoalInvestmentTrendPointViewModel}">
                    <Line X1="0" X2="0">
                        <Line.Style><Style TargetType="Line" BasedOn="{StaticResource TrendVerticalGuideLineStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Line.Style>
                    </Line>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Line x:Name="HoverGuideLine" X1="{Binding HoveredPoint.ChartX}" X2="{Binding HoveredPoint.ChartX}">
            <Line.Style><Style TargetType="Line" BasedOn="{StaticResource TrendVerticalGuideLineStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTooltipOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Line.Style>
        </Line>

        <ItemsControl Panel.ZIndex="2" IsHitTestVisible="False" ItemsSource="{Binding TrendPoints}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding ChartX}"/><Setter Property="Canvas.Top" Value="{Binding ChartY}"/></Style></ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GoalInvestmentTrendPointViewModel}">
                    <Canvas Width="1" Height="1" ClipToBounds="False">
                        <Ellipse Canvas.Left="-5" Canvas.Top="-5" Width="10" Height="10" Fill="{DynamicResource AccentPrimary}" Stroke="White" StrokeThickness="2">
                            <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsMarkerVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsHovered}" Value="True"><Setter Property="Width" Value="12"/><Setter Property="Height" Value="12"/><Setter Property="Canvas.Left" Value="-6"/><Setter Property="Canvas.Top" Value="-6"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                        </Ellipse>
                    </Canvas>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl Panel.ZIndex="2" IsHitTestVisible="False" ItemsSource="{Binding TrendPoints}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding ChartX}"/><Setter Property="Canvas.Top" Value="{Binding AxisLabelY}"/></Style></ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GoalInvestmentTrendPointViewModel}">
                    <TextBlock Width="50" Margin="-25,0,0,0" TextAlignment="Center" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{Binding AxisLabel}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowAxisLabel}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border x:Name="TrendTooltip" Panel.ZIndex="6" Width="210" Height="175" Padding="11,10" UseLayoutRounding="False"
                HorizontalAlignment="Left" VerticalAlignment="Top" Background="White" BorderBrush="#E2E5EA"
                BorderThickness="1" CornerRadius="9" MouseEnter="TrendTooltip_MouseEnter" MouseLeave="TrendTooltip_MouseLeave">
            <Border.RenderTransform><TranslateTransform X="{Binding TooltipLeft}" Y="{Binding TooltipTop}"/></Border.RenderTransform>
            <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.10"/></Border.Effect>
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTooltipOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="1"/><RowDefinition/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding HoveredPoint.TooltipDateDisplay}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource TextSecondary}">
                        <Run Text="{Binding HoverDayDurationDisplay, Mode=OneWay}" Foreground="{DynamicResource AccentPrimary}"/><Run Text="专注  ·  完成 "/><Run Text="{Binding HoverDayTaskCount, Mode=OneWay}" Foreground="{DynamicResource AccentPrimary}"/><Run Text=" 项任务"/>
                    </TextBlock>
                </StackPanel>
                <Border Grid.Row="1" Background="#ECEEF2"/>
                <ScrollViewer x:Name="TooltipTasksScroll" Grid.Row="2" Margin="0,5,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource TooltipThinScrollBar}"/>
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <ItemsControl x:Name="HoverCompletedTasks" ItemsSource="{Binding VisibleHoverDayTasks}">
                            <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:TrendCompletedTaskViewModel}">
                                <StackPanel Margin="0,2,0,3">
                                    <Grid MinHeight="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="23"/><ColumnDefinition/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                                        <Border Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource AccentPrimary}" CornerRadius="8">
                                            <Path Data="M 0,3 L 2,5 L 7,0" Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                        <Button Grid.Column="2" Style="{StaticResource TooltipLinkButton}" Command="{Binding ToggleSubTasksCommand}" Visibility="{Binding HasSubTasks, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="展开或收起子任务">
                                            <TextBlock FontSize="15" Foreground="{DynamicResource TextSecondary}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="›"/><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Text" Value="⌄"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="{Binding SubTaskCountLabel}" Margin="23,-1,0,3" FontSize="10" Foreground="{DynamicResource TextWeak}" Visibility="{Binding HasSubTasks, Converter={StaticResource BoolVisibility}}"/>
                                    <StackPanel Margin="23,1,0,1" Visibility="{Binding IsExpanded, Converter={StaticResource BoolVisibility}}">
                                        <ItemsControl ItemsSource="{Binding VisibleSubTasks}">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Grid MinHeight="21"><Grid.ColumnDefinitions><ColumnDefinition Width="19"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="✓" FontSize="10" Foreground="{DynamicResource TextWeak}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding}" FontSize="10" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="{Binding SubTaskOverflowLabel}" Command="{Binding ToggleAllSubTasksCommand}" Style="{StaticResource TooltipLinkButton}" Foreground="{DynamicResource TextSecondary}" FontSize="10" Margin="19,2,0,2" Visibility="{Binding HasSubTaskOverflow, Converter={StaticResource BoolVisibility}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{Binding HoverTaskOverflowLabel}" Command="{Binding ToggleAllHoverTasksCommand}" Style="{StaticResource TooltipLinkButton}" Foreground="#3184D6" FontSize="11" Margin="23,3,0,4" Visibility="{Binding HasHoverTaskOverflow, Converter={StaticResource BoolVisibility}}"/>
                        <TextBlock Text="{Binding HoverEmptyState}" TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Foreground="{DynamicResource TextWeak}" Margin="8,20">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasHoverDayTasks}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Width="566" Height="176" Margin="44,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="4" Background="Transparent"
                MouseMove="InteractionArea_MouseMove" MouseLeave="InteractionArea_MouseLeave"/>
    </Grid>
</UserControl>
