<UserControl x:Class="FocusApp.Desktop.Views.GoalInvestmentTrendChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FocusApp.Desktop.ViewModels" xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             Width="642" Height="212"
             TextElement.FontFamily="{DynamicResource FontFamilyPrimary}"
             TextElement.FontSize="{DynamicResource BodyFontSize}" TextElement.FontWeight="{DynamicResource BodyFontWeight}"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/FocusApp.Desktop;component/Resources/StatisticsTypography.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="TrendAxisTextBrush" Color="{StaticResource StatisticsWeakColor}"/>
        <SolidColorBrush x:Key="TrendAxisLineBrush" Color="#D3D7E0"/>
        <SolidColorBrush x:Key="TrendGridLineBrush" Color="#E6E8EE"/>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource StatisticsBodyTextStyle}"/>
        <Style x:Key="TrendAxisTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StatisticsAuxiliaryTextStyle}">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyEnglish}"/>
            <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
        <Style x:Key="TrendVerticalGuideLineStyle" TargetType="{x:Type Line}">
            <Setter Property="Y2" Value="146"/>
            <Setter Property="Stroke" Value="#40FF9C4A"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeDashArray" Value="3,3"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
      </ResourceDictionary>
    </UserControl.Resources>
    <Grid ClipToBounds="False">
      <Grid x:Name="PlotLayer" Width="642" Height="188" Margin="0,20,0,0" VerticalAlignment="Top">
        <Line X1="48" X2="48" Y1="20" Y2="146" Stroke="{StaticResource TrendAxisLineBrush}" StrokeThickness="1" IsHitTestVisible="False"/>
        <Line x:Name="TrendBaseline" X1="48" X2="636" Y1="146" Y2="146" Stroke="{StaticResource TrendAxisLineBrush}" StrokeThickness="1" IsHitTestVisible="False"/>
        <ItemsControl IsHitTestVisible="False" ItemsSource="{Binding ChartYAxisTicks}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter"><Setter Property="Canvas.Top" Value="{Binding ChartY}"/></Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GoalInvestmentTrendChartTickViewModel}">
                    <Canvas Width="642" Height="1">
                        <TextBlock Canvas.Left="0" Canvas.Top="-7" Width="40" TextAlignment="Right" Style="{StaticResource TrendAxisTextStyle}" Text="{Binding Label}"/>
                        <Line X1="48" X2="636" StrokeThickness="1">
                            <Line.Style><Style TargetType="Line"><Setter Property="Stroke" Value="{StaticResource TrendGridLineBrush}"/><Setter Property="StrokeDashArray" Value="3,4"/><Style.Triggers><DataTrigger Binding="{Binding ShowGuideLine}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Line.Style>
                        </Line>
                    </Canvas>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl x:Name="TrendBars" IsHitTestVisible="False" ItemsSource="{Binding TrendPoints}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding BarLeft}"/><Setter Property="Canvas.Top" Value="{Binding ChartY}"/></Style></ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:GoalInvestmentTrendPointViewModel}">
                <Border x:Name="TrendBar" Width="{Binding BarWidth}" Height="{Binding BarHeight}" CornerRadius="5,5,0,0" Background="#FFAA63">
                    <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Minutes}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>

        <Line x:Name="HoverGuideLine" X1="{Binding HoveredPoint.ChartX}" X2="{Binding HoveredPoint.ChartX}" Y1="{Binding HoveredPoint.ChartY}">
            <Line.Style><Style TargetType="Line" BasedOn="{StaticResource TrendVerticalGuideLineStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTooltipOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Line.Style>
        </Line>

        <ItemsControl Panel.ZIndex="2" IsHitTestVisible="False" ItemsSource="{Binding TrendPoints}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding ChartX}"/><Setter Property="Canvas.Top" Value="{Binding ChartY}"/></Style></ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GoalInvestmentTrendPointViewModel}">
                    <Canvas Width="1" Height="1" ClipToBounds="False">
                        <Ellipse Canvas.Left="-6" Canvas.Top="-6" Width="12" Height="12" Fill="#FF8A28" Stroke="White" StrokeThickness="2">
                            <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsHovered}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                        </Ellipse>
                    </Canvas>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl Panel.ZIndex="2" IsHitTestVisible="False" ItemsSource="{Binding TrendPoints}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding ChartX}"/><Setter Property="Canvas.Top" Value="{Binding AxisLabelY}"/></Style></ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GoalInvestmentTrendPointViewModel}">
                    <TextBlock Width="50" Margin="-25,0,0,0" TextAlignment="Center" Text="{Binding AxisLabel}">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource TrendAxisTextStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowAxisLabel}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl x:Name="TrendValueLabels" IsHitTestVisible="False" ItemsSource="{Binding TrendPoints}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding ChartX}"/><Setter Property="Canvas.Top" Value="{Binding ChartY}"/></Style></ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate><DataTemplate>
                <TextBlock Text="{Binding BarValueDisplay}" Width="58" Margin="-29,-22,0,0" TextAlignment="Center" Foreground="{DynamicResource StatisticsSecondaryBrush}">
                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource TrendAxisTextStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsSevenDaysRange, RelativeSource={RelativeSource AncestorType=views:GoalInvestmentTrendChart}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        <DataTrigger Binding="{Binding IsHovered}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        <DataTrigger Binding="{Binding Minutes}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl x:Name="TrendWeekdayLabels" IsHitTestVisible="False" ItemsSource="{Binding TrendPoints}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding ChartX}"/><Setter Property="Canvas.Top" Value="172"/></Style></ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate><DataTemplate>
                <TextBlock Text="{Binding WeekdayDisplay}" Width="50" Margin="-25,0,0,0" TextAlignment="Center" FontFamily="{DynamicResource FontFamilyPrimary}">
                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource TrendAxisTextStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSevenDaysRange, RelativeSource={RelativeSource AncestorType=views:GoalInvestmentTrendChart}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border x:Name="TrendInteractionArea" Width="588" Height="141" Margin="48,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="4" Background="Transparent"
                MouseMove="InteractionArea_MouseMove" MouseLeave="InteractionArea_MouseLeave"/>

      </Grid>

    </Grid>
</UserControl>
