<UserControl x:Class="FocusApp.Desktop.Views.GoalInvestmentTrendChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FocusApp.Desktop.ViewModels"
             Width="592" Height="188"
             TextElement.FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
             TextElement.FontSize="{DynamicResource BodyFontSize}" TextElement.FontWeight="{DynamicResource BodyFontWeight}"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="TrendVerticalGuideLineStyle" TargetType="{x:Type Line}">
            <Setter Property="Y2" Value="146"/>
            <Setter Property="Stroke" Value="#40FF9C4A"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeDashArray" Value="3,3"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </UserControl.Resources>
    <Grid ClipToBounds="False">
        <ItemsControl IsHitTestVisible="False" ItemsSource="{Binding YAxisTicks}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter"><Setter Property="Canvas.Top" Value="{Binding ChartY}"/></Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GoalInvestmentTrendAxisTickViewModel}">
                    <Canvas Width="592" Height="1">
                        <TextBlock Canvas.Left="0" Canvas.Top="-7" Width="38" TextAlignment="Right" FontSize="{DynamicResource CaptionFontSize}" FontWeight="{DynamicResource CaptionFontWeight}" Foreground="#8D96A8" Text="{Binding Label}"/>
                        <Line X1="44" X2="586" StrokeThickness="1">
                            <Line.Style><Style TargetType="Line"><Setter Property="Stroke" Value="#F1F3F6"/><Setter Property="StrokeDashArray" Value="3,4"/><Style.Triggers><DataTrigger Binding="{Binding ShowGuideLine}" Value="False"><Setter Property="Stroke" Value="#E9EDF2"/><Setter Property="StrokeDashArray" Value="0"/></DataTrigger></Style.Triggers></Style></Line.Style>
                        </Line>
                    </Canvas>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl x:Name="TrendBars" IsHitTestVisible="False" ItemsSource="{Binding TrendPoints}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding BarLeft}"/><Setter Property="Canvas.Top" Value="{Binding ChartY}"/></Style></ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:GoalInvestmentTrendPointViewModel}">
                <Border Width="{Binding BarWidth}" Height="{Binding BarHeight}" CornerRadius="5,5,3,3">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Offset="0" Color="#FFAD61"/><GradientStop Offset="1" Color="#FFF1E5"/></LinearGradientBrush></Border.Background>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>

        <Line x:Name="HoverGuideLine" X1="{Binding HoveredPoint.ChartX}" X2="{Binding HoveredPoint.ChartX}" Y1="{Binding HoveredPoint.ChartY}">
            <Line.Style><Style TargetType="Line" BasedOn="{StaticResource TrendVerticalGuideLineStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTooltipOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Line.Style>
        </Line>

        <ItemsControl Panel.ZIndex="2" IsHitTestVisible="False" ItemsSource="{Binding TrendPoints}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding ChartX}"/><Setter Property="Canvas.Top" Value="{Binding ChartY}"/></Style></ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GoalInvestmentTrendPointViewModel}">
                    <Canvas Width="1" Height="1" ClipToBounds="False">
                        <Ellipse Canvas.Left="-4" Canvas.Top="-4" Width="8" Height="8" Fill="#FF8A28">
                            <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsHovered}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                        </Ellipse>
                    </Canvas>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl Panel.ZIndex="2" IsHitTestVisible="False" ItemsSource="{Binding TrendPoints}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding ChartX}"/><Setter Property="Canvas.Top" Value="{Binding AxisLabelY}"/></Style></ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GoalInvestmentTrendPointViewModel}">
                    <TextBlock Width="50" Margin="-25,0,0,0" TextAlignment="Center" FontSize="{DynamicResource CaptionFontSize}" FontWeight="{DynamicResource CaptionFontWeight}" Foreground="#8D96A8" Text="{Binding AxisLabel}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowAxisLabel}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border x:Name="TrendInteractionArea" Width="542" Height="141" Margin="44,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="4" Background="Transparent"
                MouseMove="InteractionArea_MouseMove" MouseLeave="InteractionArea_MouseLeave"/>
    </Grid>
</UserControl>
