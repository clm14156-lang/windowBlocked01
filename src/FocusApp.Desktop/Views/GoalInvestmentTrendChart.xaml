<UserControl x:Class="FocusApp.Desktop.Views.GoalInvestmentTrendChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FocusApp.Desktop.ViewModels"
             Width="638" Height="166"
             TextElement.FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
             TextElement.FontSize="13" TextElement.FontWeight="Normal"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="TrendVerticalGuideLineStyle" TargetType="{x:Type Line}">
            <Setter Property="Y1" Value="28"/>
            <Setter Property="Y2" Value="130"/>
            <Setter Property="Stroke" Value="#C9CDD4"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeDashArray" Value="3,3"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </UserControl.Resources>
    <Grid ClipToBounds="False">
        <ItemsControl IsHitTestVisible="False" ItemsSource="{Binding YAxisTicks}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter"><Setter Property="Canvas.Top" Value="{Binding ChartY}"/></Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GoalInvestmentTrendAxisTickViewModel}">
                    <Canvas Width="638" Height="1">
                        <TextBlock Canvas.Left="0" Canvas.Top="-9" Width="40" TextAlignment="Right" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{Binding Label}"/>
                        <Line X1="44" X2="610" Stroke="#ECEEF1" StrokeThickness="1">
                            <Line.Style><Style TargetType="Line"><Setter Property="StrokeDashArray" Value="3,4"/><Style.Triggers><DataTrigger Binding="{Binding ShowGuideLine}" Value="False"><Setter Property="StrokeDashArray" Value="0"/></DataTrigger></Style.Triggers></Style></Line.Style>
                        </Line>
                    </Canvas>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Path Data="{Binding TrendAreaGeometry}" IsHitTestVisible="False">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#30FF7A00"/>
                    <GradientStop Offset="0.62" Color="#12FF7A00"/>
                    <GradientStop Offset="1" Color="#00FF7A00"/>
                </LinearGradientBrush>
            </Path.Fill>
        </Path>
        <Path Data="{Binding TrendCurveGeometry}" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"/>

        <Line x:Name="HoverGuideLine" X1="{Binding HoveredPoint.ChartX}" X2="{Binding HoveredPoint.ChartX}">
            <Line.Style><Style TargetType="Line" BasedOn="{StaticResource TrendVerticalGuideLineStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTooltipOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Line.Style>
        </Line>

        <ItemsControl Panel.ZIndex="2" IsHitTestVisible="False" ItemsSource="{Binding TrendPoints}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding ChartX}"/><Setter Property="Canvas.Top" Value="{Binding ChartY}"/></Style></ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GoalInvestmentTrendPointViewModel}">
                    <Canvas Width="1" Height="1" ClipToBounds="False">
                        <Ellipse Canvas.Left="-5" Canvas.Top="-5" Width="10" Height="10" Fill="{DynamicResource AccentPrimary}" Stroke="White" StrokeThickness="2">
                            <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsMarkerVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsHovered}" Value="True"><Setter Property="Width" Value="12"/><Setter Property="Height" Value="12"/><Setter Property="Canvas.Left" Value="-6"/><Setter Property="Canvas.Top" Value="-6"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                        </Ellipse>
                    </Canvas>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl Panel.ZIndex="2" IsHitTestVisible="False" ItemsSource="{Binding TrendPoints}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding ChartX}"/><Setter Property="Canvas.Top" Value="{Binding AxisLabelY}"/></Style></ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GoalInvestmentTrendPointViewModel}">
                    <TextBlock Width="50" Margin="-25,0,0,0" TextAlignment="Center" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{Binding AxisLabel}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowAxisLabel}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border x:Name="TrendInteractionArea" Width="566" Height="132" Margin="44,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="4" Background="Transparent"
                MouseEnter="InteractionArea_MouseEnter" MouseMove="InteractionArea_MouseMove" MouseLeave="InteractionArea_MouseLeave"/>
    </Grid>
</UserControl>
