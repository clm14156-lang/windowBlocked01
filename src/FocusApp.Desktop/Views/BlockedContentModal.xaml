<UserControl x:Class="FocusApp.Desktop.Views.BlockedContentModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             Width="500"
             Height="380"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="BlockedTabStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Width" Value="108" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid Background="{DynamicResource TransparentBrush}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding Content}" />
                            <Border x:Name="Indicator" Width="48" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource TransparentBrush}" CornerRadius="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="Medium" />
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlockedScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="5" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Background" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2.5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="9" />
            <Setter Property="Margin" Value="0,2,2,2" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource BlockedScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource OverlayBorder}"
            BorderThickness="1"
            CornerRadius="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Direction="270"
                              Opacity="0.12"
                              ShadowDepth="6" />
        </Border.Effect>
        <Grid Margin="28,22,28,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="42" />
                <RowDefinition Height="6" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock VerticalAlignment="Center"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Text="{DynamicResource BlockedContentTitle}" />

            <Grid Grid.Row="2" Height="42">
                <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource OverlayBorder}" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="{Binding AllTabText}" Command="{Binding SelectAllCommand}" IsChecked="{Binding IsAllSelected, Mode=OneWay}" Style="{StaticResource BlockedTabStyle}" />
                    <RadioButton Content="{Binding WebsiteTabText}" Command="{Binding SelectWebsitesCommand}" IsChecked="{Binding IsWebsitesSelected, Mode=OneWay}" Style="{StaticResource BlockedTabStyle}" />
                    <RadioButton Content="{Binding ApplicationTabText}" Command="{Binding SelectApplicationsCommand}" IsChecked="{Binding IsApplicationsSelected, Mode=OneWay}" Style="{StaticResource BlockedTabStyle}" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="4"
                          Focusable="True"
                          CanContentScroll="True"
                          PanningMode="VerticalOnly"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding VisibleItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:BlockedContentRow DataContext="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
