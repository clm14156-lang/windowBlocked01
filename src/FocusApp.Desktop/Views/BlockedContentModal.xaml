<UserControl x:Class="FocusApp.Desktop.Views.BlockedContentModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             Width="550" Height="360" HorizontalAlignment="Center" VerticalAlignment="Center"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="BlockedTabStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Width" Value="105" /><Setter Property="Height" Value="42" /><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type RadioButton}"><Grid><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /><Border x:Name="Indicator" Width="72" Height="2" VerticalAlignment="Bottom" Background="Transparent" /></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" /><Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentPrimary}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="12">
        <Grid Margin="24,0">
            <TextBlock Margin="0,20,0,0" VerticalAlignment="Top" FontSize="20" FontWeight="SemiBold" Text="{DynamicResource BlockedContentTitle}" />
            <Button Width="30" Height="30" Margin="0,12,-8,0" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding CloseCommand}" Style="{StaticResource WindowChromeButtonStyle}"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE8BB;" /></Button>
            <Grid Margin="0,62,0,0" VerticalAlignment="Top" Height="42">
                <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource BorderPrimary}" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="{Binding AllTabText}" Command="{Binding SelectAllCommand}" IsChecked="{Binding IsAllSelected, Mode=OneWay}" Style="{StaticResource BlockedTabStyle}" />
                    <RadioButton Content="{Binding WebsiteTabText}" Command="{Binding SelectWebsitesCommand}" IsChecked="{Binding IsWebsitesSelected, Mode=OneWay}" Style="{StaticResource BlockedTabStyle}" />
                    <RadioButton Content="{Binding ApplicationTabText}" Command="{Binding SelectApplicationsCommand}" IsChecked="{Binding IsApplicationsSelected, Mode=OneWay}" Style="{StaticResource BlockedTabStyle}" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,112,0,18" Height="230">
                <ScrollViewer Focusable="True" CanContentScroll="True" PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding VisibleItems}">
                        <ItemsControl.ItemTemplate><DataTemplate><views:BlockedContentRow DataContext="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
