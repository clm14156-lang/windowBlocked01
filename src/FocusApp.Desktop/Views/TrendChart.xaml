<UserControl x:Class="FocusApp.Desktop.Views.TrendChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FocusApp.Desktop.ViewModels"
             Width="578"
             Height="155"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid ClipToBounds="False">
        <ItemsControl IsHitTestVisible="False"
                      ItemsSource="{Binding YAxisTicks}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Top" Value="{Binding ChartY}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:YAxisTickViewModel}">
                    <Line X1="8"
                          X2="570"
                          Y1="0"
                          Y2="0"
                          Stroke="#F1F3F6"
                          StrokeDashArray="3,4"
                          StrokeThickness="1"
                          Opacity="1">
                        <Line.Style>
                            <Style TargetType="Line">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowGuideLine}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Line.Style>
                    </Line>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl x:Name="TrendBars" IsHitTestVisible="False" ItemsSource="{Binding TrendPoints}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding BarLeft}" /><Setter Property="Canvas.Top" Value="{Binding ChartY}" /></Style></ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TrendDataPointViewModel}">
                    <Border Width="{Binding BarWidth}" Height="{Binding BarHeight}" CornerRadius="5,5,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#FFAD61" />
                                <GradientStop Offset="1" Color="#FFF1E5" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Line x:Name="TrendCrosshair"
              X1="{Binding HoveredPoint.ChartX}"
              X2="{Binding HoveredPoint.ChartX}"
              Y1="0"
              Y2="120"
              Stroke="#E9EDF2"
              StrokeThickness="1"
              IsHitTestVisible="False">
            <Line.Style>
                <Style TargetType="{x:Type Line}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTooltipOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Line.Style>
        </Line>

        <ItemsControl Panel.ZIndex="1" IsHitTestVisible="False" ItemsSource="{Binding TrendPoints}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding ChartX}" /><Setter Property="Canvas.Top" Value="{Binding ChartY}" /></Style></ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TrendDataPointViewModel}">
                    <Canvas Width="1" Height="1" ClipToBounds="False">
                        <TextBlock Canvas.Left="-26"
                                   Canvas.Top="-29"
                                   Width="52"
                                   TextAlignment="Center"
                                   FontSize="12"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="{Binding DurationLabel}">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsValueLabelVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <Button Canvas.Left="-10"
                                Canvas.Top="-10"
                                Width="20"
                                Height="20"
                                Background="{DynamicResource TransparentBrush}"
                                BorderThickness="0"
                                Focusable="False"
                                FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Ellipse Width="12" Height="12" Fill="{DynamicResource AccentPrimary}" Stroke="{DynamicResource SurfacePrimary}" StrokeThickness="2">
                                <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsMarkerVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding IsHovered}" Value="True"><Setter Property="Width" Value="14" /><Setter Property="Height" Value="14" /></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                            </Ellipse>
                        </Button>
                    </Canvas>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl Panel.ZIndex="2" IsHitTestVisible="False" ItemsSource="{Binding TrendPoints}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding ChartX}" /><Setter Property="Canvas.Top" Value="{Binding AxisLabelY}" /></Style></ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TrendDataPointViewModel}">
                    <TextBlock Width="58"
                               Margin="-29,0,0,0"
                               TextAlignment="Center"
                               FontSize="{DynamicResource CaptionFontSize}"
                               FontWeight="{DynamicResource CaptionFontWeight}"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="{Binding DateLabel}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsDateLabelVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border x:Name="TrendInteractionArea"
                Width="562"
                Height="120"
                Margin="8,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="3"
                Background="Transparent"
                MouseMove="TrendInteractionArea_MouseMove"
                MouseLeave="TrendInteractionArea_MouseLeave" />
    </Grid>
</UserControl>
