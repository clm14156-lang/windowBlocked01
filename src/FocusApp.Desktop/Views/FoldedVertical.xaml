<UserControl x:Class="FocusApp.Desktop.Views.FoldedVertical"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="50"
             Height="235"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Border Margin="2"
            Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource BorderPrimary}"
            BorderThickness="1"
            CornerRadius="15">
        <Grid Margin="2,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="{DynamicResource FontFamilyNumeric}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Text="{Binding VerticalRemainingDisplay}" />
            <ProgressBar Grid.Row="1"
                         Width="6"
                         Margin="0,8,0,10"
                         HorizontalAlignment="Center"
                         Maximum="1"
                         Minimum="0"
                         Orientation="Vertical"
                         Value="{Binding RemainingProgress, Mode=OneWay}"
                         Foreground="{DynamicResource AccentPrimary}"
                         Background="{DynamicResource BackgroundSecondary}" />
        </Grid>
    </Border>
</UserControl>
