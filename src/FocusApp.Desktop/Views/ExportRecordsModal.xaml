<UserControl x:Class="FocusApp.Desktop.Views.ExportRecordsModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="400"
             Height="360"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="ExportPlainButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBody"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBody" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBody" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExportOptionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ExportPlainButtonStyle}">
            <Setter Property="Height" Value="60" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="OptionRowBackground" Background="{TemplateBinding Background}" CornerRadius="10">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimary}"
                                           Text="{TemplateBinding Content}" />
                                <TextBlock Grid.Column="1"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Text="{TemplateBinding Tag}" />
                                <TextBlock Grid.Column="2"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextTertiary}"
                                           Text="&#xE76C;" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="OptionRowBackground" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="OptionRowBackground" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExportSecondaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ExportPlainButtonStyle}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style x:Key="ExportPrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ExportPlainButtonStyle}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="{DynamicResource FocusButtonBackground}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBody" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBody" Property="Background" Value="{DynamicResource FocusButtonHoverBackground}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBody" Property="Background" Value="{DynamicResource FocusButtonPressedBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExportRadioOptionStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Height" Value="62" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="RadioRing" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{DynamicResource TextWeak}" BorderThickness="1.5" CornerRadius="8">
                                <Ellipse x:Name="RadioDot" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource AccentPrimary}" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="4,0,6,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="RadioRing" Property="BorderBrush" Value="{DynamicResource AccentPrimary}" /><Setter TargetName="RadioDot" Property="Visibility" Value="Visible" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExportCheckOptionStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Height" Value="68" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="CheckBoxBody" Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource TextWeak}" BorderThickness="1.2" CornerRadius="4">
                                <TextBlock x:Name="CheckGlyph" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WhiteText}" Text="✓" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="4,0,6,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckBoxBody" Property="Background" Value="{DynamicResource AccentPrimary}" /><Setter TargetName="CheckBoxBody" Property="BorderBrush" Value="{DynamicResource AccentPrimary}" /><Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource TransparentBrush}">
        <Border Width="400"
                Height="360"
                Background="{DynamicResource SurfacePrimary}"
                BorderBrush="{DynamicResource OverlayBorder}"
                BorderThickness="1"
                CornerRadius="18">
            <Border.Effect><DropShadowEffect BlurRadius="24" Direction="270" Opacity="0.16" ShadowDepth="7" /></Border.Effect>
            <Grid Margin="20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="78" />
                    <RowDefinition Height="182" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="42" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="50" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource TransparentBrush}" CornerRadius="12">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{DynamicResource AccentPrimary}" Text="&#xE898;" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,34,0" VerticalAlignment="Center">
                        <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource ExportRecordsTitle}" />
                        <TextBlock Margin="0,6,0,0" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource ExportRecordsSubtitle}" />
                    </StackPanel>
                    <Button Grid.Column="1" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0" AutomationProperties.Name="关闭导出弹窗" Command="{Binding CloseCommand}" Style="{StaticResource ExportPlainButtonStyle}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="&#xE8BB;" />
                    </Button>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="60" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="60" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="60" />
                        </Grid.RowDefinitions>
                        <Button x:Name="TimeRangeOptionButton"
                                Grid.Row="0"
                                AutomationProperties.Name="时间范围"
                                Command="{Binding ToggleTimeRangePopupCommand}"
                                Content="{DynamicResource ExportRecordsTimeRange}"
                                Style="{StaticResource ExportOptionButtonStyle}"
                                Tag="{Binding SelectedTimeRange}" />
                        <Border Grid.Row="1" Margin="18,0" Background="{DynamicResource BorderPrimary}" />
                        <Button x:Name="FileFormatOptionButton"
                                Grid.Row="2"
                                AutomationProperties.Name="文件格式"
                                Command="{Binding ToggleFileFormatPopupCommand}"
                                Content="{DynamicResource ExportRecordsFileFormat}"
                                Style="{StaticResource ExportOptionButtonStyle}"
                                Tag="{Binding SelectedFileFormat}" />
                        <Border Grid.Row="3" Margin="18,0" Background="{DynamicResource BorderPrimary}" />
                        <Button x:Name="IncludedContentOptionButton"
                                Grid.Row="4"
                                AutomationProperties.Name="包含内容"
                                Command="{Binding ToggleIncludedContentPopupCommand}"
                                Content="{DynamicResource ExportRecordsIncludedContent}"
                                Style="{StaticResource ExportOptionButtonStyle}"
                                Tag="{Binding IncludedContentSummary}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="3">
                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextTertiary}" Text="{DynamicResource ExportRecordsPrivacyHint}" />
                    <Grid HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="8" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" AutomationProperties.Name="取消导出" Command="{Binding CancelCommand}" Content="{DynamicResource ExportRecordsCancel}" Style="{StaticResource ExportSecondaryButtonStyle}" />
                        <Button Grid.Column="2" AutomationProperties.Name="导出" Command="{Binding ExportCommand}" Style="{StaticResource ExportPrimaryButtonStyle}">
                            <TextBlock FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource WhiteText}"
                                       Text="{DynamicResource ExportRecordsExport}" />
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Popup x:Name="TimeRangePopup"
               Width="300"
               Height="144"
               AllowsTransparency="True"
               CustomPopupPlacementCallback="TimeRangePopup_Placement"
               IsOpen="{Binding IsTimeRangePopupOpen, Mode=TwoWay}"
               Placement="Custom"
               PlacementTarget="{Binding ElementName=TimeRangeOptionButton}"
               PopupAnimation="Fade"
               StaysOpen="False">
            <Border Width="300" Height="136" Padding="10" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource OverlayBorder}" BorderThickness="1" CornerRadius="12">
                <Border.Effect><DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.14" ShadowDepth="4" /></Border.Effect>
                <StackPanel>
                    <RadioButton GroupName="ExportTimeRange" IsChecked="{Binding IsCurrentMonthSelected, Mode=TwoWay}" Style="{StaticResource ExportRadioOptionStyle}">
                        <StackPanel><TextBlock FontSize="13" FontWeight="Medium" Text="{DynamicResource ExportRecordsCurrentMonth}" /><TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource ExportRecordsCurrentMonthHint}" /></StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="ExportTimeRange" IsChecked="{Binding IsAllRecordsSelected, Mode=TwoWay}" Style="{StaticResource ExportRadioOptionStyle}">
                        <StackPanel><TextBlock FontSize="13" FontWeight="Medium" Text="{DynamicResource ExportRecordsAllRecords}" /><TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource ExportRecordsAllRecordsHint}" /></StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="FileFormatPopup"
               Width="320"
               Height="164"
               AllowsTransparency="True"
               CustomPopupPlacementCallback="FileFormatPopup_Placement"
               IsOpen="{Binding IsFileFormatPopupOpen, Mode=TwoWay}"
               Placement="Custom"
               PlacementTarget="{Binding ElementName=FileFormatOptionButton}"
               PopupAnimation="Fade"
               StaysOpen="False">
            <Border Width="320" Height="156" Padding="10" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource OverlayBorder}" BorderThickness="1" CornerRadius="12">
                <Border.Effect><DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.14" ShadowDepth="4" /></Border.Effect>
                <StackPanel>
                    <RadioButton Height="68" GroupName="ExportFileFormat" IsChecked="{Binding IsExcelSelected, Mode=TwoWay}" Style="{StaticResource ExportRadioOptionStyle}">
                        <Grid><StackPanel><TextBlock FontSize="13" FontWeight="Medium" Text="{DynamicResource ExportRecordsExcel}" /><TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource ExportRecordsExcelHint}" /></StackPanel><Border Width="44" Height="22" HorizontalAlignment="Right" Background="#E9F7EF" CornerRadius="6"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#1F9D55" Text="XLSX" /></Border></Grid>
                    </RadioButton>
                    <RadioButton Height="68" GroupName="ExportFileFormat" IsChecked="{Binding IsCsvSelected, Mode=TwoWay}" Style="{StaticResource ExportRadioOptionStyle}">
                        <Grid><StackPanel><TextBlock FontSize="13" FontWeight="Medium" Text="{DynamicResource ExportRecordsCsv}" /><TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource ExportRecordsCsvHint}" /></StackPanel><Border Width="44" Height="22" HorizontalAlignment="Right" Background="#E9F7EF" CornerRadius="6"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#1F9D55" Text="CSV" /></Border></Grid>
                    </RadioButton>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="IncludedContentPopup"
               Width="330"
               Height="226"
               AllowsTransparency="True"
               CustomPopupPlacementCallback="IncludedContentPopup_Placement"
               IsOpen="{Binding IsIncludedContentPopupOpen, Mode=TwoWay}"
               Placement="Custom"
               PlacementTarget="{Binding ElementName=IncludedContentOptionButton}"
               PopupAnimation="Fade"
               StaysOpen="False">
            <Border Width="330" Height="218" Padding="10" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource OverlayBorder}" BorderThickness="1" CornerRadius="12">
                <Border.Effect><DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.14" ShadowDepth="4" /></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="68" /><RowDefinition Height="68" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <CheckBox Grid.Row="0" IsChecked="{Binding IncludeFocusRecords, Mode=TwoWay}" Style="{StaticResource ExportCheckOptionStyle}">
                        <StackPanel><TextBlock FontSize="13" FontWeight="Medium" Text="{DynamicResource ExportRecordsFocusRecords}" /><TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource ExportRecordsFocusRecordsHint}" /></StackPanel>
                    </CheckBox>
                    <CheckBox Grid.Row="1" IsChecked="{Binding IncludeTaskDetails, Mode=TwoWay}" Style="{StaticResource ExportCheckOptionStyle}">
                        <StackPanel><TextBlock FontSize="13" FontWeight="Medium" Text="{DynamicResource ExportRecordsTaskDetails}" /><TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource ExportRecordsTaskDetailsHint}" /></StackPanel>
                    </CheckBox>
                    <Button Grid.Row="2" Height="38" Margin="4,8,4,0" VerticalAlignment="Bottom" Command="{Binding CompleteIncludedContentCommand}" Content="{DynamicResource ExportRecordsDone}" Style="{StaticResource ExportSecondaryButtonStyle}" />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
