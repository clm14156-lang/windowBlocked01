<UserControl x:Class="FocusApp.Desktop.Views.WebsiteLimitModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="400" Height="300"
             HorizontalAlignment="Center" VerticalAlignment="Center"
             KeyboardNavigation.TabNavigation="Cycle"
             IsVisibleChanged="Modal_IsVisibleChanged" PreviewKeyDown="Modal_PreviewKeyDown"
             FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="LimitAction" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                   FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="11"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VipContent" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WebsiteLimit.IsVip}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NormalContent" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding WebsiteLimit.IsVip}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}"
            BorderThickness="1" CornerRadius="17">
        <Border.Effect>
            <DropShadowEffect Color="#52627F" BlurRadius="19" ShadowDepth="3" Opacity="0.22" />
        </Border.Effect>
        <Grid>
            <Grid Margin="28,20,28,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="68" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="58" />
                    <RowDefinition Height="41" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="网站数量已达上限" VerticalAlignment="Center"
                           FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                <Border Grid.Row="1" Width="57" Height="57" CornerRadius="16"
                        Background="#FFF0E1" Style="{StaticResource NormalContent}">
                    <Viewbox Width="44" Height="40">
                        <Canvas Width="44" Height="40">
                            <Path Data="M3,13 L13,19 L22,5 L31,19 L41,13 L35,35 L9,35 Z"
                                  Stroke="#FF8000" StrokeThickness="2.7" StrokeLineJoin="Round" />
                            <Ellipse Width="5" Height="5" Canvas.Left="0.5" Canvas.Top="10.5" Fill="#FF8000" />
                            <Ellipse Width="6" Height="6" Canvas.Left="19" Canvas.Top="2" Fill="#FF8000" />
                            <Ellipse Width="5" Height="5" Canvas.Left="38.5" Canvas.Top="10.5" Fill="#FF8000" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <Border Grid.Row="1" Width="59" Height="59" CornerRadius="30"
                        Background="#FFF0E1" Style="{StaticResource VipContent}">
                    <Grid Width="36" Height="36">
                        <Ellipse Stroke="#FF8000" StrokeThickness="2.6" />
                        <Border Width="3.5" Height="13" Margin="0,8,0,0" VerticalAlignment="Top"
                                Background="#FF8000" CornerRadius="1.5" />
                        <Ellipse Width="4" Height="4" Margin="0,0,0,8" VerticalAlignment="Bottom" Fill="#FF8000" />
                    </Grid>
                </Border>
                <TextBlock Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="20" Foreground="{DynamicResource TextPrimary}">
                    <Run Text="已添加 " /><Run Text="{Binding WebsiteLimit.Count, Mode=OneWay}" FontWeight="Bold" Foreground="#FF8000" /><Run Text=" / " FontWeight="Bold" Foreground="#FF8000" /><Run Text="{Binding WebsiteLimit.Limit, Mode=OneWay}" FontWeight="Bold" Foreground="#FF8000" /><Run Text=" 个网站" />
                </TextBlock>
                <TextBlock Grid.Row="3" VerticalAlignment="Center" TextAlignment="Center" FontSize="14"
                           LineHeight="23" LineStackingStrategy="BlockLineHeight"
                           Foreground="{DynamicResource TextSecondary}" Style="{StaticResource NormalContent}">
                    <Run Text="普通用户最多添加 " /><Run Text="{Binding WebsiteLimit.Limit, Mode=OneWay}" /><Run Text=" 个网站。" />
                    <LineBreak /><Run Text="开通高级会员，可获得更多网站屏蔽额度。" />
                </TextBlock>
                <TextBlock Grid.Row="3" Width="270" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="14"
                           LineHeight="22" LineStackingStrategy="BlockLineHeight"
                           Foreground="{DynamicResource TextSecondary}" Style="{StaticResource VipContent}"
                           Text="网站数量已达上限，可先删除不需要的网站后再继续添加。" />
                <Grid Grid.Row="4" Grid.RowSpan="2" Style="{StaticResource VipContent}">
                    <Button Content="知道了" Height="42" VerticalAlignment="Center" Style="{StaticResource LimitAction}"
                            Foreground="{DynamicResource TextPrimary}" Background="Transparent"
                            BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1.3"
                            Command="{Binding CloseWebsiteLimitCommand}" />
                </Grid>
                <Grid Grid.Row="4" Style="{StaticResource NormalContent}">
                    <Button Content="开通高级会员" Style="{StaticResource LimitAction}"
                            Foreground="White" Background="#FF8000" BorderThickness="0"
                            Command="{Binding UpgradeWebsiteLimitCommand}" />
                </Grid>
                <Grid Grid.Row="5" Margin="0,1,0,-5" Style="{StaticResource NormalContent}">
                    <Button Content="暂不开通" HorizontalAlignment="Center" Padding="10,0"
                            Style="{StaticResource LimitAction}" FontWeight="Normal"
                            Foreground="{DynamicResource TextSecondary}" Background="Transparent" BorderThickness="0"
                            Command="{Binding CloseWebsiteLimitCommand}" />
                </Grid>
            </Grid>
            <Button x:Name="CloseButton" AutomationProperties.Name="关闭网站数量提醒"
                    Style="{DynamicResource ModalCloseButtonStyle}" Margin="0,20,21,0"
                    Command="{Binding CloseWebsiteLimitCommand}" />
        </Grid>
    </Border>
</UserControl>
