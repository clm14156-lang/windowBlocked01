<UserControl x:Class="FocusApp.Desktop.Views.CalendarFocusTimelineToolTip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI" UseLayoutRounding="True" MaxWidth="260">
    <UserControl.Resources>
        <Style x:Key="SessionToolTipStyle" TargetType="ToolTip">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
                <ContentPresenter/>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="8,8,8,0">
        <Border Background="White" BorderBrush="#E9ECF1" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,7">
            <Border.Effect><DropShadowEffect Color="#243047" Opacity="0.09" BlurRadius="12" ShadowDepth="2"/></Border.Effect>
            <StackPanel>
                <TextBlock Text="{Binding TimeRangeDisplay}" FontSize="11" Foreground="#778191" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding CalendarDurationDisplay}" FontSize="12" Foreground="#454C57" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding TaskName}" FontSize="11" Foreground="#778191" TextWrapping="Wrap" Margin="0,5,0,0" MaxWidth="220">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                        <DataTrigger Binding="{Binding TaskName}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        <DataTrigger Binding="{Binding TaskName}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
        <Path Width="14" Height="8" Data="M 0,0 L 7,7 L 14,0" Fill="White" Stroke="#E9ECF1" StrokeThickness="1"
              HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
    </Grid>
</UserControl>
