<UserControl x:Class="FocusApp.Desktop.Views.CalendarFocusTimelineToolTip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI" UseLayoutRounding="True" MaxWidth="260">
    <UserControl.Resources>
        <Style x:Key="SessionToolTipStyle" TargetType="ToolTip">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
                <ContentPresenter/>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="8,8,8,0">
        <Border Background="White" BorderBrush="#E9ECF1" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,7">
            <Border.Effect><DropShadowEffect Color="#243047" Opacity="0.09" BlurRadius="12" ShadowDepth="2"/></Border.Effect>
            <StackPanel>
                <TextBlock Text="{Binding CalendarTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#202A38" TextWrapping="Wrap"/>
                <TextBlock FontSize="11" Foreground="#8490A0" Margin="0,5,0,0" TextWrapping="Wrap">
                    <Run Text="{Binding TimeRangeDisplay, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding CalendarDurationDisplay, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Border>
        <Path Width="14" Height="8" Data="M 0,0 L 7,7 L 14,0" Fill="White" Stroke="#E9ECF1" StrokeThickness="1"
              HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
    </Grid>
</UserControl>
