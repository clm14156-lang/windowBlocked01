<UserControl x:Class="FocusApp.Desktop.Views.CalendarFocusTimelineToolTip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             x:Name="Root" FontFamily="{DynamicResource FontFamilyPrimary}" UseLayoutRounding="True"
             MaxWidth="240">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/FocusApp.Desktop;component/Resources/PoptipStyles.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="TaskScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                    <Track.Thumb><Thumb MinHeight="22"><Thumb.Template><ControlTemplate TargetType="Thumb">
                        <Border Width="3" CornerRadius="1.5" Background="#D9DDE3"/>
                    </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                </Track>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="MoreLinkStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PoptipSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{DynamicResource SecondaryFontSize}"/>
            <Setter Property="FontWeight" Value="{DynamicResource SecondaryFontWeight}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                           Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FF8000"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="#FF8000"/></Trigger>
            </Style.Triggers>
        </Style>
          </ResourceDictionary>
    </UserControl.Resources>
<views:PoptipChrome x:Name="PoptipSurface" Style="{StaticResource PoptipSurfaceStyle}"
                        PointerLeft="{Binding PointerLeft, ElementName=Root}">
            <StackPanel x:Name="PoptipLayout">
                <TextBlock x:Name="GoalTitle" Text="{Binding Record.GoalName}" Margin="0,0,0,4">
                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PoptipPrimaryTextStyle}"><Style.Triggers>
                        <DataTrigger Binding="{Binding Record.HasGoal}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <TextBlock x:Name="TimeSummary" Text="{Binding Record.CalendarPoptipSummaryDisplay}" Style="{StaticResource PoptipSecondaryTextStyle}"/>
                <StackPanel x:Name="CompletedContent">
                    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
                        <DataTrigger Binding="{Binding HasTasks}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers></Style></StackPanel.Style>
                    <Border Height="1" Background="#F0F2F5" Margin="0,11,0,7"/>
                    <ScrollViewer x:Name="TaskScroll" Height="{Binding TaskViewportHeight}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False" PanningMode="VerticalOnly">
                        <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Disabled"/><Style.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></DataTrigger>
                        </Style.Triggers></Style></ScrollViewer.Style>
                        <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource TaskScrollBar}"/></ScrollViewer.Resources>
                        <ItemsControl x:Name="TaskRows" ItemsSource="{Binding VisibleRows}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Grid x:Name="TaskRow" Height="28">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Grid x:Name="HierarchyLine" Width="24" Visibility="Collapsed">
                                        <Border Width="1" Background="#EDF0F4" HorizontalAlignment="Left" Margin="8,0,0,0"/>
                                        <Border x:Name="ChildBranch" Height="1" Width="9" Background="#EDF0F4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                    <Grid x:Name="CompletionIcon" Grid.Column="1" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Ellipse x:Name="CompletionCircle" Fill="#FF8A24" Stroke="#FF8A24" StrokeThickness="1.3"/>
                                        <Path x:Name="CompletionTick" Data="M 4,8 L 6.7,10.5 L 12,5.5" Stroke="White" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Grid>
                                    <TextBlock x:Name="TaskName" Grid.Column="2" Text="{Binding Name}" Style="{StaticResource PoptipPrimaryTextStyle}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSubTask}" Value="False">
                                        <Setter TargetName="CompletionIcon" Property="Grid.Column" Value="0"/>
                                        <Setter TargetName="TaskName" Property="Grid.Column" Value="1"/>
                                        <Setter TargetName="TaskName" Property="Grid.ColumnSpan" Value="2"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSubTask}" Value="True">
                                        <Setter TargetName="HierarchyLine" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="CompletionCircle" Property="Fill" Value="White"/>
                                        <Setter TargetName="CompletionTick" Property="Stroke" Value="#FF8A24"/>
                                        <Setter TargetName="CompletionIcon" Property="Width" Value="14"/>
                                        <Setter TargetName="CompletionIcon" Property="Height" Value="14"/>
                                        <Setter TargetName="CompletionTick" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.875" ScaleY="0.875"/></Setter.Value></Setter>
                                        <Setter TargetName="TaskName" Property="FontSize" Value="{DynamicResource SecondaryFontSize}"/>
                                        <Setter TargetName="TaskName" Property="FontWeight" Value="{DynamicResource SecondaryFontWeight}"/>
                                        <Setter TargetName="TaskName" Property="Foreground" Value="{StaticResource PoptipSecondaryBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLastChild}" Value="True">
                                        <Setter TargetName="HierarchyLine" Property="Height" Value="14"/>
                                        <Setter TargetName="HierarchyLine" Property="VerticalAlignment" Value="Top"/>
                                        <Setter TargetName="ChildBranch" Property="VerticalAlignment" Value="Bottom"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid Height="26" Margin="24,0,0,0">
                        <Grid.Style><Style TargetType="Grid"><Style.Triggers>
                            <DataTrigger Binding="{Binding HasMore}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers></Style></Grid.Style>
                        <Button x:Name="MoreLink" Content="{Binding MoreDisplay}" Command="{Binding ExpandCommand}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource MoreLinkStyle}"><Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
                            </Style.Triggers></Style></Button.Style>
                        </Button>
                    </Grid>
                </StackPanel>
            </StackPanel>
    </views:PoptipChrome>
</UserControl>
