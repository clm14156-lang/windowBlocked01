<UserControl x:Class="FocusApp.Desktop.Views.AutomaticRuleActivationModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="380"
             Height="278"
             FontFamily="{DynamicResource FontFamilyPrimary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="RuleActivationButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="50" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ContentTemplate" Value="{DynamicResource ThemedButtonTextContentTemplate}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.94" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.88" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RuleActivationSecondaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource RuleActivationButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#0D1424" />
        </Style>
        <Style x:Key="RuleActivationPrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource RuleActivationButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource ModalCommitBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Border x:Name="ModalSurface" Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource OverlayBorder}" BorderThickness="1" CornerRadius="16">
        <Border.Effect><DropShadowEffect Color="#223047" BlurRadius="28" Direction="270" Opacity="0.12" ShadowDepth="6" /></Border.Effect>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Border x:Name="ShieldBackground" Width="72" Height="72" HorizontalAlignment="Center"
                    Background="{DynamicResource AccentTint}" CornerRadius="36">
                <Viewbox Width="38" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Canvas Width="40" Height="48">
                        <Path Data="M20,3 C15,6 9,8 3,8.7 V25 C3,34 10,40.5 20,45 C30,40.5 37,34 37,25 V8.7 C31,8 25,6 20,3 Z"
                              Fill="White" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="3" StrokeLineJoin="Round" />
                        <Path Data="M12,23 L18,29 L29,17.5" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Border>
            <TextBlock x:Name="ActivationTitle" Grid.Row="1" Margin="0,14,0,0" HorizontalAlignment="Center"
                       FontSize="20" FontWeight="SemiBold" Foreground="#0D1424" TextAlignment="Center"
                       Text="{DynamicResource AutomaticRuleActivationTitle}" />
            <TextBlock x:Name="ActivationDescription" Grid.Row="2" Margin="0,8,0,0"
                       FontSize="15" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}"
                       LineHeight="23" TextAlignment="Center" TextWrapping="Wrap"
                       Text="{DynamicResource AutomaticRuleActivationDescription}" />
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CancelButton" Grid.Column="0"
                        AutomationProperties.Name="{DynamicResource AutomaticRuleActivationCancel}"
                        Command="{Binding CloseCommand}" Content="{DynamicResource AutomaticRuleActivationCancel}"
                        Style="{StaticResource RuleActivationSecondaryButtonStyle}" />
                <Button x:Name="ConfirmButton" Grid.Column="2"
                        AutomationProperties.Name="{DynamicResource AutomaticRuleActivationConfirm}"
                        Command="{Binding ConfirmCommand}" Content="{DynamicResource AutomaticRuleActivationConfirm}"
                        Style="{StaticResource RuleActivationPrimaryButtonStyle}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
