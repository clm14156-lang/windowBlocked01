<UserControl x:Class="FocusApp.Desktop.Views.AutomaticRuleActivationModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="440"
             Height="230"
             FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="RuleActivationSecondaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RuleActivationPrimaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Background" Value="{DynamicResource FocusButtonBackground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource FocusButtonHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource FocusButtonPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource OverlayBorder}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Direction="270" Opacity="0.16" ShadowDepth="7" />
        </Border.Effect>
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <Button Width="28"
                    Height="28"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{DynamicResource AutomaticRuleActivationClose}"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource WindowChromeButtonStyle}"
                    ToolTip="{DynamicResource AutomaticRuleActivationClose}">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="&#xE8BB;" />
            </Button>
            <Grid Margin="4,6,30,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="42"
                        Height="42"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{DynamicResource AccentTint}"
                        CornerRadius="21">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="22"
                               Foreground="{DynamicResource AccentPrimary}"
                               Text="&#xE814;" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               Text="{DynamicResource AutomaticRuleActivationTitle}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,10,0,0"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondary}"
                               LineHeight="18"
                               Text="{DynamicResource AutomaticRuleActivationDescription}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="176" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        AutomationProperties.Name="{DynamicResource AutomaticRuleActivationCancel}"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource RuleActivationSecondaryButtonStyle}">
                    <TextBlock FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"
                               Text="{DynamicResource AutomaticRuleActivationCancel}" />
                </Button>
                <Button Grid.Column="2"
                        AutomationProperties.Name="{DynamicResource AutomaticRuleActivationConfirm}"
                        Command="{Binding ConfirmCommand}"
                        Style="{StaticResource RuleActivationPrimaryButtonStyle}">
                    <TextBlock FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource WhiteText}"
                               Text="{DynamicResource AutomaticRuleActivationConfirm}" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
