<UserControl x:Class="FocusApp.Desktop.Views.AboutAppModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource FontFamilyPrimary}" FontSize="{DynamicResource BodyFontSize}"
             UseLayoutRounding="True" SnapsToDevicePixels="True" Focusable="True"
             KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="Modal_PreviewKeyDown" IsVisibleChanged="Modal_IsVisibleChanged">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/Styles.xaml"/></ResourceDictionary.MergedDictionaries>
            <Geometry x:Key="AboutWebsiteIcon">M11,1 A10,10 0 1 1 11,21 A10,10 0 1 1 11,1 M1,11 H21 M11,1 C5,6 5,16 11,21 C17,16 17,6 11,1</Geometry>
            <Geometry x:Key="AboutHelpIcon">M11,4 C8,1 3,1 1,3 L1,20 C4,18 8,18 11,21 C14,18 18,18 21,20 L21,3 C18,1 14,1 11,4 Z M11,4 L11,21 M5,6 H7 M15,6 H17</Geometry>
            <Geometry x:Key="AboutFeedbackIcon">M11,2 C5,2 1,5 1,10 C1,13 3,16 6,17 L5,21 L10,18 C17,19 22,15 22,10 C22,5 17,2 11,2 Z M7,10 H7.1 M11.5,10 H11.6 M16,10 H16.1</Geometry>
            <Geometry x:Key="AboutContactIcon">M3,13 V11 A9,9 0 0 1 21,11 V13 M3,12 H5 V19 H3 Q1,19 1,17 V14 Q1,12 3,12 M21,12 H19 V19 H21 Q23,19 23,17 V14 Q23,12 21,12 M20,19 Q20,23 13,23 M10,23 H13</Geometry>
            <Geometry x:Key="AboutUpdateIcon">M19,8 A8,8 0 0 0 5,4 L2,7 M2,3 L2,7 L6,7 M3,14 A8,8 0 0 0 17,18 L20,15 M16,15 L20,15 L20,19</Geometry>
            <Style x:Key="AboutUpdateButton" TargetType="Button" BasedOn="{StaticResource AuthPrimaryButtonStyle}">
                <Setter Property="Width" Value="90"/><Setter Property="Height" Value="36"/>
                <Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#D8DCE3"/><Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#596272"/>
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyPrimary}"/>
                <Setter Property="FontSize" Value="{DynamicResource ButtonFontSize}"/>
                <Setter Property="FontWeight" Value="{DynamicResource ButtonFontWeight}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="UpdateSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                        <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="UpdateSurface" Property="Background" Value="#F7F8FA"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="UpdateSurface" Property="Background" Value="#ECEFF3"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="UpdateSurface" Property="BorderBrush" Value="#FF7A00"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="UpdateSurface" Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="AboutLinkButton" TargetType="Button">
                <Setter Property="Height" Value="48"/>
                <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="9,0"/>
                <Setter Property="Foreground" Value="#26364B"/>
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyPrimary}"/><Setter Property="FontSize" Value="{DynamicResource ButtonFontSize}"/>
                <Setter Property="FontWeight" Value="{DynamicResource FontWeightSemiBold}"/><Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="LinkSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="6"/></Grid.ColumnDefinitions>
                            <Path Width="22" Height="22" Data="{TemplateBinding Tag}" Stretch="Uniform"
                                  Stroke="#59677C" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,4,0">
                                <TextBlock Text="{TemplateBinding Content}" TextWrapping="NoWrap" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock Text="{Binding Path=(AutomationProperties.HelpText), RelativeSource={RelativeSource TemplatedParent}}" FontSize="{DynamicResource SecondaryFontSize}" FontWeight="Normal" Foreground="#697689" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Path Grid.Column="3" Width="5" Height="9" Data="M0,0 L4,4.5 L0,9" Stretch="Fill" Stroke="#697689" StrokeThickness="1.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LinkSurface" Property="Background" Value="#F6F7F9"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="LinkSurface" Property="Background" Value="#F6F7F9"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="LinkSurface" Property="Background" Value="#EEF0F3"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="LinkSurface" Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="AboutLinkDivider" TargetType="Border">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Margin" Value="9,0"/>
                <Setter Property="Background" Value="#EAEDF1"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
            </Style>
            <Style x:Key="AboutFooterLink" TargetType="Button" BasedOn="{StaticResource HomeLinkButtonStyle}">
                <Setter Property="MinHeight" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="4,0"/>
                <Setter Property="Foreground" Value="#6D7685"/><Setter Property="FontSize" Value="{DynamicResource SecondaryFontSize}"/><Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"/></DataTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="Overlay" Background="{DynamicResource ModalScrim}" MouseLeftButtonDown="Overlay_MouseLeftButtonDown">
        <Border x:Name="ModalSurface" Width="400" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#FFFFFF" BorderBrush="#E3E7EE" BorderThickness="1" CornerRadius="18">
            <Border.Effect><DropShadowEffect Color="#46536B" BlurRadius="22" ShadowDepth="5" Opacity="0.12"/></Border.Effect>
            <Grid>
                <ScrollViewer x:Name="AboutContentScroll" Margin="22,24,22,18" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                    <StackPanel>
                        <Grid x:Name="BrandHeader" Height="112" Margin="4,0,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Width="84" Height="84" Background="#FFF7EF" CornerRadius="24" VerticalAlignment="Top" Margin="0,4,0,0">
                                <Image x:Name="AppLogo" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Source="/FocusApp.Desktop;component/Assets/Icons/Common/shiguang_logo.png"/>
                            </Border>
                            <StackPanel Grid.Column="2" Margin="0,8,0,0">
                                <TextBlock x:Name="AppName" Text="专注时光" FontSize="24" FontWeight="{DynamicResource DialogTitleFontWeight}" Foreground="#15243B"/>
                                <TextBlock x:Name="AppTagline" Text="让专注自然发生" FontSize="{DynamicResource BodyFontSize}" Foreground="#7C8798" Margin="0,4,0,0"/>
                                <Border x:Name="VersionBadge" Height="22" Padding="10,0" Background="#F3F5F7" CornerRadius="11" HorizontalAlignment="Left" Margin="0,6,0,0">
                                    <TextBlock x:Name="AppVersion" FontSize="{DynamicResource SecondaryFontSize}" Foreground="#7B8492" VerticalAlignment="Center"><Run FontFamily="{DynamicResource FontFamilyEnglish}" Text="{Binding Version, Mode=OneWay}"/></TextBlock>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="#EAEDF1"/>
                        <Border x:Name="UpdateCard" Padding="6,16" Background="Transparent">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                <Path Width="25" Height="25" Data="{StaticResource AboutUpdateIcon}" Stretch="Uniform" Stroke="#697384" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="软件更新" FontSize="{DynamicResource SectionTitleFontSize}" FontWeight="{DynamicResource FontWeightSemiBold}" Foreground="#18283D"/>
                                    <TextBlock x:Name="CurrentVersionLabel" FontSize="{DynamicResource SecondaryFontSize}" Foreground="#858E9C" Margin="0,4,0,0"><Run Text="当前版本 "/><Run FontFamily="{DynamicResource FontFamilyEnglish}" Text="{Binding Version, Mode=OneWay}"/></TextBlock>
                                </StackPanel>
                                <Button x:Name="CheckUpdateButton" Grid.Column="4" Content="检查更新" Style="{StaticResource AboutUpdateButton}" Command="{Binding CheckUpdateCommand}" VerticalAlignment="Center" AutomationProperties.Name="检查更新"/>
                            </Grid>
                        </Border>
                        <Border Height="1" Background="#EAEDF1"/>
                        <TextBlock x:Name="RelatedLinksTitle" Text="常用入口" FontSize="{DynamicResource SectionTitleFontSize}" FontWeight="{DynamicResource FontWeightSemiBold}" Foreground="#18283D" Margin="0,16,0,6"/>
                        <StackPanel x:Name="AboutLinks">
                            <Button x:Name="WebsiteButton" Style="{StaticResource AboutLinkButton}" Tag="{StaticResource AboutWebsiteIcon}" Content="官方网站" AutomationProperties.HelpText="了解产品与下载" Command="{Binding OpenLinkCommand}" CommandParameter="Website" AutomationProperties.Name="官方网站"/>
                            <Border Style="{StaticResource AboutLinkDivider}" />
                            <Button x:Name="HelpButton" Style="{StaticResource AboutLinkButton}" Tag="{StaticResource AboutHelpIcon}" Content="帮助中心" AutomationProperties.HelpText="使用指南与常见问题" Command="{Binding OpenLinkCommand}" CommandParameter="Help" AutomationProperties.Name="帮助中心"/>
                            <Border Style="{StaticResource AboutLinkDivider}" />
                            <Button x:Name="FeedbackButton" Style="{StaticResource AboutLinkButton}" Tag="{StaticResource AboutFeedbackIcon}" Content="问题反馈" AutomationProperties.HelpText="提交问题或建议，帮助我们改进" Command="{Binding OpenLinkCommand}" CommandParameter="Feedback" AutomationProperties.Name="问题反馈"/>
                            <Border Style="{StaticResource AboutLinkDivider}" />
                            <Button x:Name="ContactButton" Style="{StaticResource AboutLinkButton}" Tag="{StaticResource AboutContactIcon}" Content="联系我们" AutomationProperties.HelpText="获取支持与服务" Command="{Binding OpenLinkCommand}" CommandParameter="Contact" AutomationProperties.Name="联系我们"/>
                        </StackPanel>
                        <Border Height="1" Background="#EAEDF1" Margin="0,16,0,10"/>
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <Button x:Name="PrivacyButton" Content="隐私政策" Style="{StaticResource AboutFooterLink}" Command="{Binding OpenLinkCommand}" CommandParameter="Privacy"/>
                            <TextBlock Text="·" FontSize="{DynamicResource SecondaryFontSize}" Foreground="#8B94A2" VerticalAlignment="Center" Margin="8,0"/>
                            <Button x:Name="TermsButton" Content="服务协议" Style="{StaticResource AboutFooterLink}" Command="{Binding OpenLinkCommand}" CommandParameter="Terms"/>
                        </StackPanel>
                        <TextBlock x:Name="CopyrightLabel" Text="{Binding CopyrightText}" FontSize="{DynamicResource SecondaryFontSize}" Foreground="#8B96A7" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBlock x:Name="AboutStatusMessage" Text="{Binding FeedbackMessage}" FontSize="{DynamicResource SecondaryFontSize}" Foreground="#7C8798" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite">
                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
                <Button x:Name="CloseButton" Style="{StaticResource ModalCloseButtonStyle}" Margin="0,8,8,0" Foreground="#667085"
                        Command="{Binding CloseCommand}" AutomationProperties.Name="关闭关于应用弹窗"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
