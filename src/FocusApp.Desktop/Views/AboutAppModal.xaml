<UserControl x:Class="FocusApp.Desktop.Views.AboutAppModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource FontFamilyPrimary}" FontSize="{DynamicResource BodyFontSize}"
             UseLayoutRounding="True" SnapsToDevicePixels="True" Focusable="True"
             KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="Modal_PreviewKeyDown" IsVisibleChanged="Modal_IsVisibleChanged">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/Styles.xaml"/></ResourceDictionary.MergedDictionaries>
            <Geometry x:Key="AboutWebsiteIcon">M11,1 A10,10 0 1 1 11,21 A10,10 0 1 1 11,1 M1,11 H21 M11,1 C5,6 5,16 11,21 C17,16 17,6 11,1</Geometry>
            <Geometry x:Key="AboutHelpIcon">M11,4 C8,1 3,1 1,3 L1,20 C4,18 8,18 11,21 C14,18 18,18 21,20 L21,3 C18,1 14,1 11,4 Z M11,4 L11,21 M5,6 H7 M15,6 H17</Geometry>
            <Geometry x:Key="AboutFeedbackIcon">M11,2 C5,2 1,5 1,10 C1,13 3,16 6,17 L5,21 L10,18 C17,19 22,15 22,10 C22,5 17,2 11,2 Z M7,10 H7.1 M11.5,10 H11.6 M16,10 H16.1</Geometry>
            <Geometry x:Key="AboutPrivacyIcon">M11,1 C8,4 5,5 2,5 L2,12 C2,17 7,21 11,23 C15,21 20,17 20,12 L20,5 C17,5 14,4 11,1 Z M6,12 L9.5,15.5 L16,9</Geometry>
            <Geometry x:Key="AboutUpdateIcon">M19,8 A8,8 0 0 0 5,4 L2,7 M2,3 L2,7 L6,7 M3,14 A8,8 0 0 0 17,18 L20,15 M16,15 L20,15 L20,19</Geometry>
            <Style x:Key="AboutUpdateButton" TargetType="Button" BasedOn="{StaticResource AuthPrimaryButtonStyle}">
                <Setter Property="Width" Value="90"/><Setter Property="Height" Value="36"/>
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyPrimary}"/>
                <Setter Property="FontSize" Value="{DynamicResource ButtonFontSize}"/>
                <Setter Property="FontWeight" Value="{DynamicResource ButtonEmphasisFontWeight}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="UpdateSurface" Background="{TemplateBinding Background}" CornerRadius="18">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="UpdateSurface" Property="Background" Value="{DynamicResource FocusButtonHoverBackground}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="UpdateSurface" Property="Background" Value="{DynamicResource FocusButtonPressedBackground}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="AboutLinkButton" TargetType="Button">
                <Setter Property="Margin" Value="8,5"/><Setter Property="Height" Value="56"/>
                <Setter Property="Background" Value="{DynamicResource SurfacePrimary}"/><Setter Property="Padding" Value="20,0"/>
                <Setter Property="Foreground" Value="#26364B"/><Setter Property="BorderBrush" Value="#EDF0F4"/><Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyPrimary}"/><Setter Property="FontSize" Value="{DynamicResource ButtonFontSize}"/>
                <Setter Property="FontWeight" Value="{DynamicResource ButtonFontWeight}"/><Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="LinkSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <Border.Effect><DropShadowEffect Color="#526078" BlurRadius="8" ShadowDepth="1" Opacity="0.035"/></Border.Effect>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="6"/></Grid.ColumnDefinitions>
                            <Path Width="22" Height="22" Data="{TemplateBinding Tag}" Stretch="Uniform"
                                  Stroke="#6D7D91" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <TextBlock Grid.Column="2" Text="{TemplateBinding Content}" HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="NoWrap"
                                       FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}"/>
                            <Path Grid.Column="3" Width="5" Height="9" Data="M0,0 L4,4.5 L0,9" Stretch="Fill" Stroke="#ADB7C5" StrokeThickness="1.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LinkSurface" Property="Background" Value="#F7F9FC"/><Setter TargetName="LinkSurface" Property="BorderBrush" Value="#DEE5EF"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="LinkSurface" Property="Background" Value="#EEF2F7"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="Overlay" Background="{DynamicResource ModalScrim}" MouseLeftButtonDown="Overlay_MouseLeftButtonDown">
        <Border x:Name="ModalSurface" Width="400" Height="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource SurfacePrimary}" BorderBrush="#E3E7EE" BorderThickness="1" CornerRadius="18">
            <Border.Effect><DropShadowEffect Color="#46536B" BlurRadius="22" ShadowDepth="5" Opacity="0.12"/></Border.Effect>
            <Grid>
                <Grid Margin="22,24,22,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="128"/><RowDefinition Height="1"/><RowDefinition Height="24"/><RowDefinition Height="84"/>
                        <RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="12"/><RowDefinition Height="122"/>
                        <RowDefinition Height="20"/><RowDefinition Height="1"/><RowDefinition Height="16"/><RowDefinition Height="22"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="BrandHeader" Margin="14,0,10,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Width="84" Height="84" Background="#FFF7EF" CornerRadius="24" VerticalAlignment="Top" Margin="0,14,0,0">
                            <Image x:Name="AppLogo" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" Source="/FocusApp.Desktop;component/Assets/Icons/Common/shiguang_logo.png"/>
                        </Border>
                        <StackPanel Grid.Column="2" Margin="0,24,0,0" VerticalAlignment="Top">
                            <TextBlock x:Name="AppName" Height="32" Text="专注时光" FontSize="24" FontWeight="{DynamicResource DialogTitleFontWeight}" Foreground="#15243B"/>
                            <TextBlock x:Name="AppTagline" Height="24" Text="让专注自然发生" FontSize="14" FontWeight="Normal" Foreground="#7C8798"/>
                            <Border x:Name="VersionBadge" Height="22" Padding="10,0" Background="#F3F5F7" CornerRadius="11" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <TextBlock x:Name="AppVersion" FontSize="{DynamicResource SecondaryFontSize}" FontWeight="{DynamicResource SecondaryFontWeight}"
                                           Foreground="#526078" VerticalAlignment="Center">
                                    <Run FontFamily="{DynamicResource FontFamilyEnglish}" Text="{Binding Version, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="#F0F2F5"/>
                    <Border x:Name="UpdateCard" Grid.Row="3" Padding="14,13" Background="#FAFBFC" BorderBrush="#EEF1F5" BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" Background="#FFF1E2" CornerRadius="20" VerticalAlignment="Center">
                                <Path Width="22" Height="22" Data="{StaticResource AboutUpdateIcon}" Stretch="Uniform" Stroke="#FF9500" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="软件更新" FontSize="14" FontWeight="{DynamicResource DialogTitleFontWeight}" Foreground="#18283D"/>
                                <TextBlock x:Name="CurrentVersionLabel" FontSize="12" Foreground="#7C8798" Margin="0,3,0,0">
                                    <Run Text="当前版本 "/><Run FontFamily="{DynamicResource FontFamilyEnglish}" Text="{Binding Version, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="获取最新功能与体验优化" FontSize="12" Foreground="#8B96A7" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="CheckUpdateButton" Grid.Column="4" Style="{StaticResource AboutUpdateButton}" Command="{Binding CheckUpdateCommand}"
                                    VerticalAlignment="Center" AutomationProperties.Name="检查更新">
                                <TextBlock Style="{StaticResource PrimaryActionButtonLabelStyle}" Text="检查更新"/>
                            </Button>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="RelatedLinksTitle" Grid.Row="5" Text="相关链接" FontSize="15" FontWeight="{DynamicResource DialogTitleFontWeight}"
                               Foreground="#18283D" VerticalAlignment="Center"/>
                    <UniformGrid x:Name="AboutLinks" Grid.Row="7" Columns="2" Rows="2" Margin="-8,-5">
                        <Button x:Name="WebsiteButton" Style="{StaticResource AboutLinkButton}" Tag="{StaticResource AboutWebsiteIcon}" Content="官方网站" Command="{Binding OpenLinkCommand}" CommandParameter="Website" AutomationProperties.Name="官方网站"/>
                        <Button x:Name="HelpButton" Style="{StaticResource AboutLinkButton}" Tag="{StaticResource AboutHelpIcon}" Content="帮助中心" Command="{Binding OpenLinkCommand}" CommandParameter="Help" AutomationProperties.Name="帮助中心"/>
                        <Button x:Name="FeedbackButton" Style="{StaticResource AboutLinkButton}" Tag="{StaticResource AboutFeedbackIcon}" Content="问题反馈" Command="{Binding OpenLinkCommand}" CommandParameter="Feedback" AutomationProperties.Name="问题反馈"/>
                        <Button x:Name="PrivacyButton" Style="{StaticResource AboutLinkButton}" Tag="{StaticResource AboutPrivacyIcon}" Content="隐私政策" Command="{Binding OpenLinkCommand}" CommandParameter="Privacy" AutomationProperties.Name="隐私政策"/>
                    </UniformGrid>
                    <Border Grid.Row="9" Background="#F0F2F5"/>
                    <TextBlock x:Name="CopyrightLabel" Grid.Row="11" Text="{Binding CopyrightText}" FontSize="{DynamicResource SecondaryFontSize}"
                               FontWeight="{DynamicResource SecondaryFontWeight}" Foreground="#8B96A7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <Button x:Name="CloseButton" Style="{StaticResource ModalCloseButtonStyle}" Margin="0,8,8,0" Foreground="#667085"
                        Command="{Binding CloseCommand}" AutomationProperties.Name="关闭关于应用弹窗"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
