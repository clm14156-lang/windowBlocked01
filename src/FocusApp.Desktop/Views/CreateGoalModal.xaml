<UserControl x:Class="FocusApp.Desktop.Views.CreateGoalModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             UseLayoutRounding="True" SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Cycle"
             PreviewKeyDown="Modal_PreviewKeyDown" PreviewMouseDown="Modal_PreviewMouseDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="GoalModalScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/><Setter Property="MinWidth" Value="5"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                    <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb MinHeight="20"><Thumb.Template><ControlTemplate TargetType="Thumb">
                        <Border x:Name="ScrollThumb" Width="3" CornerRadius="2" Background="#D6D9DF"/>
                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ScrollThumb" Property="Background" Value="#BCC2CC"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                </Track>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GoalModalTextInputStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
            <Setter Property="FontWeight" Value="{DynamicResource BodyFontWeight}"/><Setter Property="Foreground" Value="#374151"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentPrimary}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ScrollViewer x:Name="PART_ContentHost" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TargetIconChoiceButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="#F5F6F8"/>
            <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="IconChoiceChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FFF8F2"/><Setter Property="BorderBrush" Value="#FFD4B3"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#FFA767"/></Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#FFF2E7"/><Setter Property="BorderBrush" Value="#FF9B50"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="TargetIconChoiceTemplate">
            <Button Style="{StaticResource TargetIconChoiceButtonStyle}" AutomationProperties.Name="{Binding FileName}"
                    Command="{Binding DataContext.SelectTargetIconCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                <Image Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"
                       Source="{Binding DisplayIconSource, Converter={x:Static views:TargetIconSourceConverter.Instance}}"/>
            </Button>
        </DataTemplate>
        <Style x:Key="CreateGoalSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#E3E5EA"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="FontSize" Value="{DynamicResource ButtonFontSize}"/>
            <Setter Property="FontWeight" Value="{DynamicResource ButtonFontWeight}"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#F5F6F8"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#ECEEF2"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CreateGoalPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource CreateGoalSecondaryButtonStyle}">
            <Setter Property="Background" Value="#FF762A"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource WhiteText}"/><Setter Property="FontWeight" Value="{DynamicResource FontWeightSemiBold}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="PrimaryButtonChrome" Background="{TemplateBinding Background}" CornerRadius="8">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PrimaryButtonChrome" Property="Opacity" Value="0.9"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="PrimaryButtonChrome" Property="Opacity" Value="0.78"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PrimaryButtonChrome" Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid x:Name="CreateGoalDialogOverlay" Panel.ZIndex="100" Background="#66000000" MouseDown="Overlay_MouseDown"
              TextElement.FontFamily="{DynamicResource FontFamilyPrimary}"
              Visibility="{Binding IsCreateGoalDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border x:Name="DialogCard" Width="400" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfacePrimary}" BorderBrush="#E3E3E8" BorderThickness="1" CornerRadius="14">
                <Border.Effect><DropShadowEffect BlurRadius="24" Direction="270" Opacity="0.16" ShadowDepth="5"/></Border.Effect>
                <Grid x:Name="CloseButtonHost">
                    <Grid x:Name="DialogContentGrid" Margin="22,18,22,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/><RowDefinition Height="14"/><RowDefinition Height="42"/><RowDefinition Height="10"/>
                            <RowDefinition Height="100"/><RowDefinition/><RowDefinition Height="38"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="GoalDialogTitleText" FontSize="18" FontWeight="{DynamicResource FontWeightSemiBold}"
                                   Foreground="#242424" VerticalAlignment="Center" Text="{Binding GoalDialogTitle}"/>
                        <Grid Grid.Row="2" x:Name="GoalInformationInputs">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button x:Name="GoalIconLibraryButton" AutomationProperties.Name="选择目标图标" Command="{Binding ToggleGoalIconLibraryCommand}"
                                    Background="#FFF6EF" BorderBrush="#FFE0CB" BorderThickness="1" Padding="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <Button.Template><ControlTemplate TargetType="Button">
                                    <Border x:Name="IconSelectorChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="IconSelectorChrome" Property="BorderBrush" Value="#FFB37D"/></Trigger></ControlTemplate.Triggers>
                                </ControlTemplate></Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <Image x:Name="SelectedGoalIcon" Width="26" Height="26" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="{Binding SelectedTargetIcon.DisplayIconSource, Converter={x:Static views:TargetIconSourceConverter.Instance}}"/>
                                    <Path Width="8" Height="4" Margin="6,0,0,0" VerticalAlignment="Center" Data="M 0,0 L 4,4 L 8,0"
                                          Stroke="#FF841F" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </StackPanel>
                            </Button>
                            <Border Grid.Column="2" x:Name="GoalNameInputSurface" Background="#F8F9FB" BorderBrush="#E5E7EC" BorderThickness="1" CornerRadius="8" Padding="10,0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewGoalNameTextBox" AutomationProperties.Name="目标名称" MaxLength="50"
                                             IsVisibleChanged="NewGoalNameTextBox_IsVisibleChanged" PreviewKeyDown="NewGoalNameTextBox_PreviewKeyDown"
                                             Style="{StaticResource GoalModalTextInputStyle}" Text="{Binding NewGoalName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#9CA3AF" FontSize="{DynamicResource BodyFontSize}" Text="请输入目标名称...">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NewGoalName}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{DynamicResource CaptionFontSize}"
                                               Foreground="#9CA3AF" Text="{Binding NameCharacterCountDisplay}"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <Border Grid.Row="4" x:Name="GoalRemarkContainer" Background="#F8F9FB" BorderBrush="#E5E7EC" BorderThickness="1" CornerRadius="8" Padding="10">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="18"/></Grid.RowDefinitions>
                                <TextBox x:Name="NewGoalRemarkTextBox" AutomationProperties.Name="备注" MaxLength="150" AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="60" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                         TextBlock.LineHeight="20" TextBlock.LineStackingStrategy="BlockLineHeight"
                                         Style="{StaticResource GoalModalTextInputStyle}" Text="{Binding NewGoalRemark, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource GoalModalScrollBarStyle}"/></TextBox.Resources>
                                </TextBox>
                                <TextBlock VerticalAlignment="Top" IsHitTestVisible="False" Foreground="#9CA3AF" FontSize="{DynamicResource BodyFontSize}" Text="添加备注（可选）...">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NewGoalRemark}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="{DynamicResource CaptionFontSize}" Text="{Binding RemarkCharacterCountDisplay}">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#9CA3AF"/><Style.Triggers><DataTrigger Binding="{Binding IsGoalRemarkAtLimit}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="6" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button x:Name="CancelGoalButton" Width="92" Command="{Binding CancelCreateGoalCommand}" Style="{StaticResource CreateGoalSecondaryButtonStyle}" Content="取消"/>
                            <Button x:Name="ConfirmGoalButton" Width="102" Margin="10,0,0,0" Command="{Binding ConfirmCreateGoalCommand}" IsEnabled="{Binding CanCreateGoal}"
                                    Style="{StaticResource CreateGoalPrimaryButtonStyle}" Content="{Binding GoalDialogConfirmText}"/>
                        </StackPanel>
                    </Grid>
                    <Button x:Name="ModalCloseButton" AutomationProperties.Name="关闭目标弹窗" Command="{Binding CancelCreateGoalCommand}" Style="{DynamicResource ModalCloseButtonStyle}"/>
                </Grid>
            </Border>
        </Grid>
        <Popup x:Name="GoalIconLibraryPopup" DataContext="{Binding}" AllowsTransparency="True" IsOpen="{Binding IsGoalIconLibraryOpen, Mode=TwoWay}"
               Placement="Custom" PlacementTarget="{Binding ElementName=GoalIconLibraryButton}" PopupAnimation="None" StaysOpen="True"
               Opened="GoalIconLibraryPopup_Opened" Closed="GoalIconLibraryPopup_Closed">
            <views:PoptipChrome x:Name="GoalIconPoptip" Width="240" Margin="4" Background="{DynamicResource SurfacePrimary}" BorderBrush="#E3E7EE"
                                PointerOnTop="True" PreviewKeyDown="Modal_PreviewKeyDown" KeyboardNavigation.TabNavigation="Cycle"
                                UseLayoutRounding="True" SnapsToDevicePixels="True">
                <views:PoptipChrome.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.08"/></views:PoptipChrome.Effect>
                <ScrollViewer x:Name="GoalIconScrollViewer" MaxHeight="288" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                    <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource GoalModalScrollBarStyle}"/></ScrollViewer.Resources>
                    <ItemsControl x:Name="GoalIconLibraryItems" ItemTemplate="{StaticResource TargetIconChoiceTemplate}" ItemsSource="{Binding GoalPickerIcons}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </views:PoptipChrome>
        </Popup>
    </Grid>
</UserControl>
