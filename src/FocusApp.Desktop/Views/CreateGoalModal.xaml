<UserControl x:Class="FocusApp.Desktop.Views.CreateGoalModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             KeyboardNavigation.TabNavigation="Cycle"
             PreviewKeyDown="Modal_PreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="TargetIconChoiceButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="IconChoiceChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconChoiceChrome" Property="Background" Value="#F7F7F9" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="IconChoiceChrome" Property="Background" Value="#EBEBEB" />
                                <Setter TargetName="IconChoiceChrome" Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="TargetIconChoiceTemplate">
            <Button Command="{Binding DataContext.SelectTargetIconCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource TargetIconChoiceButtonStyle}">
                <Image Width="28"
                       Height="28"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="{Binding IconSource}"
                       Stretch="Uniform" />
            </Button>
        </DataTemplate>
        <Style x:Key="CreateGoalSecondaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="SecondaryButtonChrome" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SecondaryButtonChrome" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="SecondaryButtonChrome" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CreateGoalPrimaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="PrimaryButtonChrome" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PrimaryButtonChrome" Property="Opacity" Value="0.9" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="PrimaryButtonChrome" Property="Opacity" Value="0.78" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PrimaryButtonChrome" Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
    <Grid x:Name="CreateGoalDialogOverlay"
          Panel.ZIndex="100"
          Background="#66000000"
          MouseDown="Overlay_MouseDown"
          TextElement.FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
          Visibility="{Binding IsCreateGoalDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Border x:Name="DialogCard" Width="340"
                Height="280"
                Padding="24,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource SurfacePrimary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="1"
                CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" Direction="270" Opacity="0.18" ShadowDepth="6" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="78" />
                    <RowDefinition Height="66" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           VerticalAlignment="Top"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="{Binding GoalDialogTitle}" />
                <Button Grid.Row="0"
                        Width="26" Height="26"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        AutomationProperties.Name="关闭目标弹窗"
                        Command="{Binding CancelCreateGoalCommand}"
                        Style="{StaticResource CreateGoalSecondaryButtonStyle}"
                        Content="×" />
                <StackPanel Grid.Row="1" VerticalAlignment="Top">
                    <TextBlock Margin="0,0,0,7"
                               FontSize="13"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="目标名称" />
                    <Border Height="42"
                            Background="{DynamicResource SurfacePrimary}"
                            BorderBrush="{DynamicResource BorderPrimary}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <TextBox x:Name="NewGoalNameTextBox"
                                     Padding="12,0"
                                     VerticalContentAlignment="Center"
                                     Background="{DynamicResource TransparentBrush}"
                                     BorderThickness="0"
                                     FontSize="13"
                                     FontWeight="Normal"
                                     Foreground="{DynamicResource TextPrimary}"
                                     IsVisibleChanged="NewGoalNameTextBox_IsVisibleChanged"
                                     PreviewKeyDown="NewGoalNameTextBox_PreviewKeyDown"
                                     Text="{Binding NewGoalName, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="2" VerticalAlignment="Top">
                    <TextBlock Margin="0,0,0,7"
                               FontSize="13"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="选择图标" />
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl ItemTemplate="{StaticResource TargetIconChoiceTemplate}"
                                      ItemsSource="{Binding QuickTargetIcons}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Button x:Name="GoalIconLibraryButton"
                                Width="36"
                                Height="36"
                                Padding="0"
                                Background="{DynamicResource TransparentBrush}"
                                BorderThickness="0"
                                Command="{Binding ToggleGoalIconLibraryCommand}"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="MoreIconChrome" Background="{TemplateBinding Background}" CornerRadius="18">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" Text="..." />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MoreIconChrome" Property="Background" Value="#F7F7F9" /></Trigger>
                                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="MoreIconChrome" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal">
                    <Button Width="72"
                            Command="{Binding CancelCreateGoalCommand}"
                            Style="{StaticResource CreateGoalSecondaryButtonStyle}">
                        <TextBlock Text="取消" Foreground="{DynamicResource TextSecondary}" />
                    </Button>
                    <Button Width="80"
                            Margin="10,0,0,0"
                            Command="{Binding ConfirmCreateGoalCommand}"
                            IsEnabled="{Binding CanCreateGoal}"
                            Style="{StaticResource CreateGoalPrimaryButtonStyle}">
                        <TextBlock Text="{Binding GoalDialogConfirmText}" Foreground="#FFFFFF" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    <Popup x:Name="GoalIconLibraryPopup"
           DataContext="{Binding}"
           AllowsTransparency="True"
           IsOpen="{Binding IsGoalIconLibraryOpen, Mode=TwoWay}"
           Placement="Custom"
           PlacementTarget="{Binding ElementName=DialogCard}"
           PopupAnimation="Fade"
           StaysOpen="False">
        <Border Width="344"
                Height="230"
                Padding="18"
                Background="{DynamicResource SurfacePrimary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="1"
                CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" Direction="270" Opacity="0.16" ShadowDepth="5" />
            </Border.Effect>
            <Grid>
                <ItemsControl ItemTemplate="{StaticResource TargetIconChoiceTemplate}"
                              ItemsSource="{Binding AllTargetIcons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </Border>
    </Popup>
    </Grid>
</UserControl>
