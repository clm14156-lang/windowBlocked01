<UserControl x:Class="FocusApp.Desktop.Views.CreateGoalModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             KeyboardNavigation.TabNavigation="Cycle"
             PreviewKeyDown="Modal_PreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <views:TargetIconSourceConverter x:Key="TargetIconSourceConverter" />

        <Style x:Key="GoalModalScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/><Setter Property="MinWidth" Value="5"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                    <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb MinHeight="12"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Width="3" CornerRadius="2" Background="#D6D9DF"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                </Track>
                <ControlTemplate.Triggers><Trigger Property="Maximum" Value="0"><Setter Property="Opacity" Value="0"/><Setter Property="IsHitTestVisible" Value="False"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GoalModalTextInputStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ScrollViewer x:Name="PART_ContentHost" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="TargetIconChoiceButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="IconChoiceChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconChoiceChrome" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TargetIconChoiceTemplate">
            <Button Command="{Binding DataContext.SelectTargetIconCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource TargetIconChoiceButtonStyle}">
                <Image Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding DisplayIconSource, Converter={x:Static views:TargetIconSourceConverter.Instance}}" Stretch="Uniform" />
            </Button>
        </DataTemplate>





        <Style x:Key="CreateGoalSecondaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="SecondaryButtonChrome" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SecondaryButtonChrome" Property="Background" Value="#F5F5F7" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="SecondaryButtonChrome" Property="Background" Value="#EDEDF0" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CreateGoalPrimaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="Background" Value="#FF762A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="PrimaryButtonChrome" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PrimaryButtonChrome" Property="Opacity" Value="0.9" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="PrimaryButtonChrome" Property="Opacity" Value="0.78" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PrimaryButtonChrome" Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>


    <Grid>
        <Grid x:Name="CreateGoalDialogOverlay" Panel.ZIndex="100" Background="#66000000" MouseDown="Overlay_MouseDown"
              TextElement.FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
              Visibility="{Binding IsCreateGoalDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border x:Name="DialogCard" Width="310" Height="{Binding GoalDialogHeight, FallbackValue=328}" Padding="20,18"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource SurfacePrimary}"
                    BorderBrush="#E3E3E8" BorderThickness="1" CornerRadius="14">
                <Border.Effect><DropShadowEffect BlurRadius="24" Direction="270" Opacity="0.16" ShadowDepth="5" /></Border.Effect>
                <Grid x:Name="DialogContentGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/><RowDefinition Height="Auto"/><RowDefinition Height="72"/>
                        <RowDefinition Height="78"/><RowDefinition Height="34"/>
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="19" FontWeight="SemiBold" Text="{Binding GoalDialogTitle}"/>
                    <Button Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="0" Content="×" FontSize="22"
                            AutomationProperties.Name="关闭目标弹窗" Command="{Binding CancelCreateGoalCommand}" Style="{StaticResource CreateGoalSecondaryButtonStyle}"/>
                    <StackPanel Grid.Row="1" x:Name="GoalInformationInputs">
                        <Grid Height="32"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="NewGoalNameTextBox" AutomationProperties.Name="目标名称" MaxLength="50" FontSize="14" FontWeight="Medium"
                                     IsVisibleChanged="NewGoalNameTextBox_IsVisibleChanged" PreviewKeyDown="NewGoalNameTextBox_PreviewKeyDown"
                                     Style="{StaticResource GoalModalTextInputStyle}" Text="{Binding NewGoalName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextWeak}" FontSize="13" Text="请输入目标名称...">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NewGoalName}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextWeak}" Text="{Binding NameCharacterCountDisplay}"/>
                        </Grid>
                        <Border Height="1" Background="#F0F1F3" Margin="0,4,0,7"/>
                        <Grid x:Name="GoalRemarkContainer"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="NewGoalRemarkTextBox" AutomationProperties.Name="备注" MaxLength="150" AcceptsReturn="True" TextWrapping="Wrap"
                                     Height="{Binding GoalRemarkInputHeight}" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                                     TextBlock.LineHeight="20" TextBlock.LineStackingStrategy="BlockLineHeight" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                     TextChanged="NewGoalRemarkTextBox_TextChanged" SizeChanged="NewGoalRemarkTextBox_SizeChanged"
                                     Style="{StaticResource GoalModalTextInputStyle}" Text="{Binding NewGoalRemark, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource GoalModalScrollBarStyle}"/></TextBox.Resources>
                            </TextBox>
                            <TextBlock VerticalAlignment="Top" IsHitTestVisible="False" FontSize="12" Foreground="{DynamicResource TextWeak}" Text="添加备注（可选）..." LineHeight="20" LineStackingStrategy="BlockLineHeight">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NewGoalRemark}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,0,0" FontSize="10" Text="{Binding RemarkCharacterCountDisplay}">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextWeak}"/><Style.Triggers><DataTrigger Binding="{Binding IsGoalRemarkAtLimit}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <TextBlock Margin="0,0,0,6" FontSize="13" FontWeight="Medium" Text="图标" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
                            <ItemsControl ItemTemplate="{StaticResource TargetIconChoiceTemplate}" ItemsSource="{Binding QuickTargetIcons}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Button x:Name="GoalIconLibraryButton" Grid.Column="1" Width="32" Height="32" Padding="0"
                                    AutomationProperties.Name="更多图标" Command="{Binding ToggleGoalIconLibraryCommand}" Style="{StaticResource TargetIconChoiceButtonStyle}">
                                <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="#65758B" Text="⋯" />
                            </Button>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock Margin="0,0,0,6" FontSize="13" FontWeight="Medium" Text="颜色" />
                        <ItemsControl x:Name="GoalColorChoices" ItemsSource="{Binding GoalColors}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Width="30" Height="30" Padding="0" Cursor="Hand" AutomationProperties.Name="{Binding Name}"
                                        Command="{Binding DataContext.SelectGoalColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <Button.Template><ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent">
                                            <Ellipse x:Name="SelectionRing" Margin="1" Stroke="{Binding ColorBrush}" StrokeThickness="1.5" Visibility="Collapsed" />
                                            <Ellipse Margin="4" Fill="{Binding ColorBrush}" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="SelectionRing" Property="Visibility" Value="Visible" /></DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate></Button.Template>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Row="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                        <Button Width="68" Command="{Binding CancelCreateGoalCommand}" Style="{StaticResource CreateGoalSecondaryButtonStyle}"><TextBlock Text="取消" Foreground="{DynamicResource TextSecondary}" /></Button>
                        <Button Width="102" Margin="16,0,0,0" Command="{Binding ConfirmCreateGoalCommand}" IsEnabled="{Binding CanCreateGoal}" Style="{StaticResource CreateGoalPrimaryButtonStyle}"><TextBlock Text="{Binding GoalDialogConfirmText}" Foreground="#FFFFFF" /></Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Popup x:Name="GoalIconLibraryPopup" DataContext="{Binding}" AllowsTransparency="True" IsOpen="{Binding IsGoalIconLibraryOpen, Mode=TwoWay}" Placement="Custom" PlacementTarget="{Binding ElementName=DialogCard}" PopupAnimation="Fade" StaysOpen="False">
            <Border Width="344" Height="230" Padding="18" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="16">
                <Border.Effect><DropShadowEffect BlurRadius="22" Direction="270" Opacity="0.16" ShadowDepth="5" /></Border.Effect>
                <ItemsControl ItemTemplate="{StaticResource TargetIconChoiceTemplate}" ItemsSource="{Binding AllTargetIcons}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
            </Border>
        </Popup>


    </Grid>
</UserControl>
