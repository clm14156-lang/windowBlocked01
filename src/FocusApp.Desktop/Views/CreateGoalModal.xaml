<UserControl x:Class="FocusApp.Desktop.Views.CreateGoalModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             KeyboardNavigation.TabNavigation="Cycle"
             PreviewKeyDown="Modal_PreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <views:TargetIconSourceConverter x:Key="TargetIconSourceConverter" />

        <Style x:Key="GoalModalTextInputStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentPrimary}" />
        </Style>

        <Style x:Key="TargetIconChoiceButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#F5F6F8" />
            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="IconChoiceChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconChoiceChrome" Property="Background" Value="#F7F7F9" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="IconChoiceChrome" Property="Background" Value="#FFF1E7" />
                                <Setter TargetName="IconChoiceChrome" Property="BorderBrush" Value="Transparent" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TargetIconChoiceTemplate">
            <Button Command="{Binding DataContext.SelectTargetIconCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource TargetIconChoiceButtonStyle}">
                <Image Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding DisplayIconSource, Converter={x:Static views:TargetIconSourceConverter.Instance}}" Stretch="Uniform" />
            </Button>
        </DataTemplate>

        <Style x:Key="GoalDurationButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="#E6E6EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="DurationButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DurationButtonChrome" Property="Background" Value="#FFF7EE" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="DurationButtonChrome" Property="Background" Value="#FFF2E8" />
                                <Setter TargetName="DurationButtonChrome" Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GoalDurationEditButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="EditButtonSurface" Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="EditButtonSurface" Property="Background" Value="#F1F1F3" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="EditButtonSurface" Property="Background" Value="#E7E7EA" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CreateGoalSecondaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="SecondaryButtonChrome" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SecondaryButtonChrome" Property="Background" Value="#F5F5F7" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="SecondaryButtonChrome" Property="Background" Value="#EDEDF0" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CreateGoalPrimaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="Background" Value="#FF762A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="PrimaryButtonChrome" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PrimaryButtonChrome" Property="Opacity" Value="0.9" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="PrimaryButtonChrome" Property="Opacity" Value="0.78" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PrimaryButtonChrome" Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>


    <Grid>
        <Grid x:Name="CreateGoalDialogOverlay" Panel.ZIndex="100" Background="#66000000" MouseDown="Overlay_MouseDown"
              TextElement.FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
              Visibility="{Binding IsCreateGoalDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border x:Name="DialogCard" Width="310" Height="{Binding GoalDialogHeight, FallbackValue=390}" Padding="20,18"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource SurfacePrimary}"
                    BorderBrush="#E3E3E8" BorderThickness="1" CornerRadius="14">
                <Border.Effect><DropShadowEffect BlurRadius="24" Direction="270" Opacity="0.16" ShadowDepth="5" /></Border.Effect>
                <Grid x:Name="DialogContentGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" /><RowDefinition Height="80" /><RowDefinition Height="70" />
                        <RowDefinition Height="76" /><RowDefinition Height="42" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="19" FontWeight="SemiBold" Text="{Binding GoalDialogTitle}" />
                    <Button Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="0" Content="×" FontSize="22"
                            AutomationProperties.Name="关闭目标弹窗" Command="{Binding CancelCreateGoalCommand}" Style="{StaticResource CreateGoalSecondaryButtonStyle}" />
                    <StackPanel Grid.Row="1">
                        <TextBlock Margin="0,0,0,8" FontSize="13" FontWeight="Medium" Text="目标名称" />
                        <Border Height="34" BorderBrush="#E7E9ED" BorderThickness="1" CornerRadius="7">
                            <Grid>
                                <TextBox x:Name="NewGoalNameTextBox" AutomationProperties.Name="目标名称" FontSize="13" MaxLength="50" Padding="10,0"
                                         IsVisibleChanged="NewGoalNameTextBox_IsVisibleChanged" PreviewKeyDown="NewGoalNameTextBox_PreviewKeyDown"
                                         Style="{StaticResource GoalModalTextInputStyle}" Text="{Binding NewGoalName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextWeak}" FontSize="12" Text="请输入目标名称...">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding NewGoalName}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextWeak}" Text="{Binding NameCharacterCountDisplay}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <TextBlock Margin="0,0,0,10" FontSize="13" FontWeight="Medium" Text="图标" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
                            <ItemsControl ItemTemplate="{StaticResource TargetIconChoiceTemplate}" ItemsSource="{Binding QuickTargetIcons}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Button x:Name="GoalIconLibraryButton" Grid.Column="1" Width="32" Height="32" Padding="0" Background="#F5F6F8"
                                    AutomationProperties.Name="更多图标" Command="{Binding ToggleGoalIconLibraryCommand}" Style="{StaticResource CreateGoalSecondaryButtonStyle}">
                                <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="#65758B" Text="⋯" />
                            </Button>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="3">
                        <TextBlock Margin="0,0,0,10" FontSize="13" FontWeight="Medium" Text="颜色" />
                        <ItemsControl x:Name="GoalColorChoices" ItemsSource="{Binding GoalColors}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Width="30" Height="30" Padding="0" Cursor="Hand" AutomationProperties.Name="{Binding Name}"
                                        Command="{Binding DataContext.SelectGoalColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <Button.Template><ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent">
                                            <Ellipse x:Name="SelectionRing" Margin="1" Stroke="{Binding ColorBrush}" StrokeThickness="1.5" Visibility="Collapsed" />
                                            <Ellipse Margin="4" Fill="{Binding ColorBrush}" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="SelectionRing" Property="Visibility" Value="Visible" /></DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate></Button.Template>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Border Grid.Row="4" BorderBrush="#EEF0F3" BorderThickness="0,1,0,0">
                        <Button x:Name="ToggleGoalMoreButton" HorizontalAlignment="Left" Height="38" Padding="0"
                                Command="{Binding ToggleGoalMoreCommand}" Style="{StaticResource CreateGoalSecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="18" Height="18" Margin="0,0,9,0">
                                    <Ellipse Stroke="#536070" StrokeThickness="1.3" />
                                    <Path Data="M 4,9 L 14,9" Stroke="#536070" StrokeThickness="1.3" />
                                    <Path Data="M 9,4 L 9,14" Stroke="#536070" StrokeThickness="1.3">
                                        <Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsGoalMoreExpanded}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Path.Style>
                                    </Path>
                                </Grid>
                                <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#536070" Text="{Binding GoalMoreToggleText}" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <StackPanel x:Name="GoalMoreFields" Grid.Row="5" Height="150" Visibility="{Binding IsGoalMoreExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Height="90">
                            <TextBlock Margin="0,4,0,8" FontSize="13" Text="备注（可选）" />
                            <Border x:Name="GoalRemarkContainer" Height="34" BorderBrush="#E7E9ED" BorderThickness="1" CornerRadius="7">
                                <Grid>
                                    <TextBox x:Name="NewGoalRemarkTextBox" AutomationProperties.Name="备注" MaxLength="150" Padding="10,0"
                                             Style="{StaticResource GoalModalTextInputStyle}" FontSize="12" Text="{Binding NewGoalRemark, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="12" Foreground="{DynamicResource TextWeak}" Text="请输入备注...">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding NewGoalRemark}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextWeak}" Text="{Binding RemarkCharacterCountDisplay}" />
                        </StackPanel>
                        <StackPanel Height="60">
                            <TextBlock Margin="0,0,0,9" FontSize="13" Text="目标投入（可选）" />
                        <ItemsControl Margin="-3,0" ItemsSource="{Binding GoalDurationOptions}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="DurationOptionRoot" Margin="3,0">
                                        <Button x:Name="DurationOptionButton"
                                                Command="{Binding DataContext.SelectGoalDurationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GoalDurationButtonStyle}">
                                            <TextBlock x:Name="DurationOptionLabel" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Label}" />
                                        </Button>
                                        <Button x:Name="CustomDurationEditButton"
                                                Width="22"
                                                Margin="0,0,5,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Panel.ZIndex="2"
                                                AutomationProperties.Name="编辑自定义投入"
                                                Command="{Binding DataContext.EditCustomDurationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Content="✎"
                                                FontFamily="Segoe UI Symbol"
                                                FontSize="12"
                                                Opacity="0.72"
                                                Style="{StaticResource GoalDurationEditButtonStyle}" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCustom}" Value="True" />
                                                <Condition Binding="{Binding HasCustomValue}" Value="True" />
                                                <Condition Binding="{Binding IsMouseOver, ElementName=DurationOptionRoot}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="CustomDurationEditButton" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="DurationOptionLabel" Property="Margin" Value="-10,0,10,0" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCustom}" Value="True" />
                                                <Condition Binding="{Binding HasCustomValue}" Value="True" />
                                                <Condition Binding="{Binding IsSelected}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="CustomDurationEditButton" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="DurationOptionLabel" Property="Margin" Value="-10,0,10,0" />
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                        <Button Width="68" Command="{Binding CancelCreateGoalCommand}" Style="{StaticResource CreateGoalSecondaryButtonStyle}"><TextBlock Text="取消" Foreground="{DynamicResource TextSecondary}" /></Button>
                        <Button Width="102" Margin="16,0,0,0" Command="{Binding ConfirmCreateGoalCommand}" IsEnabled="{Binding CanCreateGoal}" Style="{StaticResource CreateGoalPrimaryButtonStyle}"><TextBlock Text="{Binding GoalDialogConfirmText}" Foreground="#FFFFFF" /></Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Popup x:Name="GoalIconLibraryPopup" DataContext="{Binding}" AllowsTransparency="True" IsOpen="{Binding IsGoalIconLibraryOpen, Mode=TwoWay}" Placement="Custom" PlacementTarget="{Binding ElementName=DialogCard}" PopupAnimation="Fade" StaysOpen="False">
            <Border Width="344" Height="230" Padding="18" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="16">
                <Border.Effect><DropShadowEffect BlurRadius="22" Direction="270" Opacity="0.16" ShadowDepth="5" /></Border.Effect>
                <ItemsControl ItemTemplate="{StaticResource TargetIconChoiceTemplate}" ItemsSource="{Binding AllTargetIcons}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
            </Border>
        </Popup>

        <Popup x:Name="CustomDurationPopup" DataContext="{Binding}" AllowsTransparency="True" IsOpen="{Binding IsCustomDurationPopupOpen, Mode=TwoWay}" Placement="Custom" PlacementTarget="{Binding ElementName=DialogCard}" PopupAnimation="Fade" StaysOpen="False">
            <Grid Width="248">
                <Border Margin="0,0,0,7" Padding="16,15,16,14" Background="{DynamicResource SurfacePrimary}" BorderBrush="#E4E5E9" BorderThickness="1" CornerRadius="14">
                    <Border.Effect><DropShadowEffect BlurRadius="20" Direction="270" Opacity="0.14" ShadowDepth="5" /></Border.Effect>
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="自定义投入" />
                        <Border x:Name="CustomDurationInputBorder" Height="44" Margin="0,12,0,0" Background="#FCFCFD" CornerRadius="10">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="BorderBrush" Value="#DDDEE3" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=CustomDurationTextBox}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="CustomDurationTextBox"
                                         AutomationProperties.Name="自定义投入小时数"
                                         Height="40"
                                         Padding="12,0,8,0"
                                         VerticalContentAlignment="Center"
                                         Background="{DynamicResource TransparentBrush}"
                                         BorderThickness="0"
                                         CaretBrush="{DynamicResource AccentPrimary}"
                                         FocusVisualStyle="{x:Null}"
                                         FontSize="14"
                                         Foreground="{DynamicResource TextPrimary}"
                                         IsVisibleChanged="CustomDurationTextBox_IsVisibleChanged"
                                         MaxLength="4"
                                         PreviewKeyDown="CustomDurationTextBox_PreviewKeyDown"
                                         Text="{Binding CustomDurationInput, UpdateSourceTrigger=PropertyChanged}" />
                                <Border Grid.Column="1" Height="20" VerticalAlignment="Center" Background="#E7E7EB" />
                                <TextBlock Grid.Column="2" Margin="11,0,12,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="小时" />
                            </Grid>
                        </Border>
                        <TextBlock Margin="1,7,0,0" FontSize="11.5" Text="{Binding CustomDurationMessage}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextWeak}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCustomDurationError}" Value="True"><Setter Property="Foreground" Value="#D93025" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Margin="0,13,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Width="56" Height="34" Padding="0" Command="{Binding CancelCustomDurationCommand}" Style="{StaticResource CreateGoalSecondaryButtonStyle}" Content="取消" />
                            <Button Width="62" Height="34" Margin="8,0,0,0" Padding="0" Command="{Binding ConfirmCustomDurationCommand}" Style="{StaticResource CreateGoalPrimaryButtonStyle}" Content="确定" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Path Width="16" Height="8" Margin="0,0,45,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Data="M 0,0 L 8,8 L 16,0 Z" Fill="{DynamicResource SurfacePrimary}" Stroke="#E4E5E9" StrokeThickness="1" />
            </Grid>
        </Popup>
    </Grid>
</UserControl>
