<UserControl x:Class="FocusApp.Desktop.Views.AddProgramModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="500"
             Height="420"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="ProgramModalSecondaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="FontSize" Value="14" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Button}"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="12" MouseDown="ModalCard_MouseDown">
        <Grid>
            <TextBlock Margin="20,16,0,0" VerticalAlignment="Top" FontSize="18" FontWeight="SemiBold" Text="{DynamicResource BlockingAddProgramModalTitle}" />
            <TextBlock Margin="20,45,0,0" VerticalAlignment="Top" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource BlockingAddProgramModalDescription}" />
            <Button Width="30" Height="30" Margin="0,10,12,0" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="{DynamicResource BlockingModalClose}" Command="{Binding CloseCommand}" Style="{StaticResource WindowChromeButtonStyle}"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE8BB;" /></Button>

            <Grid Height="42" Margin="20,75,20,0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition Width="108" /></Grid.ColumnDefinitions>
                <Border BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <TextBlock Margin="13,0,0,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TextSecondary}" Text="&#xE721;" />
                        <TextBox Margin="37,1,8,1" Padding="0" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource BlockingProgramSearchPlaceholder}" Background="Transparent" BorderThickness="0" FontSize="13" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="37,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13" Foreground="{DynamicResource AuthInputPlaceholder}" Text="{DynamicResource BlockingProgramSearchPlaceholder}"><TextBlock.Style><Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    </Grid>
                </Border>
                <Button Grid.Column="2" AutomationProperties.Name="{DynamicResource BlockingChooseProgram}" Command="{Binding ChooseProgramCommand}" Style="{StaticResource AuthPrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,7,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xED25;" /><TextBlock VerticalAlignment="Center" FontSize="13" Text="{DynamicResource BlockingChooseProgram}" /></StackPanel>
                </Button>
            </Grid>

            <Border Height="40" Margin="20,130,20,0" VerticalAlignment="Top" Background="{DynamicResource BackgroundSecondary}" CornerRadius="7">
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center" Orientation="Horizontal"><TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentPrimary}" Text="&#xE823;" /><TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="{DynamicResource BlockingRecentProgramsTitle}" /></StackPanel>
            </Border>

            <Border Margin="20,180,20,66" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource OverlayBorder}" BorderThickness="1" CornerRadius="8">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="{DynamicResource TextSecondary}" Text="&#xE71D;" />
                    <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="{DynamicResource BlockingRecentProgramsEmptyTitle}" />
                    <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource BlockingRecentProgramsEmptyDescription}" />
                </StackPanel>
            </Border>

            <Border Height="1" Margin="20,0,20,56" VerticalAlignment="Bottom" Background="{DynamicResource BorderPrimary}" />
            <StackPanel Margin="0,0,20,13" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                <Button Width="86" Height="38" AutomationProperties.Name="{DynamicResource BlockingModalSave}" Command="{Binding SaveCommand}" Content="{DynamicResource BlockingModalSave}" Style="{StaticResource AuthPrimaryButtonStyle}" />
                <Button Width="86" Height="38" Margin="12,0,0,0" AutomationProperties.Name="{DynamicResource BlockingModalCancel}" Command="{Binding CloseCommand}" Content="{DynamicResource BlockingModalCancel}" Style="{StaticResource ProgramModalSecondaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
