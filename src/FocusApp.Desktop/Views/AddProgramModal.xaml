<UserControl x:Class="FocusApp.Desktop.Views.AddProgramModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="540" Height="455"
             HorizontalAlignment="Center" VerticalAlignment="Center"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="ProgramModalSecondaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProgramModalChooseButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ChooseButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChooseButtonBorder" Property="Background" Value="{DynamicResource AccentTint}" />
                                <Setter TargetName="ChooseButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChooseButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecentProgramItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder" Padding="14,5" Background="{DynamicResource TransparentBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentTint}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProgramModalThinScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="6" />
            <Setter Property="Margin" Value="0,5,3,5" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Opacity" Value="0.28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="{DynamicResource TransparentBrush}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="{DynamicResource TextTertiary}" CornerRadius="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.78" /></Trigger>
                            <Trigger Property="IsMouseCaptureWithin" Value="True"><Setter Property="Opacity" Value="0.78" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource OverlayBorder}"
            BorderThickness="1" CornerRadius="18" MouseDown="ModalCard_MouseDown">
        <Grid>
            <TextBlock Margin="28,25,0,0" VerticalAlignment="Top" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource BlockingAddProgramModalTitle}" />
            <TextBlock Margin="28,58,0,0" VerticalAlignment="Top" FontSize="13" FontWeight="Normal"
                       Foreground="{DynamicResource TextTertiary}" Text="{DynamicResource BlockingAddProgramModalDescription}" />
            <Button Width="30" Height="30" Margin="0,17,20,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                    AutomationProperties.Name="{DynamicResource BlockingModalClose}" Command="{Binding CloseCommand}"
                    Style="{StaticResource WindowChromeButtonStyle}">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE8BB;" />
            </Button>

            <Grid Height="46" Margin="28,94,28,0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="122" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource BackgroundPrimary}" BorderBrush="{DynamicResource BorderPrimary}"
                        BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <TextBlock Margin="15,0,0,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets"
                                   FontSize="16" Foreground="{DynamicResource TextTertiary}" Text="&#xE721;" />
                        <TextBox Margin="42,1,10,1" Padding="0" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="{DynamicResource BlockingProgramSearchPlaceholder}"
                                 Background="{DynamicResource TransparentBrush}" BorderThickness="0" FontSize="13"
                                 Foreground="{DynamicResource TextPrimary}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="42,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   FontSize="13" Foreground="{DynamicResource TextTertiary}"
                                   Text="{DynamicResource BlockingProgramSearchPlaceholder}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <Button Grid.Column="2" AutomationProperties.Name="{DynamicResource BlockingChooseProgram}"
                        Command="{Binding ChooseProgramCommand}" Style="{StaticResource ProgramModalChooseButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets"
                                   FontSize="16" Foreground="{DynamicResource AccentPrimary}" Text="&#xED25;" />
                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource AccentPrimary}" Text="{DynamicResource BlockingChooseProgram}" />
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel Margin="30,164,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15"
                           Foreground="{DynamicResource TextSecondary}" Text="&#xE823;" />
                <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="Medium"
                           Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource BlockingRecentProgramsTitle}" />
            </StackPanel>

            <Border Margin="28,195,28,82" Background="{DynamicResource SurfacePrimary}"
                    BorderBrush="{DynamicResource OverlayBorder}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <ListBox ItemsSource="{Binding RecentPrograms}" SelectedItem="{Binding SelectedProgram, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource RecentProgramItemStyle}"
                             Background="{DynamicResource TransparentBrush}" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ProgramModalThinScrollBarStyle}" />
                        </ListBox.Resources>
                        <ListBox.Style>
                            <Style TargetType="{x:Type ListBox}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasVisibleRecentPrograms}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="48">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom"
                                            Background="{DynamicResource OverlayBorder}" Opacity="0.75" />
                                    <Border Width="34" Height="34" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{DynamicResource AccentTint}" CornerRadius="8">
                                        <Grid>
                                            <Image Width="32" Height="32" Stretch="Uniform" Source="{Binding Icon}" />
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                       Foreground="{DynamicResource AccentPrimary}" Text="&#xE71D;">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                                   Text="{Binding DisplayName}" />
                                        <TextBlock Margin="0,3,0,0" FontSize="11.5" Foreground="{DynamicResource TextTertiary}"
                                                   Text="{Binding ExePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExePath}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontSize="11.5" Foreground="{DynamicResource TextTertiary}"
                                               Text="{Binding LastRunTimeDisplay}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasVisibleRecentPrograms}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                   Foreground="{DynamicResource TextTertiary}" Text="&#xE71D;" />
                        <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource BlockingRecentProgramsEmptyTitle}" />
                        <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextTertiary}" Text="{DynamicResource BlockingRecentProgramsEmptyDescription}" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Margin="0,0,28,20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                <Button Width="100" Height="42" AutomationProperties.Name="{DynamicResource BlockingModalCancel}"
                        Command="{Binding CloseCommand}" Content="{DynamicResource BlockingModalCancel}"
                        Style="{StaticResource ProgramModalSecondaryButtonStyle}" />
                <Button Width="100" Height="42" Margin="14,0,0,0"
                        AutomationProperties.Name="{DynamicResource BlockingModalSave}" Command="{Binding SaveCommand}"
                        Style="{StaticResource AuthPrimaryButtonStyle}">
                    <TextBlock FontSize="14" FontWeight="Normal" Foreground="{DynamicResource WhiteText}"
                               Text="{DynamicResource BlockingModalSave}" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
