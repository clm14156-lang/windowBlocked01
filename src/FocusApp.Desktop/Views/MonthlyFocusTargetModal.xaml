<UserControl x:Name="MonthlyFocusTargetModalRoot"
             x:Class="FocusApp.Desktop.Views.MonthlyFocusTargetModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewMouseDown="MonthlyFocusTargetModal_PreviewMouseDown"
             SnapsToDevicePixels="True">
        <Border Width="500"
                Height="340"
                Background="{DynamicResource SurfacePrimary}"
                BorderBrush="#E4E6EB"
                BorderThickness="1"
                CornerRadius="18"
                MouseDown="Dialog_MouseDown">
            <Border.Resources>
                <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
                <Style x:Key="GoalModalQuietButtonStyle" TargetType="Button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#F2F3F5" /></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.65" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="GoalModalMoreButtonStyle" TargetType="Button">
                    <Setter Property="Width" Value="28" />
                    <Setter Property="Height" Value="28" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="MoreButtonSurface" Background="{TemplateBinding Background}" CornerRadius="14">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MoreButtonSurface" Property="Background" Value="#F2F3F5" /></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="MoreButtonSurface" Property="Opacity" Value="0.68" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="GoalModalDangerMenuButtonStyle" TargetType="Button">
                    <Setter Property="Height" Value="34" />
                    <Setter Property="Padding" Value="10,0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="#C83A3A" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="DangerMenuSurface" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DangerMenuSurface" Property="Background" Value="#FFF3F2" /></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="DangerMenuSurface" Property="Opacity" Value="0.72" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="GoalRepeatDayStyle" TargetType="ToggleButton">
                    <Setter Property="Margin" Value="3,0" />
                    <Setter Property="Height" Value="27" />
                    <Setter Property="Background" Value="#F4F5F7" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="DaySurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DaySurface" Property="Background" Value="#EEEFF2" /></Trigger>
                                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="DaySurface" Property="Background" Value="#FFF1E7" /><Setter TargetName="DaySurface" Property="BorderBrush" Value="#FF9A52" /><Setter Property="Foreground" Value="#F26A16" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="MonthlyTargetPrimaryButtonStyle" TargetType="{x:Type Button}">
                    <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="Medium" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="PrimaryButtonBackground" Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PrimaryButtonBackground" Property="Opacity" Value="0.9" /></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="PrimaryButtonBackground" Property="Opacity" Value="0.78" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>
            <Border.Effect><DropShadowEffect BlurRadius="28" Direction="270" Opacity="0.13" ShadowDepth="7" /></Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="84" />
                    <RowDefinition Height="74" />
                    <RowDefinition Height="78" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>

                <!-- Title -->
                <Grid Grid.Row="0" Margin="28,0">
                    <TextBlock VerticalAlignment="Center" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="专注目标" />
                    <Button x:Name="MonthlyFocusTargetMoreButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,13,-5,0" Click="MonthlyFocusTargetMoreButton_Click" Style="{StaticResource GoalModalMoreButtonStyle}" ToolTip="更多操作">
                        <TextBlock FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="•••" />
                    </Button>
                </Grid>

                <Popup x:Name="MonthlyFocusTargetMoreMenu"
                       PlacementTarget="{Binding ElementName=MonthlyFocusTargetMoreButton}"
                       Placement="Bottom"
                       HorizontalOffset="-114"
                       VerticalOffset="4"
                       AllowsTransparency="True"
                       PopupAnimation="None"
                       StaysOpen="False"
                       IsOpen="False"
                       DataContext="{Binding DataContext, ElementName=MonthlyFocusTargetModalRoot}"
                       Closed="MonthlyFocusTargetMoreMenu_Closed">
                    <Border Width="142"
                            Height="44"
                            Padding="4,0"
                            Background="{DynamicResource SurfacePrimary}"
                            BorderBrush="{DynamicResource BorderPrimary}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" Direction="270" Opacity="0.12" ShadowDepth="3" />
                        </Border.Effect>
                        <Button Click="DeleteMonthlyFocusTargetMenuItem_Click" Style="{StaticResource GoalModalDangerMenuButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0" FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE74D;" />
                                <TextBlock Text="删除目标" />
                            </StackPanel>
                        </Button>
                    </Border>
                </Popup>

                <!-- Goal mode -->
                <Grid Grid.Row="1" Margin="28,0">
                    <Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="60" /></Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Top" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="目标模式" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding SelectDailyGoalModeCommand}" Cursor="Hand" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ModeSurface" Padding="13,0" Background="#F6F7F9" BorderBrush="#E6E8ED" BorderThickness="1" CornerRadius="11">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition /><ColumnDefinition Width="26" /></Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" Background="#ECEFF3" CornerRadius="17">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#667085" Text="&#xE787;" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="每日固定" />
                                                <TextBlock Margin="0,3,0,0" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" Text="每天完成固定时长" />
                                            </StackPanel>
                                            <Border x:Name="UnselectedIndicator" Grid.Column="2" Width="18" Height="18" BorderBrush="#C9CFD8" BorderThickness="1.5" CornerRadius="9" />
                                            <Border x:Name="SelectedIndicator" Grid.Column="2" Width="20" Height="20" Background="#FF6B18" CornerRadius="10" Visibility="Collapsed">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="White" Text="&#xE73E;" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ModeSurface" Property="Background" Value="#F1F2F5" /></Trigger>
                                        <DataTrigger Binding="{Binding IsDailyGoalMode}" Value="True"><Setter TargetName="ModeSurface" Property="Background" Value="#FFF2E9" /><Setter TargetName="ModeSurface" Property="BorderBrush" Value="#FF8A43" /><Setter TargetName="SelectedIndicator" Property="Visibility" Value="Visible" /><Setter TargetName="UnselectedIndicator" Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding SelectMonthlyGoalModeCommand}" Cursor="Hand" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ModeSurface" Padding="13,0" Background="#F6F7F9" BorderBrush="#E6E8ED" BorderThickness="1" CornerRadius="11">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition /><ColumnDefinition Width="26" /></Grid.ColumnDefinitions>
                                            <Border x:Name="ModeIconSurface" Width="34" Height="34" Background="#ECEFF3" CornerRadius="17">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#667085" Text="&#xE9D2;" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="每月总目标" />
                                                <TextBlock Margin="0,3,0,0" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" Text="本月累计完成总时长" />
                                            </StackPanel>
                                            <Border x:Name="UnselectedIndicator" Grid.Column="2" Width="18" Height="18" BorderBrush="#C9CFD8" BorderThickness="1.5" CornerRadius="9" />
                                            <Border x:Name="SelectedIndicator" Grid.Column="2" Width="20" Height="20" Background="#FF6B18" CornerRadius="10" Visibility="Collapsed">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="White" Text="&#xE73E;" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ModeSurface" Property="Background" Value="#F1F2F5" /></Trigger>
                                        <DataTrigger Binding="{Binding IsMonthlyGoalMode}" Value="True"><Setter TargetName="ModeSurface" Property="Background" Value="#FFF2E9" /><Setter TargetName="ModeSurface" Property="BorderBrush" Value="#FF8A43" /><Setter TargetName="ModeIconSurface" Property="Background" Value="#FFE5D4" /><Setter TargetName="SelectedIndicator" Property="Visibility" Value="Visible" /><Setter TargetName="UnselectedIndicator" Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>

                <!-- Target duration -->
                <Grid Grid.Row="2" Margin="28,0">
                    <Grid.RowDefinitions><RowDefinition Height="21" /><RowDefinition Height="52" /></Grid.RowDefinitions>
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="目标时长" />
                    <Border Grid.Row="1" Background="#F5F6F8" BorderBrush="#E5E7EC" BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="66" /><ColumnDefinition /><ColumnDefinition Width="66" /></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding DecreaseGoalTargetHoursCommand}" Style="{StaticResource GoalModalQuietButtonStyle}">
                                <TextBlock FontSize="23" FontWeight="Light" Foreground="#667085" Text="−" />
                            </Button>
                            <Grid Grid.Column="1" HorizontalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <TextBox x:Name="MonthlyFocusTargetInputBox" Width="106" Padding="0" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" TextAlignment="Right" Background="Transparent" BorderThickness="0" FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding DailyFocusTargetInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsDailyGoalMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBox Width="106" Padding="0" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" TextAlignment="Right" Background="Transparent" BorderThickness="0" FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding MonthlyFocusTargetInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsMonthlyGoalMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Margin="10,0,0,5" VerticalAlignment="Bottom" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="小时" />
                                </StackPanel>
                            </Grid>
                            <Button Grid.Column="2" Command="{Binding IncreaseGoalTargetHoursCommand}" Style="{StaticResource GoalModalQuietButtonStyle}">
                                <TextBlock FontSize="23" FontWeight="Light" Foreground="#667085" Text="+" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Supporting information -->
                <Grid Grid.Row="3" Margin="28,8,28,8">
                    <StackPanel Visibility="{Binding IsMonthlyGoalMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <UniformGrid Height="48" Columns="3">
                            <Border Margin="0,0,6,0" Padding="10,0" Background="#F5F6F8" CornerRadius="10">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#667085" Text="&#xE823;" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondary}" Text="今日建议" /><TextBlock Margin="0,2,0,0" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding TodaySuggestedFocusDisplay}" /></StackPanel></Grid>
                            </Border>
                            <Border Margin="3,0" Padding="10,0" Background="#F5F6F8" CornerRadius="10">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#667085" Text="&#xE787;" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondary}" Text="剩余" /><TextBlock Margin="0,2,0,0" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding MonthlyFocusRemainingDaysDisplay}" /></StackPanel></Grid>
                            </Border>
                            <Border Margin="6,0,0,0" Padding="10,0" Background="#F5F6F8" CornerRadius="10">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#667085" Text="&#xE9D2;" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondary}" Text="还差" /><TextBlock Margin="0,2,0,0" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding MonthlyFocusRemainingTargetDisplay}" /></StackPanel></Grid>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsDailyGoalMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid Height="28">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="重复方式" />
                            <Button Grid.Column="1" Margin="0,0,4,0" Command="{Binding SelectDailyRepeatCommand}" Content="每天" Style="{StaticResource GoalModalQuietButtonStyle}" Background="#F5F6F8" Foreground="{DynamicResource TextPrimary}" FontSize="12" />
                            <Button Grid.Column="2" Margin="4,0,0,0" Command="{Binding SelectCustomRepeatCommand}" Content="自定义" Style="{StaticResource GoalModalQuietButtonStyle}" Background="#F5F6F8" Foreground="{DynamicResource TextPrimary}" FontSize="12" />
                        </Grid>
                        <UniformGrid Margin="-3,7,-3,0" Columns="7" Visibility="{Binding IsCustomGoalRepeat, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ToggleButton Content="一" IsChecked="{Binding IsMondaySelected, Mode=OneWay}" Command="{Binding ToggleGoalRepeatDayCommand}" CommandParameter="Monday" Style="{StaticResource GoalRepeatDayStyle}" />
                            <ToggleButton Content="二" IsChecked="{Binding IsTuesdaySelected, Mode=OneWay}" Command="{Binding ToggleGoalRepeatDayCommand}" CommandParameter="Tuesday" Style="{StaticResource GoalRepeatDayStyle}" />
                            <ToggleButton Content="三" IsChecked="{Binding IsWednesdaySelected, Mode=OneWay}" Command="{Binding ToggleGoalRepeatDayCommand}" CommandParameter="Wednesday" Style="{StaticResource GoalRepeatDayStyle}" />
                            <ToggleButton Content="四" IsChecked="{Binding IsThursdaySelected, Mode=OneWay}" Command="{Binding ToggleGoalRepeatDayCommand}" CommandParameter="Thursday" Style="{StaticResource GoalRepeatDayStyle}" />
                            <ToggleButton Content="五" IsChecked="{Binding IsFridaySelected, Mode=OneWay}" Command="{Binding ToggleGoalRepeatDayCommand}" CommandParameter="Friday" Style="{StaticResource GoalRepeatDayStyle}" />
                            <ToggleButton Content="六" IsChecked="{Binding IsSaturdaySelected, Mode=OneWay}" Command="{Binding ToggleGoalRepeatDayCommand}" CommandParameter="Saturday" Style="{StaticResource GoalRepeatDayStyle}" />
                            <ToggleButton Content="日" IsChecked="{Binding IsSundaySelected, Mode=OneWay}" Command="{Binding ToggleGoalRepeatDayCommand}" CommandParameter="Sunday" Style="{StaticResource GoalRepeatDayStyle}" />
                        </UniformGrid>
                    </StackPanel>
                </Grid>

                <!-- Actions -->
                <Border Grid.Row="4" BorderBrush="#ECEDEF" BorderThickness="0,1,0,0">
                    <Grid Margin="28,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="92" /><ColumnDefinition Width="10" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Height="36" VerticalAlignment="Center" Command="{Binding CancelMonthlyFocusTargetCommand}" Content="取消" Style="{StaticResource GoalModalQuietButtonStyle}" Background="Transparent" Foreground="{DynamicResource TextSecondary}" FontSize="13" />
                        <Button Grid.Column="3" Height="36" VerticalAlignment="Center" Command="{Binding SaveMonthlyFocusTargetCommand}" Style="{StaticResource MonthlyTargetPrimaryButtonStyle}"><TextBlock Foreground="White" Text="保存" /></Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
</UserControl>
