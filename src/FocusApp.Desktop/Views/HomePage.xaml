<UserControl x:Class="FocusApp.Desktop.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             Background="{DynamicResource BackgroundPrimary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <views:AutomaticBlockingTooltipDetailConverter x:Key="AutomaticBlockingTooltipDetailConverter" />
    </UserControl.Resources>
    <Grid>
        <StackPanel Margin="0,62,24,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Orientation="Horizontal">
            <Ellipse Width="6"
                     Height="6"
                     Margin="0,0,18,0"
                     VerticalAlignment="Center"
                     Fill="{DynamicResource AccentPrimary}" />
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Text="{DynamicResource HomeReadyTitle}" />
            <Ellipse Width="6"
                     Height="6"
                     Margin="18,0,0,0"
                     VerticalAlignment="Center"
                     Fill="{DynamicResource AccentPrimary}" />
        </StackPanel>

        <StackPanel x:Name="ForcedModeStatus"
                    Margin="0,99,24,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False"
                    Orientation="Horizontal">
            <StackPanel.Style>
                <Style TargetType="{x:Type StackPanel}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsForcedModeRequested}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Image Width="14"
                   Height="14"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Source="/FocusApp.Desktop;component/Assets/Icons/Common/Home_Shield.png"
                   Stretch="Uniform" />
            <TextBlock Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="Normal"
                       Foreground="#8E8E93"
                       Text="{DynamicResource HomeForcedModeEnabled}" />
        </StackPanel>

        <Grid Width="238"
              Height="238"
              Margin="0,119,24,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Top">
            <Button AutomationProperties.Name="{DynamicResource HomeStartFocus}"
                    Command="{Binding StartFocusCommand}">
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource HomeFocusButtonStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FocusSession.IsPreparing}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Effect>
                    <DropShadowEffect BlurRadius="24"
                                      Direction="270"
                                      Opacity="0.12"
                                      ShadowDepth="8"
                                      Color="{DynamicResource AccentShadowColor}" />
                </Button.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="56"
                               Foreground="{DynamicResource WhiteText}"
                               Text="&#xE7E8;">
                        <TextBlock.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleY="0.88" />
                                <TranslateTransform Y="-1" />
                            </TransformGroup>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Margin="0,14,0,0"
                               HorizontalAlignment="Center"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource WhiteText}"
                               RenderTransformOrigin="0.5,0.5"
                               Text="{DynamicResource HomeStartFocus}">
                        <TextBlock.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1.045" />
                                <TranslateTransform Y="-5" />
                            </TransformGroup>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </StackPanel>
            </Button>

            <Grid>
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FocusSession.IsPreparing}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <views:CircularProgressRing Progress="{Binding FocusSession.PreparationProgress}"
                                            ProgressBrush="{DynamicResource AccentPrimary}"
                                            RingThickness="7"
                                            TrackBrush="{DynamicResource AccentRingTrack}" />
                <Border Width="218"
                        Height="218"
                        Background="{DynamicResource FocusButtonBackground}"
                        CornerRadius="109">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24"
                                          Direction="270"
                                          Opacity="0.14"
                                          ShadowDepth="8"
                                          Color="{DynamicResource AccentShadowColor}" />
                    </Border.Effect>
                </Border>
                <Button AutomationProperties.Name="{DynamicResource FocusCancelPreparation}"
                        Command="{Binding FocusSession.CancelPreparationCommand}"
                        FocusVisualStyle="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{DynamicResource TransparentBrush}" CornerRadius="119">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   FontSize="64"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WhiteText}"
                                   Text="{Binding FocusSession.PreparationSeconds}" />
                        <TextBlock Margin="0,2,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WhiteText}"
                                   Text="{DynamicResource FocusCancelPreparation}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <Button Padding="12,0"
                Margin="0,375,36,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                AutomationProperties.Name="{DynamicResource HomeFocusTarget}"
                BorderBrush="{DynamicResource BorderPrimary}"
                Command="{Binding OpenFocusTargetCommand}"
                IsHitTestVisible="{Binding FocusSession.IsHomeConfigurationEnabled}"
                ToolTip="{Binding FocusTargetModal.SelectedTargetButtonText}">
            <Button.Style>
                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource HomePillButtonStyle}">
                    <Setter Property="Width" Value="190" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding FocusTargetModal.HasSelectedTarget}" Value="True">
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="Padding" Value="6,0" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="16"
                           Foreground="{DynamicResource TextTertiary}"
                           Text="&#xE70F;" />

                <TextBlock Grid.Column="1"
                           Margin="5,0"
                           MaxWidth="132"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="Medium"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                           Text="{Binding FocusTargetModal.SelectedTargetButtonText}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />

                <TextBlock Grid.Column="2"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="28"
                           FontWeight="Light"
                           Foreground="{DynamicResource TextTertiary}"
                           Text="{DynamicResource HomeFocusTargetChevron}">
                    <TextBlock.RenderTransform>
                        <TranslateTransform Y="-1" />
                    </TextBlock.RenderTransform>
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FocusTargetModal.HasSelectedTarget}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Button>

        <ItemsControl Width="550"
                      Height="44"
                      Margin="0,446,4,0"
                      HorizontalAlignment="Center"
                      HorizontalContentAlignment="Center"
                      VerticalAlignment="Top"
                      IsHitTestVisible="{Binding FocusSession.IsHomeConfigurationEnabled}"
                      ItemsSource="{Binding VisibleDurationOptions}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton AutomationProperties.Name="{Binding Label}"
                                 Command="{Binding DataContext.SelectDurationCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                 CommandParameter="{Binding}"
                                 GroupName="HomeDurationOptions">
                        <RadioButton.Style>
                            <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource HomeDurationButtonStyle}">
                                <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}" />
                                <Setter Property="Width" Value="92" />
                                <Setter Property="Margin" Value="0,0,20,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Icon}" Value="&#xE823;">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="IsChecked" Value="{Binding DataContext.CustomTimeModal.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}, Mode=OneWay}" />
                                        <Setter Property="Width" Value="102" />
                                        <Setter Property="Margin" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                       Text="{Binding Icon}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Icon}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock VerticalAlignment="Center"
                                       FontWeight="Medium"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                       Text="{Binding DurationDisplayLabel}" />
                        </StackPanel>
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Height="82"
                Margin="50,535,50,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Background="{DynamicResource SurfacePrimary}"
                BorderBrush="{DynamicResource OverlayBorder}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Width="30"
                       Height="30"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="/FocusApp.Desktop;component/Assets/Icons/Common/Home_Shield.png"
                       Stretch="Uniform" />

                <StackPanel Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="14"
                                   FontWeight="Medium"
                                   Text="{DynamicResource HomeBlockingTitle}" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="·">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding HasNextAutomaticRule}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Grid Margin="12,0,0,0" VerticalAlignment="Center">
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding HasNextAutomaticRule}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <TextBlock x:Name="AutomaticBlockingTimeText"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource FontFamilyNumeric}"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource AccentPrimary}"
                                       MouseEnter="AutomaticBlockingTimeText_MouseEnter"
                                       MouseLeave="AutomaticBlockingTimeText_MouseLeave"
                                       Text="{Binding NextAutomaticStartDisplay}" />
                            <Popup x:Name="AutomaticBlockingPopup"
                                   AllowsTransparency="True"
                                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                   Placement="Custom"
                                   PlacementTarget="{Binding ElementName=AutomaticBlockingTimeText}"
                                   PopupAnimation="Fade"
                                   StaysOpen="True">
                                    <Grid x:Name="AutomaticBlockingPopupRoot"
                                          Width="190"
                                          MouseEnter="AutomaticBlockingPopup_MouseEnter"
                                          MouseLeave="AutomaticBlockingPopup_MouseLeave">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                        </Grid.RowDefinitions>
                                        <Border Height="96"
                                                Padding="16,12"
                                                Background="{DynamicResource SurfacePrimary}"
                                                BorderBrush="#E5E5EA"
                                                BorderThickness="1"
                                                CornerRadius="11">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="8"
                                                                  Direction="270"
                                                                  Opacity="0.08"
                                                                  ShadowDepth="2" />
                                            </Border.Effect>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           VerticalAlignment="Top"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="16"
                                                           Foreground="{DynamicResource AccentPrimary}"
                                                           Text="&#xE823;" />
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock FontSize="13"
                                                               FontWeight="Medium"
                                                               Foreground="{DynamicResource TextPrimary}">
                                                        <Run Text="{Binding NextAutomaticStartDisplay, Mode=OneWay}" />
                                                        <Run Text=" 开始自动屏蔽" />
                                                    </TextBlock>
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontSize="12"
                                                               FontWeight="Normal"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               Text="{Binding NextAutomaticBlockingToolTip, Mode=OneWay, Converter={StaticResource AutomaticBlockingTooltipDetailConverter}}" />
                                                    <Button Margin="0,8,0,0"
                                                            Padding="0"
                                                            HorizontalAlignment="Left"
                                                            AutomationProperties.Name="{DynamicResource HomeManageAutomaticRule}"
                                                            Background="{DynamicResource TransparentBrush}"
                                                            BorderThickness="0"
                                                            Click="ManageAutomaticRule_Click"
                                                            Cursor="Hand"
                                                            FocusVisualStyle="{x:Null}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="{x:Type Button}">
                                                                <ContentPresenter HorizontalAlignment="Left"
                                                                                  VerticalAlignment="Center" />
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontSize="12"
                                                                       FontWeight="Medium"
                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                       Text="{DynamicResource HomeManageAutomaticRule}" />
                                                            <TextBlock Margin="6,-1,0,0"
                                                                       FontSize="15"
                                                                       FontWeight="Normal"
                                                                       Foreground="{DynamicResource TextTertiary}"
                                                                       Text="›" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Row="1"
                                              Width="14"
                                              Height="8"
                                              Margin="0,-1,0,0"
                                              HorizontalAlignment="Center"
                                              Panel.ZIndex="2">
                                            <Path Data="M 0,0 L 14,0 L 7,8 Z" Fill="#E5E5EA" />
                                            <Path Margin="1,0,1,1" Data="M 0,0 L 12,0 L 6,6 Z" Fill="{DynamicResource SurfacePrimary}" />
                                        </Grid>
                                    </Grid>
                            </Popup>
                        </Grid>
                    </StackPanel>
                    <Grid Margin="0,4,0,0">
                        <TextBlock FontSize="12"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource TextTertiary}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBlockingContent}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="{Binding EnabledBlockingCount, Mode=OneWay}" />
                            <Run Text="{DynamicResource HomeBlockingCountSuffix}" />
                        </TextBlock>
                        <TextBlock FontSize="12"
                                   FontWeight="Normal"
                                   Foreground="#999999"
                                   Text="{DynamicResource HomeBlockingEmpty}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBlockingContent}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="12,0,17,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding BlockingPreviewItems}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="28" Height="28" Margin="0,0,6,0" Background="{DynamicResource TransparentBrush}" CornerRadius="14">
                                    <Grid>
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentPrimary}" Text="{Binding IconGlyph}">
                                            <TextBlock.Style><Style TargetType="{x:Type TextBlock}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Favicon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                        <Image Width="22" Height="22" Source="{Binding Favicon}" Stretch="Uniform" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Width="28" Height="28" Background="{DynamicResource ControlHoverBackground}" CornerRadius="14">
                        <Border.Style><Style TargetType="{x:Type Border}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasAdditionalBlockingItems}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}"><Run Text="+" /><Run Text="{Binding AdditionalBlockingCount, Mode=OneWay}" /></TextBlock>
                    </Border>
                </StackPanel>

                <Button Grid.Column="3"
                        VerticalAlignment="Center"
                        Command="{Binding OpenBlockedContentCommand}"
                        AutomationProperties.Name="{DynamicResource HomeAddBlockingRule}">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="MinHeight" Value="36" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                            <Setter Property="FontWeight" Value="Medium" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{DynamicResource TransparentBrush}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.84" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Opacity" Value="0.72" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}">
                            <TextBlock.Style><Style TargetType="{x:Type TextBlock}"><Setter Property="Text" Value="{DynamicResource HomeAddBlockingRule}" /><Style.Triggers><DataTrigger Binding="{Binding HasBlockingContent}" Value="True"><Setter Property="Text" Value="{DynamicResource HomeViewAllBlocking}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="6,-1,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="17"
                                   FontWeight="Normal"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   Opacity="0.72"
                                   Text="{DynamicResource HomeViewAllChevron}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
