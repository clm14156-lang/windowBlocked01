<UserControl x:Class="FocusApp.Desktop.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             Background="{DynamicResource BackgroundPrimary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid>
        <StackPanel Margin="0,62,24,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Orientation="Horizontal">
            <Ellipse Width="6"
                     Height="6"
                     Margin="0,0,18,0"
                     VerticalAlignment="Center"
                     Fill="{DynamicResource AccentPrimary}" />
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Text="{DynamicResource HomeReadyTitle}" />
            <Ellipse Width="6"
                     Height="6"
                     Margin="18,0,0,0"
                     VerticalAlignment="Center"
                     Fill="{DynamicResource AccentPrimary}" />
        </StackPanel>

        <Grid Width="238"
              Height="238"
              Margin="0,119,24,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Top">
            <Button AutomationProperties.Name="{DynamicResource HomeStartFocus}"
                    Command="{Binding StartFocusCommand}">
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource HomeFocusButtonStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FocusSession.IsPreparing}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Effect>
                    <DropShadowEffect BlurRadius="24"
                                      Direction="270"
                                      Opacity="0.12"
                                      ShadowDepth="8"
                                      Color="{DynamicResource AccentShadowColor}" />
                </Button.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="56"
                               Foreground="{DynamicResource WhiteText}"
                               Text="&#xE7E8;">
                        <TextBlock.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleY="0.88" />
                                <TranslateTransform Y="-1" />
                            </TransformGroup>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Margin="0,14,0,0"
                               HorizontalAlignment="Center"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource WhiteText}"
                               RenderTransformOrigin="0.5,0.5"
                               Text="{DynamicResource HomeStartFocus}">
                        <TextBlock.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1.045" />
                                <TranslateTransform Y="-5" />
                            </TransformGroup>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </StackPanel>
            </Button>

            <Grid>
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FocusSession.IsPreparing}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <views:CircularProgressRing Progress="{Binding FocusSession.PreparationProgress}"
                                            ProgressBrush="{DynamicResource AccentPrimary}"
                                            RingThickness="7"
                                            TrackBrush="{DynamicResource AccentRingTrack}" />
                <Border Width="218"
                        Height="218"
                        Background="{DynamicResource FocusButtonBackground}"
                        CornerRadius="109">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24"
                                          Direction="270"
                                          Opacity="0.14"
                                          ShadowDepth="8"
                                          Color="{DynamicResource AccentShadowColor}" />
                    </Border.Effect>
                </Border>
                <Button AutomationProperties.Name="{DynamicResource FocusCancelPreparation}"
                        Command="{Binding FocusSession.CancelPreparationCommand}"
                        FocusVisualStyle="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{DynamicResource TransparentBrush}" CornerRadius="119">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   FontSize="64"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WhiteText}"
                                   Text="{Binding FocusSession.PreparationSeconds}" />
                        <TextBlock Margin="0,2,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WhiteText}"
                                   Text="{DynamicResource FocusCancelPreparation}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <Button Width="190"
                Margin="0,375,36,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                AutomationProperties.Name="{DynamicResource HomeFocusTarget}"
                Command="{Binding OpenFocusTargetCommand}"
                IsHitTestVisible="{Binding FocusSession.IsHomeConfigurationEnabled}"
                Style="{StaticResource HomePillButtonStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="16"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                           Text="&#xE70F;" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                           Text="{Binding FocusTargetModal.SelectedTargetButtonText}" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="12"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                           Text="&#xE76C;" />
            </StackPanel>
        </Button>

        <ItemsControl Width="550"
                      Height="44"
                      Margin="0,446,4,0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      IsHitTestVisible="{Binding FocusSession.IsHomeConfigurationEnabled}"
                      ItemsSource="{Binding DurationOptions}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton AutomationProperties.Name="{Binding Label}"
                                 Command="{Binding DataContext.SelectDurationCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                 CommandParameter="{Binding}"
                                 IsChecked="{Binding IsSelected, Mode=OneWay}">
                        <RadioButton.Style>
                            <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource HomeDurationButtonStyle}">
                                <Setter Property="Width" Value="92" />
                                <Setter Property="Margin" Value="0,0,20,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Icon}" Value="&#xE823;">
                                        <Setter Property="Width" Value="102" />
                                        <Setter Property="Margin" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                       Text="{Binding Icon}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Icon}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                       Text="{Binding Label}" />
                        </StackPanel>
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Height="82"
                Margin="50,535,50,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Background="{DynamicResource SurfacePrimary}"
                BorderBrush="{DynamicResource OverlayBorder}"
                BorderThickness="1"
                CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  Direction="270"
                                  Opacity="0.06"
                                  ShadowDepth="4" />
            </Border.Effect>
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="32"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="&#xEA18;" />

                <StackPanel Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock FontSize="{DynamicResource CardTitleFontSize}"
                               FontWeight="SemiBold"
                               Text="{DynamicResource HomeBlockingTitle}" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="{DynamicResource SecondaryFontSize}"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="{DynamicResource HomeBlockingEmpty}" />
                </StackPanel>

                <Button Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{DynamicResource HomeAddBlockingRule}"
                        Style="{StaticResource HomeLinkButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   Text="{DynamicResource HomeAddBlockingRule}" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   Text="&#xE76C;" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
