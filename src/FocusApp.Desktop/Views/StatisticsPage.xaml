                                    <ToolTip x:Name="MonthlyFocusGoalTip" Style="{StaticResource FocusGoalProgressTipStyle}"/>
                                </ProgressBar.ToolTip>
                            </ProgressBar>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="TrendCard" Grid.Row="2" Padding="{StaticResource CardContentPadding}" Background="{DynamicResource SurfacePrimary}" BorderBrush="#EEF0F3" BorderThickness="1" CornerRadius="16">
