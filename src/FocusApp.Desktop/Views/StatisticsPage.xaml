                            <Border Width="126" Height="8" Background="#E8EBF0" CornerRadius="4"/>
                            <Border Width="92" Height="8" Margin="0,7,0,0" HorizontalAlignment="Left" Background="#E8EBF0" CornerRadius="4"/>
                            <Border Width="64" Height="8" Margin="0,7,0,0" HorizontalAlignment="Left" Background="#E8EBF0" CornerRadius="4"/>
