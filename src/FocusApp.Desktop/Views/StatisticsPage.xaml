                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding MonthlyFocusTargetPopupTitle}" />
                <TextBlock Margin="0,20,0,8" FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="本月目标时长" />
                <Grid Height="42"><TextBox x:Name="MonthlyFocusTargetInputBox" Padding="12,0,62,0" VerticalContentAlignment="Center" FontSize="18" Text="{Binding MonthlyFocusTargetInput, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="0,0,14,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="小时" /></Grid>
                <TextBlock Margin="0,12,0,0" FontSize="13" Foreground="{DynamicResource TextSecondary}"><Run Text="当前已完成 " /><Run Foreground="{DynamicResource AccentPrimary}" Text="{Binding MonthlyFocusCompletedDisplay, Mode=OneWay}" /></TextBlock>
                <StackPanel Margin="0,20,0,0" Orientation="Horizontal"><Button Width="142" Height="40" Background="{DynamicResource BackgroundSecondary}" BorderThickness="0" FontSize="14" Content="取消" Command="{Binding CancelMonthlyFocusTargetCommand}" /><Button Width="142" Height="40" Margin="12,0,0,0" Background="{DynamicResource AccentPrimary}" BorderThickness="0" Foreground="White" FontSize="14" Content="保存" Command="{Binding SaveMonthlyFocusTargetCommand}" /></StackPanel>
                <Button Margin="0,16,0,0" Padding="0,10" Background="{DynamicResource TransparentBrush}" BorderThickness="0" Foreground="{DynamicResource Danger}" FontSize="13" Content="删除本月目标" Command="{Binding DeleteMonthlyFocusTargetCommand}"><Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasMonthlyFocusTarget}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            </StackPanel>
        </Border>
    </Popup>
    </Grid>
</UserControl>
