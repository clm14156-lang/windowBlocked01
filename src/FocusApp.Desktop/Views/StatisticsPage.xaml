            <Border x:Name="PeriodFocusDistributionCard" Grid.Row="4" Padding="{StaticResource CardContentPadding}" Background="{DynamicResource SurfacePrimary}" BorderBrush="#EEF0F3" BorderThickness="1" CornerRadius="16">
