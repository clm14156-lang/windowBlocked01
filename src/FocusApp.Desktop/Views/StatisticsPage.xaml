                                                   TextAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                        <Border Height="1" Background="#EEF0F4" Margin="0,18,0,16"/>
                                        <Grid x:Name="GoalVipFeatures" Height="116">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                <Border Width="44" Height="44" Background="#F4F5F8" CornerRadius="22" HorizontalAlignment="Center">
                                                    <Viewbox Width="23" Height="23"><Path Data="M 3,16 L 3,22 M 11,9 L 11,22 M 19,2 L 19,22" Stroke="#465063" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                                </Border>
                                                <TextBlock Text="目标趋势" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                                <TextBlock FontSize="12" Foreground="#909AAC" LineHeight="19" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,7,0,0"><Run Text="查看投入变化"/><LineBreak/><Run Text="与长期趋势"/></TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1" Width="1" Background="#EEF0F4" Margin="0,4,0,3"/>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                <Border Width="44" Height="44" Background="#F4F5F8" CornerRadius="22" HorizontalAlignment="Center">
                                                    <Viewbox Width="23" Height="23"><Path Data="M 2,4 A 1,1 0 1 0 4,4 A 1,1 0 1 0 2,4 M 2,12 A 1,1 0 1 0 4,12 A 1,1 0 1 0 2,12 M 2,20 A 1,1 0 1 0 4,20 A 1,1 0 1 0 2,20 M 9,4 L 22,4 M 9,12 L 22,12 M 9,20 L 22,20" Stroke="#465063" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                                </Border>
                                                <TextBlock Text="下一步任务" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                                <TextBlock FontSize="12" Foreground="#909AAC" LineHeight="19" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,7,0,0"><Run Text="创建并管理"/><LineBreak/><Run Text="下一步行动"/></TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="3" Width="1" Background="#EEF0F4" Margin="0,4,0,3"/>
                                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                                <Border Width="44" Height="44" Background="#F4F5F8" CornerRadius="22" HorizontalAlignment="Center">
                                                    <Viewbox Width="23" Height="23"><Path Data="M 12,2 L 12,22 M 2,12 L 22,12" Stroke="#465063" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                                </Border>
                                                <TextBlock Text="创建任务" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                                <TextBlock FontSize="12" Foreground="#909AAC" LineHeight="19" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,7,0,0"><Run Text="为目标添加"/><LineBreak/><Run Text="执行任务"/></TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="5" Width="1" Background="#EEF0F4" Margin="0,4,0,3"/>
                                            <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                                                <Border Width="44" Height="44" Background="#F4F5F8" CornerRadius="22" HorizontalAlignment="Center">
                                                    <Viewbox Width="23" Height="23"><Path Data="M 12,1 A 11,11 0 1 1 11.99,1 M 12,5 L 12,12 L 17,12" Stroke="#465063" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                                </Border>
                                                <TextBlock Text="投入时间" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                                <TextBlock FontSize="12" Foreground="#909AAC" LineHeight="19" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,7,0,0"><Run Text="查看目标"/><LineBreak/><Run Text="累计投入时间"/></TextBlock>
                                            </StackPanel>
                                        </Grid>
                                        <Button x:Name="GoalVipUnlockButton" Width="272" Height="42" HorizontalAlignment="Center" Margin="0,22,0,0"
                                                Background="#FF7F3F" BorderThickness="0" Cursor="Hand" Click="GoalVipUnlockButton_Click"
                                                AutomationProperties.Name="立即开通 VIP">
                                            <Button.Template><ControlTemplate TargetType="Button">
                                                <Border x:Name="GoalUnlockSurface" Background="{TemplateBinding Background}" CornerRadius="19"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="GoalUnlockSurface" Property="Opacity" Value="0.9"/></Trigger>
                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="GoalUnlockSurface" Property="Opacity" Value="0.8"/></Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="GoalUnlockSurface" Property="BorderBrush" Value="#FFD0A9"/><Setter TargetName="GoalUnlockSurface" Property="BorderThickness" Value="2"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate></Button.Template>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="立即开通 VIP" FontSize="15" FontWeight="Medium" Foreground="White" VerticalAlignment="Center"/><TextBlock Text="→" FontSize="21" Foreground="White" Margin="9,-2,0,0" VerticalAlignment="Center"/></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="暂无目标" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextWeak}"
                                           Visibility="{Binding HasSelectedGoal, Converter={StaticResource GoalInverseVisibilityConverter}}"/>
                            </Grid>
                        </Grid>
                            <StackPanel x:Name="GoalFirstCreationGuide" Margin="0,-112,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                        Visibility="{Binding IsGoalCreationGuideVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Viewbox x:Name="GoalMountainIllustration" Width="244" Height="184" HorizontalAlignment="Center">
                                    <Canvas Width="280" Height="212">
                                        <Path Data="M 9,79 C 4,79 4,68 13,68 C 16,56 33,55 39,68 C 52,66 54,79 44,79 Z" Fill="#EFF1F5"/>
                                        <Path Data="M 232,91 C 224,91 224,81 233,80 C 239,65 255,69 258,81 C 271,80 272,91 262,91 Z" Fill="#EFF1F5"/>
                                        <Path Data="M 5,156 L 31,132 Q 47,119 70,139 L 115,91 Q 138,63 159,80 L 222,145 Q 241,130 257,148 L 277,173" Stroke="#CBD0DA" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        <Path Data="M 49,177 L 116,92 Q 138,63 159,80 L 232,176 L 264,207 L 17,207 Z">
                                            <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Offset="0" Color="#00F5F6F8"/><GradientStop Offset="0.72" Color="#22F0F2F6"/><GradientStop Offset="1" Color="#00F5F6F8"/></LinearGradientBrush></Path.Fill>
                                        </Path>
                                        <Path Data="M 149,76 C 151,99 109,101 128,118 C 137,127 168,122 169,138 C 170,159 111,157 99,178 C 88,196 116,204 148,211" Stroke="#CDD2DC" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Data="M 150,19 C 163,18 179,25 187,30 Q 191,33 185,36 C 176,42 164,45 150,47 Z" Fill="{DynamicResource AccentPrimary}"/>
                                        <Path Data="M 149,19 L 149,82" Stroke="#BFC5D0" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Data="M 119,11 L 114,6 M 154,3 L 154,-4 M 187,12 L 192,7" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Ellipse Width="13" Height="13" Canvas.Left="111" Canvas.Top="158" Fill="White" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="3"/>
                                        <Path Data="M 180,211 C 171,211 170,199 180,199 C 184,181 205,181 212,197 C 227,193 232,211 220,211 Z" Fill="#F4F5F7"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="创建你的第一个目标" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,24,0,0"/>
                                <TextBlock FontSize="14" Foreground="#828B9B" LineHeight="23" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,14,0,0"><Run Text="设定一个目标，开始记录你的投入，"/><LineBreak/><Run Text="并拆解下一步需要完成的任务。"/></TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>


            </StackPanel>
        </StackPanel>
    </ScrollViewer>
    <Grid x:Name="CompletedTasksModalOverlay" Panel.ZIndex="20" Background="#5C121827"
          Visibility="{Binding IsChecked, ElementName=CompletedTasksButton, Converter={StaticResource BooleanToVisibilityConverter}}"
          IsVisibleChanged="CompletedTasksModalOverlay_IsVisibleChanged" PreviewKeyDown="CompletedTasksModal_KeyDown">
        <Border x:Name="CompletedTasksModal" Width="430" Height="450" CornerRadius="15"
                Background="{DynamicResource SurfacePrimary}" BorderBrush="#E9EBF0" BorderThickness="1"
                TextElement.FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI" Focusable="True">
            <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.16"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="24,22,24,16">
                    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="25"/></Grid.RowDefinitions>
                    <TextBlock Text="已完成任务" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    <Button x:Name="CompletedTasksCloseButton" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="CompletedTasksCloseButton_Click" Cursor="Hand" Background="Transparent" BorderThickness="0"
                            Foreground="#7E8799" FontSize="23" Content="×" AutomationProperties.Name="关闭已完成任务">
                        <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="CloseSurface" Background="Transparent" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CloseSurface" Property="Background" Value="#F4F5F7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                    </Button>
                    <TextBlock Grid.Row="1" Text="{Binding SelectedDayCompletedTaskSummary}" FontSize="12" Foreground="#8993A7" VerticalAlignment="Bottom"/>
                </Grid>
                <ScrollViewer x:Name="CompletedTasksListScroll" Grid.Row="1" Margin="24,0,18,16"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource StatisticsThinScrollBarStyle}"/></ScrollViewer.Resources>
                    <StackPanel>
                        <TextBlock x:Name="CompletedTasksEmpty" Text="当天还没有完成任务" Margin="0,110,0,0"
                                   HorizontalAlignment="Center" FontSize="13" Foreground="#8993A7"
                                   Visibility="{Binding HasSelectedDayCompletedTasks, Converter={StaticResource GoalInverseVisibilityConverter}}"/>
                        <ItemsControl x:Name="CompletedTasksList" ItemsSource="{Binding SelectedDayCompletedTaskGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CalendarCompletedTaskGroupViewModel}">
                                    <Border BorderBrush="#EDF0F4" BorderThickness="0,0,0,1" Margin="0,0,3,18" Padding="0,0,0,15">
                                        <StackPanel>
                                            <Grid Height="36" Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Border Width="32" Height="32" CornerRadius="8" Background="{Binding IconBackground}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Image Width="19" Height="19" Source="{Binding GoalIconSource, Converter={x:Static views:TargetIconSourceConverter.Instance}}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding GoalName}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                                                           FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding DurationDisplay}" FontSize="13" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Tasks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:CalendarCompletedTaskEntryViewModel}">
                                                        <StackPanel Margin="8,0,0,9">
                                                            <Grid MinHeight="31">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                                                <Border Width="18" Height="18" Background="{DynamicResource AccentPrimary}" CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                    <Path Data="M 0,4 L 3,7 L 9,0" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                           FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding TimeDisplay}" FontSize="12" Foreground="#8C95A6"
                                                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                            <Grid Margin="20,1,0,0" Visibility="{Binding HasSubTasks, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <Border Width="1" Margin="0,0,0,2" HorizontalAlignment="Left" Background="#E7EBF1"/>
                                                                <StackPanel Margin="12,0,0,0">
                                                                    <ItemsControl ItemsSource="{Binding VisibleSubTasks}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate DataType="{x:Type vm:CalendarCompletedSubTaskViewModel}">
                                                                                <Grid Height="30">
                                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                                                                    <Border Width="16" Height="16" CornerRadius="8" Background="White" BorderBrush="{DynamicResource AccentPrimary}" BorderThickness="1.4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                                        <Path Data="M 0,3 L 2.5,5.5 L 7,0" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                    </Border>
                                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                                               FontSize="12" Foreground="#596579" Margin="0,0,8,0"/>
                                                                                    <TextBlock Grid.Column="2" Text="{Binding TimeDisplay}" FontSize="12" Foreground="#929BAD"
                                                                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <Button Content="{Binding FoldLabel}" Command="{Binding ToggleSubTasksCommand}"
                                                                            Visibility="{Binding HasOverflow, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                            Height="29" HorizontalAlignment="Left" Padding="0" Background="Transparent" BorderThickness="0"
                                                                            Foreground="#8B95A8" FontSize="12" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                                                        <Button.Template><ControlTemplate TargetType="Button"><ContentPresenter/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
    <Popup x:Name="TrendTooltipPopup"
           DataContext="{Binding}"
           AllowsTransparency="True"
           Closed="TrendTooltipPopup_Closed"
           Focusable="False"
           IsHitTestVisible="False"
           IsOpen="{Binding IsTooltipOpen, Mode=OneWay}"
           Opened="TrendTooltipPopup_Opened"
           Placement="Relative"
           PlacementTarget="{Binding ElementName=TrendCard}"
           HorizontalOffset="{Binding TooltipOffsetX}"
           VerticalOffset="{Binding TooltipOffsetY}"
           PopupAnimation="Fade">
        <Border Width="150"
                Padding="12,9"
                Background="{DynamicResource SurfacePrimary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="1"
                CornerRadius="8"
                Focusable="False"
                IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.1" ShadowDepth="2" /></Border.Effect>
            <StackPanel DataContext="{Binding HoveredPoint}">
                <TextBlock FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextUnit}" Text="{Binding TooltipDateDisplay}" />
                <TextBlock Margin="0,5,0,0" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource AccentPrimary}" Text="{Binding TooltipDurationDisplay}" />
            </StackPanel>
        </Border>
    </Popup>
    </Grid>
</UserControl>
