                                                                <Setter TargetName="DayDurationText" Property="Foreground" Value="{DynamicResource WhiteText}" />
                                                                <Setter TargetName="DayDurationText" Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
