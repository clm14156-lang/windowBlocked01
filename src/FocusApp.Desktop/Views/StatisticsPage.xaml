                                            <Image Width="17" Height="17" Margin="0,0,7,0" Source="{Binding IconSource, Converter={x:Static views:TargetIconSourceConverter.Instance}}"/>
                                            <TextBlock Grid.Column="1" Margin="5,0,16,0" VerticalAlignment="Center" FontSize="12" Text="{Binding TargetName}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}"/>
                                            <ProgressBar Grid.Column="2" Height="8" VerticalAlignment="Center" Maximum="1" Value="{Binding Ratio, Mode=OneWay}" Style="{StaticResource StatisticsProgressBarStyle}"/>
                                            <TextBlock Grid.Column="3" Margin="12,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Text="{Binding DurationDisplay}" Foreground="{DynamicResource TextSecondary}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel x:Name="PeriodFocusDistributionEmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasPeriodFocusDistribution, Converter={StaticResource GoalInverseVisibilityConverter}}">
