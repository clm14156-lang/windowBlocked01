                                        <Button Width="28" Height="28" Command="{Binding PreviousCalendarMonthCommand}" Style="{StaticResource CalendarMonthNavigationButtonStyle}" AutomationProperties.Name="上个月"><TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
                                        <Button Width="28" Height="28" Margin="8,0,0,0" Command="{Binding NextCalendarMonthCommand}" Style="{StaticResource CalendarMonthNavigationButtonStyle}" AutomationProperties.Name="下个月"><TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
