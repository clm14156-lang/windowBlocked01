<UserControl x:Class="FocusApp.Desktop.Views.StatisticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FocusApp.Desktop.ViewModels"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <views:GoalTrendLabelOffsetConverter x:Key="GoalTrendLabelOffsetConverter" />
        <Style x:Key="StatisticsTabStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Width" Value="122" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid>
                            <Border x:Name="TabBackground" Background="{TemplateBinding Background}" CornerRadius="4" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="TabIndicator" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource TransparentBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBackground" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" /><Setter TargetName="TabIndicator" Property="Background" Value="{DynamicResource AccentPrimary}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,16,30,10">
            <Grid Height="34" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <RadioButton AutomationProperties.Name="{DynamicResource StatisticsOverviewTab}" Command="{Binding SelectOverviewCommand}" IsChecked="{Binding IsOverviewSelected, Mode=OneWay}" Style="{StaticResource StatisticsTabStyle}"><StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,10,0" FontFamily="Segoe MDL2 Assets" FontSize="19" Text="&#xE823;" /><TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{DynamicResource StatisticsOverviewTab}" /></StackPanel></RadioButton>
                    <RadioButton AutomationProperties.Name="{DynamicResource StatisticsCalendarTab}" Command="{Binding SelectCalendarCommand}" IsChecked="{Binding IsCalendarSelected, Mode=OneWay}" Style="{StaticResource StatisticsTabStyle}"><StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,10,0" FontFamily="Segoe MDL2 Assets" FontSize="19" Text="&#xE787;" /><TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{DynamicResource StatisticsCalendarTab}" /></StackPanel></RadioButton>
                    <RadioButton AutomationProperties.Name="{DynamicResource StatisticsGoalsTab}" Command="{Binding SelectGoalsCommand}" IsChecked="{Binding IsGoalsSelected, Mode=OneWay}" Style="{StaticResource StatisticsTabStyle}"><StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,10,0" FontFamily="Segoe MDL2 Assets" FontSize="19" Text="&#xE9D2;" /><TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{DynamicResource StatisticsGoalsTab}" /></StackPanel></RadioButton>
                </StackPanel>
                <Border VerticalAlignment="Bottom" Height="1" Background="{DynamicResource BorderPrimary}" Panel.ZIndex="-1" />
            </Grid>

            <StackPanel Visibility="{Binding IsOverviewSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Height="22" Margin="0,0,0,8"><TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource StatisticsTodayOverview}" /><TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="{Binding TodayDateDisplay}" /></Grid>

            <Grid Height="108" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Padding="24,17" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition /></Grid.ColumnDefinitions><Ellipse Width="60" Height="60" Fill="{DynamicResource AccentTint}" /><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="29" Foreground="{DynamicResource AccentPrimary}" Text="&#xE823;" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource StatisticsTodayDuration}" /><StackPanel Margin="0,8,0,0" Orientation="Horizontal"><TextBlock FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="42" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" Text="2" /><TextBlock Margin="7,21,12,0" FontSize="19" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource StatisticsHoursUnit}" /><TextBlock FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="42" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" Text="15" /><TextBlock Margin="7,21,0,0" FontSize="19" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource StatisticsMinutesUnit}" /></StackPanel></StackPanel></Grid></Border>
                <Border Grid.Column="2" Padding="24,17" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition /></Grid.ColumnDefinitions><Ellipse Width="60" Height="60" Fill="{DynamicResource AccentTint}" /><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="29" Foreground="{DynamicResource AccentPrimary}" Text="&#xE9D2;" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource StatisticsTodayCount}" /><StackPanel Margin="0,5,0,0" Orientation="Horizontal"><TextBlock FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="42" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding TodayFocusCount}" /><TextBlock Margin="7,21,0,0" FontSize="19" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource StatisticsSessionsUnit}" /></StackPanel></StackPanel></Grid></Border>
            </Grid>

            <Border x:Name="TrendCard" Height="310" Padding="24,16,24,14" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="16"><StackPanel>
                <Grid Height="30"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="118" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Orientation="Horizontal"><TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding TrendTitleDisplay}" /><TextBlock Margin="24,5,0,0" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="{Binding TrendPeriodLabel}" /></StackPanel><ComboBox Grid.Column="1" Height="34" Padding="8,0" VerticalAlignment="Top" HorizontalContentAlignment="Center" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" Foreground="{DynamicResource TextPrimary}" FontSize="14" ItemsSource="{Binding RangeOptions}" SelectedItem="{Binding SelectedRange}" DisplayMemberPath="Label" /></Grid>
                <Grid Height="170" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition /></Grid.ColumnDefinitions><ItemsControl ItemsSource="{Binding YAxisTicks}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Top" Value="{Binding ChartY}" /></Style></ItemsControl.ItemContainerStyle><ItemsControl.ItemTemplate><DataTemplate><TextBlock Width="34" Margin="0,-9,0,0" TextAlignment="Left" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="{Binding Label}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Grid Grid.Column="1"><Border Margin="0,0,0,40" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource BorderPrimary}" /><views:TrendChart x:Name="TrendChartControl" DataContext="{Binding}" /></Grid></Grid>
                <Border Height="58" Margin="0,8,0,0" Padding="0,4" Background="{DynamicResource BackgroundPrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Border BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0,0,1,0"><StackPanel HorizontalAlignment="Center"><TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="{Binding PeriodTotalLabel}" /><TextBlock Margin="0,1,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding PeriodTotalDisplay}" /></StackPanel></Border><Border Grid.Column="1" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0,0,1,0"><StackPanel HorizontalAlignment="Center"><TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource StatisticsAverageDuration}" /><TextBlock Margin="0,3,0,0" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding AverageDurationDisplay}" /></StackPanel></Border><StackPanel Grid.Column="2" HorizontalAlignment="Center"><TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="{Binding ComparisonLabel}" /><StackPanel Margin="0,3,0,0" HorizontalAlignment="Center" Orientation="Horizontal"><TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Success}" Text="{Binding ComparisonDisplay}" /><Border Width="22" Height="22" Margin="8,0,0,0" Background="{DynamicResource SuccessTint}" CornerRadius="12"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Success}" Text="&#xE74A;" /></Border></StackPanel></StackPanel></Grid></Border>
            </StackPanel></Border>

            <Border Height="104" Margin="0,10,0,0" Padding="0,12" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="290" /><ColumnDefinition /></Grid.ColumnDefinitions><Grid Grid.Column="0" Margin="96,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="160" Height="78"><Ellipse Width="72" Height="72" Fill="{DynamicResource AccentTint}" Opacity="0.65" /><Ellipse Width="52" Height="52" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="5" /><Ellipse Width="25" Height="25" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="5" /><Ellipse Width="7" Height="7" Fill="{DynamicResource AccentPrimary}" /><Path Margin="96,3,20,48" Data="M 0,24 L 30,0 L 25,25 L 10,20 Z" Fill="{DynamicResource AccentPrimary}" /><TextBlock Margin="-50,44,0,0" HorizontalAlignment="Left" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentPrimary}" Text="&#xE734;" Opacity="0.55" /></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource StatisticsGoalTitle}" /><TextBlock Margin="0,5,0,0" FontSize="14" Foreground="{DynamicResource TextTertiary}" Text="{DynamicResource StatisticsGoalDescription}" /><Button Width="118" Height="34" Margin="0,10,0,0" HorizontalAlignment="Left" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource AccentPrimary}" BorderThickness="1" Foreground="{DynamicResource AccentPrimary}" FontSize="14" FontWeight="SemiBold" Content="{DynamicResource StatisticsSetGoal}" /></StackPanel></Grid></Border>
            </StackPanel>
            <StackPanel Visibility="{Binding IsCalendarSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <Border Padding="20,14,20,12" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="16">
                            <StackPanel>
                                <Grid Height="30">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition /><ColumnDefinition Width="62" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding CalendarMonthDisplay}" />
                                    <TextBlock Grid.Column="1" Margin="8,1,8,0" VerticalAlignment="Center" TextAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{Binding CalendarMonthSummary}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button Width="28" Height="28" Padding="0" Background="{DynamicResource TransparentBrush}" BorderThickness="0" Command="{Binding PreviousCalendarMonthCommand}" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextPrimary}" />
                                        <Button Width="28" Height="28" Padding="0" Background="{DynamicResource TransparentBrush}" BorderThickness="0" Command="{Binding NextCalendarMonthCommand}" Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextPrimary}" />
                                    </StackPanel>
                                </Grid>
                                <Border Margin="0,8,0,8" Height="1" Background="{DynamicResource BorderPrimary}" />
                                <UniformGrid Columns="7" Margin="0,0,0,4">
                                    <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="日" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="一" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="二" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="三" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="四" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="五" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="六" />
                                </UniformGrid>
                                <ItemsControl ItemsSource="{Binding CalendarDays}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CalendarDayViewModel}">
                                            <Button Height="42" Margin="1" Padding="0" Command="{Binding DataContext.SelectCalendarDateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Background="{DynamicResource TransparentBrush}" BorderThickness="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="DayBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="2">
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding DayNumber}" />
                                                                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{Binding DurationLabel}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False"><Setter Property="Opacity" Value="0.36" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource AccentTint}" /></DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,16,0,0" Padding="24,18" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="16">
                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="目标投入分布" />
                                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding GoalDistributions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GoalDistributionViewModel}">
                                            <Grid Height="34">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition /><ColumnDefinition Width="110" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimary}" Text="{Binding TargetName}" />
                                                <Grid Grid.Column="1" Height="6" VerticalAlignment="Center" Margin="10,0,18,0">
                                                    <Border Background="{DynamicResource BackgroundSecondary}" CornerRadius="3" />
                                                    <Border Width="{Binding ProgressWidth}" HorizontalAlignment="Left" Background="{DynamicResource AccentPrimary}" CornerRadius="3" />
                                                </Grid>
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="{Binding DurationDisplay}" />
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimary}" Text="{Binding RatioDisplay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border Grid.Column="1" Padding="24,20" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="16">
                        <StackPanel>
                            <Grid Height="30">
                                <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding SelectedDateDisplay}" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <TextBlock Margin="0,0,16,0" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextSecondary}" Text="&#xE76B;" />
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextSecondary}" Text="&#xE76C;" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,22,0,20">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding SelectedDayDurationDisplay}" /><TextBlock Margin="0,5,0,0" FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="专注时长" /></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding SelectedDayTasksDisplay}" /><TextBlock Margin="0,5,0,0" FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="完成任务" /></StackPanel>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource BorderPrimary}" />
                            <TextBlock Margin="0,18,0,10" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="专注记录" />
                            <ScrollViewer MaxHeight="500" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SelectedDayRecords}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:FocusSessionRecordViewModel}">
                                            <Border Padding="0,10" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0,1,0,0">
                                                <StackPanel>
                                                    <Grid><TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding TimeRangeDisplay}" /><Border HorizontalAlignment="Right" Padding="8,3" Background="{DynamicResource SuccessTint}" CornerRadius="8"><TextBlock FontSize="12" Foreground="{DynamicResource Success}" Text="{Binding GoalName}" /></Border></Grid>
                                                    <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="{Binding CompletedTaskNamesDisplay}" TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="{Binding CalendarDurationDisplay}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
            <StackPanel Visibility="{Binding IsGoalsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Height="595" Margin="0" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="5" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="595" VerticalAlignment="Top" Padding="18,18" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="16">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Height="38">
                                <Button x:Name="GoalListMenuButton" Height="34" HorizontalAlignment="Left" Padding="0" Background="{DynamicResource TransparentBrush}" BorderThickness="0" Command="{Binding ToggleGoalListMenuCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding GoalListTitle}" />
                                        <TextBlock Margin="8,2,0,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="&#xE70D;" />
                                    </StackPanel>
                                </Button>
                                <Button Width="36" Height="36" HorizontalAlignment="Right" Background="{DynamicResource TransparentBrush}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" Command="{Binding AddGoalCommand}" FontSize="22" Foreground="{DynamicResource TextPrimary}" Content="+" />
                                <Popup IsOpen="{Binding IsGoalListMenuOpen, Mode=TwoWay}" Placement="Bottom" PlacementTarget="{Binding ElementName=GoalListMenuButton}" StaysOpen="False" AllowsTransparency="True">
                                    <Border Width="178" Padding="8" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="10">
                                        <StackPanel>
                                            <Button Height="38" HorizontalContentAlignment="Left" Padding="10,0" Background="{DynamicResource TransparentBrush}" BorderThickness="0" Click="SelectCurrentGoalListButton_Click" FontSize="13">
                                                <StackPanel Orientation="Horizontal"><TextBlock Width="24" FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE73E;" Visibility="{Binding IsCurrentGoalList, Converter={StaticResource BooleanToVisibilityConverter}}" /><TextBlock Text="当前目标" /></StackPanel>
                                            </Button>
                                            <Button Height="38" HorizontalContentAlignment="Left" Padding="10,0" Background="{DynamicResource TransparentBrush}" BorderThickness="0" Click="SelectArchivedGoalListButton_Click" FontSize="13">
                                                <StackPanel Orientation="Horizontal"><TextBlock Width="24" FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE73E;" Visibility="{Binding IsArchivedGoalList, Converter={StaticResource BooleanToVisibilityConverter}}" /><TextBlock Text="归档目标" /></StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding VisibleGoals}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GoalOverviewItemViewModel}">
                                            <Button Margin="0,0,0,10" Padding="12,14" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.SelectGoalCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Background="{DynamicResource TransparentBrush}" BorderThickness="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="GoalBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0,0,0,1" CornerRadius="10">
                                                            <Grid>
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Ellipse Width="14" Height="14" Margin="0,0,10,0" Stroke="{DynamicResource TextSecondary}" StrokeThickness="3" />
                                                                        <TextBox Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsRenaming, Converter={StaticResource BooleanToVisibilityConverter}}" Width="112" FontSize="15" BorderThickness="0" Background="{DynamicResource TransparentBrush}" IsVisibleChanged="GoalNameTextBox_IsVisibleChanged" LostKeyboardFocus="GoalNameTextBox_LostKeyboardFocus" PreviewKeyDown="GoalNameTextBox_PreviewKeyDown" />
                                                                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding Name}">
                                                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsRenaming}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                    <Grid Margin="0,12,0,0"><TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{Binding Status}" /><TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{Binding TotalDurationDisplay}" /></Grid>
                                                                </StackPanel>
                                                                <Button x:Name="GoalMenuButton" Width="30" Height="26" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="0" Background="{DynamicResource TransparentBrush}" BorderThickness="0" Command="{Binding DataContext.ToggleGoalMenuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Click="GoalMenuButton_Click">
                                                                    <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed" /></Style></Button.Style>
                                                                    <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="..." />
                                                                </Button>
                                                                <Button Width="34" Height="26" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="0" Background="{DynamicResource TransparentBrush}" BorderThickness="0" Click="SaveGoalRenameButton_Click" Content="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentPrimary}" Visibility="{Binding IsRenaming, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <Popup IsOpen="{Binding IsMenuOpen, Mode=TwoWay}" Placement="Right" PlacementTarget="{Binding ElementName=GoalMenuButton}" StaysOpen="False" AllowsTransparency="True">
                                                                    <Border Width="154" Padding="8" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="10">
                                                                        <StackPanel>
                                                                            <Button Height="36" HorizontalContentAlignment="Left" Padding="8,0" Background="{DynamicResource TransparentBrush}" BorderThickness="0" Click="RenameGoalButton_Click" FontSize="13" Content="重命名" />
                                                                            <Button Height="36" HorizontalContentAlignment="Left" Padding="8,0" Background="{DynamicResource TransparentBrush}" BorderThickness="0" Click="ArchiveGoalButton_Click" FontSize="13" Content="归档目标">
                                                                                <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsArchived}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                                                            </Button>
                                                                            <Button Height="36" HorizontalContentAlignment="Left" Padding="8,0" Background="{DynamicResource TransparentBrush}" BorderThickness="0" Click="RestoreGoalButton_Click" FontSize="13" Content="恢复目标" Visibility="{Binding IsArchived, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                            <Button Height="36" HorizontalContentAlignment="Left" Padding="8,0" Background="{DynamicResource TransparentBrush}" BorderThickness="0" Click="DeleteGoalButton_Click" FontSize="13" Foreground="{DynamicResource Danger}" Content="删除目标" Visibility="{Binding IsArchived, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Popup>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="GoalBorder" Property="Background" Value="{DynamicResource AccentTint}" /><Setter TargetName="GoalBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}" /><Setter TargetName="GoalBorder" Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMenuOpen}" Value="True"><Setter TargetName="GoalMenuButton" Property="Visibility" Value="Visible" /></DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="GoalMenuButton" Property="Visibility" Value="Visible" /></Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="GoalBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                                                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="GoalBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Height="595" VerticalAlignment="Top" Padding="20,18,20,10" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="16">
                        <Grid>
                            <StackPanel>
                                <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding SelectedGoalName}" />
                                <Grid Margin="0,8,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="120" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" Text="{Binding SelectedGoalDurationDisplay}" />
                                    <TextBlock Grid.Column="1" FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" Text="{Binding SelectedGoalProgressDisplay}" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource BorderPrimary}" />
                                <Grid Margin="0,8,0,4" Height="30">
                                    <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="投入趋势" />
                                    <ComboBox Width="112" Height="28" HorizontalAlignment="Right" Padding="6,0" FontSize="12" ItemsSource="{Binding GoalMonths}" SelectedItem="{Binding SelectedGoalMonth}" DisplayMemberPath="Label" />
                                </Grid>
                                <Border Height="145" Background="{DynamicResource BackgroundPrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0,1,0,1">
                                    <Grid Margin="8,8,6,7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="24" /></Grid.RowDefinitions>
                                        <ItemsControl Grid.Column="0" Margin="0,0,4,24" ItemsSource="{Binding GoalTrendAxisTicks}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Top" Value="{Binding ChartY}" /></Style></ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:GoalTrendAxisTickViewModel}"><TextBlock Width="28" Margin="0,-8,0,0" TextAlignment="Right" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{Binding Label}" /></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid x:Name="GoalTrendChartArea" Grid.Column="1">
                                            <ItemsControl Margin="0,0,0,0" IsHitTestVisible="False" ItemsSource="{Binding GoalTrendAxisTicks}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Top" Value="{Binding ChartY}" /><Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}" /></Style></ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:GoalTrendAxisTickViewModel}"><Border Height="1" Background="{DynamicResource BorderPrimary}" Opacity="0.7" /></DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding GoalTrendPoints}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:GoalTrendPointViewModel}">
                                                        <Button Height="{Binding BarHeight}" MinWidth="10" VerticalAlignment="Bottom" Padding="0" Background="{DynamicResource TransparentBrush}" BorderThickness="0" Command="{Binding DataContext.SelectGoalTrendPointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Click="GoalTrendBar_Click" MouseEnter="GoalTrendBar_MouseEnter" MouseLeave="GoalTrendBar_MouseLeave">
                                                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Bar" Width="4" Height="{TemplateBinding Height}" VerticalAlignment="Bottom" Background="{DynamicResource AccentPrimary}" CornerRadius="2,2,0,0" /><ControlTemplate.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Bar" Property="Width" Value="6" /><Setter TargetName="Bar" Property="Background" Value="{DynamicResource TextPrimary}" /></DataTrigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Width" Value="6" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                        <ItemsControl Grid.Row="1" Grid.Column="1" Height="24" ClipToBounds="True" ItemsSource="{Binding GoalTrendDateLabels}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Top" Value="2" />
                                                    <Setter Property="Canvas.Left">
                                                        <Setter.Value>
                                                            <MultiBinding Converter="{StaticResource GoalTrendLabelOffsetConverter}" ConverterParameter="34">
                                                                <Binding Path="Position" />
                                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Canvas}" />
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:GoalTrendDateLabelViewModel}"><TextBlock Width="34" TextAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{Binding Label}" /></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Grid.ColumnSpan="2" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="暂无投入数据">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasSelectedGoalRecords}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <TextBlock Margin="0,8,0,3" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="推进记录" />
                                <Grid Height="278">
                                <ScrollViewer x:Name="GoalProgressScrollViewer" ScrollChanged="GoalProgressScrollViewer_ScrollChanged" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="{x:Type ScrollBar}">
                                            <Setter Property="Width" Value="6" />
                                            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                            <Track.DecreaseRepeatButton>
                                                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource TransparentBrush}" BorderThickness="0" />
                                                            </Track.DecreaseRepeatButton>
                                                            <Track.Thumb>
                                                                <Thumb>
                                                                    <Thumb.Template>
                                                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                                                            <Border Margin="1,0" Background="{DynamicResource BorderPrimary}" CornerRadius="3" Opacity="0.78" />
                                                                        </ControlTemplate>
                                                                    </Thumb.Template>
                                                                </Thumb>
                                                            </Track.Thumb>
                                                            <Track.IncreaseRepeatButton>
                                                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource TransparentBrush}" BorderThickness="0" />
                                                            </Track.IncreaseRepeatButton>
                                                        </Track>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ScrollViewer.Resources>
                                    <ItemsControl x:Name="GoalDateGroupsControl" Margin="0,0,10,0" ItemsSource="{Binding GoalDateGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:GoalDateGroupViewModel}">
                                                <StackPanel>
                                                    <Button Height="38" Padding="0" HorizontalContentAlignment="Stretch" Background="{DynamicResource TransparentBrush}" BorderThickness="0" Command="{Binding DataContext.ToggleGoalDateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                        <Grid><Ellipse Width="10" Height="10" HorizontalAlignment="Left" Fill="{DynamicResource BorderPrimary}" /><TextBlock Margin="28,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding DateDisplay}" /><TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextSecondary}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE76C;" /><Setter Property="Opacity" Value="0" /><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Text" Value="&#xE70D;" /></DataTrigger><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Opacity" Value="1" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                                                    </Button>
                                                    <ItemsControl Margin="0,0,0,6" ItemsSource="{Binding Sessions}" Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:FocusSessionRecordViewModel}"><Border Height="34" Padding="10,0" Background="{DynamicResource BackgroundPrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1,0,1,1"><Grid><TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{Binding TimeRangeDisplay}" /><TextBlock Margin="150,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimary}" Text="{Binding TaskName}" /><TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{Binding DurationDisplay}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondary}" IsHitTestVisible="False" Text="暂无推进记录">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasSelectedGoalRecords}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                </Grid>
                            </StackPanel>
                            <Border Background="{DynamicResource SurfacePrimary}">
                                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasSelectedGoal}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="暂无目标" /><TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="当前列表没有可显示的目标" /></StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
    <Popup x:Name="TrendTooltipPopup"
           DataContext="{Binding}"
           AllowsTransparency="True"
           IsHitTestVisible="False"
           IsOpen="{Binding IsTooltipOpen, Mode=OneWay}"
           Placement="Relative"
           PlacementTarget="{Binding ElementName=TrendCard}"
           HorizontalOffset="{Binding TooltipOffsetX}"
           VerticalOffset="{Binding TooltipOffsetY}"
           PopupAnimation="Fade">
        <Border Width="150"
                Padding="10,8"
                Background="{DynamicResource SurfacePrimary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="1"
                CornerRadius="8">
            <Border.Effect><DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.16" ShadowDepth="2" /></Border.Effect>
            <StackPanel DataContext="{Binding HoveredPoint}">
                <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding TooltipDateDisplay}" />
                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="{Binding TooltipDurationDisplay}" />
            </StackPanel>
        </Border>
    </Popup>
    <Popup x:Name="GoalTrendTooltipPopup"
           DataContext="{Binding}"
           AllowsTransparency="True"
           IsHitTestVisible="False"
           IsOpen="{Binding IsGoalTrendTooltipOpen, Mode=OneWay}"
           Placement="Relative"
           PlacementTarget="{Binding ElementName=GoalTrendChartArea}"
           HorizontalOffset="{Binding GoalTrendTooltipOffsetX}"
           VerticalOffset="{Binding GoalTrendTooltipOffsetY}"
           PopupAnimation="Fade">
        <Border Width="140"
                Padding="10,8"
                Background="{DynamicResource SurfacePrimary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="1"
                CornerRadius="8">
            <Border.Effect><DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.16" ShadowDepth="2" /></Border.Effect>
            <StackPanel DataContext="{Binding HoveredGoalTrendPoint}">
                <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding TooltipDateDisplay}" />
                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="{Binding TooltipDurationDisplay}" />
            </StackPanel>
        </Border>
    </Popup>
    </Grid>
</UserControl>
