                        <TextBlock Text="{Binding PeriodFocusDistributionEmptyTitle}" FontSize="14" FontWeight="Medium" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="开始专注后，这里会显示各目标的时间分配" Margin="0,7,0,0" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
