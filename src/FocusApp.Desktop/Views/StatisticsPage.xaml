                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentPrimary}" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="总投入" FontSize="12" Foreground="#959CA7" VerticalAlignment="Center" />
                            <TextBlock Margin="10,0,0,0" FontSize="12" FontWeight="Medium" Foreground="#6F7885" VerticalAlignment="Center" Text="{Binding PeriodFocusDistributionTotalDisplay}" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer x:Name="PeriodFocusDistributionScrollViewer" ScrollChanged="PeriodFocusDistributionScrollViewer_ScrollChanged" Grid.Row="1" Margin="{StaticResource GroupGapAbove}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasPeriodFocusDistribution, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource StatisticsThinScrollBarStyle}"/></ScrollViewer.Resources>
                        <ItemsControl x:Name="PeriodFocusDistributionList" ItemsSource="{Binding PeriodFocusDistributions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PeriodFocusDistributionViewModel}">
