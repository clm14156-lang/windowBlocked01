                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=GoalListMoreButton}" Value="True"><Setter TargetName="GoalTodayDurationText" Property="Visibility" Value="Collapsed"/><Setter TargetName="GoalTotalDurationText" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding IsRenaming}" Value="True"><Setter TargetName="GoalTodayDurationText" Property="Visibility" Value="Collapsed"/><Setter TargetName="GoalTotalDurationText" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
