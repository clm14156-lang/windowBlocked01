<UserControl x:Class="FocusApp.Desktop.Views.StatisticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FocusApp.Desktop.ViewModels"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/FocusApp.Desktop;component/Resources/PrimaryActionButtons.xaml" />
            <ResourceDictionary Source="/FocusApp.Desktop;component/Resources/Spacing.xaml" />
            <ResourceDictionary Source="/FocusApp.Desktop;component/Resources/StatisticsScrollStyles.xaml" />
            <ResourceDictionary Source="/FocusApp.Desktop;component/Resources/PoptipStyles.xaml" />
            <ResourceDictionary Source="/FocusApp.Desktop;component/Resources/CalendarTypography.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <views:GoalInverseVisibilityConverter x:Key="GoalInverseVisibilityConverter"/>

        <!-- Trim transparent asset padding only for display; retain the 28 DIP icon slot. -->
        <CroppedBitmap x:Key="CalendarDawnIcon" SourceRect="28,29,79,81">
            <CroppedBitmap.Source><BitmapImage UriSource="/FocusApp.Desktop;component/Assets/Icons/Common/rili_04.png"/></CroppedBitmap.Source>
        </CroppedBitmap>
        <CroppedBitmap x:Key="CalendarMorningIcon" SourceRect="17,18,94,95">
            <CroppedBitmap.Source><BitmapImage UriSource="/FocusApp.Desktop;component/Assets/Icons/Common/rili_03.png"/></CroppedBitmap.Source>
        </CroppedBitmap>
        <CroppedBitmap x:Key="CalendarAfternoonIcon" SourceRect="19,19,90,90">
            <CroppedBitmap.Source><BitmapImage UriSource="/FocusApp.Desktop;component/Assets/Icons/Common/rili_02.png"/></CroppedBitmap.Source>
        </CroppedBitmap>
        <CroppedBitmap x:Key="CalendarNightIcon" SourceRect="24,25,81,81">
            <CroppedBitmap.Source><BitmapImage UriSource="/FocusApp.Desktop;component/Assets/Icons/Common/rili_01.png"/></CroppedBitmap.Source>
        </CroppedBitmap>

        <Style x:Key="VipUnlockButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
            <Style.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/FocusApp.Desktop;component/Resources/VipActionBackgrounds.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Style.Resources>
        </Style>

        <Style x:Key="GoalSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource SectionTitleFontSize}"/>
            <Setter Property="FontWeight" Value="{DynamicResource SectionTitleFontWeight}"/>
            <Setter Property="Foreground" Value="#454C57"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GoalCreatedDateTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StatisticsBodyTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource StatisticsWeakBrush}"/>
        </Style>
        <Style x:Key="GoalMetricCardButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="MetricSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="0.75"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="CalendarMetricButtonStyle" TargetType="Button" BasedOn="{StaticResource GoalMetricCardButtonStyle}">
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="MetricSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MetricSurface" Property="Background" Value="#F7F9FB"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="MetricSurface" Property="Background" Value="#F1F4F8"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.75"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GoalDetailMenuItemStyle" TargetType="Button">
            <Setter Property="Height" Value="33"/><Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="MenuItemSurface" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MenuItemSurface" Property="Background" Value="#F3F3F4"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="MenuItemSurface" Property="Background" Value="#E8E8EA"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GoalInlineActionStyle" TargetType="Button">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="5">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GoalJumpActionStyle" TargetType="Button" BasedOn="{StaticResource GoalInlineActionStyle}">
            <Setter Property="FontSize" Value="{DynamicResource SecondaryMediumFontSize}"/><Setter Property="FontWeight" Value="{DynamicResource SecondaryMediumFontWeight}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Body" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter TargetName="Body" Property="Background" Value="#F8F9FA"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <GeometryGroup x:Key="GoalListCurrentIconGeometry">
            <EllipseGeometry Center="8,8" RadiusX="7" RadiusY="7"/>
            <EllipseGeometry Center="8,8" RadiusX="3" RadiusY="3"/>
        </GeometryGroup>
        <PathGeometry x:Key="GoalListArchiveIconGeometry" Figures="M 2,5 L 14,5 L 14,13 Q 14,15 12,15 L 4,15 Q 2,15 2,13 Z M 1,2 L 15,2 L 15,5 L 1,5 Z M 6,8 L 10,8"/>
        <Style x:Key="GoalListAddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#8C949F"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid x:Name="GoalListAddSurface" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                    <Path Width="12" Height="12" Data="M 0,6 L 12,6 M 6,0 L 6,12" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#616B78"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="#616B78"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="#495465"/>
                        <Setter TargetName="GoalListAddSurface" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value></Setter>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="CalendarNavigationButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Background="Transparent">
                            <Border x:Name="NavigationHover" Background="#F7F7F8" CornerRadius="8" Opacity="0"/>
                            <ContentPresenter x:Name="NavigationContent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="NavigationHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="NavigationHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="NavigationContent" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.1"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="NavigationContent" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CalendarMonthNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource CalendarNavigationButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="#111827"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="CalendarRecordRowHoverBackground" Color="#F5F6F8"/>
        <Style x:Key="CalendarRecordRowStyle" TargetType="Border">
            <Setter Property="views:CalendarRecordRowFeedback.TargetBackground" Value="{DynamicResource SurfacePrimary}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="views:CalendarRecordInteractionState.IsHovered" Value="True"><Setter Property="views:CalendarRecordRowFeedback.TargetBackground" Value="{DynamicResource CalendarRecordRowHoverBackground}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CalendarRecordTimeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style x:Key="CalendarRecordTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CalendarRecordTimeTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="StatisticsTabStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource CalendarTextSecondary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid>
                            <Border x:Name="TabBackground" Background="{TemplateBinding Background}" CornerRadius="4" />
                            <ContentPresenter Margin="0,0,0,4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="TabIndicator" Height="2" Margin="5,0" VerticalAlignment="Bottom" Background="{DynamicResource TransparentBrush}" CornerRadius="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBackground" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource CalendarAccent}" /><Setter TargetName="TabIndicator" Property="Background" Value="{DynamicResource CalendarAccent}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatisticsRecordScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="5" />
            <Setter Property="MinWidth" Value="5" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="5" Background="{DynamicResource TransparentBrush}">
                            <Track x:Name="PART_Track"
                                   Margin="0,3,1,3"
                                   IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBody"
                                                        Width="3"
                                                        HorizontalAlignment="Center"
                                                        Background="#D1D1D6"
                                                        CornerRadius="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#C7C7CC" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#AEAEB2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
      </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
    <ScrollViewer Margin="{StaticResource PageContentInset}" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
        <Grid Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid x:Name="StatisticsTabs" Width="288" Height="35" Margin="{StaticResource TabContentGapBelow}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton AutomationProperties.Name="{DynamicResource StatisticsOverviewTab}" Command="{Binding SelectOverviewCommand}" IsChecked="{Binding IsOverviewSelected, Mode=OneWay}" Style="{StaticResource StatisticsTabStyle}"><StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,9,0" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Text="&#xE823;" /><TextBlock Style="{StaticResource CalendarTabTextStyle}" Text="{DynamicResource StatisticsOverviewTab}" /></StackPanel></RadioButton>
                    <RadioButton AutomationProperties.Name="{DynamicResource StatisticsCalendarTab}" Command="{Binding SelectCalendarCommand}" IsChecked="{Binding IsCalendarSelected, Mode=OneWay}" Style="{StaticResource StatisticsTabStyle}"><StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,9,0" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Text="&#xE787;" /><TextBlock Style="{StaticResource CalendarTabTextStyle}" Text="{DynamicResource StatisticsCalendarTab}" /></StackPanel></RadioButton>
                    <RadioButton AutomationProperties.Name="{DynamicResource StatisticsGoalsTab}" Command="{Binding SelectGoalsCommand}" IsChecked="{Binding IsGoalsSelected, Mode=OneWay}" Style="{StaticResource StatisticsTabStyle}"><StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,9,0" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Text="&#xE9D2;" /><TextBlock Style="{StaticResource CalendarTabTextStyle}" Text="{DynamicResource StatisticsGoalsTab}" /></StackPanel></RadioButton>
                </StackPanel>
                <Border VerticalAlignment="Bottom" Height="1" Background="{DynamicResource BorderPrimary}" Panel.ZIndex="-1" />
            </Grid>

            <views:StatisticsDashboard x:Name="OverviewDashboard" Grid.Row="1" DataContext="{Binding Overview}"
                                       Visibility="{Binding DataContext.IsOverviewSelected, RelativeSource={RelativeSource AncestorType=views:StatisticsPage}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Grid Grid.Row="1" TextElement.FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
                        Visibility="{Binding IsCalendarSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid x:Name="CalendarPageLayout" HorizontalAlignment="Stretch">
                    <Grid.Resources>
                        <Style x:Key="CalendarSurface" TargetType="Border">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderBrush" Value="#EDEEF0"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="CornerRadius" Value="10"/>
                            <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#20252B" BlurRadius="5" ShadowDepth="1" Opacity="0.025"/></Setter.Value></Setter>
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="47*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="53*"/></Grid.ColumnDefinitions>
                    <Grid x:Name="CalendarLeftColumn">
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="12"/><RowDefinition Height="140"/></Grid.RowDefinitions>
                        <Border x:Name="CalendarCard" Padding="18" Style="{StaticResource CalendarSurface}">
                            <Grid x:Name="CalendarMonthRegion">
                                <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="42"/><RowDefinition/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource CalendarPageTitleStyle}" x:Name="CalendarMonthTitle" Text="{Binding CalendarMonthDisplay}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Width="28" Height="30" Command="{Binding PreviousCalendarMonthCommand}" Style="{StaticResource CalendarMonthNavigationButtonStyle}" AutomationProperties.Name="上个月"><Path Width="7" Height="13" Data="M 6,0 L 0,6 L 6,12" Stroke="#80858D" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
                                        <Button Width="28" Height="30" Margin="8,0,0,0" Command="{Binding NextCalendarMonthCommand}" Style="{StaticResource CalendarMonthNavigationButtonStyle}" AutomationProperties.Name="下个月"><Path Width="7" Height="13" Data="M 0,0 L 6,6 L 0,12" Stroke="#80858D" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
                                    </StackPanel>
                                </Grid>
                                <UniformGrid x:Name="CalendarWeekdays" Grid.Row="1" Columns="7" Margin="0,12,0,0" VerticalAlignment="Center" >
                                    <TextBlock Text="日" Style="{StaticResource CalendarStatusTextStyle}" HorizontalAlignment="Center"/><TextBlock Text="一" Style="{StaticResource CalendarStatusTextStyle}" HorizontalAlignment="Center"/><TextBlock Text="二" Style="{StaticResource CalendarStatusTextStyle}" HorizontalAlignment="Center"/><TextBlock Text="三" Style="{StaticResource CalendarStatusTextStyle}" HorizontalAlignment="Center"/><TextBlock Text="四" Style="{StaticResource CalendarStatusTextStyle}" HorizontalAlignment="Center"/><TextBlock Text="五" Style="{StaticResource CalendarStatusTextStyle}" HorizontalAlignment="Center"/><TextBlock Text="六" Style="{StaticResource CalendarStatusTextStyle}" HorizontalAlignment="Center"/>
                                </UniformGrid>
                                <ItemsControl x:Name="CalendarDateItems" Grid.Row="2" ItemsSource="{Binding CalendarDays}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:CalendarDayViewModel}">
                                        <Button Margin="0" Padding="0" Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}"
                                                Command="{Binding DataContext.SelectCalendarDateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanSelect}" Focusable="{Binding CanSelect}" IsHitTestVisible="{Binding CanSelect}" IsTabStop="{Binding CanSelect}">
                                            <Button.Style><Style TargetType="Button"><Setter Property="Cursor" Value="Arrow"/><Style.Triggers><DataTrigger Binding="{Binding CanSelect}" Value="True"><Setter Property="Cursor" Value="Hand"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                            <Button.Template><ControlTemplate TargetType="Button">
                                                <Grid Background="Transparent">
                                                    <Border x:Name="DaySelectionBackground" Width="40" Height="46" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent"/>
                                                    <Grid x:Name="DayContent" Width="40" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="20"/></Grid.RowDefinitions>
                                                        <TextBlock Style="{StaticResource CalendarDayNumberStyle}" x:Name="DayNumberText" Text="{Binding DayNumber}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="DayDurationText" Grid.Row="1" Text="{Binding DurationLabel}"  HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CalendarDayDurationStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasFocus}" Value="True"/><Condition Binding="{Binding IsCurrentMonth}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False"><Setter TargetName="DayNumberText" Property="Foreground" Value="{DynamicResource CalendarTextMuted}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding HasFocus}" Value="False"><Setter TargetName="DayNumberText" Property="Foreground" Value="{DynamicResource CalendarTextMuted}"/></DataTrigger>
                                                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CanSelect}" Value="True"/><Condition Binding="{Binding IsSelected}" Value="False"/><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="DaySelectionBackground" Property="Opacity" Value="0.9"/></MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="DaySelectionBackground" Property="Background" Value="{DynamicResource CalendarAccent}"/><Setter TargetName="DayNumberText" Property="Foreground" Value="{DynamicResource CalendarSelectedText}"/><Setter TargetName="DayNumberText" Property="FontWeight" Value="SemiBold"/><Setter TargetName="DayDurationText" Property="Foreground" Value="{DynamicResource CalendarSelectedText}"/></DataTrigger>
                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="DaySelectionBackground" Property="Background" Value="{DynamicResource CalendarAccent}"/><Setter TargetName="DayNumberText" Property="Foreground" Value="{DynamicResource CalendarSelectedText}"/><Setter TargetName="DayDurationText" Property="Foreground" Value="{DynamicResource CalendarSelectedText}"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate></Button.Template>
                                        </Button>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                        <Border x:Name="CalendarMonthlySummary" Grid.Row="2" Padding="18,16" Style="{StaticResource CalendarSurface}">
                            <Border.Resources>
                                <Style x:Key="MonthlyNumberUnitGap" TargetType="Border">
                                    <Setter Property="Width" Value="4"/>
                                    <Setter Property="Height" Value="0"/>
                                </Style>
                                <Style x:Key="MonthlyHoursUnitGap" TargetType="Border" BasedOn="{StaticResource MonthlyNumberUnitGap}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MonthlyTotalHoursUnitDisplay}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                                <Style x:Key="MonthlyMinutesUnitGap" TargetType="Border" BasedOn="{StaticResource MonthlyNumberUnitGap}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MonthlyTotalMinutesUnitDisplay}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
