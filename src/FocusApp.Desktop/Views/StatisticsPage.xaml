                            <TextBlock Grid.Row="0" Style="{StaticResource TodayFocusCardTitleStyle}" Text="今日专注" />
                            <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource TodayFocusMetricValueStyle}" FontWeight="Bold" Text="{Binding TodayFocusDurationCompact, Converter={StaticResource DurationTextPartConverter}, ConverterParameter=Value}" />
                                <TextBlock Style="{StaticResource TodayFocusMetricUnitStyle}" Text="{Binding TodayFocusDurationCompact, Converter={StaticResource DurationTextPartConverter}, ConverterParameter=Unit}" />
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Bottom" Orientation="Horizontal" Visibility="{Binding TodayFocusDurationCompact, Converter={StaticResource DurationTextPartConverter}, ConverterParameter=RemainderVisibility}">
                                    <TextBlock Style="{StaticResource TodayFocusMetricValueStyle}" FontWeight="Bold" Text="{Binding TodayFocusDurationCompact, Converter={StaticResource DurationTextPartConverter}, ConverterParameter=RemainderValue}" />
                                    <TextBlock Style="{StaticResource TodayFocusMetricUnitStyle}" Text="{Binding TodayFocusDurationCompact, Converter={StaticResource DurationTextPartConverter}, ConverterParameter=RemainderUnit}" />
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="SetExistingMonthlyFocusTargetButton" Visibility="{Binding ShowSetFocusGoal, Converter={StaticResource BooleanToVisibilityConverter}}" Grid.Row="2" Style="{StaticResource TodayFocusTargetLinkStyle}"
                                    AutomationProperties.Name="设置目标" Command="{Binding OpenFocusGoalSettingsCommand}" />
