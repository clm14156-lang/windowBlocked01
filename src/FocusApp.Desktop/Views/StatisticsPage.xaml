                                    <TextBlock Text="二" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="三" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="四" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="五" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="六" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                </UniformGrid>
                                <ItemsControl Grid.Row="2" Margin="0,4,0,0" ClipToBounds="False" ItemsSource="{Binding CalendarDays}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" ClipToBounds="False" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CalendarDayViewModel}">
                                            <Button MinHeight="48" VerticalAlignment="Stretch"
                                                    Margin="0"
                                                    Padding="0"
                                                    ClipToBounds="False"
                                                    Command="{Binding DataContext.SelectCalendarDateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource TransparentBrush}"
                                                    BorderThickness="0"
                                                    Focusable="{Binding CanSelect}"
                                                    FocusVisualStyle="{x:Null}"
                                                    IsEnabled="{Binding CanSelect}"
                                                    IsHitTestVisible="{Binding CanSelect}"
                                                    IsTabStop="{Binding CanSelect}">
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}">
                                                        <Setter Property="Cursor" Value="Arrow" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanSelect}" Value="True">
                                                                <Setter Property="Cursor" Value="Hand" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid Background="{DynamicResource TransparentBrush}" ClipToBounds="False">
                                                        <Grid x:Name="DayContent" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False">
                                                            <Border x:Name="DaySelectionBackground"
                                                                    Width="40"
                                                                    Height="40"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="10"
                                                                    IsHitTestVisible="False" />
                                                            <Grid Width="40" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="18"/></Grid.RowDefinitions>
                                                                <TextBlock x:Name="DayNumberText" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource TextPrimary}" Text="{Binding DayNumber}" />
                                                                <TextBlock x:Name="DayDurationText"
                                                                           Grid.Row="1"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="12"
                                                                           FontWeight="Normal"
                                                                           Foreground="{Binding HeatTextColor}"
                                                                           Text="{Binding DurationLabel}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="{x:Type TextBlock}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding HasFocus}" Value="True" />
                                                                                        <Condition Binding="{Binding IsCurrentMonth}" Value="True" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Grid>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="DayContent" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.1"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                                                                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="DayContent" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False"><Setter TargetName="DayNumberText" Property="Foreground" Value="{DynamicResource DisabledText}" /><Setter TargetName="DayDurationText" Property="Foreground" Value="{DynamicResource DisabledText}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding HasFocus}" Value="False"><Setter TargetName="DayNumberText" Property="Foreground" Value="{DynamicResource DisabledText}" /><Setter TargetName="DayDurationText" Property="Foreground" Value="{DynamicResource DisabledText}" /></DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding CanSelect}" Value="True" />
                                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                                                    <Condition Binding="{Binding IsSelected}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="DaySelectionBackground" Storyboard.TargetProperty="Opacity" To="0.72" Duration="0:0:0.15" /></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="DaySelectionBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" /></Storyboard></BeginStoryboard></MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="DaySelectionBackground" Property="Background" Value="{DynamicResource AccentPrimary}" />
                                                                <Setter TargetName="DaySelectionBackground" Property="Opacity" Value="1" />
                                                                <Setter TargetName="DayNumberText" Property="FontWeight" Value="Medium" />
                                                                <Setter TargetName="DayNumberText" Property="Foreground" Value="White" />
                                                                <Setter TargetName="DayDurationText" Property="Foreground" Value="White" />
                                                                <Setter TargetName="DayDurationText" Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <Border x:Name="CalendarSummaryDivider" Grid.Row="1" Height="1" Margin="0,16,0,16" Background="#F0F1F4"/>
                        <Border x:Name="CalendarMonthlySummary" Grid.Row="2" Background="Transparent">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="本月概括" FontSize="14" FontWeight="Medium" Foreground="#454C57"/>
