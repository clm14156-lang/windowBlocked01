                <Grid x:Name="CalendarPageLayout" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="336"/><ColumnDefinition Width="{StaticResource CardColumnGap}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="CalendarCard" Grid.Column="0" Padding="{StaticResource CardContentPadding}" Background="{DynamicResource SurfacePrimary}" BorderBrush="#ECECEF" BorderThickness="1" CornerRadius="10">
                        <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid x:Name="CalendarMonthRegion">
                                <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                                <Grid Height="30"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding CalendarMonthDisplay}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
