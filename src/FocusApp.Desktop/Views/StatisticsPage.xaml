<UserControl x:Class="FocusApp.Desktop.Views.StatisticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FocusApp.Desktop.ViewModels"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <views:GoalTrendLabelOffsetConverter x:Key="GoalTrendLabelOffsetConverter" />
        <Style x:Key="StatisticsTabStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Width" Value="106" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid>
                            <Border x:Name="TabBackground" Background="{TemplateBinding Background}" CornerRadius="4" />
                            <ContentPresenter Margin="0,0,0,4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="TabIndicator" Height="2" Margin="6,0" VerticalAlignment="Bottom" Background="{DynamicResource TransparentBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBackground" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter TargetName="TabIndicator" Property="Background" Value="{DynamicResource AccentPrimary}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatisticsRangeComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0,24,0" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <Grid>
                                    <TextBlock Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <Path Width="8" Height="5" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource TextSecondary}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeThickness="1.4" />
                                    <ToggleButton Background="{DynamicResource TransparentBrush}" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template><ControlTemplate TargetType="{x:Type ToggleButton}"><Border Background="{TemplateBinding Background}" /></ControlTemplate></ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Fade">
                                <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,4,0,0" Padding="4" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="8">
                                    <ScrollViewer MaxHeight="120" CanContentScroll="True"><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatisticsProgressBarStyle" TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="10" />
            <Setter Property="Background" Value="{DynamicResource BackgroundSecondary}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid x:Name="PART_Track">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="5" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatisticsThinScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Opacity" Value="0.48" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="6" Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   Margin="0,3"
                                   IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Width="4"
                                                        Margin="1,0"
                                                        HorizontalAlignment="Center"
                                                        Background="{DynamicResource TextSecondary}"
                                                        CornerRadius="2"
                                                        Opacity="0.72" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource TransparentBrush}"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,0,13,10">
            <Grid Width="318" Height="35" Margin="20,0,0,14" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton AutomationProperties.Name="{DynamicResource StatisticsOverviewTab}" Command="{Binding SelectOverviewCommand}" IsChecked="{Binding IsOverviewSelected, Mode=OneWay}" Style="{StaticResource StatisticsTabStyle}"><StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,10,0" FontFamily="Segoe MDL2 Assets" FontSize="19" Text="&#xE823;" /><TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{DynamicResource StatisticsOverviewTab}" /></StackPanel></RadioButton>
                    <RadioButton AutomationProperties.Name="{DynamicResource StatisticsCalendarTab}" Command="{Binding SelectCalendarCommand}" IsChecked="{Binding IsCalendarSelected, Mode=OneWay}" Style="{StaticResource StatisticsTabStyle}"><StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,10,0" FontFamily="Segoe MDL2 Assets" FontSize="19" Text="&#xE787;" /><TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{DynamicResource StatisticsCalendarTab}" /></StackPanel></RadioButton>
                    <RadioButton AutomationProperties.Name="{DynamicResource StatisticsGoalsTab}" Command="{Binding SelectGoalsCommand}" IsChecked="{Binding IsGoalsSelected, Mode=OneWay}" Style="{StaticResource StatisticsTabStyle}"><StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,10,0" FontFamily="Segoe MDL2 Assets" FontSize="19" Text="&#xE9D2;" /><TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{DynamicResource StatisticsGoalsTab}" /></StackPanel></RadioButton>
                </StackPanel>
                <Border VerticalAlignment="Bottom" Height="1" Background="{DynamicResource BorderPrimary}" Panel.ZIndex="-1" />
            </Grid>

            <StackPanel Margin="20,0,13,0" Visibility="{Binding IsOverviewSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Height="106" Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Padding="22,16" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition /></Grid.ColumnDefinitions><Ellipse Width="58" Height="58" Fill="{DynamicResource AccentTint}" /><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource AccentPrimary}" Text="&#xE823;" /><StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Margin="0,4,0,-4" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource StatisticsTodayDuration}" /><StackPanel Margin="0,8,0,0" Orientation="Horizontal"><TextBlock FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="42" FontWeight="Normal" Foreground="{DynamicResource AccentPrimary}" Text="2" /><TextBlock Margin="7,21,12,0" FontSize="19" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource StatisticsHoursUnit}" /><TextBlock FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="42" FontWeight="Normal" Foreground="{DynamicResource AccentPrimary}" Text="15" /><TextBlock Margin="7,21,0,0" FontSize="19" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource StatisticsMinutesUnit}" /></StackPanel></StackPanel></Grid></Border>
                <Border Grid.Column="2" Padding="22,16" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition /></Grid.ColumnDefinitions><Ellipse Width="58" Height="58" Fill="{DynamicResource AccentTint}" /><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource AccentPrimary}" Text="&#xE9D2;" /><StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Margin="0,4,0,-4" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource StatisticsTodayCount}" /><StackPanel Margin="0,5,0,0" Orientation="Horizontal"><TextBlock FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="42" FontWeight="Normal" Foreground="{DynamicResource TextPrimary}" Text="{Binding TodayFocusCount}" /><TextBlock Margin="7,21,0,0" FontSize="19" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource StatisticsSessionsUnit}" /></StackPanel></StackPanel></Grid></Border>
            </Grid>

            <Border x:Name="TrendCard" Height="350" Padding="24,13,24,14" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="16"><StackPanel>
                <Grid Height="30"><ComboBox Width="74" HorizontalAlignment="Right" VerticalAlignment="Top" ItemsSource="{Binding RangeOptions}" SelectedItem="{Binding SelectedRange}" DisplayMemberPath="Label" Style="{StaticResource StatisticsRangeComboBoxStyle}" /></Grid>
                <Grid Height="206" Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition /></Grid.ColumnDefinitions><ItemsControl Margin="0,9,0,0" ItemsSource="{Binding YAxisTicks}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Top" Value="{Binding ChartY}" /></Style></ItemsControl.ItemContainerStyle><ItemsControl.ItemTemplate><DataTemplate><TextBlock Width="34" Margin="0,-9,0,0" TextAlignment="Left" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="{Binding Label}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Grid Grid.Column="1"><Border Margin="0,0,0,46" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource BorderPrimary}" /><views:TrendChart x:Name="TrendChartControl" DataContext="{Binding}" /></Grid></Grid>
                <Border Height="66" Margin="-24,8,-24,0" Padding="0,4" Background="{DynamicResource TransparentBrush}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0,1,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Border BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0,0,1,0"><StackPanel Margin="0,8,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="{Binding PeriodTotalLabel}" /><TextBlock Margin="0,8,0,0" FontSize="18" FontWeight="Normal" Foreground="{DynamicResource TextPrimary}" Text="{Binding PeriodTotalDisplay}" /></StackPanel></Border><Border Grid.Column="1" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0,0,1,0"><StackPanel Margin="0,8,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource StatisticsAverageDuration}" /><TextBlock Margin="0,8,0,0" FontSize="18" FontWeight="Normal" Foreground="{DynamicResource TextPrimary}" Text="{Binding AverageDurationDisplay}" /></StackPanel></Border><StackPanel Grid.Column="2" Margin="0,8,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="{Binding ComparisonLabel}" /><StackPanel Margin="0,8,0,0" HorizontalAlignment="Center" Orientation="Horizontal"><TextBlock FontSize="18" FontWeight="Normal" Foreground="{DynamicResource Success}" Text="{Binding ComparisonDisplay}" /><Border Width="22" Height="22" Margin="8,0,0,0" Background="{DynamicResource SuccessTint}" CornerRadius="12"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Success}" Text="&#xE74A;" /></Border></StackPanel></StackPanel></Grid></Border>
            </StackPanel></Border>

            <Border x:Name="MonthlyFocusTargetCard" Height="114" Margin="0,10,0,0" Padding="24,12" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="16">
                <Grid>
                    <Grid x:Name="MonthlyFocusTargetEmptyState"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasMonthlyFocusTarget}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="248" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="90" Height="78" Margin="0,-2,13,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Width="66" Height="66" Fill="{DynamicResource AccentTint}" Opacity="0.65" />
                            <Ellipse Width="44" Height="44" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="4" />
                            <Ellipse Width="20" Height="20" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="4" />
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentPrimary}" />
                            <Line X1="57" Y1="31" X2="76" Y2="12" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path Data="M 70,11 L 82,6 L 77,18 Z" Fill="{DynamicResource AccentPrimary}" />
                        </Grid>
                        <Border Grid.Column="0" Width="1" Height="88" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource BorderPrimary}" />
                        <Grid Grid.Column="1" Margin="24,0,0,0">
                            <TextBlock Margin="0,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="设定本月专注目标" />
                            <Button x:Name="SetMonthlyFocusTargetButton" Width="96" Height="29" Margin="0,45,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource SurfacePrimary}" BorderBrush="#FDDEC4" BorderThickness="1" Foreground="#FDA767" PreviewMouseLeftButtonDown="MonthlyFocusTargetAnchor_PreviewMouseLeftButtonDown" Click="SetMonthlyFocusTargetButton_Click">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" TextElement.Foreground="{TemplateBinding Foreground}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Button.Template>
                                <TextBlock FontSize="13" FontWeight="Medium" Foreground="#FDA767" Text="设置目标" />
                            </Button>
                        </Grid>
                    </Grid>
                    <Grid x:Name="MonthlyFocusTargetSetState"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasMonthlyFocusTarget}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="290" /><ColumnDefinition /><ColumnDefinition Width="55" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Top"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="44" FontWeight="Normal" Foreground="{DynamicResource AccentPrimary}" Text="{Binding MonthlyFocusCompletedHours}" /><TextBlock Margin="8,20,0,0" FontSize="18" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource StatisticsHoursUnit}" /><TextBlock Margin="16,20,0,0" FontSize="18" Foreground="{DynamicResource TextPrimary}" Text="/" /><TextBlock Margin="16,20,0,0" FontSize="18" Foreground="{DynamicResource TextPrimary}" Text="{Binding MonthlyFocusTargetDisplay}" /></StackPanel><TextBlock Margin="0,2,0,0" FontSize="13" Foreground="{DynamicResource TextSecondary}"><Run Text="距离目标还差 " /><Run Text="{Binding MonthlyFocusRemainingDisplay, Mode=OneWay}" /></TextBlock></StackPanel>
                        <ProgressBar Grid.Column="1" Margin="8,0,5,0" VerticalAlignment="Center" Maximum="1" Value="{Binding MonthlyFocusProgressRatio, Mode=OneWay}" Style="{StaticResource StatisticsProgressBarStyle}" />
                        <Grid Grid.Column="2"><Button x:Name="EditMonthlyFocusTargetButton" Width="34" Height="24" Margin="0,-10,-18,0" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="0" Background="{DynamicResource TransparentBrush}" BorderThickness="0" FontFamily="Segoe UI" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Content="•••" ToolTip="编辑本月目标" PreviewMouseLeftButtonDown="MonthlyFocusTargetAnchor_PreviewMouseLeftButtonDown" Click="EditMonthlyFocusTargetButton_Click" /><TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="18" FontWeight="Normal" Foreground="{DynamicResource TextPrimary}" Text="{Binding MonthlyFocusProgressPercent, StringFormat={}{0}%}" /></Grid>
                    </Grid>
                </Grid>
                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfacePrimary}" /></Style></Border.Style>
            </Border>
            </StackPanel>
            <StackPanel Visibility="{Binding IsCalendarSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Width="695" Height="602" Margin="0,3,0,0" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="346" /><ColumnDefinition Width="18" /><ColumnDefinition Width="331" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Border Height="388" Padding="0,17,0,10" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" ClipToBounds="False" CornerRadius="16">
                            <StackPanel ClipToBounds="False">
                                <Grid Height="30" Margin="20,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="62" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="Normal" Foreground="{DynamicResource TextPrimary}" Text="{Binding CalendarMonthDisplay}" />
                                    <Grid Grid.Column="1" Width="62" HorizontalAlignment="Right">
                                        <Button Width="28" Height="28" Margin="-12,0,0,0" HorizontalAlignment="Left" Padding="0" Background="{DynamicResource TransparentBrush}" BorderThickness="0" Command="{Binding PreviousCalendarMonthCommand}"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextPrimary}" Text="&#xE76B;" /></Button>
                                        <Button Width="28" Height="28" Margin="0,0,-4,0" HorizontalAlignment="Right" Padding="0" Background="{DynamicResource TransparentBrush}" BorderThickness="0" Command="{Binding NextCalendarMonthCommand}"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextPrimary}" Text="&#xE76C;" /></Button>
                                    </Grid>
                                </Grid>
                                <Border Margin="20,11,20,7" Height="1" Background="{DynamicResource BorderPrimary}" />
                                <UniformGrid Columns="7" Margin="6,0,6,4">
                                    <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="日" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="一" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="二" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="三" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="四" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="五" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="六" />
                                </UniformGrid>
                                <ItemsControl Margin="6,13,6,0" ClipToBounds="False" ItemsSource="{Binding CalendarDays}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" ClipToBounds="False" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CalendarDayViewModel}">
                                            <Button Height="46" Margin="1" Padding="0" ClipToBounds="False" Command="{Binding DataContext.SelectCalendarDateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Background="{DynamicResource TransparentBrush}" BorderThickness="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False">
                                                            <Ellipse x:Name="DaySelectionBackground"
                                                                     Width="40"
                                                                     Height="40"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"
                                                                     Fill="{TemplateBinding Background}"
                                                                     IsHitTestVisible="False" />
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock x:Name="DayNumberText" HorizontalAlignment="Center" FontSize="15" FontWeight="Normal" Foreground="{DynamicResource TextPrimary}" Text="{Binding DayNumber}" />
                                                                <TextBlock x:Name="DayDurationText" Margin="0,2,0,0" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondary}" Text="{Binding DurationLabel}" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False"><Setter Property="Opacity" Value="0.55" /></DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DaySelectionBackground" Property="Fill" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="DaySelectionBackground" Property="Fill" Value="{DynamicResource AccentPrimary}" />
                                                                <Setter TargetName="DayNumberText" Property="Foreground" Value="{DynamicResource SurfacePrimary}" />
                                                                <Setter TargetName="DayDurationText" Property="Foreground" Value="{DynamicResource SurfacePrimary}" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Height="205" Margin="0,9,0,0" Padding="20,13,20,10" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="16">
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="Normal" Foreground="{DynamicResource TextPrimary}" Text="目标投入分布" />
                                <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding GoalDistributions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GoalDistributionViewModel}">
                                            <Grid Height="25">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="77" /><ColumnDefinition Width="80" /><ColumnDefinition Width="99" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimary}" Text="{Binding TargetName}" />
                                                <ProgressBar Grid.Column="1" Height="5" Margin="0,0,9,0" VerticalAlignment="Center" Maximum="1" Value="{Binding Ratio, Mode=OneWay}" Style="{StaticResource StatisticsProgressBarStyle}" />
                                                <TextBlock Grid.Column="2" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="{Binding DurationDisplay}" />
                                                <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimary}" Text="{Binding RatioDisplay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border Grid.Column="2" Height="602" Padding="27,20,24,20" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="16">
                        <StackPanel>
                            <Grid Height="24">
                                <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="Normal" Foreground="{DynamicResource TextPrimary}" Text="{Binding SelectedDateDisplay}" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <TextBlock Margin="0,0,16,0" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextSecondary}" Text="&#xE76B;" />
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextSecondary}" Text="&#xE76C;" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,29,0,24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0"><TextBlock FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="30" FontWeight="Normal" Foreground="{DynamicResource AccentPrimary}" Text="{Binding SelectedDayDurationDisplay}" /><TextBlock Margin="0,7,0,0" FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="专注时长" /></StackPanel>
                                <Border Grid.Column="0" HorizontalAlignment="Right" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0,0,1,0" />
