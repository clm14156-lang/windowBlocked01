                    <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition/></Grid.RowDefinitions>
                    <Grid>
                        <TextBlock x:Name="PeriodFocusDistributionTitle" Text="投入分布" Style="{StaticResource TodayFocusCardTitleStyle}" />
