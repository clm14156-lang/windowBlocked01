                                    <StackPanel Grid.Column="2" Margin="14,0,8,0">
                                        <StackPanel Orientation="Horizontal"><Border Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" BorderBrush="#656A7A" BorderThickness="1.3" CornerRadius="8"><Path Width="8" Height="6" Stretch="Fill" Data="M 0,3 L 2.7,5.5 L 8,0" Stroke="#656A7A" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Border><TextBlock Text="专注次数" Style="{StaticResource GoalMetricCaptionStyle}"/></StackPanel>
                                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextPrimary}"><Run Text="{Binding SelectedGoalFocusCount, Mode=OneWay}" FontSize="25" FontWeight="Medium"/><Run Text=" 次" FontSize="13"/></TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="3" Height="48" VerticalAlignment="Top" Margin="0,5,0,0" Background="#EEEEF2"/>
                                    <StackPanel Grid.Column="4" Margin="14,0,0,0">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE787;" Style="{StaticResource GoalMetricIconStyle}"/><TextBlock Text="最近一次专注" Style="{StaticResource GoalMetricCaptionStyle}"/></StackPanel>
                                        <TextBlock Margin="0,8,0,0" FontSize="21" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{Binding SelectedGoalLatestDate}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="2"><TextBlock VerticalAlignment="Center" Text="专注记录" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/><TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="查看趋势  ›" FontSize="13" Foreground="{DynamicResource TextWeak}"/><Border Height="1" VerticalAlignment="Bottom" Background="#EEEEF2"/></Grid>
                                <Grid Grid.Row="3">
                                    <ScrollViewer x:Name="GoalProgressScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ScrollViewer.Resources><Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource StatisticsThinScrollBarStyle}"/></ScrollViewer.Resources>
                                        <ItemsControl x:Name="GoalDateGroupsControl" ItemsSource="{Binding GoalDateGroups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:GoalDateGroupViewModel}">
                                                    <Border Background="Transparent" BorderBrush="#EEEEF2" BorderThickness="0,0,0,1">
                                                        <StackPanel>
                                                            <Button Height="48" Padding="16,0" Style="{StaticResource GoalRecordRowStyle}" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.ToggleGoalDateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding DateDisplay}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding WeekdayDisplay}" Margin="14,0,0,0" FontSize="12" Foreground="{DynamicResource TextWeak}" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding DurationDisplay}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Button>
                                                            <ItemsControl Margin="14,2,12,10" ItemsSource="{Binding Sessions}" Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:FocusSessionRecordViewModel}">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                            <Border Width="1" Margin="0,14,0,-14" HorizontalAlignment="Left" Background="#EEEEF2" Visibility="{Binding IsLastInGoalDateGroup, Converter={StaticResource GoalInverseVisibilityConverter}}"/>
                                                                            <Ellipse Width="5" Height="5" Margin="-2,13,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#A5A5AE"/>
                                                                            <Button Grid.Column="1" MinHeight="60" Padding="10,8,0,10" Background="Transparent" HorizontalContentAlignment="Stretch" Style="{StaticResource GoalRecordRowStyle}" Click="FocusRecord_Click">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
                                                                                    <StackPanel>
                                                                                        <TextBlock Text="{Binding TimeRangeDisplay}" FontSize="13" FontWeight="Medium"/>
                                                                                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                                                                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextWeak}" VerticalAlignment="Center"/>
                                                                                            <TextBlock Text="{Binding CalendarDurationDisplay}" Margin="6,0,14,0" FontSize="11" Foreground="{DynamicResource TextWeak}"/>
                                                                                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasCompletedTasks, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                                <Border Width="12" Height="12" VerticalAlignment="Center" BorderBrush="{DynamicResource Success}" BorderThickness="1" CornerRadius="6"><Path Width="6" Height="4" Stretch="Fill" Data="M 0,2 L 2,4 L 6,0" Stroke="{DynamicResource Success}" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Border>
                                                                                                <TextBlock Margin="6,0,0,0" FontSize="11" Foreground="{DynamicResource TextSecondary}"><Run Text="完成 "/><Run Text="{Binding CompletedTaskCount, Mode=OneWay}"/><Run Text=" 项"/></TextBlock>
                                                                                            </StackPanel>
                                                                                        </StackPanel>
                                                                                    </StackPanel>
                                                                                    <TextBlock Grid.Column="1" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource TextWeak}" VerticalAlignment="Center"/>
                                                                                </Grid>
                                                                            </Button>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Text="暂无专注记录" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextWeak}" Visibility="{Binding HasSelectedGoalRecords, Converter={StaticResource GoalInverseVisibilityConverter}}"/>
                                </Grid>
                                <Border Grid.RowSpan="4" Background="{DynamicResource SurfacePrimary}" Visibility="{Binding HasSelectedGoal, Converter={StaticResource GoalInverseVisibilityConverter}}"><TextBlock Text="暂无目标" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextWeak}"/></Border>
                            </Grid>
                            <Grid x:Name="GoalInvestmentDetailsLockedPlaceholder" Visibility="{Binding CanViewGoalInvestmentDetails, Converter={StaticResource GoalInverseVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="目标专注记录" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <Border x:Name="GoalInvestmentDetailsVipHoverTarget" Margin="0,16,0,0" Padding="12,8" Background="{DynamicResource AccentTint}" CornerRadius="8" MouseEnter="GoalInvestmentDetailsVipHoverTarget_MouseEnter" MouseLeave="GoalInvestmentDetailsVipHoverTarget_MouseLeave"><TextBlock Text="VIP 专享 · 查看目标投入详情" Foreground="{DynamicResource TextSecondary}"/></Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Popup x:Name="GoalInvestmentDetailsVipGuidePopup"
                       Width="300"
                       Height="170"
                       AllowsTransparency="True"
                       IsOpen="{Binding IsGoalInvestmentDetailsVipGuideOpen, Mode=TwoWay}"
                       Placement="Custom"
                       PlacementTarget="{Binding ElementName=GoalInvestmentDetailsVipHoverTarget}"
                       PopupAnimation="Fade"
                       StaysOpen="True">
                    <Border Width="300"
                            Height="170"
                            Padding="18"
                            Background="{DynamicResource SurfacePrimary}"
                            BorderBrush="{DynamicResource BorderPrimary}"
                            BorderThickness="1"
                            CornerRadius="12"
                            MouseEnter="GoalInvestmentDetailsVipGuide_MouseEnter"
                            MouseLeave="GoalInvestmentDetailsVipGuide_MouseLeave">
                        <Border.Effect><DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.12" ShadowDepth="4" /></Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Border Width="54" Height="54" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource AccentTint}" CornerRadius="27">
                                <Viewbox Width="29" Height="25">
                                    <Path Data="M 2,6 L 8,13 L 14,4 L 20,13 L 26,6 L 23,22 L 5,22 Z M 5,18 L 23,18" Fill="{DynamicResource TransparentBrush}" Stroke="{DynamicResource AccentPrimary}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="2" />
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="解锁目标投入详情" />
                                    <Border Margin="9,0,0,0" Padding="8,2" Background="{DynamicResource AccentTint}" BorderBrush="{DynamicResource AccentSoftBorder}" BorderThickness="1" CornerRadius="9">
                                        <TextBlock FontSize="12" FontWeight="Medium" Foreground="{DynamicResource AccentPrimary}" Text="VIP" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="0,12,0,0" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" LineHeight="19" Text="开通 VIP 后可查看当前目标的详细记录、投入趋势和任务记录。" TextWrapping="Wrap" />
                                <Button Width="120" Height="34" Margin="0,12,0,0" HorizontalAlignment="Left" Padding="0" Background="{DynamicResource AccentPrimary}" BorderThickness="0" Click="GoalInvestmentDetailsVipGuideOpenButton_Click" Cursor="Hand" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource WhiteText}" Content="立即开通">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="GuideButtonBackground" Background="{TemplateBinding Background}" CornerRadius="9">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="GuideButtonBackground" Property="Opacity" Value="0.9" /></Trigger>
                                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="GuideButtonBackground" Property="Opacity" Value="0.78" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Popup>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
    <Popup x:Name="TrendTooltipPopup"
           DataContext="{Binding}"
           AllowsTransparency="True"
           Closed="TrendTooltipPopup_Closed"
           Focusable="False"
           IsHitTestVisible="False"
           IsOpen="{Binding IsTooltipOpen, Mode=OneWay}"
           Opened="TrendTooltipPopup_Opened"
           Placement="Relative"
           PlacementTarget="{Binding ElementName=TrendCard}"
           HorizontalOffset="{Binding TooltipOffsetX}"
           VerticalOffset="{Binding TooltipOffsetY}"
           PopupAnimation="Fade">
        <Border Width="150"
                Padding="12,9"
                Background="{DynamicResource SurfacePrimary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="1"
                CornerRadius="8"
                Focusable="False"
                IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.1" ShadowDepth="2" /></Border.Effect>
            <StackPanel DataContext="{Binding HoveredPoint}">
                <TextBlock FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextUnit}" Text="{Binding TooltipDateDisplay}" />
                <TextBlock Margin="0,5,0,0" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource AccentPrimary}" Text="{Binding TooltipDurationDisplay}" />
            </StackPanel>
        </Border>
    </Popup>
    <Popup x:Name="GoalTrendTooltipPopup"
           DataContext="{Binding}"
           AllowsTransparency="True"
           IsHitTestVisible="False"
           IsOpen="{Binding IsGoalTrendTooltipOpen, Mode=OneWay}"
           Placement="Relative"
           PlacementTarget="{Binding ElementName=GoalTrendChartArea}"
           HorizontalOffset="{Binding GoalTrendTooltipOffsetX}"
           VerticalOffset="{Binding GoalTrendTooltipOffsetY}"
           PopupAnimation="Fade">
        <Grid Width="176" Height="88" DataContext="{Binding HoveredGoalTrendPoint}">
            <Border Width="168"
                    Height="74"
                    Margin="4,3,4,0"
                    Padding="14,11"
                    VerticalAlignment="Top"
                    Background="{DynamicResource SurfacePrimary}"
                    BorderBrush="{DynamicResource BorderPrimary}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Border.Effect><DropShadowEffect BlurRadius="14" Direction="270" Opacity="0.13" ShadowDepth="3" /></Border.Effect>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding TooltipDateDisplay}" />
                    <TextBlock Margin="0,6,0,0" FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" Text="{Binding TooltipDurationDisplay}" />
                </StackPanel>
            </Border>
            <Path Width="12"
                  Height="7"
                  Margin="0,0,0,4"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  Data="M 0,0 L 12,0 L 6,7 Z"
                  Fill="{DynamicResource SurfacePrimary}"
                  Stroke="{DynamicResource BorderPrimary}"
                  StrokeLineJoin="Round"
                  StrokeThickness="1" />
        </Grid>
    </Popup>
    <Popup x:Name="MonthlyFocusTargetPopup"
           DataContext="{Binding}"
           AllowsTransparency="True"
           StaysOpen="False"
           IsOpen="{Binding IsMonthlyFocusTargetPopupOpen, Mode=TwoWay}"
           Placement="Custom"
           Opened="MonthlyFocusTargetPopup_Opened"
           PopupAnimation="Fade">
        <Border Width="340" Height="310" Padding="29,25" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="18">
            <Border.Effect><DropShadowEffect BlurRadius="22" Direction="270" Opacity="0.12" ShadowDepth="5" /></Border.Effect>
            <Grid>
                <StackPanel>
                    <TextBlock FontSize="18.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding MonthlyFocusTargetPopupTitle}" />
                    <TextBlock Margin="0,25,0,8" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="本月目标时长" />
                    <Border Height="78" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="55" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="MonthlyFocusTargetInputBox"
                                     Grid.Column="0"
                                     Margin="44,0,0,0"
                                     Style="{StaticResource MonthlyTargetInputStyle}"
                                     Text="{Binding MonthlyFocusTargetInput, UpdateSourceTrigger=PropertyChanged}" />
                            <Border Grid.Column="1" Width="1" Height="44" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource BorderPrimary}" />
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="小时" />
                            <Border Grid.Column="2" Width="1" Margin="0,12" HorizontalAlignment="Left" Background="{DynamicResource BorderPrimary}" />
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <Button Grid.Row="0" AutomationProperties.Name="增加目标小时" Command="{Binding IncreaseMonthlyFocusTargetCommand}" Style="{StaticResource MonthlyTargetStepButtonStyle}">
                                    <Path Width="10" Height="6" Data="M 1,5 L 5,1 L 9,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.6" />
                                </Button>
                                <Border Grid.Row="1" Height="1" VerticalAlignment="Top" Background="{DynamicResource BorderPrimary}" />
                                <Button Grid.Row="1" AutomationProperties.Name="减少目标小时" Command="{Binding DecreaseMonthlyFocusTargetCommand}" Style="{StaticResource MonthlyTargetStepButtonStyle}">
                                    <Path Width="10" Height="6" Data="M 1,1 L 5,5 L 9,1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.6" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock Margin="0,12,0,0" FontSize="13" Foreground="{DynamicResource TextSecondary}"><Run Text="当前已完成 " /><Run Foreground="{DynamicResource AccentPrimary}" Text="{Binding MonthlyFocusCompletedHours, Mode=OneWay}" /><Run Foreground="{DynamicResource TextPrimary}" Text=" 小时 " /><Run Foreground="{DynamicResource AccentPrimary}" Text="{Binding MonthlyFocusCompletedMinutesRemainder, Mode=OneWay}" /><Run Foreground="{DynamicResource TextPrimary}" Text=" 分钟" /></TextBlock>
                    <Border Height="1" Margin="0,25,0,15" Background="{DynamicResource BorderPrimary}" Opacity="0.75" />
                    <Grid Height="38">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Margin="0,0,14,0" Content="取消" Command="{Binding CancelMonthlyFocusTargetCommand}" Style="{StaticResource MonthlyTargetTextButtonStyle}" />
                        <Button Grid.Column="1" Margin="1,0,0,0" Command="{Binding SaveMonthlyFocusTargetCommand}" Style="{StaticResource MonthlyTargetPrimaryButtonStyle}"><TextBlock Foreground="White" Text="保存" /></Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Popup>
    </Grid>
</UserControl>
