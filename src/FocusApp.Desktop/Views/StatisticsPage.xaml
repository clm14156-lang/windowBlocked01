<UserControl x:Class="FocusApp.Desktop.Views.StatisticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FocusApp.Desktop.ViewModels"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,16,40,10">
            <Grid Height="34" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Border Width="122" BorderBrush="{DynamicResource AccentPrimary}" BorderThickness="0,0,0,2"><StackPanel HorizontalAlignment="Center" Orientation="Horizontal"><TextBlock Margin="0,0,10,0" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource AccentPrimary}" Text="&#xE823;" /><TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" Text="{DynamicResource StatisticsOverviewTab}" /></StackPanel></Border>
                    <StackPanel Width="122" HorizontalAlignment="Center" Orientation="Horizontal"><TextBlock Margin="0,0,10,0" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource TextSecondary}" Text="&#xE787;" /><TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource StatisticsCalendarTab}" /></StackPanel>
                    <StackPanel Width="122" HorizontalAlignment="Center" Orientation="Horizontal"><TextBlock Margin="0,0,10,0" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource TextSecondary}" Text="&#xE9D2;" /><TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource StatisticsGoalsTab}" /></StackPanel>
                </StackPanel>
                <Border VerticalAlignment="Bottom" Height="1" Background="{DynamicResource BorderPrimary}" Panel.ZIndex="-1" />
            </Grid>

            <Grid Height="22" Margin="0,0,0,8"><TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource StatisticsTodayOverview}" /><TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="{Binding TodayDateDisplay}" /></Grid>

            <Grid Height="108" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Padding="24,17" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition /></Grid.ColumnDefinitions><Ellipse Width="60" Height="60" Fill="{DynamicResource AccentTint}" /><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="29" Foreground="{DynamicResource AccentPrimary}" Text="&#xE823;" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource StatisticsTodayDuration}" /><StackPanel Margin="0,8,0,0" Orientation="Horizontal"><TextBlock FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="42" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" Text="2" /><TextBlock Margin="7,21,12,0" FontSize="19" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource StatisticsHoursUnit}" /><TextBlock FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="42" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" Text="15" /><TextBlock Margin="7,21,0,0" FontSize="19" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource StatisticsMinutesUnit}" /></StackPanel></StackPanel></Grid></Border>
                <Border Grid.Column="2" Padding="24,17" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition /></Grid.ColumnDefinitions><Ellipse Width="60" Height="60" Fill="{DynamicResource AccentTint}" /><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="29" Foreground="{DynamicResource AccentPrimary}" Text="&#xE9D2;" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource StatisticsTodayCount}" /><StackPanel Margin="0,5,0,0" Orientation="Horizontal"><TextBlock FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="42" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding TodayFocusCount}" /><TextBlock Margin="7,21,0,0" FontSize="19" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource StatisticsSessionsUnit}" /></StackPanel></StackPanel></Grid></Border>
            </Grid>

            <Border x:Name="TrendCard" Height="310" Padding="24,16,24,14" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="16"><StackPanel>
                <Grid Height="30"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="118" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Orientation="Horizontal"><TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding TrendTitleDisplay}" /><TextBlock Margin="24,5,0,0" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="{Binding TrendPeriodLabel}" /></StackPanel><ComboBox Grid.Column="1" Height="34" Padding="8,0" VerticalAlignment="Top" HorizontalContentAlignment="Center" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" Foreground="{DynamicResource TextPrimary}" FontSize="14" ItemsSource="{Binding RangeOptions}" SelectedItem="{Binding SelectedRange}" DisplayMemberPath="Label" /></Grid>
                <Grid Height="170" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition /></Grid.ColumnDefinitions><ItemsControl ItemsSource="{Binding YAxisTicks}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Top" Value="{Binding ChartY}" /></Style></ItemsControl.ItemContainerStyle><ItemsControl.ItemTemplate><DataTemplate><TextBlock Width="34" Margin="0,-9,0,0" TextAlignment="Left" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="{Binding Label}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Grid Grid.Column="1"><Border Margin="0,0,0,40" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource BorderPrimary}" /><views:TrendChart x:Name="TrendChartControl" DataContext="{Binding}" /></Grid></Grid>
                <Border Height="58" Margin="0,8,0,0" Padding="0,4" Background="{DynamicResource BackgroundPrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Border BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0,0,1,0"><StackPanel HorizontalAlignment="Center"><TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="{Binding PeriodTotalLabel}" /><TextBlock Margin="0,1,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding PeriodTotalDisplay}" /></StackPanel></Border><Border Grid.Column="1" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0,0,1,0"><StackPanel HorizontalAlignment="Center"><TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource StatisticsAverageDuration}" /><TextBlock Margin="0,3,0,0" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding AverageDurationDisplay}" /></StackPanel></Border><StackPanel Grid.Column="2" HorizontalAlignment="Center"><TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="{Binding ComparisonLabel}" /><StackPanel Margin="0,3,0,0" HorizontalAlignment="Center" Orientation="Horizontal"><TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Success}" Text="{Binding ComparisonDisplay}" /><Border Width="22" Height="22" Margin="8,0,0,0" Background="{DynamicResource SuccessTint}" CornerRadius="12"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Success}" Text="&#xE74A;" /></Border></StackPanel></StackPanel></Grid></Border>
            </StackPanel></Border>

            <Border Height="104" Margin="0,10,0,0" Padding="0,12" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="290" /><ColumnDefinition /></Grid.ColumnDefinitions><Grid Grid.Column="0" Margin="96,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="160" Height="78"><Ellipse Width="72" Height="72" Fill="{DynamicResource AccentTint}" Opacity="0.65" /><Ellipse Width="52" Height="52" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="5" /><Ellipse Width="25" Height="25" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="5" /><Ellipse Width="7" Height="7" Fill="{DynamicResource AccentPrimary}" /><Path Margin="96,3,20,48" Data="M 0,24 L 30,0 L 25,25 L 10,20 Z" Fill="{DynamicResource AccentPrimary}" /><TextBlock Margin="-50,44,0,0" HorizontalAlignment="Left" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentPrimary}" Text="&#xE734;" Opacity="0.55" /></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource StatisticsGoalTitle}" /><TextBlock Margin="0,5,0,0" FontSize="14" Foreground="{DynamicResource TextTertiary}" Text="{DynamicResource StatisticsGoalDescription}" /><Button Width="118" Height="34" Margin="0,10,0,0" HorizontalAlignment="Left" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource AccentPrimary}" BorderThickness="1" Foreground="{DynamicResource AccentPrimary}" FontSize="14" FontWeight="SemiBold" Content="{DynamicResource StatisticsSetGoal}" /></StackPanel></Grid></Border>
        </StackPanel>
    </ScrollViewer>
    <Popup x:Name="TrendTooltipPopup"
           DataContext="{Binding}"
           AllowsTransparency="True"
           IsHitTestVisible="False"
           IsOpen="{Binding IsTooltipOpen, Mode=OneWay}"
           Placement="Relative"
           PlacementTarget="{Binding ElementName=TrendCard}"
           HorizontalOffset="{Binding TooltipOffsetX}"
           VerticalOffset="{Binding TooltipOffsetY}"
           PopupAnimation="Fade">
        <Border Width="150"
                Padding="10,8"
                Background="{DynamicResource SurfacePrimary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="1"
                CornerRadius="8">
            <Border.Effect><DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.16" ShadowDepth="2" /></Border.Effect>
            <StackPanel DataContext="{Binding HoveredPoint}">
                <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding TooltipDateDisplay}" />
                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="{Binding TooltipDurationDisplay}" />
            </StackPanel>
        </Border>
    </Popup>
    </Grid>
</UserControl>
