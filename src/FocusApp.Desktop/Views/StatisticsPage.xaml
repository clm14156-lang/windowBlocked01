    <Popup x:Name="CompletedTasksPopup" DataContext="{Binding}" AllowsTransparency="True" StaysOpen="True" Placement="Custom"
           PlacementTarget="{Binding ElementName=CompletedTasksButton}" IsOpen="{Binding IsChecked, ElementName=CompletedTasksButton, Mode=TwoWay}"
           Opened="CompletedTasksPopup_Opened" Closed="CompletedTasksPopup_Closed" PopupAnimation="Fade">
        <Border Padding="6" Background="Transparent">
            <Grid x:Name="CompletedTasksPopoverSurface" Width="300" MinHeight="140" MaxHeight="450" Focusable="True"
                  TextElement.FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI" PreviewKeyDown="CompletedTasksPopover_KeyDown">
                <Grid.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08" Color="#526070"/></Grid.Effect>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Path x:Name="CompletedTasksTopPointer" Width="18" Height="9" HorizontalAlignment="Left" Margin="220,0,0,-1" Fill="White" Data="M 0,9 L 9,0 L 18,9 Z"/>
                <Border x:Name="CompletedTasksPopoverBody" Grid.Row="1" CornerRadius="12" Background="White" BorderBrush="#EDF0F3" BorderThickness="1" Padding="18,14">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions><RowDefinition Height="21"/></Grid.RowDefinitions>
                            <TextBlock Text="已完成任务" FontSize="15" FontWeight="SemiBold" Foreground="#202936" VerticalAlignment="Center"/>
                        </Grid>
                        <ScrollViewer x:Name="CompletedTasksListScroll" Grid.Row="1" MaxHeight="362" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource StatisticsThinScrollBarStyle}"/></ScrollViewer.Resources>
                            <StackPanel>
                                <TextBlock x:Name="CompletedTasksEmpty" Text="当天还没有完成任务" Margin="0,14,0,10" HorizontalAlignment="Center" FontSize="11" Foreground="#929CAB"
                                           Visibility="{Binding HasSelectedDayCompletedTasks, Converter={StaticResource GoalInverseVisibilityConverter}}"/>
                                <ItemsControl x:Name="CompletedTasksList" ItemsSource="{Binding SelectedDayCompletedTaskGroups}" AlternationCount="2147483647">
                                    <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:CalendarCompletedTaskGroupViewModel}">
                                        <Border BorderBrush="#F0F2F5">
                                            <Border.Style><Style TargetType="Border">
                                                <Setter Property="BorderThickness" Value="0,1,0,0"/><Setter Property="Margin" Value="0,10,0,0"/><Setter Property="Padding" Value="0,10,0,0"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                                    <Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/>
                                                </DataTrigger></Style.Triggers>
                                            </Style></Border.Style>
                                            <StackPanel>
                                                <Grid Height="26" Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Image Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Source="{Binding GoalIconSource, Converter={x:Static views:TargetIconSourceConverter.Instance}}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding GoalName}" FontSize="12" FontWeight="SemiBold" Foreground="#303A48" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding TaskCountDisplay}" FontSize="10.5" Foreground="#98A1AF" VerticalAlignment="Center"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Tasks}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:CalendarCompletedTaskEntryViewModel}">
                                                    <StackPanel Margin="0,0,0,2">
                                                        <Grid MinHeight="24">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                                                            <Border x:Name="CompletedMainTaskIcon" Width="16" Height="16" CornerRadius="3" Background="#FFF6EC" BorderBrush="#FFAA71" BorderThickness="1"
                                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <Path Width="8" Height="6" Data="M 0,3 L 3,6 L 8,0" Stroke="#FF871C" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11.5" Foreground="#374150" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding TimeDisplay}" FontSize="10.5" Foreground="#98A1AF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <StackPanel Margin="27,0,0,2" Visibility="{Binding HasSubTasks, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <ItemsControl ItemsSource="{Binding VisibleSubTasks}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:CalendarCompletedSubTaskViewModel}">
                                                                <Grid MinHeight="22">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                                    <Grid x:Name="CompletedSubTaskIcon" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                        <Ellipse Fill="#FFE9D8"/>
                                                                        <Path Width="7" Height="5" Data="M 0,2.5 L 2.5,5 L 7,0" Stroke="#FF871C" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="10.5" Foreground="#939EAE" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                                            <Button Content="{Binding FoldLabel}" Command="{Binding ToggleSubTasksCommand}" Visibility="{Binding HasOverflow, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    Height="22" HorizontalAlignment="Left" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#98A1AF" FontSize="10.5" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                                                <Button.Template><ControlTemplate TargetType="Button"><ContentPresenter/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#697585"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                                                            </Button>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <Path x:Name="CompletedTasksBottomPointer" Grid.Row="2" Width="18" Height="9" HorizontalAlignment="Left" Margin="220,-1,0,0" Fill="White" Visibility="Collapsed" Data="M 0,0 L 9,9 L 18,0 Z"/>
            </Grid>
        </Border>
    </Popup>
    <Popup x:Name="TrendTooltipPopup"
           DataContext="{Binding}"
           AllowsTransparency="True"
           Closed="TrendTooltipPopup_Closed"
           Focusable="False"
           IsHitTestVisible="False"
           IsOpen="{Binding IsTooltipOpen, Mode=OneWay}"
           Opened="TrendTooltipPopup_Opened"
           Placement="Relative"
           PlacementTarget="{Binding ElementName=TrendCard}"
           HorizontalOffset="{Binding TooltipOffsetX}"
           VerticalOffset="{Binding TooltipOffsetY}"
           PopupAnimation="Fade">
        <Border Width="150"
                Padding="12,9"
                Background="{DynamicResource SurfacePrimary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="1"
                CornerRadius="8"
                Focusable="False"
                IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.1" ShadowDepth="2" /></Border.Effect>
            <StackPanel DataContext="{Binding HoveredPoint}">
                <TextBlock FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextUnit}" Text="{Binding TooltipDateDisplay}" />
                <TextBlock Margin="0,5,0,0" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource AccentPrimary}" Text="{Binding TooltipDurationDisplay}" />
            </StackPanel>
        </Border>
    </Popup>
    </Grid>
</UserControl>
