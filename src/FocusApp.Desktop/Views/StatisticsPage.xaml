                                    <StackPanel>
                                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding SelectedGoalName}" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedGoal.CreatedDateDisplay}"/>
                                        <TextBlock x:Name="GoalDetailRemark" Margin="0,7,0,0" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{Binding SelectedGoal.Remark}" ToolTip="{Binding SelectedGoal.Remark}" TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis" Visibility="{Binding HasSelectedGoalRemark, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Background="#F0F0F3"/>
                                <Grid x:Name="GoalInvestmentMetrics" Grid.Row="2" Margin="2,12,2,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Text="本周投入" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock x:Name="GoalWeeklyInvestmentText" Margin="0,4,0,0" Style="{StaticResource GoalMetricValueStyle}"><Run Text="{Binding SelectedGoalWeeklyInvestment.HoursValue, Mode=OneWay}"/><Run Text="{Binding SelectedGoalWeeklyInvestment.HoursUnitWithLeadingSpace, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/><Run Text="{Binding SelectedGoalWeeklyInvestment.MinutesValueWithLeadingSpace, Mode=OneWay}"/><Run Text="{Binding SelectedGoalWeeklyInvestment.MinutesUnitWithLeadingSpace, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/></TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#F0F0F3"/>
                                    <StackPanel Grid.Column="2" Margin="26,0,0,0">
                                        <Grid>
                                            <TextBlock VerticalAlignment="Center" Text="累计投入" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}"/>
                                            <Button x:Name="GoalInvestmentTrendButton" HorizontalAlignment="Right" VerticalAlignment="Center" Content="投入趋势  ›" Style="{StaticResource GoalInlineActionStyle}" Command="{Binding GoalInvestmentTrend.OpenCommand}" AutomationProperties.Name="查看投入趋势"/>
                                        </Grid>
                                        <TextBlock x:Name="GoalTotalInvestmentText" Margin="0,4,0,0" Style="{StaticResource GoalMetricValueStyle}"><Run Text="{Binding SelectedGoalTotalInvestment.HoursValue, Mode=OneWay}"/><Run Text="{Binding SelectedGoalTotalInvestment.HoursUnitWithLeadingSpace, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/><Run Text="{Binding SelectedGoalTotalInvestment.MinutesValueWithLeadingSpace, Mode=OneWay}"/><Run Text="{Binding SelectedGoalTotalInvestment.MinutesUnitWithLeadingSpace, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/><Run Text="{Binding SelectedGoalTargetDurationSeparator, Mode=OneWay}" FontSize="16" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}"/><Run Text="{Binding SelectedGoalTargetDuration.HoursValue, Mode=OneWay}" FontSize="16" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}"/><Run Text="{Binding SelectedGoalTargetDuration.HoursUnit, Mode=OneWay}" FontSize="16" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}"/><Run Text="{Binding SelectedGoalTargetDuration.MinutesValueWithLeadingSpace, Mode=OneWay}" FontSize="16" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}"/><Run Text="{Binding SelectedGoalTargetDuration.MinutesUnit, Mode=OneWay}" FontSize="16" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}"/></TextBlock>
                                        <Grid x:Name="GoalInvestmentProgress" Margin="0,6,0,0" Visibility="{Binding HasSelectedGoalTargetDuration, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <ProgressBar x:Name="GoalInvestmentProgressBar" VerticalAlignment="Center" Minimum="0" Maximum="1" Value="{Binding SelectedGoalInvestmentProgressRatio, Mode=OneWay}" Style="{StaticResource GoalInvestmentProgressBarStyle}"/>
                                            <TextBlock x:Name="GoalInvestmentProgressPercentage" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{Binding SelectedGoalInvestmentProgressDisplay}"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="3" Background="#F0F0F3"/>
                                <Grid Grid.Row="4" Margin="0,22,0,22">
                                    <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="下一步任务" FontSize="15" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                                        <Button x:Name="CreateNextTaskButton"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Padding="6,4"
                                                Background="Transparent"
                                                Style="{StaticResource GoalInlineActionStyle}"
                                                Command="{Binding GoalTasks.NewTaskCommand}"
                                                AutomationProperties.Name="创建任务">
                                            <TextBlock Text="+ 创建任务" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource AccentPrimary}" />
                                        </Button>
                                    </Grid>
                                    <ScrollViewer x:Name="GoalNextTasksScroll"
                                                  Grid.Row="1"
                                                  Margin="0,6,0,0"
                                                  AllowDrop="True"
                                                  DragOver="GoalNextTasksScroll_DragOver"
                                                  Drop="GoalNextTasksScroll_Drop"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ScrollViewer.Resources><Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource StatisticsThinScrollBarStyle}"/></ScrollViewer.Resources>
                                        <StackPanel>
                                            <Border x:Name="GoalNewTaskEditorRow"
                                                    Height="40"
                                                    Margin="0,1"
                                                    Background="#F7F7F8"
                                                    CornerRadius="7"
                                                    Visibility="{Binding GoalTasks.IsCreating, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="9"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border Grid.Column="1" Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Center" BorderBrush="#C8CCD5" BorderThickness="1.3" CornerRadius="4" />
                                                    <Grid Grid.Column="2" Margin="12,0,10,0">
                                                        <TextBlock Text="输入任务名称…" FontSize="13" Foreground="{DynamicResource TextWeak}" IsHitTestVisible="False" VerticalAlignment="Center">
                                                            <TextBlock.Style><Style TargetType="{x:Type TextBlock}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding GoalTasks.DraftName}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBox x:Name="GoalNewTaskNameTextBox"
                                                                 Style="{StaticResource GoalNextTaskInlineInputStyle}"
                                                                 Text="{Binding GoalTasks.DraftName, UpdateSourceTrigger=PropertyChanged}"
                                                                 IsVisibleChanged="GoalTaskEditor_IsVisibleChanged"
                                                                 PreviewKeyDown="GoalTaskEditor_PreviewKeyDown"
                                                                 LostKeyboardFocus="GoalTaskEditor_LostKeyboardFocus" />
                                                    </Grid>
                                                    <TextBlock Grid.Column="3" Margin="0,0,10,0" Text="Enter 创建 · Esc 取消" FontSize="10" Foreground="{DynamicResource TextWeak}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <ItemsControl x:Name="GoalNextTasks" ItemsSource="{Binding GoalTasks.PendingTasks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                    <Grid x:Name="GoalNextTaskRow"
                                                          Height="40"
                                                          PreviewMouseLeftButtonDown="GoalNextTaskRow_PreviewMouseLeftButtonDown"
                                                          PreviewMouseLeftButtonUp="GoalNextTaskRow_PreviewMouseLeftButtonUp"
                                                          PreviewMouseMove="GoalNextTaskRow_PreviewMouseMove">
                                                        <Grid.Style>
                                                            <Style TargetType="{x:Type Grid}">
                                                                <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
                                                                <Setter Property="Cursor" Value="Hand" />
                                                                <Setter Property="Opacity" Value="1" />
                                                                <Setter Property="RenderTransform"><Setter.Value><TranslateTransform /></Setter.Value></Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDragging}" Value="True"><Setter Property="Opacity" Value="0.72" /><Setter Property="Panel.ZIndex" Value="8" /><Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="9" Direction="270" Opacity="0.12" ShadowDepth="2" Color="#777777" /></Setter.Value></Setter></DataTrigger>
                                                                    <DataTrigger Binding="{Binding ShowDropBefore}" Value="True"><Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="3" /></Setter.Value></Setter></DataTrigger>
                                                                    <DataTrigger Binding="{Binding ShowDropAfter}" Value="True"><Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="-3" /></Setter.Value></Setter></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Border x:Name="GoalNextTaskHoverSurface" Margin="0,1" CornerRadius="7">
                                                            <Border.Style>
                                                                <Style TargetType="{x:Type Border}">
                                                                    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
                                                                    <Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, ElementName=GoalNextTaskRow}" Value="True"><Setter Property="Background" Value="#F7F7F8" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                        <Border Height="1" Margin="31,0,0,0" VerticalAlignment="Bottom" Background="#F2F2F5" />
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="9"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                                            <Border x:Name="GoalTaskPriorityBar" Grid.Column="0" Width="3" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource AccentPrimary}" CornerRadius="1.5">
                                                                <Border.Style>
                                                                    <Style TargetType="{x:Type Border}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Setter Property="Opacity" Value="1" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ListPriorityRank}" Value="1"><Setter Property="Visibility" Value="Visible" /><Setter Property="Opacity" Value="1" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding ListPriorityRank}" Value="2"><Setter Property="Visibility" Value="Visible" /><Setter Property="Opacity" Value="0.6" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding ListPriorityRank}" Value="3"><Setter Property="Visibility" Value="Visible" /><Setter Property="Opacity" Value="0.3" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                            <Button x:Name="GoalNextTaskCheckButton"
                                                                    Grid.Column="1"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    AutomationProperties.Name="完成任务"
                                                                    Command="{Binding DataContext.GoalTasks.CompleteTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource GoalNextTaskCheckButtonStyle}" />
                                                            <TextBlock Grid.Column="2" Margin="12,0,10,0" Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                            <Button x:Name="GoalNextTaskMoreButton"
                                                                    Grid.Column="3"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center"
                                                                    AutomationProperties.Name="更多任务操作"
                                                                    ToolTip="更多任务操作">
                                                                <Button.Style>
                                                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource GoalNextTaskMoreButtonStyle}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, ElementName=GoalNextTaskRow}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <TextBlock Margin="0,-4,0,0" FontSize="14" Foreground="#989CA6" Text="..." />
                                                            </Button>
                                                        </Grid>
                                                    </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                                <Border Grid.Row="5" Background="#F6F7F9" CornerRadius="10" Padding="16,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="21" Height="21" VerticalAlignment="Center" Background="#7B8595" CornerRadius="11">
                                            <Path Width="10" Height="7" Data="M 0,3.5 L 3.5,7 L 10,0" Stretch="Fill" VerticalAlignment="Center" HorizontalAlignment="Center" Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Margin="10,0,8,0" Text="今日已完成 3 项" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                        <Button Grid.Column="2" Padding="4,5" VerticalAlignment="Center" Background="Transparent" Style="{StaticResource GoalQuietActionStyle}" Command="{Binding GoalTasks.OpenCompletedCommand}" AutomationProperties.Name="查看已完成任务"><TextBlock Text="查看已完成任务  ›"/></Button>
                                    </Grid>
                                </Border>
                                <Border Grid.RowSpan="6" Background="{DynamicResource SurfacePrimary}" Visibility="{Binding HasSelectedGoal, Converter={StaticResource GoalInverseVisibilityConverter}}"><TextBlock Text="暂无目标" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextWeak}"/></Border>
                            </Grid>
                            <Grid x:Name="GoalInvestmentDetailsLockedPlaceholder" Visibility="{Binding CanViewGoalInvestmentDetails, Converter={StaticResource GoalInverseVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="目标投入详情" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                    <Border x:Name="GoalInvestmentDetailsVipHoverTarget" Margin="0,16,0,0" Padding="12,8" Background="{DynamicResource AccentTint}" CornerRadius="8" MouseEnter="GoalInvestmentDetailsVipHoverTarget_MouseEnter" MouseLeave="GoalInvestmentDetailsVipHoverTarget_MouseLeave"><TextBlock Text="VIP 专享 · 查看目标投入详情" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}"/></Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Popup x:Name="GoalInvestmentDetailsVipGuidePopup"
                       Width="300"
                       Height="170"
                       AllowsTransparency="True"
                       IsOpen="{Binding IsGoalInvestmentDetailsVipGuideOpen, Mode=TwoWay}"
                       Placement="Custom"
                       PlacementTarget="{Binding ElementName=GoalInvestmentDetailsVipHoverTarget}"
                       PopupAnimation="Fade"
                       StaysOpen="True">
                    <Border Width="300"
                            Height="170"
                            Padding="18"
                            Background="{DynamicResource SurfacePrimary}"
                            BorderBrush="{DynamicResource BorderPrimary}"
                            BorderThickness="1"
                            CornerRadius="12"
                            MouseEnter="GoalInvestmentDetailsVipGuide_MouseEnter"
                            MouseLeave="GoalInvestmentDetailsVipGuide_MouseLeave">
                        <Border.Effect><DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.12" ShadowDepth="4" /></Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Border Width="54" Height="54" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource AccentTint}" CornerRadius="27">
                                <Viewbox Width="29" Height="25">
                                    <Path Data="M 2,6 L 8,13 L 14,4 L 20,13 L 26,6 L 23,22 L 5,22 Z M 5,18 L 23,18" Fill="{DynamicResource TransparentBrush}" Stroke="{DynamicResource AccentPrimary}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="2" />
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="解锁目标投入详情" />
                                    <Border Margin="9,0,0,0" Padding="8,2" Background="{DynamicResource AccentTint}" BorderBrush="{DynamicResource AccentSoftBorder}" BorderThickness="1" CornerRadius="9">
                                        <TextBlock FontSize="12" FontWeight="Medium" Foreground="{DynamicResource AccentPrimary}" Text="VIP" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="0,12,0,0" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" LineHeight="19" Text="开通 VIP 后可查看当前目标的投入详情。" TextWrapping="Wrap" />
                                <Button Width="120" Height="34" Margin="0,12,0,0" HorizontalAlignment="Left" Padding="0" Background="{DynamicResource AccentPrimary}" BorderThickness="0" Click="GoalInvestmentDetailsVipGuideOpenButton_Click" Cursor="Hand" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource WhiteText}" Content="立即开通">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="GuideButtonBackground" Background="{TemplateBinding Background}" CornerRadius="9">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="GuideButtonBackground" Property="Opacity" Value="0.9" /></Trigger>
                                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="GuideButtonBackground" Property="Opacity" Value="0.78" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Popup>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
    <Popup x:Name="TrendTooltipPopup"
           DataContext="{Binding}"
           AllowsTransparency="True"
           Closed="TrendTooltipPopup_Closed"
           Focusable="False"
           IsHitTestVisible="False"
           IsOpen="{Binding IsTooltipOpen, Mode=OneWay}"
           Opened="TrendTooltipPopup_Opened"
           Placement="Relative"
           PlacementTarget="{Binding ElementName=TrendCard}"
           HorizontalOffset="{Binding TooltipOffsetX}"
           VerticalOffset="{Binding TooltipOffsetY}"
           PopupAnimation="Fade">
        <Border Width="150"
                Padding="12,9"
                Background="{DynamicResource SurfacePrimary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="1"
                CornerRadius="8"
                Focusable="False"
                IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.1" ShadowDepth="2" /></Border.Effect>
            <StackPanel DataContext="{Binding HoveredPoint}">
                <TextBlock FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextUnit}" Text="{Binding TooltipDateDisplay}" />
                <TextBlock Margin="0,5,0,0" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource AccentPrimary}" Text="{Binding TooltipDurationDisplay}" />
            </StackPanel>
        </Border>
    </Popup>
    </Grid>
</UserControl>
