                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" To="160" Duration="0:0:0.2" />
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" To="0" Duration="0:0:0.2" />
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="0,12,-1,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="116" /><RowDefinition Height="24" /></Grid.RowDefinitions>
                                        <ItemsControl Grid.Column="0" Margin="0,0,4,0" ItemsSource="{Binding GoalTrendAxisTicks}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Top" Value="{Binding ChartY}" /></Style></ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:GoalTrendAxisTickViewModel}"><TextBlock Width="28" Margin="0,-8,0,0" TextAlignment="Right" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{Binding Label}" /></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid x:Name="GoalTrendChartArea" Grid.Column="1" ClipToBounds="False">
                                            <ItemsControl Margin="0,0,0,0" IsHitTestVisible="False" ItemsSource="{Binding GoalTrendAxisTicks}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Top" Value="{Binding ChartY}" /><Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}" /></Style></ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:GoalTrendAxisTickViewModel}">
                                                        <Line X1="0" X2="1000" Y1="0" Y2="0" Stroke="{DynamicResource BorderPrimary}" StrokeDashArray="3,4" StrokeThickness="1" Opacity="0.52" Visibility="{Binding ShowGuideLine, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding GoalTrendPoints}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:GoalTrendPointViewModel}">
                                                        <Button Height="{Binding BarHeight}" MinWidth="10" VerticalAlignment="Bottom" Padding="0" Background="{DynamicResource TransparentBrush}" BorderThickness="0" FocusVisualStyle="{x:Null}" Command="{Binding DataContext.SelectGoalTrendPointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Click="GoalTrendBar_Click" MouseEnter="GoalTrendBar_MouseEnter" MouseLeave="GoalTrendBar_MouseLeave">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bar" Width="6" Height="{TemplateBinding Height}" VerticalAlignment="Bottom" CornerRadius="3,3,0,0" Opacity="0.8">
                                                                        <Border.Background>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                <GradientStop Offset="0" Color="#F2FF7A00" />
                                                                                <GradientStop Offset="0.58" Color="#9CFF9A4A" />
                                                                                <GradientStop Offset="1" Color="#20FFB77C" />
                                                                            </LinearGradientBrush>
                                                                        </Border.Background>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Bar" Property="Width" Value="7" /><Setter TargetName="Bar" Property="Opacity" Value="1" /></DataTrigger>
                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Width" Value="7" /><Setter TargetName="Bar" Property="Opacity" Value="1" /></Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                        <ItemsControl Grid.Row="1" Grid.Column="1" Height="24" ClipToBounds="False" ItemsSource="{Binding GoalTrendDateLabels}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Top" Value="4" />
                                                    <Setter Property="Canvas.Left">
                                                        <Setter.Value>
                                                            <MultiBinding Converter="{StaticResource GoalTrendLabelOffsetConverter}" ConverterParameter="34">
                                                                <Binding Path="Position" />
                                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Canvas}" />
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:GoalTrendDateLabelViewModel}"><TextBlock Width="34" TextAlignment="Center" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{Binding Label}" /></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Grid.ColumnSpan="2" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="暂无投入数据">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasSelectedGoalRecords}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="2" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="推进记录" />
                            <Border x:Name="GoalProgressListBorder" Grid.Row="3" ClipToBounds="True" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource OverlayBorder}" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                <ScrollViewer x:Name="GoalProgressScrollViewer" ScrollChanged="GoalProgressScrollViewer_ScrollChanged" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource StatisticsThinScrollBarStyle}" />
                                    </ScrollViewer.Resources>
                                    <ItemsControl x:Name="GoalDateGroupsControl" AlternationCount="100" ItemsSource="{Binding GoalDateGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:GoalDateGroupViewModel}">
                                                <Border BorderBrush="{DynamicResource OverlayBorder}" BorderThickness="0,0,0,1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Background" Value="{DynamicResource RecentTargetSelectedBackground}" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <Button Height="50" Padding="12,0" HorizontalContentAlignment="Stretch" FocusVisualStyle="{x:Null}" Command="{Binding DataContext.ToggleGoalDateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                                                                        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource BackgroundSecondary}" /></Trigger>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Background" Value="{DynamicResource TransparentBrush}" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="DateHeaderBackground" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                             <Grid>
                                                                 <Grid.ColumnDefinitions>
                                                                     <ColumnDefinition Width="*" />
                                                                     <ColumnDefinition Width="78" />
                                                                     <ColumnDefinition Width="14" />
                                                                 </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{Binding DateDisplay}" />
                                                                <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{Binding DurationDisplay}" />
                                                                <Grid Grid.Column="2" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                    <Path Data="M 3,1 L 8,6 L 3,11" Stroke="{DynamicResource TextWeak}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.4">
                                                                        <Path.Style><Style TargetType="Path"><Setter Property="Opacity" Value="0.72" /><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Opacity" Value="1" /></DataTrigger></Style.Triggers></Style></Path.Style>
                                                                    </Path>
                                                                    <Path Data="M 1,3 L 6,8 L 11,3" Stroke="{DynamicResource TextWeak}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.4">
                                                                        <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Path.Style>
                                                                    </Path>
                                                                </Grid>
                                                            </Grid>
                                                        </Button>
                                                        <Grid Margin="16,0,12,8" Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <ItemsControl ItemsSource="{Binding Sessions}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:FocusSessionRecordViewModel}">
                                                                        <Grid Height="52">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="18" />
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="78" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="29" />
                                                                                <RowDefinition Height="23" />
                                                                            </Grid.RowDefinitions>
                                                                            <Ellipse Grid.RowSpan="2" Grid.Column="0" Width="5" Height="5" Margin="1,12,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource TextWeak}" Opacity="0.62" />
                                                                            <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource OverlayBorder}" />
                                                                            <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Bottom" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextUnit}" Text="{Binding TaskName}" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{Binding DurationMinutes, Converter={StaticResource CompactDurationConverter}}" />
                                                                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3,0,0" VerticalAlignment="Top" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{Binding TimeRangeDisplay}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" IsHitTestVisible="False" Text="暂无推进记录">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasSelectedGoalRecords}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                </Grid>
                            </Border>
                            <Border Grid.RowSpan="4" Background="{DynamicResource SurfacePrimary}">
                                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasSelectedGoal}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock HorizontalAlignment="Center" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="暂无目标" /><TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="当前列表没有可显示的目标" /></StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
    <Popup x:Name="TrendTooltipPopup"
           DataContext="{Binding}"
           AllowsTransparency="True"
           IsHitTestVisible="False"
           IsOpen="{Binding IsTooltipOpen, Mode=OneWay}"
           Placement="Relative"
           PlacementTarget="{Binding ElementName=TrendCard}"
           HorizontalOffset="{Binding TooltipOffsetX}"
           VerticalOffset="{Binding TooltipOffsetY}"
           PopupAnimation="Fade">
        <Border Width="150"
                Padding="12,9"
                Background="{DynamicResource SurfacePrimary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="1"
                CornerRadius="8">
            <Border.Effect><DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.1" ShadowDepth="2" /></Border.Effect>
            <StackPanel DataContext="{Binding HoveredPoint}">
                <TextBlock FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextUnit}" Text="{Binding TooltipDateDisplay}" />
                <TextBlock Margin="0,5,0,0" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource AccentPrimary}" Text="{Binding TooltipDurationDisplay}" />
            </StackPanel>
        </Border>
    </Popup>
    <Popup x:Name="GoalTrendTooltipPopup"
           DataContext="{Binding}"
           AllowsTransparency="True"
           IsHitTestVisible="False"
           IsOpen="{Binding IsGoalTrendTooltipOpen, Mode=OneWay}"
           Placement="Relative"
           PlacementTarget="{Binding ElementName=GoalTrendChartArea}"
           HorizontalOffset="{Binding GoalTrendTooltipOffsetX}"
           VerticalOffset="{Binding GoalTrendTooltipOffsetY}"
           PopupAnimation="Fade">
        <Grid Width="176" Height="88" DataContext="{Binding HoveredGoalTrendPoint}">
            <Border Width="168"
                    Height="74"
                    Margin="4,3,4,0"
                    Padding="14,11"
                    VerticalAlignment="Top"
                    Background="{DynamicResource SurfacePrimary}"
                    BorderBrush="{DynamicResource BorderPrimary}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Border.Effect><DropShadowEffect BlurRadius="14" Direction="270" Opacity="0.13" ShadowDepth="3" /></Border.Effect>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding TooltipDateDisplay}" />
                    <TextBlock Margin="0,6,0,0" FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" Text="{Binding TooltipDurationDisplay}" />
                </StackPanel>
            </Border>
            <Path Width="12"
                  Height="7"
                  Margin="0,0,0,4"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  Data="M 0,0 L 12,0 L 6,7 Z"
                  Fill="{DynamicResource SurfacePrimary}"
                  Stroke="{DynamicResource BorderPrimary}"
                  StrokeLineJoin="Round"
                  StrokeThickness="1" />
        </Grid>
    </Popup>
    <Popup x:Name="MonthlyFocusTargetPopup"
           DataContext="{Binding}"
           AllowsTransparency="True"
           StaysOpen="False"
           IsOpen="{Binding IsMonthlyFocusTargetPopupOpen, Mode=TwoWay}"
           Placement="Custom"
           Opened="MonthlyFocusTargetPopup_Opened"
           PopupAnimation="Fade">
        <Border Width="340" Height="310" Padding="29,25" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="18">
            <Border.Effect><DropShadowEffect BlurRadius="22" Direction="270" Opacity="0.12" ShadowDepth="5" /></Border.Effect>
            <Grid>
                <StackPanel>
                    <TextBlock FontSize="18.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding MonthlyFocusTargetPopupTitle}" />
                    <TextBlock Margin="0,25,0,8" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="本月目标时长" />
                    <Border Height="78" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="55" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="MonthlyFocusTargetInputBox"
                                     Grid.Column="0"
                                     Margin="44,0,0,0"
                                     Style="{StaticResource MonthlyTargetInputStyle}"
                                     Text="{Binding MonthlyFocusTargetInput, UpdateSourceTrigger=PropertyChanged}" />
                            <Border Grid.Column="1" Width="1" Height="44" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource BorderPrimary}" />
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="小时" />
                            <Border Grid.Column="2" Width="1" Margin="0,12" HorizontalAlignment="Left" Background="{DynamicResource BorderPrimary}" />
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <Button Grid.Row="0" AutomationProperties.Name="增加目标小时" Command="{Binding IncreaseMonthlyFocusTargetCommand}" Style="{StaticResource MonthlyTargetStepButtonStyle}">
                                    <Path Width="10" Height="6" Data="M 1,5 L 5,1 L 9,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.6" />
                                </Button>
                                <Border Grid.Row="1" Height="1" VerticalAlignment="Top" Background="{DynamicResource BorderPrimary}" />
                                <Button Grid.Row="1" AutomationProperties.Name="减少目标小时" Command="{Binding DecreaseMonthlyFocusTargetCommand}" Style="{StaticResource MonthlyTargetStepButtonStyle}">
                                    <Path Width="10" Height="6" Data="M 1,1 L 5,5 L 9,1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.6" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock Margin="0,12,0,0" FontSize="13" Foreground="{DynamicResource TextSecondary}"><Run Text="当前已完成 " /><Run Foreground="{DynamicResource AccentPrimary}" Text="{Binding MonthlyFocusCompletedDisplay, Mode=OneWay}" /></TextBlock>
                    <Border Height="1" Margin="0,25,0,15" Background="{DynamicResource BorderPrimary}" Opacity="0.75" />
                    <Grid Height="38">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Margin="0,0,14,0" Content="取消" Command="{Binding CancelMonthlyFocusTargetCommand}" Style="{StaticResource MonthlyTargetTextButtonStyle}" />
                        <Button Grid.Column="1" Margin="1,0,0,0" Command="{Binding SaveMonthlyFocusTargetCommand}" Style="{StaticResource MonthlyTargetPrimaryButtonStyle}"><TextBlock Foreground="White" Text="保存" /></Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Popup>
    </Grid>
</UserControl>
