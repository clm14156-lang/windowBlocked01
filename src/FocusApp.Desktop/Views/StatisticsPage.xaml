                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">

                                    <ComboBox Margin="6,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" ItemsSource="{Binding RangeOptions}" SelectedItem="{Binding SelectedRange}" DisplayMemberPath="Label" Style="{StaticResource StatisticsRangeComboBoxStyle}" />
                                </StackPanel>

                            </Grid>
                            <Grid Height="155" Margin="{StaticResource GroupGapAbove}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition /></Grid.ColumnDefinitions>
