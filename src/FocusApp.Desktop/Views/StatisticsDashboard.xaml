<UserControl x:Class="FocusApp.Desktop.Views.StatisticsDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             xmlns:vm="clr-namespace:FocusApp.Desktop.ViewModels"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             FontFamily="{DynamicResource FontFamilyPrimary}" Foreground="{DynamicResource StatisticsBodyBrush}"
             MouseLeftButtonDown="Dashboard_MouseLeftButtonDown" PreviewKeyDown="Dashboard_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/FocusApp.Desktop;component/Resources/PoptipStyles.xaml"/><ResourceDictionary Source="/FocusApp.Desktop;component/Resources/StatisticsScrollStyles.xaml"/><ResourceDictionary Source="/FocusApp.Desktop;component/Resources/StatisticsTypography.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource StatisticsThinScrollBarStyle}"/>
            <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
            <Style x:Key="OverviewCard" TargetType="Border">
                <Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#EAF0F6"/>
                <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#6C85A6" Opacity="0.035" BlurRadius="12" ShadowDepth="3" Direction="270"/></Setter.Value></Setter>
            </Style>
            <Style x:Key="OverviewHeading" TargetType="TextBlock" BasedOn="{StaticResource StatisticsHeadingTextStyle}"/>
            <Style x:Key="OverviewMetricLabel" TargetType="TextBlock" BasedOn="{StaticResource StatisticsMetricLabelStyle}"/>
            <Style x:Key="OverviewNumber" TargetType="Run" BasedOn="{StaticResource StatisticsValueRunStyle}"/>
            <Style x:Key="OverviewUnit" TargetType="Run" BasedOn="{StaticResource StatisticsUnitRunStyle}"/>
            <Style x:Key="OverviewDurationGap" TargetType="Border">
                <Setter Property="Width" Value="4"/>
                <Setter Property="Height" Value="0"/>
            </Style>
            <Style x:Key="OverviewNumericSecondary" TargetType="TextBlock" BasedOn="{StaticResource StatisticsAuxiliaryTextStyle}">
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyEnglish}"/>
                <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            </Style>
            <Style x:Key="OverviewInfo" TargetType="TextBlock">
                <Setter Property="Text" Value="&#xE946;"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#A0ACC0"/><Setter Property="Margin" Value="6,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="OverviewSegment" TargetType="RadioButton">
                <Setter Property="Height" Value="30"/><Setter Property="Width" Value="68"/><Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/><Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Foreground" Value="{DynamicResource StatisticsSecondaryBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                    <Border x:Name="SegmentSurface" Background="Transparent" CornerRadius="9"><TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SegmentSurface" Property="Background" Value="#F0F3F8"/></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter Property="FontWeight" Value="Medium"/><Setter Property="Foreground" Value="White"/><Setter TargetName="SegmentSurface" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFA247" Offset="0"/><GradientStop Color="#FF8B30" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SegmentSurface" Property="BorderBrush" Value="#FFC28F"/><Setter TargetName="SegmentSurface" Property="BorderThickness" Value="1"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="OverviewDateButton" TargetType="Button">
                <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="12,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource StatisticsBodyBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="DateButtonSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="16"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DateButtonSurface" Property="Background" Value="#F0F3F7"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="DateButtonSurface" Property="Background" Value="#F0F3F7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="OverviewPeriodOptionStyle" TargetType="Button">
                <Setter Property="Height" Value="30"/><Setter Property="Padding" Value="8,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="PeriodOptionSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="7"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PeriodOptionSurface" Property="Background" Value="#F5F6F8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PeriodOptionSurface" Property="Background" Value="#F5F6F8"/></Trigger><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="PeriodOptionSurface" Property="Background" Value="#F0F3F7"/></DataTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="DistributionRowButton" TargetType="Button">
                <Setter Property="Height" Value="28"/><Setter Property="Padding" Value="10,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="RowSurface" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="#F1F3F6"/></DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="DashboardRoot" Background="Transparent">
        <ScrollViewer x:Name="OverviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="OverviewScroll_ScrollChanged">
            <Grid x:Name="OverviewLayout" Height="{Binding ActualHeight, ElementName=OverviewScroll}" MinHeight="610">
                <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="12"/><RowDefinition Height="96"/><RowDefinition Height="12"/><RowDefinition Height="226"/><RowDefinition Height="12"/><RowDefinition Height="*" MinHeight="216"/></Grid.RowDefinitions>
                <Grid x:Name="OverviewPeriodToolbar">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="OverviewDateButton" HorizontalAlignment="Left" Style="{StaticResource OverviewDateButton}" Command="{Binding TogglePeriodPickerCommand}" AutomationProperties.Name="选择统计日期" ToolTip="{Binding DateRangeDisplay}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="OverviewDateRange" Text="{Binding DateRangeDisplay}" Style="{StaticResource StatisticsBodyTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Path Grid.Column="1" Width="8" Height="5" Data="M 0,0 L 4,4 L 8,0" Stroke="#354E70" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsPeriodPickerOpen}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Path.Style></Path>
                        </Grid>
                    </Button>
                    <Border x:Name="OverviewPeriodSegments" Grid.Column="2" HorizontalAlignment="Right" Width="208" Height="32" Background="#FFFFFF" BorderBrush="#E7ECF3" BorderThickness="1" CornerRadius="11">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="WeekPeriodButton" Content="周" GroupName="OverviewPeriod" Style="{StaticResource OverviewSegment}" Command="{Binding SelectWeekCommand}" IsChecked="{Binding IsWeek, Mode=TwoWay}" AutomationProperties.Name="按周统计"/>
                            <RadioButton x:Name="MonthPeriodButton" Content="月" GroupName="OverviewPeriod" Style="{StaticResource OverviewSegment}" Command="{Binding SelectMonthCommand}" IsChecked="{Binding IsMonth, Mode=TwoWay}" AutomationProperties.Name="按月统计"/>
                            <RadioButton x:Name="YearPeriodButton" Content="年" GroupName="OverviewPeriod" Style="{StaticResource OverviewSegment}" Command="{Binding SelectYearCommand}" IsChecked="{Binding IsYear, Mode=TwoWay}" AutomationProperties.Name="按年统计"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Grid.Row="2" x:Name="OverviewMetrics">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border x:Name="OverviewDurationCard" Style="{StaticResource OverviewCard}">
                        <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid x:Name="OverviewDurationIcon" Width="30" Height="30" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Grid.Resources><Style TargetType="Ellipse"><Setter Property="Fill" Value="{x:Null}"/><Setter Property="Stroke" Value="#FF8A25"/><Setter Property="StrokeThickness" Value="1.8"/></Style><Style TargetType="Path"><Setter Property="Fill" Value="{x:Null}"/><Setter Property="Stroke" Value="#FF8A25"/><Setter Property="StrokeThickness" Value="1.8"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/></Style></Grid.Resources>
                                <Ellipse Margin="2"/><Path Data="M 15,7 L 15,15 L 22,15"/>
                            </Grid>
                            <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="21"/><RowDefinition/></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="总专注时长" Style="{StaticResource OverviewMetricLabel}"/><TextBlock Style="{StaticResource OverviewInfo}" ToolTip="当前周期内实际专注时长的总和"/></StackPanel>
                            <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                <TextBlock x:Name="OverviewTotalDuration" Style="{StaticResource StatisticsBodyTextStyle}"><Run Text="{Binding TotalHoursValue, Mode=OneWay}" Style="{StaticResource OverviewNumber}"/><InlineUIContainer BaselineAlignment="Baseline"><Border Style="{StaticResource OverviewDurationGap}" Visibility="{Binding HasHours, Converter={StaticResource VisibleWhenTrue}}"/></InlineUIContainer><Run Text="{Binding TotalHoursUnit, Mode=OneWay}" Style="{StaticResource OverviewUnit}"/><InlineUIContainer BaselineAlignment="Baseline"><Border Style="{StaticResource OverviewDurationGap}" Width="8" Visibility="{Binding HasHours, Converter={StaticResource VisibleWhenTrue}}"/></InlineUIContainer><Run Text="{Binding TotalMinutesValue, Mode=OneWay}" Style="{StaticResource OverviewNumber}"/><InlineUIContainer BaselineAlignment="Baseline"><Border Style="{StaticResource OverviewDurationGap}"/></InlineUIContainer><Run Text="分钟" Style="{StaticResource OverviewUnit}"/></TextBlock>
                            </Viewbox>
                        </Grid>
                        </Grid>
                    </Border>
                    <Border x:Name="OverviewCompletedCard" Grid.Column="2" Style="{StaticResource OverviewCard}">
                        <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid x:Name="OverviewCompletedIcon" Width="30" Height="30" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Grid.Resources><Style TargetType="Ellipse"><Setter Property="Fill" Value="{x:Null}"/><Setter Property="Stroke" Value="#2AC78D"/><Setter Property="StrokeThickness" Value="1.8"/></Style><Style TargetType="Path"><Setter Property="Fill" Value="{x:Null}"/><Setter Property="Stroke" Value="#2AC78D"/><Setter Property="StrokeThickness" Value="1.8"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/></Style></Grid.Resources>
                                <Ellipse Margin="2"/><Path Data="M 7,15 L 12,20 L 22,9"/>
                            </Grid>
                            <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="21"/><RowDefinition/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="完成任务" Style="{StaticResource OverviewMetricLabel}"/><TextBlock Style="{StaticResource OverviewInfo}" ToolTip="当前周期内专注记录中完成的任务，按任务去重"/></StackPanel><TextBlock x:Name="OverviewCompletedCount" Grid.Row="1" Style="{StaticResource StatisticsBodyTextStyle}" VerticalAlignment="Bottom"><Run Text="{Binding CompletedTaskCount, Mode=OneWay}" Style="{StaticResource OverviewNumber}"/><Run Text=" 项" Style="{StaticResource OverviewUnit}"/></TextBlock></Grid>
                        </Grid>
                    </Border>
                    <Border x:Name="OverviewDaysCard" Grid.Column="4" Style="{StaticResource OverviewCard}">
                        <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid x:Name="OverviewDaysIcon" Width="30" Height="30" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Grid.Resources><Style TargetType="Ellipse"><Setter Property="Fill" Value="{x:Null}"/><Setter Property="Stroke" Value="#2788FA"/><Setter Property="StrokeThickness" Value="1.8"/></Style><Style TargetType="Path"><Setter Property="Fill" Value="{x:Null}"/><Setter Property="Stroke" Value="#2788FA"/><Setter Property="StrokeThickness" Value="1.8"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/></Style></Grid.Resources>
                                <Path Data="M 4,26 L 4,17 M 11,26 L 11,10 M 18,26 L 18,3 M 25,26 L 25,12"/>
                            </Grid>
                            <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="21"/><RowDefinition/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="专注天数" Style="{StaticResource OverviewMetricLabel}"/><TextBlock Style="{StaticResource OverviewInfo}" ToolTip="当前周期内有实际专注时长的日期数"/></StackPanel><TextBlock x:Name="OverviewFocusDays" Grid.Row="1" Style="{StaticResource StatisticsBodyTextStyle}" VerticalAlignment="Bottom"><Run Text="{Binding FocusDayCount, Mode=OneWay}" Style="{StaticResource OverviewNumber}"/><Run Text=" 天" Style="{StaticResource OverviewUnit}"/></TextBlock></Grid>
                        </Grid>
                    </Border>
                </Grid>
                <Border x:Name="OverviewTrendCard" Grid.Row="4" Style="{StaticResource OverviewCard}" Padding="16,14,16,12">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="{Binding ChartTitle}" Style="{StaticResource OverviewHeading}"/><views:OverviewFocusChart x:Name="FocusChart" Grid.Row="2" Model="{Binding}" AutomationProperties.Name="周期专注时长柱状图"/></Grid>
                </Border>
                <Border x:Name="OverviewDistributionCard" Grid.Row="6" Style="{StaticResource OverviewCard}" Padding="16,14,16,12">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="时间分布" Style="{StaticResource OverviewHeading}"/>
                        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="246"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid x:Name="DistributionRingRegion" Width="216" Height="194" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <views:FocusDistributionChart x:Name="DistributionChart" Model="{Binding}" AutomationProperties.Name="目标时间分布环形图"/>
                                <StackPanel x:Name="DistributionCenter" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Viewbox MaxWidth="96" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
                                        <TextBlock x:Name="DistributionCenterValue" Style="{StaticResource StatisticsBodyTextStyle}"><Run Text="{Binding DonutValue, Mode=OneWay}" Style="{StaticResource OverviewNumber}"/><Run Text="{Binding DonutUnit, Mode=OneWay}" Style="{StaticResource OverviewUnit}"/></TextBlock>
                                    </Viewbox>
                                    <TextBlock Text="{Binding DonutRemainder}" Visibility="{Binding HasDonutRemainder, Converter={StaticResource VisibleWhenTrue}}" Style="{StaticResource OverviewNumericSecondary}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Column="1" Margin="5,0,0,0">
                                <ScrollViewer x:Name="DistributionScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasDistribution, Converter={StaticResource VisibleWhenTrue}}" ScrollChanged="OverviewScroll_ScrollChanged">
                                    <ItemsControl x:Name="DistributionList" ItemsSource="{Binding Distribution}">
                                        <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:FocusDistributionItemViewModel}">
                                            <Button Style="{StaticResource DistributionRowButton}" Command="{Binding DataContext.ToggleDistributionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                    MouseEnter="DistributionRow_MouseEnter" MouseLeave="DistributionRow_MouseLeave" Click="DistributionRow_Click" GotKeyboardFocus="DistributionRow_GotKeyboardFocus" LostKeyboardFocus="DistributionRow_LostKeyboardFocus" AutomationProperties.Name="{Binding TargetName}">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="104"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                                                    <Ellipse Width="13" Height="13" Fill="{Binding Color}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding TargetName}" Style="{StaticResource StatisticsBodyTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0,8,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding DurationDisplay}" Style="{StaticResource OverviewNumericSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding PercentageDisplay}" Style="{StaticResource OverviewNumericSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <StackPanel x:Name="DistributionEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasDistribution}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <TextBlock Text="本周期暂无专注记录" Style="{StaticResource StatisticsMetricLabelStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="开始专注，记录每一次投入" Style="{StaticResource StatisticsAuxiliaryTextStyle}" Margin="0,7,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
        <Popup x:Name="OverviewPeriodPopup" IsOpen="{Binding IsPeriodPickerOpen, Mode=TwoWay}" Placement="Bottom" PlacementTarget="{Binding ElementName=OverviewDateButton}" HorizontalOffset="-4" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
            <views:PoptipChrome x:Name="OverviewPeriodPopupSurface" MinWidth="128" MaxWidth="200" Style="{StaticResource PoptipSurfaceStyle}" PointerOnTop="True" PointerLeft="30" PreviewKeyDown="Dashboard_PreviewKeyDown">
                <StackPanel>
                    <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <ItemsControl x:Name="OverviewPeriodOptions" ItemsSource="{Binding AvailablePeriods}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Button Style="{StaticResource OverviewPeriodOptionStyle}" Command="{Binding DataContext.SelectAvailablePeriodCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource StatisticsBodyTextStyle}" VerticalAlignment="Center"/>
                                    <Path Grid.Column="1" Width="10" Height="8" Data="M 0,4 L 3.5,7.5 L 10,0" Stroke="#354B69" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding IsSelected, Converter={StaticResource VisibleWhenTrue}}"/>
                                </Grid>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="暂无可选时间" Margin="10,9" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource StatisticsAuxiliaryTextStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasAvailablePeriods}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </StackPanel>
            </views:PoptipChrome>
        </Popup>
        <Popup x:Name="OverviewTip" AllowsTransparency="True" Focusable="False" IsHitTestVisible="False" Placement="Relative" PlacementTarget="{Binding ElementName=DashboardRoot}" PopupAnimation="Fade" Opened="OverviewTip_Opened" Closed="OverviewTip_Closed">
            <views:PoptipChrome x:Name="OverviewTipSurface" Style="{StaticResource ChartPoptipSurfaceStyle}" IsHitTestVisible="False">
                <StackPanel>
                    <TextBlock x:Name="TipTitle" Style="{StaticResource ChartPoptipSecondaryTextStyle}"/>
                    <TextBlock x:Name="TipDateRange" Margin="0,4,0,0" Style="{StaticResource ChartPoptipSecondaryTextStyle}" Visibility="Collapsed"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="10"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Ellipse x:Name="TipMarker" Width="10" Height="10" Fill="#FF8B28" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="专注时长" Style="{StaticResource ChartPoptipBodyTextStyle}"/>
                        <TextBlock x:Name="TipDurationText" Grid.Column="4" Style="{StaticResource ChartPoptipBodyTextStyle}" LineHeight="22"><Run x:Name="TipDuration" Style="{StaticResource ChartPoptipValueStyle}"/></TextBlock>
                    </Grid>
                    <TextBlock x:Name="TipPercentage" Margin="0,8,0,0" Style="{StaticResource ChartPoptipPercentageTextStyle}"/>
                </StackPanel>
            </views:PoptipChrome>
        </Popup>
    </Grid>
</UserControl>
