<UserControl x:Class="FocusApp.Desktop.Views.OverviewCompletedTasksModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True" Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
             FontFamily="{DynamicResource FontFamilyPrimary}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource StatisticsBodyBrush}"
             PreviewKeyDown="Modal_PreviewKeyDown" IsVisibleChanged="Modal_IsVisibleChanged">
    <UserControl.Style><Style TargetType="UserControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCompletedTasksOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></UserControl.Style>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles.xaml"/>
                <ResourceDictionary Source="../Resources/StatisticsTypography.xaml"/>
                <ResourceDictionary Source="../Resources/StatisticsScrollStyles.xaml"/>
                <ResourceDictionary Source="../Resources/CompletedTaskSelectStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleIf"/>
            <SolidColorBrush x:Key="CompletedAccent" Color="#F27B22"/>
            <SolidColorBrush x:Key="CompletedSecondaryBrush" Color="#8A919F"/>
            <Style x:Key="TableHeading" TargetType="TextBlock" BasedOn="{StaticResource StatisticsAuxiliaryTextStyle}">
                <Setter Property="Foreground" Value="{StaticResource CompletedSecondaryBrush}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="CompletedListSecondaryText" TargetType="TextBlock" BasedOn="{StaticResource StatisticsAuxiliaryTextStyle}">
                <Setter Property="Foreground" Value="{StaticResource CompletedSecondaryBrush}"/><Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="CompletedListFilter" TargetType="ComboBox" BasedOn="{StaticResource CompletedRangeSelector}">
                <Setter Property="BorderBrush" Value="#E5E8ED"/>
            </Style>
            <DataTemplate x:Key="SortOptionLabel"><TextBlock Text="{Binding Label}" Style="{StaticResource StatisticsBodyTextStyle}"/></DataTemplate>
            <DataTemplate x:Key="PageNumberLabel">
                <TextBlock Text="{Binding}" FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Button}}"
                           FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                           FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </DataTemplate>
            <Style x:Key="SortOptionStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource CompletedRangeOption}"><Setter Property="ContentTemplate" Value="{StaticResource SortOptionLabel}"/></Style>
            <Style x:Key="PageButton" TargetType="Button">
                <Setter Property="MinWidth" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Margin" Value="2,0"/>
                <Setter Property="Padding" Value="5,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource StatisticsBodyBrush}"/><Setter Property="FontFamily" Value="{DynamicResource FontFamilyEnglish}"/>
                <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="PageSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PageSurface" Property="Background" Value="#F6F7F9"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PageSurface" Property="BorderBrush" Value="#D9DFE7"/><Setter TargetName="PageSurface" Property="BorderThickness" Value="1"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter TargetName="PageSurface" Property="Background" Value="#FFF0E3"/><Setter Property="Foreground" Value="{StaticResource CompletedAccent}"/><Setter Property="FontWeight" Value="Medium"/></DataTrigger>
                        <DataTrigger Binding="{Binding IsPage}" Value="False"><Setter TargetName="PageSurface" Property="Background" Value="Transparent"/><Setter TargetName="PageSurface" Property="BorderThickness" Value="0"/><Setter Property="Opacity" Value="1"/></DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="PageArrowButton" TargetType="Button" BasedOn="{StaticResource PageButton}">
                <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#EEF0F4"/><Setter Property="BorderThickness" Value="1"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="Overlay" Background="{DynamicResource ModalScrim}" MouseLeftButtonDown="Overlay_MouseLeftButtonDown">
        <Border x:Name="ModalSurface" Width="580" Height="500" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="White" BorderBrush="#E8EBF0" BorderThickness="1" CornerRadius="14">
            <Border.Effect><DropShadowEffect Color="#424954" BlurRadius="22" ShadowDepth="3" Opacity="0.07"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="56"/><RowDefinition Height="28"/><RowDefinition/><RowDefinition Height="44"/></Grid.RowDefinitions>
                <StackPanel>
                    <Grid Height="26">
                        <TextBlock x:Name="ModalTitle" Text="已完成任务" Style="{StaticResource StatisticsPageTitleTextStyle}" VerticalAlignment="Center"/>
                        <Button x:Name="CloseButton" Width="26" Height="26" Margin="0" Style="{StaticResource ModalCloseButtonStyle}" Command="{Binding CloseCompletedTasksCommand}" AutomationProperties.Name="关闭已完成任务"/>
                    </Grid>
                    <TextBlock x:Name="PeriodLabel" Text="{Binding DateRangeDisplay}" Height="18" Margin="0,4,0,0" FontFamily="{DynamicResource FontFamilyEnglish}"
                               FontSize="13" FontWeight="Normal" Foreground="{StaticResource CompletedSecondaryBrush}"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,14,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="112"/><ColumnDefinition Width="8"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="TaskListTitle" Text="{Binding CompletedTasksListTitle}" Style="{StaticResource StatisticsHeadingTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <ComboBox x:Name="GoalFilter" Grid.Column="2" Style="{StaticResource CompletedListFilter}" ItemsSource="{Binding CompletedGoalOptions}" SelectedItem="{Binding SelectedCompletedGoal, Mode=TwoWay}"
                              MaxDropDownHeight="220" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ToolTip="{Binding SelectedCompletedGoal.Label}" AutomationProperties.Name="按所属目标筛选"/>
                    <ComboBox x:Name="CompletionSort" Grid.Column="4" Style="{StaticResource CompletedListFilter}" ItemContainerStyle="{StaticResource SortOptionStyle}" ItemsSource="{Binding CompletedSortOptions}" SelectedItem="{Binding SelectedCompletedSort, Mode=TwoWay}"
                              MaxDropDownHeight="100" ToolTip="{Binding SelectedCompletedSort.Label}" AutomationProperties.Name="按完成时间排序"/>
                </Grid>
                <Border x:Name="TableHeader" Grid.Row="2" Background="#F7F8FA" CornerRadius="7" Padding="12,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="160"/><ColumnDefinition Width="16"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="2" Text="任务名称" Style="{StaticResource TableHeading}"/>
                        <TextBlock Grid.Column="4" Text="所属目标" Style="{StaticResource TableHeading}"/>
                        <TextBlock Grid.Column="6" Text="完成时间" Style="{StaticResource TableHeading}"/>
                    </Grid>
                </Border>
                <Border x:Name="TableBody" Grid.Row="3" ClipToBounds="True">
                    <Grid>
                        <ScrollViewer x:Name="TasksScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource StatisticsThinScrollBarStyle}"/></ScrollViewer.Resources>
                            <ItemsControl x:Name="TaskList" ItemsSource="{Binding CompletedTasksPageItems}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Height="28" BorderBrush="#F1F3F6" BorderThickness="0,0,0,1" Padding="12,0">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="160"/><ColumnDefinition Width="16"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                                            <Border Width="16" Height="16" CornerRadius="8" Background="#FFE1C7" VerticalAlignment="Center">
                                                <Path Width="9" Height="7" Data="M 0,3 L 3,6 L 8,0" Stretch="Uniform" Stroke="{StaticResource CompletedAccent}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock x:Name="TaskName" Grid.Column="2" Text="{Binding Name}" Style="{StaticResource StatisticsBodyTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                            <TextBlock x:Name="GoalName" Grid.Column="4" Text="{Binding GoalName}" Style="{StaticResource CompletedListSecondaryText}" ToolTip="{Binding GoalName}"/>
                                            <TextBlock x:Name="CompletionDate" Grid.Column="6" Text="{Binding DateDisplay}" Style="{StaticResource CompletedListSecondaryText}" FontFamily="{DynamicResource FontFamilyEnglish}" Typography.NumeralAlignment="Tabular"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="EmptyState" Text="该时间范围内暂无已完成任务" FontSize="13" Foreground="{DynamicResource StatisticsWeakBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasCompletedTaskResults}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <Grid x:Name="Footer" Grid.Row="4" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="TotalLabel" Text="{Binding CompletedTasksTotalDisplay}" Style="{StaticResource CompletedListSecondaryText}"/>
                    <StackPanel x:Name="Pagination" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasCompletedTaskResults, Converter={StaticResource VisibleIf}}">
                        <Button x:Name="PreviousPage" Style="{StaticResource PageArrowButton}" Command="{Binding PreviousCompletedTasksPageCommand}" AutomationProperties.Name="上一页"><Path Width="5" Height="9" Data="M4,0 L0,4 L4,8" Stroke="{StaticResource CompletedSecondaryBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
                        <ItemsControl x:Name="PageNumbers" ItemsSource="{Binding CompletedTasksPageOptions}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" ContentTemplate="{StaticResource PageNumberLabel}" Style="{StaticResource PageButton}" Command="{Binding DataContext.GoToCompletedTasksPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" IsEnabled="{Binding IsPage}" AutomationProperties.Name="{Binding Label}"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="NextPage" Style="{StaticResource PageArrowButton}" Command="{Binding NextCompletedTasksPageCommand}" AutomationProperties.Name="下一页"><Path Width="5" Height="9" Data="M0,0 L4,4 L0,8" Stroke="{StaticResource CompletedSecondaryBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
