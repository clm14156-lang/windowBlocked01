<UserControl x:Class="FocusApp.Desktop.Views.FoldedHorizontal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             views:FocusThemeScope.ResourcePrefix="FocusFloatingTheme"
             views:FocusThemeScope.IsDark="{Binding Session.IsDarkFocusTheme}"
             MinWidth="160" MaxWidth="320" Height="50"
             Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/FocusFloatingTheme.Light.xaml" /></ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="TaskVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border x:Name="CapsuleSurface" Background="{DynamicResource FoldedBackgroundBrush}" BorderBrush="{DynamicResource FoldedBorderBrush}" BorderThickness="1" CornerRadius="25" Padding="14,0">
        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Session.IsDarkFocusTheme}" Value="True"><Setter Property="Effect" Value="{DynamicResource FloatingShadow}"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="88"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <views:CircularProgressRing x:Name="FoldedProgressRing" Width="30" Height="30" VerticalAlignment="Center" RingThickness="3.5"
                                        TrackBrush="{DynamicResource FoldedRingTrackBrush}" ProgressBrush="{DynamicResource AccentPrimary}"
                                        Progress="{Binding RemainingProgress, Mode=OneWay}"/>
            <TextBlock x:Name="FoldedCountdown" Grid.Column="2" Text="{Binding RemainingTimeDisplay}" FontFamily="{DynamicResource FontFamilyNumeric}"
                       FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource FoldedCountdownBrush}" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap"/>
            <Border x:Name="TaskDivider" Grid.Column="3" Width="1" Height="22" Margin="12,0" VerticalAlignment="Center" Background="{DynamicResource FoldedDividerBrush}"
                    Visibility="{Binding HasCurrentTask, Converter={StaticResource TaskVisibilityConverter}}"/>
            <TextBlock x:Name="FoldedTaskName" Grid.Column="4" Text="{Binding CurrentTaskName}" FontFamily="{DynamicResource FontFamilyPrimary}"
                       FontSize="14" Foreground="{DynamicResource FoldedTaskBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasCurrentTask, Converter={StaticResource TaskVisibilityConverter}}"/>
        </Grid>
    </Border>
</UserControl>
