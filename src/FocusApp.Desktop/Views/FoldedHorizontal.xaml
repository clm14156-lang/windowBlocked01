<UserControl x:Class="FocusApp.Desktop.Views.FoldedHorizontal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="235"
             Height="40"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Border Margin="2"
            Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource BorderPrimary}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid Margin="10,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Margin="4,0,20,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="{DynamicResource FontFamilyNumeric}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Text="{Binding RemainingTimeDisplay}" />
            <ProgressBar Grid.Column="1"
                         Height="6"
                         Margin="0,0,4,0"
                         VerticalAlignment="Center"
                         Maximum="1"
                         Minimum="0"
                         Value="{Binding RemainingProgress, Mode=OneWay}"
                         Foreground="{DynamicResource AccentPrimary}"
                         Background="{DynamicResource BackgroundSecondary}" />
        </Grid>
    </Border>
</UserControl>
