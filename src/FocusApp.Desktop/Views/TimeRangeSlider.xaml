<UserControl x:Class="FocusApp.Desktop.Views.TimeRangeSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             Height="45"
             FontFamily="{DynamicResource FontFamilyPrimary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="RangeSliderThumbStyle" TargetType="{x:Type primitives:Thumb}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                        <Ellipse x:Name="ThumbCircle"
                                 Fill="{DynamicResource SurfacePrimary}"
                                 Stroke="{DynamicResource AccentPrimary}"
                                 StrokeThickness="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbCircle" Property="Fill" Value="{DynamicResource AccentTint}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbCircle" Property="Fill" Value="{DynamicResource AccentPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid SizeChanged="RangeSlider_SizeChanged">
        <Canvas x:Name="TrackCanvas" Height="24" VerticalAlignment="Top">
            <Border x:Name="BaseTrack"
                    Height="3"
                    Canvas.Top="10"
                    Background="{DynamicResource BorderPrimary}"
                    CornerRadius="2" />
            <Border x:Name="SelectedTrack"
                    Height="3"
                    Canvas.Top="10"
                    Background="{DynamicResource AccentPrimary}"
                    CornerRadius="2" />
            <primitives:Thumb x:Name="StartThumb"
                              Width="18"
                              Height="18"
                              Canvas.Top="2"
                              AutomationProperties.Name="{DynamicResource AutomaticRuleStartSlider}"
                              DragDelta="StartThumb_DragDelta"
                              Style="{StaticResource RangeSliderThumbStyle}" />
            <primitives:Thumb x:Name="EndThumb"
                              Width="18"
                              Height="18"
                              Canvas.Top="2"
                              AutomationProperties.Name="{DynamicResource AutomaticRuleEndSlider}"
                              DragDelta="EndThumb_DragDelta"
                              Style="{StaticResource RangeSliderThumbStyle}" />
        </Canvas>
        <Grid Margin="0,26,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" HorizontalAlignment="Left" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="00:00" />
            <TextBlock Grid.Column="1" HorizontalAlignment="Center" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="06:00" />
            <TextBlock Grid.Column="2" HorizontalAlignment="Center" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="12:00" />
            <TextBlock Grid.Column="3" HorizontalAlignment="Center" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="18:00" />
            <TextBlock Grid.Column="4" HorizontalAlignment="Right" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="24:00" />
        </Grid>
    </Grid>
</UserControl>
