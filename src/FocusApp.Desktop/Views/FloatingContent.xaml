<UserControl x:Class="FocusApp.Desktop.Views.FloatingContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             views:FocusThemeScope.ResourcePrefix="FocusFloatingTheme"
             views:FocusThemeScope.IsDark="{Binding Session.IsDarkFocusTheme}"
             Width="300" Height="{Binding WindowHeight}"
             Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True"
             Focusable="True" FocusVisualStyle="{x:Null}" PreviewKeyDown="Content_PreviewKeyDown"
             PreviewMouseMove="Content_TaskDragMouseMove" PreviewMouseLeftButtonUp="Content_TaskDragMouseUp" LostMouseCapture="Content_TaskDragLostCapture"
             PreviewMouseWheel="Content_TaskDragMouseWheel"
             Loaded="Content_Loaded" Unloaded="Content_Unloaded" DataContextChanged="Content_DataContextChanged" IsVisibleChanged="Content_IsVisibleChanged">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="FocusTaskResources.xaml" /><ResourceDictionary Source="../Resources/FocusFloatingTheme.Light.xaml" /></ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="TaskVisibility"/>
        <views:CompactSubTaskProgressConverter x:Key="CompactSubTaskProgress"/>
        <views:CustomTimeSelectionConverter x:Key="SameTask"/>
        <Style x:Key="DarkChildDecoration" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                <Condition Binding="{Binding DataContext.Session.IsDarkFocusTheme, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True"/>
                <Condition Binding="{Binding HasSubTasks}" Value="True"/>
            </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="FloatingPlainButton" TargetType="Button">
            <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonRoot" Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonRoot" Property="Background" Value="{DynamicResource FloatingButtonHoverBrush}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonRoot" Property="Background" Value="{DynamicResource FloatingButtonPressedBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FloatingTaskCheckBox" TargetType="CheckBox" BasedOn="{StaticResource FocusTaskCheckBoxStyle}">
            <Style.Resources>
                <CornerRadius x:Key="TaskCheckCornerRadius">4</CornerRadius>
                <system:Double x:Key="TaskCheckTickWidth">10</system:Double>
            </Style.Resources>
            <Setter Property="Width" Value="20"/><Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FloatingCheckBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Background" Value="{DynamicResource FloatingCheckBackgroundBrush}" />
        </Style>
        <Style x:Key="FloatingTaskScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/><Setter Property="MinWidth" Value="0"/><Setter Property="MaxWidth" Value="6"/><Setter Property="Background" Value="{DynamicResource FloatingScrollTrackBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Border Background="{TemplateBinding Background}" CornerRadius="3">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                        <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb MinHeight="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbSurface" Background="{DynamicResource FloatingScrollThumbBrush}" CornerRadius="3"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource FloatingScrollHoverBrush}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource FloatingScrollDraggingBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                    </Track>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FloatingSubTaskTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource FloatingTaskTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True">
                <Setter Property="TextDecorations" Value="Strikethrough"/><Setter Property="Foreground" Value="{DynamicResource FloatingCompletedTaskBrush}"/>
            </DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="FloatingTaskRowHover" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FloatingTaskRowHoverBrush}"/>
            <Setter Property="CornerRadius" Value="6"/><Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
            </DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="FloatingTaskDragHighlight" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FloatingTaskRowDragBrush}"/>
            <Setter Property="CornerRadius" Value="6"/><Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Style.Triggers><DataTrigger Binding="{Binding Path=(views:FloatingContent.IsTaskDragging), RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
            </DataTrigger></Style.Triggers>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border x:Name="FloatingSurface" Background="{DynamicResource FoldedBackgroundBrush}" BorderBrush="{DynamicResource FloatingBorderBrush}" BorderThickness="1" CornerRadius="22">
        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Session.IsDarkFocusTheme}" Value="True"><Setter Property="Effect" Value="{DynamicResource FloatingShadow}"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <Grid Margin="19,15,19,17">
            <Grid.RowDefinitions><RowDefinition Height="81"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid x:Name="TimerArea">
                <Grid.RowDefinitions><RowDefinition Height="23"/><RowDefinition Height="47"/><RowDefinition Height="11"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentPrimary}" Margin="0,0,10,0"/>
                    <TextBlock Text="{DynamicResource FocusFloatingStatus}" FontSize="14" Foreground="{DynamicResource FloatingStatusBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="ExpandButton" HorizontalAlignment="Right" Margin="0,-1,-2,0" Style="{StaticResource FloatingPlainButton}" Click="ExpandButton_Click"
                        AutomationProperties.Name="{DynamicResource FocusFloatingExpandButton}" ToolTip="{DynamicResource FocusFloatingExpandButton}">
                    <Path Width="14" Height="14" Stretch="Uniform" Data="M 8,1 L 13,1 L 13,6 M 13,1 L 1,13 M 1,8 L 1,13 L 6,13" Stroke="{DynamicResource FloatingIconBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Button>
                <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="CountdownText" Text="{Binding RemainingTimeDisplay}" FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="38" FontWeight="Bold" Foreground="{DynamicResource FloatingCountdownBrush}"/>
                        <TextBlock x:Name="TotalTimeText" FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="19" Foreground="{DynamicResource FloatingSecondaryBrush}" Margin="10,0,0,6" VerticalAlignment="Bottom"><Run Text="/ "/><Run Text="{Binding TotalTimeDisplay, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                </Viewbox>
                <ProgressBar x:Name="FocusProgressBar" Grid.Row="2" Height="7" VerticalAlignment="Bottom" Minimum="0" Maximum="1" Value="{Binding RemainingProgress, Mode=OneWay}" Foreground="{DynamicResource AccentPrimary}" Background="{DynamicResource FloatingProgressTrackBrush}">
                    <ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track"><Border Background="{TemplateBinding Background}" CornerRadius="3.5"/><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3.5"/></Grid></ControlTemplate></ProgressBar.Template>
                </ProgressBar>
            </Grid>
            <Border x:Name="TaskDisplayBorder" Grid.Row="1" Background="Transparent" Height="{Binding TaskAreaHeight}" ClipToBounds="True" Visibility="{Binding HasDisplayedTasks, Converter={StaticResource TaskVisibility}}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="16"/><RowDefinition Height="1"/><RowDefinition Height="10"/><RowDefinition Height="18"/><RowDefinition Height="1"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="1" Background="{DynamicResource FloatingDividerBrush}"/>
                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <TextBlock Text="当前任务" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FloatingTaskHeaderBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Grid.Row="5">
                    <ScrollViewer x:Name="TaskScrollViewer" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Disabled"/><Style.Triggers><DataTrigger Binding="{Binding HasTaskOverflow}" Value="True"><Setter Property="VerticalScrollBarVisibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
                        <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource FloatingTaskScrollBar}"/></ScrollViewer.Resources>
                        <ItemsControl x:Name="PendingTaskList" ItemsSource="{Binding VisibleTasks}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Grid x:Name="FloatingTaskRow" ClipToBounds="True" MouseEnter="TaskRow_CreationMouseEnter" MouseLeave="TaskRow_CreationMouseLeave">
                                <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid x:Name="FloatingTaskHeader" Height="28" Background="Transparent" PreviewMouseLeftButtonDown="TaskRow_MouseDown"
                                      AutomationProperties.HelpText="按住任务行拖动可调整排序；悬停后按 Tab 添加子任务">
                                <Border x:Name="TaskHoverSurface" Style="{StaticResource FloatingTaskRowHover}"/>
                                <Border x:Name="TaskDragSurface" Style="{StaticResource FloatingTaskDragHighlight}"/>
                                <Grid Margin="0,0,7,0"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ParentTaskCheck" Style="{StaticResource FloatingTaskCheckBox}" IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleTaskCompletedCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}"
                                              AutomationProperties.Name="{Binding Name}" ToolTip="{DynamicResource FocusFloatingCompleteTask}"/>
                                    <TextBlock x:Name="ParentTaskTitle" Grid.Column="2" Text="{Binding Name}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource FloatingTaskTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DataContext.Session.IsDarkFocusTheme, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True"/>
                                            <Condition Binding="{Binding HasSubTasks}" Value="True"/>
                                        </MultiDataTrigger.Conditions><Setter Property="Padding" Value="0,0,46,0"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <Border x:Name="SubTaskProgressCapsule" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Height="20" MinWidth="36" Padding="6,0" CornerRadius="10"
                                            Style="{StaticResource DarkChildDecoration}" Background="{DynamicResource FloatingProgressCapsuleBrush}" BorderBrush="{DynamicResource FloatingProgressCapsuleBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding SubTaskProgress, Converter={StaticResource CompactSubTaskProgress}}" FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="12" Foreground="{DynamicResource FloatingIconBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                </Grid>
                                <ItemsControl x:Name="SubTaskList" Grid.Row="1" Margin="32,0,7,0" ItemsSource="{Binding SubTasks}">
                                    <ItemsControl.Template><ControlTemplate TargetType="ItemsControl"><Grid>
                                        <Path x:Name="SubTaskConnectorStem" Style="{StaticResource DarkChildDecoration}" HorizontalAlignment="Left" Width="1" Margin="-23,0,0,14" Data="M 0,0 L 0,1" Stretch="Fill"
                                              Stroke="{DynamicResource FloatingConnectorBrush}" StrokeThickness="1" StrokeDashArray="3,2"/>
                                        <ItemsPresenter/>
                                    </Grid></ControlTemplate></ItemsControl.Template>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Grid x:Name="FloatingChildRow" Height="28" Background="Transparent" Loaded="ChildRow_Loaded" Unloaded="ChildRow_Unloaded" DataContextChanged="ChildRow_DataContextChanged"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Border x:Name="ChildHoverSurface" Grid.ColumnSpan="3" Style="{StaticResource FloatingTaskRowHover}"/>
                                            <Path x:Name="SubTaskConnectorBranch" Grid.ColumnSpan="3" Width="12" Height="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-23,0,0,0" Data="M 0,0 L 12,0"
                                                  Stroke="{DynamicResource FloatingConnectorBrush}" StrokeThickness="1" StrokeDashArray="3,2" IsHitTestVisible="False"
                                                  Visibility="{Binding DataContext.Session.IsDarkFocusTheme, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource TaskVisibility}}"/>
                                            <CheckBox x:Name="SubTaskCheck" Style="{StaticResource CircleCheck}" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsCompleted, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Title}"/>
                                            <TextBlock x:Name="SubTaskTitle" Grid.Column="2" Text="{Binding Title}" Style="{StaticResource FloatingSubTaskTitle}" ToolTip="{Binding Title}"/>
                                        </Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border x:Name="InlineSubTaskCreation" Grid.Row="2" Margin="32,4,7,0" Height="32" CornerRadius="7" BorderThickness="1"
                                        Background="{DynamicResource FloatingInputBackgroundBrush}">
                                    <Border.Style><Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource FloatingInputBorderBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource SameTask}">
                                                <Binding/><Binding Path="DataContext.SubTaskCreationParent" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            </MultiBinding></DataTrigger.Binding><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FloatingInputFocusBrush}"/></Trigger>
                                        </Style.Triggers>
                                    </Style></Border.Style>
                                    <Grid Margin="9,0">
                                        <TextBox x:Name="InlineSubTaskTitleInput" Text="{Binding DataContext.TaskTitle, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding DataContext.IsCreatingSubTask, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 FontFamily="{DynamicResource FontFamilyPrimary}" FontSize="13" FontWeight="Normal"
                                                 Foreground="{DynamicResource FloatingTaskTextBrush}" CaretBrush="{DynamicResource AccentPrimary}" Background="Transparent" BorderThickness="0"
                                                 VerticalContentAlignment="Center" Padding="0" AcceptsReturn="False" AcceptsTab="False" InputMethod.IsInputMethodEnabled="True" AutomationProperties.Name="子任务名称">
                                            <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"/></ControlTemplate></TextBox.Template>
                                        </TextBox>
                                        <TextBlock Text="输入子任务名称…" FontFamily="{DynamicResource FontFamilyPrimary}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource FloatingSecondaryBrush}" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.TaskTitle, RelativeSource={RelativeSource AncestorType=UserControl}}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                </Grid>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Canvas IsHitTestVisible="False" ClipToBounds="True"><Border x:Name="FloatingTaskInsertionLine" Height="1" Background="{StaticResource FocusTaskCheckAccentBrush}" Visibility="Collapsed"/></Canvas>
                    </Grid>
                </Grid>
            </Border>
            <Grid x:Name="TaskCreationArea" Grid.Row="2" Height="{Binding CreationHeight}" ClipToBounds="True">
                <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding CreationHeight}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Border x:Name="TaskCreationSurface" Height="32" Margin="0,12,0,0" VerticalAlignment="Top" Background="{DynamicResource FloatingInputBackgroundBrush}" BorderThickness="1" CornerRadius="7">
                    <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource FloatingInputBorderBrush}"/><Style.Triggers>
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=TaskTitleInput}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FloatingInputFocusBrush}"/></DataTrigger>
                    </Style.Triggers></Style></Border.Style>
                    <Grid Margin="9,0">
                        <TextBox x:Name="TaskTitleInput" Text="{Binding TaskTitle, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsCreatingRootTask}" FontFamily="{DynamicResource FontFamilyPrimary}" FontSize="13" FontWeight="Normal"
                                 Foreground="{DynamicResource FloatingTaskTextBrush}" CaretBrush="{DynamicResource AccentPrimary}" Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center" Padding="0" AcceptsReturn="False" AcceptsTab="False" AutomationProperties.Name="任务名称"
                                 InputMethod.IsInputMethodEnabled="True">
                            <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"/></ControlTemplate></TextBox.Template>
                        </TextBox>
                        <TextBlock Text="输入任务名称…" FontFamily="{DynamicResource FontFamilyPrimary}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource FloatingSecondaryBrush}" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TaskTitle}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
