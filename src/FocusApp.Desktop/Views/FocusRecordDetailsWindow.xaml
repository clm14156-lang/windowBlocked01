<Window x:Class="FocusApp.Desktop.Views.FocusRecordDetailsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="340" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" WindowStartupLocation="Manual"
 FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI" FontSize="13" Foreground="#1D1D1F" PreviewKeyDown="Window_KeyDown">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/></Style>
 </Window.Resources>
 <Border Margin="6" Padding="18" Background="White" BorderBrush="#E5E5EA" BorderThickness="1" CornerRadius="14">
  <StackPanel>
   <Grid>
    <WrapPanel Margin="0,12,30,0"><TextBlock Text="{Binding TimeRangeDisplay}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,6"/><Border Background="#FFF1E5" CornerRadius="12" Padding="9,4" Margin="0,0,0,6"><TextBlock Text="{Binding CalendarDurationDisplay}" Foreground="#FF8000" FontSize="12" FontWeight="Medium"/></Border></WrapPanel>
    <Button Content="×" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="#6E6E73" Click="Close_Click"/>
   </Grid>
   <StackPanel Orientation="Horizontal" Margin="0,3,0,14">
    <Image Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center" Source="/FocusApp.Desktop;component/Assets/Icons/Common/rili.png"/>
    <TextBlock Text="{Binding CalendarDateDisplay}" Foreground="#6E6E73" VerticalAlignment="Center" FontSize="12"/>
   </StackPanel>
   <Border Background="#F7F7F9" CornerRadius="8" Padding="10" Visibility="{Binding HasGoal, Converter={StaticResource BoolVisibility}}">
    <DockPanel><Image Source="{Binding IconSource}" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="{Binding GoalName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
   </Border>
   <StackPanel Visibility="{Binding ShowDetailTasks, Converter={StaticResource BoolVisibility}}">
    <Border Height="1" Background="#E5E5EA" Margin="0,16"/>
    <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Text="{Binding TaskCountDisplay}" Foreground="#6E6E73" FontSize="12"/><TextBlock Text="本次完成任务" FontSize="15" FontWeight="Medium"/></DockPanel>
    <Border Background="#F7F7F9" CornerRadius="8" Padding="10,6">
     <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding CompletedTaskNames}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,4"><Image Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Source="/FocusApp.Desktop;component/Assets/Icons/Common/green_gouxuan.png"/><TextBlock VerticalAlignment="Center" Text="{Binding}" TextWrapping="Wrap" LineHeight="20"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </ScrollViewer>
    </Border>
   </StackPanel>
   <Border Height="1" Background="#E5E5EA" Margin="0,16,0,10"/>
   <TextBlock x:Name="DeleteError" Visibility="Collapsed" Text="删除失败，请稍后重试" Foreground="#FF3B30" FontSize="12" Margin="0,0,0,8"/>
   <Button x:Name="DeleteButton" Foreground="#FF3B30" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="30" Click="Delete_Click">
    <StackPanel Orientation="Horizontal">
     <Image Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center" Source="/FocusApp.Desktop;component/Assets/Icons/Common/lajitong.png"/>
     <TextBlock Text="删除记录" Foreground="#FF3B30" VerticalAlignment="Center"/>
    </StackPanel>
   </Button>
  </StackPanel>
 </Border>
</Window>
