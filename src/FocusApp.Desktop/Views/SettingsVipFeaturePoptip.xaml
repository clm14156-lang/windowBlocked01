<UserControl x:Class="FocusApp.Desktop.Views.SettingsVipFeaturePoptip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             FontFamily="{DynamicResource FontFamilyPrimary}" Width="300" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/PoptipStyles.xaml"/></ResourceDictionary.MergedDictionaries>
    </ResourceDictionary></UserControl.Resources>
    <views:PoptipChrome x:Name="Surface" Style="{StaticResource PoptipSurfaceStyle}" Margin="10" MaxWidth="320" PointerSize="18,9" Background="White" BorderBrush="#E7EBF2">
        <views:PoptipChrome.Effect><DropShadowEffect Color="#17202D" BlurRadius="14" ShadowDepth="3" Opacity="0.10"/></views:PoptipChrome.Effect>
        <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="9"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Width="28" Height="28" Background="#FFF1E3" CornerRadius="8">
                    <Viewbox Width="18" Height="18"><Path x:Name="FeatureIcon" Stroke="#FD7E05" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                        <Path.Style><Style TargetType="Path">
                            <Setter Property="Data" Value="M 2,7 L 6,10 L 10,3 L 14,10 L 18,7 L 16,17 L 4,17 Z M 5,20 L 15,20"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsAutomaticBlockingFeature}" Value="True"><Setter Property="Data" Value="M 19,10 A 9,9 0 1 1 1,10 A 9,9 0 1 1 19,10 M 10,5 L 10,10 L 14,10"/></DataTrigger></Style.Triggers>
                        </Style></Path.Style>
                    </Path></Viewbox>
                </Border>
                <TextBlock x:Name="HintTitle" Grid.Column="2" Text="{Binding VipHintTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#101B2C" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="HintDescription" Text="{Binding VipHintDescription}" Margin="0,8,0,0" FontSize="12" FontWeight="Normal" Foreground="#6B7280" TextWrapping="Wrap" LineHeight="18"/>
            <Border Height="1" Margin="0,11,0,2" Background="#EFF1F5"/>
            <Button x:Name="MembershipButton" Height="30" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}" Click="MembershipButton_Click" AutomationProperties.Name="开通会员">
                <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"><TextBlock Text="开通会员 ›" FontSize="13" FontWeight="Medium" Foreground="#FD7E05" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
            </Button>
        </StackPanel>
    </views:PoptipChrome>
</UserControl>
