<Window x:Class="FocusApp.Desktop.Views.FocusFloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FocusApp.Desktop.Views"
        Width="300"
        Height="220"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid x:Name="ContentHost"
          ClipToBounds="True"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="ContentTranslateTransform" />
        </Grid.RenderTransform>
        <views:FloatingContent x:Name="FloatingContentView"
                               Visibility="Visible" />
        <views:FoldedHorizontal x:Name="FoldedHorizontalView"
                                Visibility="Collapsed" />
        <views:FoldedVertical x:Name="FoldedVerticalView"
                              Visibility="Collapsed" />
    </Grid>
</Window>
