<Window x:Class="FocusApp.Desktop.Views.FocusFloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300"
        Height="220"
        MinWidth="300"
        MinHeight="220"
        MaxWidth="300"
        MaxHeight="220"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="FloatingPlainButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="2"
            Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource BorderPrimary}"
            BorderThickness="1"
            CornerRadius="24">
        <Grid Margin="16,10,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10"
                             Height="10"
                             Margin="0,0,10,0"
                             Fill="{DynamicResource Success}" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="16"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="{DynamicResource FocusFloatingStatus}" />
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        AutomationProperties.Name="{DynamicResource FocusFloatingExpandButton}"
                        Click="ExpandButton_Click"
                        Style="{StaticResource FloatingPlainButton}"
                        ToolTip="{DynamicResource FocusFloatingExpandButton}">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                               Text="&#xE740;" />
                </Button>
            </Grid>

            <TextBlock Grid.Row="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="{DynamicResource FontFamilyNumeric}"
                       FontSize="54"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Text="{Binding RemainingTimeDisplay}" />

            <ProgressBar Grid.Row="2"
                         Height="6"
                         Margin="0,0,0,2"
                         Maximum="1"
                         Minimum="0"
                         Value="{Binding RemainingProgress, Mode=OneWay}"
                         Foreground="{DynamicResource AccentPrimary}"
                         Background="{DynamicResource BackgroundSecondary}" />

            <Border x:Name="TaskDisplayBorder"
                    Grid.Row="3"
                    MinHeight="40"
                    Padding="12,7"
                    Background="{DynamicResource BackgroundPrimary}"
                    BorderBrush="{DynamicResource BorderPrimary}"
                    BorderThickness="1"
                    CornerRadius="14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasCurrentTask}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Button Width="24"
                            Height="24"
                            Margin="0,0,10,0"
                            Padding="0"
                            AutomationProperties.Name="{DynamicResource FocusFloatingCompleteTask}"
                            Command="{Binding ToggleTaskCompletedCommand}"
                            CommandParameter="{Binding CurrentTask}"
                            Style="{StaticResource FloatingPlainButton}"
                            ToolTip="{DynamicResource FocusFloatingCompleteTask}">
                        <Ellipse Width="14"
                                 Height="14"
                                 Stroke="{DynamicResource TextTertiary}"
                                 StrokeThickness="1.5" />
                    </Button>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="{DynamicResource TextPrimary}"
                               Text="{Binding CurrentTaskName}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
