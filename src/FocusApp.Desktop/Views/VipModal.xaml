<UserControl x:Class="FocusApp.Desktop.Views.VipModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FocusApp.Desktop.ViewModels"
             Width="440"
             Height="550"
             TextElement.FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="VipSelectedPlanBackground" Color="#FFF8F2" />
        <Style x:Key="VipPlainButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VipPlanButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentTint}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.84" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VipBenefitCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="5,5,7,5" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource OverlayBorder}"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Direction="270" Opacity="0.18" ShadowDepth="8" />
        </Border.Effect>

        <Grid Margin="20,14,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="108" />
                <RowDefinition Height="1" />
                <RowDefinition Height="34" />
                <RowDefinition Height="128" />
                <RowDefinition Height="140" />
                <RowDefinition Height="54" />
                <RowDefinition Height="45" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.RenderTransform><TranslateTransform Y="-2" /></StackPanel.RenderTransform>
                    <Viewbox Width="68" Height="59.5" HorizontalAlignment="Center">
                    <Grid Width="48" Height="42">
                        <Path HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M 24,2 L 44,21 L 24,40 L 4,21 Z M 24,2 L 31,21 L 24,40 L 17,21 Z"
                              Fill="{DynamicResource FocusButtonBackground}"
                              Stretch="None" />
                        <TextBlock Margin="-8,-9,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   FontSize="17"
                                   Foreground="{DynamicResource AccentHover}"
                                   Text="✦" />
                        <TextBlock Margin="0,-7,-10,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   FontSize="13"
                                   Foreground="{DynamicResource AccentHover}"
                                   Text="✦" />
                    </Grid>
                    </Viewbox>
                    <TextBlock Margin="0,2,0,0"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               Text="{DynamicResource VipModalTitle}">
                        <TextBlock.RenderTransform><TranslateTransform Y="-2" /></TextBlock.RenderTransform>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="2"
                       Margin="4,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="15"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextPrimary}"
                       Text="{DynamicResource VipModalBenefitsTitle}">
                <TextBlock.RenderTransform><TranslateTransform Y="-7" /></TextBlock.RenderTransform>
            </TextBlock>

            <UniformGrid Grid.Row="3" Columns="3" Rows="2">
                <UniformGrid.RenderTransform><TranslateTransform Y="1" /></UniformGrid.RenderTransform>
                <Border Style="{StaticResource VipBenefitCardStyle}">
                    <Grid Margin="9,7,4,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Width="27" Height="27" Background="{DynamicResource AccentTint}" CornerRadius="14">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource AccentPrimary}" Text="&#xE72E;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource VipBenefitForcedMode}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource VipBenefitCardStyle}">
                    <Grid Margin="9,7,4,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Width="27" Height="27" Background="{DynamicResource AccentTint}" CornerRadius="14">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource AccentPrimary}" Text="&#xEA18;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource VipBenefitAutoBlocking}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource VipBenefitCardStyle}">
                    <Grid Margin="9,7,4,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Width="27" Height="27" Background="{DynamicResource AccentTint}" CornerRadius="14">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource AccentPrimary}" Text="&#xE790;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource VipBenefitThemes}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource VipBenefitCardStyle}">
                    <Grid Margin="9,7,4,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Width="27" Height="27" Background="{DynamicResource AccentTint}" CornerRadius="14">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource AccentPrimary}" Text="&#xE8A5;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource VipBenefitExport}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource VipBenefitCardStyle}">
                    <Grid Margin="9,7,4,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Width="27" Height="27" Background="{DynamicResource AccentTint}" CornerRadius="14">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource AccentPrimary}" Text="&#xE9D2;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource VipBenefitStatistics}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource VipBenefitCardStyle}">
                    <Grid Margin="9,7,4,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Width="27" Height="27" Background="{DynamicResource AccentTint}" CornerRadius="14">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource AccentPrimary}" Text="&#xE753;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource VipBenefitSync}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <UniformGrid Grid.Row="4" Columns="3">
                <Button Margin="5,15,7,6" Command="{Binding SelectPlanCommand}" CommandParameter="{x:Static vm:VipModalViewModel.MonthlyPlan}">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource VipPlanButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPlanKey}" Value="{x:Static vm:VipModalViewModel.MonthlyPlan}">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                    <Setter Property="Background" Value="{StaticResource VipSelectedPlanBackground}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.RenderTransform><TranslateTransform Y="-9" /></StackPanel.RenderTransform>
                        <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource VipPlanMonthly}" />
                        <StackPanel Margin="0,8,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Margin="0,7,2,0" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextPrimary}" Text="¥" />
                            <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource VipPlanMonthlyPrice}" />
                            <TextBlock Margin="3,12,0,0" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource VipPlanMonthlyUnit}" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Margin="5,15,7,6" Command="{Binding SelectPlanCommand}" CommandParameter="{x:Static vm:VipModalViewModel.YearlyPlan}">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource VipPlanButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPlanKey}" Value="{x:Static vm:VipModalViewModel.YearlyPlan}">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                    <Setter Property="Background" Value="{StaticResource VipSelectedPlanBackground}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.RenderTransform><TranslateTransform Y="5" /></StackPanel.RenderTransform>
                            <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource VipPlanYearly}" />
                            <StackPanel Margin="0,6,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Margin="0,7,2,0" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextPrimary}" Text="¥" />
                                <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource VipPlanYearlyPrice}" />
                                <TextBlock Margin="3,12,0,0" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource VipPlanYearlyUnit}" />
                            </StackPanel>
                            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource VipPlanYearlyHint}" />
                            <TextBlock Margin="0,2,0,0" HorizontalAlignment="Center" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource AccentPrimary}" Text="{DynamicResource VipPlanSavings}" />
                        </StackPanel>
                        <Border Height="22" Padding="8,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource AccentPrimary}" CornerRadius="0,10,0,9">
                            <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource WhiteText}" Text="{DynamicResource VipPlanRecommended}" />
                        </Border>
                    </Grid>
                </Button>

                <Button Margin="5,15,7,6" Command="{Binding SelectPlanCommand}" CommandParameter="{x:Static vm:VipModalViewModel.LifetimePlan}">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource VipPlanButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPlanKey}" Value="{x:Static vm:VipModalViewModel.LifetimePlan}">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                    <Setter Property="Background" Value="{StaticResource VipSelectedPlanBackground}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.RenderTransform><TranslateTransform Y="2" /></StackPanel.RenderTransform>
                        <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource VipPlanLifetime}" />
                        <StackPanel Margin="0,5,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Margin="0,7,2,0" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextPrimary}" Text="¥" />
                            <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource VipPlanLifetimePrice}" />
                        </StackPanel>
                        <TextBlock Margin="0,11,0,0" HorizontalAlignment="Center" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource VipPlanLifetimeHint}" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <Button Grid.Row="5"
                    Height="40"
                    Margin="5,12,6,2"
                    AutomationProperties.Name="{DynamicResource VipUpgradeAction}"
                    Command="{Binding UpgradeCommand}">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="{DynamicResource FocusButtonBackground}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource FocusButtonHoverBackground}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource FocusButtonPressedBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.RenderTransform><TranslateTransform Y="1" /></StackPanel.RenderTransform>
                    <Viewbox Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Canvas Width="20" Height="20">
                            <Path Data="M 1,5 L 5,12 L 10,3 L 15,12 L 19,5 L 17,15 L 3,15 Z M 3,18 L 17,18" Fill="Transparent" Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <Ellipse Canvas.Left="0" Canvas.Top="3.5" Width="2.5" Height="2.5" Fill="White" />
                            <Ellipse Canvas.Left="8.75" Canvas.Top="1" Width="2.5" Height="2.5" Fill="White" />
                            <Ellipse Canvas.Left="17.5" Canvas.Top="3.5" Width="2.5" Height="2.5" Fill="White" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource WhiteText}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Text" Value="{DynamicResource VipUpgradeAction}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUpgradeFeedback}" Value="True">
                                        <Setter Property="Text" Value="{DynamicResource VipUpgradeFeedback}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>

            <Button Grid.Row="6"
                    Width="110"
                    Height="34"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{DynamicResource VipLaterAction}"
                    Command="{Binding LaterCommand}"
                    Style="{StaticResource VipPlainButtonStyle}">
                <TextBlock FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource VipLaterAction}" />
            </Button>
        </Grid>
    </Border>
</UserControl>
