<UserControl x:Class="FocusApp.Desktop.Views.VipModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="450" FontFamily="{DynamicResource FontFamilyPrimary}"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FocusApp.Desktop;component/Resources/StatisticsTypography.xaml" />
                <ResourceDictionary Source="/FocusApp.Desktop;component/Resources/PrimaryActionButtons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="VipAccentBrush" Color="#FD7E05" />
            <SolidColorBrush x:Key="VipIconBackground" Color="#FFF0E5" />
            <SolidColorBrush x:Key="VipNeutralBorder" Color="#E7E9ED" />
            <Geometry x:Key="VipShieldIcon">M 12,2 C 9,4 6,5 3,5.5 V 11 C 3,16 6,20 12,23 C 18,20 21,16 21,11 V 5.5 C 18,5 15,4 12,2 Z</Geometry>
            <Geometry x:Key="VipLayersIcon">M 2,7 L 12,2 L 22,7 L 12,12 Z M 2,12 L 12,17 L 22,12 M 2,17 L 12,22 L 22,17</Geometry>
            <Geometry x:Key="VipStatisticsIcon">M 2,18 V 14 M 6,18 V 8 H 8 V 18 M 12,12 V 3 H 14 V 9 M 21.5,13.5 A 3.5,3.5 0 1 1 14.5,13.5 A 3.5,3.5 0 1 1 21.5,13.5 M 12,23 A 6,6 0 0 1 24,23</Geometry>

            <Style x:Key="VipBenefitRowStyle" TargetType="ContentControl">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12"
                                    Background="{StaticResource VipIconBackground}" Margin="0,0,16,0" VerticalAlignment="Center">
                                <Path Width="23" Height="23" Stretch="Uniform"
                                      Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      Stroke="{StaticResource VipAccentBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value></Setter>
            </Style>
            <Style x:Key="VipBenefitDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource StatisticsAuxiliaryTextStyle}">
                <Setter Property="Foreground" Value="{StaticResource StatisticsSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,3,0,0" />
            </Style>
            <Style x:Key="VipLaterButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource StatisticsSecondaryBrush}" />
                <Setter Property="FontSize" Value="{DynamicResource ButtonFontSize}" />
                <Setter Property="FontWeight" Value="{DynamicResource ButtonFontWeight}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LaterSurface" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LaterSurface" Property="Background" Value="#F3F4F6" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="LaterSurface" Property="Background" Value="#E9EBEF" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="VipCard" Background="White" BorderBrush="{StaticResource VipNeutralBorder}"
            BorderThickness="1" CornerRadius="18">
        <Grid>
            <StackPanel Margin="26,21,26,12">
                <Border Width="66" Height="66" CornerRadius="18" HorizontalAlignment="Center" Background="{StaticResource VipIconBackground}">
                    <Path Width="41" Height="37" Stretch="Uniform" Stroke="{StaticResource VipAccentBrush}" StrokeThickness="3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M 2,10 L 12,19 L 20,2 L 28,19 L 38,10 L 35,29 H 5 Z M 6,35 H 34" />
                </Border>
                <TextBlock x:Name="VipTitle" Text="{DynamicResource VipModalTitle}" Style="{StaticResource DialogTitleTextStyle}" FontSize="18"
                           Foreground="{StaticResource StatisticsPrimaryBrush}" TextAlignment="Center" Margin="0,9,0,0" />
                <TextBlock Text="{DynamicResource VipModalSubtitle}" Style="{StaticResource StatisticsMetricLabelStyle}"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                <Border Height="1" Background="{StaticResource VipNeutralBorder}" Margin="0,18,0,16" />

                <StackPanel Margin="16,0,10,0">
                    <ContentControl Style="{StaticResource VipBenefitRowStyle}" Tag="{StaticResource VipShieldIcon}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource VipBenefitFocusTitle}" Style="{StaticResource StatisticsHeadingTextStyle}" />
                            <TextBlock Text="{DynamicResource VipBenefitFocusDescription}" Style="{StaticResource VipBenefitDescriptionStyle}" />
                        </StackPanel>
                    </ContentControl>
                    <ContentControl Style="{StaticResource VipBenefitRowStyle}" Tag="{StaticResource VipLayersIcon}" Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource VipBenefitQuotaTitle}" Style="{StaticResource StatisticsHeadingTextStyle}" />
                            <TextBlock Text="{DynamicResource VipBenefitQuotaDescription}" Style="{StaticResource VipBenefitDescriptionStyle}" />
                        </StackPanel>
                    </ContentControl>
                    <ContentControl Style="{StaticResource VipBenefitRowStyle}" Tag="{StaticResource VipStatisticsIcon}" Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource VipBenefitPersonalizationTitle}" Style="{StaticResource StatisticsHeadingTextStyle}" />
                            <TextBlock Text="{DynamicResource VipBenefitPersonalizationDescription}" Style="{StaticResource VipBenefitDescriptionStyle}" />
                        </StackPanel>
                    </ContentControl>
                </StackPanel>

                <Button x:Name="UpgradeButton" Height="46" Margin="0,31,0,0"
                        Command="{Binding UpgradeCommand}" Style="{StaticResource PrimaryActionRoundedButtonStyle}"
                        AutomationProperties.Name="{DynamicResource VipUpgradeAction}">
                    <Button.Resources>
                        <ResourceDictionary Source="/FocusApp.Desktop;component/Resources/VipActionBackgrounds.xaml" />
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="17" Height="17" Margin="0,0,10,0" Stretch="Uniform" VerticalAlignment="Center"
                              Data="M 8,3 H 3 Q 2,3 2,4 V 16 Q 2,17 3,17 H 15 Q 16,17 16,16 V 11 M 11,2 H 17 V 8 M 8,11 L 17,2"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <TextBlock x:Name="UpgradeLabel" Style="{StaticResource PrimaryActionButtonLabelStyle}" Text="{DynamicResource VipUpgradeAction}" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding UpgradeFeedback}" TextAlignment="Center" Margin="0,6,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatisticsAuxiliaryTextStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUpgradeFeedback}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button x:Name="LaterButton" Width="104" Height="32" Margin="0,10,0,0" HorizontalAlignment="Center"
                        Command="{Binding LaterCommand}" Style="{StaticResource VipLaterButtonStyle}" Content="{DynamicResource VipLaterAction}" />
            </StackPanel>
            <Button x:Name="CloseButton" Margin="0,11,12,0" Command="{Binding CloseCommand}"
                    AutomationProperties.Name="{DynamicResource VipModalClose}" Style="{DynamicResource ModalCloseButtonStyle}" />
        </Grid>
    </Border>
</UserControl>
