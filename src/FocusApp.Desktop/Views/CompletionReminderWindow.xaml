<Window x:Class="FocusApp.Desktop.Views.CompletionReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource CompletionReminderTitle}"
        Width="400"
        Height="210"
        MinWidth="400"
        MinHeight="210"
        MaxWidth="400"
        MaxHeight="210"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        SnapsToDevicePixels="True"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStyle="None">
    <Border x:Name="RootCard"
            Margin="4"
            Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource OverlayBorder}"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Direction="270" Opacity="0.08" ShadowDepth="2" />
        </Border.Effect>

        <Grid Margin="24,14,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="10" />
                <RowDefinition Height="30" />
                <RowDefinition Height="22" />
                <RowDefinition Height="26" />
                <RowDefinition Height="20" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image x:Name="ApplicationLogo"
                       Width="32"
                       Height="32"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Source="/FocusApp.Desktop;component/Assets/Icons/Common/shiguang_logo.png"
                       Stretch="Uniform" />

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="{DynamicResource CompletionReminderBrandName}" />

                <Button Grid.Column="3"
                        Width="26"
                        Height="26"
                        Margin="0,-4,-8,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{DynamicResource CompletionReminderClose}"
                        Command="{Binding CloseCompletionReminderCommand}"
                        Style="{StaticResource WindowChromeButtonStyle}">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="&#xE8BB;" />
                </Button>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Width="32"
                       Height="32"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Source="/FocusApp.Desktop;component/Assets/Icons/Common/CompletePop-up_CheckBox.png"
                       Stretch="Uniform" />

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="{DynamicResource CompletionReminderTitle}" />
            </Grid>

            <StackPanel Grid.Row="3"
                        Margin="40,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="Normal"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="{DynamicResource CompletionReminderDurationPrefix}" />
                <TextBlock Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentPrimary}"
                           Text="{Binding CompletionReminderDuration, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Grid.Row="4"
                        Margin="40,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="15"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="&#xE823;" />
                <TextBlock Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="Normal"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="{Binding CompletionReminderTimeRange, Mode=OneWay}" />
            </StackPanel>

            <Border Grid.Row="5"
                    Height="1"
                    Margin="40,0,0,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource BorderPrimary}" />

            <StackPanel Grid.Row="6"
                        Margin="40,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Border Width="15"
                        Height="15"
                        VerticalAlignment="Center"
                        BorderBrush="{DynamicResource Success}"
                        BorderThickness="1.5"
                        CornerRadius="7.5">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="10"
                               Foreground="{DynamicResource Success}"
                               Text="&#xE73E;" />
                </Border>
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="Normal"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="{DynamicResource CompletionReminderRecorded}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
