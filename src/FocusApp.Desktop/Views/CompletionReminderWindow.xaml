<Window x:Class="FocusApp.Desktop.Views.CompletionReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="390"
        Height="150"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStyle="None">
    <Border Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource OverlayBorder}"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect><DropShadowEffect BlurRadius="20" Direction="270" Opacity="0.16" ShadowDepth="5" /></Border.Effect>
        <Grid Margin="20,16,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="66" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="28" />
            </Grid.ColumnDefinitions>
            <Border Width="54" Height="54" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource AccentPrimary}" CornerRadius="27">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource WhiteText}" Text="&#xE73E;" />
            </Border>
            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                <TextBlock FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="专注已完成" />
                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                    <TextBlock FontSize="13" Foreground="{DynamicResource TextPrimary}" Text="本次专注 " />
                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" Text="{Binding CompletionReminderDuration}" />
                </StackPanel>
                <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{Binding CompletionReminderDetail}" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCompletionReminderDetail}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Margin="0,7,0,0" FontSize="11" Foreground="{DynamicResource TextTertiary}" Text="已记录到统计" />
            </StackPanel>
            <Button Grid.Column="2" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="关闭专注完成提示" Command="{Binding CloseCompletionReminderCommand}" Style="{StaticResource WindowChromeButtonStyle}">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="&#xE8BB;" />
            </Button>
        </Grid>
    </Border>
</Window>
