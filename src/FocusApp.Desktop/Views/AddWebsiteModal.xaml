<UserControl x:Class="FocusApp.Desktop.Views.AddWebsiteModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="330"
             Height="330"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             IsVisibleChanged="Modal_IsVisibleChanged"
             PreviewKeyDown="Modal_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="BlockingModalTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OverlayBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlockingModalSecondaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource ThemedTextButtonBaseStyle}">
            <Setter Property="Width" Value="78" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextUnit}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlockingModalPrimaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BlockingModalSecondaryButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlockingOptionalNameButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource ThemedTextButtonBaseStyle}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource OverlayBorder}"
            BorderThickness="1"
            CornerRadius="12"
            MouseDown="ModalCard_MouseDown">
        <Grid Margin="24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="22" />
                <RowDefinition />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       VerticalAlignment="Top"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Text" Value="{DynamicResource BlockingAddWebsiteModalTitle}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                <Setter Property="Text" Value="{DynamicResource BlockingEditWebsiteModalTitle}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Grid.Row="1"
                       VerticalAlignment="Top"
                       FontSize="12"
                       FontWeight="Normal"
                       Foreground="{DynamicResource TextSecondary}">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Text" Value="{DynamicResource BlockingAddWebsiteModalDescription}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                <Setter Property="Text" Value="{DynamicResource BlockingEditWebsiteModalDescription}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Grid.Row="2" Margin="0,10,0,10">
                <TextBlock FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="{DynamicResource BlockingWebsiteAddressLabel}" />
                <Grid Margin="0,8,0,0">
                    <TextBox x:Name="WebsiteAddressTextBox"
                             AutomationProperties.Name="{DynamicResource BlockingWebsiteAddressLabel}"
                             Text="{Binding WebsiteAddress, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource BlockingModalTextBoxStyle}" />
                    <TextBlock Margin="11,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               FontSize="13"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextWeak}"
                               Text="{DynamicResource BlockingWebsiteAddressPlaceholder}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WebsiteAddress}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=WebsiteAddressTextBox}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock Margin="0,6,0,0"
                           FontSize="12"
                           FontWeight="Normal"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="{DynamicResource BlockingWebsiteDomainHint}" />

                <Button Margin="0,18,0,0"
                        Command="{Binding ToggleWebsiteNameCommand}"
                        Content="{DynamicResource BlockingWebsiteOptionalNamePrompt}">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BlockingOptionalNameButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWebsiteNameExpanded}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel Margin="0,17,0,0">
                    <StackPanel.Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWebsiteNameExpanded}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"
                               Text="{DynamicResource BlockingWebsiteOptionalNameLabel}" />
                    <Grid Margin="0,8,0,0">
                        <TextBox x:Name="WebsiteNameTextBox"
                                 AutomationProperties.Name="{DynamicResource BlockingWebsiteOptionalNameLabel}"
                                 Text="{Binding WebsiteName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BlockingModalTextBoxStyle}"
                                 IsVisibleChanged="WebsiteNameEditor_IsVisibleChanged" />
                        <TextBlock Margin="11,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   FontSize="13"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource TextWeak}"
                                   Text="{DynamicResource BlockingWebsiteNamePlaceholder}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WebsiteName}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=WebsiteNameTextBox}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button AutomationProperties.Name="{DynamicResource BlockingModalCancel}"
                        Command="{Binding CloseCommand}"
                        Content="{DynamicResource BlockingModalCancel}"
                        Style="{StaticResource BlockingModalSecondaryButtonStyle}" />
                <Button Margin="14,0,0,0"
                        AutomationProperties.Name="{DynamicResource BlockingWebsiteAdd}"
                        Command="{Binding SaveCommand}">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BlockingModalPrimaryButtonStyle}">
                            <Setter Property="Content" Value="{DynamicResource BlockingWebsiteAdd}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="Content" Value="{DynamicResource BlockingModalSave}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
