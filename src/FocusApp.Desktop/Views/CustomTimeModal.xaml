<UserControl x:Class="FocusApp.Desktop.Views.CustomTimeModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="320"
             TextElement.FontFamily="{DynamicResource FontFamilyPrimary}"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="../Resources/PrimaryActionButtons.xaml" />
            <ResourceDictionary Source="../Resources/StatisticsTypography.xaml" />
        </ResourceDictionary.MergedDictionaries>

        <Style x:Key="CustomTimeFocusVisualStyle" TargetType="{x:Type Control}">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Control}">
                <Border Margin="-3" BorderBrush="#FFD3B0" BorderThickness="1" CornerRadius="15" IsHitTestVisible="False" />
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CustomTimeQuickButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="86" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource StatisticsBodyBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyPrimary}" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ContentTemplate" Value="{DynamicResource ThemedButtonTextContentTemplate}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource CustomTimeFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="QuickButtonScale" /></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="QuickButtonPress">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="QuickButtonScale" Storyboard.TargetProperty="ScaleX" To="0.98" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetName="QuickButtonScale" Storyboard.TargetProperty="ScaleY" To="0.98" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions><StopStoryboard BeginStoryboardName="QuickButtonPress" /></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF7F0" />
                    <Setter Property="BorderBrush" Value="#FFD3B0" />
                </Trigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="FontWeight" Value="Medium" />
                    <Setter Property="Background" Value="#FFFAF6" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FFF4EB" />
                </MultiDataTrigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFEBDD" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CustomTimePrimaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource PrimaryActionButtonStyle}">
            <Setter Property="Height" Value="42" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource CustomTimeFocusVisualStyle}" />
            <Setter Property="ContentTemplate" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="PrimaryButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CustomTimeEditButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="{DynamicResource ButtonFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource ButtonFontWeight}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource CustomTimeFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="EditButtonBorder" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EditButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="EditButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>


    <Border x:Name="CustomTimeCard" Width="320"
            Padding="19,18,19,16"
            Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource OverlayBorder}"
            BorderThickness="1" CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.10" ShadowDepth="4" />
        </Border.Effect>
        <StackPanel>
            <Grid Height="28">
                <TextBlock Style="{StaticResource StatisticsPageTitleTextStyle}"
                           VerticalAlignment="Center" TextAlignment="Center"
                           Text="{DynamicResource CustomTimeTitle}" />
                <Button x:Name="CloseCustomTimeButton" Width="26" Height="26" Margin="0,-4,-6,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding CancelCommand}" AutomationProperties.Name="关闭"
                        Style="{StaticResource CustomTimeEditButtonStyle}">
                    <Path Width="10" Height="10" Data="M 0,0 L 10,10 M 10,0 L 0,10"
                          Stroke="{DynamicResource TextWeak}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </Grid>

            <Grid Height="28" Margin="0,16,0,8">
                <TextBlock Style="{StaticResource StatisticsHeadingTextStyle}" VerticalAlignment="Center"
                           Text="{DynamicResource CustomTimeCommonLabel}" />
                <Button x:Name="EditCommonTimesButton" HorizontalAlignment="Right" Command="{Binding ToggleEditCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CustomTimeEditButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource PrimaryActionButtonLabelStyle}" Text="编辑" />
                        <Path Width="5" Height="9" Margin="7,0,0,0" VerticalAlignment="Center"
                              Data="M 0,0 L 4.5,4.5 L 0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </StackPanel>
                </Button>
                <Button x:Name="CompleteEditButton" HorizontalAlignment="Right" Content="完成"
                        Command="{Binding CompleteEditCommand}" ContentTemplate="{DynamicResource ThemedButtonTextContentTemplate}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CustomTimeEditButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <ItemsControl x:Name="CommonTimeOptions" Width="280" ItemsSource="{Binding CommonTimes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="86" Height="40" Margin="0,0,7,8">
                            <Button Command="{Binding DataContext.SelectTimeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" Content="{Binding DurationDisplayLabel}"
                                    Style="{StaticResource CustomTimeQuickButtonStyle}" Tag="{Binding IsSelectedInCustomTime}" />
                            <Button Width="16" Height="16" Margin="0,-4,-4,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Padding="0"
                                    Command="{Binding DataContext.DeleteTimeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" Content="×" FontSize="10" FontWeight="Normal">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CustomTimeQuickButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Height="1" Margin="0,12,0,8" Background="{DynamicResource OverlayBorder}" />
            <Button x:Name="ToggleCustomDurationButton" Height="40" HorizontalContentAlignment="Stretch"
                    Command="{Binding ToggleCustomDurationCommand}"
                    AutomationProperties.Name="{DynamicResource CustomTimeExpandLabel}"
                    AutomationProperties.HelpText="{DynamicResource CustomTimeInputPlaceholder}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource CustomTimeEditButtonStyle}">
                        <Setter Property="Width" Value="280" />
                        <Setter Property="Foreground" Value="{StaticResource StatisticsBodyBrush}" />
                    </Style>
                </Button.Style>
                <Grid Width="280">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" /><ColumnDefinition Width="10" />
                        <ColumnDefinition /><ColumnDefinition Width="16" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="18" Height="18" VerticalAlignment="Center">
                        <Ellipse StrokeThickness="1.4">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Stroke" Value="{StaticResource StatisticsSecondaryBrush}" />
                                    <Setter Property="Fill" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustomDurationExpanded}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource PrimaryActionBackground}" />
                                            <Setter Property="Stroke" Value="{DynamicResource PrimaryActionBackground}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Path StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="M 5,9 L 13,9 M 9,5 L 9,13" />
                                    <Setter Property="Stroke" Value="{StaticResource StatisticsSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustomDurationExpanded}" Value="True">
                                            <Setter Property="Data" Value="M 5,9 L 13,9" />
                                            <Setter Property="Stroke" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                    <TextBlock Grid.Column="2" Style="{StaticResource PrimaryActionButtonLabelStyle}"
                               Text="{DynamicResource CustomTimeExpandLabel}" />
                    <Path Grid.Column="3" Width="6" Height="10" VerticalAlignment="Center"
                          Data="M 0,0 L 5,5 L 0,10" Stroke="{DynamicResource TextSecondary}"
                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0" /></Setter.Value></Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCustomDurationExpanded}" Value="True">
                                        <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Grid>
            </Button>

            <Border x:Name="CustomDurationReveal" Height="0" Visibility="Collapsed" Opacity="0"
                    ClipToBounds="True" IsHitTestVisible="False">
                <Grid Height="42" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}"
                            BorderThickness="1" CornerRadius="12">
                        <Grid Margin="12,0">
                            <TextBox x:Name="MinutesTextBox" Padding="0" VerticalContentAlignment="Center"
                                     Background="Transparent" BorderThickness="0"
                                     FontFamily="{DynamicResource FontFamilyPrimary}"
                                     FontSize="{DynamicResource BodyFontSize}" FontWeight="Normal"
                                     Foreground="{StaticResource StatisticsBodyBrush}"
                                     InputMethod.IsInputMethodEnabled="False" AllowDrop="False"
                                     DataObject.Pasting="MinutesTextBox_Pasting"
                                     PreviewKeyDown="MinutesTextBox_PreviewKeyDown"
                                     PreviewTextInput="MinutesTextBox_PreviewTextInput"
                                     Text="{Binding MinutesInput, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock IsHitTestVisible="False" VerticalAlignment="Center"
                                       Text="{DynamicResource CustomTimeInputPlaceholder}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StatisticsAuxiliaryTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MinutesInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Button Grid.Column="2" x:Name="AddCustomTimeButton"
                            AutomationProperties.Name="{DynamicResource CustomTimeConfirm}"
                            Command="{Binding ConfirmCommand}" Style="{StaticResource CustomTimePrimaryButtonStyle}">
                        <TextBlock Style="{StaticResource PrimaryActionButtonLabelStyle}" Text="{DynamicResource CustomTimeConfirm}" />
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
