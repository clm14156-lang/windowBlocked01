<UserControl x:Class="FocusApp.Desktop.Views.CustomTimeModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="320"
             Height="420"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="CustomTimeFocusVisualStyle" TargetType="{x:Type Control}">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Control}">
                <Border Margin="-3" BorderBrush="#FFD3B0" BorderThickness="1" CornerRadius="15" IsHitTestVisible="False" />
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CustomTimeQuickButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="86" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextUnit}" />
            <Setter Property="FontSize" Value="{DynamicResource BodyMediumFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource BodyMediumFontWeight}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ContentTemplate" Value="{DynamicResource ThemedButtonTextContentTemplate}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource CustomTimeFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="QuickButtonScale" /></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="QuickButtonPress">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="QuickButtonScale" Storyboard.TargetProperty="ScaleX" To="0.98" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetName="QuickButtonScale" Storyboard.TargetProperty="ScaleY" To="0.98" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions><StopStoryboard BeginStoryboardName="QuickButtonPress" /></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF7F0" />
                    <Setter Property="BorderBrush" Value="#FFD3B0" />
                </Trigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#FFFAF6" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FFF4EB" />
                </MultiDataTrigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFEBDD" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CustomTimeFooterButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="{DynamicResource ButtonFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource ButtonFontWeight}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ContentTemplate" Value="{DynamicResource ThemedButtonTextContentTemplate}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource CustomTimeFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="FooterBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FooterBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FooterBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CustomTimePrimaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource CustomTimeFooterButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
            <Setter Property="ContentTemplate" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="PrimaryButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryButtonBorder" Property="Background" Value="{DynamicResource AccentHover}" />
                                <Setter TargetName="PrimaryButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimaryButtonBorder" Property="Background" Value="{DynamicResource AccentPressed}" />
                                <Setter TargetName="PrimaryButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PrimaryButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                                <Setter TargetName="PrimaryButtonBorder" Property="BorderBrush" Value="{DynamicResource ControlPressedBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CustomTimeEditButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="{DynamicResource SecondaryMediumFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource SecondaryMediumFontWeight}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource CustomTimeFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="EditButtonBorder" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EditButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="EditButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="CustomTimeCard" Width="320"
            Height="420"
            Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource OverlayBorder}"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              Direction="270"
                              Opacity="0.10"
                              ShadowDepth="4" />
        </Border.Effect>
        <Canvas>
            <TextBlock Canvas.Top="23"
                       Width="318"
                       FontSize="{DynamicResource DialogTitleFontSize}"
                       FontWeight="{DynamicResource DialogTitleFontWeight}"
                       Foreground="{DynamicResource TextPrimary}"
                       Text="{DynamicResource CustomTimeTitle}"
                       TextAlignment="Center" />

            <Button x:Name="CloseCustomTimeButton" Canvas.Left="279" Canvas.Top="15"
                    Width="26" Height="26" Content="×" FontSize="20" FontWeight="Normal" Command="{Binding CancelCommand}"
                    ContentTemplate="{DynamicResource ThemedButtonTextContentTemplate}"
                    AutomationProperties.Name="关闭" Style="{StaticResource CustomTimeEditButtonStyle}" />

            <TextBlock Canvas.Left="20"
                       Canvas.Top="63"
                       FontSize="{DynamicResource SectionTitleFontSize}"
                       FontWeight="{DynamicResource SectionTitleFontWeight}"
                       Foreground="{DynamicResource TextPrimary}"
                       Text="{DynamicResource CustomTimeDurationLabel}" />

            <TextBlock Canvas.Left="198"
                       Canvas.Top="64"
                       Width="102"
                       FontSize="{DynamicResource SecondaryFontSize}"
                       FontWeight="{DynamicResource SecondaryFontWeight}"
                       Foreground="{DynamicResource TextSecondary}"
                       IsHitTestVisible="False"
                       Text="{DynamicResource CustomTimeDurationRange}"
                       TextAlignment="Right" />

            <Border Canvas.Left="20"
                    Canvas.Top="85"
                    Width="280"
                    Height="70"
                    Background="{DynamicResource SurfacePrimary}"
                    BorderBrush="{DynamicResource BorderPrimary}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <TextBox x:Name="MinutesTextBox"
                             Width="150"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Padding="0"
                             Background="{DynamicResource TransparentBrush}"
                             BorderThickness="0"
                             FontFamily="{DynamicResource FontFamilyNumeric}"
                             FontSize="{DynamicResource TimerFontSize}"
                             FontWeight="{DynamicResource TimerMediumFontWeight}"
                             Foreground="{DynamicResource TextPrimary}"
                             MaxLength="3"
                             DataObject.Pasting="MinutesTextBox_Pasting"
                             IsVisibleChanged="MinutesTextBox_IsVisibleChanged"
                             KeyDown="MinutesTextBox_KeyDown"
                             PreviewTextInput="MinutesTextBox_PreviewTextInput"
                             Text="{Binding MinutesInput, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Center" />
                    <TextBlock Margin="0,0,18,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource BodyFontSize}"
                               FontWeight="{DynamicResource BodyFontWeight}"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="{DynamicResource CustomTimeUnit}" />
                </Grid>
            </Border>

            <Border Canvas.Left="20"
                    Canvas.Top="173"
                    Width="280"
                    Height="1"
                    Background="{DynamicResource OverlayBorder}" />

            <TextBlock Canvas.Left="20"
                       Canvas.Top="186"
                       FontSize="{DynamicResource SectionTitleFontSize}"
                       FontWeight="{DynamicResource SectionTitleFontWeight}"
                       Foreground="{DynamicResource TextPrimary}"
                       Text="{DynamicResource CustomTimeCommonLabel}" />

            <Button Canvas.Left="248" Canvas.Top="180" Command="{Binding ToggleEditCommand}">
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource CustomTimeEditButtonStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                               FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                               Text="编辑" />
                    <TextBlock Margin="5,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="11"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                               Text="&#xE76C;" />
                </StackPanel>
            </Button>
            <Button Canvas.Left="248" Canvas.Top="180" Content="完成" Command="{Binding CompleteEditCommand}" ContentTemplate="{DynamicResource ThemedButtonTextContentTemplate}">
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource CustomTimeEditButtonStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <ItemsControl x:Name="CommonTimeOptions" Canvas.Left="20"
                          Canvas.Top="214"
                          Width="280"
                          Height="144"
                          ItemsSource="{Binding CommonTimes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="86" Height="40" Margin="0,0,7,8">
                            <Button Command="{Binding DataContext.SelectTimeCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding DurationDisplayLabel}"
                                    Style="{StaticResource CustomTimeQuickButtonStyle}"
                                    Tag="{Binding IsSelectedInCustomTime}" />
                            <Button Width="16"
                                    Height="16"
                                    Margin="0,-4,-4,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Padding="0"
                                    Command="{Binding DataContext.DeleteTimeCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                    CommandParameter="{Binding}"
                                    Content="×"
                                    FontSize="10" FontWeight="Normal">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource CustomTimeQuickButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button x:Name="AddCustomTimeButton" Canvas.Left="20"
                    Canvas.Top="364"
                    Width="280"
                    AutomationProperties.Name="{DynamicResource CustomTimeConfirm}"
                    Command="{Binding ConfirmCommand}"
                    Style="{StaticResource CustomTimePrimaryButtonStyle}">
                <TextBlock FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                           FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                           Text="{DynamicResource CustomTimeConfirm}" />
            </Button>
        </Canvas>
    </Border>
</UserControl>
