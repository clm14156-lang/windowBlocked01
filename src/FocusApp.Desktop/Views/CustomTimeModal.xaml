<UserControl x:Class="FocusApp.Desktop.Views.CustomTimeModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="300"
             Height="360"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="CustomTimeQuickButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CustomTimeAccentQuickButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource CustomTimeQuickButtonStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
        </Style>
        <Style x:Key="CustomTimeFooterButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="FooterBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FooterBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FooterBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CustomTimePrimaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource CustomTimeFooterButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Border Width="300"
            Height="360"
            Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource OverlayBorder}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              Direction="270"
                              Opacity="0.14"
                              ShadowDepth="5" />
        </Border.Effect>
        <Canvas>
            <TextBlock Canvas.Top="17"
                       Width="298"
                       HorizontalAlignment="Center"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Text="{DynamicResource CustomTimeTitle}"
                       TextAlignment="Center" />

            <TextBlock Canvas.Left="16"
                       Canvas.Top="55"
                       FontSize="13"
                       Text="{DynamicResource CustomTimeDurationLabel}" />

            <Border Canvas.Left="16"
                    Canvas.Top="80"
                    Width="268"
                    Height="57"
                    Background="{DynamicResource SurfacePrimary}"
                    BorderBrush="{DynamicResource BorderPrimary}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <TextBox Width="120"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Padding="0"
                             Background="Transparent"
                             BorderThickness="0"
                             FontFamily="Segoe UI Variable Display"
                             FontSize="34"
                             Foreground="{DynamicResource TextPrimary}"
                             Text="{Binding Minutes, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Center" />
                    <TextBlock Margin="0,0,15,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="{DynamicResource CustomTimeUnit}" />
                </Grid>
            </Border>

            <TextBlock Canvas.Left="16"
                       Canvas.Top="158"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Text="{DynamicResource CustomTimeCommonLabel}" />

            <Button Canvas.Left="16" Canvas.Top="183" Height="32" Style="{StaticResource CustomTimeAccentQuickButtonStyle}" Content="{DynamicResource CustomTimePreset15}" />
            <Button Canvas.Left="110" Canvas.Top="183" Height="32" Style="{StaticResource CustomTimeAccentQuickButtonStyle}" Content="{DynamicResource CustomTimePreset15}" />
            <Button Canvas.Left="204" Canvas.Top="183" Height="32" Style="{StaticResource CustomTimeQuickButtonStyle}" Content="{DynamicResource CustomTimePreset15}" />
            <Button Canvas.Left="16" Canvas.Top="225" Height="32" Style="{StaticResource CustomTimeQuickButtonStyle}" Content="{DynamicResource CustomTimePreset15}" />
            <Button Canvas.Left="110" Canvas.Top="225" Height="32" Style="{StaticResource CustomTimeAccentQuickButtonStyle}" Content="{DynamicResource CustomTimePreset15}" />
            <Button Canvas.Left="204" Canvas.Top="225" Height="32" Style="{StaticResource CustomTimeAccentQuickButtonStyle}" Content="{DynamicResource CustomTimePreset15}" />
            <Button Canvas.Left="16" Canvas.Top="267" Height="32" Style="{StaticResource CustomTimeQuickButtonStyle}" Content="{DynamicResource CustomTimePreset15}" />
            <Button Canvas.Left="110" Canvas.Top="267" Height="32" Style="{StaticResource CustomTimeQuickButtonStyle}" Content="{DynamicResource CustomTimePreset15}" />

            <Button Canvas.Left="16"
                    Canvas.Top="314"
                    Width="130"
                    AutomationProperties.Name="{DynamicResource CustomTimeCancel}"
                    Command="{Binding CancelCommand}"
                    Content="{DynamicResource CustomTimeCancel}"
                    Style="{StaticResource CustomTimeFooterButtonStyle}" />
            <Button Canvas.Left="155"
                    Canvas.Top="314"
                    Width="129"
                    AutomationProperties.Name="{DynamicResource CustomTimeConfirm}"
                    Command="{Binding ConfirmCommand}"
                    Content="{DynamicResource CustomTimeConfirm}"
                    Style="{StaticResource CustomTimePrimaryButtonStyle}" />
        </Canvas>
    </Border>
</UserControl>
