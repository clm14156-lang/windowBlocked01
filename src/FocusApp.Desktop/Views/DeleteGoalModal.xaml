<UserControl x:Class="FocusApp.Desktop.Views.DeleteGoalModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource FontFamilyPrimary}" UseLayoutRounding="True" SnapsToDevicePixels="True"
             Focusable="True" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="Modal_PreviewKeyDown" IsVisibleChanged="Modal_IsVisibleChanged">
    <UserControl.Style><Style TargetType="UserControl"><Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers><DataTrigger Binding="{Binding IsOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
    </Style></UserControl.Style>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="HasErrorVisibility"/>
        <Style x:Key="DeleteGoalAction" TargetType="Button">
            <Setter Property="Height" Value="36"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#243248"/><Setter Property="Background" Value="#F7F8FA"/>
            <Setter Property="BorderBrush" Value="#E7EAF0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ActionSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                    <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                               FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionSurface" Property="Opacity" Value="0.9"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ActionSurface" Property="Opacity" Value="0.75"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ActionSurface" Property="BorderBrush" Value="#CBD4E0"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ActionSurface" Property="Opacity" Value="0.5"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="Overlay" Background="{DynamicResource ModalScrim}" MouseLeftButtonDown="Overlay_MouseLeftButtonDown">
        <Border x:Name="ModalSurface" Width="350" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="White" BorderBrush="#E5E8EE" BorderThickness="1" CornerRadius="14">
            <Border.Effect><DropShadowEffect Color="#344155" BlurRadius="22" ShadowDepth="4" Opacity="0.12"/></Border.Effect>
            <Grid Margin="18,20,18,16">
                <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="16"/><RowDefinition Height="24"/><RowDefinition Height="8"/><RowDefinition Height="57"/><RowDefinition/><RowDefinition Height="36"/></Grid.RowDefinitions>
                <Border Width="56" Height="56" Background="#FFF0F0" CornerRadius="28" HorizontalAlignment="Center">
                    <Path Width="24" Height="26" Stretch="Uniform" Data="M3,6 L21,6 M8,6 L8,2 L16,2 L16,6 M5,6 L5,23 Q5,24 6,24 L18,24 Q19,24 19,23 L19,6 M9,10 L9,20 M15,10 L15,20"
                          Stroke="#EF5658" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Row="2" Text="删除目标？" FontSize="18" FontWeight="SemiBold" Foreground="#162438" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="DeletionWarning" Grid.Row="4" Text="删除后，该目标的所有数据将被永久删除，包括专注&#x0A;记录、累计投入、完成任务数、专注天数及相关任务。&#x0A;此操作不可恢复。"
                           FontSize="12" FontWeight="Normal" Foreground="#738094" TextAlignment="Center" TextWrapping="Wrap" LineHeight="19"/>
                <TextBlock Grid.Row="5" Text="{Binding ErrorMessage}" Visibility="{Binding HasError, Converter={StaticResource HasErrorVisibility}}"
                           FontSize="11" Foreground="#DE4A50" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ErrorMessage}" VerticalAlignment="Center"/>
                <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button x:Name="CancelButton" Content="取消" Style="{StaticResource DeleteGoalAction}" Command="{Binding CancelCommand}"/>
                    <Button x:Name="ConfirmDeleteButton" Grid.Column="2" Content="{Binding ConfirmButtonText}" Style="{StaticResource DeleteGoalAction}"
                            Background="#EF4F54" BorderThickness="0" Foreground="White" Command="{Binding ConfirmCommand}" AutomationProperties.Name="确认永久删除目标"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
