<UserControl x:Class="FocusApp.Desktop.Views.FocusDaysDetailsModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource FontFamilyPrimary}" FontSize="{DynamicResource BodyFontSize}"
             Foreground="{DynamicResource StatisticsBodyBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True"
             Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
             PreviewKeyDown="Modal_PreviewKeyDown" IsVisibleChanged="Modal_IsVisibleChanged">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsFocusDaysDetailsOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles.xaml"/>
                <ResourceDictionary Source="../Resources/StatisticsTypography.xaml"/>
                <ResourceDictionary Source="../Resources/StatisticsScrollStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
            <SolidColorBrush x:Key="CheckInAccent" Color="#FD7E05"/>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource StatisticsThinScrollBarStyle}"/>
            <Style x:Key="SummaryCard" TargetType="Border">
                <Setter Property="Background" Value="#F6F7F9"/><Setter Property="BorderBrush" Value="#F0F2F5"/>
                <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="10,8"/>
            </Style>
            <Style x:Key="SummaryLabel" TargetType="TextBlock" BasedOn="{StaticResource StatisticsMetricLabelStyle}"/>
            <Style x:Key="DayCircle" TargetType="Border">
                <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/>
                <Setter Property="CornerRadius" Value="14"/><Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Background" Value="#F2F3F5"/><Setter Property="BorderBrush" Value="#DFE4EB"/><Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasFocus}" Value="True"><Setter Property="Background" Value="#FFF0E2"/><Setter Property="BorderBrush" Value="#FFE2C6"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Background" Value="{StaticResource CheckInAccent}"/><Setter Property="BorderBrush" Value="{StaticResource CheckInAccent}"/></DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="WeekDate" TargetType="TextBlock" BasedOn="{StaticResource StatisticsAuxiliaryTextStyle}">
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyEnglish}"/><Setter Property="Foreground" Value="{DynamicResource StatisticsSecondaryBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Height" Value="18"/>
                <Style.Triggers><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Foreground" Value="{StaticResource CheckInAccent}"/></DataTrigger></Style.Triggers>
            </Style>
            <Style x:Key="MonthDayCircle" TargetType="Border" BasedOn="{StaticResource DayCircle}">
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers><DataTrigger Binding="{Binding IsInPeriod}" Value="False"><Setter Property="Background" Value="Transparent"/></DataTrigger></Style.Triggers>
            </Style>
            <Style x:Key="MonthDayText" TargetType="TextBlock" BasedOn="{StaticResource StatisticsBodyTextStyle}">
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyEnglish}"/>
                <Setter Property="Foreground" Value="#98A2B3"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasFocus}" Value="True"><Setter Property="Foreground" Value="{StaticResource CheckInAccent}"/><Setter Property="FontWeight" Value="Medium"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsInPeriod}" Value="False"><Setter Property="Foreground" Value="#BEC5CF"/><Setter Property="FontWeight" Value="Normal"/></DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="MonthProgress" TargetType="ProgressBar">
                <Setter Property="Height" Value="5"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="1"/>
                <Setter Property="Background" Value="#E7EAF0"/><Setter Property="Foreground" Value="{StaticResource CheckInAccent}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="PART_Track" ClipToBounds="True">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2.5"/>
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2.5"/>
                    </Grid>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="Overlay" Background="{DynamicResource ModalScrim}" MouseLeftButtonDown="Overlay_MouseLeftButtonDown">
        <Border x:Name="ModalSurface" Width="350" MaxWidth="350" MaxHeight="450" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="White" BorderBrush="#E9EDF3" BorderThickness="1" CornerRadius="14">
            <Border.Effect><DropShadowEffect Color="#526078" BlurRadius="18" ShadowDepth="3" Opacity="0.08"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel>
                    <Grid Height="26">
                        <TextBlock x:Name="ModalTitle" Text="专注天数" Style="{StaticResource StatisticsPageTitleTextStyle}" VerticalAlignment="Center"/>
                        <Button x:Name="CloseButton" Width="26" Height="26" Margin="0" HorizontalAlignment="Right" Command="{Binding CloseFocusDaysDetailsCommand}"
                                Style="{StaticResource ModalCloseButtonStyle}" AutomationProperties.Name="关闭专注天数详情"/>
                    </Grid>
                    <TextBlock x:Name="PeriodLabel" Text="{Binding DateRangeDisplay}" Margin="0,4,0,0" Height="18" FontSize="13" FontWeight="Medium"
                               FontFamily="{DynamicResource FontFamilyEnglish}" Foreground="{DynamicResource StatisticsSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DateRangeDisplay}"/>
                </StackPanel>
                <Grid x:Name="SummaryCards" Grid.Row="1" Height="76" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border x:Name="FocusDaysSummary" Style="{StaticResource SummaryCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="专注天数" Style="{StaticResource SummaryLabel}"/>
                        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock><Run Text="{Binding FocusDayCount, Mode=OneWay}" Style="{StaticResource StatisticsValueRunStyle}"/><Run Text=" 天" Style="{StaticResource StatisticsUnitRunStyle}"/></TextBlock></Viewbox>
                    </Grid></Border>
                    <Border x:Name="StreakSummary" Grid.Column="2" Style="{StaticResource SummaryCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="最长连续" Style="{StaticResource SummaryLabel}"/>
                        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock><Run Text="{Binding LongestFocusStreak, Mode=OneWay}" Style="{StaticResource StatisticsValueRunStyle}"/><Run Text=" 天" Style="{StaticResource StatisticsUnitRunStyle}"/></TextBlock></Viewbox>
                    </Grid></Border>
                    <Border x:Name="HoursSummary" Grid.Column="4" Style="{StaticResource SummaryCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="专注时长" Style="{StaticResource SummaryLabel}"/>
                        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock><Run Text="{Binding FocusDaysHoursDisplay, Mode=OneWay}" Style="{StaticResource StatisticsValueRunStyle}"/><Run Text=" 小时" Style="{StaticResource StatisticsUnitRunStyle}"/></TextBlock></Viewbox>
                    </Grid></Border>
                </Grid>
                <Border Grid.Row="2" Height="1" Background="#EDF0F4" Margin="0,16,0,14"/>
                <TextBlock x:Name="SectionTitle" Grid.Row="3" Text="{Binding FocusDaysSectionTitle}" Style="{StaticResource StatisticsHeadingTextStyle}" Height="20" Margin="0,0,0,12"/>
                <ScrollViewer x:Name="ContentScroll" Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="209">
                    <Grid>
                        <ItemsControl x:Name="WeekCheckIns" ItemsSource="{Binding FocusWeekDays}" Visibility="{Binding IsWeek, Converter={StaticResource VisibleWhenTrue}}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <StackPanel AutomationProperties.Name="{Binding AccessibleLabel}">
                                    <TextBlock Text="{Binding WeekdayLabel}" Style="{StaticResource WeekDate}"/>
                                    <Border Style="{StaticResource DayCircle}" Margin="0,10,0,0">
                                        <Path Data="M 1,6 L 5,10 L 12,2" Width="12" Height="10" Stretch="Uniform" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasFocus, Converter={StaticResource VisibleWhenTrue}}">
                                            <Path.Style><Style TargetType="Path"><Setter Property="Stroke" Value="{StaticResource CheckInAccent}"/><Style.Triggers><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Stroke" Value="White"/></DataTrigger></Style.Triggers></Style></Path.Style>
                                        </Path>
                                    </Border>
                                    <TextBlock Text="{Binding ShortDate}" Style="{StaticResource WeekDate}" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding TodayLabel}" Style="{StaticResource WeekDate}"/>
                                </StackPanel>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel x:Name="MonthCheckIns" Visibility="{Binding IsMonth, Converter={StaticResource VisibleWhenTrue}}">
                            <ItemsControl ItemsSource="{Binding FocusWeekdayLabels}" Margin="1,0,1,6">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Height="18" FontSize="12" Foreground="{DynamicResource StatisticsSecondaryBrush}" HorizontalAlignment="Center"/></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Background="#FCFCFD" BorderBrush="#EFF1F5" BorderThickness="1" CornerRadius="8">
                                <ItemsControl x:Name="MonthDays" ItemsSource="{Binding FocusMonthDays}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Grid Height="30" AutomationProperties.Name="{Binding AccessibleLabel}"><Border Style="{StaticResource MonthDayCircle}" VerticalAlignment="Center"><TextBlock Text="{Binding DayNumber}" Style="{StaticResource MonthDayText}"/></Border></Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                        <ItemsControl x:Name="YearCheckIns" ItemsSource="{Binding FocusYearMonths}" Margin="-3,0" Visibility="{Binding IsYear, Converter={StaticResource VisibleWhenTrue}}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Height="46" Margin="3" Padding="8,6" Background="#FCFCFD" BorderBrush="#EDEFF4" BorderThickness="1" CornerRadius="7">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition/></Grid.RowDefinitions>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource StatisticsSecondaryBrush}"/>
                                            <TextBlock Grid.Column="1"><Run Text="{Binding FocusDays, Mode=OneWay}" FontFamily="{DynamicResource FontFamilyEnglish}"/><Run Text=" 天" FontSize="12" Foreground="{DynamicResource StatisticsSecondaryBrush}"/></TextBlock>
                                        </Grid>
                                        <ProgressBar Grid.Row="1" Value="{Binding Ratio, Mode=OneWay}" Style="{StaticResource MonthProgress}" VerticalAlignment="Bottom" AutomationProperties.Name="{Binding Label}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
