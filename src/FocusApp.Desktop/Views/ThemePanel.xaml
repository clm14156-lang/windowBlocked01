<UserControl x:Class="FocusApp.Desktop.Views.ThemePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             Width="420"
             Background="Transparent"
             TextElement.FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Style>
        <Style TargetType="{x:Type UserControl}">
            <Setter Property="Height" Value="510" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanUsePremiumThemes}" Value="True">
                    <Setter Property="Height" Value="450" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.Resources>
        <views:ThemeKeyEqualityConverter x:Key="ThemeKeyEqualityConverter" />
        <views:ThemeLockVisibilityConverter x:Key="ThemeLockVisibilityConverter" />
        <views:ThemePreviewVisualVisibilityConverter x:Key="ThemePreviewVisualVisibilityConverter" />
        <SolidColorBrush x:Key="ThemeOrangeBrush" Color="#FF8500" />
        <SolidColorBrush x:Key="ThemeBlueBrush" Color="#3989EF" />
        <SolidColorBrush x:Key="ThemeCyanBrush" Color="#39C4CC" />
        <SolidColorBrush x:Key="ThemeOrangeHoverBrush" Color="#FF8500" />
        <SolidColorBrush x:Key="ThemeBlueHoverBrush" Color="#3989EF" />
        <SolidColorBrush x:Key="ThemeCyanHoverBrush" Color="#39C4CC" />
        <SolidColorBrush x:Key="ThemeDarkHoverBrush" Color="#2A2A2A" />
        <SolidColorBrush x:Key="ThemeWarmHoverBrush" Color="#FF7578" />
        <SolidColorBrush x:Key="ThemeSkyHoverBrush" Color="#4A93EF" />
        <SolidColorBrush x:Key="ThemeDreamHoverBrush" Color="#8659E8" />
        <SolidColorBrush x:Key="ThemeFreshHoverBrush" Color="#35BDA8" />
        <SolidColorBrush x:Key="ThemeStarryHoverBrush" Color="#30206E" />
        <SolidColorBrush x:Key="ThemeMountainHoverBrush" Color="#A66C52" />
        <SolidColorBrush x:Key="ThemeForestHoverBrush" Color="#347154" />
        <SolidColorBrush x:Key="ThemeSnowHoverBrush" Color="#62A9D8" />
        <LinearGradientBrush x:Key="ThemeDarkBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#353535" />
            <GradientStop Offset="1" Color="#161616" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ThemeWarmBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#FF6176" />
            <GradientStop Offset="1" Color="#FFE0AB" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ThemeSkyBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#2E82F4" />
            <GradientStop Offset="1" Color="#B8E2FF" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ThemeDreamBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#6F50F0" />
            <GradientStop Offset="1" Color="#EDB8F2" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ThemeFreshBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#29C2CA" />
            <GradientStop Offset="1" Color="#CFF8C3" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="ThemeStarryBrush" Center="0.67,0.28" GradientOrigin="0.67,0.28" RadiusX="0.7" RadiusY="0.7">
            <GradientStop Offset="0" Color="#704FC1" />
            <GradientStop Offset="0.36" Color="#24175F" />
            <GradientStop Offset="1" Color="#061443" />
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="ThemeMountainBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#C49ABB" />
            <GradientStop Offset="0.62" Color="#E9A078" />
            <GradientStop Offset="1" Color="#65423F" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ThemeForestBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#B5CDC5" />
            <GradientStop Offset="0.48" Color="#4B806B" />
            <GradientStop Offset="1" Color="#154C31" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ThemeSnowBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#4DABE8" />
            <GradientStop Offset="0.64" Color="#D7F1FA" />
            <GradientStop Offset="1" Color="#668AAE" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="ThemeMoonBrush" Center="0.55,0.24" GradientOrigin="0.55,0.24" RadiusX="0.65" RadiusY="0.65">
            <GradientStop Offset="0" Color="#7AB0E0" />
            <GradientStop Offset="0.45" Color="#1C568B" />
            <GradientStop Offset="1" Color="#052D58" />
        </RadialGradientBrush>

        <Style x:Key="ThemeOptionStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Width" Value="97.5" />
            <Setter Property="Height" Value="102" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid Width="97.5" Height="102" ClipToBounds="False">
                            <Grid x:Name="ThumbnailFrame"
                                  Width="75"
                                  Height="75"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Top"
                                  ClipToBounds="False"
                                  UseLayoutRounding="False"
                                  SnapsToDevicePixels="False">
                                <Grid x:Name="ThumbnailClip"
                                      Width="64.5"
                                      Height="66.75"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      ClipToBounds="True">
                                    <Grid.Clip>
                                        <RectangleGeometry Rect="0,0,64.5,66.75" RadiusX="10.5" RadiusY="10.5" />
                                    </Grid.Clip>
                                    <Border x:Name="ThemeThumbnail"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="10.5" />
                                    <Border x:Name="ThumbnailHoverBorder"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="10.5"
                                            IsHitTestVisible="False"
                                            Visibility="Collapsed" />
                                    <Button x:Name="PreviewThemeButton"
                                            Width="45"
                                            Height="23.25"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#80000000"
                                            BorderBrush="{DynamicResource WhiteText}"
                                            BorderThickness="1"
                                            Command="{Binding DataContext.PreviewThemeCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding CommandParameter, RelativeSource={RelativeSource TemplatedParent}}"
                                            Cursor="Hand"
                                            FocusVisualStyle="{x:Null}"
                                            Foreground="{DynamicResource WhiteText}">
                                        <Button.Visibility>
                                            <MultiBinding Converter="{StaticResource ThemePreviewVisualVisibilityConverter}" ConverterParameter="PreviewButton">
                                                <Binding Path="DataContext.CanUsePremiumThemes" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding Path="CommandParameter" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding ElementName="ThumbnailClip" Path="IsMouseOver" />
                                                <Binding Path="DataContext.PreviewThemeKey" RelativeSource="{RelativeSource TemplatedParent}" />
                                            </MultiBinding>
                                        </Button.Visibility>
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border x:Name="PreviewButtonBackground"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="{TemplateBinding Foreground}" Text="预览" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PreviewButtonBackground" Property="Background" Value="#A6000000" /></Trigger>
                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="PreviewButtonBackground" Property="Opacity" Value="0.76" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Border x:Name="PreviewingBadge"
                                            Height="20.25"
                                            Margin="4.5,0,4.5,4.5"
                                            VerticalAlignment="Bottom"
                                            Background="#B3FFFFFF"
                                            CornerRadius="5.25">
                                        <Border.Visibility>
                                            <MultiBinding Converter="{StaticResource ThemePreviewVisualVisibilityConverter}" ConverterParameter="Previewing">
                                                <Binding Path="DataContext.CanUsePremiumThemes" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding Path="CommandParameter" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding ElementName="ThumbnailClip" Path="IsMouseOver" />
                                                <Binding Path="DataContext.PreviewThemeKey" RelativeSource="{RelativeSource TemplatedParent}" />
                                            </MultiBinding>
                                        </Border.Visibility>
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource AccentPrimary}" Text="预览中" />
                                    </Border>
                                    <Border x:Name="LockBadge"
                                            Width="23.25"
                                            Height="23.25"
                                            Margin="0,3,3,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="#66000000"
                                            CornerRadius="7.5">
                                        <Border.Visibility>
                                            <MultiBinding Converter="{StaticResource ThemeLockVisibilityConverter}">
                                                <Binding Path="DataContext.CanUsePremiumThemes" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding Path="CommandParameter" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding ElementName="ThumbnailClip" Path="IsMouseOver" />
                                                <Binding Path="DataContext.PreviewThemeKey" RelativeSource="{RelativeSource TemplatedParent}" />
                                            </MultiBinding>
                                        </Border.Visibility>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11.25"
                                                   Foreground="{DynamicResource WhiteText}"
                                                   Text="&#xE72E;" />
                                    </Border>
                                </Grid>
                                <Border x:Name="SelectionBorder"
                                        BorderBrush="Transparent"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="12.75"
                                        IsHitTestVisible="False" />
                                <Border x:Name="PreviewSelectionBorder"
                                        BorderBrush="{DynamicResource AccentPrimary}"
                                        BorderThickness="2"
                                        CornerRadius="12.75"
                                        IsHitTestVisible="False">
                                    <Border.Visibility>
                                        <MultiBinding Converter="{StaticResource ThemePreviewVisualVisibilityConverter}" ConverterParameter="Previewing">
                                            <Binding Path="DataContext.CanUsePremiumThemes" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="CommandParameter" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding ElementName="ThumbnailClip" Path="IsMouseOver" />
                                            <Binding Path="DataContext.PreviewThemeKey" RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </Border.Visibility>
                                </Border>
                            </Grid>
                            <Grid x:Name="CheckBadgeLayer"
                                  Width="87"
                                  Height="75"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Top"
                                  ClipToBounds="False"
                                  IsHitTestVisible="False">
                                <Border x:Name="CheckBadge"
                                        Width="21.75"
                                        Height="21.75"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource AccentPrimary}"
                                        BorderBrush="{DynamicResource SurfacePrimary}"
                                        BorderThickness="2.25"
                                        CornerRadius="11.25"
                                        Visibility="Collapsed">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource WhiteText}"
                                               Text="&#xE73E;" />
                                </Border>
                            </Grid>
                            <TextBlock Margin="0,78,0,0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding Tag}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbnailHoverBorder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                <Setter TargetName="CheckBadge" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <DataTrigger Binding="{Binding DataContext.IsThemePreviewing, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="CheckBadge" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemePersonalOptionStyle"
               TargetType="{x:Type RadioButton}"
               BasedOn="{StaticResource ThemeOptionStyle}" />

        <Style x:Key="ThemePremiumOptionStyle"
               TargetType="{x:Type RadioButton}"
               BasedOn="{StaticResource ThemeOptionStyle}">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="PremiumThemeOption_PreviewMouseLeftButtonDown" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanUsePremiumThemes}" Value="False">
                    <Setter Property="Focusable" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Width="420"
                Background="{DynamicResource SurfacePrimary}"
                BorderBrush="{DynamicResource OverlayBorder}"
                BorderThickness="1"
                CornerRadius="13.5">
        <Border.Style>
            <Style TargetType="{x:Type Border}">
                <Setter Property="Height" Value="510" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CanUsePremiumThemes}" Value="True">
                        <Setter Property="Height" Value="450" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.Effect>
            <DropShadowEffect BlurRadius="15"
                              Direction="270"
                              Opacity="0.12"
                              ShadowDepth="3.75" />
        </Border.Effect>
        <Canvas>
            <TextBlock Canvas.Left="23.25"
                       Canvas.Top="21.75"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Text="{DynamicResource ThemePanelTitle}" />
            <StackPanel Canvas.Left="13.5" Canvas.Top="64.5" Orientation="Horizontal">
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeOrange}" Background="{StaticResource ThemeOrangeBrush}" BorderBrush="{StaticResource ThemeOrangeHoverBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Orange" IsChecked="{Binding VisualSelectedThemeKey, Converter={StaticResource ThemeKeyEqualityConverter}, ConverterParameter=Orange, Mode=OneWay}" Style="{StaticResource ThemeOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeBlue}" Background="{StaticResource ThemeBlueBrush}" BorderBrush="{StaticResource ThemeBlueHoverBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Blue" IsChecked="{Binding VisualSelectedThemeKey, Converter={StaticResource ThemeKeyEqualityConverter}, ConverterParameter=Blue, Mode=OneWay}" Style="{StaticResource ThemeOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeCyan}" Background="{StaticResource ThemeCyanBrush}" BorderBrush="{StaticResource ThemeCyanHoverBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Cyan" IsChecked="{Binding VisualSelectedThemeKey, Converter={StaticResource ThemeKeyEqualityConverter}, ConverterParameter=Cyan, Mode=OneWay}" Style="{StaticResource ThemeOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeDark}" Background="{StaticResource ThemeDarkBrush}" BorderBrush="{StaticResource ThemeDarkHoverBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Dark" IsChecked="{Binding VisualSelectedThemeKey, Converter={StaticResource ThemeKeyEqualityConverter}, ConverterParameter=Dark, Mode=OneWay}" Style="{StaticResource ThemeOptionStyle}" />
            </StackPanel>
            <Border Canvas.Left="18" Canvas.Top="175.5" Width="384" Height="1" Background="{DynamicResource BorderPrimary}" Opacity="0.7" />

            <StackPanel Canvas.Left="13.5" Canvas.Top="194.25" Orientation="Horizontal">
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeWarm}" Background="{StaticResource ThemeWarmBrush}" BorderBrush="{StaticResource ThemeWarmHoverBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Warm" IsChecked="{Binding VisualSelectedThemeKey, Converter={StaticResource ThemeKeyEqualityConverter}, ConverterParameter=Warm, Mode=OneWay}" Style="{StaticResource ThemePremiumOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeSky}" Background="{StaticResource ThemeSkyBrush}" BorderBrush="{StaticResource ThemeSkyHoverBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Sky" IsChecked="{Binding VisualSelectedThemeKey, Converter={StaticResource ThemeKeyEqualityConverter}, ConverterParameter=Sky, Mode=OneWay}" Style="{StaticResource ThemePremiumOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeDream}" Background="{StaticResource ThemeDreamBrush}" BorderBrush="{StaticResource ThemeDreamHoverBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Dream" IsChecked="{Binding VisualSelectedThemeKey, Converter={StaticResource ThemeKeyEqualityConverter}, ConverterParameter=Dream, Mode=OneWay}" Style="{StaticResource ThemePremiumOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeFresh}" Background="{StaticResource ThemeFreshBrush}" BorderBrush="{StaticResource ThemeFreshHoverBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Fresh" IsChecked="{Binding VisualSelectedThemeKey, Converter={StaticResource ThemeKeyEqualityConverter}, ConverterParameter=Fresh, Mode=OneWay}" Style="{StaticResource ThemePremiumOptionStyle}" />
            </StackPanel>
            <Border Canvas.Left="18" Canvas.Top="308.25" Width="384" Height="1" Background="{DynamicResource BorderPrimary}" Opacity="0.7" />

            <StackPanel Canvas.Left="13.5" Canvas.Top="329.25" Orientation="Horizontal">
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeStarry}" Background="{StaticResource ThemeStarryBrush}" BorderBrush="{StaticResource ThemeStarryHoverBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Starry" IsChecked="{Binding VisualSelectedThemeKey, Converter={StaticResource ThemeKeyEqualityConverter}, ConverterParameter=Starry, Mode=OneWay}" Style="{StaticResource ThemePremiumOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeMountain}" Background="{StaticResource ThemeMountainBrush}" BorderBrush="{StaticResource ThemeMountainHoverBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Mountain" IsChecked="{Binding VisualSelectedThemeKey, Converter={StaticResource ThemeKeyEqualityConverter}, ConverterParameter=Mountain, Mode=OneWay}" Style="{StaticResource ThemePremiumOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeForest}" Background="{StaticResource ThemeForestBrush}" BorderBrush="{StaticResource ThemeForestHoverBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Forest" IsChecked="{Binding VisualSelectedThemeKey, Converter={StaticResource ThemeKeyEqualityConverter}, ConverterParameter=Forest, Mode=OneWay}" Style="{StaticResource ThemePremiumOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeSnow}" Background="{StaticResource ThemeSnowBrush}" BorderBrush="{StaticResource ThemeSnowHoverBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Snow" IsChecked="{Binding VisualSelectedThemeKey, Converter={StaticResource ThemeKeyEqualityConverter}, ConverterParameter=Snow, Mode=OneWay}" Style="{StaticResource ThemePremiumOptionStyle}" />
            </StackPanel>
            <Border x:Name="ThemePreviewStatusDivider"
                    Canvas.Left="18"
                    Canvas.Top="444.75"
                    Width="384"
                    Height="1"
                    Background="{DynamicResource BorderPrimary}"
                    Opacity="0.7">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding CanUsePremiumThemes}" Value="False" />
                                    <Condition Binding="{Binding IsThemePreviewing}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <Button x:Name="ThemeVipUnlockButton"
                    Canvas.Left="18"
                    Canvas.Top="455.25"
                    Width="384"
                    Height="40.5"
                    Background="{DynamicResource SurfaceSecondary}"
                    BorderBrush="{DynamicResource BorderPrimary}"
                    BorderThickness="1"
                    Command="{Binding OpenVipCommand}"
                    Cursor="Hand"
                    FocusVisualStyle="{x:Null}">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding CanUsePremiumThemes}" Value="False" />
                                    <Condition Binding="{Binding IsThemePreviewing}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="UnlockBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <Grid Margin="15,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="21" /><ColumnDefinition /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                                <Viewbox Width="16.5" Height="14.25" HorizontalAlignment="Left">
                                    <Path Data="M 2,6 L 8,13 L 14,4 L 20,13 L 26,6 L 23,22 L 5,22 Z M 5,18 L 23,18" Fill="{DynamicResource TransparentBrush}" Stroke="{DynamicResource AccentPrimary}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="2" />
                                </Viewbox>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextPrimary}">
                                    <Run Text="{DynamicResource ThemePanelVipUnlockPrefix}" /><Run FontWeight="Medium" Foreground="{DynamicResource AccentPrimary}" Text="{DynamicResource ThemePanelVipUnlockLabel}" /><Run Text="{DynamicResource ThemePanelVipUnlockSuffix}" />
                                </TextBlock>
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="11.25" Foreground="{DynamicResource TextSecondary}" Text="&#xE76C;" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="UnlockBackground" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="UnlockBackground" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border x:Name="ThemePreviewStatusBar"
                    Canvas.Left="18"
                    Canvas.Top="455.25"
                    Width="384"
                    Height="40.5"
                    Background="{DynamicResource TransparentBrush}"
                    BorderThickness="0">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding CanUsePremiumThemes}" Value="False" />
                                    <Condition Binding="{Binding IsThemePreviewing}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="6,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="97" /><ColumnDefinition Width="125.5" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{Binding PreviewStatusDisplay}" />
                        <TextBlock Margin="0,3,0,0" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource ThemePanelPreviewHint}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="89.5"
                            Height="37"
                            Margin="3,0,4.5,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SurfacePrimary}"
                            BorderBrush="{DynamicResource BorderPrimary}"
                            BorderThickness="1"
                            Command="{Binding RestoreOriginalThemeCommand}"
                            Cursor="Hand"
                            FontSize="13"
                            FontWeight="Medium"
                            Foreground="{DynamicResource TextPrimary}"
                            Content="{DynamicResource ThemePanelRestoreOriginal}">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="RestoreBackground" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6.75">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RestoreBackground" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="RestoreBackground" Property="Opacity" Value="0.76" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="2"
                            Width="125.5"
                            Height="37"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentPrimary}"
                            BorderThickness="0"
                            Command="{Binding OpenVipCommand}"
                            ContentTemplate="{StaticResource ThemedButtonTextContentTemplate}"
                            Cursor="Hand"
                            FontSize="13"
                            FontWeight="Medium"
                            Foreground="{DynamicResource WhiteText}"
                            Content="{DynamicResource ThemePanelUpgradeAndApply}">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="UpgradeBackground" Background="{TemplateBinding Background}" CornerRadius="6.75">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="UpgradeBackground" Property="Opacity" Value="0.9" /></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="UpgradeBackground" Property="Opacity" Value="0.76" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Canvas>
    </Border>
</UserControl>
