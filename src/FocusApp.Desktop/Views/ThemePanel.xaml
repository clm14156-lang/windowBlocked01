<UserControl x:Class="FocusApp.Desktop.Views.ThemePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             Width="420"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Style>
        <Style TargetType="{x:Type UserControl}">
            <Setter Property="Height" Value="510" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanUsePremiumThemes}" Value="True">
                    <Setter Property="Height" Value="450" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.Resources>
        <views:ThemeKeyEqualityConverter x:Key="ThemeKeyEqualityConverter" />
        <views:ThemeLockVisibilityConverter x:Key="ThemeLockVisibilityConverter" />
        <SolidColorBrush x:Key="ThemeOrangeBrush" Color="#FF8500" />
        <SolidColorBrush x:Key="ThemeBlueBrush" Color="#3989EF" />
        <SolidColorBrush x:Key="ThemeCyanBrush" Color="#39C4CC" />
        <LinearGradientBrush x:Key="ThemeDarkBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#353535" />
            <GradientStop Offset="1" Color="#161616" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ThemeWarmBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#FF6176" />
            <GradientStop Offset="1" Color="#FFE0AB" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ThemeSkyBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#2E82F4" />
            <GradientStop Offset="1" Color="#B8E2FF" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ThemeDreamBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#6F50F0" />
            <GradientStop Offset="1" Color="#EDB8F2" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ThemeFreshBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#29C2CA" />
            <GradientStop Offset="1" Color="#CFF8C3" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="ThemeStarryBrush" Center="0.67,0.28" GradientOrigin="0.67,0.28" RadiusX="0.7" RadiusY="0.7">
            <GradientStop Offset="0" Color="#704FC1" />
            <GradientStop Offset="0.36" Color="#24175F" />
            <GradientStop Offset="1" Color="#061443" />
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="ThemeMountainBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#C49ABB" />
            <GradientStop Offset="0.62" Color="#E9A078" />
            <GradientStop Offset="1" Color="#65423F" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ThemeForestBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#B5CDC5" />
            <GradientStop Offset="0.48" Color="#4B806B" />
            <GradientStop Offset="1" Color="#154C31" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ThemeSnowBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#4DABE8" />
            <GradientStop Offset="0.64" Color="#D7F1FA" />
            <GradientStop Offset="1" Color="#668AAE" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="ThemeMoonBrush" Center="0.55,0.24" GradientOrigin="0.55,0.24" RadiusX="0.65" RadiusY="0.65">
            <GradientStop Offset="0" Color="#7AB0E0" />
            <GradientStop Offset="0.45" Color="#1C568B" />
            <GradientStop Offset="1" Color="#052D58" />
        </RadialGradientBrush>

        <Style x:Key="ThemeOptionStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Width" Value="130" />
            <Setter Property="Height" Value="136" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid Width="130" Height="136">
                            <Border x:Name="SelectionBorder"
                                    Width="100"
                                    Height="100"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Padding="5,2,5,5"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="17">
                                <Grid x:Name="ThumbnailClip" ClipToBounds="True">
                                    <Grid.Clip>
                                        <RectangleGeometry Rect="0,0,86,89" RadiusX="14" RadiusY="14" />
                                    </Grid.Clip>
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="14" />
                                    <Border x:Name="LockBadge"
                                            Width="31"
                                            Height="31"
                                            Margin="0,4,4,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="#66000000"
                                            CornerRadius="10">
                                        <Border.Visibility>
                                            <MultiBinding Converter="{StaticResource ThemeLockVisibilityConverter}">
                                                <Binding Path="DataContext.CanUsePremiumThemes" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding Path="CommandParameter" RelativeSource="{RelativeSource TemplatedParent}" />
                                            </MultiBinding>
                                        </Border.Visibility>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource WhiteText}"
                                                   Text="&#xE72E;" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Border x:Name="CheckBadge"
                                    Width="29"
                                    Height="29"
                                    Margin="0,-5,7,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource AccentPrimary}"
                                    BorderBrush="{DynamicResource SurfacePrimary}"
                                    BorderThickness="3"
                                    CornerRadius="15"
                                    Visibility="Collapsed">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{DynamicResource WhiteText}"
                                           Text="&#xE73E;" />
                            </Border>
                            <TextBlock Margin="0,104,0,0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding Tag}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                <Setter TargetName="CheckBadge" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemePersonalOptionStyle"
               TargetType="{x:Type RadioButton}"
               BasedOn="{StaticResource ThemeOptionStyle}" />

        <Style x:Key="ThemePremiumOptionStyle"
               TargetType="{x:Type RadioButton}"
               BasedOn="{StaticResource ThemeOptionStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanUsePremiumThemes}" Value="False">
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <Setter Property="Focusable" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Viewbox Width="420" Stretch="Uniform">
        <Viewbox.Style>
            <Style TargetType="{x:Type Viewbox}">
                <Setter Property="Height" Value="510" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CanUsePremiumThemes}" Value="True">
                        <Setter Property="Height" Value="450" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Viewbox.Style>
        <Border Width="560"
                Background="{DynamicResource SurfacePrimary}"
                BorderBrush="{DynamicResource OverlayBorder}"
                BorderThickness="1"
                CornerRadius="18">
        <Border.Style>
            <Style TargetType="{x:Type Border}">
                <Setter Property="Height" Value="680" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CanUsePremiumThemes}" Value="True">
                        <Setter Property="Height" Value="600" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              Direction="270"
                              Opacity="0.12"
                              ShadowDepth="5" />
        </Border.Effect>
        <Canvas>
            <TextBlock Canvas.Left="31"
                       Canvas.Top="29"
                       FontSize="28"
                       FontWeight="Bold"
                       Text="{DynamicResource ThemePanelTitle}" />
            <StackPanel Canvas.Left="18" Canvas.Top="86" Orientation="Horizontal">
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeOrange}" Background="{StaticResource ThemeOrangeBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Orange" IsChecked="{Binding SelectedThemeKey, Converter={StaticResource ThemeKeyEqualityConverter}, ConverterParameter=Orange, Mode=OneWay}" Style="{StaticResource ThemeOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeBlue}" Background="{StaticResource ThemeBlueBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Blue" IsChecked="{Binding SelectedThemeKey, Converter={StaticResource ThemeKeyEqualityConverter}, ConverterParameter=Blue, Mode=OneWay}" Style="{StaticResource ThemeOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeCyan}" Background="{StaticResource ThemeCyanBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Cyan" IsChecked="{Binding SelectedThemeKey, Converter={StaticResource ThemeKeyEqualityConverter}, ConverterParameter=Cyan, Mode=OneWay}" Style="{StaticResource ThemeOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeDark}" Background="{StaticResource ThemeDarkBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Dark" IsChecked="{Binding SelectedThemeKey, Converter={StaticResource ThemeKeyEqualityConverter}, ConverterParameter=Dark, Mode=OneWay}" Style="{StaticResource ThemeOptionStyle}" />
            </StackPanel>
            <Border Canvas.Left="24" Canvas.Top="234" Width="512" Height="1" Background="{DynamicResource BorderPrimary}" Opacity="0.7" />

            <StackPanel Canvas.Left="18" Canvas.Top="259" Orientation="Horizontal">
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeWarm}" Background="{StaticResource ThemeWarmBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Warm" IsChecked="{Binding SelectedThemeKey, Converter={StaticResource ThemeKeyEqualityConverter}, ConverterParameter=Warm, Mode=OneWay}" Style="{StaticResource ThemePremiumOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeSky}" Background="{StaticResource ThemeSkyBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Sky" IsChecked="{Binding SelectedThemeKey, Converter={StaticResource ThemeKeyEqualityConverter}, ConverterParameter=Sky, Mode=OneWay}" Style="{StaticResource ThemePremiumOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeDream}" Background="{StaticResource ThemeDreamBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Dream" IsChecked="{Binding SelectedThemeKey, Converter={StaticResource ThemeKeyEqualityConverter}, ConverterParameter=Dream, Mode=OneWay}" Style="{StaticResource ThemePremiumOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeFresh}" Background="{StaticResource ThemeFreshBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Fresh" IsChecked="{Binding SelectedThemeKey, Converter={StaticResource ThemeKeyEqualityConverter}, ConverterParameter=Fresh, Mode=OneWay}" Style="{StaticResource ThemePremiumOptionStyle}" />
            </StackPanel>
            <Border Canvas.Left="24" Canvas.Top="411" Width="512" Height="1" Background="{DynamicResource BorderPrimary}" Opacity="0.7" />

            <StackPanel Canvas.Left="18" Canvas.Top="439" Orientation="Horizontal">
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeStarry}" Background="{StaticResource ThemeStarryBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Starry" IsChecked="{Binding SelectedThemeKey, Converter={StaticResource ThemeKeyEqualityConverter}, ConverterParameter=Starry, Mode=OneWay}" Style="{StaticResource ThemePremiumOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeMountain}" Background="{StaticResource ThemeMountainBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Mountain" IsChecked="{Binding SelectedThemeKey, Converter={StaticResource ThemeKeyEqualityConverter}, ConverterParameter=Mountain, Mode=OneWay}" Style="{StaticResource ThemePremiumOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeForest}" Background="{StaticResource ThemeForestBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Forest" IsChecked="{Binding SelectedThemeKey, Converter={StaticResource ThemeKeyEqualityConverter}, ConverterParameter=Forest, Mode=OneWay}" Style="{StaticResource ThemePremiumOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeSnow}" Background="{StaticResource ThemeSnowBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Snow" IsChecked="{Binding SelectedThemeKey, Converter={StaticResource ThemeKeyEqualityConverter}, ConverterParameter=Snow, Mode=OneWay}" Style="{StaticResource ThemePremiumOptionStyle}" />
            </StackPanel>
            <Button x:Name="ThemeVipUnlockButton"
                    Canvas.Left="24"
                    Canvas.Top="607"
                    Width="512"
                    Height="54"
                    Background="{DynamicResource SurfaceSecondary}"
                    BorderBrush="{DynamicResource BorderPrimary}"
                    BorderThickness="1"
                    Command="{Binding OpenVipCommand}"
                    Cursor="Hand"
                    FocusVisualStyle="{x:Null}">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CanUsePremiumThemes}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="UnlockBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <Grid Margin="20,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                                <Viewbox Width="22" Height="19" HorizontalAlignment="Left">
                                    <Path Data="M 2,6 L 8,13 L 14,4 L 20,13 L 26,6 L 23,22 L 5,22 Z M 5,18 L 23,18" Fill="{DynamicResource TransparentBrush}" Stroke="{DynamicResource AccentPrimary}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="2" />
                                </Viewbox>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="16" FontWeight="Normal" Foreground="{DynamicResource TextPrimary}">
                                    <Run Text="{DynamicResource ThemePanelVipUnlockPrefix}" /><Run FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" Text="{DynamicResource ThemePanelVipUnlockLabel}" /><Run Text="{DynamicResource ThemePanelVipUnlockSuffix}" />
                                </TextBlock>
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TextSecondary}" Text="&#xE76C;" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="UnlockBackground" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="UnlockBackground" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Canvas>
        </Border>
    </Viewbox>
</UserControl>
