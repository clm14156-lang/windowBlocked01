<UserControl x:Class="FocusApp.Desktop.Views.ThemePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="420"
             Height="450"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ThemeOrangeBrush" Color="#FF8500" />
        <SolidColorBrush x:Key="ThemeBlueBrush" Color="#3989EF" />
        <SolidColorBrush x:Key="ThemeCyanBrush" Color="#39C4CC" />
        <LinearGradientBrush x:Key="ThemeDarkBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#353535" />
            <GradientStop Offset="1" Color="#161616" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ThemeWarmBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#FF6176" />
            <GradientStop Offset="1" Color="#FFE0AB" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ThemeSkyBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#2E82F4" />
            <GradientStop Offset="1" Color="#B8E2FF" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ThemeDreamBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#6F50F0" />
            <GradientStop Offset="1" Color="#EDB8F2" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ThemeFreshBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#29C2CA" />
            <GradientStop Offset="1" Color="#CFF8C3" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="ThemeStarryBrush" Center="0.67,0.28" GradientOrigin="0.67,0.28" RadiusX="0.7" RadiusY="0.7">
            <GradientStop Offset="0" Color="#704FC1" />
            <GradientStop Offset="0.36" Color="#24175F" />
            <GradientStop Offset="1" Color="#061443" />
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="ThemeMountainBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#C49ABB" />
            <GradientStop Offset="0.62" Color="#E9A078" />
            <GradientStop Offset="1" Color="#65423F" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ThemeForestBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#B5CDC5" />
            <GradientStop Offset="0.48" Color="#4B806B" />
            <GradientStop Offset="1" Color="#154C31" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ThemeSnowBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#4DABE8" />
            <GradientStop Offset="0.64" Color="#D7F1FA" />
            <GradientStop Offset="1" Color="#668AAE" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="ThemeMoonBrush" Center="0.55,0.24" GradientOrigin="0.55,0.24" RadiusX="0.65" RadiusY="0.65">
            <GradientStop Offset="0" Color="#7AB0E0" />
            <GradientStop Offset="0.45" Color="#1C568B" />
            <GradientStop Offset="1" Color="#052D58" />
        </RadialGradientBrush>

        <Style x:Key="ThemeOptionStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Width" Value="99" />
            <Setter Property="Height" Value="90" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid Width="99" Height="90">
                            <Border x:Name="SelectionBorder"
                                    Width="70"
                                    Height="70"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Padding="2"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="11">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8" />
                            </Border>
                            <Border x:Name="CheckBadge"
                                    Width="21"
                                    Height="21"
                                    Margin="0,-2,11,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource AccentPrimary}"
                                    BorderBrush="{DynamicResource SurfacePrimary}"
                                    BorderThickness="2"
                                    CornerRadius="11"
                                    Visibility="Collapsed">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"
                                           Foreground="{DynamicResource WhiteText}"
                                           Text="&#xE73E;" />
                            </Border>
                            <TextBlock Margin="0,73,0,0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding Tag}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                <Setter TargetName="CheckBadge" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemePersonalOptionStyle"
               TargetType="{x:Type RadioButton}"
               BasedOn="{StaticResource ThemeOptionStyle}">
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="68" />
            <Setter Property="Foreground" Value="{DynamicResource WhiteText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid Width="80" Height="68">
                            <Border x:Name="SelectionBorder"
                                    Width="68"
                                    Height="68"
                                    HorizontalAlignment="Center"
                                    Padding="1"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8" />
                            </Border>
                            <TextBlock Margin="0,0,0,6"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding Tag}" />
                            <Border x:Name="CheckBadge"
                                    Width="20"
                                    Height="20"
                                    Margin="0,-2,5,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource AccentPrimary}"
                                    BorderBrush="{DynamicResource SurfacePrimary}"
                                    BorderThickness="2"
                                    CornerRadius="10"
                                    Visibility="Collapsed">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="9"
                                           Foreground="{DynamicResource WhiteText}"
                                           Text="&#xE73E;" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                <Setter TargetName="CheckBadge" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Width="420"
            Height="450"
            Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource OverlayBorder}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              Direction="270"
                              Opacity="0.12"
                              ShadowDepth="5" />
        </Border.Effect>
        <Canvas>
            <TextBlock Canvas.Left="18"
                       Canvas.Top="17"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="31"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="&#xE790;" />
            <TextBlock Canvas.Left="47"
                       Canvas.Top="13"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Text="{DynamicResource ThemePanelTitle}" />
            <TextBlock Canvas.Left="47"
                       Canvas.Top="38"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="{DynamicResource ThemePanelSubtitle}" />
            <Button Canvas.Left="380"
                    Canvas.Top="14"
                    Width="28"
                    Height="28"
                    AutomationProperties.Name="{DynamicResource ThemePanelClose}"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource AuthCloseButtonStyle}">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           FontSize="13"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                           Text="&#xE8BB;" />
            </Button>
            <Border Canvas.Left="18" Canvas.Top="54" Width="384" Height="1" Background="{DynamicResource BorderPrimary}" />

            <Border Canvas.Left="19" Canvas.Top="68" Width="3" Height="13" Background="{DynamicResource AccentPrimary}" CornerRadius="1" />
            <TextBlock Canvas.Left="29" Canvas.Top="62" FontSize="16" FontWeight="SemiBold" Text="{DynamicResource ThemePanelSolid}" />
            <StackPanel Canvas.Left="11" Canvas.Top="86" Orientation="Horizontal">
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeOrange}" Background="{StaticResource ThemeOrangeBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Orange" Style="{StaticResource ThemeOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeBlue}" Background="{StaticResource ThemeBlueBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Blue" Style="{StaticResource ThemeOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeCyan}" Background="{StaticResource ThemeCyanBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Cyan" Style="{StaticResource ThemeOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeDark}" Background="{StaticResource ThemeDarkBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Dark" Style="{StaticResource ThemeOptionStyle}" />
            </StackPanel>
            <Border Canvas.Left="18" Canvas.Top="191" Width="384" Height="1" Background="{DynamicResource BorderPrimary}" />

            <Border Canvas.Left="19" Canvas.Top="205" Width="3" Height="13" Background="#7568FF" CornerRadius="1" />
            <TextBlock Canvas.Left="29" Canvas.Top="199" FontSize="16" FontWeight="SemiBold" Text="{DynamicResource ThemePanelGradient}" />
            <StackPanel Canvas.Left="11" Canvas.Top="227" Orientation="Horizontal">
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeWarm}" Background="{StaticResource ThemeWarmBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Warm" IsChecked="True" Style="{StaticResource ThemeOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeSky}" Background="{StaticResource ThemeSkyBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Sky" Style="{StaticResource ThemeOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeDream}" Background="{StaticResource ThemeDreamBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Dream" Style="{StaticResource ThemeOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeFresh}" Background="{StaticResource ThemeFreshBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Fresh" Style="{StaticResource ThemeOptionStyle}" />
            </StackPanel>
            <Border Canvas.Left="18" Canvas.Top="327" Width="384" Height="1" Background="{DynamicResource BorderPrimary}" />

            <Border Canvas.Left="19" Canvas.Top="340" Width="3" Height="13" Background="#42D485" CornerRadius="1" />
            <TextBlock Canvas.Left="29" Canvas.Top="334" FontSize="16" FontWeight="SemiBold" Text="{DynamicResource ThemePanelPersonal}" />
            <StackPanel Canvas.Left="10" Canvas.Top="361" Orientation="Horizontal">
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeStarry}" Background="{StaticResource ThemeStarryBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Starry" Style="{StaticResource ThemePersonalOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeMountain}" Background="{StaticResource ThemeMountainBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Mountain" Style="{StaticResource ThemePersonalOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeForest}" Background="{StaticResource ThemeForestBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Forest" Style="{StaticResource ThemePersonalOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeSnow}" Background="{StaticResource ThemeSnowBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Snow" Style="{StaticResource ThemePersonalOptionStyle}" />
                <RadioButton GroupName="ThemePanelThemes" Tag="{DynamicResource ThemeMoon}" Background="{StaticResource ThemeMoonBrush}" Command="{Binding SelectThemeCommand}" CommandParameter="Moon" Style="{StaticResource ThemePersonalOptionStyle}" />
            </StackPanel>
        </Canvas>
    </Border>
</UserControl>
