<UserControl x:Class="FocusApp.Desktop.Views.GoalInvestmentTrendModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             UseLayoutRounding="True" SnapsToDevicePixels="True" Focusable="True"
             FontFamily="{DynamicResource FontFamilyPrimary}" Foreground="{DynamicResource StatisticsBodyBrush}" KeyboardNavigation.TabNavigation="Cycle"
             PreviewKeyDown="Modal_PreviewKeyDown" IsVisibleChanged="Modal_IsVisibleChanged">
    <UserControl.Style><Style TargetType="UserControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></UserControl.Style>
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/FocusApp.Desktop;component/Resources/StatisticsTypography.xaml"/>
            <ResourceDictionary Source="/FocusApp.Desktop;component/Resources/PoptipStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <sys:Boolean x:Key="SelectedRangeValue">True</sys:Boolean>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <DataTemplate x:Key="TrendRangeTextTemplate">
            <TextBlock Text="{Binding}" Style="{StaticResource StatisticsBodyTextStyle}"/>
        </DataTemplate>
        <Style x:Key="TrendRangeSelectorButton" TargetType="Button">
            <Setter Property="Height" Value="32"/><Setter Property="Width" Value="96"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DEE2E9"/>
            <Setter Property="Foreground" Value="{DynamicResource StatisticsBodyBrush}"/><Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/><Setter Property="FontFamily" Value="{DynamicResource FontFamilyPrimary}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="ContentTemplate" Value="{StaticResource TrendRangeTextTemplate}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="RangeSelectorSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center"/>
                        <Path Grid.Column="1" Width="8" Height="5" Data="M 0,0 L 4,4 L 8,0" Stroke="#818B9A" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FAFAFB"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#BAC3D0"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TrendRangeOptionButton" TargetType="Button">
            <Setter Property="Height" Value="30"/><Setter Property="Background" Value="White"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource StatisticsBodyBrush}"/><Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/><Setter Property="FontFamily" Value="{DynamicResource FontFamilyPrimary}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="ContentTemplate" Value="{StaticResource TrendRangeTextTemplate}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="OptionSurface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="9,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center"/>
                        <Path x:Name="OptionCheck" Grid.Column="1" Width="9" Height="7" Data="M 0,3 L 3,6 L 8,0" Stroke="#778294" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F5F6F8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#F5F6F8"/></Trigger><Trigger Property="Tag" Value="{StaticResource SelectedRangeValue}"><Setter Property="Background" Value="#F1F3F6"/><Setter TargetName="OptionCheck" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TrendSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource StatisticsHeadingTextStyle}"><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style x:Key="TrendMetricGroup" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="TrendMetricDivider" TargetType="Border"><Setter Property="Width" Value="1"/><Setter Property="Height" Value="66"/><Setter Property="Background" Value="#E8EBF0"/><Setter Property="VerticalAlignment" Value="Top"/></Style>
        <Style x:Key="TrendMetricIconBadge" TargetType="Border"><Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/><Setter Property="CornerRadius" Value="21"/><Setter Property="VerticalAlignment" Value="Top"/></Style>
        <Style x:Key="TrendMetricIcon" TargetType="Path"><Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="StrokeThickness" Value="2"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="IsHitTestVisible" Value="False"/></Style>
        <Style x:Key="TrendMetricLabel" TargetType="TextBlock" BasedOn="{StaticResource StatisticsMetricLabelStyle}"><Setter Property="Foreground" Value="#576174"/></Style>
        <Style x:Key="TrendMetricValue" TargetType="TextBlock" BasedOn="{StaticResource StatisticsBodyTextStyle}"/>
        <Style x:Key="TrendMetricNumberRunStyle" TargetType="Run" BasedOn="{StaticResource StatisticsValueRunStyle}"><Setter Property="FontSize" Value="34"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#101E2D"/></Style>
        <Style x:Key="TrendMetricUnitRunStyle" TargetType="Run" BasedOn="{StaticResource StatisticsUnitRunStyle}"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#576174"/></Style>
        <DataTemplate x:Key="TrendMetricDuration"><TextBlock Style="{StaticResource TrendMetricValue}" TextWrapping="NoWrap"><Run Text="{Binding HoursValue, Mode=OneWay}" Style="{StaticResource TrendMetricNumberRunStyle}"/><Run Text="{Binding HoursUnitWithLeadingSpace, Mode=OneWay}" Style="{StaticResource TrendMetricUnitRunStyle}"/><Run Text="{Binding MinutesValueWithLeadingSpace, Mode=OneWay}" Style="{StaticResource TrendMetricNumberRunStyle}"/><Run Text="{Binding MinutesUnitWithLeadingSpace, Mode=OneWay}" Style="{StaticResource TrendMetricUnitRunStyle}"/></TextBlock></DataTemplate>
        <Style x:Key="TrendYearNavigationButton" TargetType="Button">
            <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#8D929B"/><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F5F6F8"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.28"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TrendMonthOptionButton" TargetType="Button">
            <Setter Property="Height" Value="32"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ContentTemplate" Value="{StaticResource TrendRangeTextTemplate}"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="MonthSurface" Background="{TemplateBinding Background}" Padding="6,0" CornerRadius="6">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Path x:Name="MonthCheck" Data="M 0,5 L 4,9 L 12,0" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MonthSurface" Property="Background" Value="#F6F7F9"/></Trigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="MonthSurface" Property="Background" Value="#FFF2E9"/><Setter TargetName="MonthCheck" Property="Visibility" Value="Visible"/></DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TrendThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/><Setter Property="MinWidth" Value="5"/><Setter Property="Opacity" Value="0.35"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Width="5"><Track x:Name="PART_Track" Margin="0,2" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinHeight="22"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Width="3" Background="#A8ADB7" CornerRadius="1.5"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>

      </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="Overlay" Background="{DynamicResource ModalScrim}" MouseDown="Overlay_MouseDown">
        <Border x:Name="TrendModalCard" Width="700" Height="480" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" BorderBrush="#E8EAEE" BorderThickness="1" CornerRadius="16" MouseDown="ModalCard_MouseDown">
            <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.08"/></Border.Effect>
            <Grid x:Name="CloseButtonHost">
                <Grid Margin="24,20,24,20">
                    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="16"/><RowDefinition Height="32"/><RowDefinition Height="16"/><RowDefinition Height="76"/><RowDefinition Height="14"/><RowDefinition Height="254"/></Grid.RowDefinitions>
                    <TextBlock x:Name="TrendModalTitle" Text="投入趋势" Style="{StaticResource StatisticsPageTitleTextStyle}" VerticalAlignment="Center"/>
                    <Grid Grid.Row="2">
                        <TextBlock x:Name="DataOverviewTitle" Text="数据概况" Style="{StaticResource TrendSectionTitle}"/>
                        <Button x:Name="RangeSelectorButton" Content="{Binding RangeDisplay}" Style="{StaticResource TrendRangeSelectorButton}" HorizontalAlignment="Right" Click="RangeSelector_Click" AutomationProperties.Name="选择投入趋势时间范围"/>
                        <Popup x:Name="RangeMenuPopup" Opened="RangeMenu_Opened" Placement="Bottom" PlacementTarget="{Binding ElementName=RangeSelectorButton}" HorizontalOffset="-36" VerticalOffset="2" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border PreviewKeyDown="Modal_PreviewKeyDown" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle" Width="128" Margin="4,4,8,8" Padding="4" Background="White" BorderBrush="#E7EAF0" BorderThickness="1" CornerRadius="9">
                                <Border.Effect><DropShadowEffect Color="#293549" BlurRadius="10" ShadowDepth="2" Opacity="0.10"/></Border.Effect>
                                <StackPanel>
                                    <Button x:Name="SevenDaysRangeOption" Content="近七天" Tag="{Binding IsSevenDaysRange}" Style="{StaticResource TrendRangeOptionButton}" Command="{Binding SelectSevenDaysCommand}" Click="RangeOption_Click"/>
                                    <Button x:Name="ThirtyDaysRangeOption" Content="近三十天" Tag="{Binding IsThirtyDaysRange}" Style="{StaticResource TrendRangeOptionButton}" Command="{Binding SelectThirtyDaysCommand}" Click="RangeOption_Click"/>
                                    <Button x:Name="MonthRangeOption" Content="按月" Tag="{Binding IsMonthRange}" Style="{StaticResource TrendRangeOptionButton}" Command="{Binding SelectMonthModeCommand}" Click="RangeOption_Click"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                        <Popup x:Name="MonthPickerPopup" Grid.Row="2" HorizontalOffset="-32" VerticalOffset="4" IsOpen="{Binding IsMonthMenuOpen, Mode=TwoWay}" Placement="Bottom" PlacementTarget="{Binding ElementName=RangeSelectorButton}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border x:Name="MonthPickerSurface" PreviewKeyDown="Modal_PreviewKeyDown" Width="120" Padding="4" Margin="8" Background="White" BorderBrush="#ECEEF1" BorderThickness="1" CornerRadius="9">
                                <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.12"/></Border.Effect>
                                <StackPanel>
                                    <Grid Height="32" Visibility="{Binding HasMultipleMonthYears, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                        <Button Content="‹" Style="{StaticResource TrendYearNavigationButton}" Command="{Binding PreviousMonthYearCommand}" AutomationProperties.Name="上一数据年份"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MonthPickerYearDisplay}" Style="{StaticResource StatisticsAuxiliaryTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="›" Style="{StaticResource TrendYearNavigationButton}" Command="{Binding NextMonthYearCommand}" AutomationProperties.Name="下一数据年份"/>
                                    </Grid>
                                    <ScrollViewer MaxHeight="192" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource TrendThinScrollBar}"/></ScrollViewer.Resources>
                                        <ItemsControl x:Name="AvailableMonthList" ItemsSource="{Binding AvailableMonths}">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Button Content="{Binding Display}" Style="{StaticResource TrendMonthOptionButton}" Command="{Binding DataContext.SelectMonthCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock x:Name="MonthPickerEmptyState" Text="暂无数据" HorizontalAlignment="Center" Margin="0,20">
                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource StatisticsAuxiliaryTextStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasAvailableMonths}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Popup>
                    <Grid x:Name="InvestmentSummary" Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border x:Name="PeriodInvestmentCard" Grid.Column="0" Style="{StaticResource TrendMetricGroup}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition/></Grid.RowDefinitions>
                                <Border Grid.RowSpan="2" Style="{StaticResource TrendMetricIconBadge}" Background="#FFF3E8">
                                    <Path x:Name="PeriodInvestmentIcon" Style="{StaticResource TrendMetricIcon}" Stroke="#FF8219" Data="M 12,2 A 10,10 0 1 1 11.99,2 M 12,6 L 12,12 L 16.5,14.5"/>
                                </Border>
                                    <TextBlock Grid.Column="2" Text="累计投入" Style="{StaticResource TrendMetricLabel}"/>
                                <Viewbox Grid.Column="2" Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top"><ContentControl Content="{Binding PeriodInvestment}" ContentTemplate="{StaticResource TrendMetricDuration}"/></Viewbox>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource TrendMetricDivider}"/>
                        <Border x:Name="DailyAverageInvestmentCard" Grid.Column="2" Style="{StaticResource TrendMetricGroup}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition/></Grid.RowDefinitions>
                                <Border Grid.RowSpan="2" Style="{StaticResource TrendMetricIconBadge}" Background="#EDF5FF">
                                    <Path x:Name="DailyAverageInvestmentIcon" Style="{StaticResource TrendMetricIcon}" Stroke="#1684F8" Data="M 2,21 L 11,21 M 2,16 L 8,9 L 13,14 L 22,4 M 17,4 L 22,4 L 22,9"/>
                                </Border>
                                    <TextBlock Grid.Column="2" Text="日均投入" Style="{StaticResource TrendMetricLabel}"/>
                                <Viewbox Grid.Column="2" Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top"><ContentControl Content="{Binding DailyAverageInvestment}" ContentTemplate="{StaticResource TrendMetricDuration}"/></Viewbox>
                            </Grid>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource TrendMetricDivider}"/>
                        <Border x:Name="ActiveDaysCard" Grid.Column="4" Style="{StaticResource TrendMetricGroup}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition/></Grid.RowDefinitions>
                                <Border Grid.RowSpan="2" Style="{StaticResource TrendMetricIconBadge}" Background="#E8F8EF">
                                    <Path x:Name="ActiveDaysIcon" Style="{StaticResource TrendMetricIcon}" Stroke="#20B76B" Data="M 4,4 L 20,4 Q 21,4 21,5 L 21,21 Q 21,22 20,22 L 4,22 Q 3,22 3,21 L 3,5 Q 3,4 4,4 Z M 3,9 L 21,9 M 7,2 L 7,6 M 17,2 L 17,6 M 12,16 L 16,12"/>
                                </Border>
                                    <TextBlock Grid.Column="2" Text="活跃天数" Style="{StaticResource TrendMetricLabel}"/>
                                <Viewbox Grid.Column="2" Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Style="{StaticResource TrendMetricValue}" TextWrapping="NoWrap"><Run Text="{Binding ActiveDays, Mode=OneWay}" Style="{StaticResource TrendMetricNumberRunStyle}"/><Run Text=" 天" Style="{StaticResource TrendMetricUnitRunStyle}"/></TextBlock></Viewbox>
                            </Grid>
                        </Border>
                    </Grid>
                    <Border x:Name="TrendChartCard" Grid.Row="6" Background="White" BorderBrush="#ECEEF2" BorderThickness="0" Padding="0,6,0,0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="212"/></Grid.RowDefinitions>
                            <Grid x:Name="TrendChartHeading"><TextBlock x:Name="TrendSectionHeading" Text="投入趋势" Style="{StaticResource TrendSectionTitle}"/></Grid>
                            <views:GoalInvestmentTrendChart x:Name="TrendChart" Grid.Row="1" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
        <Canvas x:Name="TrendTooltipOverlay" Grid.RowSpan="7" Panel.ZIndex="10" IsHitTestVisible="False">
            <Border x:Name="TrendTooltip" Canvas.Left="{Binding TooltipLeft}" Canvas.Top="{Binding TooltipTop}" Width="196" Height="68" CornerRadius="10" Padding="13,10" Background="{StaticResource ChartPoptipBackgroundBrush}" BorderBrush="{StaticResource ChartPoptipBorderBrush}" BorderThickness="1"
                    Visibility="{Binding IsTooltipOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.RenderTransform><TranslateTransform x:Name="TrendTooltipOrigin"/></Border.RenderTransform>
                <Border.Effect><DropShadowEffect Color="#17202D" BlurRadius="12" Opacity="0.12" ShadowDepth="2"/></Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="TooltipDate" Text="{Binding HoveredPoint.TooltipFullDateDisplay}" Style="{StaticResource StatisticsAuxiliaryTextStyle}" FontSize="13" FontWeight="Normal" Foreground="{StaticResource ChartPoptipSecondaryBrush}"/>
                    <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8" Fill="#FF8B28" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TooltipFocusLabel" Grid.Column="2" Text="专注时长" Style="{StaticResource StatisticsAuxiliaryTextStyle}" FontSize="13" FontWeight="Normal" Foreground="{StaticResource ChartPoptipBodyBrush}" VerticalAlignment="Center"/>
                        <Viewbox Grid.Column="4" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock x:Name="TooltipFocusDuration" Text="{Binding HoverFocusDurationDisplay}" Style="{StaticResource StatisticsTimeTextStyle}" FontSize="13" FontWeight="Normal" Foreground="{StaticResource ChartPoptipValueBrush}"/></Viewbox>
                    </Grid>
                </StackPanel>
            </Border>
        </Canvas>
                </Grid>
                <Button x:Name="CloseModalButton" Style="{DynamicResource ModalCloseButtonStyle}" Command="{Binding CloseCommand}" AutomationProperties.Name="关闭投入趋势"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
