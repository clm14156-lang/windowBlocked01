<UserControl x:Class="FocusApp.Desktop.Views.GoalInvestmentTrendModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             UseLayoutRounding="True" SnapsToDevicePixels="True" Focusable="True"
             TextElement.FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
             TextElement.FontSize="13" TextElement.FontWeight="Normal"
             KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="Modal_PreviewKeyDown"
             IsVisibleChanged="Modal_IsVisibleChanged">
    <UserControl.Style>
        <Style TargetType="UserControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
    </UserControl.Style>
    <UserControl.Resources>
        <sys:Boolean x:Key="SelectedRangeValue">True</sys:Boolean>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="TrendQuietButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F5F6F8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#ECEEF1"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TrendRangeButton" TargetType="Button">
            <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F5F6F8"/></Trigger>
                    <Trigger Property="Tag" Value="{StaticResource SelectedRangeValue}"><Setter TargetName="Surface" Property="Background" Value="#FFF3EB"/><Setter TargetName="Surface" Property="BorderBrush" Value="#FFD5BA"/><Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TrendYearNavigationButton" TargetType="Button">
            <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#8D929B"/><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F5F6F8"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.28"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TrendMonthOptionButton" TargetType="Button">
            <Setter Property="Height" Value="32"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="MonthSurface" Background="{TemplateBinding Background}" Padding="10,0" CornerRadius="6">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Path x:Name="MonthCheck" Data="M 0,5 L 4,9 L 12,0" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MonthSurface" Property="Background" Value="#F6F7F9"/></Trigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="MonthSurface" Property="Background" Value="#FFF2E9"/><Setter TargetName="MonthCheck" Property="Visibility" Value="Visible"/></DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TimelineRecordButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="RowSurface" Background="{TemplateBinding Background}" CornerRadius="7"><ContentPresenter/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="#F8F9FB"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><DataTrigger Binding="{Binding HasCompletedTasks}" Value="True"><Setter Property="Cursor" Value="Hand"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="TrendThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/><Setter Property="MinWidth" Value="5"/><Setter Property="Opacity" Value="0.35"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Width="5"><Track x:Name="PART_Track" Margin="0,2" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinHeight="22"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Width="3" Background="#A8ADB7" CornerRadius="1.5"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ModalScrim}" MouseDown="Overlay_MouseDown">
        <Border x:Name="TrendModalCard" Width="700" Height="540" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="22,18" Background="White" BorderBrush="#E8E9EC" BorderThickness="1" CornerRadius="18" MouseDown="ModalCard_MouseDown">
            <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="5" Direction="270" Opacity="0.12"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/><RowDefinition Height="8"/><RowDefinition Height="72"/><RowDefinition Height="8"/>
                    <RowDefinition Height="158"/><RowDefinition Height="8"/><RowDefinition/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Top" Margin="0,-1,12,0">
                        <TextBlock Text="{Binding GoalName}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding GoalRemark}"/>
                        <TextBlock Text="投入趋势" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding GoalRemark}" FontSize="11" Foreground="{DynamicResource TextWeak}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Visibility="{Binding HasGoalRemark, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Width="24" Height="24" Margin="0,-8,-6,0" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource TrendQuietButton}" Command="{Binding CloseCommand}" AutomationProperties.Name="关闭投入趋势">
                        <TextBlock Text="×" FontSize="22" Foreground="{DynamicResource TextWeak}"/>
                    </Button>
                    <Border x:Name="RangeSelectorSurface" Grid.Column="1" Margin="0,22,0,0" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#FAFBFC" BorderBrush="#ECEEF2" BorderThickness="1" CornerRadius="7">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="78"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Content="近7天" Tag="{Binding IsSevenDaysRange}" Style="{StaticResource TrendRangeButton}" Command="{Binding SelectSevenDaysCommand}"/>
                            <Button Grid.Column="1" Content="近30天" Tag="{Binding IsThirtyDaysRange}" Style="{StaticResource TrendRangeButton}" Command="{Binding SelectThirtyDaysCommand}"/>
                            <Button x:Name="MonthRangeButton" Grid.Column="2" MinWidth="92" Tag="{Binding IsMonthRange}" Style="{StaticResource TrendRangeButton}" Command="{Binding SelectMonthModeCommand}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding MonthButtonText}" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="7,3,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel>
                            </Button>
                            <Popup x:Name="MonthPickerPopup" Grid.Column="2" HorizontalOffset="-78" VerticalOffset="4" IsOpen="{Binding IsMonthMenuOpen, Mode=TwoWay}" Placement="Bottom" PlacementTarget="{Binding ElementName=MonthRangeButton}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border x:Name="MonthPickerSurface" Width="180" Padding="6" Margin="8" Background="White" BorderBrush="#ECEEF1" BorderThickness="1" CornerRadius="9">
                                    <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.12"/></Border.Effect>
                                    <StackPanel>
                                        <Grid Height="32" Visibility="{Binding HasMultipleMonthYears, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                            <Button Content="‹" Style="{StaticResource TrendYearNavigationButton}" Command="{Binding PreviousMonthYearCommand}" AutomationProperties.Name="上一数据年份"/>
                                            <TextBlock Grid.Column="1" Text="{Binding MonthPickerYearDisplay}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                            <Button Grid.Column="2" Content="›" Style="{StaticResource TrendYearNavigationButton}" Command="{Binding NextMonthYearCommand}" AutomationProperties.Name="下一数据年份"/>
                                        </Grid>
                                        <ScrollViewer MaxHeight="192" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                            <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource TrendThinScrollBar}"/></ScrollViewer.Resources>
                                            <ItemsControl x:Name="AvailableMonthList" ItemsSource="{Binding AvailableMonths}">
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <Button Content="{Binding Display}" Style="{StaticResource TrendMonthOptionButton}" Command="{Binding DataContext.SelectMonthCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock x:Name="MonthPickerEmptyState" Text="暂无数据" FontSize="12" Foreground="{DynamicResource TextWeak}" HorizontalAlignment="Center" Margin="0,20">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasAvailableMonths}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="InvestmentMetrics" Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" HorizontalAlignment="Left" Background="#FFF3EB" CornerRadius="20">
                            <Grid Width="20" Height="20"><Ellipse Stroke="{DynamicResource AccentPrimary}" StrokeThickness="1.8"/><Path Data="M 10,4 L 10,10 L 15,12" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PeriodInvestmentTitle}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                            <Viewbox Height="36" Margin="0,3,0,0" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                <TextBlock x:Name="PeriodInvestmentValue"><Run Text="{Binding PeriodInvestment.HoursValue, Mode=OneWay}" FontSize="28" FontWeight="SemiBold"/><Run Text="{Binding PeriodInvestment.HoursUnitWithLeadingSpace, Mode=OneWay}" FontSize="12"/><Run Text="{Binding PeriodInvestment.MinutesValueWithLeadingSpace, Mode=OneWay}" FontSize="28" FontWeight="SemiBold"/><Run Text="{Binding PeriodInvestment.MinutesUnitWithLeadingSpace, Mode=OneWay}" FontSize="12"/></TextBlock>
                            </Viewbox>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Column="1" Height="52" Background="#ECEEF2"/>
                    <Grid Grid.Column="2" Margin="18,0,12,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" HorizontalAlignment="Left" Background="#FFF3EB" CornerRadius="20"><Path Width="18" Height="20" Stretch="Uniform" Data="M 3,4 L 17,4 Q 19,4 19,6 L 19,18 Q 19,20 17,20 L 3,20 Q 1,20 1,18 L 1,6 Q 1,4 3,4 M 1,9 L 19,9 M 5,1 L 5,6 M 15,1 L 15,6" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="活跃天数" FontSize="12" Foreground="{DynamicResource TextSecondary}"/><TextBlock x:Name="ActiveDaysValue" Margin="0,3,0,0"><Run Text="{Binding ActiveDays, Mode=OneWay}" FontSize="28" FontWeight="SemiBold"/><Run Text=" 天" FontSize="12"/></TextBlock></StackPanel>
                    </Grid>
                    <Border Grid.Column="3" Height="52" Background="#ECEEF2"/>
                    <Grid Grid.Column="4" Margin="18,0,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" HorizontalAlignment="Left" Background="#FFF3EB" CornerRadius="20"><Grid Width="19" Height="21"><Border Width="3" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{DynamicResource AccentPrimary}" CornerRadius="1.5"/><Border Width="3" Height="14" VerticalAlignment="Bottom" Background="{DynamicResource AccentPrimary}" CornerRadius="1.5"/><Border Width="3" Height="21" HorizontalAlignment="Right" Background="{DynamicResource AccentPrimary}" CornerRadius="1.5"/></Grid></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="平均时长" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                            <Viewbox Height="36" Margin="0,3,0,0" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock x:Name="AverageInvestmentValue"><Run Text="{Binding AverageInvestment.HoursValue, Mode=OneWay}" FontSize="28" FontWeight="SemiBold"/><Run Text="{Binding AverageInvestment.HoursUnitWithLeadingSpace, Mode=OneWay}" FontSize="12"/><Run Text="{Binding AverageInvestment.MinutesValueWithLeadingSpace, Mode=OneWay}" FontSize="28" FontWeight="SemiBold"/><Run Text="{Binding AverageInvestment.MinutesUnitWithLeadingSpace, Mode=OneWay}" FontSize="12"/></TextBlock></Viewbox>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Border x:Name="TrendChartCard" Grid.Row="4" Background="Transparent"><views:GoalInvestmentTrendChart HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>

                <Grid x:Name="InvestmentRecordsSection" Grid.Row="6">
                    <Grid.RowDefinitions><RowDefinition Height="1"/><RowDefinition Height="38"/><RowDefinition/></Grid.RowDefinitions>
                    <Border Background="#ECEEF2"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="InvestmentRecordDateTitle" Text="{Binding SelectedDateTitle}" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedDateSummary}" Margin="16,3,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ScrollViewer x:Name="InvestmentRecordsScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource TrendThinScrollBar}"/></ScrollViewer.Resources>
                        <ItemsControl x:Name="InvestmentTimeline" ItemsSource="{Binding SelectedDateRecords}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Grid x:Name="TimelineRow">
                                    <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="80"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                                    <Border x:Name="TimelineTopConnector" Grid.Column="1" Panel.ZIndex="2" IsHitTestVisible="False" Width="1" Height="12" VerticalAlignment="Top" Background="#E3E6EB">
                                        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsFirst}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    </Border>
                                    <Border x:Name="TimelineBottomConnector" Grid.Column="1" Grid.RowSpan="2" Panel.ZIndex="2" IsHitTestVisible="False" Width="1" Margin="0,22,0,0" Background="#E3E6EB">
                                        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsLast}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    </Border>
                                    <Button x:Name="TimelineRecordHeader" Grid.ColumnSpan="5" Style="{StaticResource TimelineRecordButton}" Command="{Binding ToggleDetailsCommand}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="80"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding StartTimeDisplay}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Top" Margin="0,8,0,0"/>
                                            <Ellipse Grid.Column="1" Width="10" Height="10" VerticalAlignment="Top" Margin="0,12,0,0">
                                                <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#CDD3DD"/><Style.Triggers><DataTrigger Binding="{Binding IsFirst}" Value="True"><Setter Property="Fill" Value="{DynamicResource AccentPrimary}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                            </Ellipse>
                                            <StackPanel Grid.Column="2" Margin="8,6,8,0">
                                                <TextBlock Text="{Binding GoalName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding TimeRangeDisplay}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasCompletedTasks, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="·" Margin="8,0" Foreground="{DynamicResource TextSecondary}"/>
                                                        <Path Data="M 0,4 L 3,7 L 10,0" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding CompletedTaskSummary}" Margin="5,0,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding DurationDisplay}" FontSize="13" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,4,0"/>
                                            <TextBlock x:Name="TimelineChevron" Grid.Column="4" FontFamily="Segoe MDL2 Assets" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,11,2,0" Foreground="{DynamicResource TextSecondary}" Visibility="{Binding HasCompletedTasks, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE76C;"/><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Text" Value="&#xE70E;"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Button>
                                    <ItemsControl x:Name="TimelineCompletedTasks" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Margin="8,0,0,12" ItemsSource="{Binding CompletedTasks}" Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Grid MinHeight="25"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <Border Width="14" Height="14" CornerRadius="7" Background="{DynamicResource AccentPrimary}" HorizontalAlignment="Left"><Path Data="M 0,3 L 2,5 L 7,0" Stroke="White" StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Border>
                                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Grid.RowSpan="2" Grid.Column="2" Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Background="#F0F2F5" IsHitTestVisible="False"/>
                                </Grid>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" Text="这一天暂无专注记录" FontSize="12" Foreground="{DynamicResource TextWeak}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasSelectedDateRecords}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
