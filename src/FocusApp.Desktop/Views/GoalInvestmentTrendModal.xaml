<UserControl x:Class="FocusApp.Desktop.Views.GoalInvestmentTrendModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             xmlns:vm="clr-namespace:FocusApp.Desktop.ViewModels"
             UseLayoutRounding="True" SnapsToDevicePixels="True" Focusable="True"
             TextElement.FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
             TextElement.FontSize="{DynamicResource BodyFontSize}" TextElement.FontWeight="{DynamicResource BodyFontWeight}"
             KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="Modal_PreviewKeyDown"
             IsVisibleChanged="Modal_IsVisibleChanged">
    <UserControl.Style>
        <Style TargetType="UserControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
    </UserControl.Style>
    <UserControl.Resources>
        <sys:Boolean x:Key="SelectedRangeValue">True</sys:Boolean>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <SolidColorBrush x:Key="TrendSegmentBackground" Color="#F5F6F8"/>
        <SolidColorBrush x:Key="TrendSegmentSelectedBackground" Color="#FFF5EB"/>
        <SolidColorBrush x:Key="TrendSegmentSelectedBorder" Color="#FFDFC7"/>
        <SolidColorBrush x:Key="TrendMetricIconBrush" Color="#748292"/>
        <SolidColorBrush x:Key="TrendMetricDividerBrush" Color="#E6EAF0"/>
        <Style x:Key="TrendMetricGroup" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="16,0,8,0"/>
        </Style>
        <Style x:Key="TrendMetricDivider" TargetType="Border">
            <Setter Property="Width" Value="1"/><Setter Property="Height" Value="58"/>
            <Setter Property="Background" Value="{StaticResource TrendMetricDividerBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TrendMetricIcon" TargetType="Path">
            <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/>
            <Setter Property="Stretch" Value="Uniform"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Stroke" Value="{StaticResource TrendMetricIconBrush}"/><Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style x:Key="TrendMetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
            <Setter Property="FontWeight" Value="{DynamicResource BodyFontWeight}"/>
            <Setter Property="Foreground" Value="{StaticResource TrendMetricIconBrush}"/>
        </Style>
        <Style x:Key="TrendMetricValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyNumeric}"/>
            <Setter Property="FontSize" Value="{DynamicResource DataValueLargeFontSize}"/>
            <Setter Property="FontWeight" Value="{DynamicResource DataValueLargeFontWeight}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <DataTemplate x:Key="TrendMetricDuration">
            <TextBlock Style="{StaticResource TrendMetricValue}"><Run Text="{Binding HoursValue, Mode=OneWay}"/><Run Text="{Binding HoursUnitWithLeadingSpace, Mode=OneWay}" FontFamily="{DynamicResource FontFamilyPrimary}" FontSize="{DynamicResource BodyFontSize}" FontWeight="{DynamicResource BodyFontWeight}"/><Run Text="{Binding MinutesValueWithLeadingSpace, Mode=OneWay}"/><Run Text="{Binding MinutesUnitWithLeadingSpace, Mode=OneWay}" FontFamily="{DynamicResource FontFamilyPrimary}" FontSize="{DynamicResource BodyFontSize}" FontWeight="{DynamicResource BodyFontWeight}"/></TextBlock>
        </DataTemplate>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="TrendRangeLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="FontWeight" Value="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>
        <DataTemplate x:Key="TrendRangeTextContent">
            <TextBlock Text="{Binding}" Style="{StaticResource TrendRangeLabel}"/>
        </DataTemplate>
        <Style x:Key="TrendRangeButton" TargetType="Button">
            <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"/><Setter Property="FontWeight" Value="{DynamicResource BodyFontWeight}"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="17" BorderThickness="1" BorderBrush="Transparent">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlHoverBackground}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentSoftBorder}"/></Trigger>
                    <Trigger Property="Tag" Value="{StaticResource SelectedRangeValue}"><Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/><Setter Property="FontWeight" Value="{DynamicResource BodyMediumFontWeight}"/><Setter TargetName="Surface" Property="Background" Value="{StaticResource TrendSegmentSelectedBackground}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource TrendSegmentSelectedBorder}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TrendYearNavigationButton" TargetType="Button">
            <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#8D929B"/><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F5F6F8"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.28"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TrendMonthOptionButton" TargetType="Button">
            <Setter Property="Height" Value="32"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="MonthSurface" Background="{TemplateBinding Background}" Padding="6,0" CornerRadius="6">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Path x:Name="MonthCheck" Data="M 0,5 L 4,9 L 12,0" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MonthSurface" Property="Background" Value="#F6F7F9"/></Trigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="MonthSurface" Property="Background" Value="#FFF2E9"/><Setter TargetName="MonthCheck" Property="Visibility" Value="Visible"/></DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TrendThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/><Setter Property="MinWidth" Value="5"/><Setter Property="Opacity" Value="0.35"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Width="5"><Track x:Name="PART_Track" Margin="0,2" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinHeight="22"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Width="3" Background="#A8ADB7" CornerRadius="1.5"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource ModalScrim}" MouseDown="Overlay_MouseDown">
        <Border x:Name="TrendModalCard" Width="700" Height="448" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="White" BorderBrush="#E8E9EC" BorderThickness="1" CornerRadius="18" MouseDown="ModalCard_MouseDown">
            <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.10"/></Border.Effect>
            <Grid x:Name="CloseButtonHost">
            <Grid Margin="28,24">
                <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="12"/><RowDefinition Height="84"/><RowDefinition Height="20"/><RowDefinition Height="24"/><RowDefinition Height="6"/><RowDefinition Height="188"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,260,0">
                    <TextBlock Text="{Binding GoalName}" FontSize="{DynamicResource DialogTitleFontSize}" FontWeight="{DynamicResource DialogTitleFontWeight}" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding GoalRemark}"/>
                    <TextBlock Text="投入趋势" FontSize="{DynamicResource BodyFontSize}" FontWeight="{DynamicResource BodyFontWeight}" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
                </StackPanel>
                <Border x:Name="RangeSelectorSurface" Width="228" Height="34" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{StaticResource TrendSegmentBackground}" CornerRadius="17" BorderThickness="0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Content="近7天" ContentTemplate="{StaticResource TrendRangeTextContent}" Tag="{Binding IsSevenDaysRange}" Style="{StaticResource TrendRangeButton}" Command="{Binding SelectSevenDaysCommand}"/>
                        <Button Grid.Column="1" Content="近30天" ContentTemplate="{StaticResource TrendRangeTextContent}" Tag="{Binding IsThirtyDaysRange}" Style="{StaticResource TrendRangeButton}" Command="{Binding SelectThirtyDaysCommand}"/>
                        <Button x:Name="MonthRangeButton" Grid.Column="2" Content="{Binding MonthButtonText}" ContentTemplate="{StaticResource TrendRangeTextContent}" Tag="{Binding IsMonthRange}" Style="{StaticResource TrendRangeButton}" Command="{Binding SelectMonthModeCommand}"/>
                        <Popup x:Name="MonthPickerPopup" Grid.Column="2" HorizontalOffset="-44" VerticalOffset="4" IsOpen="{Binding IsMonthMenuOpen, Mode=TwoWay}" Placement="Bottom" PlacementTarget="{Binding ElementName=MonthRangeButton}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border x:Name="MonthPickerSurface" Width="120" Padding="4" Margin="8" Background="White" BorderBrush="#ECEEF1" BorderThickness="1" CornerRadius="9">
                                <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.12"/></Border.Effect>
                                <StackPanel>
                                    <Grid Height="32" Visibility="{Binding HasMultipleMonthYears, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                        <Button Content="‹" Style="{StaticResource TrendYearNavigationButton}" Command="{Binding PreviousMonthYearCommand}" AutomationProperties.Name="上一数据年份"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MonthPickerYearDisplay}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <Button Grid.Column="2" Content="›" Style="{StaticResource TrendYearNavigationButton}" Command="{Binding NextMonthYearCommand}" AutomationProperties.Name="下一数据年份"/>
                                    </Grid>
                                    <ScrollViewer MaxHeight="192" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource TrendThinScrollBar}"/></ScrollViewer.Resources>
                                        <ItemsControl x:Name="AvailableMonthList" ItemsSource="{Binding AvailableMonths}">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Button Content="{Binding Display}" Style="{StaticResource TrendMonthOptionButton}" Command="{Binding DataContext.SelectMonthCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock x:Name="MonthPickerEmptyState" Text="暂无数据" FontSize="12" Foreground="{DynamicResource TextWeak}" HorizontalAlignment="Center" Margin="0,20">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasAvailableMonths}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
                <Grid x:Name="InvestmentSummary" Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border x:Name="PeriodInvestmentCard" Style="{StaticResource TrendMetricGroup}" Padding="8,0,8,0">
                        <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="2"/><RowDefinition Height="20"/></Grid.RowDefinitions>
                            <Path x:Name="PeriodInvestmentIcon" Style="{StaticResource TrendMetricIcon}" Data="M 12,1.5 A 10.5,10.5 0 1 1 11.99,1.5 M 12,5 L 12,12 L 17,14"/>
                            <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center"><ContentControl Content="{Binding PeriodInvestment}" ContentTemplate="{StaticResource TrendMetricDuration}"/></Viewbox>
                            <TextBlock Grid.Column="2" Grid.Row="2" Text="累计投入" Style="{StaticResource TrendMetricLabel}"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource TrendMetricDivider}"/>
                    <Border x:Name="DailyAverageInvestmentCard" Grid.Column="2" Style="{StaticResource TrendMetricGroup}">
                        <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="2"/><RowDefinition Height="20"/></Grid.RowDefinitions>
                            <Path x:Name="DailyAverageInvestmentIcon" Style="{StaticResource TrendMetricIcon}" Data="M 4,21 L 4,14 M 12,21 L 12,8 M 20,21 L 20,3" StrokeThickness="3.2"/>
                            <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center"><ContentControl Content="{Binding DailyAverageInvestment}" ContentTemplate="{StaticResource TrendMetricDuration}"/></Viewbox>
                            <TextBlock Grid.Column="2" Grid.Row="2" Text="日均投入" Style="{StaticResource TrendMetricLabel}" ToolTip="所选范围的累计投入除以活跃天数"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource TrendMetricDivider}"/>
                    <Border x:Name="ActiveDaysCard" Grid.Column="4" Style="{StaticResource TrendMetricGroup}">
                        <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="2"/><RowDefinition Height="20"/></Grid.RowDefinitions>
                            <Path x:Name="ActiveDaysIcon" Style="{StaticResource TrendMetricIcon}" Data="M 5,5 L 19,5 Q 21,5 21,7 L 21,20 Q 21,22 19,22 L 5,22 Q 3,22 3,20 L 3,7 Q 3,5 5,5 Z M 7,2 L 7,7 M 17,2 L 17,7 M 3,10 L 21,10 M 8,14 L 8.01,14 M 15,14 L 15.01,14 M 8,18 L 8.01,18"/>
                            <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Style="{StaticResource TrendMetricValue}"><Run Text="{Binding ActiveDays, Mode=OneWay}"/><Run Text=" 天" FontFamily="{DynamicResource FontFamilyPrimary}" FontSize="{DynamicResource BodyFontSize}" FontWeight="{DynamicResource BodyFontWeight}"/></TextBlock></Viewbox>
                            <TextBlock Grid.Column="2" Grid.Row="2" Text="活跃天数" Style="{StaticResource TrendMetricLabel}"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="5" Style="{StaticResource TrendMetricDivider}"/>
                    <Border x:Name="LongestDayInvestmentCard" Grid.Column="6" Style="{StaticResource TrendMetricGroup}">
                        <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="2"/><RowDefinition Height="20"/></Grid.RowDefinitions>
                            <Path x:Name="LongestDayInvestmentIcon" Style="{StaticResource TrendMetricIcon}" Data="M 4,21 L 4,14 M 12,21 L 12,8 M 20,21 L 20,3" StrokeThickness="3.2"/>
                            <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center"><ContentControl Content="{Binding LongestDayInvestment}" ContentTemplate="{StaticResource TrendMetricDuration}"/></Viewbox>
                            <TextBlock Grid.Column="2" Grid.Row="2" Text="最长单日" Style="{StaticResource TrendMetricLabel}"/>
                        </Grid>
                    </Border>
                </Grid>
                <Border x:Name="SummaryDivider" Grid.Row="3" Height="1" Background="#F0F2F5" VerticalAlignment="Center"/>
                <Grid x:Name="TrendChartHeading" Grid.Row="4">
                    <TextBlock Text="投入趋势" FontSize="{DynamicResource SectionTitleFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                </Grid>
                <Border x:Name="TrendChartCard" Grid.Row="6" Background="Transparent">
                    <views:GoalInvestmentTrendChart x:Name="TrendChart" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                </Border>
                <Canvas Grid.RowSpan="7" Panel.ZIndex="6" IsHitTestVisible="False">
                    <views:PoptipChrome x:Name="TrendTooltip" Canvas.Left="{Binding TooltipLeft}"
                            Width="164" Height="{Binding TooltipHeight}" PointerLeft="{Binding TooltipPointerLeft}"
                            Visibility="{Binding IsTooltipOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <views:PoptipChrome.RenderTransform><TransformGroup><TranslateTransform Y="{Binding TooltipTop}"/><TranslateTransform Y="210"/></TransformGroup></views:PoptipChrome.RenderTransform>
                        <views:PoptipChrome.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.08"/></views:PoptipChrome.Effect>
                        <StackPanel>
                            <TextBlock x:Name="TooltipDate" Text="{Binding HoveredPoint.TooltipDateDisplay}" FontSize="12" Foreground="#728197"/>
                            <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="TooltipFocusLabel" Text="专注时长" FontSize="13" Foreground="#17202C" VerticalAlignment="Center"/>
                                <Viewbox Grid.Column="1" Margin="6,0,0,0" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock x:Name="TooltipFocusDuration" Text="{Binding HoverFocusDurationDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}"/>
                                </Viewbox>
                            </Grid>
                            <TextBlock x:Name="TooltipFocusCount" Text="{Binding HoverFocusCountDisplay}" Margin="0,5,0,0" FontSize="12" Foreground="#728197"/>
                        </StackPanel>
                    </views:PoptipChrome>
                </Canvas>
            </Grid>
                <Button x:Name="ModalCloseButton" Style="{DynamicResource ModalCloseButtonStyle}"
                        Command="{Binding CloseCommand}" AutomationProperties.Name="关闭投入趋势" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
