<UserControl x:Class="FocusApp.Desktop.Views.GoalInvestmentTrendModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             UseLayoutRounding="True" SnapsToDevicePixels="True" Focusable="True"
             FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI" KeyboardNavigation.TabNavigation="Cycle"
             PreviewKeyDown="Modal_PreviewKeyDown" IsVisibleChanged="Modal_IsVisibleChanged">
    <UserControl.Style><Style TargetType="UserControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></UserControl.Style>
    <UserControl.Resources>
        <sys:Boolean x:Key="SelectedRangeValue">True</sys:Boolean>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="TrendRangeButton" TargetType="Button">
            <Setter Property="Height" Value="34"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#30394A"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent" CornerRadius="10">
                    <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EFEFF2"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#C6CBD4"/></Trigger>
                    <Trigger Property="Tag" Value="{StaticResource SelectedRangeValue}"><Setter Property="Background" Value="#FF881F"/><Setter Property="Foreground" Value="White"/><Setter TargetName="Surface" Property="BorderBrush" Value="#FF881F"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TrendMetricGroup" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#F0F1F3"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="10,10"/>
        </Style>
        <Style x:Key="TrendMetricDivider" TargetType="Border"><Setter Property="Width" Value="1"/><Setter Property="Height" Value="42"/><Setter Property="Background" Value="#ECEEF1"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style x:Key="TrendMetricIconTile" TargetType="Border"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Background" Value="#F3F5F7"/><Setter Property="CornerRadius" Value="8"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style x:Key="TrendMetricIcon" TargetType="Path"><Setter Property="Width" Value="23"/><Setter Property="Height" Value="23"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Stroke" Value="#7A8798"/><Setter Property="StrokeThickness" Value="1.8"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="IsHitTestVisible" Value="False"/></Style>
        <Style x:Key="TrendMetricLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Foreground" Value="#7B8595"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style x:Key="TrendMetricValue" TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource FontFamilyNumeric}"/><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#151C28"/></Style>
        <DataTemplate x:Key="TrendMetricDuration"><TextBlock Style="{StaticResource TrendMetricValue}"><Run Text="{Binding HoursValue, Mode=OneWay}"/><Run Text="{Binding HoursUnitWithLeadingSpace, Mode=OneWay}" FontSize="11" FontWeight="Medium"/><Run Text="{Binding MinutesValueWithLeadingSpace, Mode=OneWay}"/><Run Text="{Binding MinutesUnitWithLeadingSpace, Mode=OneWay}" FontSize="11" FontWeight="Medium"/></TextBlock></DataTemplate>
        <Style x:Key="TrendYearNavigationButton" TargetType="Button">
            <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#8D929B"/><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F5F6F8"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.28"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TrendMonthOptionButton" TargetType="Button">
            <Setter Property="Height" Value="32"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="MonthSurface" Background="{TemplateBinding Background}" Padding="6,0" CornerRadius="6">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Path x:Name="MonthCheck" Data="M 0,5 L 4,9 L 12,0" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MonthSurface" Property="Background" Value="#F6F7F9"/></Trigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="MonthSurface" Property="Background" Value="#FFF2E9"/><Setter TargetName="MonthCheck" Property="Visibility" Value="Visible"/></DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TrendThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/><Setter Property="MinWidth" Value="5"/><Setter Property="Opacity" Value="0.35"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Width="5"><Track x:Name="PART_Track" Margin="0,2" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinHeight="22"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Width="3" Background="#A8ADB7" CornerRadius="1.5"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>

    </UserControl.Resources>
    <Grid x:Name="Overlay" Background="{DynamicResource ModalScrim}" MouseDown="Overlay_MouseDown">
        <Border x:Name="TrendModalCard" Width="700" Height="480" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" BorderBrush="#E8EAEE" BorderThickness="1" CornerRadius="16" MouseDown="ModalCard_MouseDown">
            <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.08"/></Border.Effect>
            <Grid x:Name="CloseButtonHost">
                <Grid Margin="24,20,24,20">
                    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="14"/><RowDefinition Height="34"/><RowDefinition Height="18"/><RowDefinition Height="76"/><RowDefinition Height="12"/><RowDefinition Height="254"/></Grid.RowDefinitions>
                    <TextBlock x:Name="TrendModalTitle" Text="投入趋势" FontSize="24" FontWeight="SemiBold" Foreground="#141B27" VerticalAlignment="Center"/>
                    <Border x:Name="RangeSelectorSurface" Grid.Row="2" Width="240" Height="34" HorizontalAlignment="Left" Background="#F8F8FA" BorderBrush="#ECEEF2" BorderThickness="0" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Grid.Column="1" Width="1" Height="16" HorizontalAlignment="Left" Background="#ECEEF2"/>
                            <Border Grid.Column="2" Width="1" Height="16" HorizontalAlignment="Left" Background="#ECEEF2"/>
                            <Button x:Name="SevenDaysRangeButton" Content="近七天" Tag="{Binding IsSevenDaysRange}" Style="{StaticResource TrendRangeButton}" Command="{Binding SelectSevenDaysCommand}"/>
                            <Button x:Name="ThirtyDaysRangeButton" Grid.Column="1" Content="近三十天" Tag="{Binding IsThirtyDaysRange}" Style="{StaticResource TrendRangeButton}" Command="{Binding SelectThirtyDaysCommand}"/>
                            <Button x:Name="MonthRangeButton" Grid.Column="2" Content="按月" Tag="{Binding IsMonthRange}" Style="{StaticResource TrendRangeButton}" Command="{Binding SelectMonthModeCommand}"/>
                        <Popup x:Name="MonthPickerPopup" Grid.Column="2" HorizontalOffset="-44" VerticalOffset="4" IsOpen="{Binding IsMonthMenuOpen, Mode=TwoWay}" Placement="Bottom" PlacementTarget="{Binding ElementName=MonthRangeButton}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border x:Name="MonthPickerSurface" Width="120" Padding="4" Margin="8" Background="White" BorderBrush="#ECEEF1" BorderThickness="1" CornerRadius="9">
                                <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.12"/></Border.Effect>
                                <StackPanel>
                                    <Grid Height="32" Visibility="{Binding HasMultipleMonthYears, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                        <Button Content="‹" Style="{StaticResource TrendYearNavigationButton}" Command="{Binding PreviousMonthYearCommand}" AutomationProperties.Name="上一数据年份"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MonthPickerYearDisplay}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <Button Grid.Column="2" Content="›" Style="{StaticResource TrendYearNavigationButton}" Command="{Binding NextMonthYearCommand}" AutomationProperties.Name="下一数据年份"/>
                                    </Grid>
                                    <ScrollViewer MaxHeight="192" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource TrendThinScrollBar}"/></ScrollViewer.Resources>
                                        <ItemsControl x:Name="AvailableMonthList" ItemsSource="{Binding AvailableMonths}">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Button Content="{Binding Display}" Style="{StaticResource TrendMonthOptionButton}" Command="{Binding DataContext.SelectMonthCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock x:Name="MonthPickerEmptyState" Text="暂无数据" FontSize="12" Foreground="{DynamicResource TextWeak}" HorizontalAlignment="Center" Margin="0,20">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasAvailableMonths}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Popup>
                        </Grid>
                    </Border>
                    <Grid x:Name="InvestmentSummary" Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border x:Name="PeriodInvestmentCard" Style="{StaticResource TrendMetricGroup}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition/></Grid.RowDefinitions>
                                <Border Grid.RowSpan="2" Style="{StaticResource TrendMetricIconTile}"><Path x:Name="PeriodInvestmentIcon" Style="{StaticResource TrendMetricIcon}" Data="M 12,1.5 A 10.5,10.5 0 1 1 11.99,1.5 M 12,5 L 12,12 L 17,14"/></Border>
                                <TextBlock Grid.Column="2" Text="累计投入" Style="{StaticResource TrendMetricLabel}"/>
                                <Viewbox Grid.Column="2" Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center"><ContentControl Content="{Binding PeriodInvestment}" ContentTemplate="{StaticResource TrendMetricDuration}"/></Viewbox>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource TrendMetricDivider}"/>
                        <Border x:Name="DailyAverageInvestmentCard" Grid.Column="2" Style="{StaticResource TrendMetricGroup}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition/></Grid.RowDefinitions>
                                <Border Grid.RowSpan="2" Style="{StaticResource TrendMetricIconTile}"><Path x:Name="DailyAverageInvestmentIcon" Style="{StaticResource TrendMetricIcon}" Data="M 4,21 L 4,14 M 12,21 L 12,8 M 20,21 L 20,3" StrokeThickness="3.2"/></Border>
                                <TextBlock Grid.Column="2" Text="日均投入" Style="{StaticResource TrendMetricLabel}"/>
                                <Viewbox Grid.Column="2" Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center"><ContentControl Content="{Binding DailyAverageInvestment}" ContentTemplate="{StaticResource TrendMetricDuration}"/></Viewbox>
                            </Grid>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource TrendMetricDivider}"/>
                        <Border x:Name="ActiveDaysCard" Grid.Column="4" Style="{StaticResource TrendMetricGroup}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition/></Grid.RowDefinitions>
                                <Border Grid.RowSpan="2" Style="{StaticResource TrendMetricIconTile}"><Path x:Name="ActiveDaysIcon" Style="{StaticResource TrendMetricIcon}" Data="M 3,4 L 21,4 L 21,22 L 3,22 Z M 3,9 L 21,9 M 7,1 L 7,6 M 17,1 L 17,6 M 7,13 L 9,13 M 13,13 L 15,13 M 7,17 L 9,17"/></Border>
                                <TextBlock Grid.Column="2" Text="活跃天数" Style="{StaticResource TrendMetricLabel}"/>
                                <Viewbox Grid.Column="2" Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Style="{StaticResource TrendMetricValue}"><Run Text="{Binding ActiveDays, Mode=OneWay}"/><Run Text=" 天" FontSize="12" FontWeight="Medium"/></TextBlock></Viewbox>
                            </Grid>
                        </Border>
                        <Border Grid.Column="5" Style="{StaticResource TrendMetricDivider}"/>
                        <Border x:Name="LongestDayInvestmentCard" Grid.Column="6" Style="{StaticResource TrendMetricGroup}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition/></Grid.RowDefinitions>
                                <Border Grid.RowSpan="2" Style="{StaticResource TrendMetricIconTile}"><Path x:Name="LongestDayInvestmentIcon" Style="{StaticResource TrendMetricIcon}" Data="M 4,21 L 4,14 M 12,21 L 12,8 M 20,21 L 20,3" StrokeThickness="3.2"/></Border>
                                <TextBlock Grid.Column="2" Text="最长单日" Style="{StaticResource TrendMetricLabel}"/>
                                <Viewbox Grid.Column="2" Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center"><ContentControl Content="{Binding LongestDayInvestment}" ContentTemplate="{StaticResource TrendMetricDuration}"/></Viewbox>
                            </Grid>
                        </Border>
                    </Grid>
                    <Border x:Name="TrendChartCard" Grid.Row="6" Background="White" BorderBrush="#EEF0F3" BorderThickness="1" CornerRadius="12" Padding="3,9,3,5">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="212"/></Grid.RowDefinitions>
                            <Grid x:Name="TrendChartHeading" Margin="14,0"><TextBlock Text="投入趋势" FontSize="13" FontWeight="SemiBold" Foreground="#758093" VerticalAlignment="Center"/></Grid>
                            <views:GoalInvestmentTrendChart x:Name="TrendChart" Grid.Row="1" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
        <Canvas x:Name="TrendTooltipOverlay" Grid.RowSpan="7" Panel.ZIndex="10" IsHitTestVisible="False">
            <Border x:Name="TrendTooltip" Canvas.Left="{Binding TooltipLeft}" Canvas.Top="{Binding TooltipTop}" Width="196" Height="68" CornerRadius="10" Padding="13,10" Background="#282F3B" BorderBrush="#343D4B" BorderThickness="1"
                    Visibility="{Binding IsTooltipOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.RenderTransform><TransformGroup><TranslateTransform Y="20"/><TranslateTransform x:Name="TrendTooltipOrigin"/></TransformGroup></Border.RenderTransform>
                <Border.Effect><DropShadowEffect Color="#17202D" BlurRadius="12" Opacity="0.12" ShadowDepth="2"/></Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="TooltipDate" Text="{Binding HoveredPoint.TooltipFullDateDisplay}" FontSize="11" Foreground="#BFC6D2"/>
                    <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8" Fill="#FF8B28" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TooltipFocusLabel" Grid.Column="2" Text="专注时长" FontSize="12" Foreground="#E3E7EE" VerticalAlignment="Center"/>
                        <Viewbox Grid.Column="4" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock x:Name="TooltipFocusDuration" Text="{Binding HoverFocusDurationDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="White"/></Viewbox>
                    </Grid>
                </StackPanel>
            </Border>
        </Canvas>
                </Grid>
                <Button x:Name="CloseModalButton" Style="{DynamicResource ModalCloseButtonStyle}" Command="{Binding CloseCommand}" AutomationProperties.Name="关闭投入趋势"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
