<Window x:Class="FocusApp.Desktop.Views.AutomaticRuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="280" MinWidth="280" MaxWidth="280"
        Height="400" MinHeight="400" MaxHeight="400"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
        FontSize="12" Foreground="#1D1D1F">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FocusApp.Desktop;component/Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVisibility" />
            <Style x:Key="TextButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#8E8E93" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F5F5F7" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#ECECEF" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="RepeatButton" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#6E6E73" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
                                <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F2F3F5" /></Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="#FFF7F0" />
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="#FFCBA3" />
                                    <Setter Property="Foreground" Value="#FF7A00" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FFEFE2" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="WeekdayButton" TargetType="ToggleButton" BasedOn="{StaticResource RepeatButton}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="26" />
                <Setter Property="FontSize" Value="11" />
            </Style>
            <Style x:Key="TimeField" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#E5E5EA" />
                <Setter Property="Foreground" Value="#1D1D1F" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                                <Grid Margin="11,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Path Grid.Column="1" Width="7" Height="4" VerticalAlignment="Center" HorizontalAlignment="Right" Data="M0,0 L3.5,3 L7,0" Stroke="#8E8E93" StrokeThickness="1.3" StrokeLineJoin="Round" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="#FAFAFC" />
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="#D5D5DC" />
                                </Trigger>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="#FFFAF6" />
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="#FF7A00" />
                                </DataTrigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FFF3E9" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PickerList" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
                <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Height" Value="28" />
                            <Setter Property="Padding" Value="4,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Foreground" Value="#6E6E73" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Surface" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F7F7F9" /></Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Surface" Property="Background" Value="#FFF4EB" />
                                                <Setter Property="Foreground" Value="#FF7A00" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemTemplate">
                    <Setter.Value><DataTemplate><TextBlock Text="{Binding}" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></DataTemplate></Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="EditorRoot" Width="280" Height="400" Background="Transparent" Focusable="True"
          PreviewKeyDown="OnKeyDown" PreviewMouseDown="Editor_PreviewMouseDown" PreviewMouseUp="Editor_PreviewMouseUp">
        <Border x:Name="EditorSurface" Padding="18,16,18,14" Background="White" BorderBrush="#E9E9ED" BorderThickness="1" CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26" /><RowDefinition Height="12" /><RowDefinition Height="42" />
                    <RowDefinition Height="14" /><RowDefinition Height="18" /><RowDefinition Height="6" /><RowDefinition Height="32" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="18" /><RowDefinition Height="6" /><RowDefinition Height="32" />
                    <RowDefinition Height="14" /><RowDefinition Height="18" /><RowDefinition Height="6" /><RowDefinition Height="32" />
                    <RowDefinition Height="*" /><RowDefinition Height="28" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="编辑规则" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="CloseEditorButton" Width="24" Height="24" Padding="0" HorizontalAlignment="Right" Style="{StaticResource TextButton}" Click="Close_Click" AutomationProperties.Name="关闭编辑规则">
                        <Path Width="9" Height="9" Data="M0,0 L9,9 M9,0 L0,9" Stroke="#8E8E93" StrokeThickness="1.3" />
                    </Button>
                </Grid>
                <Grid x:Name="RuleStatusRow" Grid.Row="2">
                    <Border Background="#F7F8FA" CornerRadius="8" />
                    <StackPanel Margin="9,0,40,0" VerticalAlignment="Center">
                        <TextBlock Text="启用规则" FontSize="12" FontWeight="Medium" />
                        <TextBlock Text="启用后将在设定时间自动执行" FontSize="9" Foreground="#9B9BA1" Margin="0,3,0,0" />
                    </StackPanel>
                    <ToggleButton x:Name="RuleStatusSwitch" Margin="0,0,9,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Style="{StaticResource AutomaticRuleSwitchStyle}" IsChecked="{Binding EditorIsEnabled, Mode=TwoWay}"
                                  AutomationProperties.Name="规则状态" AutomationProperties.HelpText="{Binding EditorStatusDisplay}" />
                </Grid>
                <TextBlock Grid.Row="4" Text="重复" FontSize="13" FontWeight="Medium" />
                <Border Grid.Row="6" Background="#F8F8FA" BorderBrush="#E8E8ED" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ToggleButton Content="每天" Style="{StaticResource RepeatButton}" IsChecked="{Binding IsDaily, Mode=OneWay}" Command="{Binding SelectDailyCommand}" />
                        <ToggleButton Grid.Column="1" Content="自定义" Style="{StaticResource RepeatButton}" IsChecked="{Binding IsCustom, Mode=OneWay}" Command="{Binding SelectCustomCommand}" />
                    </Grid>
                </Border>
                <ItemsControl x:Name="WeekdaySelector" Grid.Row="7" Margin="0,6,0,0" ItemsSource="{Binding Weekdays}" Visibility="{Binding IsCustom, Converter={StaticResource BoolVisibility}}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><ToggleButton Content="{Binding ChineseName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource WeekdayButton}" HorizontalAlignment="Center" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Row="9" Text="时间" FontSize="13" FontWeight="Medium" />
                <Grid Grid.Row="11">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button x:Name="StartTimeField" Content="{Binding EditorStartText}" Style="{StaticResource TimeField}" Click="StartTime_Click" AutomationProperties.Name="开始时间" />
                    <TextBlock Grid.Column="1" Text="—" Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Button x:Name="EndTimeField" Grid.Column="2" Content="{Binding EditorEndText}" Style="{StaticResource TimeField}" Click="EndTime_Click" AutomationProperties.Name="结束时间" />
                </Grid>
                <TextBlock Grid.Row="13" FontSize="13" FontWeight="Medium"><Run Text="绑定目标" /><Run Text="（可选）" FontSize="11" FontWeight="Normal" Foreground="#8E8E93" /></TextBlock>
                <Button x:Name="TargetField" Grid.Row="15" Style="{StaticResource TimeField}" FontSize="12" FontWeight="Normal" Foreground="#8E8E93" Click="Target_Click" AutomationProperties.Name="绑定目标" />
                <TextBlock Grid.Row="16" Text="{Binding ValidationMessage}" FontSize="10" Foreground="#E34B4B" TextTrimming="CharacterEllipsis" ToolTip="{Binding ValidationMessage}" VerticalAlignment="Center" />
                <Button x:Name="DeleteRuleButton" Grid.Row="17" HorizontalAlignment="Left" Padding="0,4,6,4" Style="{StaticResource TextButton}" Click="Delete_Click" AutomationProperties.Name="删除规则">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="12" Height="14" Data="M1,3 L11,3 M4,1 L8,1 M2,3 L3,13 L9,13 L10,3 M5,5 L5,11 M7,5 L7,11" Stroke="#E34B4B" StrokeThickness="1.2" StrokeLineJoin="Round" />
                        <TextBlock Text="删除" FontSize="12" Foreground="#E34B4B" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        <Canvas x:Name="PickerLayer" Panel.ZIndex="10">
            <Border x:Name="TimePickerSurface" Width="150" Background="White" BorderBrush="#E8E8ED" BorderThickness="1" CornerRadius="9" Padding="6" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="小时" FontSize="10" Foreground="#A1A1A6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="分钟" FontSize="10" Foreground="#A1A1A6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Grid.RowSpan="2" Background="#F1F1F4" />
                    <ListBox x:Name="HoursList" Grid.Row="1" Style="{StaticResource PickerList}" SelectionChanged="Time_SelectionChanged" />
                    <ListBox x:Name="MinutesList" Grid.Row="1" Grid.Column="2" Style="{StaticResource PickerList}" SelectionChanged="Time_SelectionChanged" />
                </Grid>
            </Border>
            <Border x:Name="TargetPickerSurface" Width="242" Background="White" BorderBrush="#E8E8ED" BorderThickness="1" CornerRadius="9" Padding="5" Visibility="Collapsed">
                <ListBox x:Name="TargetsList" Style="{StaticResource PickerList}" ItemsSource="{Binding Targets}" SelectionChanged="Target_SelectionChanged">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Canvas>
    </Grid>
</Window>
