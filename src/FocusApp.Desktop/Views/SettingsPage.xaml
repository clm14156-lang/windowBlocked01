<UserControl x:Class="FocusApp.Desktop.Views.SettingsPage"
             x:Name="SettingsPageRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:FocusApp.Core;assembly=FocusApp.Core"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             Background="{DynamicResource BackgroundPrimary}"
             FontFamily="{DynamicResource FontFamilyPrimary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="SettingsHairlineBrush" Color="#EFEFF1" Opacity="0.5" />
        <Color x:Key="SettingsRowHoverColor">#FBFBFC</Color>

        <Style x:Key="SettingsToggleRowStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="views:RippleEffect.IsEnabled" Value="True" />
            <Setter Property="Height" Value="63" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid x:Name="RowBackground">
                            <Grid.Background>
                                <SolidColorBrush x:Name="RowHoverBrush" Color="Transparent" />
                            </Grid.Background>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="76" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="34"
                                    Height="34"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource BackgroundSecondary}"
                                    CornerRadius="17">
                                <TextBlock x:Name="SettingIcon"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="20"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Text="{Binding Icon}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimary}"
                                               Text="{Binding Title}" />
                                    <StackPanel x:Name="VipRestrictionBadge"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Visibility="{Binding IsVipRestricted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   Text="&#xE72E;" />
                                        <TextBlock Margin="4,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   Text="{DynamicResource SettingsVipExclusive}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="12"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Text="{Binding Description}" />
                            </StackPanel>
                            <Grid Grid.Column="2"
                                  Width="35"
                                  Height="20"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Border x:Name="ToggleTrack"
                                        Background="{DynamicResource BorderPrimary}"
                                        CornerRadius="12" />
                                <Ellipse x:Name="ToggleThumb"
                                         Width="17"
                                         Height="17"
                                         Margin="2"
                                         HorizontalAlignment="Left"
                                         Fill="{DynamicResource SurfacePrimary}">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="3" Opacity="0.16" ShadowDepth="1" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <Border Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Height="1"
                                    Margin="14,0"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource SettingsHairlineBrush}"
                                    Visibility="{Binding HasSeparator, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="RowHoverBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource SettingsRowHoverColor}"
                                                        Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="RowHoverBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="Transparent"
                                                        Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource AccentPrimary}" />
                                <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SettingIcon" Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource AccentHover}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource BackgroundSecondary}" />
                                <Setter TargetName="ToggleTrack" Property="Opacity" Value="0.55" />
                                <Setter TargetName="ToggleThumb" Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsEntryRowStyle" TargetType="{x:Type Button}">
            <Setter Property="views:RippleEffect.IsEnabled" Value="True" />
            <Setter Property="Height" Value="63" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="RowBackground">
                            <Grid.Background>
                                <SolidColorBrush x:Name="RowHoverBrush" Color="Transparent" />
                            </Grid.Background>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="66" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="34"
                                    Height="34"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource BackgroundSecondary}"
                                    CornerRadius="17">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="20"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Text="{Binding Icon}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimary}"
                                           Text="{Binding Title}" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="12"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Text="{Binding Description}" />
                                <StackPanel.RenderTransform><TranslateTransform Y="-1" /></StackPanel.RenderTransform>
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="&#xE76C;" />
                            <Border Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Height="1"
                                    Margin="14,0"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource SettingsHairlineBrush}"
                                    Visibility="{Binding HasSeparator, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="RowHoverBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource SettingsRowHoverColor}"
                                                        Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="RowHoverBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="Transparent"
                                                        Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsAddRuleButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource RecentTargetSelectedBackground}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource RecentTargetSelectedPressedBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsRuleSwitchStyle"
               TargetType="{x:Type ToggleButton}"
               BasedOn="{StaticResource AutomaticRuleSwitchStyle}" />

        <Style x:Key="SettingsRuleMoreButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="MoreBackground" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MoreBackground" Property="Background" Value="{DynamicResource ControlHoverBackground}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="MoreBackground" Property="Background" Value="{DynamicResource ControlPressedBackground}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SettingsRuleMenuTextTemplate">
            <TextBlock VerticalAlignment="Center"
                       FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                       Text="{Binding}" />
        </DataTemplate>

        <Style x:Key="SettingsRuleMenuItemStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ThemedTextButtonBaseStyle}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="ContentTemplate" Value="{StaticResource SettingsRuleMenuTextTemplate}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="MenuItemBackground" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MenuItemBackground" Property="Background" Value="{DynamicResource ControlHoverBackground}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="MenuItemBackground" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsAppearanceIconStyle" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource BackgroundSecondary}" />
            <Setter Property="CornerRadius" Value="17" />
        </Style>
        <Style x:Key="SettingsAppearanceRowStyle" TargetType="{x:Type Button}">
            <Setter Property="views:RippleEffect.IsEnabled" Value="True" />
            <Setter Property="views:RippleEffect.CornerRadius" Value="10,10,0,0" />
            <Setter Property="Height" Value="63" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="RowBackground" Background="{TemplateBinding Background}" CornerRadius="10,10,0,0">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="#FBFBFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsAppearanceSelectorStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Width" Value="110" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="SelectorBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectorBorder" Property="Background" Value="#F9FAFB" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="SelectorBorder" Property="Background" Value="#F3F4F6" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsAppearanceMenuItemStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SettingsRuleMenuItemStyle}">
            <Setter Property="ContentTemplate" Value="{x:Null}" />
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyPrimary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <TextBlock Margin="32,-15,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Panel.ZIndex="2"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"
                   Text="{DynamicResource NavigationSettings}" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden">
            <StackPanel Width="636" Margin="31,42,0,24" HorizontalAlignment="Left">
                <TextBlock Height="20" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextUnit}" Text="{DynamicResource SettingsGeneralSection}">
                    <TextBlock.RenderTransform><TranslateTransform Y="-2" /></TextBlock.RenderTransform>
                </TextBlock>
                <Border Margin="0,6,0,0" Background="{DynamicResource SurfacePrimary}" BorderBrush="{StaticResource SettingsHairlineBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding GeneralToggleItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton AutomationProperties.Name="{Binding Title}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Style="{StaticResource SettingsToggleRowStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Margin="14,0,14,12"
                                Background="{DynamicResource SurfacePrimary}"
                                BorderBrush="{DynamicResource BorderPrimary}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AutomaticBlockingItem.IsEnabled}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid Height="54">
                                    <StackPanel Margin="22,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource AutomaticRulesTitle}" />
                                        <TextBlock Margin="0,3,0,0" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource AutomaticRulesDailyLimitHint}" />
                                    </StackPanel>
                                    <Button Margin="0,0,18,0" HorizontalAlignment="Right" AutomationProperties.Name="{DynamicResource AutomaticRuleAddButton}" Command="{Binding OpenRuleModalCommand}" Style="{StaticResource SettingsAddRuleButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource AccentPrimary}" Text="+" />
                                            <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource AccentPrimary}" Text="{DynamicResource AutomaticRuleAddButton}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource AutomaticRulesEmpty}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding AutomaticRules.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl x:Name="AutomaticRulesList" ItemsSource="{Binding AutomaticRules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="AutomaticRuleRow" Height="44"
                                                    views:RippleEffect.IsEnabled="True"
                                                    Margin="14,0"
                                                    CornerRadius="7"
                                                    MouseEnter="AutomaticRuleRow_MouseEnter">
                                                <Border.Style>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource SettingsHairlineBrush}" /></Trigger>
                                                            <DataTrigger Binding="{Binding IsNavigationHighlighted}" Value="True"><Setter Property="Background" Value="{StaticResource SettingsHairlineBrush}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid Margin="8,0,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /><ColumnDefinition Width="38" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.ColumnSpan="4" Height="1" VerticalAlignment="Top" Background="{DynamicResource BorderPrimary}" />
                                                    <Grid Grid.ColumnSpan="2">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                        <Ellipse x:Name="RuleStatusDot" Grid.Column="0" Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="{x:Type Ellipse}">
                                                                    <Setter Property="Fill" Value="{DynamicResource AccentPrimary}" />
                                                                    <Style.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="False"><Setter Property="Fill" Value="{DynamicResource TextWeak}" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock x:Name="RuleTargetText" FontSize="{DynamicResource BodyMediumFontSize}" FontWeight="{DynamicResource BodyMediumFontWeight}"
                                                                       Text="{Binding TargetDisplayText}" TextTrimming="CharacterEllipsis"
                                                                       Visibility="{Binding HasDisplayTarget, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock.Style><Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                                                    <Style.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextWeak}" /></DataTrigger></Style.Triggers>
                                                                </Style></TextBlock.Style>
                                                            </TextBlock>
                                                            <Grid x:Name="RuleScheduleLine" ClipToBounds="True">
                                                                <Grid.Style><Style TargetType="Grid">
                                                                    <Setter Property="Margin" Value="0" />
                                                                    <Style.Triggers><DataTrigger Binding="{Binding HasDisplayTarget}" Value="True"><Setter Property="Margin" Value="0,2,0,0" /></DataTrigger></Style.Triggers>
                                                                </Style></Grid.Style>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                <TextBlock x:Name="RuleTimeText" Text="{Binding TimeRangeText}" VerticalAlignment="Center">
                                                                    <TextBlock.Style><Style TargetType="TextBlock">
                                                                        <Setter Property="FontSize" Value="{DynamicResource BodyMediumFontSize}" />
                                                                        <Setter Property="FontWeight" Value="{DynamicResource BodyMediumFontWeight}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasDisplayTarget}" Value="True">
                                                                                <Setter Property="FontSize" Value="{DynamicResource SecondaryFontSize}" />
                                                                                <Setter Property="FontWeight" Value="{DynamicResource SecondaryFontWeight}" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextWeak}" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style></TextBlock.Style>
                                                                </TextBlock>
                                                                <ItemsControl x:Name="RuleRepeatTags" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                                                              ItemsSource="{Binding ScheduleRepeatDays}" ClipToBounds="True" IsHitTestVisible="False"
                                                                              Visibility="{Binding HasScheduleRepeat, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,6,0" /></Style></ItemsControl.ItemContainerStyle>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border x:Name="RuleDayTag" Height="22" Padding="9,0" CornerRadius="11" Background="{DynamicResource SurfacePrimary}"
                                                                                    BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1">
                                                                                <TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                           FontSize="{DynamicResource SecondaryFontSize}" FontWeight="{DynamicResource SecondaryFontWeight}">
                                                                                    <TextBlock.Style><Style TargetType="TextBlock">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                                                                        <Style.Triggers><DataTrigger Binding="{Binding DataContext.IsEnabled, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextWeak}" /></DataTrigger></Style.Triggers>
                                                                                    </Style></TextBlock.Style>
                                                                                </TextBlock>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>
                                                    <ToggleButton Grid.Column="2"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  AutomationProperties.Name="{Binding RepeatText}"
                                                                  IsChecked="{Binding IsEnabled}"
                                                                  PreviewMouseLeftButtonDown="RuleSwitch_PreviewMouseLeftButtonDown"
                                                                  Style="{StaticResource SettingsRuleSwitchStyle}" />
                                                    <ToggleButton x:Name="RuleMoreButton"
                                                                  Grid.Column="3"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  AutomationProperties.Name="{DynamicResource AutomaticRuleMoreActions}"
                                                                  Style="{StaticResource SettingsRuleMoreButtonStyle}">
                                                        <TextBlock Margin="0,-4,0,0" FontSize="15" FontWeight="Medium" Text="···" />
                                                    </ToggleButton>
                                                    <Popup AllowsTransparency="True"
                                                           IsOpen="{Binding IsChecked, ElementName=RuleMoreButton, Mode=TwoWay}"
                                                           Placement="Left"
                                                           PlacementTarget="{Binding ElementName=RuleMoreButton}"
                                                           PopupAnimation="Fade"
                                                           StaysOpen="False">
                                                        <Border Width="126"
                                                                Padding="6"
                                                                Background="{DynamicResource SurfacePrimary}"
                                                                BorderBrush="{DynamicResource OverlayBorder}"
                                                                BorderThickness="1"
                                                                CornerRadius="10">
                                                            <Border.Effect><DropShadowEffect BlurRadius="12" Direction="270" Opacity="0.10" ShadowDepth="2" /></Border.Effect>
                                                            <StackPanel>
                                                                <Button Click="RuleMenuItem_Click"
                                                                        Command="{Binding DataContext.EditRuleCommand, Source={x:Reference SettingsPageRoot}}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="{DynamicResource AutomaticRuleEdit}"
                                                                        Style="{StaticResource SettingsRuleMenuItemStyle}"
                                                                        Tag="{Binding ElementName=RuleMoreButton}" />
                                                                <Button Click="RuleMenuItem_Click"
                                                                        Command="{Binding DataContext.DeleteRuleCommand, Source={x:Reference SettingsPageRoot}}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="{DynamicResource AutomaticRuleDelete}"
                                                                        Foreground="{DynamicResource Danger}"
                                                                        Style="{StaticResource SettingsRuleMenuItemStyle}"
                                                                        Tag="{Binding ElementName=RuleMoreButton}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Grid Height="63">
                            <ToggleButton AutomationProperties.Name="{Binding ForcedModeItem.Title}"
                                          DataContext="{Binding ForcedModeItem}"
                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                          Style="{StaticResource SettingsToggleRowStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Height="20" Margin="0,25,0,0" Style="{DynamicResource SectionTitleTextStyle}" Foreground="{DynamicResource TextUnit}" Text="{DynamicResource SettingsFocusAppearanceSection}">
                    <TextBlock.RenderTransform><TranslateTransform X="1" Y="-4" /></TextBlock.RenderTransform>
                </TextBlock>
                <!-- Character selection remains a preview; the theme selector uses the saved focus setting. -->
                <Border x:Name="FocusAppearanceCard" Margin="0,6,0,0" Background="{DynamicResource SurfacePrimary}" BorderBrush="{StaticResource SettingsHairlineBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <Button x:Name="FocusCharacterPreview" Style="{StaticResource SettingsAppearanceRowStyle}" Command="{Binding FocusCharacterPicker.OpenCommand}" AutomationProperties.Name="{DynamicResource SettingsFocusCharacter}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="66" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SettingsAppearanceIconStyle}">
                                    <Path Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 10,1 A 4,4 0 1 1 10,9 A 4,4 0 1 1 10,1 M 2,20 L 2,18 C 2,8 18,8 18,18 L 18,20" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{DynamicResource BodyMediumTextStyle}" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource SettingsFocusCharacter}" />
                                    <TextBlock Margin="0,2,0,0" Style="{DynamicResource SecondaryTextStyle}" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource SettingsFocusCharacterDescription}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{DynamicResource BodyTextStyle}" Foreground="{DynamicResource TextPrimary}" Text="{Binding FocusCharacterName}" />
                                <TextBlock Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="&#xE76C;" />
                            </Grid>
                        </Button>
                        <Border Height="1" Margin="14,0" Background="{StaticResource SettingsHairlineBrush}" />
                        <Grid x:Name="FocusThemeRow" Height="63" Background="Transparent" views:RippleEffect.IsEnabled="True">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsAppearanceIconStyle}">
                                <Path Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M 6,1 L 1,4 L 3,9 L 6,7 L 6,20 L 16,20 L 16,7 L 19,9 L 21,4 L 16,1 C 15,5 7,5 6,1 Z" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{DynamicResource BodyMediumTextStyle}" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource SettingsFocusTheme}" />
                                <TextBlock Margin="0,2,0,0" Style="{DynamicResource SecondaryTextStyle}" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource SettingsFocusThemeDescription}" />
                            </StackPanel>
                            <ToggleButton x:Name="FocusThemePreviewSelector" Grid.Column="2" Margin="0,0,23,0" VerticalAlignment="Center" Style="{StaticResource SettingsAppearanceSelectorStyle}" AutomationProperties.Name="{DynamicResource SettingsFocusTheme}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Foreground="{DynamicResource TextPrimary}">
                                        <TextBlock.Style><Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
                                            <Setter Property="FontWeight" Value="{DynamicResource BodyFontWeight}" />
                                            <Setter Property="Text" Value="{DynamicResource SettingsFocusThemeSystem}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FocusTheme}" Value="{x:Static core:FocusThemeMode.Light}"><Setter Property="Text" Value="{DynamicResource SettingsFocusThemeLight}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding FocusTheme}" Value="{x:Static core:FocusThemeMode.Dark}"><Setter Property="Text" Value="{DynamicResource SettingsFocusThemeDark}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style></TextBlock.Style>
                                    </TextBlock>
                                    <Path Width="10" Height="5" Margin="12,0,0,0" VerticalAlignment="Center" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" Data="M 0,0 L 5,5 L 10,0" />
                                </StackPanel>
                            </ToggleButton>
                            <Popup x:Name="FocusThemePreviewPopup" Grid.Column="2" Placement="Bottom" PlacementTarget="{Binding ElementName=FocusThemePreviewSelector}" HorizontalOffset="0" VerticalOffset="2" AllowsTransparency="True" StaysOpen="False" IsOpen="{Binding IsChecked, ElementName=FocusThemePreviewSelector, Mode=TwoWay}">
                                <Border x:Name="FocusThemeMenuSurface" Margin="10" Width="110" Padding="4" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="10" TextElement.FontFamily="{DynamicResource FontFamilyPrimary}">
                                    <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.12" /></Border.Effect>
                                    <StackPanel>
                                        <Button x:Name="FocusThemeLightOption" Command="{Binding SelectFocusThemeCommand}" CommandParameter="{x:Static core:FocusThemeMode.Light}"
                                                Click="FocusThemeOption_Click" AutomationProperties.Name="{DynamicResource SettingsFocusThemeLight}">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SettingsAppearanceMenuItemStyle}">
                                                <Style.Triggers><DataTrigger Binding="{Binding FocusTheme}" Value="{x:Static core:FocusThemeMode.Light}"><Setter Property="Background" Value="#F3F4F6" /></DataTrigger></Style.Triggers>
                                            </Style></Button.Style>
                                            <Grid>
                                                <TextBlock VerticalAlignment="Center" Style="{DynamicResource BodyTextStyle}" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource SettingsFocusThemeLight}" />
                                                <Path Width="12" Height="9" HorizontalAlignment="Right" VerticalAlignment="Center" Stroke="#606873" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 0,4 L 4,8 L 11,1">
                                                    <Path.Style><Style TargetType="Path">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers><DataTrigger Binding="{Binding FocusTheme}" Value="{x:Static core:FocusThemeMode.Light}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                    </Style></Path.Style>
                                                </Path>
                                            </Grid>
                                        </Button>
                                        <Button x:Name="FocusThemeDarkOption" Command="{Binding SelectFocusThemeCommand}" CommandParameter="{x:Static core:FocusThemeMode.Dark}"
                                                Click="FocusThemeOption_Click" AutomationProperties.Name="{DynamicResource SettingsFocusThemeDark}">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SettingsAppearanceMenuItemStyle}">
                                                <Style.Triggers><DataTrigger Binding="{Binding FocusTheme}" Value="{x:Static core:FocusThemeMode.Dark}"><Setter Property="Background" Value="#F3F4F6" /></DataTrigger></Style.Triggers>
                                            </Style></Button.Style>
                                            <Grid>
                                                <TextBlock VerticalAlignment="Center" Style="{DynamicResource BodyTextStyle}" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource SettingsFocusThemeDark}" />
                                                <Path Width="12" Height="9" HorizontalAlignment="Right" VerticalAlignment="Center" Stroke="#606873" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 0,4 L 4,8 L 11,1">
                                                    <Path.Style><Style TargetType="Path">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers><DataTrigger Binding="{Binding FocusTheme}" Value="{x:Static core:FocusThemeMode.Dark}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                    </Style></Path.Style>
                                                </Path>
                                            </Grid>
                                        </Button>
                                        <Button x:Name="FocusThemeSystemOption" Command="{Binding SelectFocusThemeCommand}" CommandParameter="{x:Static core:FocusThemeMode.System}"
                                                Click="FocusThemeOption_Click" AutomationProperties.Name="{DynamicResource SettingsFocusThemeSystem}">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SettingsAppearanceMenuItemStyle}">
                                                <Style.Triggers><DataTrigger Binding="{Binding FocusTheme}" Value="{x:Static core:FocusThemeMode.System}"><Setter Property="Background" Value="#F3F4F6" /></DataTrigger></Style.Triggers>
                                            </Style></Button.Style>
                                            <Grid>
                                                <TextBlock VerticalAlignment="Center" Style="{DynamicResource BodyTextStyle}" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource SettingsFocusThemeSystem}" />
                                                <Path Width="12" Height="9" HorizontalAlignment="Right" VerticalAlignment="Center" Stroke="#606873" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 0,4 L 4,8 L 11,1">
                                                    <Path.Style><Style TargetType="Path">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers><DataTrigger Binding="{Binding FocusTheme}" Value="{x:Static core:FocusThemeMode.System}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                    </Style></Path.Style>
                                                </Path>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Height="20" Margin="0,25,0,0" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextUnit}" Text="{DynamicResource SettingsDataSection}">
                    <TextBlock.RenderTransform><TranslateTransform X="1" Y="-4" /></TextBlock.RenderTransform>
                </TextBlock>
                <Border Margin="0,6,0,0" Background="{DynamicResource SurfacePrimary}" BorderBrush="{StaticResource SettingsHairlineBrush}" BorderThickness="1" CornerRadius="10">
                    <ItemsControl ItemsSource="{Binding EntryItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button AutomationProperties.Name="{Binding Title}" Command="{Binding DataContext.ActivateEntryCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding}" Style="{StaticResource SettingsEntryRowStyle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
