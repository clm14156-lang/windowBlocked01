<UserControl x:Class="FocusApp.Desktop.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundPrimary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="SettingsToggleRowStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Height" Value="59" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid x:Name="RowBackground" Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="23"
                                       Foreground="{DynamicResource AccentPrimary}"
                                       Text="{Binding Icon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="{Binding Title}" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Text="{Binding Description}" />
                            </StackPanel>
                            <Grid Grid.Column="2"
                                  Width="40"
                                  Height="23"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Border x:Name="ToggleTrack"
                                        Background="{DynamicResource BorderPrimary}"
                                        CornerRadius="12" />
                                <Ellipse x:Name="ToggleThumb"
                                         Width="19"
                                         Height="19"
                                         Margin="2"
                                         HorizontalAlignment="Left"
                                         Fill="{DynamicResource SurfacePrimary}">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="3" Opacity="0.16" ShadowDepth="1" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <Border Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Height="1"
                                    Margin="18,0"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource BorderPrimary}"
                                    Visibility="{Binding HasSeparator, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource AccentPrimary}" />
                                <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource AccentHover}" />
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                <Setter TargetName="ToggleTrack" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsEntryRowStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="54" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="RowBackground" Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="66" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="22"
                                       Foreground="{DynamicResource AccentPrimary}"
                                       Text="{Binding Icon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="{Binding Title}" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Text="{Binding Description}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="&#xE76C;" />
                            <Border Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Height="1"
                                    Margin="18,0"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource BorderPrimary}"
                                    Visibility="{Binding HasSeparator, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource AccentTint}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource AccentTint}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Canvas>
        <TextBlock Canvas.Left="26"
                   Canvas.Top="-14"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Text="{DynamicResource NavigationSettings}" />

        <TextBlock Canvas.Left="26"
                   Canvas.Top="47"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondary}"
                   Text="{DynamicResource SettingsGeneralSection}" />
        <Border Canvas.Left="26"
                Canvas.Top="73"
                Width="646"
                Height="354"
                Background="{DynamicResource SurfacePrimary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="1"
                CornerRadius="10">
            <Border.Clip>
                <RectangleGeometry Rect="0,0,646,354" RadiusX="10" RadiusY="10" />
            </Border.Clip>
            <ItemsControl ItemsSource="{Binding ToggleItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton AutomationProperties.Name="{Binding Title}"
                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                      Style="{StaticResource SettingsToggleRowStyle}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Canvas.Left="26"
                   Canvas.Top="452"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondary}"
                   Text="{DynamicResource SettingsDataSection}" />
        <Border Canvas.Left="26"
                Canvas.Top="475"
                Width="646"
                Height="108"
                Background="{DynamicResource SurfacePrimary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="1"
                CornerRadius="10">
            <Border.Clip>
                <RectangleGeometry Rect="0,0,646,108" RadiusX="10" RadiusY="10" />
            </Border.Clip>
            <ItemsControl ItemsSource="{Binding EntryItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button AutomationProperties.Name="{Binding Title}"
                                Command="{Binding DataContext.ActivateEntryCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource SettingsEntryRowStyle}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Canvas>
</UserControl>
