<UserControl x:Class="FocusApp.Desktop.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundPrimary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="SettingsHairlineBrush" Color="#EFEFF1" Opacity="0.5" />

        <Style x:Key="SettingsToggleRowStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Height" Value="63" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid x:Name="RowBackground" Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="76" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="34"
                                    Height="34"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource BackgroundSecondary}"
                                    CornerRadius="17">
                                <TextBlock x:Name="SettingIcon"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="20"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Text="{Binding Icon}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{Binding Title}" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Text="{Binding Description}" />
                            </StackPanel>
                            <Grid Grid.Column="2"
                                  Width="35"
                                  Height="20"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Border x:Name="ToggleTrack"
                                        Background="{DynamicResource BorderPrimary}"
                                        CornerRadius="12" />
                                <Ellipse x:Name="ToggleThumb"
                                         Width="17"
                                         Height="17"
                                         Margin="2"
                                         HorizontalAlignment="Left"
                                         Fill="{DynamicResource SurfacePrimary}">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="3" Opacity="0.16" ShadowDepth="1" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <Border Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Height="1"
                                    Margin="14,0"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource SettingsHairlineBrush}"
                                    Visibility="{Binding HasSeparator, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource AccentPrimary}" />
                                <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SettingIcon" Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource AccentHover}" />
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                <Setter TargetName="ToggleTrack" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsEntryRowStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="63" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="RowBackground" Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="66" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="34"
                                    Height="34"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource BackgroundSecondary}"
                                    CornerRadius="17">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="20"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Text="{Binding Icon}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{Binding Title}" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Text="{Binding Description}" />
                                <StackPanel.RenderTransform><TranslateTransform Y="-1" /></StackPanel.RenderTransform>
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="&#xE76C;" />
                            <Border Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Height="1"
                                    Margin="14,0"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource SettingsHairlineBrush}"
                                    Visibility="{Binding HasSeparator, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource AccentTint}" />
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource AccentTint}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsAddRuleButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentTint}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsRuleIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="IconBorder" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="IconBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="IconBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <TextBlock Margin="32,-15,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Panel.ZIndex="2"
                   FontSize="21"
                   FontWeight="SemiBold"
                   Text="{DynamicResource NavigationSettings}" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden">
            <StackPanel Width="636" Margin="31,42,0,24" HorizontalAlignment="Left">
                <TextBlock Height="20" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource SettingsGeneralSection}">
                    <TextBlock.RenderTransform><TranslateTransform Y="-2" /></TextBlock.RenderTransform>
                </TextBlock>
                <Border Margin="0,6,0,0" Background="{DynamicResource SurfacePrimary}" BorderBrush="{StaticResource SettingsHairlineBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding GeneralToggleItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton AutomationProperties.Name="{Binding Title}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Style="{StaticResource SettingsToggleRowStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Margin="14,0,14,12"
                                Background="{DynamicResource SurfacePrimary}"
                                BorderBrush="{DynamicResource BorderPrimary}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AutomaticBlockingItem.IsEnabled}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid Height="54">
                                    <TextBlock Margin="22,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{DynamicResource AutomaticRulesTitle}" />
                                    <Button Margin="0,0,18,0" HorizontalAlignment="Right" AutomationProperties.Name="{DynamicResource AutomaticRuleAddButton}" Command="{Binding OpenRuleModalCommand}" Style="{StaticResource SettingsAddRuleButtonStyle}">
                                        <StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,7,0" FontSize="17" Text="+" /><TextBlock VerticalAlignment="Center" Text="{DynamicResource AutomaticRuleAddButton}" /></StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource AutomaticRulesEmpty}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding AutomaticRules.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding AutomaticRules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="44" Margin="22,0,14,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" /><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /><ColumnDefinition Width="38" /><ColumnDefinition Width="38" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.ColumnSpan="6" Height="1" VerticalAlignment="Top" Background="{DynamicResource BorderPrimary}" />
                                                <Ellipse Grid.Column="0" Width="7" Height="7" HorizontalAlignment="Left" Fill="{DynamicResource AccentPrimary}" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" Text="{Binding RepeatText}" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="{DynamicResource FontFamilyNumeric}" FontSize="13" Text="{Binding TimeRangeText}" />
                                                <CheckBox Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsEnabled, Mode=TwoWay}" ToolTip="启用规则" />
                                                <Button Grid.Column="4" AutomationProperties.Name="{DynamicResource AutomaticRuleEdit}" Command="{Binding DataContext.EditRuleCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Style="{StaticResource SettingsRuleIconButtonStyle}" ToolTip="{DynamicResource AutomaticRuleEdit}"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE70F;" /></Button>
                                                <Button Grid.Column="5" AutomationProperties.Name="{DynamicResource AutomaticRuleDelete}" Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Style="{StaticResource SettingsRuleIconButtonStyle}" ToolTip="{DynamicResource AutomaticRuleDelete}"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE74D;" /></Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <ToggleButton AutomationProperties.Name="{Binding ForcedModeItem.Title}" DataContext="{Binding ForcedModeItem}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Style="{StaticResource SettingsToggleRowStyle}" />
                    </StackPanel>
                </Border>

                <TextBlock Height="20" Margin="0,25,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource SettingsDataSection}">
                    <TextBlock.RenderTransform><TranslateTransform X="1" Y="-4" /></TextBlock.RenderTransform>
                </TextBlock>
                <Border Margin="0,6,0,0" Background="{DynamicResource SurfacePrimary}" BorderBrush="{StaticResource SettingsHairlineBrush}" BorderThickness="1" CornerRadius="10">
                    <ItemsControl ItemsSource="{Binding EntryItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button AutomationProperties.Name="{Binding Title}" Command="{Binding DataContext.ActivateEntryCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding}" Style="{StaticResource SettingsEntryRowStyle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
