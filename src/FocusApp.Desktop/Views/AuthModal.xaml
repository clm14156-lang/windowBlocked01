<UserControl x:Class="FocusApp.Desktop.Views.AuthModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusApp.Desktop.Views"
             views:FocusThemeScope.ResourcePrefix="AuthTheme"
             Width="350"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             FontFamily="{DynamicResource FontFamilyPrimary}"
             KeyboardNavigation.TabNavigation="Cycle"
             IsVisibleChanged="AuthModal_IsVisibleChanged"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="../Resources/Typography.xaml"/><ResourceDictionary Source="../Resources/Styles.xaml"/>
            <ResourceDictionary Source="../Resources/AuthTheme.Light.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="AccentPrimary" Color="#FF7A00"/>
        <Style x:Key="LoginFieldStyle" TargetType="{x:Type Border}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="16,0,8,0" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LoginPasswordUtilityButton" TargetType="Button" BasedOn="{StaticResource HomeLinkButtonStyle}">
            <Setter Property="Width" Value="24"/><Setter Property="Height" Value="28"/><Setter Property="MinHeight" Value="28"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Style.Triggers><DataTrigger Binding="{Binding LoginPassword}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="LoginTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="LoginIconStyle" TargetType="{x:Type Path}">
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{DynamicResource TextSecondary}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="LoginLinkStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource HomeLinkButtonStyle}">
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource BodyMediumFontWeight}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LoginSubmitStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryActionButtonStyle}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="{DynamicResource ButtonEmphasisFontSize}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#FF8B24"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#E86D00"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.42"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource AccentPressed}" />
                                <Setter TargetName="ButtonChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsLoggingIn}" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource AuthLoadingBackground}" />
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="1" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource BorderPrimary}"
            BorderThickness="1"
            CornerRadius="16"
            MouseDown="AuthCard_MouseDown">
        <Grid>
            <StackPanel Margin="20,26,20,18">
                <TextBlock HorizontalAlignment="Center"
                           Style="{StaticResource PageTitleTextStyle}"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="{DynamicResource AuthLoginTitle}" />
                <TextBlock Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           Style="{StaticResource BodyTextStyle}"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="{DynamicResource AuthLoginSubtitle}" />

                <StackPanel Margin="0,18,0,0" IsEnabled="{Binding IsIdle}">
                    <Border Style="{StaticResource LoginFieldStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Style="{StaticResource LoginIconStyle}"
                                  Data="M 2,4 H 15 Q 16,4 16,5 V 12 Q 16,13 15,13 H 2 Q 1,13 1,12 V 5 Q 1,4 2,4 M 1,5 L 8.5,10 L 16,5" />
                            <TextBox x:Name="LoginEmailTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource LoginTextBoxStyle}"
                                     AutomationProperties.Name="{DynamicResource AuthEmailPlaceholder}"
                                     Text="{Binding LoginAccount, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{DynamicResource AuthEmailPlaceholder}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BodyTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LoginAccount}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Border x:Name="LoginPasswordField" Margin="0,12,0,0" Style="{StaticResource LoginFieldStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Style="{StaticResource LoginIconStyle}"
                                  Data="M 4,8 V 6 A 4.5,4.5 0 0 1 13,6 V 8 M 4,8 H 13 Q 15,8 15,10 V 14 Q 15,16 13,16 H 4 Q 2,16 2,14 V 10 Q 2,8 4,8 Z" />
                            <PasswordBox x:Name="LoginPasswordBox"
                                         Grid.Column="1" Padding="0"
                                         VerticalContentAlignment="Center"
                                         AutomationProperties.Name="{DynamicResource AuthPasswordPlaceholder}"
                                         Background="{DynamicResource TransparentBrush}"
                                         BorderThickness="0"
                                         FontSize="{DynamicResource BodyFontSize}"
                                         Foreground="{DynamicResource TextPrimary}"
                                         PasswordChanged="LoginPasswordBox_PasswordChanged" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{DynamicResource AuthPasswordPlaceholder}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BodyTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LoginPassword}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button x:Name="LoginPasswordClearButton" Grid.Column="2" Style="{StaticResource LoginPasswordUtilityButton}"
                                    Click="ClearLoginPassword_Click" AutomationProperties.Name="清空密码">
                                <Path Width="8" Height="8" Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Button>
                            <Button x:Name="LoginRecoveryButton" Grid.Column="3" MinHeight="28" Height="28" Padding="4,0,2,0"
                                    Content="{DynamicResource AuthForgotPassword}" Command="{Binding OpenRecoveryWebsiteCommand}" Style="{StaticResource LoginLinkStyle}"/>
                        </Grid>
                    </Border>

                    <Grid x:Name="LoginCaptchaArea" Margin="0,12,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RequiresCaptcha}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource LoginFieldStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Style="{StaticResource LoginIconStyle}"
                                      Data="M 8.5,1.5 L 15,4 V 8.2 C 15,12 12,14.5 8.5,16 C 5,14.5 2,12 2,8.2 V 4 Z M 5.5,8.3 L 7.5,10.3 L 11.7,6.3" />
                                <TextBox x:Name="LoginCaptchaTextBox" Grid.Column="1" MaxLength="32" CharacterCasing="Upper"
                                         Text="{Binding CaptchaText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource LoginTextBoxStyle}" AutomationProperties.Name="{DynamicResource AuthCaptchaPlaceholder}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource AuthCaptchaPlaceholder}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CaptchaText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Height="40" CornerRadius="8" Background="{DynamicResource BackgroundSecondary}">
                            <Image x:Name="LoginCaptchaImage" Margin="3" Source="{Binding CaptchaImage}" Stretch="Uniform"
                                   AutomationProperties.Name="{DynamicResource AuthCaptchaImage}" />
                        </Border>
                        <Button Grid.Column="3" Width="32" Height="36" Margin="4,0,0,0"
                                Style="{StaticResource WindowChromeButtonStyle}" Command="{Binding RefreshCaptchaCommand}"
                                AutomationProperties.Name="{DynamicResource AuthRefreshCaptcha}" ToolTip="{DynamicResource AuthRefreshCaptcha}">
                            <Path Data="M 15,7 A 6,6 0 0 0 4,4 L 2,6 M 2,2.5 V 6 H 5.5 M 2,10 A 6,6 0 0 0 13,13 L 15,11 M 11.5,11 H 15 V 14.5"
                                  Style="{StaticResource LoginIconStyle}" />
                        </Button>
                    </Grid>
                </StackPanel>

                <Grid x:Name="LoginFeedback" Margin="3,10,0,0" AutomationProperties.LiveSetting="Polite">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Margin="0,0,8,0" Stroke="{DynamicResource Danger}" VerticalAlignment="Top"
                          Data="M 8.5,1.5 A 7,7 0 1 1 8.5,15.5 A 7,7 0 1 1 8.5,1.5 M 8.5,4.5 V 9 M 8.5,11.7 L 8.5,12">
                        <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource LoginIconStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLoginError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <TextBlock x:Name="LoginStatusMessage" Grid.Column="1" Text="{Binding StatusMessage}"
                               TextWrapping="Wrap" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLoginError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Button x:Name="LoginSubmitButton" Margin="0,16,0,0"
                        IsDefault="True" IsEnabled="{Binding IsIdle}"
                        AutomationProperties.Name="{Binding Text, ElementName=LoginSubmitLabel}"
                        Command="{Binding LoginCommand}"
                        Style="{StaticResource LoginSubmitStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="LoginSpinner" Margin="0,0,8,0" Width="17" Height="17" VerticalAlignment="Center"
                              Stretch="Uniform" Data="M 8.5,1.5 A 7,7 0 1 1 2.45,5" Stroke="#FFFFFF" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform><RotateTransform /></Path.RenderTransform>
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoggingIn}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard Name="SpinLogin">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         From="0" To="360" Duration="0:0:0.8" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="SpinLogin" /></DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock x:Name="LoginSubmitLabel" Foreground="#FFFFFF">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PrimaryActionButtonLabelStyle}">
                                    <Setter Property="Text" Value="{DynamicResource AuthLoginAction}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoggingIn}" Value="True">
                                            <Setter Property="Text" Value="{DynamicResource AuthLoggingIn}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource BorderPrimary}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Text="{DynamicResource AuthNoAccount}" />
                        <Button Content="{DynamicResource AuthWebsiteRegistration}"
                                Command="{Binding OpenRegistrationWebsiteCommand}"
                                IsEnabled="{Binding IsIdle}"
                                Style="{StaticResource LoginLinkStyle}" />
                    </StackPanel>
                    <Border Grid.Column="2" Height="1" VerticalAlignment="Center" Background="{DynamicResource BorderPrimary}" />
                </Grid>
            </StackPanel>

            <Button x:Name="ModalCloseButton" Width="36" Height="36" Margin="0,8,8,0"
                    AutomationProperties.Name="{DynamicResource AuthClose}"
                    IsEnabled="{Binding IsIdle}"
                    Command="{Binding CloseCommand}" Style="{StaticResource ModalCloseButtonStyle}" />
        </Grid>
    </Border>
</UserControl>
