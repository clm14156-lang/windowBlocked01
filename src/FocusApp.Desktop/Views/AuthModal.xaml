<UserControl x:Class="FocusApp.Desktop.Views.AuthModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="360"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="AuthPasswordRevealButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuthAgreementCheckBoxStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="CheckBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <TextBlock x:Name="CheckMark"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="9"
                                       Foreground="{DynamicResource WhiteText}"
                                       Text="&#xE73E;"
                                       Visibility="Collapsed" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource AccentPrimary}" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuthCodeBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="CodeBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CodeBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                <Setter TargetName="CodeBorder" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuthLoginButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource AuthPrimaryButtonStyle}">
            <Setter Property="Background" Value="#FF7A00" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="LoginButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LoginButtonSurface" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="LoginButtonSurface" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="LoginButtonSurface" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <UserControl.Style>
        <Style TargetType="{x:Type UserControl}">
            <Setter Property="Height" Value="360" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRegistration}" Value="True">
                    <Setter Property="Height" Value="465" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Border Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource BorderPrimary}"
            BorderThickness="1"
            CornerRadius="16"
            MouseDown="AuthCard_MouseDown">
        <Grid Margin="28,0">
            <Grid x:Name="LoginPanel" TextElement.FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRegistration}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPasswordRecovery}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <TextBlock Margin="0,24,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="{DynamicResource AuthLoginTitle}" />
                <TextBlock Margin="0,57,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           FontSize="12"
                           FontWeight="Normal"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="{DynamicResource AuthLoginSubtitle}" />

                <Grid Height="34"
                      Margin="0,89,0,0"
                      VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2"
                            Height="1"
                            Margin="8,0"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource BorderPrimary}" />
                    <Button Grid.Column="0"
                            Width="68"
                            Margin="22,0,0,0"
                            Command="{Binding ShowLoginCommand}"
                            Style="{StaticResource AuthTabButtonStyle}"
                            BorderBrush="{DynamicResource AccentPrimary}"
                            Foreground="{DynamicResource AccentPrimary}">
                        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Text="{DynamicResource AuthLoginTab}" />
                    </Button>
                    <Button Grid.Column="1"
                            Width="68"
                            Margin="0,0,14,0"
                            Command="{Binding ShowRegisterCommand}"
                            Style="{StaticResource AuthTabButtonStyle}">
                        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   FontSize="13"
                                   FontWeight="Normal"
                                   Text="{DynamicResource AuthRegisterTab}" />
                    </Button>
                </Grid>

                <Border Height="42"
                        Margin="0,142,0,0"
                        VerticalAlignment="Top"
                        BorderBrush="{DynamicResource BorderPrimary}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{DynamicResource AuthInputPlaceholder}"
                                   Text="&#xE715;" />
                        <TextBox x:Name="LoginAccountTextBox"
                                 Grid.Column="1"
                                 Padding="0"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.Name="{DynamicResource AuthAccountPlaceholder}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="13"
                                 FontWeight="Normal"
                                 Foreground="{DynamicResource TextPrimary}"
                                 Text="{Binding LoginAccount, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   FontSize="13"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource TextWeak}"
                                   Text="{DynamicResource AuthAccountPlaceholder}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LoginAccount}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Border Height="42"
                        Margin="0,198,0,0"
                        VerticalAlignment="Top"
                        BorderBrush="{DynamicResource BorderPrimary}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{DynamicResource AuthInputPlaceholder}"
                                   Text="&#xE72E;" />
                        <PasswordBox x:Name="LoginPasswordBox"
                                     Grid.Column="1"
                                     Padding="0"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.Name="{DynamicResource AuthPasswordPlaceholder}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="13"
                                     FontWeight="Normal"
                                     Foreground="{DynamicResource TextPrimary}"
                                     PasswordChanged="LoginPasswordBox_PasswordChanged"
                                     PreviewKeyDown="LoginPasswordBox_PreviewKeyDown" />
                        <TextBox x:Name="LoginPasswordTextBox"
                                 Grid.Column="1"
                                 Padding="0"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="13"
                                 FontWeight="Normal"
                                 Foreground="{DynamicResource TextPrimary}"
                                 PreviewKeyDown="LoginPasswordBox_PreviewKeyDown"
                                 Text="{Binding LoginPassword, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="Collapsed" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   FontSize="13"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource TextWeak}"
                                   Text="{DynamicResource AuthPasswordPlaceholder}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LoginPassword}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="ToggleLoginPasswordVisibility_Click"
                                Style="{StaticResource AuthPasswordRevealButtonStyle}">
                            <TextBlock x:Name="LoginPasswordVisibilityIcon"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="{DynamicResource AuthInputPlaceholder}"
                                       Text="&#xE890;" />
                        </Button>
                    </Grid>
                </Border>

                <Button Width="90"
                        Height="32"
                        Margin="0,238,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Padding="0"
                        Click="StartPasswordRecoveryButton_Click"
                        Command="{Binding StartPasswordRecoveryCommand}"
                        Style="{StaticResource HomeLinkButtonStyle}">
                    <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                               FontSize="12"
                               FontWeight="Medium"
                               Text="{DynamicResource AuthForgotPassword}" />
                </Button>
                <TextBlock Margin="3,249,100,0"
                           VerticalAlignment="Top"
                           FontSize="12"
                           FontWeight="Normal"
                           Foreground="{DynamicResource AuthError}"
                           Text="{DynamicResource AuthLoginError}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLoginError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Margin="0,279,0,0"
                        Height="38"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{DynamicResource AuthLoginAction}"
                        Command="{Binding LoginCommand}"
                        Style="{StaticResource AuthLoginButtonStyle}">
                    <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                               FontSize="13"
                               FontWeight="Medium"
                               Text="{DynamicResource AuthLoginAction}" />
                </Button>
                <TextBlock Margin="0,326,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           FontSize="12"
                           FontWeight="Normal"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="{DynamicResource AuthSyncHint}" />
            </Grid>

            <Grid x:Name="PasswordRecoveryPanel">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPasswordRecovery}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Button Width="68"
                        Height="34"
                        Margin="-10,9,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Command="{Binding PasswordRecoveryBackCommand}"
                        Style="{StaticResource HomeLinkButtonStyle}"
                        Foreground="{DynamicResource TextSecondary}"
                        Visibility="{Binding IsRecoveryBackVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,5,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Text="&#xE72B;" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Normal"
                                   Text="{DynamicResource AuthRecoveryBack}" />
                    </StackPanel>
                </Button>

                <Grid x:Name="RecoveryAccountStepPanel">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRecoveryAccountStep}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <TextBlock Margin="0,58,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Text="{DynamicResource AuthRecoveryTitle}" />
                    <TextBlock Margin="0,94,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="{DynamicResource AuthRecoveryAccountHint}" />
                    <Border Height="44"
                            Margin="0,139,0,0"
                            VerticalAlignment="Top"
                            BorderBrush="{DynamicResource BorderPrimary}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="{DynamicResource AuthInputPlaceholder}"
                                       Text="&#xE715;" />
                            <TextBox x:Name="RecoveryAccountTextBox"
                                     Grid.Column="1"
                                     Padding="0"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.Name="{DynamicResource AuthRecoveryAccountPlaceholder}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="15"
                                     Text="{Binding RecoveryAccount, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       FontSize="15"
                                       Foreground="{DynamicResource AuthInputPlaceholder}"
                                       Text="{DynamicResource AuthRecoveryAccountPlaceholder}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecoveryAccount}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Button Height="40"
                            Margin="0,279,0,0"
                            VerticalAlignment="Top"
                            Click="ContinueRecoveryButton_Click"
                            Command="{Binding ContinueRecoveryCommand}"
                            IsEnabled="{Binding CanContinueRecovery}"
                            Style="{StaticResource AuthPrimaryButtonStyle}">
                        <TextBlock Foreground="{DynamicResource WhiteText}"
                                   Text="{DynamicResource AuthRecoveryContinue}" />
                    </Button>
                </Grid>

                <Grid x:Name="RecoveryVerificationStepPanel">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRecoveryVerificationStep}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <TextBlock Margin="0,58,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Text="{DynamicResource AuthRecoveryVerifyTitle}" />
                    <TextBlock Margin="0,94,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="{DynamicResource AuthRecoveryCodeSent}" />
                    <TextBlock Margin="0,117,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimary}"
                               Text="{DynamicResource AuthRecoveryMaskedEmail}" />
                    <UniformGrid Margin="8,153,8,0"
                                 VerticalAlignment="Top"
                                 Columns="6"
                                 Rows="1">
                        <TextBox x:Name="RecoveryCodeBox1" Tag="0" Margin="3,0" MaxLength="1" Style="{StaticResource AuthCodeBoxStyle}" TextChanged="RecoveryCodeBox_TextChanged" PreviewKeyDown="RecoveryCodeBox_PreviewKeyDown" PreviewTextInput="RecoveryCodeBox_PreviewTextInput" />
                        <TextBox x:Name="RecoveryCodeBox2" Tag="1" Margin="3,0" MaxLength="1" Style="{StaticResource AuthCodeBoxStyle}" TextChanged="RecoveryCodeBox_TextChanged" PreviewKeyDown="RecoveryCodeBox_PreviewKeyDown" PreviewTextInput="RecoveryCodeBox_PreviewTextInput" />
                        <TextBox x:Name="RecoveryCodeBox3" Tag="2" Margin="3,0" MaxLength="1" Style="{StaticResource AuthCodeBoxStyle}" TextChanged="RecoveryCodeBox_TextChanged" PreviewKeyDown="RecoveryCodeBox_PreviewKeyDown" PreviewTextInput="RecoveryCodeBox_PreviewTextInput" />
                        <TextBox x:Name="RecoveryCodeBox4" Tag="3" Margin="3,0" MaxLength="1" Style="{StaticResource AuthCodeBoxStyle}" TextChanged="RecoveryCodeBox_TextChanged" PreviewKeyDown="RecoveryCodeBox_PreviewKeyDown" PreviewTextInput="RecoveryCodeBox_PreviewTextInput" />
                        <TextBox x:Name="RecoveryCodeBox5" Tag="4" Margin="3,0" MaxLength="1" Style="{StaticResource AuthCodeBoxStyle}" TextChanged="RecoveryCodeBox_TextChanged" PreviewKeyDown="RecoveryCodeBox_PreviewKeyDown" PreviewTextInput="RecoveryCodeBox_PreviewTextInput" />
                        <TextBox x:Name="RecoveryCodeBox6" Tag="5" Margin="3,0" MaxLength="1" Style="{StaticResource AuthCodeBoxStyle}" TextChanged="RecoveryCodeBox_TextChanged" PreviewKeyDown="RecoveryCodeBox_PreviewKeyDown" PreviewTextInput="RecoveryCodeBox_PreviewTextInput" />
                    </UniformGrid>
                    <Button Height="32"
                            Margin="0,205,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Click="ResendRecoveryCodeButton_Click"
                            Command="{Binding ResendRecoveryCodeCommand}"
                            IsEnabled="{Binding IsResendAvailable}"
                            Style="{StaticResource HomeLinkButtonStyle}">
                        <TextBlock FontSize="12" Text="{Binding ResendCountdownText}" />
                    </Button>
                    <Button Height="40"
                            Margin="0,279,0,0"
                            VerticalAlignment="Top"
                            Command="{Binding VerifyRecoveryCodeCommand}"
                            IsEnabled="{Binding CanVerifyRecoveryCode}"
                            Style="{StaticResource AuthPrimaryButtonStyle}">
                        <TextBlock Foreground="{DynamicResource WhiteText}"
                                   Text="{DynamicResource AuthRecoveryNext}" />
                    </Button>
                </Grid>

                <Grid x:Name="RecoveryNewPasswordStepPanel">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRecoveryNewPasswordStep}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <TextBlock Margin="0,58,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Text="{DynamicResource AuthRecoveryNewPasswordTitle}" />
                    <TextBlock Margin="0,94,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="{DynamicResource AuthRecoveryNewPasswordHint}" />
                    <Border Height="44" Margin="0,132,0,0" VerticalAlignment="Top" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="10">
                        <Grid Margin="14,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AuthInputPlaceholder}" Text="&#xE72E;" />
                            <PasswordBox x:Name="RecoveryNewPasswordBox" Grid.Column="1" Padding="0" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" FontSize="15" PasswordChanged="RecoveryNewPasswordBox_PasswordChanged" />
                            <TextBox x:Name="RecoveryNewPasswordTextBox" Grid.Column="1" Padding="0" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" FontSize="15" Text="{Binding RecoveryNewPassword, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="15" Foreground="{DynamicResource AuthInputPlaceholder}" Text="{DynamicResource AuthRecoveryNewPasswordPlaceholder}">
                                <TextBlock.Style><Style TargetType="{x:Type TextBlock}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding RecoveryNewPassword}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="2" Click="ToggleRecoveryNewPasswordVisibility_Click" Style="{StaticResource AuthPasswordRevealButtonStyle}"><TextBlock x:Name="RecoveryNewPasswordVisibilityIcon" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AuthInputPlaceholder}" Text="&#xE890;" /></Button>
                        </Grid>
                    </Border>
                    <Border Height="44" Margin="0,188,0,0" VerticalAlignment="Top" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="10">
                        <Grid Margin="14,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AuthInputPlaceholder}" Text="&#xE72E;" />
                            <PasswordBox x:Name="RecoveryConfirmPasswordBox" Grid.Column="1" Padding="0" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" FontSize="15" PasswordChanged="RecoveryConfirmPasswordBox_PasswordChanged" />
                            <TextBox x:Name="RecoveryConfirmPasswordTextBox" Grid.Column="1" Padding="0" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" FontSize="15" Text="{Binding RecoveryConfirmPassword, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="15" Foreground="{DynamicResource AuthInputPlaceholder}" Text="{DynamicResource AuthRecoveryConfirmPasswordPlaceholder}">
                                <TextBlock.Style><Style TargetType="{x:Type TextBlock}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding RecoveryConfirmPassword}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="2" Click="ToggleRecoveryConfirmPasswordVisibility_Click" Style="{StaticResource AuthPasswordRevealButtonStyle}"><TextBlock x:Name="RecoveryConfirmPasswordVisibilityIcon" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AuthInputPlaceholder}" Text="&#xE890;" /></Button>
                        </Grid>
                    </Border>
                    <Button Height="40" Margin="0,279,0,0" VerticalAlignment="Top" Command="{Binding CompletePasswordRecoveryCommand}" IsEnabled="{Binding CanCompletePasswordRecovery}" Style="{StaticResource AuthPrimaryButtonStyle}">
                        <TextBlock Foreground="{DynamicResource WhiteText}"
                                   Text="{DynamicResource AuthRecoveryComplete}" />
                    </Button>
                </Grid>

                <Grid x:Name="RecoveryCompletedStepPanel">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsRecoveryCompletedStep}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Border Width="62" Height="62" Margin="0,65,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{DynamicResource SuccessTint}" CornerRadius="31">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource Success}" Text="&#xE73E;" />
                    </Border>
                    <TextBlock Margin="0,149,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="21" FontWeight="SemiBold" Text="{DynamicResource AuthRecoverySuccessTitle}" />
                    <TextBlock Margin="0,186,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource AuthRecoverySuccessHint}" />
                    <Button Height="40" Margin="0,279,0,0" VerticalAlignment="Top" Command="{Binding ReturnToLoginCommand}" Style="{StaticResource AuthPrimaryButtonStyle}">
                        <TextBlock Foreground="{DynamicResource WhiteText}"
                                   Text="{DynamicResource AuthRecoveryReturnLogin}" />
                    </Button>
                </Grid>
            </Grid>

            <Grid x:Name="RegisterPanel" TextElement.FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRegistration}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <TextBlock Margin="0,24,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="{DynamicResource AuthRegisterTitle}" />
                <TextBlock Margin="0,59,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           FontSize="12"
                           FontWeight="Normal"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="{DynamicResource AuthRegisterSubtitle}" />
                <Grid Height="34"
                      Margin="0,89,0,0"
                      VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2"
                            Height="1"
                            Margin="8,0"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource BorderPrimary}" />
                    <Button Grid.Column="0"
                            Width="68"
                            Margin="14,0,0,0"
                            Command="{Binding ShowLoginCommand}"
                            Style="{StaticResource AuthTabButtonStyle}">
                        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   FontSize="13"
                                   FontWeight="Normal"
                                   Text="{DynamicResource AuthLoginTab}" />
                    </Button>
                    <Button Grid.Column="1"
                            Width="62"
                            Margin="0,0,14,0"
                            Command="{Binding ShowRegisterCommand}"
                            Style="{StaticResource AuthTabButtonStyle}"
                            BorderBrush="{DynamicResource AccentPrimary}"
                            Foreground="{DynamicResource AccentPrimary}">
                        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Text="{DynamicResource AuthRegisterTab}" />
                    </Button>
                </Grid>

                <Border Height="41"
                        Margin="6,142,-5,0"
                        VerticalAlignment="Top"
                        BorderBrush="{DynamicResource BorderPrimary}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid Margin="14,0">
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{DynamicResource AuthInputPlaceholder}"
                                   Text="&#xE715;" />
                        <TextBox Margin="24,0,0,0"
                                 Padding="0"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.Name="{DynamicResource AuthEmailInputPlaceholder}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="13"
                                 FontWeight="Normal"
                                 Foreground="{DynamicResource TextPrimary}"
                                 Text="{Binding RegisterEmail, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="24,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   FontSize="13"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource TextWeak}"
                                   Text="{DynamicResource AuthEmailInputPlaceholder}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RegisterEmail}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <StackPanel Margin="0,181,0,0"
                            VerticalAlignment="Top"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="10"
                               Foreground="{DynamicResource AuthError}"
                               Text="&#xE783;" />
                    <TextBlock Margin="6,0,0,0"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="{DynamicResource AuthError}"
                               Text="{DynamicResource AuthEmailError}" />
                </StackPanel>

                <Border Height="41"
                        Margin="6,201,-5,0"
                        VerticalAlignment="Top"
                        BorderBrush="{DynamicResource BorderPrimary}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="94" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{DynamicResource AuthInputPlaceholder}"
                                   Text="&#xEA18;" />
                        <TextBox Grid.Column="1"
                                 Padding="0"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.Name="{DynamicResource AuthCodePlaceholder}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="13"
                                 FontWeight="Normal"
                                 Foreground="{DynamicResource TextPrimary}"
                                 Text="{Binding RegisterCode, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   FontSize="13"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource TextWeak}"
                                   Text="{DynamicResource AuthCodePlaceholder}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RegisterCode}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                Padding="0"
                                Style="{StaticResource HomeLinkButtonStyle}">
                            <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Text="{DynamicResource AuthSendCode}" />
                        </Button>
                    </Grid>
                </Border>
                <Border Height="41"
                        Margin="6,259,-5,0"
                        VerticalAlignment="Top"
                        BorderBrush="{DynamicResource BorderPrimary}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid Margin="14,0">
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{DynamicResource AuthInputPlaceholder}"
                                   Text="&#xE72E;" />
                        <PasswordBox Margin="24,0,28,0"
                                     x:Name="RegisterPasswordBox"
                                     Padding="0"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.Name="{DynamicResource AuthPasswordInputPlaceholder}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="13"
                                     FontWeight="Normal"
                                     Foreground="{DynamicResource TextPrimary}"
                                     PasswordChanged="RegisterPasswordBox_PasswordChanged" />
                        <TextBox x:Name="RegisterPasswordTextBox"
                                 Margin="24,0,28,0"
                                 Padding="0"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="13"
                                 FontWeight="Normal"
                                 Foreground="{DynamicResource TextPrimary}"
                                 Text="{Binding RegisterPassword, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="Collapsed" />
                        <TextBlock Margin="24,0,28,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   FontSize="13"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource TextWeak}"
                                   Text="{DynamicResource AuthPasswordInputPlaceholder}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RegisterPassword}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="ToggleRegisterPasswordVisibility_Click"
                                Style="{StaticResource AuthPasswordRevealButtonStyle}">
                            <TextBlock x:Name="RegisterPasswordVisibilityIcon"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="{DynamicResource AuthInputPlaceholder}"
                                       Text="&#xE890;" />
                        </Button>
                    </Grid>
                </Border>
                <Border Height="41"
                        Margin="6,317,-5,0"
                        VerticalAlignment="Top"
                        BorderBrush="{DynamicResource BorderPrimary}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid Margin="14,0">
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{DynamicResource AuthInputPlaceholder}"
                                   Text="&#xE72E;" />
                        <PasswordBox Margin="24,0,28,0"
                                     x:Name="RegisterConfirmPasswordBox"
                                     Padding="0"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.Name="{DynamicResource AuthConfirmPasswordPlaceholder}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="13"
                                     FontWeight="Normal"
                                     Foreground="{DynamicResource TextPrimary}"
                                     PasswordChanged="RegisterConfirmPasswordBox_PasswordChanged" />
                        <TextBox x:Name="RegisterConfirmPasswordTextBox"
                                 Margin="24,0,28,0"
                                 Padding="0"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="13"
                                 FontWeight="Normal"
                                 Foreground="{DynamicResource TextPrimary}"
                                 Text="{Binding RegisterConfirmPassword, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="Collapsed" />
                        <TextBlock Margin="24,0,28,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   FontSize="13"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource TextWeak}"
                                   Text="{DynamicResource AuthConfirmPasswordPlaceholder}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RegisterConfirmPassword}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="ToggleRegisterConfirmPasswordVisibility_Click"
                                Style="{StaticResource AuthPasswordRevealButtonStyle}">
                            <TextBlock x:Name="RegisterConfirmPasswordVisibilityIcon"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="{DynamicResource AuthInputPlaceholder}"
                                       Text="&#xE890;" />
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Margin="9,360,0,0"
                            VerticalAlignment="Top"
                            Orientation="Horizontal"
                            MouseLeftButtonDown="RegisterAgreementRow_MouseLeftButtonDown">
                    <ToggleButton x:Name="RegisterAgreementCheckBox"
                                  Margin="0,0,4,0"
                                  Style="{StaticResource AuthAgreementCheckBoxStyle}" />
                    <TextBlock FontSize="12"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"
                               Text="{DynamicResource AuthAgreementPrefix}" />
                    <Button Padding="0"
                            Style="{StaticResource HomeLinkButtonStyle}">
                        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Text="{DynamicResource AuthTerms}" />
                    </Button>
                    <TextBlock Margin="6,0,6,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextPrimary}"
                               Text="{DynamicResource AuthAgreementAnd}" />
                    <Button Padding="0"
                            Style="{StaticResource HomeLinkButtonStyle}">
                        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Text="{DynamicResource AuthPrivacy}" />
                    </Button>
                </StackPanel>
                <Button Height="39"
                        Margin="6,402,-5,0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{DynamicResource AuthRegisterAction}"
                        Style="{StaticResource AuthPrimaryButtonStyle}">
                        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Text="{DynamicResource AuthRegisterAction}" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
