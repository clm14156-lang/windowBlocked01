<UserControl x:Class="FocusApp.Desktop.Views.AuthModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="360"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Style>
        <Style TargetType="{x:Type UserControl}">
            <Setter Property="Height" Value="360" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRegistration}" Value="True">
                    <Setter Property="Height" Value="450" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Border Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource BorderPrimary}"
            BorderThickness="1"
            CornerRadius="16"
            MouseDown="AuthCard_MouseDown">
        <Grid Margin="28,0">
            <Grid x:Name="LoginPanel">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRegistration}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <TextBlock Margin="0,25,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Text="{DynamicResource AuthLoginTitle}" />
                <TextBlock Margin="0,62,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           FontSize="16"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="{DynamicResource AuthLoginSubtitle}" />

                <Grid Height="32"
                      Margin="0,96,0,0"
                      VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Command="{Binding ShowLoginCommand}"
                            Style="{StaticResource AuthTabButtonStyle}"
                            BorderBrush="{DynamicResource AccentPrimary}"
                            Foreground="{DynamicResource AccentPrimary}">
                        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   Text="{DynamicResource AuthLoginTab}" />
                    </Button>
                    <Button Grid.Column="1"
                            Command="{Binding ShowRegisterCommand}"
                            Style="{StaticResource AuthTabButtonStyle}">
                        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   Text="{DynamicResource AuthRegisterTab}" />
                    </Button>
                </Grid>

                <Border Height="42"
                        Margin="0,143,0,0"
                        VerticalAlignment="Top"
                        BorderBrush="{DynamicResource BorderPrimary}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   Foreground="{DynamicResource AuthInputPlaceholder}"
                                   Text="&#xE715;" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   Foreground="{DynamicResource AuthInputPlaceholder}"
                                   Text="{DynamicResource AuthEmailPlaceholder}" />
                    </Grid>
                </Border>

                <Border Height="42"
                        Margin="0,199,0,0"
                        VerticalAlignment="Top"
                        BorderBrush="{DynamicResource BorderPrimary}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   Foreground="{DynamicResource AuthInputPlaceholder}"
                                   Text="&#xE72E;" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   Foreground="{DynamicResource AuthInputPlaceholder}"
                                   Text="{DynamicResource AuthPasswordPlaceholder}" />
                        <TextBlock Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   Foreground="{DynamicResource AuthInputPlaceholder}"
                                   Text="&#xE890;" />
                    </Grid>
                </Border>

                <Button Width="90"
                        Height="32"
                        Margin="0,239,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Padding="0"
                        Style="{StaticResource HomeLinkButtonStyle}">
                    <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                               Text="{DynamicResource AuthForgotPassword}" />
                </Button>
                <Button Margin="0,280,0,0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{DynamicResource AuthLoginAction}"
                        Style="{StaticResource AuthPrimaryButtonStyle}">
                    <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                               Text="{DynamicResource AuthLoginAction}" />
                </Button>
                <TextBlock Margin="0,329,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="{DynamicResource AuthSyncHint}" />
            </Grid>

            <Grid x:Name="RegisterPanel">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRegistration}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <TextBlock Margin="0,27,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Text="{DynamicResource AuthRegisterTitle}" />
                <TextBlock Margin="0,62,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           FontSize="16"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="{DynamicResource AuthRegisterSubtitle}" />
                <Button Width="32"
                        Height="32"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{DynamicResource AuthClose}"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource AuthCloseButtonStyle}">
                    <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                               FontFamily="Segoe MDL2 Assets"
                               Text="&#xE8BB;" />
                </Button>

                <Grid Height="32"
                      Margin="0,95,0,0"
                      VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Command="{Binding ShowLoginCommand}"
                            Style="{StaticResource AuthTabButtonStyle}">
                        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   Text="{DynamicResource AuthLoginTab}" />
                    </Button>
                    <Button Grid.Column="1"
                            Command="{Binding ShowRegisterCommand}"
                            Style="{StaticResource AuthTabButtonStyle}"
                            BorderBrush="{DynamicResource AccentPrimary}"
                            Foreground="{DynamicResource AccentPrimary}">
                        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   Text="{DynamicResource AuthRegisterTab}" />
                    </Button>
                </Grid>

                <Border Height="38"
                        Margin="0,138,0,0"
                        VerticalAlignment="Top"
                        BorderBrush="{DynamicResource BorderPrimary}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid Margin="14,0">
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   Foreground="{DynamicResource AuthInputPlaceholder}"
                                   Text="&#xE715;" />
                        <TextBlock Margin="30,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   Foreground="{DynamicResource AuthInputPlaceholder}"
                                   Text="{DynamicResource AuthEmailInputPlaceholder}" />
                    </Grid>
                </Border>
                <StackPanel Margin="0,181,0,0"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{DynamicResource AuthError}"
                               Text="&#xE783;" />
                    <TextBlock Margin="6,0,0,0"
                               FontSize="14"
                               Foreground="{DynamicResource AuthError}"
                               Text="{DynamicResource AuthEmailError}" />
                </StackPanel>

                <Border Height="38"
                        Margin="0,207,0,0"
                        VerticalAlignment="Top"
                        BorderBrush="{DynamicResource BorderPrimary}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="94" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   Foreground="{DynamicResource AuthInputPlaceholder}"
                                   Text="&#xEA18;" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   Foreground="{DynamicResource AuthInputPlaceholder}"
                                   Text="{DynamicResource AuthCodePlaceholder}" />
                        <Button Grid.Column="2"
                                Padding="0"
                                Style="{StaticResource HomeLinkButtonStyle}">
                            <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       Text="{DynamicResource AuthSendCode}" />
                        </Button>
                    </Grid>
                </Border>
                <Border Height="38"
                        Margin="0,259,0,0"
                        VerticalAlignment="Top"
                        BorderBrush="{DynamicResource BorderPrimary}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid Margin="14,0">
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   Foreground="{DynamicResource AuthInputPlaceholder}"
                                   Text="&#xE72E;" />
                        <TextBlock Margin="30,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   Foreground="{DynamicResource AuthInputPlaceholder}"
                                   Text="{DynamicResource AuthPasswordPlaceholder}" />
                        <TextBlock HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   Foreground="{DynamicResource AuthInputPlaceholder}"
                                   Text="&#xE890;" />
                    </Grid>
                </Border>
                <Border Height="38"
                        Margin="0,311,0,0"
                        VerticalAlignment="Top"
                        BorderBrush="{DynamicResource BorderPrimary}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid Margin="14,0">
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   Foreground="{DynamicResource AuthInputPlaceholder}"
                                   Text="&#xE72E;" />
                        <TextBlock Margin="30,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   Foreground="{DynamicResource AuthInputPlaceholder}"
                                   Text="{DynamicResource AuthConfirmPasswordPlaceholder}" />
                        <TextBlock HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   Foreground="{DynamicResource AuthInputPlaceholder}"
                                   Text="&#xE890;" />
                    </Grid>
                </Border>

                <StackPanel Margin="0,357,0,0"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                    <Border Width="18"
                            Height="18"
                            Margin="0,0,8,0"
                            BorderBrush="{DynamicResource BorderPrimary}"
                            BorderThickness="1"
                            CornerRadius="4" />
                    <TextBlock FontSize="14"
                               VerticalAlignment="Center"
                               Text="{DynamicResource AuthAgreementPrefix}" />
                    <Button Padding="0"
                            Style="{StaticResource HomeLinkButtonStyle}">
                        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   Text="{DynamicResource AuthTerms}" />
                    </Button>
                    <TextBlock Margin="6,0,6,0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Text="{DynamicResource AuthAgreementAnd}" />
                    <Button Padding="0"
                            Style="{StaticResource HomeLinkButtonStyle}">
                        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   Text="{DynamicResource AuthPrivacy}" />
                    </Button>
                </StackPanel>
                <Button Margin="0,387,0,0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{DynamicResource AuthRegisterAction}"
                        Style="{StaticResource AuthPrimaryButtonStyle}">
                    <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                               Text="{DynamicResource AuthRegisterAction}" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
