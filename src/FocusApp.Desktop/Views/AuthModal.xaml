<UserControl x:Class="FocusApp.Desktop.Views.AuthModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="408"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             FontFamily="{DynamicResource FontFamilyPrimary}"
             KeyboardNavigation.TabNavigation="Cycle"
             IsVisibleChanged="AuthModal_IsVisibleChanged"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="LoginFieldStyle" TargetType="{x:Type Border}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="16,0,8,0" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LoginTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="LoginIconStyle" TargetType="{x:Type Path}">
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{DynamicResource TextSecondary}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="LoginLinkStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource HomeLinkButtonStyle}">
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource BodyMediumFontWeight}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LoginSubmitStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryActionButtonStyle}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="FontSize" Value="{DynamicResource ButtonEmphasisFontSize}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource AccentPressed}" />
                                <Setter TargetName="ButtonChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource BorderPrimary}"
            BorderThickness="1"
            CornerRadius="16"
            MouseDown="AuthCard_MouseDown">
        <Grid>
            <StackPanel Margin="24,40,24,24">
                <TextBlock HorizontalAlignment="Center"
                           Style="{StaticResource PageTitleTextStyle}"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="{DynamicResource AuthLoginTitle}" />
                <TextBlock Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Style="{StaticResource BodyTextStyle}"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="{DynamicResource AuthLoginSubtitle}" />

                <StackPanel Margin="0,24,0,0" IsEnabled="{Binding IsIdle}">
                    <Border Style="{StaticResource LoginFieldStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Style="{StaticResource LoginIconStyle}"
                                  Data="M 2,4 H 15 Q 16,4 16,5 V 12 Q 16,13 15,13 H 2 Q 1,13 1,12 V 5 Q 1,4 2,4 M 1,5 L 8.5,10 L 16,5" />
                            <TextBox x:Name="LoginEmailTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource LoginTextBoxStyle}"
                                     AutomationProperties.Name="{DynamicResource AuthEmailPlaceholder}"
                                     Text="{Binding LoginAccount, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{DynamicResource AuthEmailPlaceholder}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BodyTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LoginAccount}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Border Margin="0,12,0,0" Style="{StaticResource LoginFieldStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <Path Style="{StaticResource LoginIconStyle}"
                                  Data="M 4,8 V 6 A 4.5,4.5 0 0 1 13,6 V 8 M 4,8 H 13 Q 15,8 15,10 V 14 Q 15,16 13,16 H 4 Q 2,16 2,14 V 10 Q 2,8 4,8 Z" />
                            <PasswordBox x:Name="LoginPasswordBox"
                                         Grid.Column="1" Padding="0"
                                         VerticalContentAlignment="Center"
                                         AutomationProperties.Name="{DynamicResource AuthPasswordPlaceholder}"
                                         Background="{DynamicResource TransparentBrush}"
                                         BorderThickness="0"
                                         FontSize="{DynamicResource BodyFontSize}"
                                         Foreground="{DynamicResource TextPrimary}"
                                         PasswordChanged="LoginPasswordBox_PasswordChanged" />
                            <TextBox x:Name="LoginPasswordTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource LoginTextBoxStyle}"
                                     AutomationProperties.Name="{DynamicResource AuthPasswordPlaceholder}"
                                     Text="{Binding LoginPassword, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="Collapsed" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{DynamicResource AuthPasswordPlaceholder}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BodyTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LoginPassword}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button x:Name="LoginPasswordToggle"
                                    Grid.Column="2" Width="36"
                                    Click="ToggleLoginPasswordVisibility_Click">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource HomeLinkButtonStyle}">
                                        <Setter Property="AutomationProperties.Name" Value="{DynamicResource AuthShowPassword}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=LoginPasswordTextBox}" Value="Visible">
                                                <Setter Property="AutomationProperties.Name" Value="{DynamicResource AuthHidePassword}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Path>
                                    <Path.Style>
                                        <Style TargetType="{x:Type Path}" BasedOn="{StaticResource LoginIconStyle}">
                                            <Setter Property="Data" Value="M 1,2 L 16,15 M 2,10 Q 1,9 1,8 Q 2,6 4,5 M 6,4 Q 11,1 16,8 Q 15,10 13,11 M 11,12 Q 6,15 2,10" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=LoginPasswordTextBox}" Value="Visible">
                                                    <Setter Property="Data" Value="M 1,8 Q 8.5,-1 16,8 Q 8.5,17 1,8 Z M 11,8 A 2.5,2.5 0 1 0 6,8 A 2.5,2.5 0 1 0 11,8" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <Button Margin="0,4,0,0"
                        HorizontalAlignment="Right"
                        Content="{DynamicResource AuthForgotPassword}"
                        Command="{Binding OpenRecoveryWebsiteCommand}"
                        IsEnabled="{Binding IsIdle}"
                        Style="{StaticResource LoginLinkStyle}" />

                <Button x:Name="LoginSubmitButton" Margin="0,12,0,0"
                        IsDefault="True" IsEnabled="{Binding IsIdle}"
                        AutomationProperties.Name="{DynamicResource AuthLoginAction}"
                        Command="{Binding LoginCommand}"
                        Style="{StaticResource LoginSubmitStyle}">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PrimaryActionButtonLabelStyle}">
                                <Setter Property="Text" Value="{DynamicResource AuthLoginAction}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Text" Value="{DynamicResource AuthLoggingIn}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <TextBlock Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           Text="{Binding StatusMessage}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SecondaryTextStyle}">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLoginError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource BorderPrimary}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Text="{DynamicResource AuthNoAccount}" />
                        <Button Content="{DynamicResource AuthWebsiteRegistration}"
                                Command="{Binding OpenRegistrationWebsiteCommand}"
                                IsEnabled="{Binding IsIdle}"
                                Style="{StaticResource LoginLinkStyle}" />
                    </StackPanel>
                    <Border Grid.Column="2" Height="1" VerticalAlignment="Center" Background="{DynamicResource BorderPrimary}" />
                </Grid>
            </StackPanel>

            <Button x:Name="ModalCloseButton" Width="36" Height="36" Margin="0,8,8,0"
                    AutomationProperties.Name="{DynamicResource AuthClose}"
                    IsEnabled="{Binding IsIdle}"
                    Command="{Binding CloseCommand}" Style="{StaticResource ModalCloseButtonStyle}" />
        </Grid>
    </Border>
</UserControl>
