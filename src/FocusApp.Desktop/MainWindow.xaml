<Window x:Class="FocusApp.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FocusApp.Desktop.ViewModels"
        xmlns:views="clr-namespace:FocusApp.Desktop.Views"
        Title="{DynamicResource ApplicationName}"
        Width="800"
        Height="710"
        MinWidth="800"
        MinHeight="710"
        MaxWidth="800"
        MaxHeight="710"
        ResizeMode="NoResize"
        PreviewMouseDown="Window_PreviewMouseDown"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">
    <Border BorderBrush="{DynamicResource BorderPrimary}"
            BorderThickness="1"
            Background="{DynamicResource BackgroundPrimary}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource BackgroundPrimary}"
                    BorderBrush="{DynamicResource OverlayBorder}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="124" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="104" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Image Width="32"
                               Height="32"
                               Margin="0,32,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="/FocusApp.Desktop;component/Assets/Themes/Solid/Orange/sidebar-logo.png"
                               Stretch="Uniform" />
                    </Grid>

                    <ItemsControl Grid.Row="1"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Top"
                                  ItemsSource="{Binding PrimaryNavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton AutomationProperties.Name="{Binding Title}"
                                             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                             CommandParameter="{Binding}"
                                             Focusable="False"
                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                             Style="{StaticResource NavigationButtonStyle}"
                                             ToolTip="{Binding Title}">
                                    <Grid Width="20" Height="20">
                                        <TextBlock x:Name="NavigationGlyph"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="20"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                                   Text="{Binding Icon}" />
                                        <TextBlock x:Name="BlockingCheckGlyph"
                                                   Margin="0,2,0,0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{DynamicResource FontFamilyPrimary}"
                                                   FontSize="8"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                                   Text="✓"
                                                   Visibility="Collapsed" />
                                        <Grid x:Name="StatisticsPieGlyph" Visibility="Collapsed">
                                            <Ellipse Margin="1"
                                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                                     StrokeThickness="1.6" />
                                            <Path Data="M 10,1.2 L 10,10 L 18.8,10"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeThickness="1.6" />
                                        </Grid>
                                    </Grid>
                                </RadioButton>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Page}" Value="{x:Static vm:NavigationPage.Blocking}">
                                        <Setter TargetName="BlockingCheckGlyph" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Page}" Value="{x:Static vm:NavigationPage.Statistics}">
                                        <Setter TargetName="NavigationGlyph" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="StatisticsPieGlyph" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Grid.Row="2">
                        <Border Height="1"
                                Margin="18,-8,18,0"
                                VerticalAlignment="Top"
                                Background="{DynamicResource BorderPrimary}" />
                        <RadioButton x:Name="AccountButton"
                                     Width="44"
                                     Height="44"
                                     Margin="0,-1,0,39"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     AutomationProperties.Name="{Binding AccountNavigationItem.Title}"
                                     Command="{Binding OpenAuthCommand}"
                                     Focusable="False"
                                     IsChecked="{Binding AccountNavigationItem.IsSelected, Mode=OneWay}"
                                     MouseEnter="GuestAccountHint_MouseEnter"
                                     MouseLeave="GuestAccountHint_MouseLeave"
                                     PreviewMouseLeftButtonDown="AccountButton_PreviewMouseLeftButtonDown"
                                     Style="{StaticResource NavigationButtonStyle}"
                                     ToolTip="{Binding AccountNavigationItem.Title}"
                                     ToolTipService.IsEnabled="{Binding IsLoggedIn}">
                            <Grid Width="40" Height="40">
                                <Ellipse Fill="{DynamicResource BackgroundSecondary}" />
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                    <Ellipse.Fill>
                                        <ImageBrush AlignmentX="Center"
                                                    AlignmentY="Center"
                                                    ImageSource="/FocusApp.Desktop;component/Assets/Images/Illustrations/UserAvatar.png"
                                                    Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="20"
                                           Foreground="{DynamicResource TextSecondary}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Text" Value="{Binding AccountNavigationItem.Icon}" />
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Width="12"
                                        Height="12"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource AccentPrimary}"
                                        CornerRadius="6">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="8"
                                               Foreground="{DynamicResource WhiteText}"
                                               Text="&#xE710;" />
                                </Border>
                                <Image Width="17"
                                       Height="17"
                                       Margin="0,0,-1,-1"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="/FocusApp.Desktop;component/Assets/Icons/Common/vip_logo.png"
                                       Stretch="Uniform">
                                    <Image.Style>
                                        <Style TargetType="{x:Type Image}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVipMember}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </Grid>
                        </RadioButton>
                        <TextBlock x:Name="AccountStatusText"
                                   Margin="0,0,0,23"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   FontSize="{DynamicResource SecondaryFontSize}"
                                   FontWeight="Normal">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                    <Setter Property="Text" Value="{DynamicResource HomeGuestAccount}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <Popup x:Name="GuestLoginHintPopup"
                   AllowsTransparency="True"
                   Placement="Custom"
                   PlacementTarget="{Binding ElementName=AccountButton}"
                   PopupAnimation="Fade"
                   StaysOpen="True">
                <Grid x:Name="GuestLoginHintRoot"
                      Width="220"
                      Height="100"
                      Background="{DynamicResource TransparentBrush}"
                      MouseEnter="GuestAccountHint_MouseEnter"
                      MouseLeave="GuestAccountHint_MouseLeave">
                    <Border Width="210"
                            Height="100"
                            HorizontalAlignment="Right"
                            Background="{DynamicResource SurfacePrimary}"
                            BorderBrush="{DynamicResource BorderPrimary}"
                            BorderThickness="1"
                            CornerRadius="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.14" ShadowDepth="5" />
                        </Border.Effect>
                        <StackPanel Margin="20,0" VerticalAlignment="Center">
                            <TextBlock FontSize="16"
                                       FontWeight="Medium"
                                       Text="{DynamicResource GuestLoginHintTitle}" />
                            <TextBlock Margin="0,12,0,0"
                                       FontSize="13"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource TextSecondary}"
                                       LineHeight="20"
                                       Text="{DynamicResource GuestLoginHintDescription}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Path Width="11"
                          Height="18"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Data="M 11,0 L 0,9 L 11,18 Z"
                          Fill="{DynamicResource SurfacePrimary}"
                          Stroke="{DynamicResource BorderPrimary}"
                          StrokeThickness="1" />
                </Grid>
            </Popup>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Background="{DynamicResource BackgroundPrimary}"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Margin="0,4,8,4"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button x:Name="ThemeButton"
                                AutomationProperties.Name="{DynamicResource HomeThemeButton}"
                                Click="ThemeButton_Click"
                                Style="{StaticResource WindowChromeButtonStyle}"
                                ToolTip="{DynamicResource HomeThemeButton}">
                            <Image Width="20"
                                   Height="20"
                                   Source="/FocusApp.Desktop;component/Assets/Icons/Common/Menber_skin.png"
                                   Stretch="Uniform" />
                        </Button>
                        <Button AutomationProperties.Name="{DynamicResource HomeMinimizeButton}"
                                Click="MinimizeButton_Click"
                                Style="{StaticResource WindowChromeButtonStyle}"
                                ToolTip="{DynamicResource HomeMinimizeButton}">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       Text="&#xE921;" />
                        </Button>
                        <Button AutomationProperties.Name="{DynamicResource HomeCloseButton}"
                                Click="CloseButton_Click"
                                Style="{StaticResource WindowChromeButtonStyle}"
                                ToolTip="{DynamicResource HomeCloseButton}">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       Text="&#xE8BB;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <ContentControl x:Name="PageHost"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />

                    <TextBlock Margin="40,28,40,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               FontSize="{DynamicResource PageTitleFontSize}"
                               FontWeight="SemiBold"
                               Text="{Binding CurrentPageTitle}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:NavigationPage.Home}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:NavigationPage.Settings}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:NavigationPage.Blocking}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:NavigationPage.Statistics}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

            <Grid Grid.ColumnSpan="2" Panel.ZIndex="102">
                <Grid.Style><Style TargetType="{x:Type Grid}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding BlockingPage.WebsiteModal.IsOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Border Background="{DynamicResource ModalScrim}" MouseDown="WebsiteScrim_MouseDown">
                    <views:AddWebsiteModal DataContext="{Binding BlockingPage.WebsiteModal}" />
                </Border>
            </Grid>

            <Grid Grid.ColumnSpan="2" Panel.ZIndex="103">
                <Grid.Style><Style TargetType="{x:Type Grid}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding BlockingPage.ProgramModal.IsOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Border Background="{DynamicResource ModalScrim}" MouseDown="ProgramScrim_MouseDown">
                    <views:AddProgramModal DataContext="{Binding BlockingPage.ProgramModal}" />
                </Border>
            </Grid>

            <Grid Grid.ColumnSpan="2" Panel.ZIndex="104">
                <Grid.Style><Style TargetType="{x:Type Grid}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HomePage.BlockedContentModal.IsOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Border Background="{DynamicResource ModalScrim}" MouseDown="BlockedContentScrim_MouseDown">
                    <views:BlockedContentModal DataContext="{Binding HomePage.BlockedContentModal}" />
                </Border>
            </Grid>

            <Grid Grid.ColumnSpan="2"
                  Panel.ZIndex="100">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AuthModal.IsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Background="{DynamicResource ModalScrim}"
                        MouseDown="AuthScrim_MouseDown">
                    <views:AuthModal DataContext="{Binding AuthModal}" />
                </Border>
            </Grid>

            <Grid Grid.ColumnSpan="2"
                  Panel.ZIndex="101">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SettingsPage.RuleModal.IsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Background="{DynamicResource ModalScrim}"
                        MouseDown="RuleScrim_MouseDown">
                    <views:AutomaticRuleModal HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              DataContext="{Binding SettingsPage.RuleModal}" />
                </Border>
            </Grid>

            <Grid Grid.ColumnSpan="2"
                  Panel.ZIndex="102">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SettingsPage.RuleActivationModal.IsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Background="{DynamicResource ModalScrim}"
                        MouseDown="RuleActivationScrim_MouseDown">
                    <views:AutomaticRuleActivationModal HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        DataContext="{Binding SettingsPage.RuleActivationModal}" />
                </Border>
            </Grid>

            <Grid Grid.ColumnSpan="2"
                  Panel.ZIndex="90">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HomePage.CustomTimeModal.IsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <views:CustomTimeModal x:Name="CustomTimeModalControl"
                                       Margin="0,120,22,0"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       DataContext="{Binding HomePage.CustomTimeModal}" />
            </Grid>

            <Grid Grid.ColumnSpan="2"
                  Panel.ZIndex="91">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ThemePanel.IsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <views:ThemePanel x:Name="ThemePanelControl"
                                  Margin="0,54,0,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top"
                                  DataContext="{Binding ThemePanel}" />
            </Grid>

            <Grid Grid.ColumnSpan="2"
                  Panel.ZIndex="95"
                  IsHitTestVisible="True">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAccountPanelOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <views:AccountPanel x:Name="AccountPanelControl"
                                    Margin="68,0,0,14"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    DataContext="{Binding}" />
            </Grid>

            <Grid Grid.ColumnSpan="2" Panel.ZIndex="104">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HomePage.FocusTargetModal.IsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Background="{DynamicResource ModalScrim}" MouseDown="FocusTargetScrim_MouseDown">
                    <views:FocusTargetModal HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            DataContext="{Binding HomePage.FocusTargetModal}" />
                </Border>
            </Grid>

            <Grid Grid.ColumnSpan="2" Panel.ZIndex="150">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding VipModal.IsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Background="{DynamicResource ModalScrim}"
                        MouseDown="VipScrim_MouseDown">
                    <views:VipModal HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    DataContext="{Binding VipModal}" />
                </Border>
            </Grid>

            <Grid Grid.ColumnSpan="2" Panel.ZIndex="151">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AccountSyncModal.IsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Background="{DynamicResource ModalScrim}"
                        MouseDown="AccountSyncScrim_MouseDown">
                    <views:AccountSyncModal HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            DataContext="{Binding AccountSyncModal}" />
                </Border>
            </Grid>

            <Grid Grid.ColumnSpan="2" Panel.ZIndex="152">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MembershipCenter.IsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Background="{DynamicResource ModalScrim}"
                        MouseDown="MembershipCenterScrim_MouseDown">
                    <views:MembershipCenterModal HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 DataContext="{Binding MembershipCenter}" />
                </Border>
            </Grid>

            <Grid Grid.ColumnSpan="2" Panel.ZIndex="153">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SettingsPage.ExportRecordsModal.IsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Background="{DynamicResource ModalScrim}"
                        MouseDown="ExportRecordsScrim_MouseDown">
                    <views:ExportRecordsModal HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              DataContext="{Binding SettingsPage.ExportRecordsModal}" />
                </Border>
            </Grid>

            <Grid Grid.ColumnSpan="2"
                  Panel.ZIndex="180"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  IsHitTestVisible="True">
                <Border Margin="0,62,0,0"
                        Padding="12,10,8,10"
                        Width="360"
                        Background="{DynamicResource SurfacePrimary}"
                        BorderBrush="{DynamicResource BorderPrimary}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" Opacity="0.12" ShadowDepth="3" />
                    </Border.Effect>
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SettingsPage.IsRuleMergeToastVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30"
                                Height="30"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{DynamicResource SuccessTint}"
                                CornerRadius="15">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="{DynamicResource Success}"
                                       Text="&#xE73E;" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,4,0">
                            <TextBlock FontSize="15"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Text="{DynamicResource AutomaticRuleMergedTitle}" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap">
                                <Run Text="{DynamicResource AutomaticRuleMergedMessagePrefix}" />
                                <Run Text=" " />
                                <Run Text="{Binding SettingsPage.RuleMergeToastRange, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="{DynamicResource AutomaticRuleMergedClose}"
                                Command="{Binding SettingsPage.CloseRuleMergeToastCommand}"
                                Style="{StaticResource WindowChromeButtonStyle}"
                                ToolTip="{DynamicResource AutomaticRuleMergedClose}">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="&#xE8BB;" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.ColumnSpan="2"
                  Panel.ZIndex="182"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  IsHitTestVisible="True">
                <Border Width="360"
                        Height="60"
                        Margin="0,65,0,0"
                        Padding="12,8,8,8"
                        Background="{DynamicResource SurfacePrimary}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" Opacity="0.12" ShadowDepth="3" />
                    </Border.Effect>
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SettingsPage.ExportRecordsModal.IsNotificationVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SettingsPage.ExportRecordsModal.NotificationKind}" Value="Success">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SettingsPage.ExportRecordsModal.NotificationKind}" Value="Failure">
                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="14">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="{DynamicResource AccentTint}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SettingsPage.ExportRecordsModal.NotificationKind}" Value="Success">
                                            <Setter Property="Background" Value="{DynamicResource SuccessTint}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SettingsPage.ExportRecordsModal.NotificationKind}" Value="Failure">
                                            <Setter Property="Background" Value="{DynamicResource DangerTint}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                                        <Setter Property="Text" Value="&#xE946;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SettingsPage.ExportRecordsModal.NotificationKind}" Value="Success">
                                                <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                                <Setter Property="Text" Value="&#xE73E;" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SettingsPage.ExportRecordsModal.NotificationKind}" Value="Failure">
                                                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                <Setter Property="Text" Value="&#xE7BA;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center">
                            <TextBlock FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Text="{Binding SettingsPage.ExportRecordsModal.NotificationTitle, Mode=OneWay}" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{Binding SettingsPage.ExportRecordsModal.NotificationMessage, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="关闭导出提示"
                                Command="{Binding SettingsPage.ExportRecordsModal.CloseNotificationCommand}"
                                Style="{StaticResource WindowChromeButtonStyle}"
                                ToolTip="关闭">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="&#xE8BB;" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.ColumnSpan="2"
                  Panel.ZIndex="181"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  IsHitTestVisible="True">
                <Border Width="360"
                        Height="60"
                        Margin="0,65,0,0"
                        Padding="12,8,8,8"
                        Background="{DynamicResource SurfacePrimary}"
                        BorderBrush="{DynamicResource DangerBorder}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" Opacity="0.12" ShadowDepth="3" />
                    </Border.Effect>
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SettingsPage.IsRuleLimitToastVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>
                        <Border Width="28"
                                Height="28"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource DangerTint}"
                                CornerRadius="14">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Foreground="{DynamicResource Danger}"
                                       Text="&#xE7BA;" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center">
                            <TextBlock FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Text="{DynamicResource AutomaticRuleLimitTitle}" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{Binding SettingsPage.RuleLimitToastMessage, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="{DynamicResource AutomaticRuleLimitClose}"
                                Command="{Binding SettingsPage.CloseRuleLimitToastCommand}"
                                Style="{StaticResource WindowChromeButtonStyle}"
                                ToolTip="{DynamicResource AutomaticRuleLimitClose}">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="&#xE8BB;" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="FocusResultToastOverlay"
                  Grid.Column="1"
                  Panel.ZIndex="190"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  IsHitTestVisible="True">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFocusResultToastVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Width="360"
                        Height="60"
                        Margin="0,65,0,0"
                        Padding="14,8,10,8"
                        Background="#FFFFFFFF"
                        BorderBrush="#FFE9E9EC"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16"
                                          Direction="270"
                                          Opacity="0.10"
                                          ShadowDepth="3"
                                          Color="#FF555B66" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>

                        <Image Width="36"
                               Height="36"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="{Binding FocusResultToastIconSource, Mode=OneWay}"
                               Stretch="Uniform" />

                        <StackPanel Grid.Column="1"
                                    Margin="4,0,8,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontSize="15"
                                       FontWeight="Medium"
                                       Foreground="#FF1D1D1F"
                                       Text="{Binding FocusResultToastTitle, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="12"
                                       FontWeight="Normal"
                                       Text="{Binding FocusResultToastSubtitle, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="#FF7A7D86" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FocusResultToastKind}"
                                                         Value="{x:Static vm:FocusResultKind.EarlyEndedDiscarded}">
                                                <Setter Property="Foreground" Value="#FFFF5A36" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="关闭专注结果提示"
                                Command="{Binding CloseFocusResultToastCommand}"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="CloseBackground"
                                            Background="Transparent"
                                            CornerRadius="14">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
                                                   FontSize="14"
                                                   FontWeight="Normal"
                                                   Foreground="#FF7C7F87"
                                                   Text="×" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CloseBackground" Property="Background" Value="#FFF3F3F3" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="CloseBackground" Property="Background" Value="#FFEAEAEA" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <views:FocusFlowView Grid.ColumnSpan="2"
                                 Panel.ZIndex="200"
                                 MinimizeRequested="FocusFlowView_MinimizeRequested"
                                 DataContext="{Binding HomePage.FocusSession}">
                <views:FocusFlowView.Style>
                    <Style TargetType="{x:Type views:FocusFlowView}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFullScreenVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:FocusFlowView.Style>
            </views:FocusFlowView>

            <views:CreateGoalModal x:Name="CreateGoalModalControl"
                                   Grid.ColumnSpan="2"
                                   Panel.ZIndex="210"
                                   Margin="-1"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   DataContext="{Binding StatisticsPage}" />
        </Grid>
    </Border>
</Window>
