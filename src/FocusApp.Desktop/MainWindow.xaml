<Window x:Class="FocusApp.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ApplicationName}"
        Width="800"
        Height="710"
        MinWidth="800"
        MinHeight="710"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SurfacePrimary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="96" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="80" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Width="40"
                        Height="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AccentTint}"
                        CornerRadius="{DynamicResource NavigationCornerRadius}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentPrimary}"
                               Text="{DynamicResource ApplicationMonogram}" />
                </Border>

                <ItemsControl Grid.Row="1"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top"
                              ItemsSource="{Binding PrimaryNavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton AutomationProperties.Name="{Binding Title}"
                                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                         CommandParameter="{Binding}"
                                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                                         Style="{StaticResource NavigationButtonStyle}"
                                         ToolTip="{Binding Title}">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="20"
                                           Text="{Binding Icon}" />
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <RadioButton Grid.Row="2"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             AutomationProperties.Name="{Binding AccountNavigationItem.Title}"
                             Command="{Binding NavigateCommand}"
                             CommandParameter="{Binding AccountNavigationItem}"
                             IsChecked="{Binding AccountNavigationItem.IsSelected, Mode=OneWay}"
                             Style="{StaticResource NavigationButtonStyle}"
                             ToolTip="{Binding AccountNavigationItem.Title}">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Text="{Binding AccountNavigationItem.Icon}" />
                </RadioButton>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="40,28,40,0">
            <TextBlock HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       FontSize="{DynamicResource PageTitleFontSize}"
                       FontWeight="SemiBold"
                       Text="{Binding CurrentPageTitle}" />
        </Grid>
    </Grid>
</Window>
