<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:FocusApp.Desktop.Views">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FocusApp.Desktop;component/Resources/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="PoptipPrimaryBrush" Color="#242424" />
    <SolidColorBrush x:Key="PoptipSecondaryBrush" Color="#909399" />
    <SolidColorBrush x:Key="PoptipAccentBrush" Color="#FF7A2F" />
    <Style x:Key="PoptipSurfaceStyle" TargetType="views:PoptipChrome">
        <Setter Property="Margin" Value="4" />
        <Setter Property="MaxWidth" Value="240" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Effect">
            <Setter.Value><DropShadowEffect Color="Black" Opacity="0.06" BlurRadius="8" ShadowDepth="2" Direction="270" /></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PoptipPrimaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyPrimary}" />
        <Setter Property="FontSize" Value="{DynamicResource ButtonEmphasisFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource ButtonEmphasisFontWeight}" />
        <Setter Property="Foreground" Value="{StaticResource PoptipPrimaryBrush}" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="PoptipSecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyPrimary}" />
        <Setter Property="FontSize" Value="{DynamicResource SecondaryFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource SecondaryFontWeight}" />
        <Setter Property="Foreground" Value="{StaticResource PoptipSecondaryBrush}" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="PoptipAccentTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PoptipPrimaryTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource PoptipAccentBrush}" />
    </Style>
</ResourceDictionary>
