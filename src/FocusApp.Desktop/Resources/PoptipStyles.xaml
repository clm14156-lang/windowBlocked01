<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:FocusApp.Desktop.Views">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FocusApp.Desktop;component/Resources/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="PoptipPrimaryBrush" Color="#242424" />
    <SolidColorBrush x:Key="PoptipSecondaryBrush" Color="#909399" />
    <SolidColorBrush x:Key="PoptipAccentBrush" Color="#FF7A2F" />
    <SolidColorBrush x:Key="ChartPoptipBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ChartPoptipBorderBrush" Color="#E3E7EE" />
    <SolidColorBrush x:Key="ChartPoptipSecondaryBrush" Color="#8A919F" />
    <SolidColorBrush x:Key="ChartPoptipBodyBrush" Color="#8A919F" />
    <SolidColorBrush x:Key="ChartPoptipValueBrush" Color="#18212F" />
    <Style x:Key="PoptipSurfaceStyle" TargetType="views:PoptipChrome">
        <Setter Property="Margin" Value="4" />
        <Setter Property="MaxWidth" Value="240" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Effect">
            <Setter.Value><DropShadowEffect Color="Black" Opacity="0.06" BlurRadius="8" ShadowDepth="2" Direction="270" /></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PoptipPrimaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyPrimary}" />
        <Setter Property="FontSize" Value="{DynamicResource ButtonEmphasisFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource ButtonEmphasisFontWeight}" />
        <Setter Property="Foreground" Value="{StaticResource PoptipPrimaryBrush}" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="PoptipSecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyPrimary}" />
        <Setter Property="FontSize" Value="{DynamicResource SecondaryFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource SecondaryFontWeight}" />
        <Setter Property="Foreground" Value="{StaticResource PoptipSecondaryBrush}" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="PoptipAccentTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PoptipPrimaryTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource PoptipAccentBrush}" />
    </Style>
    <Style x:Key="ChartPoptipSurfaceStyle" TargetType="views:PoptipChrome" BasedOn="{StaticResource PoptipSurfaceStyle}">
        <Setter Property="Background" Value="{StaticResource ChartPoptipBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ChartPoptipBorderBrush}" />
        <Setter Property="ShowPointer" Value="False" />
        <Setter Property="Effect">
            <Setter.Value><DropShadowEffect Color="#17202D" Opacity="0.06" BlurRadius="12" ShadowDepth="2" /></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ChartPoptipSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PoptipSecondaryTextStyle}">
        <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource ChartPoptipSecondaryBrush}" />
        <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style x:Key="ChartPoptipTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PoptipPrimaryTextStyle}">
        <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
        <Setter Property="Foreground" Value="{StaticResource ChartPoptipBodyBrush}" />
        <Setter Property="LineHeight" Value="22" />
    </Style>
    <Style x:Key="ChartPoptipHeadingTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ChartPoptipTitleTextStyle}">
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightSemiBold}" />
    </Style>
    <Style x:Key="ChartPoptipBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ChartPoptipSecondaryTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource ChartPoptipBodyBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ChartPoptipPercentageTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ChartPoptipSecondaryTextStyle}">
        <Setter Property="FontSize" Value="{DynamicResource SecondaryFontSize}" />
        <Setter Property="LineHeight" Value="18" />
    </Style>
    <Style x:Key="ChartPoptipValueStyle" TargetType="Run">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyPrimary}" />
        <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource ChartPoptipValueBrush}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="ChartPoptipDurationTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ChartPoptipBodyTextStyle}">
        <Setter Property="LineHeight" Value="22" />
    </Style>
    <Style x:Key="WeeklyChartPoptipSurfaceStyle" TargetType="views:PoptipChrome" BasedOn="{StaticResource ChartPoptipSurfaceStyle}">
        <Setter Property="MaxWidth" Value="340" />
        <Setter Property="ShowPointer" Value="True" />
        <Setter Property="PointerSize" Value="24,12" />
        <Setter Property="BorderBrush" Value="#E1E4E9" />
    </Style>
    <Style x:Key="WeeklyChartPoptipHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ChartPoptipSecondaryTextStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="#909399" />
        <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style x:Key="WeeklyChartPoptipBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ChartPoptipBodyTextStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="#3D444F" />
        <Setter Property="LineHeight" Value="24" />
    </Style>
    <Style x:Key="WeeklyChartPoptipValueStyle" TargetType="Run" BasedOn="{StaticResource ChartPoptipValueStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="#3D444F" />
    </Style>
</ResourceDictionary>
