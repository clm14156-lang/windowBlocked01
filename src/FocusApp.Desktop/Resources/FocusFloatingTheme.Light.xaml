<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Original floating and folded palette: keep light appearance unchanged. -->
    <LinearGradientBrush x:Key="FloatingBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FDFEFF"/><GradientStop Offset="1" Color="#F7FAFE"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FloatingBorderBrush" Color="#E6ECF3"/>
    <SolidColorBrush x:Key="FloatingCountdownBrush" Color="#101B2C"/>
    <SolidColorBrush x:Key="FloatingSecondaryBrush" Color="#9BAAC0"/>
    <SolidColorBrush x:Key="FloatingStatusBrush" Color="#69758A"/>
    <SolidColorBrush x:Key="FloatingIconBrush" Color="#48556A"/>
    <SolidColorBrush x:Key="FloatingProgressTrackBrush" Color="#DDE5F0"/>
    <SolidColorBrush x:Key="FloatingDividerBrush" Color="#E6ECF4"/>
    <SolidColorBrush x:Key="FloatingTaskHeaderBrush" Color="#263347"/>
    <SolidColorBrush x:Key="FloatingTaskTextBrush" Color="#3C485B"/>
    <SolidColorBrush x:Key="FloatingCompletedTaskBrush" Color="#7D8CA2"/>
    <SolidColorBrush x:Key="FloatingTaskRowHoverBrush" Color="#F2F4F6"/>
    <SolidColorBrush x:Key="FloatingTaskRowDragBrush" Color="#E8EDF2"/>
    <SolidColorBrush x:Key="FloatingTaskDragHandleBrush" Color="#ADB5C0"/>
    <SolidColorBrush x:Key="FloatingConnectorBrush" Color="#C4CEDB"/>
    <SolidColorBrush x:Key="FloatingCheckBorderBrush" Color="#AEBCCF"/>
    <SolidColorBrush x:Key="FloatingCheckBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FloatingButtonHoverBrush" Color="#EEF2F6"/>
    <SolidColorBrush x:Key="FloatingButtonPressedBrush" Color="#E4EAF1"/>
    <SolidColorBrush x:Key="FloatingScrollTrackBrush" Color="#EDF2F7"/>
    <SolidColorBrush x:Key="FloatingScrollThumbBrush" Color="#BFCCDC"/>
    <SolidColorBrush x:Key="FloatingScrollHoverBrush" Color="#AABAD0"/>
    <SolidColorBrush x:Key="FloatingScrollDraggingBrush" Color="#99ADC6"/>
    <SolidColorBrush x:Key="FloatingInputBackgroundBrush" Color="#F7FAFE"/>
    <SolidColorBrush x:Key="FloatingInputBorderBrush" Color="#E1E7EF"/>
    <SolidColorBrush x:Key="FloatingInputFocusBrush" Color="#FFAD70"/>
    <SolidColorBrush x:Key="FoldedBackgroundBrush" Color="#FCFCFD"/>
    <SolidColorBrush x:Key="FoldedBorderBrush" Color="#E1E4E9"/>
    <SolidColorBrush x:Key="FoldedCountdownBrush" Color="#15171A"/>
    <SolidColorBrush x:Key="FoldedTaskBrush" Color="#9B9FA8"/>
    <SolidColorBrush x:Key="FoldedDividerBrush" Color="#DFE2E7"/>
    <SolidColorBrush x:Key="FoldedRingTrackBrush" Color="#DCE0E5"/>
</ResourceDictionary>
