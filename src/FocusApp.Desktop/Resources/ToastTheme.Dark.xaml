<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Preserve the existing night Toast gradients and interaction colors. -->
    <LinearGradientBrush x:Key="ToastBlockedBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#50545A" Offset="0" />
        <GradientStop Color="#40454A" Offset="0.44" />
        <GradientStop Color="#3C4146" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ToastAutomaticBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F53D434B" Offset="0" />
        <GradientStop Color="#F5343A42" Offset="0.44" />
        <GradientStop Color="#F530353C" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ToastMenuBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#494F55" Offset="0" />
        <GradientStop Color="#3C4146" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ToastBlockedBorderBrush" Color="#555A60" />
    <SolidColorBrush x:Key="ToastAutomaticBorderBrush" Color="#626973" />
    <SolidColorBrush x:Key="ToastTitleBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToastPrimaryBrush" Color="#F5F6F8" />
    <SolidColorBrush x:Key="ToastSecondaryBrush" Color="#B4BAC3" />
    <SolidColorBrush x:Key="ToastMutedBrush" Color="#AEB5BE" />
    <SolidColorBrush x:Key="ToastIconBrush" Color="#AEB5BE" />
    <SolidColorBrush x:Key="ToastControlBrush" Color="#C4C8CE" />
    <SolidColorBrush x:Key="ToastDividerBrush" Color="#656B72" />
    <SolidColorBrush x:Key="ToastMoreHoverBrush" Color="#5A6067" />
    <SolidColorBrush x:Key="ToastMenuHoverBrush" Color="#565C63" />
    <SolidColorBrush x:Key="ToastCloseHoverBrush" Color="#50545A" />
    <SolidColorBrush x:Key="ToastAutomaticBrandBrush" Color="#F6F7F9" />
    <SolidColorBrush x:Key="ToastAutomaticSecondaryBrush" Color="#B8BEC7" />
    <SolidColorBrush x:Key="ToastAutomaticIconBrush" Color="#E3E7EC" />
    <SolidColorBrush x:Key="ToastAutomaticRuleBrush" Color="#F0F2F5" />
    <SolidColorBrush x:Key="ToastLinkBrush" Color="#F3F5F7" />
    <SolidColorBrush x:Key="ToastAutomaticControlBrush" Color="#D4D9DF" />
    <SolidColorBrush x:Key="ToastAutomaticCloseHoverBrush" Color="#505761" />
    <SolidColorBrush x:Key="ToastAccentBrush" Color="#FF9448" />
    <Color x:Key="ToastShadowColor">#000000</Color>
</ResourceDictionary>
