<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FocusApp.Desktop;component/Resources/Typography.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Shared by all statistics tabs without changing application-wide typography. -->
    <system:Double x:Key="StatisticsTitleFontSize">18</system:Double>
    <system:Double x:Key="StatisticsMetricFontSize">28</system:Double>
    <Color x:Key="StatisticsPrimaryColor">#18212F</Color>
    <Color x:Key="StatisticsBodyColor">#374151</Color>
    <Color x:Key="StatisticsSecondaryColor">#667085</Color>
    <Color x:Key="StatisticsWeakColor">#7C8798</Color>
    <SolidColorBrush x:Key="StatisticsPrimaryBrush" Color="{StaticResource StatisticsPrimaryColor}"/>
    <SolidColorBrush x:Key="StatisticsBodyBrush" Color="{StaticResource StatisticsBodyColor}"/>
    <SolidColorBrush x:Key="StatisticsSecondaryBrush" Color="{StaticResource StatisticsSecondaryColor}"/>
    <SolidColorBrush x:Key="StatisticsWeakBrush" Color="{StaticResource StatisticsWeakColor}"/>

    <Style x:Key="StatisticsBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyPrimary}"/>
        <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource StatisticsBodyBrush}"/>
    </Style>
    <Style x:Key="StatisticsPageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StatisticsBodyTextStyle}">
        <Setter Property="FontSize" Value="{DynamicResource StatisticsTitleFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource StatisticsPrimaryBrush}"/>
    </Style>
    <Style x:Key="StatisticsTimeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StatisticsBodyTextStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyEnglish}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <Style x:Key="StatisticsHeadingTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StatisticsBodyTextStyle}">
        <Setter Property="FontSize" Value="{DynamicResource SectionTitleFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource StatisticsPrimaryBrush}"/>
    </Style>
    <Style x:Key="StatisticsMetricLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource StatisticsBodyTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource StatisticsSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="StatisticsAuxiliaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StatisticsBodyTextStyle}">
        <Setter Property="FontSize" Value="{DynamicResource SecondaryFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource StatisticsWeakBrush}"/>
    </Style>
    <Style x:Key="StatisticsValueRunStyle" TargetType="Run">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyNumeric}"/>
        <Setter Property="FontSize" Value="{DynamicResource StatisticsMetricFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource StatisticsPrimaryBrush}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="BaselineAlignment" Value="Baseline"/>
    </Style>
    <Style x:Key="StatisticsUnitRunStyle" TargetType="Run">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyPrimary}"/>
        <Setter Property="FontSize" Value="{DynamicResource SecondaryFontSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource StatisticsSecondaryBrush}"/>
        <Setter Property="BaselineAlignment" Value="Baseline"/>
    </Style>
</ResourceDictionary>
