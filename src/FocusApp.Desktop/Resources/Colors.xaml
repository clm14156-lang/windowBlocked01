<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="BackgroundPrimary" Color="#F7F7F8" />
    <SolidColorBrush x:Key="BackgroundSecondary" Color="#F2F2F4" />
    <SolidColorBrush x:Key="SurfacePrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextPrimary" Color="#1D1D1F" />
    <SolidColorBrush x:Key="TextSecondary" Color="#6E6E73" />
    <SolidColorBrush x:Key="BorderPrimary" Color="#E5E5EA" />
    <SolidColorBrush x:Key="AccentPrimary" Color="#FF7A00" />
    <SolidColorBrush x:Key="AccentTint" Color="#FFF1E6" />
    <SolidColorBrush x:Key="Success" Color="#2E9B62" />
    <SolidColorBrush x:Key="Warning" Color="#C47A00" />
    <SolidColorBrush x:Key="Danger" Color="#D83B3B" />
</ResourceDictionary>
