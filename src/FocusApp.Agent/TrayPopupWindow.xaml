<Window x:Class="FocusApp.Agent.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="270"
        Height="372"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStyle="None">
    <Window.Resources>
        <Style x:Key="TrayMenuButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF5F5F5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFEFEFEF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrayExitButtonStyle"
               BasedOn="{StaticResource TrayMenuButtonStyle}"
               TargetType="{x:Type Button}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFFFF5F4" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFFFECEA" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Margin="4"
            Padding="14,14,14,12"
            Background="#FFFFFFFF"
            BorderBrush="#FFE5E5EA"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12"
                              Direction="270"
                              Opacity="0.10"
                              ShadowDepth="3" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="1" />
                <RowDefinition Height="8" />
                <RowDefinition Height="44" />
                <RowDefinition Height="44" />
                <RowDefinition Height="44" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Top" Orientation="Horizontal">
                <Image Width="20"
                       Height="20"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="/FocusApp.Agent;component/Assets/Themes/Solid/Orange/sidebar-logo.png"
                       Stretch="Uniform" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="Medium"
                           Foreground="#FF1D1D1F"
                           Text="专注时光" />
            </StackPanel>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border x:Name="StatusPill"
                        Padding="10,4"
                        HorizontalAlignment="Center"
                        Background="#FFFFFFFF"
                        CornerRadius="14">
                    <TextBlock x:Name="StatusText"
                               FontSize="15"
                               FontWeight="Medium"
                               Foreground="#FF1D1D1F"
                               Text="当前未在专注" />
                </Border>
                <TextBlock x:Name="TimerText"
                           Margin="0,8,0,0"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="44"
                           FontWeight="SemiBold"
                           Foreground="#FF1D1D1F"
                           TextAlignment="Center"
                           Visibility="Collapsed" />
                <TextBlock x:Name="IdleHint"
                           Margin="0,7,0,0"
                           FontSize="12"
                           FontWeight="Normal"
                           Foreground="#FF6E6E73"
                           Text="放下干扰，开始高效的一天"
                           TextAlignment="Center" />
            </StackPanel>

            <Border Grid.Row="2" Background="#FFEDEDEF" />

            <Button x:Name="BlockingButton"
                    Grid.Row="4"
                    Click="BlockingButton_Click"
                    Style="{StaticResource TrayMenuButtonStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Width="17"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="17"
                               Foreground="#FF22A968"
                               Text="&#xE72E;" />
                    <TextBlock Grid.Column="1"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="Normal"
                               Foreground="#FF1D1D1F"
                               Text="自动屏蔽已开启" />
                    <Path Grid.Column="2"
                          Width="6"
                          Height="10"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Data="M 1,1 L 5,5 L 1,9"
                          Stroke="#FFAEAEB2"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeThickness="1.4" />
                </Grid>
            </Button>

            <Border Grid.Row="5" Height="44" Padding="8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Width="17"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="17"
                               Foreground="#FF8E8E93"
                               Text="&#xE823;" />
                    <TextBlock Grid.Column="1"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="Normal"
                               Foreground="#FF1D1D1F"
                               Text="今日专注" />
                    <TextBlock x:Name="TodayText"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="#FFFF7A00" />
                </Grid>
            </Border>

            <Button Grid.Row="6"
                    Click="OpenDesktopButton_Click"
                    Style="{StaticResource TrayMenuButtonStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Width="17"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="17"
                               Foreground="#FF5F7F9F"
                               Text="&#xE7F4;" />
                    <TextBlock Grid.Column="1"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="Normal"
                               Foreground="#FF1D1D1F"
                               Text="打开主界面" />
                    <Path Grid.Column="2"
                          Width="6"
                          Height="10"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Data="M 1,1 L 5,5 L 1,9"
                          Stroke="#FFAEAEB2"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeThickness="1.4" />
                </Grid>
            </Button>

            <Button x:Name="ExitButton"
                    Grid.Row="7"
                    Click="ExitButton_Click"
                    Style="{StaticResource TrayExitButtonStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ExitIcon"
                               Width="17"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="17"
                               Foreground="#FFF04444"
                               Text="&#xE7E8;" />
                    <StackPanel Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="ExitText"
                                   FontSize="13"
                                   FontWeight="Normal"
                                   Foreground="#FF1D1D1F"
                                   Text="退出应用" />
                        <TextBlock x:Name="ExitHint"
                                   FontSize="12"
                                   FontWeight="Normal"
                                   Foreground="#FFAEAEB2"
                                   Text="暂无法退出"
                                   Visibility="Collapsed" />
                    </StackPanel>
                    <Path Grid.Column="2"
                          Width="6"
                          Height="10"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Data="M 1,1 L 5,5 L 1,9"
                          Stroke="#FFAEAEB2"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeThickness="1.4" />
                </Grid>
            </Button>
        </Grid>
    </Border>
</Window>
