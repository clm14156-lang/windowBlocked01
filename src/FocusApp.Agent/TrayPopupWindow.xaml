<Window x:Class="FocusApp.Agent.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="270" Height="400" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Topmost="True" WindowStyle="None">
    <Border Background="#FFFFFF" BorderBrush="#E5E5EA" BorderThickness="1" CornerRadius="8" Padding="18,16,18,12">
        <Border.Effect><DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.16" ShadowDepth="5" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="1"/><RowDefinition Height="48"/><RowDefinition Height="48"/><RowDefinition Height="48"/><RowDefinition Height="48"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#FF7A00" Text="&#xE80F;" VerticalAlignment="Center"/>
                <TextBlock Margin="10,0,0,0" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="20" FontWeight="SemiBold" Foreground="#1D1D1F" Text="专注时光" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border x:Name="StatusPill" Padding="14,7" CornerRadius="20" HorizontalAlignment="Center" Background="#FFF2E8">
                    <TextBlock x:Name="StatusText" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="15" FontWeight="SemiBold" Foreground="#FF7A00" Text="当前未在专注"/>
                </Border>
                <TextBlock x:Name="TimerText" Margin="0,12,0,0" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="44" FontWeight="SemiBold" Foreground="#1D1D1F" TextAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="TargetText" Margin="0,5,0,0" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="17" Foreground="#1D1D1F" TextAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="TasksText" Margin="0,5,0,0" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="#6E6E73" TextAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="IdleHint" Margin="0,10,0,0" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="#6E6E73" Text="放下干扰，开始高效的一天" TextAlignment="Center"/>
            </StackPanel>
            <Border Grid.Row="2" Background="#E5E5EA"/>
            <Button Grid.Row="3" x:Name="BlockingButton" Click="BlockingButton_Click" Style="{x:Null}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#22A968" Text="&#xE72E;" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Margin="12,0,0,0" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="#1D1D1F" Text="自动屏蔽已开启" VerticalAlignment="Center"/></Grid>
            </Button>
            <Border Grid.Row="4" Background="Transparent" Padding="0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="#6E6E73" Text="&#xE7F4;" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Margin="12,0,0,0" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="#1D1D1F" Text="今日专注" VerticalAlignment="Center"/><TextBlock x:Name="TodayText" Grid.Column="1" HorizontalAlignment="Right" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="#FF7A00" VerticalAlignment="Center"/></Grid>
            </Border>
            <Button Grid.Row="5" Click="OpenDesktopButton_Click" Style="{x:Null}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="#6E6E73" Text="&#xE7F4;" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Margin="12,0,0,0" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="#1D1D1F" Text="打开主界面" VerticalAlignment="Center"/></Grid></Button>
            <Button Grid.Row="6" x:Name="ExitButton" Click="ExitButton_Click" Style="{x:Null}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="ExitIcon" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#F04444" Text="&#xE7E8;" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="ExitText" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="#1D1D1F" Text="退出应用"/><TextBlock x:Name="ExitHint" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12" Foreground="#AEAEB2" Text="暂无法退出" Visibility="Collapsed"/></StackPanel></Grid></Button>
        </Grid>
    </Border>
</Window>
