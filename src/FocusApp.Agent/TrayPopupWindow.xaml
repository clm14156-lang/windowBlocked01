<Window x:Class="FocusApp.Agent.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="270"
        SizeToContent="Height"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStyle="None">
    <Window.Resources>
        <Geometry x:Key="ShieldIcon">M 10,1 L 18,4.5 V 10 C 18,14 14.5,17.5 10,19 C 5.5,17.5 2,14 2,10 V 4.5 Z M 6.5,10 L 9,12.5 L 13.5,8</Geometry>
        <Geometry x:Key="LockIcon">M 6,8 V 5 A 4,4 0 0 1 14,5 V 8 M 5,8 H 15 Q 17,8 17,10 V 16 Q 17,18 15,18 H 5 Q 3,18 3,16 V 10 Q 3,8 5,8 Z M 10,12 V 14</Geometry>
        <Geometry x:Key="ClockIcon">M 10,2 A 8,8 0 1 1 10,18 A 8,8 0 1 1 10,2 Z M 10,5.5 V 10 H 13.5</Geometry>
        <Geometry x:Key="MonitorIcon">M 3,3 H 17 Q 18,3 18,4 V 13 Q 18,14 17,14 H 3 Q 2,14 2,13 V 4 Q 2,3 3,3 Z M 10,14 V 17.5 M 6.5,17.5 H 13.5</Geometry>
        <Geometry x:Key="PowerIcon">M 6,4.2 A 7.5,7.5 0 1 0 14,4.2 M 10,1.5 V 9</Geometry>
        <Geometry x:Key="RestrictedIcon">F0 M 6,8 V 5 A 4,4 0 0 1 14,5 V 8 H 12 V 5 A 2,2 0 0 0 8,5 V 8 Z M 5,8 H 15 Q 17,8 17,10 V 16 Q 17,18 15,18 H 5 Q 3,18 3,16 V 10 Q 3,8 5,8 Z M 9,13 V 15 H 11 V 13 A 1.5,1.5 0 1 0 9,13 Z</Geometry>
        <Style x:Key="TrayIconStyle" TargetType="Path">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="#FF65686E" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <Style x:Key="RestrictedIconStyle" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource RestrictedIcon}" />
            <Setter Property="Fill" Value="#FFCBCFD8" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="TrayLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#FF1D1D1F" />
        </Style>
        <Style x:Key="TrayDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Background" Value="#FFEDEDEF" />
        </Style>
        <Style x:Key="TraySwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Background="#FFD4D8E1" CornerRadius="10">
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="2,0" Fill="White"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FFFF8A00" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="Track" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrayMenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF5F5F5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFEFEFEF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="4" Padding="14,8" Background="#FFFFFFFF" BorderBrush="#FFE5E5EA" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" Direction="270" Opacity="0.10" ShadowDepth="3" />
        </Border.Effect>

        <StackPanel>
            <Border Height="36" Padding="8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource ShieldIcon}" Style="{StaticResource TrayIconStyle}" />
                    <TextBlock Grid.Column="1" Text="自动屏蔽" Style="{StaticResource TrayLabelStyle}" />
                    <Path x:Name="AutomaticBlockingLock" Grid.Column="2" Style="{StaticResource RestrictedIconStyle}" />
                    <ToggleButton x:Name="AutomaticBlockingSwitch" Grid.Column="3" AutomationProperties.Name="自动屏蔽"
                                  Click="FocusFeatureSwitch_Click" Style="{StaticResource TraySwitchStyle}" />
                </Grid>
            </Border>

            <Border Height="36" Padding="8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource LockIcon}" Style="{StaticResource TrayIconStyle}" />
                    <TextBlock Grid.Column="1" Text="强制模式" Style="{StaticResource TrayLabelStyle}" />
                    <Path x:Name="ForcedModeLock" Grid.Column="2" Style="{StaticResource RestrictedIconStyle}" />
                    <ToggleButton x:Name="ForcedModeSwitch" Grid.Column="3" AutomationProperties.Name="强制模式"
                                  Click="FocusFeatureSwitch_Click" Style="{StaticResource TraySwitchStyle}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource TrayDividerStyle}" />
            <Border Height="36" Padding="8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource ClockIcon}" Style="{StaticResource TrayIconStyle}" />
                    <TextBlock Grid.Column="1" Text="今日专注" Style="{StaticResource TrayLabelStyle}" />
                    <TextBlock x:Name="TodayText" Grid.Column="2" VerticalAlignment="Center"
                               FontSize="12" FontWeight="Medium" Foreground="#FFFF7A00" />
                </Grid>
            </Border>
            <Border Style="{StaticResource TrayDividerStyle}" />

            <Button Click="OpenDesktopButton_Click" Style="{StaticResource TrayMenuButtonStyle}" AutomationProperties.Name="打开主界面">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource MonitorIcon}" Style="{StaticResource TrayIconStyle}" />
                    <TextBlock Grid.Column="1" Text="打开主界面" Style="{StaticResource TrayLabelStyle}" />
                </Grid>
            </Button>

            <Button x:Name="ExitButton" Click="ExitButton_Click" Style="{StaticResource TrayMenuButtonStyle}"
                    AutomationProperties.Name="退出应用" ToolTipService.ShowOnDisabled="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource PowerIcon}" Style="{StaticResource TrayIconStyle}" />
                    <TextBlock Grid.Column="1" Text="退出应用" Style="{StaticResource TrayLabelStyle}" />
                </Grid>
            </Button>
        </StackPanel>
    </Border>
</Window>
